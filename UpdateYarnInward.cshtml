        }
        function SaveSiftYarnBox() {
            var dataArray = [];
            var BillToPartyID = $("#txtBillToPartyID").val();
            var YarnMaterialID = $("#txtYarnMaterialID").val();
            var YarnColorID = $("#txtYarnColorID").val();

            var GodownLocationIDRaw = $("#txtGodownLocationID").val();
            if (!GodownLocationIDRaw) return;

            var GodownLocationIDs = GodownLocationIDRaw.slice(0, -1).split(",");
            var TotalNoOfBox = 0;

            GodownLocationIDs.forEach(function (id) {
                var qty = parseInt($("#txtNoOfBox_" + id).val()) || 0;
                TotalNoOfBox += qty;
            });

            $("#hTotalNoOfBox").html(TotalNoOfBox);

            var SpanNoOfBox = parseInt($("#tblSpanNoOfBox").html()) || 0;

            if (TotalNoOfBox !== SpanNoOfBox) {
                return;
            }

            var existingValue = $("#siftGodownInputBox").val() || "";
            var newEntries = "";
            var qtyMap = {};

            GodownLocationIDs.forEach(function (id) {
                var qty = parseInt($("#txtNoOfBox_" + id).val()) || 0;
                if (qty > 0) {
                    var entry = "(" + id + "," + BillToPartyID + "," + YarnMaterialID + "," + YarnColorID + "," + qty + ")|";
                    newEntries += entry;

                    var mapKey = BillToPartyID + "_" + YarnMaterialID + "_" + YarnColorID;
                    if (!qtyMap[mapKey]) {
                        qtyMap[mapKey] = 0;
                    }
                    qtyMap[mapKey] += qty;
                }
            });

            $("#siftGodownInputBox").val(existingValue + newEntries);

            $("#tableYarnOutward tr").each(function () {
                var $row = $(this);
                var hiddenId = $row.find("input[type='hidden']").val();
                if (!hiddenId) return;

                var parts = hiddenId.split("_");
                if (parts.length < 4) return;

                var rowKey = parts[1] + "_" + parts[2] + "_" + parts[3];

                if (qtyMap[rowKey]) {
                    var stockSpan = $row.find("span[id^='spanStock_']");
                    var currentStock = parseInt(stockSpan.text()) || 0;
                    var newStock = currentStock - qtyMap[rowKey];

                    if (newStock < 0) newStock = 0;

                    stockSpan.text(newStock);
                    $row.find("input[id^='txtinputstock_']").val("");

                    if (newStock === 0) {
                        $row.hide();
                    }
                }
            });
            $("#tableYarnOutward tr:visible").each(function (index) {
                $(this).find("td:eq(0)").text(index + 1);
            });
            $("#tblYarnSift tr").each(function () {
                var id = $(this).data("godownlocationid");
                var noOfBox = parseInt($("#txtNoOfBox_" + id).val()) || 0;

                if (noOfBox <= 0) return;

                dataArray.push({
                    Id: id,
                    Company: $(this).data("companyname"),
                    Material: $(this).data("yarnmaterial"),
                    Color: $(this).data("yarncolor"),
                    YarnCode: $(this).data("yarncolorcode"),
                    Godown: $(this).find("td:eq(1)").text().trim(),
                    Location: $(this).find("td:eq(2)").text().trim(),
                    NoOfBox: noOfBox
                });
            });

            if (dataArray.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: 'Please enter at least one box.'
                });
                return;
            }

            $("#btnClose").click();

            var dataTable = $('#tableSiftYarnData');
            var temp = "";
            var srno = $("#tableSiftYarnData tr").length + 1;

            for (var i = 0; i < dataArray.length; i++) {
                temp += "<tr>";

                var hiddenValue = "(" + dataArray[i].Id + "," +
                    BillToPartyID + "," +
                    YarnMaterialID + "," +
                    YarnColorID + "," +
                    dataArray[i].NoOfBox + ")";

                temp += "<td style='text-align:center;'>" +
                    "<a href='javascript:void(0);' onclick='yarnbacksift(this,\"" + hiddenValue + "\")'>" +
                    "<img src='/img/left-rrow.png' title='Sift Back Yarn' style='width:20px;'/>" +
                    "</a>" +
                    "</td>";

                temp += "<td>" + srno + "</td>";
                temp += "<td>" + dataArray[i].Company + "</td>";
                temp += "<td>" + dataArray[i].Material + "</td>";
                temp += "<td>" + dataArray[i].Color + "</td>";
                temp += "<td>" + dataArray[i].YarnCode + "</td>";
                temp += "<td>" + dataArray[i].Location + "</td>";
                temp += "<td>" + dataArray[i].NoOfBox + "</td>";

                temp += "<input type='hidden' id='txtsiftid_" + srno + "' " +
                    "value='" + dataArray[i].Id + "' />";

                temp += "</tr>";

                srno++;
            }
            dataTable.append(temp);
        }
        function GodownNoOfBox(abc) {
            var GodownLocationID = abc.id.split('_')[1];
            var spanValue = "#span_" + GodownLocationID;
            var trrow = "#tr" + GodownLocationID;

            var InputNoOfBox = abc.value;
            var SpanNoOfBox = $(spanValue).html();

            if (parseInt(InputNoOfBox) > parseInt(SpanNoOfBox)) {
                $(trrow).css("background-color", "darkred");
                $(trrow).css("color", "white");
                notess.show("Please Mention Less " + SpanNoOfBox + " No Of Box.", {
                    type: 'danger'
                });
            }
            else {
                $(trrow).css("background-color", "transparent");
                $(trrow).css("color", "#6f7479");
            }

            var tblSpanNoOfBox = $("#tblSpanNoOfBox").html();
            var GodownLocationID = $("#txtGodownLocationID").val().slice(0, -1);

            var TotalNoOfBox = 0;
            for (var i = 0; i < GodownLocationID.split(',').length; i++) {
                var InpuNoOfBox = "#txtNoOfBox_" + GodownLocationID.split(',')[i];

                if ($(InpuNoOfBox).val() == "") {
                    TotalNoOfBox = parseInt(TotalNoOfBox) + parseInt(0);
                }
                else {
                    TotalNoOfBox = parseInt(TotalNoOfBox) + parseInt($(InpuNoOfBox).val());
                }
            }

            $("#hTotalNoOfBox").html(TotalNoOfBox);

            if (parseInt(tblSpanNoOfBox) < parseInt(TotalNoOfBox)) {
                $('.modal-header').css('background', '#ff0000');
                notess.show("Please Mention Only " + tblSpanNoOfBox + " No Of Box.", {
                    type: 'danger'
                });
            }
            else {
                $('.modal-header').css('background', '#1273eb');
            }
        }
        function HideAlreadySifted() {
            let count = 1;
            var balance = parseInt($("#tblSpanNoOfBox").text()) || 0;

            $("#tblYarnSift tr").each(function () {
                var $modalRow = $(this);
                var locationId = $modalRow.data("godownlocationid");
                var billTo = $modalRow.data("billto");
                var material = $modalRow.data("yarnmaterialid");
                var color = $modalRow.data("yarncolorid");

                var modalMaxQty = parseInt($modalRow.find("td:eq(3)").text()) || 0;
                var usedQty = 0;

                $("#tableSiftYarnData tr").each(function () {
                    var anchor = $(this).find("a[onclick]");
                    if (!anchor.length) return;

                    var onclickText = anchor.attr("onclick");
                    var match = onclickText.match(/"\((.*?)\)"/);
                    if (!match) return;

                    var parts = match[1].split(",");
                    if (parts.length < 5) return;

                    if (locationId == parts[0] &&
                        billTo == parts[1] &&
                        material == parts[2] &&
                        color == parts[3]) {
                        usedQty += parseInt(parts[4]) || 0;
                    }
                });

                var remaining = modalMaxQty - usedQty;
                if (remaining < 0) remaining = 0;

                var textbox = $modalRow.find(".txtNoOfBox");
                var finalQty = Math.min(remaining, balance);
                textbox.val(finalQty);

                balance -= finalQty;

                $modalRow.find("td:eq(3)").text(remaining);

                if (remaining === 0) {
                    textbox.prop("disabled", true).addClass("bg-light");
                    $modalRow.hide();
                    return;
                } else {
                    textbox.prop("disabled", false).removeClass("bg-light");
                }

                $(this).find("td:eq(0)").text(count);
                count++;
            });
        }
