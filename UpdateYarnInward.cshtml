        function yarnbacksift(el, key) {
            var originalKey = key;
            key = key.replace("(", "").replace(")", "");
            var ids = key.split(",");
            var locationId = ids[0];
            var partyId = ids[1];
            var materialId = ids[2];
            var colorId = ids[3];
            var qty = parseInt(ids[4]) || 0;
            var $rightRow = $(el).closest("tr");
            var companyName = $rightRow.find("td:eq(2)").text().trim();
            var materialName = $rightRow.find("td:eq(3)").text().trim();
            var colorName = $rightRow.find("td:eq(4)").text().trim();
            var colorCode = $rightRow.find("td:eq(5)").text().trim();
            var rowFound = false;

            $("#tableYarnOutward tr").each(function () {
                var $row = $(this);
                var hiddenId = $row.find("input[type='hidden']").val();
                if (!hiddenId) return;
                var parts = hiddenId.split("_");
                if (partyId == parts[1] &&
                    materialId == parts[2] &&
                    colorId == parts[3]) {
                    var stockSpan = $row.find("span[id^='spanStock_']");
                    var currentStock = parseInt(stockSpan.text()) || 0;
                    var newStock = currentStock + qty;
                    stockSpan.text(newStock);
                    if (newStock > 0) {
                        $row.show();
                        rowFound = true;
                    }
                }
            });
            if (!rowFound) {
                var $tbody = $("#tableYarnOutward");
                var temp = "";
                var lastId = 0;
                $tbody.find("span[id^='span_Name_']").each(function () {
                    var id = $(this).attr("id");
                    var num = parseInt(id.split("_")[2]);
                    if (num > lastId) {
                        lastId = num;
                    }
                });
                var newId = lastId + 1;
                var srno = $tbody.find("tr:has(td)").length + 1;
                var allids = newId + "_" + partyId + "_" + materialId + "_" + colorId;
                temp += "<tr>";
                temp += "<td class='srno'>" + srno + "</td>";
                temp += "<td><span id='span_Name_" + newId + "'>" + companyName + "</span></td>";
                temp += "<td><span id='span_Material_" + newId + "'>" + materialName + "</span></td>";
                temp += "<td><span id='span_Color_" + newId + "'>" + colorName + "</span></td>";
                temp += "<td><span id='span_Code_" + newId + "'>" + colorCode + "</span></td>";
                temp += "<td style='text-align:center;'>";
                temp += "<span id='spanStock_" + newId + "'>" + qty + "</span>";
                temp += "</td>";
                temp += "<td>";
                temp += "<input type='text' id='txtinputstock_" + newId + "' ";
                temp += "class='form-control' maxlength='2' ";
                temp += "style='padding:5px; min-height:0px; margin-top:-5px;' ";
                temp += "onkeypress='return (event.charCode>=48 && event.charCode<=57)' />";
                temp += "<br/>";
                temp += "<input type='hidden' id='txtid_" + newId + "' value='" + allids + "' />";
                temp += "</td>";
                temp += "<td style='padding: 0; margin: 0; text-align: center;'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='Sift Yarn' onclick='StockTransferSiftTo(\"" + allids + "\")'><img src='/img/arrow.png' title='Sift Yarn' style='width: 40%;'/></a></td>";
                temp += "</tr>";
                $tbody.append(temp);
            }
            $(el).closest("tr").remove();
            var currentValue = $("#siftGodownInputBox").val() || "";
            var updatedValue = currentValue.replace(originalKey + "|", "");
            $("#siftGodownInputBox").val(updatedValue);
            $("#tableSiftYarnData tr").each(function (index) {
                $(this).find("td:eq(1)").text(index + 1);
            });
        }
        function yarnsift(abc) {
            if (!abc) return;
            var parts = abc.split("_");
            if (parts.length < 4) return;
            var SrNo = parts[0];
            var BillToPartyID = parts[1];
            var YarnMaterialID = parts[2];
            var YarnColorID = parts[3];
            var GodownID = $("#ddlGodownMaster").val();

            var $stockSpan = $("#spanStock_" + SrNo);
            var $inputBox = $("#txtinputstock_" + SrNo);
            var TextStock = parseInt($inputBox.val()) || 0;
            var AvailableStock = parseInt($stockSpan.text()) || 0;
            if (!TextStock) {
                $inputBox.addClass("is-invalid");
                notes.show("Please Mention No Of Box.", { type: 'danger' });
                return;
            }

            if (TextStock > AvailableStock) {
                $inputBox.addClass("is-invalid");
                notes.show("Please Mention Below Stock Value.", { type: 'danger' });
                return;
            }

            $inputBox.removeClass("is-invalid");
            $("#tblSpanCompanyName").html($("#span_Name_" + SrNo).html());
            $("#tblSpanYarnMaterial").html($("#span_Material_" + SrNo).html());
            $("#tblSpanYarnColor").html($("#span_Color_" + SrNo).html());
            $("#tblSpanColorCode").html($("#span_Code_" + SrNo).html());
            $("#tblSpanNoOfBox").html(TextStock);

            $("#txtBillToPartyID").val(BillToPartyID);
            $("#txtYarnMaterialID").val(YarnMaterialID);
            $("#txtYarnColorID").val(YarnColorID);
            $("#txtTextStock").val(TextStock);
            var formData = new FormData();
            formData.append('BillToPartyID', BillToPartyID);
            formData.append('YarnMaterialID', YarnMaterialID);
            formData.append('YarnColorID', YarnColorID);
            formData.append('GodownID', GodownID);

            var siftGodownInputBox = $("#siftGodownInputBox").val() || "";
            formData.append(
                'siftGodownInputBox',
                siftGodownInputBox ? siftGodownInputBox.slice(0, -1).replace(/\|/g, ',') : ""
            );

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getUpdateYarnOutwardSiftMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var list = response.listYarnOutwardMaster || [];
                    var $tbody = $("#tblYarnSift");

                    $tbody.empty();

                    if (!list.length) {
                        $("#hTotalNoOfBox").html(0);
                        return;
                    }

                    var temp = "";
                    var srno = 1;
                    var RemainingStock = TextStock;
                    var locationIds = [];
                    stockAssigned = false
                    list.forEach(function (item) {
                        var maxBox = parseInt(item.NoOfBox) || 0;
                        var MentionNoOfBox = 0;

                        if (!stockAssigned && TextStock <= maxBox) {
                            MentionNoOfBox = TextStock;
                            stockAssigned = true;
                        } else {
                            MentionNoOfBox = 0;
                        }

                        temp += `
                              <tr
                                  data-billto="${item.BillToPartyID}"
                                  data-godownlocationid="${item.GodownLocationID}"
                                  data-yarncolorid="${item.YarnColorID}"
                                  data-yarnmaterialid="${item.YarnMaterialID}"
                                  data-companyname="${item.CompanyName}"
                                  data-yarnmaterial="${item.YarnMaterial}"
                                  data-yarncolor="${item.YarnColor}"
                                  data-yarncolorcode="${item.YarnColorCode}">

                                  <td>${srno}</td>
                                  <td>${item.GodownTitle}</td>
                                  <td>${item.LocationTitle}</td>
                                  <td>${maxBox}</td>
                                  <td>
                                      <input type="tel"
                                          class="form-control txtNoOfBox"
                                          id="txtNoOfBox_${item.GodownLocationID}"
                                          data-max="${maxBox}"
                                          value="${MentionNoOfBox}"
                                          maxlength="2"
                                          style="width:60px; min-height:30px;"
                                          onkeypress="return (event.charCode>=48 && event.charCode<=57)"
                                          onkeyup="GodownNoOfBox(this)" />
                                  </td>
                              </tr>`;

                        locationIds.push(item.GodownLocationID);
                        srno++;
                    });

                    $tbody.append(temp);

                    $("#hTotalNoOfBox").html(TextStock);
                    $("#txtGodownLocationID").val(locationIds.join(",") + ",");

                    HideAlreadySifted();

                    $('#modalYarnSift').on('shown.bs.modal', function () {
                        $("#btnSaveSiftYarnBox").trigger("focus");
                    });
                }
            });

            $("#btnShiftModel").click();
        }
