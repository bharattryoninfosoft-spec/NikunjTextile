                                dataArray[i].BillToPartyID + "," +
                                dataArray[i].YarnMaterialID + "," +
                                dataArray[i].YarnColorID + "," +
                                dataArray[i].Stock + ")";

                            temp += "<td style='text-align:center;'>" +
                                "<a href='javascript:void(0);' onclick='yarnbacksift(this,\"" + hiddenValue + "\")'>" +
                                "<img src='/img/left-rrow.png' title='Sift Back Yarn' style='width:20px;'/>" +
                                "</a>" +
                                "</td>";

                            temp += "<td>" + srno + "</td>";
                            temp += "<td>" + dataArray[i].CompanyName + "</td>";
                            temp += "<td>" + dataArray[i].YarnMaterial + "</td>";
                            temp += "<td>" + dataArray[i].YarnColor + "</td>";
                            temp += "<td>" + dataArray[i].YarnColorCode + "</td>";
                            temp += "<td>" + dataArray[i].LocationTitle + "</td>";
                            temp += "<td>" + dataArray[i].Stock + "</td>";

                            temp += "<input type='hidden' id='txtsiftid_" + srno + "' " +
                                "value='" + dataArray[i].GodownLocationID + "' />";

                            temp += "</tr>";

                            locationIds.push(hiddenValue);
                            srno++;
                        }
                        dataTable.append(temp);
                        $("#siftGodownInputBox").val(locationIds.join("|") + "|");
                    }
                },
                error: function (request, status, error) { }
            });
        }

        $('#Savebtn').on('click', function () {
            let location = $('#Location1').val();

            if (!location || location === "0") {
                Swal.fire({
                    icon: 'error',
                    title: 'Please Select Location',
                    text: 'Location is required before saving!'
                });
                return;
            }

            let totalWeight = parseFloat($('#TotalTotalWeight').val() || $('#TotalTotalWeight').text()) || 0;
            let receiveWeight = 0;
            $('#tableItemData').find('[id^="NetWeight"]').each(function () {
                receiveWeight += parseFloat($(this).val()) || 0;
            });
            let ReceivePOQty = parseFloat($('#ReceivePOQty').val()) || 0;
            let ChallanWeight = parseFloat($('#TotalWeight').val()) || 0;
            let TotalPendingWeight = parseFloat($('#TotalPendingWeight').text()) || 0;

            let pending = totalWeight - receiveWeight;
            $('#TotalPendingWeight').text(pending.toFixed(2));

            if (ChallanWeight !== receiveWeight) {
                Swal.fire({
                    icon: 'error',
                    title: 'Challan Pending Weight InComplete',
                    text: `Total: ${ChallanWeight} | Received: ${receiveWeight}`
                });
                return;
            }

            Swal.fire({
                title: 'Confirm Save',
                html: `
                        <b>Total Weight:</b> ${totalWeight} <br>
                        <b>Receive Weight:</b> ${ReceivePOQty + receiveWeight}<br>
                        <b>Pending Weight:</b> ${TotalPendingWeight}
                    `,
                icon: 'info',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Save',
                denyButtonText: 'Save & Close',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    checkSave();
                }
                else if (result.isDenied) {
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "Are you sure you want to Close this Yarn PO?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes',
                        cancelButtonText: 'No'
                    }).then((confirmResult) => {
                        if (confirmResult.isConfirmed) {
                            checkCloseSave();
                        }
                    });
                }
            });
        });
    </script>
