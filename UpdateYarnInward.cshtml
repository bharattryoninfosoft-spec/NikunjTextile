    function validateFloatKeyPress(el, evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        var number = el.value.split('.');
        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        //just one dot (thanks ddlab)
        if (number.length > 1 && charCode == 46) {
            return false;
        }
        //get the carat position
        var caratPos = getSelectionStart(el);
        var dotPos = el.value.indexOf(".");
        if (caratPos > dotPos && dotPos > -1 && (number[1].length > 1)) {
            return false;
        }
        return true;
    }

    function getSelectionStart(o) {
        if (o.createTextRange) {
            var r = document.selection.createRange().duplicate()
            r.moveEnd('character', o.value.length)
            if (r.text == '') return o.value.length
            return o.value.lastIndexOf(r.text)
        } else return o.selectionStart
    }



    function PendingWeightCalc() {


        var PreviousTotalWeight = $("#PreviousTotalWeight").val();
        var TotalPOTotalWeight = $("#TotalPOTotalWeight").val();

        var TotalPreWe = parseFloat(PreviousTotalWeight) + parseFloat(TotalPOTotalWeight);


        var TotalWeight = $("#TotalWeight").val();

        if (parseFloat(TotalWeight) <= parseFloat(TotalPreWe)) {

            //console.log(TotalPreWe);

            var TotalPendingTotalWeight = $("#TotalPendingTotalWeight").val();

            var TotalTotalWeight = TotalPendingTotalWeight;
            var TotWei = parseFloat(0);

            var txtColorArray = $("#txtYarnDetailsArray").val();
            var txtColorData = txtColorArray.slice(0, -1).split('|');


            for (var j = 0; j < txtColorData.length; j++) {


                var NW = "#NetWeight" + txtColorData[j];
                var NWVal = $(NW).val();
                //alert(NWVal);
                if (NWVal == "") {
                    TotWei += parseFloat(0);
                }
                else {
                    TotWei += parseFloat(NWVal);
                }

            }



            if (TotalWeight == "") {
                var PendingWeight = parseFloat(0) - parseFloat(TotWei);
                $("#PendingWeight").html(PendingWeight.toFixed(2));
                //alert(TotalTotalWeight + " " + TotWei);
                var TotalPendingWeight = parseFloat(TotalTotalWeight) - parseFloat(TotWei);
                //var TotalNewPendingWeight = (parseFloat($("#TotalWeight").val()) + parseFloat($("#TotalPOTotalWeight").val()));

                var TotalNewPendingWeight = (parseFloat($("#PreviousTotalWeight").val()) + parseFloat($("#TotalPOTotalWeight").val())) + parseFloat($("#PreviousTotalWeight").val());
                var NewTotalPendingWeight = parseFloat(TotalNewPendingWeight) - parseFloat(TotWei);

                //$("#TotalPendingWeight").html(TotalPendingWeight.toFixed(2));
                //$("#TotalPendingWeight").html(TotalNewPendingWeight.toFixed(2));
                var TotalPOTotalWeight = (parseFloat($("#TotalPOTotalWeight").val()) + parseFloat($("#PreviousTotalWeight").val())) - parseFloat(TotWei);
                $("#TotalPendingWeight").html(parseFloat(TotalPOTotalWeight).toFixed(2));

                if (PendingWeight.toFixed(2) < 0) {
                    $("#divPendingWeight").css("background-color", "orangered");
                }
                else {
                    $("#divPendingWeight").css("background-color", "lightgreen");
                }
                //divPendingWeight

            }
            else {
                var PendingWeight = parseFloat(TotalWeight) - parseFloat(TotWei);
                $("#PendingWeight").html(PendingWeight.toFixed(2));
                //alert(TotalTotalWeight + " " + TotWei);
                var TotalPendingWeight = parseFloat(TotalTotalWeight) - parseFloat(TotWei);
                //var TotalNewPendingWeight = parseFloat($("#TotalWeight").val()) + parseFloat($("#TotalPOTotalWeight").val());
                var TotalNewPendingWeight = (parseFloat($("#PreviousTotalWeight").val()) + parseFloat($("#TotalPOTotalWeight").val())) + parseFloat($("#PreviousTotalWeight").val());
                var NewTotalPendingWeight = parseFloat(TotalNewPendingWeight) - parseFloat(TotWei);

                var TotalPOTotalWeight = (parseFloat($("#TotalPOTotalWeight").val()) + parseFloat($("#PreviousTotalWeight").val())) - parseFloat(TotWei);
                //$("#TotalPendingWeight").html(TotalPendingWeight.toFixed(2));
                //$("#TotalPendingWeight").html(TotalNewPendingWeight.toFixed(2));
                $("#TotalPendingWeight").html(parseFloat(TotalPOTotalWeight).toFixed(2));

                if (PendingWeight.toFixed(2) < 0) {
                    $("#divPendingWeight").css("background-color", "orangered");
                }
                else {
                    $("#divPendingWeight").css("background-color", "lightgreen");
                }

            }


        }
        else {
            notes.show("It is not possible to enter a weight greater than " + TotalPreWe + ".", { type: 'danger' });
        }




    }



    function saveImage(input) {
        var previewStr = "#" + input.id + "-preview";
        if (input.files && input.files[0]) {
            var fildr = new FileReader();
            fildr.onload = function (e) {
                var imgStr = "<img src='" + e.target.result + "' style='width:100%;margin-top:-54px;'>";
                $(previewStr).html(imgStr);
                $(previewStr).css('color', 'initial');
            }
            fildr.readAsDataURL(input.files[0]);
            return true;
        }
        else {
            var message = "";
            if (input.id == "upload-image" || input.id == "upload-image-default") {
                message = "Photo Of Sketch Is Needed.";
            }
            else {
                message = "Photo Of Inward Is Needed.";
            }
            $(previewStr).html(message);
            $(previewStr).css('color', 'red');
            return false;
        }
    }

