function checkSave() {

    var siftYarnInwardDetailID = $.trim($("#siftYarnInwardDetailID").val() || "");
    var GodownLocationID = parseInt($("#ddlLocationDetail").val() || "0", 10);

    // -----------------------------
    // Validate Yarn Selection
    // -----------------------------
    if (siftYarnInwardDetailID === "") {
        Toast.fire({
            icon: 'warning',
            title: 'Please Sift Any Yarn.'
        });
        return false;
    }

    // -----------------------------
    // Validate Godown Location
    // -----------------------------
    if (GodownLocationID <= 0) {
        Toast.fire({
            icon: 'warning',
            title: 'Please Select Godown Location.'
        });
        return false;
    }

    // -----------------------------
    // Clean Selected IDs
    // Supports:
    // 1,2,3,
    // 1,2,3
    // -----------------------------
    var ids = siftYarnInwardDetailID
        .split(',')
        .map(function (id) {
            return $.trim(id);
        })
        .filter(function (id) {
            return id !== "" && !isNaN(id);
        });

    if (ids.length === 0) {
        Toast.fire({
            icon: 'warning',
            title: 'Please select valid Yarn.'
        });
        return false;
    }

    // Remove duplicate IDs
    ids = [...new Set(ids)];

    var cleanIds = ids.join(',');

    // -----------------------------
    // Prevent Double Click
    // -----------------------------
    var $btn = $("#btnSave");

    if ($btn.length) {
        $btn.prop("disabled", true);
    }

    var formData = new FormData();

    formData.append("YarnInwardDetailIDs", cleanIds);
    formData.append("GodownLocationID", GodownLocationID);

    $.ajax({
        type: "POST",
        url: "/WebServiceNikunjTextile.asmx/insertYarnInterChangeTable",
        data: formData,
        dataType: "json",
        contentType: false,
        processData: false,

        success: function (response) {

            // ASP.NET ASMX can return JSON inside response.d
            var result = response;

            if (response && response.d) {
                try {
                    result = typeof response.d === "string"
                        ? JSON.parse(response.d)
                        : response.d;
                }
                catch (e) {
                    result = response.d;
                }
            }

            if (result && result.Code == 201) {

                // Reset location
                $("#ddlLocationDetail").val("0").trigger("change");

                // Reset selected yarn IDs
                $("#siftYarnInwardDetailID").val("");

                // Clear table
                $("#tableSiftYarnData").html("");

                // Reload yarn data
                onsiftYarnInterChange();

                Swal.fire({
                    icon: "success",
                    title: "Success",
                    text: result.Message || "Record has been saved successfully.",
                    timer: 2000,
                    showConfirmButton: false
                });
            }
            else {

                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: (result && result.Message)
                        ? result.Message
                        : "Unable to save record."
                });
            }
        },

        error: function (xhr, status, error) {

            console.error("Yarn Interchange Error:", {
                status: status,
                error: error,
                response: xhr.responseText
            });

            Swal.fire({
                icon: "error",
                title: "Operation Failed",
                text: "An error occurred while saving. Please try again."
            });
        },

        complete: function () {

            if ($btn.length) {
                $btn.prop("disabled", false);
            }
        }
    });

    return false;
}

    </script>
