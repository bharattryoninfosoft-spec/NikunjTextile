        function yarnsift(YarnInwardDetailID) {
            var currentVal = $("#siftYarnInwardDetailID").val();
            var trYarnInwardDetailID = "#tr_" + YarnInwardDetailID + "";
            $(trYarnInwardDetailID).remove();

            if (currentVal == "") {
                $("#siftYarnInwardDetailID").val(YarnInwardDetailID + ",");
            } else {
                $("#siftYarnInwardDetailID").val(currentVal + YarnInwardDetailID + ",");
            }
            onsiftYarnInterChange();
        }

        function onsiftYarnInterChange() {
            var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val();

            if (siftYarnInwardDetailID != 0 && siftYarnInwardDetailID != "") {
                var formData = new FormData();
                formData.append('YarnInwardDetailID', siftYarnInwardDetailID);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getSiftYarnInterChangeTable',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == "200") {
                            if (response.listYarnInterChangeMaster.length > 0) {
                                var tempInterChangeTbl = "";
                                var SRno = 0;
                                for (var i = 0; i < response.listYarnInterChangeMaster.length; i++) {
                                    SRno = i + 1;
                                    tempInterChangeTbl += "<tr id='tr_" + response.listYarnInterChangeMaster[i].YarnInwardDetailID + "'>";
                                    tempInterChangeTbl += "<td style='padding: 0; margin: 0; text-align: center;'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='Sift Yarn' onclick='yarnsiftback(" + response.listYarnInterChangeMaster[i].YarnInwardDetailID + ")'><img src='/img/left-rrow.png' title='Sift Yarn' style='width: 40%;'/></a></td>";
                                    tempInterChangeTbl += "<td>" + SRno + "</td>";
                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].PartyName + "</td>";
                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].YarnMaterial + "</td>";
                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].YarnColor + "</td>";
                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].CompanyCode + "</td>";
                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].BoxNo + "</td>";
                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].NetWeight + "</td>";
                                    tempInterChangeTbl += "</tr>";
                                }
                                $("#tableSiftYarnData").html(tempInterChangeTbl);
                            } else {
                                $("#tableSiftYarnData").html('');
                            }
                        }
                    },
                    error: function (request, status, error) { }
                });
            }
        }

        function yarnsiftback(YarnInwardDetailID) {
            var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val();
            var YIDID = YarnInwardDetailID + ",";
            var newdata = siftYarnInwardDetailID.replace(YIDID, "");

            $("#siftYarnInwardDetailID").val(newdata);

            var trYarnInwardDetailID = "#tr_" + YarnInwardDetailID + "";
            $(trYarnInwardDetailID).remove();

            onchangeYarnInterChange();
        }

        function checkSave() {
            var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val();
            var GodownLocationID = $("#ddlLocationDetail").val();

            if (siftYarnInwardDetailID == "") {
                Toast.fire({
                    icon: 'warning',
                    title: 'Please Sift Any Yarn.'
                });
            }
            else if (GodownLocationID <= 0) {
                Toast.fire({
                    icon: 'warning',
                    title: 'Please Select Godown Location.'
                });
            }
            else {
                var cleanIds = siftYarnInwardDetailID.replace(/,\s*$/, "");
                var formData = new FormData();
                formData.append('YarnInwardDetailIDs', cleanIds);
                formData.append('GodownLocationID', GodownLocationID);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertYarnInterChangeTable',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            $("#ddlLocationDetail").val('0');
                            $("#select2-ddlLocationDetail-container").html('Select Location');
                            $("#siftYarnInwardDetailID").val('');
                            $("#tableSiftYarnData").html('');
                            onsiftYarnInterChange();

                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.Message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                        }
                        else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.Message
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Operation Failed',
                            text: 'An error occurred while saving. Please try again.'
                        });
                    }
                });
            }
        }
    </script>
}