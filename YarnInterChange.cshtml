@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $('body').addClass('fullscreen');
        var currentPagePermission = {};

        // Configure SweetAlert2 Toast helper for non-blocking alerts
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                var currentPagePermission = JSON.parse(permission);
                if (currentPagePermission.Add == false) {
                    $("#savebtn").hide();
                }
            }

            var liSelected;
            $(document).keydown(function (key) {
                var li = $('li');
                switch (parseInt(key.which, 10)) {
                    case 27: // Esc Key
                        $("#DivDDLItemDetail").hide();
                        $("#DivAddItem").show();
                        $("#CloseItemModel").click();
                        $("#cancelbtn").click();
                        $("#cancelItembtn").click();
                        break;
                    case 40:
                        if (liSelected) {
                            liSelected.removeClass('selected');
                            next = liSelected.next();
                            if (next.length > 0) {
                                liSelected = next.addClass('selected');
                            } else {
                                liSelected = li.eq(0).addClass('selected');
                            }
                        } else {
                            liSelected = li.eq(0).addClass('selected');
                        }
                        break;
                    case 38:
                        if (liSelected) {
                            liSelected.removeClass('selected');
                            next = liSelected.prev();
                            if (next.length > 0) {
                                liSelected = next.addClass('selected');
                            } else {
                                liSelected = li.last().addClass('selected');
                            }
                        } else {
                            liSelected = li.last().addClass('selected');
                        }
                        break;
                    default:
                        break;
                }
            });

            $('.active, .show, .current-page').removeClass('active show current-page');

            $("#YarnForm-tab").addClass("active");
            $("#tab-YarnForm").addClass("show active");
            $("#aYarnInterChange").addClass("current-page");

            FunctionIsLogin();
            getGodownDetail();
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: request.statusText || 'Failed to fetch default company.'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#Updatebtn").hide();
            $("#addNewContactLabel").html("Add Design Entry Form");
            $("#add-alert").hide();
            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function validate(code) {
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();

            if (code.value == "0" || code.value == "") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            } else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }

        function getGodownDetail() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getGodownDetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        if (response.listGodownMaster.length > 0) {
                            $('#ddlGodownID').empty();
                            var tempPartyName = "<option value='0'> Select Godown </option>";
                            $('#ddlGodownID').append(tempPartyName);

                            for (var i = 0; i < response.listGodownMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listGodownMaster[i].GodownID + "'> " + response.listGodownMaster[i].GodownTitle + " </option>";
                                $('#ddlGodownID').append(tempPartyName);
                            }
                        }
                    }
                },
                error: function (request, status, error) { }
            });
        }

        function OnChangeGown(GodownID) {
            $("#siftYarnInwardDetailID").val('');
            $("#tableSiftYarnData").html('');
            onchangeYarnInterChange();
            OnChangeLocation(GodownID);

            $("#hGodownDetail").html($('#ddlGodownID').find(":selected").text());

            $('#ddlSupplier').prop('disabled', true).empty().append("<option value='0'> Select PO & Supplier </option>");
            $('#ddlYarnMaterial').prop('disabled', true).empty().append("<option value='0'> Yarn Material </option>");
            $('#ddlYarnColor').prop('disabled', true).empty().append("<option value='0'> Yarn Color </option>");
            $('#ddlYarnCode').prop('disabled', true).empty().append("<option value='0'> Yarn Code </option>");
            $('#ddlBoxNo').prop('disabled', true).empty().append("<option value='0'> Box No </option>");

            var formData = new FormData();
            formData.append('GodownID', GodownID);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getLocationDetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        if (response.listGodownMaster.length > 0) {
                            $('#ddlLocation').empty();
                            $('#ddlLocationDetail').empty();
                            $('#ddlLocation').prop('disabled', false);
                            $('#ddlLocationDetail').prop('disabled', false);

                            var tempPartyName = "<option value='0'> Select Location </option>";
                            $('#ddlLocation').append(tempPartyName);
                            $('#ddlLocationDetail').append(tempPartyName);

                            for (var i = 0; i < response.listGodownMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listGodownMaster[i].GodownLocationID + "'> " + response.listGodownMaster[i].LocationTitle + " </option>";
                                $('#ddlLocation').append(tempPartyName);
                                $('#ddlLocationDetail').append(tempPartyName);
                            }
                        }
                    }
                },
                error: function (request, status, error) { }
            });
        }

        function OnChangeLocation(ddlGodownID) {
            onchangeYarnInterChange();

            $('#ddlYarnColor').prop('disabled', true).empty().append("<option value='0'> Yarn Color </option>");
            $('#ddlYarnCode').prop('disabled', true).empty().append("<option value='0'> Yarn Code </option>");
            $('#ddlBoxNo').prop('disabled', true).empty().append("<option value='0'> Box No </option>");
            $('#ddlYarnMaterial').prop('disabled', true).empty().append("<option value='0'> Yarn Material </option>");
            $('#ddlSupplier').prop('disabled', true).empty().append("<option value='0'> Select PO & Supplier   </option>");

            var formData = new FormData();
            formData.append('GodownID', ddlGodownID);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnMateraColorSupplier',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        if (response.listYarnPOMaster.length > 0) {
                            $('#ddlSupplier').empty().prop('disabled', false);
                            $('#ddlSupplier').append("<option value='0'> Select PO & Supplier </option>");
                            for (var i = 0; i < response.listYarnPOMaster.length; i++) {
                                $('#ddlSupplier').append("<option value='" + response.listYarnPOMaster[i].YarnPOID + "'> " + response.listYarnPOMaster[i].PONo + " - " + response.listYarnPOMaster[i].CompanyPartyName + " </option>");
                            }
                        } else {
                            $('#ddlSupplier').empty().prop('disabled', true).append("<option value='0' selected> Select PO & Supplier </option>");
                        }

                        if (response.listYarnMaterialMaster.length > 0) {
                            $('#ddlYarnMaterial').empty().prop('disabled', false);
                            $('#ddlYarnMaterial').append("<option value='0'> Yarn Material </option>");
                            for (var i = 0; i < response.listYarnMaterialMaster.length; i++) {
                                $('#ddlYarnMaterial').append("<option value='" + response.listYarnMaterialMaster[i].YarnMaterialID + "'> " + response.listYarnMaterialMaster[i].YarnMaterial + " </option>");
                            }
                        } else {
                            $('#ddlYarnMaterial').empty().prop('disabled', true).append("<option value='0' selected> Yarn Material </option>");
                        }

                        if (response.listYarnColorMaster.length > 0) {
                            $('#ddlYarnColor').empty().prop('disabled', false);
                            $('#ddlYarnColor').append("<option value='0'> Yarn Color </option>");
                            for (var i = 0; i < response.listYarnColorMaster.length; i++) {
                                $('#ddlYarnColor').append("<option value='" + response.listYarnColorMaster[i].YarnColorID + "'> " + response.listYarnColorMaster[i].YarnColor + " </option>");
                            }
                        } else {
                            $('#ddlYarnColor').empty().prop('disabled', true).append("<option value='0' selected> Yarn Color </option>");
                        }

                        if (response.listYarnPODetails.length > 0) {
                            $('#ddlYarnCode').empty().prop('disabled', false);
                            $('#ddlYarnCode').append("<option value='0'> Yarn Code </option>");
                            for (var i = 0; i < response.listYarnPODetails.length; i++) {
                                $('#ddlYarnCode').append("<option value='" + response.listYarnPODetails[i].YarnPODetailID + "'> " + response.listYarnPODetails[i].CompanyCode + " </option>");
                            }
                        } else {
                            $('#ddlYarnCode').empty().prop('disabled', true).append("<option value='0' selected> Yarn Code</option>");
                        }

                        if (response.listYarnInwardDetail.length > 0) {
                            $('#ddlBoxNo').empty().prop('disabled', false);
                            $('#ddlBoxNo').append("<option value='0'> Box No </option>");
                            for (var i = 0; i < response.listYarnInwardDetail.length; i++) {
                                $('#ddlBoxNo').append("<option value='" + response.listYarnInwardDetail[i].YarnInwardDetailID + "'> " + response.listYarnInwardDetail[i].BoxNo + " </option>");
                            }
                        } else {
                            $('#ddlBoxNo').empty().prop('disabled', true).append("<option value='0' selected> Box No</option>");
                        }
                    }
                },
                error: function (request, status, error) { }
            });
        }

        function onchangeYarnInterChange() {
            var ddlGodownID = $("#ddlGodownID").val();
            var YarnMaterialID = $("#ddlYarnMaterial").val();
            var YarnColorID = $("#ddlYarnColor").val();
            var GodownLocationID = $("#ddlLocation").val();
            var YarnPODetailIDCompanyCode = $("#ddlYarnCode").val();
            var YarnPOID = $("#ddlSupplier").val();
            var YarnInwardDetailID = $("#ddlBoxNo").val();
            var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val();

            if (ddlGodownID != 0 && ddlGodownID != "") {
                var formData = new FormData();
                formData.append('GodownID', ddlGodownID);
                formData.append('GodownLocationID', GodownLocationID);
                formData.append('YarnMaterialID', YarnMaterialID);
                formData.append('YarnColorID', YarnColorID);
                formData.append('YarnPODetailIDCompanyCode', YarnPODetailIDCompanyCode);
                formData.append('YarnPOID', YarnPOID);
