                                    tempInterChangeTbl += "<td>" + response.listYarnInterChangeMaster[i].NetWeight + "</td>";
                                    tempInterChangeTbl += "<td style='padding: 0; margin: 0; text-align: center;'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='Sift Yarn' onclick='yarnsift(" + response.listYarnInterChangeMaster[i].YarnInwardDetailID + ")'><img src='/img/arrow.png' title='Sift Yarn' style='width: 40%;'/></a></td>";
