@{
    Layout = "/_LayoutPage1.cshtml";
}


<div class="content-wrapper">
    <div class="toast position-fixed top-0 end-0 m-3" id="liveToast">
        <div class="toast-body bg-success text-white">
            Saved Successfully
        </div>
    </div>
    <div class="card-header-lg">
        <div class="modal fade" id="brokerModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title" id="brokerModalLabel">Add Broker</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" id="brokerForm">
                        <input type="hidden" id="BrokerId" value="0">
                        <div class="row">
                            <!-- Broker Code -->
                            <div class="col-2">
                                <div class="field-wrapper">
                                    <input type="text" class="form-control" id="BrokerCode" readonly>
                                    <div class="field-placeholder">Broker Code</div>
                                </div>
                            </div>

                            <!-- Broker Name -->
                            <div class="col-5">
                                <div class="field-wrapper">
                                    <input type="text" class="form-control" id="BrokerName">
                                    <div class="field-placeholder">Broker Name <span style="color:red">*</span></div>
                                    <div class="invalid-feedback">Broker Name is required</div>
                                </div>
                            </div>
                            <!-- Mobile -->
                            <div class="col-5">
                                <div class="field-wrapper">
                                    <input type="tel" class="form-control" id="MobileNo" maxlength="10" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                    <div class="field-placeholder">Mobile <span style="color:red">*</span></div>
                                    <div class="invalid-feedback">Enter valid 10-digit mobile number</div>
                                </div>
                            </div>

                            <!-- Address -->
                            <div class="col-5">
                                <div class="field-wrapper">
                                    <input type="text" class="form-control" id="Address">
                                    <div class="field-placeholder">Address</div>
                                </div>
                            </div>
                            <!-- City -->
                            <div class="col-2">
                                <div class="field-wrapper">
                                    <input type="text" class="form-control" id="CityName">
                                    <div class="field-placeholder">City</div>
                                </div>
                            </div>
                            <!-- Commission -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <input type="number" class="form-control" id="CommissionRate" maxlength="3" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                    <div class="field-placeholder">Commission (%)</div>
                                </div>
                            </div>
                            <!-- Status -->
                            <div class="col-2">
                                <div class="field-wrapper">
                                    <select class="form-control" id="IsActive">
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                    <div class="field-placeholder">Status</div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- Footer -->
                    <div class="modal-footer" id="brokerForm">
                        <button type="button" id="saveBtn" class="btn btn-success px-4" onclick="saveBroker()">
                            <span id="btnText">Save</span>
                            <span id="btnLoader" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>                      
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>

                </div>
            </div>
        </div>

        <button class="btn btn-primary" style="float:right;" data-bs-toggle="modal" data-bs-target="#brokerModal">
            <i class="fa fa-plus"></i> Add Broker
        </button>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Broker Master</div>
                    <div class="table-responsive">
                        <table id="tblBroker" class="table table-bordered table-striped w-100">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Row end -->
</div>

<script>

    var currentPagePermission = {};
    $(document).ready(function () {
        var permission = sessionStorage.getItem("PagePermission");
        if (permission != null) {
            currentPagePermission = JSON.parse(permission);
            console.log("currentPagePermission", currentPagePermission);
            if (currentPagePermission.Add == false) {
                $("#AddFinacialYearModel").hide();
            }
        }

        FunctionIsLogin();
        LoadBrokerList();
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });

    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {        

                notes.show(request.statusText, {
                    type: 'danger',
                    
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function LoadBrokerList() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetBrokerList",
            type: "POST",
            data: "{}",
            contentType: "application/json",
            dataType: "json",
            success: function (res) {

                var data = res.d;

                if (typeof data === "string") {
                    data = JSON.parse(data);
                }
                console.log("LoadBrokerList", res);
                bindBrokerTable(data);
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
    function bindBrokerTable(data) {

        if ($.fn.DataTable.isDataTable('#tblBroker')) {
            $('#tblBroker').DataTable().clear().destroy();
        }
        $('#tblBroker').DataTable({
            data: data,
            autoWidth: false,   // 🔥 important

            columns: [
                { data: "BrokerCode", title: "Broker Code" },
                { data: "BrokerName", title: "Broker Name" },
                { data: "MobileNo", title: "Mobile" },

                {
                    data: "Address",
                    title: "Address",
                    render: function (data) {
                        return `<div style="white-space:normal;">${data || '-'}</div>`;
                    }
                },

                { data: "CityName", title: "City" },

                {
                    data: "CommissionRate",
                    title: "Commission (%)",
                    render: d => parseFloat(d).toFixed(2)
                },

                {
                    data: "IsActive",
                    title: "Status",
                    className: "text-center",
                    render: d => d
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-danger">Inactive</span>'
                },

                {
                    data: "BrokerId",
                    title: "Action",
                    className: "text-center",
                    orderable: false,
                    render: function (id, type, row) {
                        let actionHtml = '';
                        // EDIT
                        if (currentPagePermission.Edit == true || currentPagePermission.Edit == "true") {
                            actionHtml += `<i class="fa fa-edit text-primary edit me-2" style="cursor:pointer;" title="Edit" data-id="${id}"></i>`;
                        }
                        // VIEW
                        if (currentPagePermission.View == true || currentPagePermission.View == "true") {
                            actionHtml += `<i class="fa fa-eye text-dark view me-2" style="cursor:pointer;" title="View" data-id="${id}"> </i>`;
                        }
                        // DELETE
                        if (currentPagePermission.Delete == true || currentPagePermission.Delete == "true") {
                            actionHtml += `<i class="fa fa-trash text-danger delete" style="cursor:pointer;" title="Delete" data-id="${id}"> </i>`;
                        }
                        return actionHtml;
                    }                    
                }
            ],

            responsive: true,
            pageLength: 10,
            lengthChange: false,
            info: false,
            ordering: false
        });       
    }
    $('#brokerModal').on('show.bs.modal', function () {

        if ($('#BrokerId').val() == 0) {

            $.ajax({
                url: '/WebServiceNikunjTextile.asmx/GetNextBrokerCode',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: '{}', // MUST for ASMX

                success: function (response) {
                    $('#BrokerCode').val(response.d); // ⚠️ .d required
                },
                error: function (err) {
                    console.log(err);
                }
            });

        }

    });
    $('#brokerModal').on('hidden.bs.modal', function () {
        $(this).find('input, textarea').val('');
        $(this).find('input[type="checkbox"]').prop('checked', false);
        $(this).find('select').val(null).trigger('change');
    });
    $('.form-control').on('input', function () {
        $(this).removeClass('is-invalid');
    });
    $('#tblBroker').on('click', '.edit', function () {
        let id = $(this).data('id');
        getBrokerById(id, "edit");
    });
    $('#tblBroker').on('click', '.view', function () {
        let id = $(this).data('id');       
        getBrokerById(id, "view");
    });
    $('#tblBroker').on('click', '.delete', function () {
        let id = $(this).data('id');
        deleteBroker(id);
    });
    function getBrokerById(id, mode) {

        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/GetBrokerById',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify({ BrokerId: id }),

            success: function (res) {

                let data = res.d;

                // Fill form
                $('#BrokerId').val(data.BrokerId);
                $('#BrokerCode').val(data.BrokerCode);
                $('#BrokerName').val(data.BrokerName);
                $('#MobileNo').val(data.MobileNo);
                $('#Address').val(data.Address);
                $('#CityName').val(data.CityName);
                $('#CommissionRate').val(data.CommissionRate);
                $('#IsActive').val(data.IsActive.toString());



                if (mode === "view") {
                    $("#brokerModal input, #brokerModal select, #brokerModal textarea").prop("disabled", true);
                    $('#brokerModalLabel').text("View Broker");
                    $("#saveBtn").hide(); // hide save button
                } else {
                    $("#brokerModal input, #brokerModal select, #brokerModal textarea").prop("disabled", false);
                    $('#brokerModalLabel').text("Edit Broker");
                    $("#saveBtn").show();
                }
              $('#brokerModal').modal('show');
            }
        });
    }
    function deleteBroker(id) {

        Swal.fire({
            title: "Are you sure?",
            text: "You want to delete this broker!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel"
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '/WebServiceNikunjTextile.asmx/DeleteBroker',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ BrokerId: id }),

                    success: function (res) {

                        if (res.d === "success") {

                            Swal.fire("Deleted!", "Broker removed successfully", "success");

                            LoadBrokerList(); // 🔄 reload table

                        } else {
                            Swal.fire("Error", res.d, "error");
                        }
                    }
                });

            }

        });
    }
    function showToast(type, msg) {
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: type,
            title: msg,
            showConfirmButton: false,
            timer: 2000
        });
    }
    function saveBroker() {

        let isValid = true;

        $('.form-control').removeClass('is-invalid');

        let mobile = $('#MobileNo').val().trim();

        // Broker Name
        if (!$('#BrokerName').val().trim()) {
            $('#BrokerName').addClass('is-invalid');
            isValid = false;
        }

        // Mobile Required
        if (!mobile) {
            $('#MobileNo').addClass('is-invalid');
            isValid = false;
        }
        // Mobile Format Check
        else if (!/^[6-9]\d{9}$/.test(mobile)) {
            $('#MobileNo').addClass('is-invalid');
            $('#MobileNo').siblings('.invalid-feedback').text("Invalid mobile number");
            isValid = false;
        }

        if (!isValid) return;
        $("#btnText").text("Saving...");
        $("#btnLoader").removeClass("d-none");
        $("#saveBtn").prop("disabled", true);
        var obj = {
            BrokerId: $('#BrokerId').val(),
            BrokerCode: $('#BrokerCode').val(),
            BrokerName: $('#BrokerName').val(),
            MobileNo: mobile,
            Address: $('#Address').val(),
            CityName: $('#CityName').val(),
            CommissionRate: $('#CommissionRate').val() || 0,
            IsActive: $('#IsActive').val() === "true"
        };

        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/SaveBroker',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify({ obj: obj }),

            success: function (res) {

                // Reset loader
                $("#btnText").text("Save");
                $("#btnLoader").addClass("d-none");
                $("#saveBtn").prop("disabled", false);

                // ✅ HANDLE RESPONSE
                if (res.d === "success") {

                    showToast('success','Broker details saved successfully.');
                    $('#brokerModal').modal('hide');
                    LoadBrokerList();

                } else {

                    // 🔥 SHOW SERVER MESSAGE
                    showToast('error', res.d);

                }
            }
        });
    }

</script>







