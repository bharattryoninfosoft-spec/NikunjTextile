@{
    Layout = "/_LayoutPage1.cshtml";
}




<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <div class="modal fade" id="brokerModal">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Add Broker</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden" id="BrokerId">

                        <div class="mb-2">
                            <label>Broker Code</label>
                            <input type="text" id="BrokerCode" class="form-control">
                        </div>

                        <div class="mb-2">
                            <label>Broker Name</label>
                            <input type="text" id="BrokerName" class="form-control">
                        </div>

                        <div class="mb-2">
                            <label>Firm Name</label>
                            <input type="text" id="FirmName" class="form-control">
                        </div>

                        <div class="mb-2">
                            <label>Mobile</label>
                            <input type="text" id="MobileNo" class="form-control">
                        </div>

                        <div class="mb-2">
                            <label>City</label>
                            <input type="text" id="CityName" class="form-control">
                        </div>

                        <div class="mb-2">
                            <label>Commission %</label>
                            <input type="number" id="CommissionRate" class="form-control">
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-success" onclick="saveBroker()">Save</button>
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- Row start -->
    <div class="row gutters">      
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <button style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#brokerModal">
                        <i class="fa fa-plus"></i> Add Broker
                    </button>
                    <br />
                    <br />
                    <div class="form-section-header">Broker Master</div>

                    <div class="table-responsive">
                        <table id="tblBroker" class="table table-bordered table-striped w-100">
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


