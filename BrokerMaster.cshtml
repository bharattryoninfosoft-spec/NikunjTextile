<script>
    document.title = "Broker Master - Nikunj Textile";
</script>
<script>

    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#master-tab").addClass("active");
        $("#tab-Master").addClass("show active");
        $("#aBrokerMaster").addClass("current-page");
        FunctionIsLogin();
        LoadBrokerList();
      });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function LoadBrokerList() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetBrokerList",
            type: "POST",
            data: "{}",
            contentType: "application/json",
            dataType: "json",
            success: function (res) {

                var data = res.d;

                if (typeof data === "string") {
                    data = JSON.parse(data);
                }
                console.log("LoadBrokerList", res);
                bindBrokerTable(data);
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
    function bindBrokerTable(data) {

        if ($.fn.DataTable.isDataTable('#tblBroker')) {
            $('#tblBroker').DataTable().clear().destroy();        }

        $('#tblBroker').DataTable({
            data: data,
            columns: [
                { data: "BrokerId", title: "ID" },
                { data: "BrokerCode", title: "Code" },
                { data: "BrokerName", title: "Name" },
                { data: "FirmName", title: "Firm" },
                { data: "MobileNo", title: "Mobile" },
                { data: "CityName", title: "City" },
                { data: "CommissionRate", title: "Commission %" },
                {
                    data: "IsActive",
                    title: "Status",
                    render: function (data) {
                        return data ? '<span class="badge bg-success">Active</span>'
                            : '<span class="badge bg-danger">Inactive</span>';
                    }
                },
                {
                    data: "BrokerId",
                    title: "Action",
                    render: function (data) {
                        return `
                            
                            <i class="fa fa-edit text-primary edit" data-id="${data}" style="cursor:pointer; margin-right:10px;" title="Edit"></i>
                            <i class="fa fa-eye text-secondary view" data-id="${data}" style="cursor:pointer; margin-right:10px;" title="View"></i>
                            
                            <i class="fa fa-trash text-danger delete" data-id="${data}" style="cursor:pointer;" title="Delete"></i>
                        `;
                    }
                }
           
            ],
            responsive: true,
            pageLength: 10,
            lengthChange: false,
            info: false
        });
    }  
</script>



