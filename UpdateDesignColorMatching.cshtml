                tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                tempColorMatching += '<div id="tdMatchingWarp' + ArrayNo + colNo + '" style="width: 35px;height: 35px; border-radius:3px; background-color:' + bgColor + '"></div>';
                tempColorMatching += '<select id="MatchingWarp' + ArrayNo + colNo + '" class="form-control no-select2" style="min-height: 30px; width: 90%; font-size: x-small;" ' + (waColor > 0 ? 'onfocusout="validate(this)" ' : '') + 'onchange="WarpMatchingChange(\'' + ArrayNo + '_' + colNo + '\')">';
                tempColorMatching += '<option value="" selected> Select Color </option>';
                for (var k = 0; k < ArrayYarnColor[0].length; k++) {
                    var selectedAttr = (SelectMatchingWarp == ArrayYarnColor[0][k].YarnColorID) ? " selected" : "";
                    tempColorMatching += "<option value='" + ArrayYarnColor[0][k].YarnColorID + "'" + selectedAttr + "> " + ArrayYarnColor[0][k].YarnColor + " </option>";
                }
                tempColorMatching += '</select>';
                tempColorMatching += '</div>';
                tempColorMatching += '</td>';
            }

            tempColorMatching += '<td style="background-color: #c8d3df;"><br /></td>';

            for (var weColor = 0; weColor < weftLength; weColor++) {
                var colNo = weColor + 1;
                var spanmatchingID = "#matchingWeft" + PreviosMatchingID + "ID";
                var bgColor = $("#tdMatchingWeft" + PreviosMatchingID + colNo).css("background-color");
                var SelectMatchingWeft = $("#MatchingWeft" + PreviosMatchingID + colNo).val();

                tempColorMatching += '<td>';
                tempColorMatching += '<br />';
                tempColorMatching += '<span style="margin-left: 5px; font-weight: 600; color: #1273eb; display:none;" id="matchingWeft' + ArrayNo + 'ID">' + $(spanmatchingID).html() + '</span>';
                tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                tempColorMatching += '<div id="tdMatchingWeft' + ArrayNo + colNo + '" style="width: 35px;height: 35px; border-radius:3px; background-color:' + bgColor + '"></div>';
                tempColorMatching += '<select id="MatchingWeft' + ArrayNo + colNo + '" class="form-control no-select2" onfocusout="validate(this)" style="min-height: 30px; width: 90%; font-size: x-small;" onchange="WeftMatchingChange(\'' + ArrayNo + '_' + colNo + '\')">';
                tempColorMatching += '<option value="" selected> Select Color </option>';
                for (var k = 0; k < ArrayYarnColor[0].length; k++) {
                    var selectedAttr = (SelectMatchingWeft == ArrayYarnColor[0][k].YarnColorID) ? " selected" : "";
                    tempColorMatching += "<option value='" + ArrayYarnColor[0][k].YarnColorID + "'" + selectedAttr + "> " + ArrayYarnColor[0][k].YarnColor + " </option>";
                }
                tempColorMatching += '</select>';
                tempColorMatching += '</div>';
                tempColorMatching += '</td>';
            }

            tempColorMatching += '</tr>';

            $("#txtColorArray").val(txtColorArray + ArrayNo + "|");
            $("#tblColorMatching").append(tempColorMatching);

            mergerAllMatchingID();
        }

        // Warp Matching
        function WarpMatchingChange(abc) {
            const warpLength = +$("#warpLength").val();
            const [rowNo, DDlNo] = abc.split('_');
            const Mat = `#MatchingWarp${rowNo}${DDlNo}`;
            const TableData = `#tdMatchingWarp${rowNo}${DDlNo}`;
            const getSelectedText = id => $.trim($(id + " option:selected").text());
            const cleanValue = val => val.replace(/\/+$/, "");
            const getChkArray = () =>
                Array.from({ length: warpLength - 1 }, (_, i) => i + 2)
                    .filter(no => $(`#chkwarp${no}`).prop('checked'))
                    .join("|");

            const val = $(Mat).val();
            if (!val) {
                $(TableData).css("background-color", "");
            } else {
                const color = ArrayYarnColor[0].find(c => c.YarnColorID == val)?.YarnColorCode;
                if (color) $(TableData).css("background-color", `#${color}`);
            }

            const buildMatching = (Did) => {
                if (!$(Mat).val()) return "";
                const chkArray = getChkArray().split('|').filter(Boolean);
                let ids = getSelectedText(`#MatchingWarp${Did}1`) + "/";
                chkArray.forEach(no => {
                    ids += getSelectedText(`#MatchingWarp${Did}${no}`) + "/";
                });
                return cleanValue(ids);
            };

            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            txtColorData.forEach((_, i) => {
                const Did = i + 1;
                const matchVal = buildMatching(Did);
                $(`#matching${Did}ID`).html(matchVal);
            });

            mergerAllMatchingID();
        }

        function onchangeCHKWarp() {
            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            const warpLength = +$("#warpLength").val();
            const cleanValue = (val) => val.replace(/\/+$/, "");
            const getSelectedText = (id) => $.trim($(id + " option:selected").text());

            txtColorData.forEach((_, d) => {
                const Did = d + 1;
                const matchingID = "#matching" + Did + "ID";

                let chkArray = [];
                for (let wa = 1; wa <= warpLength; wa++) {
                    const Mat = "#MatchingWarp" + Did + wa;
                    if (!$(Mat).val()) {
                        validate(document.getElementById("MatchingWarp" + Did + wa));
                    } else if ($("#chkwarp" + wa).prop("checked")) {
                        chkArray.push(wa);
                    }
                }

                let MatchingWarpID = getSelectedText("#MatchingWarp" + Did + "1") + "/";
                chkArray.forEach((wa, i) => {
                    if (!(i === 0 && wa === 1)) {
                        MatchingWarpID += getSelectedText("#MatchingWarp" + Did + wa) + "/";
                    }
                });

                MatchingWarpID = cleanValue(MatchingWarpID);
                $(matchingID).html(MatchingWarpID);
            });

            mergerAllMatchingID();
        }

        function CheckWarpDuplicates(ColorMatchingArray) {
            $("#spanWarpDuplicate").html('');
            var seen = {};
            $.each(ColorMatchingArray, function (i, obj) {
                var value = Object.values(obj)[0];
                var key = Object.keys(obj)[0];

                if (seen[value]) {
                    $("#spanWarpDuplicate").append(`<div>Duplicate Found: ${seen[value]} and ${key}</div>`);
                    return;
                } else {
                    seen[value] = key;
                }
            });
        }

        // Weft Feeder Matching
        function WeftMatchingChange(abc) {
            const [rowNo, DDlNo] = abc.split('_');
            const weftLength = +$("#weftLength").val();
            const Mat = `#MatchingWeft${rowNo}${DDlNo}`;
            const TableData = `#tdMatchingWeft${rowNo}${DDlNo}`;

            const selectedVal = $(Mat).val();
            if (!selectedVal) {
                $(TableData).css("background-color", "");
            } else {
                const match = ArrayYarnColor[0].find(c => c.YarnColorID == selectedVal);
                if (match) $(TableData).css("background-color", `#${match.YarnColorCode}`);
            }

            let missing = [], checked = [];
            for (let i = 1; i <= weftLength; i++) {
                const chk = $(`#chkweft${i}`);
                if (!chk.length) missing.push(i);
                else if (chk.prop('checked')) checked.push(i);
            }

            const getDDLText = i => $.trim($(`#MatchingWeft${rowNo}${i} option:selected`).text());
            const allSelected = [...missing, ...checked].map(getDDLText).filter(Boolean).join('/');
            $(`#matchingWeft${rowNo}ID`).html(allSelected);

            mergerAllMatchingID();
        }

        function onchangeCHKWeft() {
            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            const weftLength = +$("#weftLength").val();

            let missing = [], checked = [];
            for (let i = 1; i <= weftLength; i++) {
                const chk = $(`#chkweft${i}`);
                if (!chk.length) missing.push(i);
                else if (chk.prop('checked')) checked.push(i);
            }

            const getDDLText = (row, i) =>
                $.trim($(`#MatchingWeft${row}${i} option:selected`).text());

            txtColorData.forEach((_, idx) => {
                const Did = 1;
                for (let wa = 1; wa <= weftLength; wa++) {
                    const Mat = "#MatchingWeft" + Did + wa;
                    if (!$(Mat).val()) {
                        validate(document.getElementById("MatchingWeft" + Did + wa));
                    }
                }

                const rowNo = idx + 1;
                const ddlValues = [...missing, ...checked]
                    .map(i => getDDLText(rowNo, i))
                    .filter(Boolean)
                    .join('/');

                $(`#matchingWeft${rowNo}ID`).html(ddlValues);
            });

            mergerAllMatchingID();
        }

        function CheckWeftDuplicates(ColorMatchingArray) {
            $("#spanFeederDuplicate").html('');
            var seen = {};
            $.each(ColorMatchingArray, function (i, obj) {
                var value = Object.values(obj)[0];
                var key = Object.keys(obj)[0];

                if (seen[value]) {
                    $("#spanFeederDuplicate").append(`<div>Duplicate Found: ${seen[value]} and ${key}</div>`);
                    return;
                } else {
                    seen[value] = key;
                }
            });
        }

        function mergerAllMatchingID() {
            const ColorMatchingArray = [];
            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');

            for (var i = 0; i < txtColorData.length; i++) {
                var rowNo = i + 1;
                var matchingID = "#matching" + txtColorData[i] + "ID";
                var matchingWeftID = "#matchingWeft" + txtColorData[i] + "ID";

                var marchingDDLValue = $(matchingID).html() + "/" + $(matchingWeftID).html();
                var MatId = "Matching " + rowNo;

                let myObject = {};
                myObject[MatId] = marchingDDLValue;
                ColorMatchingArray.push(myObject);
            }

            CheckDuplicatesArray(ColorMatchingArray);
        }

        function CheckDuplicatesArray(ColorMatchingArray) {
            $("#spanDuplicate").html('');
            var seen = {};
            $.each(ColorMatchingArray, function (i, obj) {
                var value = Object.values(obj)[0];
                var key = Object.keys(obj)[0];

                if (seen[value]) {
                    $("#spanDuplicate").append(`<div>Duplicate Found: ${seen[value]} and ${key}</div>`);
                    return;
                } else {
                    seen[value] = key;
                }
            });
        }

        function deleteColorMatchingData(abc) {
            if ($("#trMatching" + abc).attr("data-locked") === "1") {
                Swal.fire({
                    icon: 'info',
                    title: 'Locked Row',
                    text: 'This color matching row is already validated and cannot be deleted.'
                });
                return;
            }

            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this color matching row!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var trMatching = "#trMatching" + abc;
                    var replace = abc + "|";
                    var ColorArray = $("#txtColorArray").val();

                    var DesignColorMatchingDetailsID = "#txtDesignColorMatchingDetailsID" + abc;
                    var DCMDID = $(DesignColorMatchingDetailsID).val() + ",";
                    var DeleteColorArray = $("#txtDeleteColorArray").val();

                    if ($(DesignColorMatchingDetailsID).val() != "0") {
                        $("#txtDeleteColorArray").val(DeleteColorArray + DCMDID);
                    }

                    $(trMatching).remove();
                    $("#txtColorArray").val(ColorArray.replace(replace, ''));

                    Swal.fire(
                        'Deleted!',
                        'Row has been deleted.',
                        'success'
                    );
                }
            });
        }

        function checkSave() {
            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            const ColorArray = $("#txtColorArray").val();
            const warpLength = parseInt($("#warpLength").val());
            const weftLength = parseInt($("#weftLength").val());
            const DesignNo = $("#DesignNo").val();

            let WarpCheckBox = "", WeftCheckBox = "";
            let ColorMatchingArray = [];
            let hasValidationError = false;

            const lastColorNo = parseInt(txtColorData[txtColorData.length - 1]);

            for (let i = 0; i < warpLength; i++) {
                const Sno = i + 1;
                const el = document.getElementById("MatchingWarp" + lastColorNo + Sno);
                if (!validate(el)) hasValidationError = true;
                WarpCheckBox += $("#chkwarp" + Sno).is(':checked') ? "1|" : "0|";
            }

            for (let i = 0; i < weftLength; i++) {
                const Sno = i + 1;
                const el = document.getElementById("MatchingWeft" + lastColorNo + Sno);
                if (!validate(el)) hasValidationError = true;
                WeftCheckBox += $("#chkweft" + Sno).is(':checked') ? "1|" : "0|";
            }

            if (hasValidationError) {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: 'Please fill all required fields properly!'
                });
                return;
            }

            let seen = {}, isDuplicate = false;
            $("#spanDuplicate").html('');

            txtColorData.forEach((colorNo, index) => {
                const id = "#matching" + colorNo + "ID";
                const weftId = "#matchingWeft" + colorNo + "ID";
                const value = $(id).html() + "/" + $(weftId).html();
                const key = "Matching " + (index + 1);

                let obj = {};
                obj[key] = value;
                ColorMatchingArray.push(obj);

                if (seen[value]) {
                    isDuplicate = true;
                    $("#spanDuplicate").append(`<div>Duplicate Found: ${seen[value]} and ${key}</div>`);
                } else {
                    seen[value] = key;
                }
            });

            if (isDuplicate) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Duplicate Found',
                    text: 'Please check for duplicate matching combinations!'
                });
                return;
            }

            let WarpFeederArray = txtColorData.map(MatchingNo => {
                let obj = {
                    MatchingNo,
                    WarpMatchingID: $("#matching" + MatchingNo + "ID").html(),
                    FeederMatchingID: $("#matchingWeft" + MatchingNo + "ID").html()
                };

                for (let i = 0; i < warpLength; i++) {
                    obj["Warp" + (i + 1)] = $("#MatchingWarp" + MatchingNo + (i + 1)).val();
                }

                for (let i = 0; i < weftLength; i++) {
                    obj["Feeder" + (i + 1)] = $("#MatchingWeft" + MatchingNo + (i + 1)).val();
                }

                return obj;
            });

            const DesignColorMatchingArray = JSON.stringify({
                DesignEntryFormID: DesignNo.split("|")[0],
                TotalWarp: warpLength,
                TotalWeft: weftLength,
                ColorArray: ColorArray,
                WarpCheckBox: WarpCheckBox.slice(0, -1),
                WeftCheckBox: WeftCheckBox.slice(0, -1),
                listDesignColorMatchingDetails: WarpFeederArray
            });

            const formData = new FormData();
            formData.append('ColorFormArray', DesignColorMatchingArray);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertDesignColorMatchingFormMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Color Matching Created Successfully.',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = 'ColorMatching';
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Oops...', text: response.Message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Problem occurred while submitting your data.' });
                }
            });
        }

        function checkUpdate() {
            Swal.fire({
                title: 'Update Color Matching?',
                text: "Do you want to save the changes made?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
