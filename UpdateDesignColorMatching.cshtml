@{
    Layout = "/_LayoutPage1.cshtml";
}
<style>
    /* Hide Export Buttons */
    .dt-buttons,
    .dataTables_wrapper .dt-buttons {
        display: none !important;
    }

    /* Hide Search Box */
    .dataTables_filter {
        display: none !important;
    }

    /* Hide "Showing x to y of z entries" */
    .dataTables_info {
        display: none !important;
    }

    /* Hide Pagination */
    .dataTables_paginate {
        display: none !important;
    }

    /* Hide "Show Entries" Dropdown */
    .dataTables_length {
        display: none !important;
    }

    table, th, td {
        border: none;
    }

    table {
        border-collapse: collapse;
    }
</style>
<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Update Design Color Matching Form</div>
                    <br />
                    <!--Images-->
                    <div class="row gutters">
                        <div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 col-12">
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <!-- Field wrapper start -->
                            <div id="dropzone-sm" class="mb-3 image-upload-clear-image">
                                <div class="dropzone needsclick dz-clickable" id="demo-upload">
                                    <div class="dz-message needsclick" style="text-align: center; margin-top: 54px;"><label id="upload-PhotoOfDesign-default-preview" for="upload-PhotoOfDesign-default">Photo Of Design.</label></div>
                                </div>
                            </div>
                            <!-- Field wrapper end -->
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                            <!-- Field wrapper start -->
                            <div id="dropzone-sm">
                                <input type="hidden" id="txtDesignColorMatchingFormID" class="form-control" />

                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <div class="form-section-header" style=" margin: 0; padding: 0.3rem 0.9rem; background: #689de7;">Design No</div>
                                    </div>
                                    <div class="col-6">
                                        <select class="form-control no-select2" style="min-height: 35px;" id="DesignNo" onchange="getDesignNo(this)" disabled>
                                            <option value="">Select Design No</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <span>Pick On Loom</span>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="PickOnLoom" name="PickOnLoom" class="form-control" title="Pick On Loom" placeholder="Pick On Loom" style="min-height: 35px;" readonly />
                                    </div>
                                </div>

                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <span>Total Card</span>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="TotalCard" name="TotalCard" class="form-control" title="Total Card" placeholder="Total Card" style="min-height: 35px;" readonly />
                                    </div>
                                </div>

                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <span>Design Category</span>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="DesignCategory" name="DesignCategory" class="form-control" title="Design No" placeholder="Design No" style="min-height: 35px;" readonly />
                                    </div>
                                </div>
                            </div>
                            <!-- Field wrapper end -->
                        </div>
                    </div>

                    <input type="hidden" id="txtWarpData" value="1|" />
                    <input type="hidden" id="txtWeftData" value="1|" />

                    <hr />

                    <!--Weft Data -->
                    <div class="row gutters">
                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12">
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <div id="divExistingDesignNo" style="display:none;">
                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <div class="form-section-header" style=" margin: 0; padding: 0.3rem 0.9rem; background: #689de7;">Import Existing Design No</div>
                                    </div>
                                    <div class="col-6">
                                        <select class="form-control no-select2" style="min-height: 35px;" id="ExistingDesignNo" onchange="getExistingDesignNo(this)">
                                            <option value="">Select Design No</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <br />
                            <br />
                            <div class="table-responsive" id="divColorMatchingTable"></div>
                            <br />
                            <br />
                        </div>
                    </div>

                    <input type="hidden" id="txtColorArray" title="txtColorArray" />
                    <input type="hidden" id="warpLength" title="warpLength" />
                    <input type="hidden" id="weftLength" title="weftLength" />
                    <input type="hidden" id="txtDeleteColorArray" title="DeleteColorArray" />

                    <div id="divMatchingColor"></div>

                    <div class="row gutters" id="divAddColorMatching" style="display:none;">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" id="divWarpData">
                            <div class="row gutters">
                                <div class="row gutters">
                                    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-12">
                                    </div>
                                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                        <button type="button" class="btn btn-secondary" style=" width: 100%;" onclick="AddColorMatchingData()"><i class="fa fa-plus"></i> ADD COLOR MATCHING DATA</button>
                                    </div>
                                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                        <button type="button" class="btn btn-success" style=" width: 100%;" onclick="AddDuplicateColorMatchingData()"><i class="fa fa-plus"></i> ADD DUPLICATE COLOR MATCHING</button>
                                    </div>
                                    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-12">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="modal-footer">
                        <a href="ColorMatching" class="btn btn-light" style="font-size: medium;"><i class="fa fa-arrow-left"></i>Back</a>
                        <button id="savebtn" type="button" class="btn btn-primary" onclick="checkSave()" style="font-size: medium;">Save Color Matching</button>
                        <button id="Updatebtn" type="button" class="btn btn-primary" onclick="checkUpdate()" style="font-size: medium; display:none;">Update Color Matching</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Content wrapper end -->

@section Scripts {
    <script>
        $('body').addClass('fullscreen');
        $(document).ready(function () {
            $('.active, .show, .current-page').removeClass('active show current-page');

            $("#EntryForm-tab").addClass("active");
            $("#tab-EntryForm").addClass("show active");
            $("#aCreateDesignColorMatching").addClass("current-page");

            FunctionIsLogin();
            getDesignEntryForm();
            getYarnColor();
        });

        var notes = $('#notes').notify({
            removeIcon: '<i class="icon-close"></i>'
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request) {
                    notes.show(request.statusText, {
                        type: 'danger'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#Updatebtn").hide();
            $("#addNewContactLabel").html("Add Design Entry Form");
            $("#add-alert").hide();

            $("#YarnColor").val('');

            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();

            if (code.value == "0" || code.value == "") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }

        function isRowValidated(detail) {
            if (!detail) return false;
            var flag = detail.IsValidated !== undefined
                ? detail.IsValidated
                : (detail.isValidated !== undefined ? detail.isValidated : detail.IsColorMatchingValidated);
            return flag === true || flag === 1 || flag === "1" || String(flag).toLowerCase() === "true";
        }

        function getDesignEntryForm() {
            var formData = new FormData();

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getDesignNoUpdateForm',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        var DesignColorMatchingFormIDs = "";
                        var designNo = "";

                        if (response.listDesignEntryForm.length > 0) {
                            var tempDesignNo = "<option value=''> Select Designer No </option>";
                            $('#DesignerID').append(tempDesignNo);

                            for (var i = 0; i < response.listDesignEntryForm.length; i++) {
                                DesignColorMatchingFormIDs = response.listDesignEntryForm[i].DesignColorMatchingFormIDs;

                                if (DesignColorMatchingFormIDs != "0") {
                                    if (DesignColorMatchingFormIDs == response.listDesignEntryForm[i].DesignColorMatchingFormID) {
                                        designNo = response.listDesignEntryForm[i].DesignEntryFormID + "|" + response.listDesignEntryForm[i].DesignColorMatchingFormID;
                                        tempDesignNo = "<option value='" + response.listDesignEntryForm[i].DesignEntryFormID + "|" + response.listDesignEntryForm[i].DesignColorMatchingFormID + "' selected> " + response.listDesignEntryForm[i].DesignerCode + response.listDesignEntryForm[i].DesignNo + " </option>";
                                        $('#DesignNo').append(tempDesignNo);
                                    }
                                }

                                tempDesignNo = "<option value='" + response.listDesignEntryForm[i].DesignEntryFormID + "|" + response.listDesignEntryForm[i].DesignColorMatchingFormID + "'> " + response.listDesignEntryForm[i].DesignerCode + response.listDesignEntryForm[i].DesignNo + " </option>";
                                $('#DesignNo').append(tempDesignNo);
                            }
                        }

                        if (DesignColorMatchingFormIDs != "0") {
                            getCookieDesignNo(designNo);
                        }
                    }
                }
            });
        }

        var ArrayYarnColor = [];
        function getYarnColor() {
            var formData = new FormData();

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMatching',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    ArrayYarnColor.push(response.listYarnColorMaster);
                }
            });
        }

        function buildColorMatchingTableHtml(dataItem, isEditMode) {
            var weftLength = dataItem.TotalWeft;
            var warpLength = dataItem.TotalWarp;
            var WarpCheckBox = dataItem.WarpCheckBox;
            var WeftCheckBox = dataItem.WeftCheckBox;
            var sumWarpWeft = parseInt(warpLength) + parseInt(weftLength);

            if (sumWarpWeft <= 0) {
                return { html: "", editColorArray: "" };
            }

            var html = "";
            html += '<table id="copy-print-csvs" class="table table-hover table-bordered m-0">';
            html += '<thead>';

            // Table Heading
            html += '<tr>';
            html += '<th><br /></th>';

            for (var wa = 0; wa < warpLength; wa++) {
                var no = parseInt(wa) + parseInt(1);
                html += '<th>';
                html += '<div class="field-wrapper" style="margin-bottom: 5px; margin-top:0;">';
                html += '<span class="field-placeholder" style="border: 1px solid black; border-radius: 0; padding: 0px 12px 0px 12px; width: 90%; text-align: center;">WARP-' + no + '</span>';
                html += '</div>';
                html += '</th>';
            }

            html += '<th style="background-color: #c8d3df;"><br /></th>';

            for (var we = 0; we < weftLength; we++) {
                var no = parseInt(we) + parseInt(1);
                html += '<th>';
                html += '<div class="field-wrapper" style="margin-bottom: 5px; margin-top: 0;">';
                html += '<span class="field-placeholder" style="border: 1px solid black; border-radius: 0; padding: 0px 12px 0px 12px; width: 90%; text-align: center;">FEEDER-' + no + '</span>';
                html += '</div>';
                html += '</th>';
            }

            html += '</tr>';

            // Table CheckBox
            html += '<tr>';
            html += '<th><br /></th>';

            for (var wach = 0; wach < warpLength; wach++) {
                var wchk = WarpCheckBox.split("|")[wach];
                var no = parseInt(wach) + parseInt(1);
                if (wach == 0) {
                    html += '<th></th>';
                }
                else {
                    html += '<th>';
                    html += '<center>';
                    html += '<input class="form-check-input" type="checkbox" id="chkwarp' + no + '" style="transform: scale(1.3);" onchange="onchangeCHKWarp()"' + (wchk == "1" ? " checked" : "") + '>';
                    html += '</center>';
                    html += '</th>';
                }
            }

            html += '<th style="background-color: #c8d3df;"><br /></th>';

            for (var wech = 0; wech < weftLength; wech++) {
                var no = parseInt(wech) + parseInt(1);
                var wchk = WeftCheckBox.split("|")[wech];
                if (dataItem.listDesignEntryWeftData[wech].DesignSpecification == "GROUND") {
                    html += '<th></th>';
                }
                else {
                    html += '<th>';
                    html += '<center>';
                    html += '<input class="form-check-input" type="checkbox" id="chkweft' + no + '" style="transform: scale(1.3);" onchange="onchangeCHKWeft()"' + (wchk == "1" ? " checked" : "") + '>';
                    html += '</center>';
                    html += '</th>';
                }
            }

            html += '</tr>';

            // Table Weft and Warp Data
            html += '<tr>';
            html += '<th><br /></th>';

            for (var waData = 0; waData < warpLength; waData++) {
                var no = parseInt(waData) + parseInt(1);
                html += '<th>';
                html += '<center>';
                html += '<input type="text" id="warp' + no + '" class="form-control" onfocusout="validate(this)" value="' + dataItem.listDesignFormWarpData[waData].YarnMaterial + '" style="margin-top: 3px; min-height: 30px; width: 90%; font-size: x-small; background-color: #e5f0ff;" readonly>';
                html += '<input type="hidden" id="warpid' + no + '" class="form-control" value="' + dataItem.listDesignFormWarpData[waData].DesignEntryWarpID + '">';
                html += '</center>';
                html += '</th>';
            }

            html += '<th style="background-color: #c8d3df;"><br /></th>';

            for (var weData = 0; weData < weftLength; weData++) {
                var no = parseInt(weData) + parseInt(1);
                html += '<th>';
                html += '<center>';
                html += '<span id="spanDesignSpecification' + no + '" style="margin-left: 5px; color: #6f7479; font-size: 0.725rem; font-weight: 500;">' + dataItem.listDesignEntryWeftData[weData].DesignSpecification + '</span>';
                html += '<input type="text" id="feeder' + no + '" class="form-control" onfocusout="validate(this)" value="' + dataItem.listDesignEntryWeftData[weData].YarnMaterial + '" style="margin-top: 3px; min-height: 30px; width: 90%; font-size: x-small; background-color: #e5f0ff;" readonly>';
                html += '<input type="hidden" id="feederid' + no + '" class="form-control" value="' + dataItem.listDesignEntryWeftData[weData].DesignEntryWeftID + '">';
                html += '</center>';
                html += '</th>';
            }

            html += '</tr>';
            html += '</thead>';

            var editColorArray = "";
            html += '<tbody id="tblColorMatching">';

            for (var ca = 0; ca < dataItem.listDesignColorMatchingDetails.length; ca++) {
                var detail = dataItem.listDesignColorMatchingDetails[ca];
                var SrNo = ca + 1;
                editColorArray += SrNo + "|";

                var lockedRow = isEditMode && isRowValidated(detail);
                var disabledAttr = lockedRow ? " disabled" : "";

                html += '<tr id="trMatching' + SrNo + '" data-locked="' + (lockedRow ? "1" : "0") + '">';
                if (ca == 0 || lockedRow) {
                    html += '<td></td>';
                }
                else {
                    html += '<td><i class="fa fa-times fa-2x" style="color: red; margin-top: 14px; cursor:pointer;" onclick="deleteColorMatchingData(' + SrNo + ')"></i></td>';
                }

                for (var waColor = 0; waColor < warpLength; waColor++) {
                    var no = parseInt(waColor) + parseInt(1);
                    var warpVal = detail["Warp" + no] || "";

                    html += '<td>';
                    if (waColor == 0) {
                        var detailsIdVal = isEditMode ? detail.DesignColorMatchingDetailsID : "0";
                        html += '<input type="hidden" id="txtDesignColorMatchingDetailsID' + SrNo + '" value="' + detailsIdVal + '" /> ';
                        html += '<span style="margin-left: 5px; font-weight: 600; color: #1273eb; background-color: white; border-radius: 10px; padding: 0px 5px 1.5px 5px;">Matching ' + SrNo + '</span>';
                        html += '<span style="margin-left: 5px; font-weight: 600; color: #1273eb; display:none;" id="matching' + SrNo + 'ID">' + detail.WarpMatchingID + '</span>';
                    }
                    else {
                        html += '<br />';
                    }

                    html += '<div class="field-wrapper" style="display:flex;align-items:center;gap:5px;">';

                    var selectHtml = '<select id="MatchingWarp' + SrNo + no + '" class="form-control no-select2" style="min-height: 30px; width: 90%; font-size: x-small;"' + disabledAttr + ' onfocusout="validate(this)" onchange="WarpMatchingChange(\'' + SrNo + '_' + no + '\')">';
                    selectHtml += '<option value="" selected> Select Color </option>';
                    var swatchHtml = '';

                    for (var k = 0; k < ArrayYarnColor[0].length; k++) {
                        var colorItem = ArrayYarnColor[0][k];
                        if (colorItem.YarnColorID == warpVal) {
                            swatchHtml += '<div id="tdMatchingWarp' + SrNo + no + '" style="background-color: #' + colorItem.YarnColorCode + '; width: 35px;height: 35px; border-radius:3px;"></div>';
                            selectHtml += "<option value='" + colorItem.YarnColorID + "' selected> " + colorItem.YarnColor + " </option>";
                        }
                        else {
                            selectHtml += "<option value='" + colorItem.YarnColorID + "'> " + colorItem.YarnColor + " </option>";
                        }
                    }

                    selectHtml += '</select>';
                    html += swatchHtml + selectHtml;
                    html += '</div>';
                    html += '</td>';
                }

                html += '<td style="background-color: #c8d3df;"><br /></td>';

                for (var weColor = 0; weColor < weftLength; weColor++) {
                    var no = parseInt(weColor) + parseInt(1);
                    var feederVal = detail["Feeder" + no] || "";

                    html += '<td>';
                    if (weColor == 0) {
                        html += '<span style="margin-left: 5px; font-weight: 600; color: #1273eb; display:none;" id="matchingWeft' + SrNo + 'ID">' + detail.FeederMatchingID + '</span>';
                    }
                    html += '<br />';
                    html += '<div class="field-wrapper" style="display:flex;align-items:center;gap:5px;">';

                    var selectHtml = '<select id="MatchingWeft' + SrNo + no + '" class="form-control no-select2" style="min-height: 30px; width: 90%; font-size: x-small;"' + disabledAttr + ' onfocusout="validate(this)" onchange="WeftMatchingChange(\'' + SrNo + '_' + no + '\')">';
                    selectHtml += '<option value="" selected> Select Color </option>';
                    var swatchHtml = '';

                    for (var k = 0; k < ArrayYarnColor[0].length; k++) {
                        var colorItem = ArrayYarnColor[0][k];
                        if (colorItem.YarnColorID == feederVal) {
                            swatchHtml += '<div id="tdMatchingWeft' + SrNo + no + '" style="background-color: #' + colorItem.YarnColorCode + '; width: 35px;height: 35px; border-radius:3px;"></div>';
                            selectHtml += "<option value='" + colorItem.YarnColorID + "' selected> " + colorItem.YarnColor + " </option>";
                        }
                        else {
                            selectHtml += "<option value='" + colorItem.YarnColorID + "'> " + colorItem.YarnColor + " </option>";
                        }
                    }

                    selectHtml += '</select>';
                    html += swatchHtml + selectHtml;
                    html += '</div>';
                    html += '</td>';
                }

                html += '</tr>';
            }

            html += '</tbody>';
            html += '<tfoot>';
            html += '<tr>';
            html += '<th><br /></th>';
            html += '<th colspan="' + sumWarpWeft + '">';
            html += '<div class="field-wrapper" style="margin-bottom: 5px; margin-top:0;">';
            html += '<span class="field-placeholder" style="position: relative; padding: 0px 12px 0px 12px; width: 90%; text-align: center; color:red; font-size: medium;" id="spanDuplicate"></span>';
            html += '</div>';
            html += '</th>';
            html += '</tr>';
            html += '</tfoot>';
            html += '</table>';

            return { html: html, editColorArray: editColorArray };
        }

        function getCookieDesignNo(designNo) {
            $("#txtDeleteColorArray").val('');

            if (designNo.value != "") {
                validate(document.getElementById("DesignNo"));

                var DesignEntryFormID = designNo.split("|")[0];
                var DesignColorMatchingFormID = designNo.split('|')[1];

                $("#txtDesignColorMatchingFormID").val(DesignColorMatchingFormID);

                var formData = new FormData();
                formData.append('DesignEntryFormID', DesignEntryFormID);
                formData.append('DesignColorMatchingFormID', DesignColorMatchingFormID);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getCreateColorMatchingFormDetails',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        for (var i = 0; i < response.listDesignColorMatchingForm.length; i++) {
                            var item = response.listDesignColorMatchingForm[i];
                            var weftLength = item.TotalWeft;
                            var warpLength = item.TotalWarp;

                            $("#PickOnLoom").val(item.PickOnLoom);
                            $("#TotalCard").val(item.TotalCard);
                            $("#DesignCategory").val(item.DesignCategory);

                            var imgStr = "<img src='" + item.PhotoOfDesign + "' style='width:100%;margin-top:-54px;'>";
                            $("#upload-PhotoOfDesign-default-preview").html(imgStr);
                            $("#upload-PhotoOfDesign-default-preview").css('color', 'initial');

                            $("#weftLength").val(weftLength);
                            $("#warpLength").val(warpLength);
                            $("#txtColorArray").val('');

                            var built = buildColorMatchingTableHtml(response.listDesignColorMatchingForm[0], true);
                            if (built.html) {
                                $("#divColorMatchingTable").html(built.html).show();
