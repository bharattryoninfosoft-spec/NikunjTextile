        function getNextMatchingRowNo(txtColorData) {
            var maxNo = 0;
            for (var idx = 0; idx < txtColorData.length; idx++) {
                var parsed = parseInt(txtColorData[idx], 10);
                if (!isNaN(parsed) && parsed > maxNo) {
                    maxNo = parsed;
                }
            }
            return maxNo + 1;
        }

