                    });

                    if (isDuplicate) {
                        Swal.fire({ icon: 'warning', title: 'Duplicate Found', text: 'Please resolve duplicates before updating.' });
                        return;
                    }

                    let WarpFeederArray = txtColorData.map(MatchingNo => {
                        let obj = {
