        #tblOrderListTable th:nth-child(10),
        #tblOrderListTable td:nth-child(10) {
            width: 75px !important;
        }


        /* =========================================================
         TABLE ALIGNMENT
         ========================================================= */

        #tblOrderListTable tbody td {
            color: #30343b;
        }


            #tblOrderListTable tbody td:nth-child(1),
            #tblOrderListTable tbody td:nth-child(2),
            #tblOrderListTable tbody td:nth-child(3),
            #tblOrderListTable tbody td:nth-child(5),
            #tblOrderListTable tbody td:nth-child(7),
