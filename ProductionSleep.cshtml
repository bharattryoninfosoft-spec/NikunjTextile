         SELECTED ROW
         ========================================================= */

        #tblOrderListTable tr.table-active td {
            background: #f1f7fd !important;
        }


        #tblOrderListTable tbody tr:hover {
            background: #f7f9fb !important;
        }


        #tblOrderListTable tr.table-active:hover td {
            background: #edf5fc !important;
