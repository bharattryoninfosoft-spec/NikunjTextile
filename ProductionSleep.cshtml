                        function snapToPanaRepeatMultiple(val, pcs) {
                            var panaRepeat = numberValue($("#txtPanaRepeat").val());
                            var num = numberValue(val);

                            if (num <= 0) {
                                return 0;
                            }

                            if (panaRepeat > 0) {
                                if (num < panaRepeat) {
                                    num = panaRepeat;
                                } else {
                                    var remainder = num % panaRepeat;
                                    if (remainder !== 0) {
                                        num = Math.round(num / panaRepeat) * panaRepeat;
                                    }
                                }
                            }

                            if (pcs > 0 && num > pcs) {
                                if (panaRepeat > 0 && pcs >= panaRepeat) {
                                    num = Math.floor(pcs / panaRepeat) * panaRepeat;
                                } else {
                                    num = pcs;
                                }
                            }

                            return num;
