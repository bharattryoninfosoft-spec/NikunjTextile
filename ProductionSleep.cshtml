                                contentType:
                                    "application/json; charset=utf-8",

                                /*
                                 * Use text because the existing ASMX method may be
                                 * Response.Write()-ing JSON and returning d:null.
                                 * This parser supports both the old and new response.
                                 */

                                dataType:
                                    "text",

                                success:
                                    function (response) {
                                        isJobWorkerLoaded = true;
                                        var data = parseJobberResponse(response);
                                        var $select = $("#txtJobWorker");
