                                        $select.empty();
                                        $select.append(
                                            $("<option>", { value: "", text: "-- Select Job Worker --" })
                                        );
                                        $.each(
                                            data,
                                            function (index, item) {

                                                var id =
                                                    item.JobberMasterID ??
                                                    item.jobberMasterID ??
                                                    item.JobberMasterId ??
                                                    item.JobberID ??
                                                    item.jobberID ??
                                                    item.JobberId ??
                                                    item.ID ??
                                                    item.id;


                                                var name =
                                                    item.JobberName ??
                                                    item.jobberName ??
                                                    item.Jobber ??
                                                    item.jobber ??
                                                    item.PartyName ??
                                                    item.partyName ??
                                                    item.Name ??
                                                    item.name;


                                                var panaRepeat =
                                                    item.PanaRepeat ??
                                                    item.panaRepeat ??
                                                    item.PanaRepeatValue ??
                                                    item.panaRepeatValue ??
                                                    item.Pick ??
                                                    item.pick;


                                                if (
                                                    id === undefined ||
                                                    id === null ||
                                                    String(id).trim() === ""
                                                ) {

                                                    return;

                                                }


                                                name =
                                                    textValue(name);


                                                panaRepeat =
                                                    panaRepeat === null ||
                                                        panaRepeat === undefined
                                                        ? "0"
                                                        : String(panaRepeat);


                                                var $option =
                                                    $("<option>", {

                                                        value:
                                                            String(id),

                                                        text:
                                                            name

                                                    });


                                                $option.attr(
                                                    "data-panarepeat",
                                                    panaRepeat
                                                );


                                                $select.append(
                                                    $option
                                                );

                                            }
                                        );


                                        try {
                                            $select.trigger("change");
                                            if (typeof $select.selectpicker === "function") {
                                                $select.selectpicker("refresh");
                                            }
                                        }
                                        catch (e) {}

                                        if (pendingJobWorkerID || pendingJobWorkerName) {
                                            setExistingJobWorker(
                                                pendingJobWorkerID,
                                                pendingJobWorkerName,
                                                pendingJobWorkerPanaRepeat
                                            );
                                        }
                                        else if (currentSelectedVal) {
                                            $select.val(currentSelectedVal);
                                            try {
                                                $select.trigger("change");
                                                if (typeof $select.selectpicker === "function") {
                                                    $select.selectpicker("refresh");
                                                }
                                            }
                                            catch (e) {}
                                        }
                                        else {
                                            $("#txtPanaRepeat").val("");
                                        }

                                    },

                                error:
                                    function (xhr) {
                                        isJobWorkerLoaded = true;

                                        console.error(
                                            "GetJobberMaster Error:",
                                            xhr.responseText
                                        );

                                        if (pendingJobWorkerID || pendingJobWorkerName) {
                                            setExistingJobWorker(
                                                pendingJobWorkerID,
                                                pendingJobWorkerName,
                                                pendingJobWorkerPanaRepeat
                                            );
                                        }

                                    }

                            });

                        }
