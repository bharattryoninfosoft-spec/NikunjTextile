                        function parseJobberResponse(response) {

                            /*
                             * New/normal ASMX:
                             *
                             * { "d": "[...]" }
                             *
                             * or:
                             *
                             * { "d": [...] }
                             */

                            if (
                                response &&
                                typeof response === "object"
                            ) {

                                var d =
                                    response.d;

                                if (
                                    typeof d === "string"
                                ) {

                                    try {

                                        d =
                                            JSON.parse(d);

                                    }
                                    catch (e) {

                                        d = [];

                                    }

                                }


                                if (
                                    Array.isArray(d)
                                ) {

                                    return d;

                                }

                            }


                            var raw =
                                response === null ||
                                    response === undefined
                                    ? ""
                                    : String(response);


                            if (
                                !raw
                            ) {

                                return [];

                            }


                            /*
                             * First try complete JSON.
                             */

                            try {

                                var parsed =
                                    JSON.parse(raw);


                                if (
                                    Array.isArray(parsed)
                                ) {

                                    return parsed;

                                }


                                if (
                                    parsed &&
                                    typeof parsed.d === "string"
                                ) {

                                    var parsedD =
                                        JSON.parse(parsed.d);

                                    return Array.isArray(parsedD)
                                        ? parsedD
                                        : [];

                                }


                                if (
                                    parsed &&
                                    Array.isArray(parsed.d)
                                ) {

                                    return parsed.d;

                                }

                            }
                            catch (e) {

                                /*
                                 * Old method may return:
                                 *
                                 * [...]{"d":null}
                                 *
                                 * Extract the first JSON array.
                                 */

                            }


                            var first =
                                raw.indexOf("[");


                            var last =
                                raw.lastIndexOf("]");


                            if (
                                first >= 0 &&
                                last > first
                            ) {

                                var arrayText =
                                    raw.substring(
                                        first,
                                        last + 1
                                    );


                                try {

                                    var arrayData =
                                        JSON.parse(
                                            arrayText
                                        );


                                    return Array.isArray(
                                        arrayData
                                    )
                                        ? arrayData
                                        : [];

                                }
                                catch (e) {

                                    console.error(
                                        "Unable to parse Jobber response:",
                                        e,
                                        raw
                                    );

                                }

                            }


                            return [];

                        }
