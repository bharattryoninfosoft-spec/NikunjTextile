                        function matchQualityRowToItem(q, item, pColor) {
                            var qMatchingId = textValue(q.DesignColorMatchingID || q.DesignColorMatchingFormID);
                            var iMatchingId = textValue(item.DesignColorMatchingID || item.DesignColorMatchingFormID);
                            if (qMatchingId && iMatchingId && qMatchingId === iMatchingId) {
                                return true;
                            }

                            var qDesign = normalizeText(q.DesignerCode || q.DesignNo);
                            var iDesign = normalizeText(getDesignNo(item));
                            var qCleanDesign = cleanDesignNo(q.DesignerCode || q.DesignNo);
                            var iCleanDesign = cleanDesignNo(getDesignNo(item));
                            var qDigits = getDesignDigits(q.DesignerCode || q.DesignNo);
                            var iDigits = getDesignDigits(getDesignNo(item));

                            var designMatch = false;
                            if (qDesign && iDesign) {
                                if (qDesign === iDesign || qCleanDesign === iCleanDesign) {
                                    designMatch = true;
                                } else if (qDigits && iDigits && qDigits === iDigits) {
                                    designMatch = true;
                                } else if (qCleanDesign && iCleanDesign && (iCleanDesign.indexOf(qCleanDesign) >= 0 || qCleanDesign.indexOf(iCleanDesign) >= 0)) {
                                    designMatch = true;
                                }
                            } else {
                                designMatch = true;
                            }

                            if (!designMatch) {
                                return false;
                            }

                            var qColour = normalizeText(q.ColourName || q.Colour);
                            var qYarnColor = normalizeText(q.YarnColor);
                            var iColour = normalizeText(getColour(item));
                            var targetColor = normalizeText(pColor || "");

                            if (!iColour) {
                                return true;
                            }

                            var colourMatch = false;

                            if (qColour && (qColour === iColour || iColour.indexOf(qColour) >= 0 || qColour.indexOf(iColour) >= 0)) {
                                colourMatch = true;
                            }

                            if (!colourMatch && qYarnColor && (qYarnColor === iColour || iColour.indexOf(qYarnColor) >= 0 || qYarnColor.indexOf(iColour) >= 0)) {
                                colourMatch = true;
                            }

                            if (!colourMatch && targetColor && (targetColor === iColour || iColour.indexOf(targetColor) >= 0 || targetColor.indexOf(iColour) >= 0)) {
                                colourMatch = true;
                            }

                            if (!colourMatch) {
                                var searchColors = [qColour, qYarnColor, targetColor].filter(Boolean);
                                for (var s = 0; s < searchColors.length; s++) {
