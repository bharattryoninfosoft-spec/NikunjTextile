                        function rebuildProductionReport() {

                            var $body =
                                $("#tblProductionReportBody");

                            $body.empty();


                            var totalPcs = 0;

                            var totalAmount = 0;

                            var rowCount = 0;


                            /*
                             * IMPORTANT:
                             * Always use globalOrderData.
                             * Filter hone ke baad bhi report disappear nahi hogi.
                             */

                            $.each(
                                globalOrderData,
                                function (index, item) {

                                    var subId =
                                        getSubId(item);


                                    var selected =
                                        selectedItemsMap[subId];


                                    if (!selected) {
                                        return;
                                    }


                                    var production =
                                        numberValue(
                                            selected.prodPcs
                                        );


                                    if (production <= 0) {
                                        return;
                                    }


                                    var slipNo =
                                        item.GeneratedSlipNo || "";


                                    var designNo =
                                        getDesignNo(item);


                                    var colour =
                                        getColour(item);


                                    /*
                                     * Formula: Job Rate = Design Total card * Job rate / Pick * .0254 / 100 (rounded to 2 decimal places)
                                     */
                                    var itemJobRate =
                                        calculateJobRateForItem(item);

                                    var amount =
                                        production * itemJobRate;


                                    $body.append(

                                        "<tr>" +

                                        /* SLIP NO */

                                        "<td>" +
                                        escapeHtml(
                                            slipNo
                                        ) +
                                        "</td>" +


                                        /* DESIGN NO */

                                        "<td>" +
                                        escapeHtml(
                                            designNo
                                        ) +
                                        "</td>" +


                                        /* COLOUR MATCHING ID */

                                        "<td>" +
                                        escapeHtml(
                                            colour
                                        ) +
                                        "</td>" +


                                        /* PCS */

                                        "<td class='rep-pcs'>" +
                                        production +
                                        "</td>" +


                                        /* JOB RATE */

                                        "<td class='rep-rate'>" +
                                        itemJobRate.toFixed(2) +
                                        "</td>" +


                                        /* AMOUNT */

                                        "<td class='rep-amt'>" +
                                        amount.toFixed(2) +
                                        "</td>" +

                                        "</tr>"

                                    );


                                    totalPcs +=
                                        production;


                                    totalAmount +=
                                        amount;


                                    rowCount++;

                                }
                            );


                            if (rowCount === 0) {

                                $body.html(

                                    "<tr>" +

                                    "<td colspan='6' " +
                                    "class='text-center text-muted py-3'>" +

                                    "No items added for production yet." +

                                    "</td>" +

                                    "</tr>"

                                );

                            }


                            $("#lblTotalPcs")
                                .text(
                                    totalPcs
                                );


                            $("#lblTotalAmount")
                                .text(
                                    totalAmount.toFixed(2)
                                );

                        }
                        $(document).on("click.productionOrder", "#btnAddForProduction", function () {

                            if (
                                isProductionViewMode
                            ) {

                                return;

                            }


                            if (
                                isSavingProduction
                            ) {

                                return;

                            }


                            var productionDate =
                                ensureProductionDate();


                            var jobWorkerId =
                                $("#txtJobWorker")
                                    .val();


                            var jobWorkerName =
                                $("#txtJobWorker option:selected")
                                    .text();


                            var panaRepeat =
                                numberValue(
                                    $("#txtPanaRepeat").val()
                                );


                            var jobRate =
                                numberValue(
                                    $("#txtJobRate").val()
                                );


                            /*
                             * DETAILS
                             */

                            var detailList =
                                [];


                            /*
                             * IMPORTANT:
                             *
                             * GLOBAL DATA use karna hai.
                             *
                             * Filtered DOM use nahi karna.
                             */

                            $.each(
                                globalOrderData,
                                function (index, item) {

                                    var subId =
                                        getSubId(item);


                                    var selected =
                                        selectedItemsMap[
                                        subId
                                        ];


                                    if (
                                        !selected
                                    ) {

                                        return;

                                    }


                                    var pcs =
                                        getPcs(item);


                                    var production =
                                        numberValue(
                                            selected.prodPcs
                                        );


                                    if (
                                        production <= 0
                                    ) {

                                        return;

                                    }


                                    production =
                                        Math.min(
                                            production,
                                            pcs
                                        );


                                    var pending =
                                        Math.max(
                                            0,
                                            pcs - production
                                        );


                                    var rate =
                                        getRate(item);


                                    var itemJobRate =
                                        calculateJobRateForItem(item);

                                    var amount =
                                        production *
                                        itemJobRate;


                                    /*
                                     * Read IDs directly from globalOrderData.
                                     * NULL only when source API itself does not
                                     * provide that ID.
                                     */
                                    var salesOrderID =
                                        getSalesOrderID(item);

                                    var salesOrderDetailID =
                                        getSalesOrderDetailID(item);

                                    var partyID =
                                        getPartyID(item);

                                    var designEntryFormID =
                                        getDesignEntryFormIDValue(item);

                                    var colourMatchingID =
                                        getColourMatchingID(item);

                                    var warpQuality =
                                        getWarpQualityValue(item);

                                    var weftQuality =
                                        getWeftQualityValue(item);

                                    detailList.push({

                                        ProductionOrderDetailID:
                                            getNullableID(item,
                                                item.ProductionOrderDetailID ??
                                                item.productionOrderDetailID
                                            ) || 0,

                                        SalesOrderID:
                                            salesOrderID,

                                        SalesOrderDetailID:
                                            salesOrderDetailID,

                                        SubDetailID:
                                            getNullableID(item,
                                                item.SubDetailID ??
                                                subId
                                            ),

                                        SalesOrderNo:
                                            getOrderNo(item),

                                        SlipNo:
                                            item.GeneratedSlipNo || "",

                                        /*
                                         * Barcode = milliseconds.
                                         * Backend also validates uniqueness.
                                         */
                                        Barcode:
                                            textValue(
                                                item.Barcode ??
                                                item.SlipNoBarcode ??
                                                (jQuery.now().toString())
                                            ),

                                        OrderDate:
                                            getOrderDate(item),

                                        PartyID:
                                            partyID,

                                        PartyName:
                                            getPartyName(item),

                                        DesignEntryFormID:
                                            designEntryFormID,

                                        DesignNo:
                                            getDesignNo(item),

                                        ColourMatchingID:
                                            colourMatchingID,

                                        ColourMatchingName:
                                            getColour(item),

                                        WarpQuality:
                                            warpQuality,

                                        WeftQuality:
                                            weftQuality,

                                        PCS:
                                            pcs,

                                        ProductionPCS:
                                            production,

                                        PendingPCS:
                                            pending,

                                        SalesRate:
                                            rate,

                                        JobRate:
                                            itemJobRate,

                                        Amount:
                                            amount

                                    });

                                }
                            );


                            /*
                             * VALIDATION
                             */

                            if (
                                detailList.length === 0
                            ) {

                                alert(
                                    "Please enter Production greater than 0."
                                );

                                return;

                            }


                            /*
                             * TOTAL
                             */

                            var totalPcs =
                                0;

                            var totalProductionPcs =
                                0;

                            var totalPendingPcs =
                                0;

                            var totalAmount =
                                0;


                            $.each(
                                detailList,
                                function (index, item) {

                                    totalPcs +=
                                        numberValue(
                                            item.PCS
                                        );

                                    totalProductionPcs +=
                                        numberValue(
                                            item.ProductionPCS
                                        );

                                    totalPendingPcs +=
                                        numberValue(
                                            item.PendingPCS
                                        );

                                    totalAmount +=
                                        numberValue(
                                            item.Amount
                                        );

                                }
                            );


                            /*
                             * MASTER PAYLOAD
                             */

                            var productionOrderID =
                                parseInt(
                                    $("#txtProductionOrderID").val(),
                                    10
                                ) || 0;

                            var payload = {

                                ProductionOrderID:
                                    productionOrderID,

                                ProductionOrderNo:
                                    $("#txtProductionOrderNo")
                                        .val(),

                                ProductionOrderDate:
                                    productionDate,

                                JobWorker:
                                    jobWorkerId,

                                JobWorkerID:
                                    jobWorkerId,

                                JobWorkerName:
                                    jobWorkerName,

                                PanaRepeat:
                                    panaRepeat,

                                JobRate:
                                    jobRate,

                                Traders:
                                    $("#txtTraders")
                                        .val(),

                                TotalPcs:
                                    totalPcs,

                                TotalProductionPcs:
                                    totalProductionPcs,

                                TotalPendingPcs:
                                    totalPendingPcs,

                                TotalPCS:
                                    totalPcs,

                                TotalAmount:
                                    totalAmount,

                                listProductionOrderDetail:
                                    detailList

                            };


                            console.log(
                                "FINAL PRODUCTION PAYLOAD:",
                                payload
                            );

                            console.table(
                                detailList.map(function (x) {
                                    return {
                                        SalesOrderID: x.SalesOrderID,
                                        SalesOrderDetailID: x.SalesOrderDetailID,
                                        SubDetailID: x.SubDetailID,
                                        PartyID: x.PartyID,
                                        ColourMatchingID: x.ColourMatchingID,
                                        Barcode: x.Barcode
                                    };
                                })
                            );


                            /*
                             * SAVE
                             */

                            isSavingProduction =
                                true;


                            $("#btnAddForProduction")
                                .prop(
                                    "disabled",
                                    true
                                );


                            $.ajax({

                                type: "POST",

                                url:
                                    "WebServiceNikunjTextile.asmx/SaveProductionOrder",

                                contentType:
                                    "application/json; charset=utf-8",

                                dataType:
                                    "json",

                                data:
                                    JSON.stringify({

                                        request:
                                            payload

                                    }),

                                success:
                                    function (response) {

                                        console.log(
                                            "Save Production Response:",
                                            response
                                        );


                                        var result =
                                            response
                                                ? response.d
                                                : null;


                                        if (
                                            typeof result === "string"
                                        ) {

                                            try {

                                                result =
                                                    JSON.parse(result);

                                            }
                                            catch (e) {

                                            }

                                        }


                                        if (
                                            result &&
                                            (
                                                result.Success === true ||
                                                result.Success === "true" ||
                                                result.Code === 200 ||
                                                result.Code === "200"
                                            )
                                        ) {

                                            alert(
                                                result.Message ||
                                                "Production Order saved successfully."
                                            );

                                            window.location.href = "/ProductionOrderList";

                                        }
                                        else {

                                            alert(

                                                (
                                                    result &&
                                                    result.Message
                                                )
                                                ||
                                                "Unable to save Production Order."

                                            );

                                        }

                                    },

                                error:
                                    function (xhr) {

                                        console.error(
                                            "SaveProductionOrder Error:",
                                            xhr.responseText
                                        );


                                        alert(
                                            "Error while saving Production Order."
                                        );

                                    },

                                complete:
                                    function () {

                                        isSavingProduction =
                                            false;


                                        $("#btnAddForProduction")
                                            .prop(
                                                "disabled",
                                                false
                                            );

                                    }

                            });

                        });
                    </script>

                }
