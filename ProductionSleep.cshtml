                @section Scripts {

                    <script>

                        var globalOrderData = [];
                        var globalQualityData = [];
                        var selectedItemsMap = {};
                        var isSavingProduction = false;
                        var isProductionEditMode = false;
                        var isProductionViewMode = false;
                        $(document).ready(function () {

                            $('body').addClass('fullscreen');

                            /*
                             * IMPORTANT:
                             * ProductionOrderID URL mein direct numeric ID nahi aayegi.
                             *
                             * Edit:
                             * /ProductionSleep?ProductionOrderID=<ENCRYPTED>
                             *
                             * View:
                             * /ProductionSleep?ProductionOrderID=<ENCRYPTED>&Mode=View
                             */
                            initializeProductionOrderPage();

                        });
                        function getProductionOrderQueryValue(name) {

                            /*
                             * IMPORTANT:
                             * URLSearchParams already decodes one URL-encoding layer.
                             * Older List pages may have encoded the encrypted ID more
                             * than once, e.g.:
                             *
                             *     Vw%253d%253d
                             *
                             * After params.get() this becomes:
                             *
                             *     Vw%3d%3d
                             *
                             * Decrypt() needs the real encrypted value:
                             *
                             *     Vw==
                             *
                             * Decode remaining URL-encoding layers safely.
                             */
                            function decodeEncryptedQueryValue(value) {

                                if (
                                    value === null ||
                                    value === undefined
                                ) {

                                    return "";

                                }

                                var result =
                                    String(value).trim();

                                /*
                                 * Maximum 3 extra layers.
                                 * Base64 encrypted values themselves do not contain
                                 * percent-encoded sequences, so this will not damage
                                 * a normal encrypted ID.
                                 */
                                for (
                                    var i = 0;
                                    i < 3;
                                    i++
                                ) {

                                    if (
                                        result.indexOf("%") < 0
                                    ) {

                                        break;

                                    }

                                    try {

                                        var decoded =
                                            decodeURIComponent(
                                                result
                                            );

                                        if (
                                            decoded === result
                                        ) {

                                            break;

                                        }

                                        result =
                                            decoded;

                                    }
                                    catch (decodeError) {

                                        console.warn(
                                            "Unable to decode ProductionOrderID:",
                                            decodeError
                                        );

                                        break;

                                    }

                                }

                                return textValue(result);

                            }


                            try {

                                var params =
                                    new URLSearchParams(
                                        window.location.search || ""
                                    );

                                return decodeEncryptedQueryValue(
                                    params.get(name)
                                );

                            }
                            catch (e) {

                                var query =
                                    window.location.search || "";

                                var match =
                                    query.match(
                                        new RegExp(
                                            "[?&]" +
                                            name +
                                            "=([^&]+)"
                                        )
                                    );

                                return match
                                    ? decodeEncryptedQueryValue(
                                        match[1]
                                    )
                                    : "";

                            }

                        }
                        function initializeProductionOrderPage() {

                            var encryptedID =
                                getProductionOrderQueryValue(
                                    "ProductionOrderID"
                                ) ||
                                getProductionOrderQueryValue(
                                    "id"
                                ) ||
                                getProductionOrderQueryValue(
                                    "ID"
                                );


                            var mode =
                                normalizeText(
                                    getProductionOrderQueryValue(
                                        "Mode"
                                    ) ||
                                    getProductionOrderQueryValue(
                                        "mode"
                                    )
                                );


                            isProductionViewMode =
                                mode === "view" ||
                                mode === "v";


                            isProductionEditMode =
                                !!encryptedID &&
                                !isProductionViewMode;


                            setProductionOrderToday();

                            loadJobWorker();
                            loadWARPandWEFTQUALITY();


                            /*
                             * No ID = CREATE MODE
                             */
                            if (
                                !encryptedID
                            ) {

                                isProductionEditMode = false;
                                isProductionViewMode = false;

                                /*
                                 * CREATE MODE:
                                 * Get Production Order No from MAX(ProductionOrderID) + 1.
                                 * Example: MAX ID = 17 => PO0018.
                                 */
                                setProductionOrderNo();

                                loadPendingOrders();

                                return;

                            }


                            /*
                             * Existing Production Order
                             */
                            loadExistingProductionOrder(
                                encryptedID,
                                isProductionViewMode
                            );

                        }
                        function parseProductionOrderResponse(response) {

                            var result =
                                response &&
                                    response.d !== undefined
                                    ? response.d
                                    : response;


                            if (
                                typeof result === "string"
                            ) {

                                try {

                                    result =
                                        JSON.parse(result);

                                }
                                catch (e) {

                                    console.error(
                                        "ProductionOrder JSON parse error:",
                                        e
                                    );

                                    return null;

                                }

                            }


                            return result;

                        }
                        function loadExistingProductionOrder(
                            encryptedID,
                            viewMode
                        ) {

                            if (
                                !encryptedID
                            ) {

                                loadPendingOrders();

                                return;

                            }


                            $.ajax({

                                type: "POST",

                                url:
                                    "WebServiceNikunjTextile.asmx/GetProductionOrderByEncryptedID",

                                contentType:
                                    "application/json; charset=utf-8",

                                dataType:
                                    "json",

                                data:
                                    JSON.stringify({

                                        EncryptedID:
                                            encryptedID

                                    }),

                                success:
                                    function (response) {

                                        var result =
                                            parseProductionOrderResponse(
                                                response
                                            );


                                        console.log(
                                            "Existing Production Order:",
                                            result
                                        );


                                        if (
                                            !result ||
                                            result.Success !== true ||
                                            !result.Master
                                        ) {

                                            alert(
                                                (
                                                    result &&
                                                    result.Message
                                                ) ||
                                                "Production Order not found."
                                            );

                                            window.location.href =
                                                "/ProductionOrderList";

                                            return;

                                        }

                                        var master = result.Master;
                                        var details = result.Details || [];

                                        if (viewMode) {
                                            bindExistingProductionOrder(
                                                master,
                                                details,
                                                viewMode
                                            );
                                        } else {
                                            $.ajax({
                                                type: "POST",
                                                url: "WebServiceNikunjTextile.asmx/GetPendingOrdersForProduction",
                                                contentType: "application/json; charset=utf-8",
                                                dataType: "json",
                                                data: "{}",
                                                success: function (pendingResponse) {
                                                    var pendingData = pendingResponse && pendingResponse.d !== undefined ? pendingResponse.d : pendingResponse;
                                                    if (typeof pendingData === "string") {
                                                        try { pendingData = JSON.parse(pendingData); } catch (e) { pendingData = []; }
                                                    }
                                                    if (pendingData && Array.isArray(pendingData.data)) pendingData = pendingData.data;
                                                    if (pendingData && Array.isArray(pendingData.list)) pendingData = pendingData.list;
                                                    if (!Array.isArray(pendingData)) pendingData = [];

                                                    var mergedList = [];
                                                    var savedSubIdMap = {};
                                                    selectedItemsMap = {};

                                                    $.each(details, function (index, sItem) {
                                                        sItem.GeneratedSlipNo = textValue(sItem.SlipNo);
                                                        var subId = getSubId(sItem);
                                                        var production = numberValue(sItem.ProductionPCS);

                                                        if (subId) {
                                                            savedSubIdMap[subId] = sItem;
                                                            if (production > 0) {
                                                                selectedItemsMap[subId] = { prodPcs: production };
                                                            }
                                                        }
                                                        mergedList.push(sItem);
                                                    });

                                                    $.each(pendingData, function (index, pItem) {
                                                        var pSubId = getSubId(pItem);
                                                        if (pSubId && savedSubIdMap[pSubId]) {
                                                            var sItem = savedSubIdMap[pSubId];
                                                            var pendingAvail = numberValue(pItem.PendingPcs ?? pItem.PendingPCS ?? pItem.Pcs ?? pItem.PCS);
                                                            var savedProd = numberValue(sItem.ProductionPCS);
                                                            var totalMax = pendingAvail + savedProd;

                                                            sItem.PCS = totalMax;
                                                            sItem.Pcs = totalMax;
                                                            sItem.PendingPcs = totalMax;
                                                            sItem.PendingPCS = totalMax;

                                                            if (!sItem.WarpQuality && pItem.WarpQuality) sItem.WarpQuality = pItem.WarpQuality;
                                                            if (!sItem.WeftQuality && pItem.WeftQuality) sItem.WeftQuality = pItem.WeftQuality;
                                                            if (!sItem.TotalCard && pItem.TotalCard) sItem.TotalCard = pItem.TotalCard;
                                                        } else {
                                                            var pAvail = numberValue(pItem.PendingPcs ?? pItem.PendingPCS ?? pItem.Pcs ?? pItem.PCS);
                                                            pItem.PCS = pAvail;
                                                            pItem.Pcs = pAvail;
                                                            pItem.PendingPcs = pAvail;
                                                            pItem.PendingPCS = pAvail;
                                                            pItem.ProductionPCS = 0;
                                                            mergedList.push(pItem);
                                                        }
                                                    });

                                                    bindExistingProductionOrder(
                                                        master,
                                                        mergedList,
                                                        viewMode
                                                    );
                                                },
                                                error: function (xhr) {
                                                    console.error("GetPendingOrdersForProduction edit merge error:", xhr);
                                                    bindExistingProductionOrder(
                                                        master,
                                                        details,
                                                        viewMode
                                                    );
                                                }
                                            });
                                        }

                                    },

                                error:
                                    function (xhr) {

                                        console.error(
                                            "GetProductionOrderByEncryptedID:",
                                            xhr.responseText
                                        );


                                        alert(
                                            "Unable to load Production Order."
                                        );


                                        window.location.href =
                                            "/ProductionOrderList";

                                    }

                            });

                        }
                        function bindExistingProductionOrder(
                            master,
                            details,
                            viewMode
                        ) {

                            isProductionViewMode =
                                !!viewMode;


                            isProductionEditMode =
                                !isProductionViewMode;


                            /*
                             * MASTER
                             */

                            $("#txtProductionOrderID")
                                .val(
                                    numberValue(
                                        master.ProductionOrderID
                                    )
                                );
                        

                            $("#txtProductionOrderNo")
                                .val(
                                    textValue(
                                        master.ProductionOrderNo
                                    )
                                );


                            $("#txtProductionOrderDate")
                                .val(
                                    normalizeDate(
                                        master.ProductionOrderDate
                                    )
                                );


                            $("#txtJobRate")
                                .val(
                                    numberValue(
                                        master.JobRate
                                    )
                                );


                            $("#txtPanaRepeat")
                                .val(
                                    numberValue(
                                        master.PanaRepeat
                                    )
                            );


                            var jwID = master ? (master.JobWorkerID || master.jobWorkerID || master.JobWorker || master.jobWorker || master.PartyID || master.partyID) : null;
                            var jwName = master ? (master.JobWorkerName || master.jobWorkerName || master.PartyName || master.partyName) : null;

                            if ((!jwID || jwID === 0 || String(jwID) === "0") && (!jwName || String(jwName).trim() === "")) {
                                if (details && details.length > 0) {
                                    jwID = details[0].PartyID || details[0].partyID || details[0].JobWorkerID || details[0].jobWorkerID;
                                    jwName = details[0].PartyName || details[0].partyName || details[0].JobWorkerName || details[0].jobWorkerName;
                                }
                            }

                            /*
                             * JOB WORKER:
                             * loadJobWorker is asynchronous, so set it immediately
                             * if option exists, otherwise retry after dropdown load.
                             */
                            setExistingJobWorker(
                                jwID,
                                jwName,
                                master ? master.PanaRepeat : 0
                            );


                            /*
                             * DETAILS
                             */
                            globalOrderData = details || [];

                            $.each(
                                globalOrderData,
                                function (index, detail) {

                                    if (!detail.GeneratedSlipNo) {
                                        detail.GeneratedSlipNo =
                                            textValue(
                                                detail.SlipNo
                                            );
                                    }

                                    var subId =
                                        getSubId(detail);

                                    var production =
                                        numberValue(
                                            detail.ProductionPCS
                                        );

                                    if (
                                        subId &&
                                        production > 0 &&
                                        selectedItemsMap[subId] === undefined
                                    ) {

                                        selectedItemsMap[
                                            subId
                                        ] = {

                                            prodPcs:
                                                production

                                        };

                                    }

                                }
                            );

                            generateSlipNumbers();

                            populateAllFilters();

                            renderTable(
                                globalOrderData
                            );


                            /*
                             * Show first saved item's quality.
                             */
                            if (
                                globalOrderData.length > 0
                            ) {

                                loadDesignQualityForItem(
                                    globalOrderData[0]
                                );

                            }
                            else {

                                clearDesignQuality();

                            }


                            rebuildProductionReport();


                            /*
                             * VIEW MODE
                             */
                            applyProductionPageMode();

                        }
                        var existingJobWorkerRetryCount = 0;
                        var pendingJobWorkerID = null;
                        var pendingJobWorkerName = null;
                        var pendingJobWorkerPanaRepeat = null;
                        var isJobWorkerLoaded = false;

                        function setExistingJobWorker(
                            jobWorkerID,
                            jobWorkerName,
                            panaRepeat
                        ) {
                            if (jobWorkerID !== undefined && jobWorkerID !== null && String(jobWorkerID).trim() !== "" && String(jobWorkerID).trim() !== "0") {
                                pendingJobWorkerID = jobWorkerID;
                            }
                            if (jobWorkerName !== undefined && jobWorkerName !== null && String(jobWorkerName).trim() !== "") {
                                pendingJobWorkerName = jobWorkerName;
                            }
                            if (panaRepeat !== undefined && panaRepeat !== null) {
                                pendingJobWorkerPanaRepeat = panaRepeat;
                            }

                            var id = textValue(jobWorkerID);
                            if (id === "0") id = "";
                            var name = textValue(jobWorkerName);

                            var $select = $("#txtJobWorker");

                            if ((!id && !name) || !$select.length) {
                                if (panaRepeat !== undefined && panaRepeat !== null) {
                                    $("#txtPanaRepeat").val(numberValue(panaRepeat));
                                }
                                return;
                            }

                            var $options = $select.find("option");
                            var $matchedOption = null;

                            if (id) {
                                $options.each(function () {
                                    var v = String($(this).val());
                                    if (v && v !== "" && v === String(id)) {
                                        $matchedOption = $(this);
                                        return false;
                                    }
                                });
                            }

                            if (!$matchedOption && name) {
                                var lowerName = name.toLowerCase();
                                $options.each(function () {
                                    var txt = $.trim($(this).text()).toLowerCase();
                                    if (txt && txt !== "" && txt !== "-- select job worker --" && txt === lowerName) {
                                        $matchedOption = $(this);
                                        return false;
                                    }
                                });
                            }

                            if (!$matchedOption && name) {
                                $options.each(function () {
                                    var v = String($(this).val());
                                    if (v && v !== "" && v === String(name)) {
                                        $matchedOption = $(this);
                                        return false;
                                    }
                                });
                            }

                            if (!$matchedOption && id) {
                                var lowerId = id.toLowerCase();
                                $options.each(function () {
                                    var txt = $.trim($(this).text()).toLowerCase();
                                    if (txt && txt !== "" && txt !== "-- select job worker --" && txt === lowerId) {
                                        $matchedOption = $(this);
                                        return false;
                                    }
                                });
                            }

                            function updateDropdownUI(valToSet) {
                                $select.val(valToSet);
                                if (typeof $select.select2 === "function") {
                                    try {
                                        $select.trigger("change");
                                        $select.trigger("change.select2");
                                    } catch (e) {}
                                }
                                if (typeof $select.selectpicker === "function") {
                                    try {
                                        $select.selectpicker("refresh");
                                        $select.selectpicker("val", valToSet);
                                    }
                                    catch (e) {
                                        try { $select.selectpicker("refresh"); } catch (e2) {}
                                    }
                                }
                            }

                            if ($matchedOption && $matchedOption.length > 0) {
                                var matchedVal = $matchedOption.val();
                                updateDropdownUI(matchedVal);

                                var optionPana = $matchedOption.attr("data-panarepeat");
                                $("#txtPanaRepeat").val(
                                    optionPana || numberValue(panaRepeat)
                                );

                                existingJobWorkerRetryCount = 0;
                                return;
                            }

                            if (isJobWorkerLoaded || existingJobWorkerRetryCount >= 20) {
                                var optVal = id || name;
                                var optText = name || id;
                                if (optVal) {
                                    var $newOpt = $("<option>", {
                                        value: String(optVal),
                                        text: String(optText)
                                    });
                                    var pr = (panaRepeat !== null && panaRepeat !== undefined) ? String(panaRepeat) : "0";
                                    $newOpt.attr("data-panarepeat", pr);
                                    $select.append($newOpt);
                                    updateDropdownUI(String(optVal));

                                    $("#txtPanaRepeat").val(numberValue(panaRepeat));
                                    existingJobWorkerRetryCount = 0;
                                    return;
                                }
                            }

                            /*
                             * Jobber AJAX may not have completed yet.
                             */
                            existingJobWorkerRetryCount++;

                            if (existingJobWorkerRetryCount <= 20) {
                                setTimeout(
                                    function () {
                                        setExistingJobWorker(
                                            jobWorkerID,
                                            jobWorkerName,
                                            panaRepeat
                                        );
                                    },
                                    300
                                );
                            }
                            else {
                                $("#txtPanaRepeat").val(numberValue(panaRepeat));
                            }

                        }
                        function applyProductionPageMode() {

                            if (
                                isProductionViewMode
                            ) {

                                /*
                                 * Header
                                 */
                                $(".erp-page-header .form-section-header")
                                    .text(
                                        "WEAVELANE FOR PRODUCTION SLEEP - VIEW"
                                    );


                                /*
                                 * Disable all editable controls.
                                 */
                                $("#txtProductionOrderDate")
                                    .prop("disabled", true);

                                $("#filterOrderNo,#filterOrderDate,#filterDesignNo,#filterPartyName,#filterColor,#filterWarpQuality,#filterWeftQuality")
                                    .prop("disabled", true);

                                $("#txtJobWorker")
                                    .prop("disabled", true);

                                $("#txtJobRate")
                                    .prop("disabled", true);

                                $("#chkSelectAll")
                                    .prop("disabled", true);


                                /*
                                 * Existing row inputs/checkboxes
                                 */
                                $("#tblOrderListBody input")
                                    .prop("disabled", true);


                                $("#btnAddForProduction")
                                    .hide();

                            }
                            else if (
                                isProductionEditMode
                            ) {

                                $(".erp-page-header .form-section-header")
                                    .text(
                                        "WEAVELANE FOR PRODUCTION SLEEP - EDIT"
                                    );


                                $("#txtProductionOrderDate")
                                    .prop("disabled", false);

                                $("#filterOrderNo,#filterOrderDate,#filterDesignNo,#filterPartyName,#filterColor,#filterWarpQuality,#filterWeftQuality")
                                    .prop("disabled", false);

                                $("#txtJobWorker")
                                    .prop("disabled", false);

                                $("#txtJobRate")
                                    .prop("disabled", false);

                                $("#chkSelectAll")
                                    .prop("disabled", false);

                                $("#tblOrderListBody input")
                                    .prop("disabled", false);

                                $("#btnAddForProduction")
                                    .show();

                            }
                            else {

                                $(".erp-page-header .form-section-header")
                                    .text(
                                        "WEAVELANE FOR PRODUCTION SLEEP"
                                    );


                                $("#txtProductionOrderDate")
                                    .prop("disabled", false);

                                $("#filterOrderNo,#filterOrderDate,#filterDesignNo,#filterPartyName,#filterColor,#filterWarpQuality,#filterWeftQuality")
                                    .prop("disabled", false);

                                $("#txtJobWorker")
                                    .prop("disabled", false);

                                $("#txtJobRate")
                                    .prop("disabled", false);

                                $("#chkSelectAll")
                                    .prop("disabled", false);

                                $("#tblOrderListBody input")
                                    .prop("disabled", false);

                                $("#btnAddForProduction")
                                    .show();

                            }

                        }
                        function setProductionOrderToday() {

                            var today = new Date();

                            var yyyy =
                                today.getFullYear();

                            var mm =
                                String(
                                    today.getMonth() + 1
                                ).padStart(2, "0");

                            var dd =
                                String(
                                    today.getDate()
                                ).padStart(2, "0");

                            $("#txtProductionOrderDate")
                                .val(
                                    yyyy + "-" + mm + "-" + dd
                                );
                        }
                        function textValue(value) {

                            if (
                                value === null ||
                                value === undefined
