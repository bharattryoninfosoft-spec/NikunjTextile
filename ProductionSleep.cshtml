         PCS / PENDING
         ========================================================= */

        #tblOrderListTable .td-pcs {
            text-align: center !important;
            font-weight: 700 !important;
        }


        #tblOrderListTable .td-ending {
            color: #f04438 !important;
            font-weight: 700 !important;
            text-align: center !important;
        }


