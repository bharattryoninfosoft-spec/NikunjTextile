                        function normalizeDate(value) {

                            if (
                                value === null ||
                                value === undefined ||
                                value === ""
                            ) {

                                return "";

                            }


                            var str =
                                String(value).trim();


                            /*
                             * ASP.NET DATE
                             */

                            var asp =
                                str.match(
                                    /\/Date\((\d+)(?:[+-]\d+)?\)\//
                                );


                            if (asp) {

                                return formatDate(
                                    new Date(
                                        parseInt(
                                            asp[1],
                                            10
                                        )
                                    )
                                );

                            }


                            /*
                             * yyyy-MM-dd
                             */

                            var ymd =
                                str.match(
                                    /^(\d{4})-(\d{1,2})-(\d{1,2})/
                                );


                            if (ymd) {

                                return (
                                    ymd[1] +
                                    "-" +
                                    String(
                                        ymd[2]
                                    ).padStart(2, "0") +
                                    "-" +
                                    String(
                                        ymd[3]
                                    ).padStart(2, "0")
                                );

                            }


                            /*
                             * MM/dd/yyyy
                             *
                             * Current API screenshot:
                             * 08/22/2026
                             */

                            var mdy =
                                str.match(
                                    /^(\d{1,2})\/(\d{1,2})\/(\d{4})/
                                );


                            if (mdy) {

                                return (
                                    mdy[3] +
                                    "-" +
                                    String(
                                        mdy[1]
                                    ).padStart(2, "0") +
                                    "-" +
                                    String(
                                        mdy[2]
                                    ).padStart(2, "0")
                                );

                            }


                            /*
                             * dd-MM-yyyy
                             */

                            var dmy =
                                str.match(
                                    /^(\d{1,2})-(\d{1,2})-(\d{4})/
                                );


                            if (dmy) {

                                return (
                                    dmy[3] +
                                    "-" +
                                    String(
                                        dmy[2]
                                    ).padStart(2, "0") +
                                    "-" +
                                    String(
                                        dmy[1]
                                    ).padStart(2, "0")
                                );

                            }


                            var date =
                                new Date(str);


                            if (
                                !isNaN(date.getTime())
                            ) {

                                return formatDate(date);

                            }


                            return normalizeText(str);

                        }
