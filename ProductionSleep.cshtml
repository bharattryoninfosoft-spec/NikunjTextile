                        function parseDesignDetailsResponse(response) {

                            /*
                             * Supports:
                             * 1. { d: "..." }
                             * 2. { d: {...} }
                             * 3. direct JSON object
                             * 4. old Response.Write JSON + {"d":null}
                             */

                            if (
                                response &&
                                typeof response === "object"
                            ) {

                                var d =
                                    response.d;


                                if (
                                    typeof d === "string"
                                ) {

                                    try {

                                        d =
                                            JSON.parse(d);

                                    }
                                    catch (e) {

                                        d = null;

                                    }

                                }


                                if (
                                    d &&
                                    typeof d === "object"
                                ) {

                                    if (
                                        d.listDesignEntryForm &&
                                        Array.isArray(
                                            d.listDesignEntryForm
                                        )
                                    ) {

                                        return d.listDesignEntryForm[0];

                                    }


                                    return d;

                                }

                            }


                            var raw =
                                response === null ||
                                    response === undefined
                                    ? ""
                                    : String(response);


                            if (
                                !raw
                            ) {

                                return null;

                            }


                            try {

                                var parsed =
                                    JSON.parse(raw);


                                if (
                                    parsed &&
                                    parsed.d
                                ) {

                                    var pd =
                                        parsed.d;


                                    if (
                                        typeof pd === "string"
                                    ) {

                                        pd =
                                            JSON.parse(pd);

                                    }


                                    if (
                                        pd.listDesignEntryForm &&
                                        Array.isArray(
                                            pd.listDesignEntryForm
                                        )
                                    ) {

                                        return pd.listDesignEntryForm[0];

                                    }


                                    return pd;

                                }


                                if (
                                    parsed &&
                                    parsed.listDesignEntryForm &&
                                    Array.isArray(
                                        parsed.listDesignEntryForm
                                    )
                                ) {

                                    return parsed.listDesignEntryForm[0];

                                }


                                return parsed;

                            }
                            catch (e) {

                                /*
                                 * Old response may contain a JSON object
                                 * followed by {"d":null}.
                                 *
                                 * Find the object containing
                                 * listDesignEntryForm.
                                 */

                                var key =
                                    raw.indexOf(
                                        '"listDesignEntryForm"'
                                    );


                                if (
                                    key >= 0
                                ) {

                                    var first =
                                        raw.lastIndexOf(
                                            "{",
                                            key
                                        );


                                    var depth =
                                        0;


                                    var inString =
                                        false;


                                    var escaped =
                                        false;


                                    for (
                                        var i = first;
                                        i < raw.length;
                                        i++
                                    ) {

                                        var ch =
                                            raw.charAt(i);


                                        if (
                                            escaped
                                        ) {

                                            escaped = false;

                                            continue;

                                        }


                                        if (
                                            ch === "\\"
                                        ) {

                                            escaped = true;

                                            continue;

                                        }


                                        if (
                                            ch === '"'
                                        ) {

                                            inString =
                                                !inString;

                                            continue;

                                        }


                                        if (
                                            inString
                                        ) {

                                            continue;

                                        }


                                        if (
                                            ch === "{"
                                        ) {

                                            depth++;

                                        }
                                        else if (
                                            ch === "}"
                                        ) {

                                            depth--;


                                            if (
                                                depth === 0
                                            ) {

                                                try {

                                                    return JSON.parse(
                                                        raw.substring(
                                                            first,
                                                            i + 1
                                                        )
                                                    );

                                                }
                                                catch (ignore) {

                                                    break;

                                                }

                                            }

                                        }

                                    }

                                }

                            }


                            return null;

                        }
