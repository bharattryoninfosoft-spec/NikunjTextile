@{ Layout = "/_LayoutPage1.cshtml"; }

<style>

    /* =========================================================
         PAGE
         ========================================================= */

    .production-page {
        width: 100%;
    }


    /* =========================================================
         SECTION HEADER
         ========================================================= */

    .form-section-header {
        font-size: 13px !important;
        font-weight: 700 !important;
        padding: 7px 12px !important;
        margin-bottom: 0 !important;
        background: #e5f0fc !important;
        border-radius: 2px 2px 0 0 !important;
        color: #222 !important;
    }


    /* =========================================================
         LEFT PANEL
         ========================================================= */

    .production-left-panel {
        border-right: 1px solid #c9cfd6;
        padding-right: 12px;
    }

        .production-left-panel .wl-input-sm,
        .production-left-panel .form-control,
        .production-left-panel .select-single {
            width: 100% !important;
        }


    /* =========================================================
         MAIN TABLE
         ========================================================= */

    .order-table-scroll {
        width: 100%;
        max-height: 330px;
        overflow-x: auto;
        overflow-y: auto;
        border: 1px solid #bfc7d1;
        background: #fff;
    }


    #tblOrderListTable {
        width: 100% !important;
        min-width: 1050px;
        table-layout: fixed !important;
        border-collapse: collapse !important;
        margin: 0 !important;
        font-size: 12px !important;
    }


        #tblOrderListTable th,
        #tblOrderListTable td {
            border: 1px solid #c9cfd6 !important;
            padding: 3px 6px !important;
            height: 29px !important;
            line-height: 20px !important;
            vertical-align: middle !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }


        #tblOrderListTable thead th {
            position: sticky;
            top: 0;
            z-index: 30;
            background: #e4eef9 !important;
            color: #202020 !important;
            font-size: 12px !important;
            font-weight: 700 !important;
            text-align: center !important;
            height: 32px !important;
            padding: 4px 5px !important;
            border: 1px solid #aeb9c6 !important;
        }


        /* =========================================================
         COLUMN WIDTHS
         ========================================================= */

        #tblOrderListTable th:nth-child(1),
        #tblOrderListTable td:nth-child(1) {
            width: 42px !important;
        }


        #tblOrderListTable th:nth-child(2),
        #tblOrderListTable td:nth-child(2) {
            width: 105px !important;
        }


        #tblOrderListTable th:nth-child(3),
