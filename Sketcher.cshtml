@{
    Layout = "/_LayoutPage1.cshtml";
}


<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="0" />
    <input type="hidden" id="edit-id" value="" />

    <!-- Action Header -->
    <div class="card-header-lg mb-3">
        <button id="AddFinacialYearModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Sketcher</button>
        <div style="clear:both;"></div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addNewContactLabel">Add Sketcher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row gutters">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="row gutters">
                                <div class="col-6">
                                    <div class="field-wrapper">
                                        <input type="text" id="Sketcher" name="Sketcher" class="form-control clear-field" onfocusout="validate(this)">
                                        <div class="field-placeholder">Sketcher <sup style="color:red;">*</sup></div>
                                        <div class="Sketcher-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="Sketcher-invalid-feedback invalid-feedback">Please Mention Sketcher</div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="field-wrapper pt-3">
                                        <div class="form-check form-check-inline">
                                            <input id="IsActive" class="form-check-input" type="checkbox" value="1" checked>
                                            <label class="form-check-label" for="IsActive">Is Active</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                    <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                    <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                    <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Container -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Sketcher Master</div>
                    <br />
                    <div class="row gutters mb-3">
                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12"></div>
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <div class="field-wrapper">
                                <input id="search-Sketcher" placeholder="Search Sketcher" type="text" class="form-control clear-field detail" onkeyup="functionSearch()">
                                <div class="field-placeholder">Search Sketcher</div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="sketcherTable" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr style="background-color: #1273eb;">
                                    <th style="color:white; width: 10%;">Sr No</th>
                                    <th style="color:white; width: 50%;">Sketcher</th>
                                    <th style="color:white; width: 20%;">Is Active</th>
                                    <th style="color:white; width: 20%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dynamic dynamic rows -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View More / Pagination -->
    <div class="view-more-styl-class text-center my-3">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
    </div>
</div>

@section Scripts{
<script>
    $(document).ready(function () {
        FunctionIsLogin();
        displayData(0);
    });

    // SweetAlert Utility Helper
    function showAlert(title, message, icon) {
        Swal.fire({
            title: title,
            text: message,
            icon: icon,
            timer: 2000,
            showConfirmButton: false
        });
    }

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: JSON.stringify({ userName: '0' }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    function functionSearch() {
        displayData(0);
    }

    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck !== 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        } else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }

        var searchSketcher = $("#search-Sketcher").val();
        var formData = new FormData();
        formData.append('searchSketcher', searchSketcher);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getSketcherMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#sketcherTable tbody").empty();
                }

                if (!response.listSketcherMaster || response.listSketcherMaster.length < 10) {
                    $("#view-more-btn").hide();
                } else {
                    $("#view-more-btn").show();
                }

                var temp = "";
                var SrNo = rowStart + 1;

                if (response.listSketcherMaster && response.listSketcherMaster.length > 0) {
                    for (var i = 0; i < response.listSketcherMaster.length; i++) {
                        var item = response.listSketcherMaster[i];
                        temp += "<tr>";
                        temp += "<td>" + SrNo++ + "</td>";
                        temp += "<td>" + item.Sketcher + "</td>";

                        if (item.IsActive == "1") {
                            temp += "<td><span class='badge bg-success'>Active</span></td>";
                        } else {
                            temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                        }

                        temp += "<td><div class='actions'>";
                        temp += "<a href='javascript:void(0);' class='EditBtn' title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + item.SketcherID + ")'>";
                        temp += "<i class='icon-edit1 text-info '></i></a>&nbsp;&nbsp;";
                        temp += "<a href='javascript:void(0);' class='DeleteBtn' title='Delete' onclick='functionYarnDelete(" + item.SketcherID + ")'>";
                        temp += "<i class='icon-x-circle text-danger'></i></a>";
                        temp += "</div></td>";
                        temp += "</tr>";
                    }
                }

                $("#sketcherTable tbody").append(temp);

                // Permission Handling
                var permission = getCookie("PagePermission");
                if (permission) {
                    var currentPagePermission = JSON.parse(permission);
                    if (currentPagePermission.Add === false) { $("#AddFinacialYearModel").hide(); }
                    if (currentPagePermission.Edit === false) { $(".EditBtn").hide(); }
                    if (currentPagePermission.Delete === false) { $(".DeleteBtn").hide(); }
                }
            },
            error: function (error) {
                showAlert("Error", "Problem occurred while fetching records.", "error");
            }
        });
    }

    function clearAll() {
        $("#savebtn").show();
        $("#saveViewbtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add Sketcher");

        $("#edit-id").val('');
        $("#Sketcher").val('');
        $("#IsActive").prop('checked', true);

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback, .valid-feedback").hide();
    }

    function checkSaveView() {
        if (!validate(document.getElementById('Sketcher'))) return;

        var formData = new FormData();
        formData.append('Sketcher', $('#Sketcher').val());
        formData.append('IsActive', $("#IsActive").is(':checked') ? "1" : "0");

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/insertSketcherMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 201) {
                    clearAll();
                    showAlert("Success", response.Message || "Record saved successfully.", "success");
                    displayData(0);
                    $("#cancelbtn").click();
                } else {
                    showAlert("Warning", response.Message || "Could not save record.", "warning");
                }
            },
            error: function () {
                showAlert("Error", "Error processing request.", "error");
            }
        });
    }

    function checkSave() {
        if (!validate(document.getElementById('Sketcher'))) return;

        var formData = new FormData();
        formData.append('Sketcher', $('#Sketcher').val());
        formData.append('IsActive', $("#IsActive").is(':checked') ? "1" : "0");

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/insertSketcherMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 201) {
                    clearAll();
                    showAlert("Success", response.Message || "Record saved successfully.", "success");
                    displayData(0);
                } else {
                    showAlert("Warning", response.Message || "Could not save record.", "warning");
                }
            },
            error: function () {
                showAlert("Error", "Error processing request.", "error");
            }
        });
    }

    function checkEdit() {
        if (!validate(document.getElementById('Sketcher'))) return;

        var formData = new FormData();
        formData.append('SketcherID', $("#edit-id").val());
        formData.append('Sketcher', $('#Sketcher').val());
        formData.append('IsActive', $("#IsActive").is(':checked') ? "1" : "0");

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/EditSketcherMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 201) {
                    clearAll();
                    showAlert("Success", response.Message || "Record updated successfully.", "success");
                    displayData(0);
                    $("#cancelbtn").click();
                } else {
                    showAlert("Warning", response.Message || "Update failed.", "warning");
                }
            },
            error: function () {
                showAlert("Error", "Error processing request.", "error");
            }
        });
    }

    function showRecords(id) {
        clearAll();
        $("#edit-id").val(id);
        $("#saveViewbtn, #savebtn").hide();
        $("#editbtn").show();
        $("#addNewContactLabel").html("Edit Sketcher");

        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getSketcherMasterById?id=' + id,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if ((response.Code == 200 || response.Code == "200") && response.listSketcherMaster.length > 0) {
                    var data = response.listSketcherMaster[0];
                    $("#Sketcher").val(data.Sketcher);
                    $("#IsActive").prop('checked', data.IsActive == "1");
                } else {
                    showAlert("Warning", response.Message || "Unable to retrieve record details.", "warning");
                }
            },
            error: function () {
                showAlert("Error", "Error processing request.", "error");
            }
        });
    }

    function functionYarnDelete(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new FormData();
                formData.append('SketcherID', id);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/DeleteSketcherMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 200) {
                            showAlert("Deleted!", "Sketcher deleted successfully.", "success");
                            displayData(0);
                        } else {
                            showAlert("Failed", "Problem occurred while deleting Sketcher.", "error");
                        }
                    },
                    error: function () {
                        showAlert("Error", "Problem occurred while deleting Sketcher.", "error");
                    }
                });
            }
        });
    }

    function validate(code) {
        code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";

        $(".invalid-feedback, .valid-feedback").hide();

        if (code.value === "") {
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        } else {
            document.getElementById(code.id).classList.add("is-valid");
            document.getElementById(code.id).classList.remove("is-invalid");
            $(errorMessageValid).show();
            return true;
        }
    }
</script>
}