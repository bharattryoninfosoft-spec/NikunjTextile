    function displayData(rowStartCheck) {

        var rowStart = rowStartCheck;

        var searchpartyname = $("#search-GodownManager-name").val();

        var formData = new FormData();
        formData.append('searchGodownManagerName', searchpartyname);
        formData.append('startFrom', rowStart);



        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getGodownManagerMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";

                var srno = parseInt(rowStart) + parseInt(1);
                for (var i = 0; i < response.listGodownManager.length; i++) {

                    temp += "<tr><td>" + srno++ + "</td>";
                    temp += "<td>" + response.listGodownManager[i].DateandTimes + "</td>";
                    temp += "<td>" + response.listGodownManager[i].GodownManagerName + "</td>";
                    temp += "<td>" + response.listGodownManager[i].MobileNo + "</td>";
                    
                    if (response.listGodownManager[i].AlterMobileNo != "0") {
                        temp += "<br />" + response.listGodownManager[i].AlterMobileNo;
                    }
                    temp += "</td>";
                    temp += "<td>" + response.listGodownManager[i].Email + "</td>";
                    temp += "<td>" + response.listGodownManager[i].ManagerAddress + "</td>";

                     
                    if (response.listGodownManager[i].IsActiveManager == "1" || response.listGodownManager[i].IsActiveManager == 1) {
                        IsApproved = "<span class='badge bg-success'>Approved</span>";
                    }
                    else {
                        IsApproved = "<span class='badge bg-danger'>Not Approved</span>";
                    }
                    temp += "<td>" + IsApproved + "</td>";
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listGodownManager[i].GodownManagerID + ",1)'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listGodownManager[i].GodownManagerID + ",0)'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listGodownManager[i].GodownManagerID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }





