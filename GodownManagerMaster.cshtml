    function showRecords(id, status) {
        clearAll();



        $("#edit-id").val(id);
        $("#saveViewbtn").hide();
        $("#savebtn").hide();
        $("#saveViewbtn").hide();

        if (status == 0 || status == "0") {
            $("#addNewContactLabel").html("Godown Manager Details");
            $(".detail").attr("disabled", true);
            $("#editbtn").hide();
        }
        else {
            $("#addNewContactLabel").html("Edit Godown Manager");
            $(".detail").attr("disabled", false);
            $("#editbtn").show();
        }

        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getGodownManagerMasterById?id=' + id,
            data: "{ 'id':'" + id + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {

                    //alert(response.listGodownManager[0].GodownManagerName);
                    $("#GodownManagerName").val(response.listGodownManager[0].GodownManagerName);
                    $('#MobileNo').val(response.listGodownManager[0].MobileNo);
                    $('#MobileNotemp').val(response.listGodownManager[0].MobileNo);
                    $('#AlterMobileNo').val(response.listGodownManager[0].AlterMobileNo);
                    $('#email').val(response.listGodownManager[0].email);

                    $("textarea#ManagerAddress").val(response.listGodownManager[0].ManagerAddress);
                     
                    if (response.listGodownManager[0].IsActiveManager == "1") {
                        $("#chcekIsActiveManager").prop("checked", true);
                    }
                    else {
                        $("#chcekIsActiveManager").prop("checked", false);
                    }

                }
                else {

                    notess.show(response.Message, {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });
                }

            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notess.show(response.Message, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });
            }
        });
    }





