            if ($("#gstStat").prop("checked") == true) {
                $(".gst-clear").show();
            }
            else {
                $(".gst-clear").hide();
            }
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            }
            else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }

            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMaster?startFrom=' + rowStart,
                data: "{ 'startFrom':'" + rowStart + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    // Your original cookie permission check setup
                    var permission = getCookie("PagePermission");
                    if (permission != null && permission != "") {
                        var currentPagePermission = JSON.parse(permission);
                        if (currentPagePermission.Add == false) {
                            $("#AddCompayModel").hide();
                        }
                    }
                    // Clear only the tbody content so the DataTable structure stays intact
                    var tbody = $('#copy-print-csv tbody');
                    if (rowStart == 0) {
                        tbody.empty();
                    }

                    var temp = "";
                    var operation = "";

                    if (response.listCompanyMaster.length < 10) {
                        $("#view-more-btn").hide();
                    }
                    else {
                        $("#view-more-btn").show();
                    }

                    if (response.listCompanyMaster.length == 2) {
                        $("#AddCompayModel").hide();
                    }
                    else {
                        $("#AddCompayModel").show();
                    }

                    for (var i = 0; i < response.listCompanyMaster.length; i++) {
                        var deleteStr = "";
                        if (response.listCompanyMaster[i].is_default == "1" || response.listCompanyMaster[i].is_default == 1) {
                            operation = "<span class='badge bg-success'>Yes</span>";
                        }
                        else {
                            operation = "<span class='badge bg-danger'>No</span>";
                            if (currentPagePermission.Delete == true || currentPagePermission.Delete == "true") {
                                deleteStr = "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='Delete' onclick='functionCompanyDelete(" + response.listCompanyMaster[i].CompanyId + ")'><i class='icon-x-circle text-danger'></i></a>";
                            }
                        }

                        temp += "<tr>";
                        temp += "<td><div class='media-box'><img style='width:40px;height:40px;' src='" + response.listCompanyMaster[i].CompanyLogo + "' class='media-avatar' alt='Logo'><div class='media-box-body'><a href='javascript:void(0);' class='text-truncate'>" + response.listCompanyMaster[i].CompanyName + "</a><p></p></div></div></td>";
                        temp += "<td>" + response.listCompanyMaster[i].MobileNo + "</td>";
                        temp += "<td>" + response.listCompanyMaster[i].Email + "</td>";
                        temp += "<td>" + response.listCompanyMaster[i].StateTitle + "</td>";
                        temp += "<td>" + operation + "</td>";
                        temp += "<td><div class='actions'>";

                   

                        // Permission-based Edit action
                        if (currentPagePermission.Edit == true || currentPagePermission.Edit == "true") {
                            temp += "<a href='javascript:void(0);' title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listCompanyMaster[i].CompanyId + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;";
                            $("#editbtn-default").show();
                        } else {
                            $("#editbtn-default").hide();
                        }

                        // Permission-based Delete action
                        if (currentPagePermission.Delete == true || currentPagePermission.Delete == "true") {
                            temp += deleteStr;
                        }

                        temp += "</div></td>";
                        temp += "</tr>";
                    }

                    // Append rows directly to the table body
                    tbody.append(temp);
                },
                error: function (request, status, error) {
                    showToast('error', 'Failed to load company records.');
                }
            });
        }

        function showRecords(id) {
            clearAll();
            $("#upload-image-temp").val("");
            $("#upload-sign-temp").val("");
            $("#upload-image").val("");
            $("#upload-sign").val("");
            $("#edit-id").val(id);
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Edit Company");
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterById?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-name").val(response.listCompanyMaster[0].CompanyName);
                        $('#email').val(response.listCompanyMaster[0].Email);
                        $('#phone').val(response.listCompanyMaster[0].MobileNo);
                        $('#alt-phone').val(response.listCompanyMaster[0].AlterMobileNo);

                        longfunctionfirst(getStatess(response.listCompanyMaster[0].State));
                        longfunctionfirst(getBusinessTypess(response.listCompanyMaster[0].BusinessType));
                        longfunctionfirst(getBusinessCatss(response.listCompanyMaster[0].BusinessCategory));

