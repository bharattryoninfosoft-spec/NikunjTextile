<script>

    $(document).ready(function () {
        loadDynamicMenu();
    });    
    function loadDynamicMenu() {
        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/GetDynamicMenu',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (response) {
                console.log(response);
                var menus = response.d;
                console.log(menus);                
                $("#dynamicMenuTabs").find(".nav-link").remove();
                $("#dynamicMenuContent").empty();                
                $.each(menus, function (i, menu) {
                   var tabHtml = `<a class="nav-link" id="tab_${menu.Menu_Id}_link" data-bs-toggle="tab" href="#tab_${menu.Menu_Id}" role="tab">
                                    <i class="bi ${menu.Menu_Icon}"></i>
                                    <span class="nav-link-text">${menu.Menu_Name}</span>
                                </a>`;
                    $("#dynamicMenuTabs").append(tabHtml);
                    var submenuHtml = '';
                    $.each(menu.SubMenus, function (j, sub) {
                        var url = '#';
                        if (sub.Controller != '' && sub.Controller != '#') {
                            url = '/' + sub.Controller;
                        }
                        submenuHtml += `<li> <a href="${url}" id="submenu_${sub.SubMenu_Id}">
                                                <i class="bi ${sub.SubMenu_Icon} me-2"></i> ${sub.SubMenu_Name} </a> </li>`;
                    });              
                    var contentHtml = `<div class="tab-pane fade" id="tab_${menu.Menu_Id}" role="tabpanel">
                                                <div class="tab-pane-header">
                                                    <i class="bi ${menu.Menu_Icon} me-2"></i>
                                                                 ${menu.Menu_Name}
                                                 </div>
                                        <div class="sidebarMenuScroll"> <div class="sidebar-menu"> <ul> ${submenuHtml} </ul> </div> </div>
                                        </div>`;
                                    $("#dynamicMenuContent").append(contentHtml);
                 });
                var currentUrl = window.location.pathname.toLowerCase();
                //console.log("Current URL:", currentUrl);
                $("#dynamicMenuContent a").each(function () {
                    var menuUrl = $(this).attr("href").toLowerCase();
                    //console.log(menuUrl);
                    if (currentUrl == menuUrl) {                     
                        $(this).addClass("current-page");
                       var tabPane = $(this).closest(".tab-pane");
                           tabPane.addClass("show active");                      
                        var tabId = tabPane.attr("id");
                        $('#dynamicMenuTabs a[href="#' + tabId + '"]').addClass("active");
                    }
                });
                if ($("#dynamicMenuTabs .active").length == 0) {
                    $("#dynamicMenuTabs .nav-link:first").addClass("active");
                    $("#dynamicMenuContent .tab-pane:first").addClass("show active");
                }
            },
            error: function (xhr, status, error) {
                //console.log(xhr.responseText);
                Swal.fire({
                    icon: 'error',
                    title: 'Menu Error',
                    text: xhr.responseText
                });
            }
        });
    }

</script>
