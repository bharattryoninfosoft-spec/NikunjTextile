        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    console.log(data);
                    if (data.d == "false") {
                        Swal.fire({
                            icon: "warning",
                            title: "Session Expired",
                            text: "Please login again."
                        }).then(() => {
                            window.location.replace("/Index");
                        });
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }
        loadDynamicMenu();
        // Global Select2 extension to keep UI in sync when setting .val() programmatically (with recursion guard)
        (function ($) {
            if (!$ || !$.fn) return;
            var origVal = $.fn.val;
            var isSyncingVal = false;

            $.fn.val = function () {
                if (arguments.length === 0) {
                    return origVal.apply(this, arguments);
                }

                var isSelect = this.is("select");
                var oldVal = isSelect ? this.val() : null;
                var result = origVal.apply(this, arguments);

                if (isSelect && !isSyncingVal) {
                    var newVal = this.val();
                    if (oldVal !== newVal) {
                        isSyncingVal = true;
                        try {
                            this.each(function () {
                                var $select = $(this);
                                if ($select.data("select2")) {
                                    $select.trigger("change.select2");
                                }
                            });
                        } finally {
                            isSyncingVal = false;
                        }
                    }
                }
                return result;
            };
        })(jQuery);

        window.initAllSelect2 = function (context) {
            if (typeof $.fn.select2 !== "function") return;
            var $target = context ? $(context).find("select") : $("select");

            $target.not(".no-select2, .swal2-select, .swal-select, .swal2-container select, .swal-container select").each(function () {
                var $select = $(this);
                if (!$select.data("select2")) {
                    $select.select2({
                        width: "100%"
                    });
                }
            });
        };

        $(document).ready(function () {
            window.initAllSelect2();
        });

        $(document).ajaxComplete(function () {
            setTimeout(function () {
                window.initAllSelect2();
            }, 100);
        });

        $(document).on("change", "select", function () {
            if (typeof validate === "function" && this.id) {
                validate(this);
            }
        });

        $(document).ajaxError(function (event, jqXHR, ajaxSettings, thrownError) {
            if (jqXHR.status !== 0 && jqXHR.status !== 200 && ajaxSettings.url && !ajaxSettings.url.includes("LogErrorRecord")) {
                var errorMsg = "AJAX Failure: " + (thrownError || jqXHR.statusText) + " (HTTP " + jqXHR.status + ")";
                $.ajax({
                    type: "POST",
                    url: "/WebServiceNikunjTextile.asmx/LogErrorRecord",
                    data: JSON.stringify({
                        moduleName: "Client Application",
                        methodName: ajaxSettings.url,
                        errorMessage: errorMsg,
                        stackTrace: jqXHR.responseText || ""
                    }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function () {},
                    error: function () {}
                });
            }
        });

        $(document).ready(function () {
            setTimeout(function () {
                if (typeof window.highlightCurrentMenu === "function") {
                    window.highlightCurrentMenu();
                }
            }, 200);
        });
        window.highlightCurrentMenu = function () {
            var rawPath = (window.location.pathname || "").toLowerCase().replace(/\.cshtml$/i, "").replace(/\/$/, "");
            if (!rawPath || rawPath === "/") rawPath = "/dashboard";

            var currentUrlClean = (window.location.pathname + window.location.search).toLowerCase().replace(/\.cshtml$/i, "").replace(/\/$/, "");
            var cleanPath = rawPath;

            // Comprehensive lowercased page mapping for form, edit, create, and list route variants
            var pageMap = {
                // Production & Slips
                "/productionsleep": "/jobproductionorderlist",
                "/jobproductionorderlist": "/jobproductionorderlist",

                // Butta Cutting & Jobber Flow
                "/jobbertobuttacutting": "/jobbertobuttacuttinglist",
                "/receivejobbertobuttacutting": "/buttacuttingreceivelist",
                "/buttacuttingreceive": "/buttacuttingreceivelist",
                "/buttacuttingstock": "/buttacuttingstocklist",
                "/buttacuttingtojobber": "/buttacuttingtojobberlist",
                "/jobberreceive": "/jobberreceivelist",
                "/buttacuttinghistory": "/buttacuttinghistorylist",
                "/buttacuttingjobberreceive": "/buttacuttingjobberreceivelist",

                // Process Flow
                "/jobbertoprocess": "/jobbertoprocesslist",
                "/jobbertoprocessprint": "/jobbertoprocesslist",
                "/processreceive": "/processreceivelist",
                "/processstock": "/processstock",
                "/processissueback": "/processissuebacklist",
                "/processmanagementhistory": "/processmanagementhistory",

                // Sales Order
                "/updatedesigncolormatching": "/createdesigncolormatching",
                "/updatedesignentry": "/createdesignentry",
                "/updatesaleorderentry": "/listsaleorderentry",
                "/saleorderentry": "/listsaleorderentry",

                // Yarn Flow
                "/updateyarninward": "/createyarninward",
                "/updateyarnoutwardchallan": "/yarnoutwardchallandetails",
                "/yarnoutwardchallan": "/yarnoutwardchallandetails",
                "/yarnoutwardchallannew": "/yarnoutwardchallandetails",
                "/updateyarnoutwardchallannew": "/yarnoutwardchallandetails",
                "/updateyarnoutwardscan": "/yarnoutwardscandetails",
                "/yarnoutwardscan": "/yarnoutwardscandetails",
                "/updateyarnpo": "/createyarnpo",
                "/updateyarnrequirement": "/createyarnrequirement",

                // Jobber Inward / Outward
                "/createjobberinward": "/createjobberinward",
                "/jobberyarninward": "/jobberyarninward",
                "/createjobberoutward": "/createjobberoutward",
                "/jobberoutwardlist": "/jobberoutwardlist"
            };

            var targetPath = pageMap[cleanPath] || cleanPath;
            var isFound = false;

            // Reset menu selection state
            $("#dynamicMenuTabs .nav-link").removeClass("active");
            $("#dynamicMenuContent .tab-pane").removeClass("show active");
            $("#dynamicMenuContent a").removeClass("current-page");

            // 1. Direct or PageMap match
            $("#dynamicMenuContent a").each(function () {
                var href = ($(this).attr("href") || "").toLowerCase().replace(/\.cshtml$/i, "").replace(/\/$/, "");
                if (!href || href === "#") return;

                if (href === cleanPath || href === currentUrlClean || href === targetPath) {
                    isFound = true;
                    $(this).addClass("current-page");

                    var tabPane = $(this).closest(".tab-pane");
                    tabPane.addClass("show active");

                    var tabId = tabPane.attr("id");
                    if (tabId) {
                        $('#dynamicMenuTabs a[href="#' + tabId + '"]').addClass("active");
                    }

                    document.title = $(this).text().trim() + " - Nikunj Textile";
                    return false; // Break $.each loop
                }
            });

            // 2. Base-name / Fuzzy match fallback (e.g. /jobbertobuttacutting -> /jobbertobuttacuttinglist)
            if (!isFound) {
                $("#dynamicMenuContent a").each(function () {
                    var href = ($(this).attr("href") || "").toLowerCase().replace(/\.cshtml$/i, "").replace(/\/$/, "");
                    if (!href || href === "#") return;

                    var hrefNoList = href.replace(/list$/i, "");
                    var cleanNoList = cleanPath.replace(/list$/i, "");
                    var targetNoList = targetPath.replace(/list$/i, "");

                    if (hrefNoList === cleanNoList || hrefNoList === targetNoList || cleanNoList === href || targetNoList === href) {
                        isFound = true;
                        $(this).addClass("current-page");

                        var tabPane = $(this).closest(".tab-pane");
                        tabPane.addClass("show active");

                        var tabId = tabPane.attr("id");
                        if (tabId) {
                            $('#dynamicMenuTabs a[href="#' + tabId + '"]').addClass("active");
                        }

                        document.title = $(this).text().trim() + " - Nikunj Textile";
                        return false;
                    }
                });
            }

            // 3. Fallback: Default to first tab if nothing matched
            if (!isFound && $("#dynamicMenuTabs .active").length === 0) {
                $("#dynamicMenuTabs .nav-link:first").addClass("active");
                $("#dynamicMenuContent .tab-pane:first").addClass("show active");
            }
        };

        function loadDynamicMenu() {
            $.ajax({
                url: '/WebServiceNikunjTextile.asmx/GetDynamicMenu',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',

                success: function (response) {
                    var menus = response.d;                  
                    // CLEAR OLD STORAGE
                    deleteCookie("PagePermission");
                    $("#dynamicMenuTabs").find(".nav-link").remove();
                    $("#dynamicMenuContent").empty();

                    $.each(menus, function (i, menu) {

                        // LEFT TAB MENU
                        var tabHtml = `<a class="nav-link" id="tab_${menu.Menu_Id}_link" data-bs-toggle="tab" href="#tab_${menu.Menu_Id}" role="tab">
                                                          <i class="bi ${menu.Menu_Icon}"></i>
                                                                    <span class="nav-link-text"> ${menu.Menu_Name} </span> </a>`;
                        $("#dynamicMenuTabs").append(tabHtml);
                        var submenuHtml = '';
                        $.each(menu.SubMenus, function (j, sub) {
                            var url = '#';
                            if (sub.Controller != '' && sub.Controller != '#') {
                                url = '/' + sub.Controller;
                            }
                            // CURRENT PAGE
                            var currentPage = window.location.pathname.toLowerCase().replace("/", "");
                            // MENU PAGE
                            var menuPage = sub.Controller.toLowerCase().replace("/", "");
                            // STORE CURRENT PAGE PERMISSION
                            if (currentPage == menuPage) {
                                console.log("Permission Set :", sub);
                                setCookie("PagePermission", JSON.stringify(sub), 1);
                            }
                            submenuHtml += `<li> <a href="${url}" id="submenu_${sub.SubMenu_Id}">
                                                                                                                                                                                                  <i class="bi ${sub.SubMenu_Icon} me-2"></i> ${sub.SubMenu_Name} </a> </li>`;
                        });
                        // RIGHT SIDE SUBMENU
                        var contentHtml = `<div class="tab-pane fade" id="tab_${menu.Menu_Id}"  role="tabpanel">
                                                                                                                                                                                          <div class="tab-pane-header"> <i class="bi ${menu.Menu_Icon} me-2"></i> ${menu.Menu_Name} </div>
                                                                                                                                                                                          <div class="sidebarMenuScroll">
                                                                                                                                                                                              <div class="sidebar-menu">
                                                                                                                                                                                                  <ul> ${submenuHtml} </ul>
                                                                                                                                                                                              </div>
                                                                                                                                                                                          </div>
                                                                                                                                                                                      </div>`;
                        $("#dynamicMenuContent").append(contentHtml);
                    });

                    // HIGHLIGHT ACTIVE CURRENT PAGE MENU ITEM
                    window.highlightCurrentMenu();
                },
                error: function (xhr, status, error) {
                    console.log(xhr.responseText);
                    Swal.fire({
                        icon: 'error',
                        title: 'Menu Error',
                        text: xhr.responseText
                    });
                }
            });
        }
        $("#toggle-sidebar").on("click", function () {
            $(".sidebar-wrapper").toggleClass("collapsed");
            $(".main-container").toggleClass("expanded");
        });

        function logout() {
            Swal.fire({
                title: "Logout Confirmation",
                text: "Are you sure you want to logout?",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Logout",
                confirmButtonColor: "#dc3545",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/Logout',
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        complete: function () {
                            window.location.replace("/Index");
                        }
                    });
                }
            });
        }
        function setCookie(name, value, days) {

            var expires = "";

            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }

            document.cookie = name + "=" + encodeURIComponent(value) + expires + "; path=/";
        }

        function getCookie(name) {

            var cookieName = name + "=";
            var cookies = document.cookie.split(";");

            for (var i = 0; i < cookies.length; i++) {

                var c = cookies[i].trim();

                if (c.indexOf(cookieName) == 0) {
                    return decodeURIComponent(c.substring(cookieName.length));
                }
            }

            return null;
        }

        function deleteCookie(name) {
            document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 UTC;path=/;";
        }

        function openChangePasswordModal() {
            $('#txtOldPassword').val('');
            $('#txtNewPassword').val('');
            $('#txtConfirmPassword').val('');
            $('#changePasswordAlert').addClass('d-none').removeClass('alert-danger alert-success').html('');
            
            if (typeof $('#changePasswordModal').modal === 'function') {
                $('#changePasswordModal').modal('show');
            } else if (window.bootstrap && bootstrap.Modal) {
                try {
                    var modalEl = document.getElementById('changePasswordModal');
                    var modal = (typeof bootstrap.Modal.getInstance === 'function' ? bootstrap.Modal.getInstance(modalEl) : null) || new bootstrap.Modal(modalEl);
                    modal.show();
                } catch (e) {
                    $('#changePasswordModal').addClass('show').css('display', 'block');
                }
            } else {
                $('#changePasswordModal').addClass('show').css('display', 'block');
            }
        }

        function togglePasswordVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        function hideChangePasswordModal() {
            if (typeof $('#changePasswordModal').modal === 'function') {
                $('#changePasswordModal').modal('hide');
            } else if (window.bootstrap && bootstrap.Modal) {
                try {
                    var modalEl = document.getElementById('changePasswordModal');
                    var modal = typeof bootstrap.Modal.getInstance === 'function' ? bootstrap.Modal.getInstance(modalEl) : null;
                    if (modal) modal.hide();
                    else $('#changePasswordModal').removeClass('show').css('display', 'none');
                } catch (e) {
                    $('#changePasswordModal').removeClass('show').css('display', 'none');
                }
            } else {
                $('#changePasswordModal').removeClass('show').css('display', 'none');
            }
        }

        function submitChangePassword() {
            var oldPass = $('#txtOldPassword').val().trim();
            var newPass = $('#txtNewPassword').val().trim();
            var confirmPass = $('#txtConfirmPassword').val().trim();
            var alertBox = $('#changePasswordAlert');

            if (!oldPass || !newPass) {
                alertBox.removeClass('d-none alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-2"></i>Please enter both Current Password and New Password.');
                return;
            }
            if (newPass.length < 4) {
                alertBox.removeClass('d-none alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-2"></i>New password must be at least 4 characters long.');
                return;
            }
            if (newPass !== confirmPass) {
                alertBox.removeClass('d-none alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-2"></i>New Password and Confirm Password do not match.');
                return;
            }

            alertBox.addClass('d-none');
            $('#btnSavePassword').prop('disabled', true);
            $('#btnSavePasswordSpinner').removeClass('d-none');

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/ChangeUserPassword',
                data: {
                    OldPassword: oldPass,
                    NewPassword: newPass,
                    ConfirmPassword: confirmPass
                },
                dataType: "json",
                success: function (response) {
                    $('#btnSavePassword').prop('disabled', false);
                    $('#btnSavePasswordSpinner').addClass('d-none');

                    var res = response.d || response;
                    if (typeof res === "string") {
                        try { res = JSON.parse(res); } catch (e) {}
                    }

                    if (res.Code === 200) {
                        hideChangePasswordModal();

                        // Perform Auto-Logout and Redirect to Login Screen
                        $.ajax({
                            type: "POST",
                            url: '/WebServiceNikunjTextile.asmx/Logout',
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            complete: function () {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Password Updated Successfully!',
                                    text: 'Your password has been changed. Please log in with your new password.',
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#0d6efd',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                }).then(() => {
                                    window.location.replace("/Index");
                                });
                            }
                        });
                    } else {
                        var errMsg = res.Message || 'Failed to update password. Please check your current password.';
                        alertBox.removeClass('d-none alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-2"></i>' + errMsg);
                    }
                },
                error: function (xhr, status, error) {
                    $('#btnSavePassword').prop('disabled', false);
                    $('#btnSavePasswordSpinner').addClass('d-none');
                    alertBox.removeClass('d-none alert-success').addClass('alert-danger').html('<i class="bi bi-exclamation-triangle-fill me-2"></i>An unexpected server error occurred. Please try again.');
                }
            });
        }
    </script>

    <!-- Change Password Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title text-white" id="changePasswordModalLabel">
                        <i class="bi bi-key me-2"></i>Change Password
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="changePasswordAlert" class="alert d-none" role="alert"></div>
                    <form id="changePasswordForm" autocomplete="off" onsubmit="return false;">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Current Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="txtOldPassword" placeholder="Enter current password" required />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('txtOldPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">New Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="txtNewPassword" placeholder="Enter new password (min 4 chars)" required />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('txtNewPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">Confirm New Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="txtConfirmPassword" placeholder="Re-enter new password" required />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('txtConfirmPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" id="btnSavePassword" onclick="submitChangePassword()">
                        <span id="btnSavePasswordSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                        Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>



