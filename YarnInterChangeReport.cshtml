        function renderTable() {
            let start = (currentPage - 1) * pageSize;
            let pageData = filteredData.slice(start, start + pageSize);
            let html = "";

            pageData.forEach((item, i) => {
                let badge = item.Move === "YES"
                    ? '<span class="badge bg-success">YES</span>'
                    : '<span class="badge bg-danger">NO</span>';

                let rowClass = item.Move === "YES" ? "table-success" : "";
                const date = item.DateAndTime ? new Date(item.DateAndTime).toLocaleString('en-IN') : '-';

                html += `
                        <tr class="${rowClass}">
                            <td>${start + i + 1}</td>
                            <td>${date}</td>
                            <td>${item.User || '-'}</td>
                            <td>${item.Box || '-'}</td>
                            <td>${item.Material || '-'}</td>
                            <td>${item.Color || '-'}</td>
                            <td>${item.Party || '-'}</td>
