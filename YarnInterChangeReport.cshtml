<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>






<script>

    document.title = "Yarn Inter Change Report - Nikunj Textile";
    $('body').addClass('fullscreen');
    let fullData = [];
    let filteredData = [];
    let currentPage = 1;
    let pageSize = 10;
    const { jsPDF } = window.jspdf;
    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#Report-tab").addClass("active");
        $("#tab-Report").addClass("show active");
        $("#aYarnInterChangeReport").addClass("current-page");
        $(".nav-tabs .nav-link").removeClass("active");
        $(".nav-tabs .nav-link").attr("aria-selected", "false");
        $(".nav-tabs .nav-link[data-report='1']").addClass("active");
        $(".nav-tabs .nav-link[data-report='1']").attr("aria-selected", "true");
        FunctionIsLogin();
        loadReport();
    });
    $("#filterBox, #filterMaterial, #filterColor, #filterParty, #filterPO, #filterGodown, #filterMove")
        .on("change", function () {
            applyFilters();
        });
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            }
        });
    }
    let groupedData = {}; // ✅ GLOBAL (important)
    function applyFilters() {

        let box = $("#filterBox").val().toLowerCase();
        let material = $("#filterMaterial").val().toLowerCase();
        let color = $("#filterColor").val().toLowerCase();
        let party = $("#filterParty").val().toLowerCase();
        let po = $("#filterPO").val().toLowerCase();
        let godown = $("#filterGodown").val().toLowerCase();
        let move = $("#filterMove").val();

        filteredData = fullData.filter(x => {

            return (!box || x.BoxNo?.toLowerCase().includes(box)) &&
                (!material || x.YarnMaterial?.toLowerCase().includes(material)) &&
                (!color || x.YarnColor?.toLowerCase().includes(color)) &&
                (!party || x.PartyName?.toLowerCase().includes(party)) &&
                (!po || x.PONo?.toString().toLowerCase().includes(po)) &&
                (!godown || x.GodownTitle?.toLowerCase().includes(godown)) &&
                (!move || x.MOVEBOXORNOT === move);
        });

        currentPage = 1;
        renderTable();
    }
    function loadReport() {

        $.ajax({
            type: "POST",
            url: "/WebServiceNikunjTextile.asmx/YarnInterChangeReport",
            data: JSON.stringify({}),
            contentType: "application/json",
            dataType: "json",
            success: function (res) {
                console.log("YarnInterChangeReport", res)
                fullData = JSON.parse(res.d);
                filteredData = [...fullData];

                bindDropdowns();
                renderTable();
            }
        });
    }
    function renderTable() {

        let start = (currentPage - 1) * pageSize;
        let pageData = filteredData.slice(start, start + pageSize);
        let html = "";

        pageData.forEach((item, i) => {

            let badge = item.MOVEBOXORNOT === "YES"
                ? '<span class="badge bg-success">YES</span>'
                : '<span class="badge bg-danger">NO</span>';

            let rowClass = item.MOVEBOXORNOT === "YES" ? "table-success" : "";

            let row = `
            <tr class="${rowClass}">
                <td>${start + i + 1}</td>
                <td>${item.BoxNo}</td>
                <td>${item.YarnMaterial}</td>
                <td>${item.YarnColor}</td>
                <td>${item.PartyName}</td>
                <td>${item.PONo}</td>
                <td>${item.GodownTitle}</td>
                <td>${item.FromLocation || '-'}</td>
                <td>${item.ToLocation || '-'}</td>
                <td>${item.NetWeight}</td>
                <td>${badge}</td>
            </tr>
        `;

            html += row; // ✅ MOST IMPORTANT LINE
        });

        $("#tblReport tbody").html(html);

        renderPagination();
    }
    function renderPagination() {

        let totalPages = Math.ceil(filteredData.length / pageSize);
        let html = "";

        for (let i = 1; i <= totalPages; i++) {
            html += `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-light'} page-btn" data-page="${i}">${i}</button>`;
        }

        $("#pagination").html(html);
    }
    $(document).on("click", ".btn-expand", function () {

        let id = $(this).data("id");
        let row = $("#expand-" + id);

        if (row.hasClass("d-none")) {

            row.removeClass("d-none");

            // 🔥 Load history via AJAX
            $.ajax({
                url: '/WebServiceNikunjTextile.asmx/GetMovementHistory',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ yarnDetailId: id }),
                success: function (res) {

                    let data = JSON.parse(res.d);

                    let html = `
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>`;

                    data.forEach(x => {
                        html += `
                    <tr>
                        <td>${x.DateAndTime}</td>
                        <td>${x.FromLocation ?? '-'}</td>
                        <td>${x.ToLocation}</td>
                        <td>${x.UserAccountId}</td>
                    </tr>`;
                    });

                    html += `</tbody></table>`;

                    row.find("div").html(html);
                }
            });

        } else {
            row.addClass("d-none");
        }
    });
    $(document).on("click", ".page-btn", function () {
        currentPage = parseInt($(this).data("page"));
        renderTable();
    });
    $(document).on("click", ".page-link", function (e) {
        e.preventDefault();
        currentPage = parseInt($(this).text());
        renderTable();
    });
    $("#searchBox").on("input", function () {

        let search = $(this).val().toLowerCase();

        filteredData = fullData.filter(x => {

            return !search ||

                (x.BoxNo && x.BoxNo.toLowerCase().includes(search)) ||
                (x.YarnMaterial && x.YarnMaterial.toLowerCase().includes(search)) ||
                (x.YarnColor && x.YarnColor.toLowerCase().includes(search)) ||
                (x.PartyName && x.PartyName.toLowerCase().includes(search)) ||
                (x.PONo && x.PONo.toString().includes(search)) ||
                (x.GodownTitle && x.GodownTitle.toLowerCase().includes(search)) ||
                (x.FromLocation && x.FromLocation.toLowerCase().includes(search)) ||
                (x.ToLocation && x.ToLocation.toLowerCase().includes(search)) ||
                (x.NetWeight && x.NetWeight.toString().includes(search)) ||
                (x.MOVEBOXORNOT && x.MOVEBOXORNOT.toLowerCase().includes(search));
        });

        currentPage = 1;
        renderTable();
    });
    function bindDropdowns() {

        bindDropdown("#filterBox", "BoxNo");
        bindDropdown("#filterMaterial", "YarnMaterial");
        bindDropdown("#filterColor", "YarnColor");
        bindDropdown("#filterParty", "PartyName");
        bindDropdown("#filterPO", "PONo");
        bindDropdown("#filterGodown", "GodownTitle");
    }
    function bindDropdown(selector, field) {

        let values = [...new Set(fullData.map(x => x[field]))];

        let dropdown = $(selector);
        dropdown.empty().append(`<option value="">All ${field}</option>`);

        values.forEach(v => {
            dropdown.append(`<option value="${v}">${v}</option>`);
        });
    }
    $(document).on("click", ".btn-expand", function () {

        let id = $(this).data("id");

        expandedRows[id] = !expandedRows[id];

        renderTable(); // re-render to toggle

        if (expandedRows[id]) {

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/GetMovementHistory",
                data: JSON.stringify({ yarnDetailId: id }),
                contentType: "application/json",
                success: function (res) {

                    let data = JSON.parse(res.d);

                    let html = `
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>`;

                    data.forEach(x => {
                        html += `
                    <tr>
                        <td>${x.DateAndTime}</td>
                        <td>${x.FromLocation || '-'}</td>
                        <td>${x.ToLocation}</td>
                        <td>${x.UserAccountId}</td>
                    </tr>`;
                    });

                    html += `</tbody></table>`;

                    $("#history-" + id).html(html);
                }
            });
        }
    });
    function groupByGodown(data) {

        let grouped = {};

        data.forEach(item => {
            if (!grouped[item.GodownTitle]) {
                grouped[item.GodownTitle] = [];
            }
            grouped[item.GodownTitle].push(item);
        });

        let html = "";

        Object.keys(grouped).forEach(godown => {

            html += `
        <tr class="table-dark">
            <td colspan="12"><b>${godown}</b></td>
        </tr>`;

            grouped[godown].forEach((item, i) => {

                let badge = item.MOVEBOXORNOT === "YES"
                    ? '<span class="badge bg-success">YES</span>'
                    : '<span class="badge bg-danger">NO</span>';

                let rowClass = item.MOVEBOXORNOT === "YES" ? "table-success" : "";

                html += `
            <tr class="${rowClass}">
                <td>${i + 1}</td>
                <td>${item.BoxNo}</td>
                <td>${item.YarnMaterial}</td>
                <td>${item.YarnColor}</td>
                <td>${item.PartyName}</td>
                <td>${item.PONo}</td>
                <td>${item.GodownTitle}</td>
                <td>${item.FromLocation ?? '-'}</td>
                <td>${item.ToLocation}</td>
                <td>${item.NetWeight}</td>
                <td>${badge}</td>
            </tr>`;
            });
        });

        $("#tblBody").html(html);
    }
    function exportToExcel() {
        let table = document.getElementById("tblReport").outerHTML;
        let url = 'data:application/vnd.ms-excel,' + encodeURIComponent(table);
        let link = document.createElement("a");
        link.href = url;
        link.download = "YarnInterChangeReport.xls";
        link.click();
    }
    function preparePDFData() {

        let html = "";
        filteredData.forEach((item, i) => {
            let move = item.MOVEBOXORNOT === "YES" ? "YES" : "NO";
            html += `
            <tr>
            <td>${i + 1}</td>
            <td>${item.BoxNo}</td>
            <td>${item.YarnMaterial}</td>
            <td>${item.YarnColor}</td>
            <td>${item.PartyName}</td>
            <td>${item.PONo}</td>
            <td>${item.GodownTitle}</td>
            <td>${item.FromLocation || '-'}</td>
            <td>${item.ToLocation || '-'}</td>
            <td>${item.NetWeight}</td>
            <td>${move}</td>
        </tr>`;
        });

        $("#tblReport tbody").html(html);
    }
    function exportToPDF() {

        let doc = new jsPDF('landscape');

        let rows = filteredData.map((x, i) => [
            i + 1,
            x.BoxNo,
            x.YarnMaterial,
            x.YarnColor,
            x.PartyName,
            x.PONo,
            x.GodownTitle,
            x.FromLocation || '-',
            x.ToLocation || '-',
            x.NetWeight,
            x.MOVEBOXORNOT
        ]);

        doc.autoTable({
            head: [['#', 'Box', 'Material', 'Color', 'Party', 'PO', 'Godown', 'From', 'To', 'Wt', 'Move']],
            body: rows,

            styles: {
                fontSize: 8,
                textColor: [0, 0, 0]
            },

            headStyles: {
                fillColor: [13, 110, 253], // 🔵 BLUE HEADER
                textColor: [255, 255, 255], // ⚪ WHITE TEXT
                fontStyle: 'bold'
            },

            alternateRowStyles: {
                fillColor: [240, 248, 255] // light blue shade (optional)
            }
        });

        doc.save("YarnReport.pdf");
    }
    function printReport() {

        preparePDFData(); // same function reuse 👍

        let content = document.getElementById("pdfContainer").innerHTML;

        let printWindow = window.open('', '', 'width=1200,height=800');

        printWindow.document.write(`
        <html>
        <head>
            <title>Yarn Report</title>
            <style>
                body { font-family: Arial; padding: 20px; }

                table {
                    width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                }

                th, td {
                    border: 1px solid #ccc;
                    padding: 5px;
                    font-size: 12px;
                    text-align: left;
                    word-wrap: break-word;
                }

                th {
                    background: #0d6efd;
                    color: white;
                }

                tr {
                    page-break-inside: avoid;
                }
            </style>
        </head>
        <body>
            <h3 style="text-align:center;">Yarn Interchange Report</h3>
            ${content}
        </body>
        </html>
    `);

        printWindow.document.close();
        printWindow.focus();

        setTimeout(() => {
            printWindow.print();
            printWindow.close();
        }, 500);
    }
</script>