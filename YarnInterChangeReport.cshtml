@{
    Layout = "/_LayoutPage1.cshtml";
}

<style>
    body {
        background: #f5f6fa;
    }

    .card {
        border-radius: 12px;
    }

    .table thead {
        background: #0d6efd;
        color: white;
    }

    .badge-yes {
        background: #198754;
    }

    .badge-no {
        background: #dc3545;
    }

    .pagination {
        justify-content: end;
    }

    #tblReport th {
        color: white;
    }

    @@media print {
        @@page {
            size: A4 landscape;
        }
    }
</style>

<div class="content-wrapper">
    <div class="container-fluid">
        <div class="card">
            <div class="card">
                <div class="card-body">
                    <div class="container-fluid mt-3">
                        <div class="row">

                            <!-- 🔹 LEFT FILTER PANEL -->
                            <div class="col-md-3">
                                <div class="card shadow">
                                    <div class="card-header">
                                        <h4>Filters</h4>
                                    </div>
                                    <div class="card-body">

                                        <div class="field-wrapper">
                                            <select id="filterBox" class="select-single detail" data-live-search="true">
                                                <option value="">All Box</option>
                                            </select>
                                            <div class="field-placeholder">Box</div>
                                        </div>
                                        <div class="field-wrapper">
                                            <select id="filterMaterial" class="select-single detail" data-live-search="true">
                                                <option value="">All Material</option>
                                            </select>
                                            <div class="field-placeholder">Material</div>
                                        </div>
                                        <div class="field-wrapper">

                                            <select id="filterColor" class="select-single detail" data-live-search="true">
                                                <option value="">All Color</option>
                                            </select>
                                            <div class="field-placeholder">Color</div>
                                        </div>
                                        <div class="field-wrapper">


                                            <select id="filterParty" class="select-single detail" data-live-search="true">
                                                <option value="">All Party</option>
                                            </select>
                                            <div class="field-placeholder">Party</div>
                                        </div>
                                        <div class="field-wrapper">
                                            <select id="filterPO" class="select-single detail" data-live-search="true">
                                                <option value="">All PO</option>
                                            </select>
                                            <div class="field-placeholder">PO Number</div>
                                        </div>
                                        <div class="field-wrapper">
                                            <select id="filterGodown" class="select-single detail" data-live-search="true">
                                                <option value="">All Godown</option>
                                            </select>
                                            <div class="field-placeholder">Godown</div>
                                        </div>                                     
                                    </div>
                                </div>
                            </div>

                            <!-- 🔹 RIGHT TABLE -->
                            <div class="col-md-9">
                                <div class="card shadow">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h4>Yarn Inter Change Report</h4>

                                        <div>
                                            <button onclick="exportToExcel()" class="btn btn-success btn-sm" id="btnExcel">
                                                <i class="bi bi-file-earmark-excel"></i> Excel
                                            </button>
                                            <button onclick="exportToPDF()" class="btn btn-danger btn-sm" id="btnPdf">
                                                <i class="bi bi-file-earmark-pdf"></i> PDF
                                            </button>
                                            <button onclick="printReport()" class="btn btn-secondary btn-sm" id="btnPrint">
                                                <i class="bi bi-printer"></i> Print
                                            </button>
                                        </div>
                                    </div>

                                    <div class="card-body">

                                        <!-- Filters -->
                                        <div class="row mb-3">
                                            <div class="col-md-3">
                                                <input type="text" id="searchBox" class="form-control" placeholder="Search...">
                                            </div>
                                        </div>

                                        <!-- Table -->
                                        <div class="table-responsive" id="pdfContainer">
                                            <table class="table table-bordered table-hover" id="tblReport">
                                                <thead>
                                                    <tr>
                                                        <th style="width:4%">#</th>
                                                        <th style="width:8%">Box</th>
                                                        <th style="width:10%">Material</th>
                                                        <th style="width:12%">Color</th>
                                                        <th style="width:15%">Party</th>
                                                        <th style="width:6%">PO</th>
                                                        <th style="width:12%">Godown</th>
                                                        <th style="width:8%">From</th>
                                                        <th style="width:8%">To</th>
                                                        <th style="width:5%">Wt</th>
                                                        <th style="width:6%">Move</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>

                                        <!-- Pagination -->
                                        <nav>
                                            <ul class="pagination" id="pagination"></ul>
                                        </nav>

                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
