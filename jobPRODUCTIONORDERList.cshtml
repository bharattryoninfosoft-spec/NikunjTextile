            var slip = $.trim($("#filterSlipNo").val()).toLowerCase();
            var design = $.trim($("#filterDesignNo").val()).toLowerCase();
            var colour = $.trim($("#filterColour").val()).toLowerCase();
            var filterDateVal = $("#filterDate").val();

            var filterDateObj = filterDateVal ? new Date(filterDateVal + "T00:00:00") : null;

            var targetData = allPendingData;
            if (currentTab === "allotted") {
                targetData = allAllottedData;
            } else if (currentTab === "completed") {
                targetData = allCompletedData;
            }

            var filtered = $.grep(targetData, function (item) {
                var formattedSO = formatSONumber(item.SalesOrderNo);
                var mParty = !party || String(item.PartyName || "").toLowerCase().indexOf(party) >= 0;
                var mJobber = !jobber || String(item.JobWorkerName || item.PartyName || "").toLowerCase().indexOf(jobber) >= 0;
                var mSO = !so || String(item.SalesOrderNo || "").toLowerCase().indexOf(so) >= 0 || formattedSO.toLowerCase().indexOf(so) >= 0;
                var mSlip = !slip || String(item.SlipNo || "").toLowerCase().indexOf(slip) >= 0;
                var mDesign = !design || String(item.DesignNo || "").toLowerCase().indexOf(design) >= 0;
                var mColour = !colour || String(item.ColourMatchingName || "").toLowerCase().indexOf(colour) >= 0;

                var mDate = true;
                if (filterDateObj) {
                    var itemDate = parseDDMMYYYY(item.ProductionDate || item.OrderDate);
                    if (itemDate) {
                        mDate = (itemDate.getFullYear() === filterDateObj.getFullYear() &&
                                 itemDate.getMonth() === filterDateObj.getMonth() &&
                                 itemDate.getDate() === filterDateObj.getDate());
                    } else {
                        mDate = false;
                    }
                }

                return mParty && mJobber && mSO && mSlip && mDesign && mColour && mDate;
