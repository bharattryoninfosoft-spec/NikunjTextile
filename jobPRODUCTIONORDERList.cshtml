        function showToast(type, title, msg) {
            if (typeof toastr !== 'undefined') {
                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "timeOut": "3500",
                    "preventDuplicates": true
                };
                if (toastr[type]) {
                    toastr[type](msg, title);
                    return;
                }
            }
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: type,
                    title: title ? (title + ': ' + msg) : msg,
                    showConfirmButton: false,
                    timer: 3500,
                    timerProgressBar: true
                });
                return;
            }
            alert((title ? title + "\n" : "") + msg);
        }

        function validatePCSValue(inputVal, panaRepeat, orderPcs, completedPcs, remainingPcs, isToast, maxRepeatInput) {
            if (isNaN(inputVal) || inputVal <= 0) {
                var msg1 = (panaRepeat > 0) ? "Please enter a valid Repeat count." : "Please enter a valid PCS value.";
                if (isToast) {
                    showToast("warning", "Invalid Input", msg1);
                }
                return { valid: false, message: msg1, title: "Invalid Input" };
            }

            if (panaRepeat > 0) {
                var maxAllowedRepeats = (maxRepeatInput > 0) ? maxRepeatInput : (remainingPcs / panaRepeat);
                if (inputVal > maxAllowedRepeats) {
                    var msgMaxR = "Repeat input (" + inputVal + ") cannot exceed REPEAT limit (" + maxAllowedRepeats + ")!";
                    if (isToast) {
                        showToast("warning", "Repeat Limit Exceeded", msgMaxR);
                    }
                    return { valid: false, message: msgMaxR, title: "Repeat Limit Exceeded" };
                }

                var pcsToSave = inputVal * panaRepeat;
                var totalMachinePCS = completedPcs + pcsToSave;
                if (orderPcs > 0 && totalMachinePCS > orderPcs) {
                    var msgMaxPcs = "Total Machine PCS (" + totalMachinePCS.toFixed(2) + ") cannot exceed Order PCS (" + orderPcs.toFixed(2) + "). Maximum remaining allowed PCS is " + remainingPcs.toFixed(2) + ".";
                    if (isToast) {
                        showToast("warning", "PCS Limit Exceeded", msgMaxPcs);
                    }
                    return { valid: false, message: msgMaxPcs, title: "PCS Limit Exceeded" };
                }

                return { valid: true, pcsToSave: pcsToSave };
            } else {
                if (remainingPcs > 0 && inputVal > remainingPcs) {
                    var msgMax = "PCS (" + inputVal + ") cannot exceed Pending PCS (" + remainingPcs.toFixed(2) + ").";
                    if (isToast) {
                        showToast("warning", "PCS Limit Exceeded", msgMax);
                    }
                    return { valid: false, message: msgMax, title: "PCS Limit Exceeded" };
                }

                var totalMachinePCS = completedPcs + inputVal;
                if (orderPcs > 0 && totalMachinePCS > orderPcs) {
                    var msg4 = "Total Machine PCS (" + totalMachinePCS.toFixed(2) + ") cannot exceed Order PCS (" + orderPcs.toFixed(2) + "). Maximum remaining allowed PCS is " + remainingPcs.toFixed(2) + ".";
                    if (isToast) {
                        showToast("warning", "PCS Limit Exceeded", msg4);
                    }
                    return { valid: false, message: msg4, title: "PCS Limit Exceeded" };
                }

                return { valid: true, pcsToSave: inputVal };
            }
        }

        function saveRowMachineDetail(detailId, orderId, remainingPcs, orderPcs, panaRepeat, completedPcs, maxRepeatInput, noOfMachines) {
            var prodDate = $.trim($("#rowDate_" + detailId).val());
            var machineNo = parseInt($("#rowMachineNo_" + detailId).val(), 10);
            var inputVal = parseFloat($("#rowPCS_" + detailId).val());
            panaRepeat = parseFloat(panaRepeat || 0);
            completedPcs = parseFloat(completedPcs || 0);
            noOfMachines = parseInt(noOfMachines || $("#rowMachineNo_" + detailId).attr("data-noofmachines") || 0, 10);

            if (!prodDate) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Validation Warning', text: 'Please select Date.' });
                } else {
                    alert("Please select Date.");
                }
                $("#rowDate_" + detailId).focus();
                return;
            }
            if (isNaN(machineNo) || machineNo <= 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Validation Warning', text: 'Please enter a valid Machine Number.' });
                } else {
                    alert("Please enter a valid Machine Number.");
                }
                $("#rowMachineNo_" + detailId).focus();
                return;
            }

            if (noOfMachines > 0 && machineNo > noOfMachines) {
                var msgMachine = "Machine No (" + machineNo + ") cannot exceed Jobber Machine count (" + noOfMachines + ")!";
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Machine Count Exceeded', text: msgMachine });
                } else {
                    alert(msgMachine);
                }
                $("#rowMachineNo_" + detailId).focus();
                return;
            }

            var check = validatePCSValue(inputVal, panaRepeat, orderPcs, completedPcs, remainingPcs, false, maxRepeatInput);
            if (!check.valid) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: check.title, text: check.message });
                } else {
                    alert(check.message);
                }
                $("#rowPCS_" + detailId).focus();
                return;
            }

            var pcsToSave = check.pcsToSave;

            var payload = {
                productionOrderID: orderId,
                productionOrderDetailID: detailId,
                productionDate: prodDate,
                machineNumber: machineNo,
                pcs: pcsToSave
            };

            $.ajax({
                type: "POST",
                url: "WebServiceNikunjTextile.asmx/SaveProductionOrderSubDetail",
                data: JSON.stringify(payload),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var res = response.d !== undefined ? response.d : response;
                    if (typeof res === "string") {
                        try { res = JSON.parse(res); } catch (e) { }
                    }

                    if (res && res.Status) {
                        loadProductionOrderSlips();
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Saved Successfully!',
                                text: res.Message || 'Machine details saved successfully.',
                                confirmButtonColor: '#1273eb',
                                confirmButtonText: 'OK'
                            });
                        } else {
                            alert(res.Message || 'Machine details saved successfully.');
                        }
                    } else {
                        var errorMsg = (res ? res.Message : '') || 'Failed to save machine details.';
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'error', title: 'Error', text: errorMsg });
                        } else {
                            alert(errorMsg);
                        }
                    }
                },
                error: function (xhr) {
                    console.error("Error saving row sub detail:", xhr);
                    var msg = "An error occurred while saving.";
                    if (xhr && xhr.responseJSON && xhr.responseJSON.Message) msg = xhr.responseJSON.Message;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Error', text: msg });
                    } else {
                        alert(msg);
                    }
                }
            });
        }

        function saveBulkMachineDetails() {
            var $checkedBoxes = $("#tblJobProductionOrderListBody .chk-select-slip:checked");
            if ($checkedBoxes.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Selection Warning', text: 'Please select at least one slip to save.' });
                } else {
                    alert('Please select at least one slip to save.');
                }
                return;
            }

            var itemsToSave = [];
            var validationFailed = false;

            $checkedBoxes.each(function () {
                if (validationFailed) return false;

                var detailId = parseInt($(this).attr("data-detailid") || $(this).val(), 10);
                var orderId = parseInt($(this).attr("data-orderid") || 0, 10);

                var $dateInput = $("#rowDate_" + detailId);
                var $machineInput = $("#rowMachineNo_" + detailId);
                var $pcsInput = $("#rowPCS_" + detailId);

                var prodDate = $.trim($dateInput.val());
                var machineNo = parseInt($machineInput.val(), 10);
                var inputVal = parseFloat($pcsInput.val());

                var orderPcs = parseFloat($pcsInput.attr("data-orderpcs") || 0);
                var panaRepeat = parseFloat($pcsInput.attr("data-panarepeat") || 0);
                var maxRepeatInput = parseFloat($pcsInput.attr("data-maxrepeat") || 0);
                var completedPcs = parseFloat($pcsInput.attr("data-completedpcs") || 0);
                var remainingPcs = parseFloat($pcsInput.attr("data-remainingpcs") || 0);
                var noOfMachines = parseInt($machineInput.attr("data-noofmachines") || 0, 10);

                var slipCode = $(this).closest("tr").find(".slip-code-badge").text() || ("ID: " + detailId);

                if (!prodDate) {
                    validationFailed = true;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'warning', title: 'Validation Warning', text: 'Please select Date for Slip ' + slipCode });
                    } else {
                        alert('Please select Date for Slip ' + slipCode);
                    }
                    $dateInput.focus();
                    return false;
                }

                if (isNaN(machineNo) || machineNo <= 0) {
                    validationFailed = true;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'warning', title: 'Validation Warning', text: 'Please enter a valid Machine Number for Slip ' + slipCode });
                    } else {
                        alert('Please enter a valid Machine Number for Slip ' + slipCode);
                    }
                    $machineInput.focus();
                    return false;
                }

                if (noOfMachines > 0 && machineNo > noOfMachines) {
                    validationFailed = true;
                    var msgMachine = "Machine No (" + machineNo + ") cannot exceed Jobber Machine count (" + noOfMachines + ") for Slip " + slipCode;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'warning', title: 'Machine Count Exceeded', text: msgMachine });
                    } else {
                        alert(msgMachine);
                    }
                    $machineInput.focus();
                    return false;
                }

                var check = validatePCSValue(inputVal, panaRepeat, orderPcs, completedPcs, remainingPcs, false, maxRepeatInput);
                if (!check.valid) {
                    validationFailed = true;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'warning', title: check.title, text: slipCode + ': ' + check.message });
                    } else {
                        alert(slipCode + ': ' + check.message);
                    }
                    $pcsInput.focus();
                    return false;
                }

                itemsToSave.push({
                    productionOrderID: orderId,
                    productionOrderDetailID: detailId,
                    productionDate: prodDate,
                    machineNumber: machineNo,
                    pcs: check.pcsToSave
                });
            });

            if (validationFailed || itemsToSave.length === 0) return;

            var doSave = function () {
                $("#btnBulkSave").prop("disabled", true).html('<i class="fa fa-spinner fa-spin me-1"></i> Saving...');
                $.ajax({
                    type: "POST",
                    url: "WebServiceNikunjTextile.asmx/SaveBulkProductionOrderSubDetails",
                    data: JSON.stringify({ items: itemsToSave }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        $("#btnBulkSave").prop("disabled", false).html('<i class="fa fa-save me-1"></i> Add for Production');
                        var res = response.d !== undefined ? response.d : response;
                        if (typeof res === "string") {
                            try { res = JSON.parse(res); } catch (e) { }
                        }

                        if (res && res.Status) {
                            loadProductionOrderSlips();
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Saved Successfully!',
                                    text: res.Message || 'Selected slips saved successfully.',
                                    confirmButtonColor: '#1273eb',
                                    confirmButtonText: 'OK'
                                });
                            } else {
                                alert(res.Message || 'Selected slips saved successfully.');
                            }
                        } else {
                            var errorMsg = (res ? res.Message : '') || 'Failed to save slips.';
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({ icon: 'error', title: 'Error', text: errorMsg });
                            } else {
                                alert(errorMsg);
                            }
                        }
                    },
                    error: function (xhr) {
                        $("#btnBulkSave").prop("disabled", false).html('<i class="fa fa-save me-1"></i> Add for Production');
                        console.error("Error saving bulk machine details:", xhr);
                        var msg = "An error occurred while saving.";
                        if (xhr && xhr.responseJSON && xhr.responseJSON.Message) msg = xhr.responseJSON.Message;
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'error', title: 'Error', text: msg });
                        } else {
                            alert(msg);
                        }
                    }
                });
            };

            doSave();
        }

        function deleteSubDetailRow(subDetailId) {
            if (!subDetailId) return;

            var doDelete = function () {
                $.ajax({
                    type: "POST",
                    url: "WebServiceNikunjTextile.asmx/DeleteProductionOrderSubDetail",
                    data: JSON.stringify({ productionOrderSubDetailID: subDetailId }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        var res = response.d !== undefined ? response.d : response;
                        if (typeof res === "string") {
                            try { res = JSON.parse(res); } catch (e) { }
                        }
                        if (res && res.Status) {
                            if (typeof toastr !== 'undefined') toastr.success(res.Message || "Sub-detail record deleted successfully.");
                            loadProductionOrderSlips();
                        } else {
                            var errorMsg = (res ? res.Message : '') || 'Failed to delete record.';
                            if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: errorMsg });
                            else alert(errorMsg);
                        }
                    },
                    error: function (xhr) {
                        console.error("Error deleting sub detail:", xhr);
                        if (typeof Swal !== 'undefined') Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred while deleting.' });
                        else alert("An error occurred while deleting.");
                    }
                });
            };

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Delete Entry?',
                    text: "Are you sure you want to delete this completed machine allocation record?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa fa-trash me-1"></i> Delete',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        doDelete();
                    }
                });
            } else if (confirm("Are you sure you want to delete this completed machine allocation record?")) {
                doDelete();
            }
        }

        function ExportProductionSlipPDF(ids) {
            if (!ids || ids.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Warning', text: 'Please select at least one production slip.' });
                } else {
                    alert('Please select at least one production slip.');
                }
                return;
            }

            $("#btnText").hide();
            $("#btnLoader").show();
            $("#btnGeneratePDF").prop("disabled", true);

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/JobProductionOrderSlipReport",
                data: JSON.stringify({ productionOrderDetailID: ids }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var result = response.d !== undefined ? response.d : response;
                    if (typeof result === 'string') {
                        try { result = JSON.parse(result); } catch (e) { }
                    }

                    $("#btnText").show();
                    $("#btnLoader").hide();
                    $("#btnGeneratePDF").prop("disabled", false);

                    if (result && result.Status && result.FilePath) {
                        window.open(result.FilePath, "_blank");
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({ icon: 'warning', title: 'Notice', text: (result ? result.Message : '') || 'PDF not generated' });
                        } else {
                            alert((result ? result.Message : '') || 'PDF not generated');
                        }
                    }
                },
                error: function (xhr) {
                    console.error("JobProductionOrderSlipReport AJAX Error:", xhr);
                    $("#btnText").show();
                    $("#btnLoader").hide();
                    $("#btnGeneratePDF").prop("disabled", false);

                    var msg = "An error occurred while generating the PDF.";
                    if (xhr && xhr.responseJSON && xhr.responseJSON.Message) {
                        msg = xhr.responseJSON.Message;
                    } else if (xhr && xhr.responseText) {
                        try {
                            var parsed = JSON.parse(xhr.responseText);
                            msg = (parsed && parsed.Message) ? parsed.Message : xhr.responseText;
                        } catch (e) {
                            msg = xhr.responseText;
                        }
                    }

                    if (typeof Swal !== 'undefined') {
                        Swal.fire({ icon: 'error', title: 'Error!', text: msg });
                    } else {
                        alert(msg);
                    }
                }
            });
        }

        function renderPagination(totalPages) {
            $("#btnFirstPage").prop("disabled", currentPage <= 1);
            $("#btnPrevPage").prop("disabled", currentPage <= 1);
            $("#btnNextPage").prop("disabled", currentPage >= totalPages || totalPages === 0);
            $("#btnLastPage").prop("disabled", currentPage >= totalPages || totalPages === 0);

            var $container = $("#paginationNumbers");
            $container.empty();

            if (totalPages <= 1) return;

            var maxButtons = 5;
            var startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
            var endPage = startPage + maxButtons - 1;

            if (endPage > totalPages) {
                endPage = totalPages;
                startPage = Math.max(1, endPage - maxButtons + 1);
            }

            for (var p = startPage; p <= endPage; p++) {
                var activeClass = (p === currentPage) ? " active" : "";
                $container.append('<button type="button" class="pagination-btn' + activeClass + '" data-page="' + p + '">' + p + '</button>');
            }
        }

        function openPrintModal(index) {
            var item = filteredSlipData[index];
            if (!item) return;

            var displaySO = formatSONumber(item.SalesOrderNo);

            var html = '<div class="slip-card">' +
                '<h4>PRODUCTION SLIP</h4>' +
                '<table class="slip-table">' +
                '<tr><td class="label">PARTY:</td><td><strong>' + escapeHtml(item.PartyName || '--') + '</strong></td></tr>' +
                '<tr><td class="label">SO <br/> NUMBER:</td><td><strong class="text-primary">' + escapeHtml(displaySO) + '</strong></td></tr>' +
                '<tr><td class="label">SLIP <br/> NO:</td><td><span class="slip-code-badge">' + escapeHtml(item.SlipNo || '--') + '</span></td></tr>' +
                '<tr><td class="label">DESIGN <br/> NO:</td><td>' + escapeHtml(item.DesignNo || '--') + '</td></tr>' +
                '<tr><td class="label">COLOUR <br/> MATCHING:</td><td>' + escapeHtml(item.ColourMatchingName || '--') + '</td></tr>' +
                '<tr><td class="label">PCS:</td><td><strong>' + (item.PCS || 0) + '</strong></td></tr>' +
                '<tr><td class="label">JOB RATE:</td><td><i class="fa fa-inr me-1"></i>' + parseFloat(item.JobRate || 0).toFixed(2) + '</td></tr>' +
                '<tr><td class="label">REPEAT (PANA):</td><td>' + (item.Repeat || '--') + '</td></tr>' +
                (item.Barcode ? '<tr><td class="label">BARCODE:</td><td><code>' + escapeHtml(item.Barcode) + '</code></td></tr>' : '') +
                '</table>' +
                '</div>';

            $("#modalSlipContent").html(html);
            $("#printSlipArea").html(html);
            showModal('printSlipModal');
        }

        function printModalSlip() {
            window.print();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function showModal(modalId) {
            var $modal = $('#' + modalId);
            if (typeof $modal.modal === 'function') {
                $modal.modal('show');
            } else if (window.bootstrap && bootstrap.Modal) {
                var modalEl = document.getElementById(modalId);
                if (modalEl) {
                    var bsModal = (typeof bootstrap.Modal.getOrCreateInstance === 'function')
                        ? bootstrap.Modal.getOrCreateInstance(modalEl)
                        : new bootstrap.Modal(modalEl);
                    bsModal.show();
                }
            }
        }

    </script>
}
