        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getFinancialYearMaster?startFrom=' + rowStart,
            data: "{ 'startFrom':'" + rowStart + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listFinancialYearMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
