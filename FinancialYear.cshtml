    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add Financial Year");
        $("#add-alert").hide();

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }
    function checkSave() {


        var FinancialYear = $('#FinancialYear').val();
        var AssessmentYear = $('#AssessmentYear').val();

        var StartYears = $('#year').val();
        var EndYears = parseInt($('#year').val()) + parseInt(1);

        var startDate = StartYears + "-04-01";
        var endDate = EndYears + "-03-31";

        var IsDefault = "0";
        if ($("#isDefault").is(':checked')) {
            //$("#isDefault").attr('value', 'true');
            IsDefault = "1";
        }



        if (validate(document.getElementById('FinancialYear')) == false) {
            validate(document.getElementById('FinancialYear'));
        }
        else {

            var formData = new FormData();
            formData.append('FinancialYear', FinancialYear);
            formData.append('AssessmentYear', AssessmentYear);
            formData.append('StartDate', startDate);
            formData.append('EndDate', endDate);
            formData.append('IsDefault', IsDefault);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertFinancialYearMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 201) {
                        clearAll();

                        //$("#add-alert").addClass("alert-success");
                        //$("#add-alert").removeClass("alert-danger");
                        //$("#add-alert").html(response.Message);
                        //$("#add-alert").show();

                        notes.show(response.Message, {
                            type: 'success',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });
                        $("#cancelbtn").click();
                        displayData(0);

                    }
                    else {
                        //$("#add-alert").removeClass("alert-success");
                        //$("#add-alert").addClass("alert-danger");
                        //$("#add-alert").html(response.Message);
                        //$("#add-alert").show();

                        notess.show(response.Message, {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                    }
                },
                error: function (error) {
                    //$("#add-alert").removeClass("alert-success");
                    //$("#add-alert").addClass("alert-danger");
                    //$("#add-alert").html(response.Message);
                    //$("#add-alert").show();

                    notess.show(response.Message, {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });


                }
            });
        }
    }
    function validate(code) {
        code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";
        $(".invalid-feedback .valid-feedback").hide();
        if (code.value == "") {
            if (code.id == "name") {
                $(".company-invalid-feedback").show();
            }
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else if ((code.id == "igst" || code.id == "gst" || code.id == "cess") && code.value[code.value.length - 1] == ".") {
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else {
            document.getElementById(code.id).classList.add("is-valid");
            document.getElementById(code.id).classList.remove("is-invalid");
            $(errorMessageValid).show();
            $(errorMessageInvalid).hide();
            $(".company-invalid-feedback").show();
            return true;
        }
    }
    function exportTableToExcel(tableID, filename = '') {

        var downloadLink;
        var dataType = 'application/vnd.ms-excel';

        var tableSelect = document.getElementById(tableID);

        var tableHTML = tableSelect.outerHTML.replace(/ /g, '%20');

        filename = filename ? filename + '.xls' : 'excel_data.xls';

        downloadLink = document.createElement("a");

        document.body.appendChild(downloadLink);

        if (navigator.msSaveOrOpenBlob) {

            var blob = new Blob(['\ufeff', tableHTML], {
                type: dataType
            });

            navigator.msSaveOrOpenBlob(blob, filename);
        }
        else {

            downloadLink.href = 'data:' + dataType + ', ' + tableHTML;

            downloadLink.download = filename;

            downloadLink.click();
        }
    }
    function generatePDF() {

        const { jsPDF } = window.jspdf;

        const doc = new jsPDF('l', 'pt', 'a4');

        doc.setFontSize(14);

        doc.text("User Account Report", 40, 40);

        doc.autoTable({

            html: '#copy-print-csv',

            startY: 60,

            theme: 'grid',

            styles: {
                fontSize: 8
            },

            headStyles: {
                fillColor: [41, 128, 185]
            }
        });

        doc.save('UserAccountReport.pdf');
    }
    function printTable() {

        var table = document.getElementById("copy-print-csv").outerHTML;

        var style = `
       <style>

           body{
               font-family: Arial;
               padding:20px;
           }

           h3{
               text-align:center;
               margin-bottom:20px;
           }

           table{
               width:100%;
               border-collapse: collapse;
           }

           table, th, td{
               border:1px solid #000;
           }

           th, td{
               padding:8px;
               text-align:left;
               font-size:12px;
           }

           .actions{
               display:none;
           }

           img{
               width:40px !important;
               height:40px !important;
               border-radius:50%;
           }

       </style>
   `;

        var win = window.open('', '', 'height=900,width=1200');

        win.document.write(`
       <html>
           <head>
               <title>User Account Report</title>
               ${style}
           </head>

           <body>

               <h3>User Account Report</h3>

               ${table}

           </body>
       </html>
   `);

        win.document.close();

        win.focus();

        setTimeout(function () {

            win.print();

            win.close();

        }, 500);
    }
    function searchTable() {

        var input, filter, table, tr, td, i, j, txtValue, found;

        input = document.getElementById("searchBox");

        filter = input.value.toUpperCase();

        table = document.getElementById("copy-print-csv");

        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) {

            td = tr[i].getElementsByTagName("td");

            found = false;

            for (j = 0; j < td.length; j++) {

                if (td[j]) {

                    txtValue = td[j].textContent || td[j].innerText;

                    if (txtValue.toUpperCase().indexOf(filter) > -1) {

                        found = true;

                        break;
                    }
                }
            }

            tr[i].style.display = found ? "" : "none";
        }
    }
</script>