            var formData = new FormData();
            formData.append('FinancialYearIDs', abc);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/ActiveFinancialYearMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.Code == 1) {

                        notes.show("Year status updated successflly.", {
                            type: 'success',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                        displayData(0);
                    }

                    else {
                        notes.show("Problem has been occurred while upadating your year.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                    }
                },
                error: function (error) {
                    // alert("Problem has been occurred while upadating your data.");
                    notes.show("Problem has been occurred while upadating your year.", {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });

                }
            });


        } else {
            // Do nothing!
            console.log('Problem has been occurred while upadating your data.');
        }
        //alert(abc);
    }

    //Delete Finacial Year
