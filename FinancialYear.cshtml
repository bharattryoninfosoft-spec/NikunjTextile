                    temp += "<td>" + response.listFinancialYearMaster[i].AssessmentYear + "</td>";
                    temp += "<td>" + response.listFinancialYearMaster[i].StartDates + "</td>";
                    temp += "<td>" + response.listFinancialYearMaster[i].EndDates + "</td>";
                    temp += "<td><span class='" + response.listFinancialYearMaster[i].IsDefaultCss + "' >" + response.listFinancialYearMaster[i].IsDefaults + "</span></td>";
                    temp += "<td>";
                    //temp += "<div class='actions'>";
                    //temp += "<div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listFinancialYearMaster[i].FinancialYearID + ")'><i class='icon-verified_user text-primary'></i></a> &nbsp;&nbsp;";
