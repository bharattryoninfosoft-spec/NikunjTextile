    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add Financial Year");
        $("#add-alert").hide();

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }

    function checkSave() {


        var FinancialYear = $('#FinancialYear').val();
        var AssessmentYear = $('#AssessmentYear').val();

        var StartYears = $('#year').val();
        var EndYears = parseInt($('#year').val()) + parseInt(1);

        var startDate = StartYears + "-04-01";
        var endDate = EndYears + "-03-31";

        var IsDefault = "0";
        if ($("#isDefault").is(':checked')) {
            //$("#isDefault").attr('value', 'true');
            IsDefault = "1";
        }



        if (validate(document.getElementById('FinancialYear')) == false) {
            validate(document.getElementById('FinancialYear'));
        }
        else {

            var formData = new FormData();
            formData.append('FinancialYear', FinancialYear);
            formData.append('AssessmentYear', AssessmentYear);
            formData.append('StartDate', startDate);
            formData.append('EndDate', endDate);
            formData.append('IsDefault', IsDefault);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertFinancialYearMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 201) {
                        clearAll();

                        //$("#add-alert").addClass("alert-success");
                        //$("#add-alert").removeClass("alert-danger");
                        //$("#add-alert").html(response.Message);
                        //$("#add-alert").show();

                        notes.show(response.Message, {
                            type: 'success',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });
                        $("#cancelbtn").click();
                        displayData(0);

                    }
                    else {
                        //$("#add-alert").removeClass("alert-success");
                        //$("#add-alert").addClass("alert-danger");
                        //$("#add-alert").html(response.Message);
                        //$("#add-alert").show();

                        notess.show(response.Message, {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                    }
                },
                error: function (error) {
                    //$("#add-alert").removeClass("alert-success");
                    //$("#add-alert").addClass("alert-danger");
                    //$("#add-alert").html(response.Message);
                    //$("#add-alert").show();

                    notess.show(response.Message, {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });


                }
            });
        }
    }

    function validate(code) {
        code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";
        $(".invalid-feedback .valid-feedback").hide();
        if (code.value == "") {
            if (code.id == "name") {
                $(".company-invalid-feedback").show();
            }
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else if ((code.id == "igst" || code.id == "gst" || code.id == "cess") && code.value[code.value.length - 1] == ".") {
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else {
            document.getElementById(code.id).classList.add("is-valid");
            document.getElementById(code.id).classList.remove("is-invalid");
            $(errorMessageValid).show();
            $(errorMessageInvalid).hide();
            $(".company-invalid-feedback").show();
            return true;
        }
    }

</script>

