@section Scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script>
        $('body').addClass('fullscreen');
        var currentPagePermission = { Add: true, Edit: true, Delete: true }; // Default fallback

        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                try {
                    currentPagePermission = JSON.parse(permission);
                } catch (e) {
                    console.error("Error parsing PagePermission cookie", e);
                }
            }

            // Hide Add Button if permission is false
            if (currentPagePermission.Add === false || currentPagePermission.Add === "false") {
                $("#AddFinacialYearModel").hide();
            }

            FunctionIsLogin();
            displayData(0);
            getCurrentYear();

            // Shortcut Key
            $(document).keydown(function (key) {
                switch (parseInt(key.which, 10)) {
                    case 27:
                        $("#cancelbtn").click();
                        break;
                    case 18 && 79:
                        $("#AddFinacialYearModel").click();
                        break;
                    default:
                        break;
                }
            });
        });

        // Helper function to read cookies
        function getCookie(name) {
            var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            if (match) return decodeURIComponent(match[2]);
            return null;
        }

        function showToast(type, msg) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: msg,
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true
            });
        }

        function getCurrentYear() {
            var d = new Date();
            var currentYear = d.getFullYear();
            $("#year").val(currentYear);
            changeYearRange(currentYear);
        }

        function changeYearRange(year) {
            var yearRange = "" + year + "-" + (parseInt(year) + 1);
            var AsstyearRange = "" + (parseInt(year) + 1) + "-" + (parseInt(year) + 2);

            document.getElementById("FinancialYear").value = yearRange;
            document.getElementById("AssessmentYear").value = AsstyearRange;

            checkYearRange(yearRange);
        }

        function checkYearRange(yearRange) {
            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/checkValidYearRange",
                data: "{'yearRange':'" + yearRange + "'}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: OnSuccessRangeValidity,
                error: OnErrorRangeValidity
            });
        }

        function OnSuccessRangeValidity(data, status) {
            if (data.d == "true") {
                showToast('error', "This year is already exists");
            }
        }

        function OnErrorRangeValidity(request, status, error) {
            showToast('error', request.statusText);
            return false;
        }

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    showToast('error', request.statusText || 'Failed to fetch default company.');
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            }
            else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getFinancialYearMaster?startFrom=' + rowStart,
                data: "{ 'startFrom':'" + rowStart + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").empty();
                    }

                    var tableBody = $("#copy-print-csv tbody");
                    var temp = "";

                    if (response.listFinancialYearMaster.length < 10) {
                        $("#view-more-btn").hide();
                    }
                    else {
                        $("#view-more-btn").show();
                    }

                    for (var i = 0; i < response.listFinancialYearMaster.length; i++) {
                        temp += "<tr>";
                        temp += "<td>" + response.listFinancialYearMaster[i].FinancialYear + "</td>";
                        temp += "<td>" + response.listFinancialYearMaster[i].AssessmentYear + "</td>";
                        temp += "<td>" + response.listFinancialYearMaster[i].StartDates + "</td>";
                        temp += "<td>" + response.listFinancialYearMaster[i].EndDates + "</td>";
                        temp += "<td>" +
                            "<span class='" + response.listFinancialYearMaster[i].IsDefaultCss + "'>" +
                            response.listFinancialYearMaster[i].IsDefaults +
                            "</span>" +
                            "</td>";

                        // ==========================================
                        // ACTIONS COLUMN WITH PERMISSION CONTROLS
                        // ==========================================
                        temp += "<td class='no-export'><div class='actions'>";

                        var canEdit = currentPagePermission.Edit === true || currentPagePermission.Edit === "true";
                        var canDelete = currentPagePermission.Delete === true || currentPagePermission.Delete === "true";

                        if (!canEdit && !canDelete) {
                            temp += "-";
                        } else {
                            if (canEdit) {
                                temp += "<a href='javascript:void(0);' title='Update' onclick='functionFYActive(" + response.listFinancialYearMaster[i].FinancialYearID + ")'>" +
                                    "<i class='icon-verified_user text-primary'></i>" +
                                    "</a>&nbsp;&nbsp;";
                            }

                            if (canDelete) {
                                temp += "<a href='javascript:void(0);' title='Delete' onclick='functionFYDelete(" + response.listFinancialYearMaster[i].FinancialYearID + ")'>" +
                                    "<i class='icon-x-circle text-danger'></i>" +
                                    "</a>";
                            }
                        }

                        temp += "</div></td>";
                        temp += "</tr>";
                    }

                    tableBody.append(temp);
                },
                error: function (request, status, error) {
                }
            });
        }

        function functionFYActive(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to update default status?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, update it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/ActiveFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Updated!',
                                    text: 'Year status updated successfully.',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                displayData(0);
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: 'Problem has been occurred while updating your year.'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Problem has been occurred while updating your year.'
                            });
                        }
                    });
                }
            });
        }

        function functionFYDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                displayData(0);
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Financial Year deleted successfully.',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: 'Problem has been occurred while deleting Financial Year.'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Problem has been occurred while deleting Financial Year.'
                            });
                        }
                    });
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Financial Year");
            $("#add-alert").hide();

            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function checkSave() {
            var FinancialYear = $('#FinancialYear').val();
            var AssessmentYear = $('#AssessmentYear').val();
            var StartYears = $('#year').val();
            var EndYears = parseInt($('#year').val()) + parseInt(1);

            var startDate = StartYears + "-04-01";
            var endDate = EndYears + "-03-31";

            var IsDefault = "0";
            if ($("#isDefault").is(':checked')) {
                IsDefault = "1";
            }

            if (validate(document.getElementById('FinancialYear')) == false) {
                validate(document.getElementById('FinancialYear'));
            }
            else {
                var formData = new FormData();
                formData.append('FinancialYear', FinancialYear);
                formData.append('AssessmentYear', AssessmentYear);
                formData.append('StartDate', startDate);
                formData.append('EndDate', endDate);
                formData.append('IsDefault', IsDefault);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertFinancialYearMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            showToast('success', response.Message);
                            $("#cancelbtn").click();
                            displayData(0);
                        }
                        else {
                            showToast('error', response.Message);
                        }
                    },
                    error: function (error) {
                        showToast('error', 'An error occurred while submitting your data.');
                    }
                });
            }
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "") {
                if (code.id == "name") {
                    $(".company-invalid-feedback").show();
                }
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }

        // --- EXCEL EXPORT (Excludes .no-export column) ---
        function exportTableToExcel(tableID, filename = '') {
            var tableSelect = document.getElementById(tableID);
            var cloneTable = tableSelect.cloneNode(true);

            $(cloneTable).find('.no-export').remove();

            var tableHTML = cloneTable.outerHTML.replace(/ /g, '%20');
            filename = filename ? filename + '.xls' : 'excel_data.xls';

            var downloadLink = document.createElement("a");
            document.body.appendChild(downloadLink);

            if (navigator.msSaveOrOpenBlob) {
                var blob = new Blob(['\ufeff', tableHTML], { type: 'application/vnd.ms-excel' });
                navigator.msSaveOrOpenBlob(blob, filename);
            } else {
                downloadLink.href = 'data:application/vnd.ms-excel, ' + tableHTML;
                downloadLink.download = filename;
                downloadLink.click();
            }
        }

        // --- PDF EXPORT (Excludes .no-export column using jsPDF-AutoTable correctly) ---
        function generatePDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'pt', 'a4');
            doc.setFontSize(14);
            doc.text("Financial Year Report", 40, 40);

            doc.autoTable({
                html: '#copy-print-csv',
                startY: 60,
                theme: 'grid',
                excludeColumns: [5],
                styles: { fontSize: 8 },
                headStyles: { fillColor: [41, 128, 185] }
            });

            doc.save('FinancialYearReport.pdf');
        }

        // --- PRINT FUNCTION (Excludes .no-export column) ---
        function printTable() {
            var printContents = document.getElementById("copy-print-csv").cloneNode(true);

            $(printContents).find('.no-export').remove();

            var originalContents = document.body.innerHTML;
            document.body.innerHTML = "<h3>Financial Year Report</h3>" + printContents.outerHTML;
            window.print();
            document.body.innerHTML = originalContents;
            location.reload();
        }

        // --- SEARCH FUNCTION ---
        function searchTable() {
            var input = document.getElementById("searchBox");
            var filter = input.value.toUpperCase();
            var table = document.getElementById("copy-print-csv");
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var tdArray = tr[i].getElementsByTagName("td");
                var match = false;
                for (var j = 0; j < tdArray.length - 1; j++) {
                    if (tdArray[j]) {
                        if (tdArray[j].textContent.toUpperCase().indexOf(filter) > -1) {
                            match = true;
                            break;
                        }
                    }
                }
                tr[i].style.display = match ? "" : "none";
            }
        }
    </script>
}
