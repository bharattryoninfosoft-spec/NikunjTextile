<script>

    var currentPagePermission = {};
    $(document).ready(function () {
        var permission = sessionStorage.getItem("PagePermission");
        if (permission != null) {
            currentPagePermission = JSON.parse(permission);
            console.log("currentPagePermission", currentPagePermission);
            if (currentPagePermission.Add == false) {
                $("#AddFinacialYearModel").hide();
            }
        }

        FunctionIsLogin();


        displayData(0);
        //getDefaultCompany();
        getCurrentYear();



        // Shortcut Key
        $(document).keydown(function (key) {
            switch (parseInt(key.which, 10)) {
                case 27:
                    //Esc Key
                    $("#cancelbtn").click();
                    break;
                case 18 && 79:
                    // Alt + O
                    $("#AddFinacialYearModel").click();
                    //addnewcontact
                    break;
                default:
                    //alert(key.which);
                    break;
            }
        });


    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getCurrentYear() {
        var d = new Date();
        var currentYear = d.getFullYear();
        $("#year").val(currentYear);
        changeYearRange(currentYear);
    }
    function changeYearRange(year) {
        var yearRange = "" + year + "-" + (parseInt(year) + 1);

        var AsstyearRange = "" + (parseInt(year) + 1) + "-" + (parseInt(year) + 2);
        //alert(yearRange);
        //$("#FinancialYear").val(yearRange);

        document.getElementById("FinancialYear").value = yearRange;
        document.getElementById("AssessmentYear").value = AsstyearRange;

        checkYearRange(yearRange);
    }
    function checkYearRange(yearRange) {
        console.log("check");
        $.ajax({
            type: "POST",
            url: "/WebServiceNikunjTextile.asmx/checkValidYearRange",
            data: "{'yearRange':'" + yearRange + "'}",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: OnSuccessRangeValidity,
            error: OnErrorRangeValidity
        });
    }
    function OnSuccessRangeValidity(data, status) {
        console.log(data);
        if (data.d == "true") {

            //$("#add-alert").removeClass("alert-success");
            //$("#add-alert").addClass("alert-danger");
            //$("#add-alert").html("This year is already exists");
            //$("#add-alert").show();

            notess.show("This year is already exists", {
                type: 'danger',
                //title: 'Opps.!',
                //icon: '<i class="icon-alert-triangle"></i>'
            });

        }
        else {

            //$("#add-alert").removeClass("alert-success");
            //$("#add-alert").removeClass("alert-danger");
            ///*$("#add-alert").html("Record for this year already exists");*/
            //$("#add-alert").hide();



        }
    }
    function OnErrorRangeValidity(request, status, error) {

        //$("#add-alert").removeClass("alert-success");
        //$("#add-alert").addClass("alert-danger");
        //$("#add-alert").html(request.statusText);
        //$("#add-alert").show();

        notess.show(request.statusText, {
            type: 'danger',
            //title: 'Opps.!',
            //icon: '<i class="icon-alert-triangle"></i>'
        });
        return false;
    }
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getFinancialYearMaster?startFrom=' + rowStart,
            data: "{ 'startFrom':'" + rowStart + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {

                // CLEAR TABLE
                if (rowStart == 0) {

                    $("#copy-print-csv tbody").empty();
                }

                // HTML TABLE BODY
                var tableBody = $("#copy-print-csv tbody");

                var temp = "";

                // VIEW MORE
                if (response.listFinancialYearMaster.length < 10) {

                    $("#view-more-btn").hide();
                }
                else {

                    $("#view-more-btn").show();
                }

                // LOOP
                for (var i = 0; i < response.listFinancialYearMaster.length; i++) {

                    temp += "<tr>";

                    temp += "<td>" + response.listFinancialYearMaster[i].FinancialYear + "</td>";

                    temp += "<td>" + response.listFinancialYearMaster[i].AssessmentYear + "</td>";

                    temp += "<td>" + response.listFinancialYearMaster[i].StartDates + "</td>";

                    temp += "<td>" + response.listFinancialYearMaster[i].EndDates + "</td>";

                    temp += "<td>" +
                        "<span class='" + response.listFinancialYearMaster[i].IsDefaultCss + "'>" +
                        response.listFinancialYearMaster[i].IsDefaults +
                        "</span>" +
                        "</td>";

                    // ACTIONS
                    temp += "<td><div class='actions'>";

                    // DEFAULT UPDATE
                    if (currentPagePermission.Edit == true ||
                        currentPagePermission.Edit == "true") {
                        temp += "<a href='javascript:void(0);' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Update' " +
                            "onclick='functionFYActive(" + response.listFinancialYearMaster[i].FinancialYearID + ")'>" +
                            "<i class='icon-verified_user text-primary'></i>" +
                            "</a>&nbsp;&nbsp;";
                    }
                    temp += "<a href='javascript:void(0);' " +
                        "data-toggle='tooltip' " +
                        "data-placement='top' " +
                        "title='Is Default Update' " +
                        "onclick='functionFYActive(" + response.listFinancialYearMaster[i].FinancialYearID + ")'>" +
                        "<i class='icon-verified_user text-primary'></i>" +
                        "</a>&nbsp;&nbsp;";
                    // DELETE
                    if (currentPagePermission.Delete == true ||
                        currentPagePermission.Delete == "true") {

                        temp += "<a href='javascript:void(0);' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Delete' " +
                            "onclick='functionFYDelete(" + response.listFinancialYearMaster[i].FinancialYearID + ")'>" +
                            "<i class='icon-x-circle text-danger'></i>" +
                            "</a>";
                    }

                    temp += "</div></td>";

                    temp += "</tr>";
                }

                // APPEND HTML
                tableBody.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }
    function functionFYActive(abc) {
        if (confirm('Are you sure you want to update default status ?')) {
            // Save it!
            //alert(abc)
            var formData = new FormData();
            formData.append('FinancialYearIDs', abc);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/ActiveFinancialYearMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.Code == 1) {

                        notes.show("Year status updated successflly.", {
                            type: 'success',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                        displayData(0);
                    }

                    else {
                        notes.show("Problem has been occurred while upadating your year.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                    }
                },
                error: function (error) {
                    // alert("Problem has been occurred while upadating your data.");
                    notes.show("Problem has been occurred while upadating your year.", {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });

                }
            });


        } else {
            // Do nothing!
            console.log('Problem has been occurred while upadating your data.');
        }
        //alert(abc);
    }
    //Delete Finacial Year
