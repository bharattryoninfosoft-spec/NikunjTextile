                rowsHtml += '<tr>' +
                    '<td style="text-align: center;">' + globalIdx + '</td>' +
                    '<td style="text-align: center; font-weight: bold; padding-left:22px;">' + escapeHtml(item.GeneratedSlipNo || '--') + '</td>' +
