            });

            var printHtml = '<div style="font-family: Arial, sans-serif; padding: 10px;">' +
                '<h3 style="text-align: center; margin-bottom: 5px; color: #1273eb;">Sale Order Jobber Assignment Report</h3>' +
                '<p style="text-align: center; font-size: 11px; color: #555; margin-bottom: 15px;">Generated on: ' + new Date().toLocaleString() + ' | Total Records: ' + (filteredReportData ? filteredReportData.length : 0) + '</p>' +
