    <script>

        $(document).ready(function () {
            logout();
        });

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            var idStr = "#" + code.id;
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "" || code.value == "0") {
                $(idStr).addClass("is-invalid");
                $(idStr).removeClass("is-valid");
                $(errorMessageInvalid).show();
                $(".unavailable-feedback").hide();
                return false;
            }
            else if (code.id == "email") {
                $("#return-message").val("");
                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/checkLoginUsername',
                    data: "{ 'username':'" + code.value + "' }",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data, status) {
                        var jsonData = data.d;
                        console.log("yuhu", jsonData);
                        if (jsonData != "false") {
                            $(".email-valid-feedback").show();
                            $(".email-invalid-feedback").hide();
                            $(".unavailable-feedback").hide();
                            $(idStr).addClass("is-valid");
                            $(idStr).removeClass("is-invalid");
                            $("#return-message").val("true");
                        }
                        else {
                            $(".email-valid-feedback").hide();
                            $(".email-invalid-feedback").hide();
                            $(".unavailable-feedback").show();
                            $(idStr).addClass("is-invalid");
                            $(idStr).removeClass("is-valid");
                            $("#return-message").val("false");
                        }
                        console.log("return msg", $("#return-message").val());
                    },
                    error: function (request, status, error) {
                        $(".email-valid-feedback").hide();
                        $(".email-invalid-feedback").hide();
                        $(".unavailable-feedback").show();
                    }
                });

            }
            else {
                $(idStr).addClass("is-valid");
                $(idStr).removeClass("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                return true;
            }
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    var jsonData = data.d;
                },
                error: function (request, status, error) {
                }
            });
        }

        function checkLogin() {
            var email = document.getElementById("email");
            var password = document.getElementById("password");
            console.log("Validate email", $("#return-message").val());
            console.log("password", validate(password));
            console.log("email empty", email.value != "");
            if (email.value != "" && validate(password) == true && $("#return-message").val() == "true") {
                $("#error-alert").hide();
                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getLoginDetails',
                    data: "{ 'username':'" + email.value + "','password':'" + password.value + "' }",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data, status) {
                        console.log(data);
                        var jsonData = data.d;
                        if (jsonData == "done") {
                            window.location.replace("/Dashboard");
                        }
                        else if (jsonData == "deactivate") {
                            $("#error-alert").show();
                            $("#error-alert").html("User Deactivated. You cannot login into the system.");
                        }
                        else {
                            $("#error-alert").show();
                            $("#error-alert").html("Incorrect Username Or Password");
                        }
                    },
                    error: function (request, status, error) {
                        console.log(error);
                    }
                });
            }
            else {
                validate(email);
                validate(password);
                $("#error-alert").show();
                $("#error-alert").html("Please Provide All Details Properly");
            }
        }
    </script>

