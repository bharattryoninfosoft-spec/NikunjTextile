                        SpanSundryParty = "<span class='badge bg-success' style='margin-top: 5px;'><i class='fa fa-arrow-down'></i> Sundry Creditors</span>";
                    }
                    else
                        if (response.listPartyMaster[i].SundryParty == "2") {
                            SpanSundryParty = "<span class='badge bg-danger' style='margin-top: 5px;'><i class='fa fa-arrow-up'></i> Sundry Debtors</span>";
                        }
                    
                    else
                        if (response.listPartyMaster[i].SundryParty == "3") {
