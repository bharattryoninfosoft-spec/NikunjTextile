                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr style="background-color: #1273eb;">
                                    <th style="color:white;">Sr No</th>
                                    <th style="color:white;">Date</th>
                                    <th style="color:white;">Party Name</th>
                                    <th style="color:white;">Mobile No</th>
                                    <th style="color:white;">GST IN</th>
                                    <th style="width: 20%; color: white;">City <br />State <br /> Pincode</th>
                                    <th style="color:white;">Is Active</th>
                                    <th style="width: 5%; color: white;">Actions</th>
                                </tr>
