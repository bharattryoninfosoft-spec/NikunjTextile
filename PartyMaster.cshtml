                        $('#PanNo, #PanNotemp').val(item.PanNo);
                        $('#pincode').val(item.Pincode);
                        $('#city').val(item.City);
                        $('#BankHolderName').val(item.BankHolderName);
                        $('#BankAccountNo').val(item.BankAccountNo);
                        $('#BankIFSCCode').val(item.BankIFSCCode);
                        $('#BankName').val(item.BankName);
                        $('#BankBranch').val(item.BankBranch);
                        $('#SundryParty').val(item.SundryParty);
