    function validate(code) {
        //alert(code.id);
        code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";
        $(".invalid-feedback .valid-feedback").hide();
        if (code.value == "") {
            if (code.id == "name") {
                $(".company-invalid-feedback").show();
            }
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else if ((code.id == "igst" || code.id == "gst" || code.id == "cess") && code.value[code.value.length - 1] == ".") {
            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else if ((code.id == "gstin")) {


            if (code.value.length == 2) {

                $('#placeOfSupply').val(code.value);

                $("#select2-placeOfSupply-container").html($('#placeOfSupply option:selected').text());

            }

            if (code.value.length == 15) {
                //alert(code.value.toUpperCase());
                $("#gstin").val(code.value.toUpperCase());
                let gstVal = code.value.toUpperCase();
                let eMMessage = "No Errors";
                let statecode = gstVal.substring(0, 2);
                let patternstatecode = /^[0-9]{2}$/
                let threetoseven = gstVal.substring(2, 7);
                let patternthreetoseven = /^[A-Z]{5}$/
                let seventoten = gstVal.substring(7, 11);
                let patternseventoten = /^[0-9]{4}$/
                let Twelveth = gstVal.substring(11, 12);
                let patternTwelveth = /^[A-Z]{1}$/
                let Thirteen = gstVal.substring(12, 13);
                let patternThirteen = /^[1-9A-Z]{1}$/
                let fourteen = gstVal.substring(13, 14);
                let patternfourteen = /^Z$/
                let fifteen = gstVal.substring(14, 15);
                let patternfifteen = /^[0-9A-Z]{1}$/
                if (gstVal.length != 15) {
                    eMMessage = 'Length should be restricted to 15 digits and should not allow anything more or less';

                } else if (!patternstatecode.test(statecode)) {
                    eMMessage = 'First two characters of GSTIN should be numbers';

                } else if (!patternthreetoseven.test(threetoseven)) {
                    eMMessage = 'Third to seventh characters of GSTIN should be alphabets';

                } else if (!patternseventoten.test(seventoten)) {
                    eMMessage = 'Eighth to Eleventh characters of GSTIN should be numbers';

                } else if (!patternTwelveth.test(Twelveth)) {
                    eMMessage = 'Twelveth character of GSTIN should be alphabet';

                } else if (!patternThirteen.test(Thirteen)) {
                    eMMessage = 'Thirteen characters of GSTIN can be either alphabet or numeric';

                } else if (!patternfourteen.test(fourteen)) {
                    eMMessage = 'fourteen characters of GSTIN should be Z';

                } else if (!patternfifteen.test(fifteen)) {
                    eMMessage = 'fifteen characters of GSTIN can be either alphabet or numeric';
                }
                //console.log(eMMessage)

                if (eMMessage == "No Errors") {
                    $("#GSTError").html("Valid GSTIN");
                    document.getElementById(code.id).classList.add("is-valid");
                    document.getElementById(code.id).classList.remove("is-invalid");
                    $(errorMessageValid).show();
                    $(errorMessageInvalid).hide();

                    var pan = code.value.substring(2, 12);
                    $('#PanNo').val(pan);


                    return true;
                }
                else {
                    $("#GSTError").html(eMMessage);
                    document.getElementById(code.id).classList.remove("is-valid");
                    document.getElementById(code.id).classList.add("is-invalid");
                    $(errorMessageInvalid).show();
                    return false;
                }

            }
            else {

                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();

                $("#GSTError").html("");

                //document.getElementById(code.id).classList.remove("is-valid");
                //document.getElementById(code.id).classList.add("is-invalid");
                //$(errorMessageInvalid).show();
                return false;
            }

        }
        else {
            document.getElementById(code.id).classList.add("is-valid");
            document.getElementById(code.id).classList.remove("is-invalid");
            $(errorMessageValid).show();
            $(errorMessageInvalid).hide();
            $(".company-invalid-feedback").show();
            return true;
        }
    }
    function bindBrokerDropdown() {
        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/GetBrokerList',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (response) {
                debugger;
                let data = JSON.parse(response.d);
                console.log("GetBrokerList", data);
                $("#Broker").empty().append('<option value="-1">Select</option>');

                $.each(data, function (i, item) {
                    $("#Broker").append(`
                    <option value="${item.BrokerCode}">
                        ${item.BrokerCode} - ${item.BrokerName}
                    </option>
                `);
                });
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
