                        var isSame = (item.IsSameAddress == "1");
                        $("#checkAddress").prop("checked", isSame);
                        $("#shippingAddress").attr("disabled", isSame);

                        $('#placeOfSupply').val(item.State ? item.State.slice(0, 2) : '0');
                        $("#Broker").val(item.BrokerCode || '-1');
