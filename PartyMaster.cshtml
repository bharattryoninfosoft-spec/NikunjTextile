                $("#addNewContactLabel").html("Party Master Details");
                $(".detail").attr("disabled", true);
                $("#editbtn").hide();
            } else {
                $("#addNewContactLabel").html("Edit Party Master");
                $(".detail").attr("disabled", false);
                $("#editbtn").show();
            }

            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getPartyMasterById?id=' + id,
                dataType: 'json',
                success: function (response) {
                    if (response.Code == 200 && response.listPartyMaster.length > 0) {
                        var item = response.listPartyMaster[0];
                        $("#party-name").val(item.PartyName);
                        $('#phone, #phonetemp').val(item.MobileNo);
                        $('#alt-phone').val(item.AlterMobileNo);
                        $('#email').val(item.Email);
