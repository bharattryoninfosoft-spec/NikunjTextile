                                            <div class="field-wrapper">
                                                <p id="PPartyName"> </p>
                                            </div>
                                        </div>

                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                            <!-- Field wrapper start -->
                                            <div class="field-wrapper">
                                                <p id="PMobileNo"> </p>
                                            </div>
                                            <!-- Field wrapper end -->
                                        </div>


                                    </div>

                                </div>


                                <hr />
                                <div id="dropzone-sm">
                                    <div class="row gutters">


                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                            <!-- Field wrapper start -->
                                            <div class="field-wrapper">
                                                <input type="hidden" id="hGodownManagerUserAccountId" class="form-control" value="">
                                                <p id="PUserAccountName"> </p>
                                            </div>
                                        </div>

                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                            <!-- Field wrapper start -->
                                            <div class="field-wrapper">
                                                <p id="PUserAccountMobileNo"> </p>
                                            </div>
                                            <!-- Field wrapper end -->
                                        </div>


                                    </div>

                                </div>





                            </div>


                            <div class="col-xl-9 col-lg-9 col-md-9 col-sm-9 col-9" style="border-left: 1px solid;">

                                <div id="dropzone-sm">
                                    <div class="row gutters">


                                        <div class="col-12">
                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="tblYarnOutward" style="overflow: hidden;">
                                                    <thead>
                                                        <tr>
                                                            <th colspan="8">Yarn Outward</th>
                                                        </tr>
                                                        <tr>
                                                            <th style="width:3%;">#</th>
                                                            <th style="width: 15%; text-align: center;"> Company Name </th>
                                                            <th style="width: 15%; text-align: center;">Yarn <br />Material</th>
                                                            <th style="width: 10%; text-align: center;">Yarn <br />Color</th>
                                                            <th style="width: 10%; text-align: center;">Yarn <br />Code</th>
                                                            <th style="width: 10%; text-align: center;">Box No</th>
                                                            <th style="width: 10%; text-align: center;">No Of Box</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody id="tableYarnOutward">
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <th colspan="6" style="text-align:end;">Total Boxes</th>
                                                            <th style="text-align:center;"><span id="spanTotalWeight"></span></th>
                                                        </tr>
                                                    </tfoot>



                                                </table>




                                            </div>
                                        </div>



                                    </div>

                                </div>


                            </div>



                        </div>
                        <br />


                    </div>
                    <input id="edit-id" type="hidden" />
                    <input id="catedit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Yarn Outward List</div>
                    <br />


                    <div class="row gutters">


                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                        </div>


                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <!-- Field wrapper start -->
                            <div class="field-wrapper">
                                <input id="SearchRequirementNo" placeholder="Search Outward List No. / Sundry Creditors / Godown Manager." type="text" class="form-control clear-field detail" onkeyup="functionSearch()">
                                <div class="field-placeholder">Search Outward List No. / Sundry Creditors / Godown Manager </div>
                            </div>
                            <!-- Field wrapper end -->
                        </div>

                    </div>


                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr style=" background-color: #1273eb;">
                                    <th style="color: white !important;">Sr No</th>
                                    <th style="color: white !important;">Action</th>
                                    <th style="color: white !important;">Outward <br /> List No</th>
                                    <th style="color: white !important;">GodownTitle</th>
                                    <th style="color: white !important;">Outward <br /> Date</th>
                                    <th style="color: white !important;">Sundry <br /> Party</th>
                                    <th style="color: white !important;">Party <br /> Mobile No </th>
                                    <th style="color: white !important;">Godown Manager </th>
                                    <th style="color: white !important;">Godown Manager <br /> Contact No</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>



                    <br />


                    <nav aria-label="Page navigation example">
                        <ul class="pagination justify-content-center" id="divPaggination">
                            @*<li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                                </li>
                                <li class="page-item"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Next</a>
                                </li>*@
                        </ul>
                    </nav>




                </div>
            </div>

        </div>
    </div>

    <!-- Row end -->

</div>
<!-- Content wrapper end -->

@section Scripts{
    <script>
        var currentPagePermission = {};
        $(document).ready(function () {
            FunctionIsLogin();
            displayPagginationData();
            displayData(0);
            getYarnColor();
            //getDefaultCompany();
        });

        var notes = $('#notes').notify({
            removeIcon: '<i class="icon-close"></i>'
        });

        var notess = $('#notess').notify({
            removeIcon: '<i class="icon-close"></i>'
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: request.statusText || 'Failed to fetch default company',
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    console.log(data);
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function functionSearch() {
            displayPagginationData();
            displayData(0);
        }

        function displayData(rowStartCheck) {
            var rowStart = rowStartCheck;
            var searchdesignNo = $("#SearchRequirementNo").val();

            var formData = new FormData();
            formData.append('SearchRequirementNo', searchdesignNo);
            formData.append('startFrom', rowStart);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getDisplayYarnOutwardMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").empty();
                    }

                    var temp = "";
                    var srno = parseInt(rowStart) + parseInt(1);
                    for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {
                        temp += "<tr><td>" + srno++ + "</td>";
                        temp += "<td><div class='actions'>";

                        temp += "<a href='javascript:void(0);' " +
                            "class='DeleteBtn' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Edit' " +
                            "onclick='showEditRecords(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'>" +
                            "<i class='icon-edit1 text-info'></i>" +
                            "</a>&nbsp;&nbsp;&nbsp;";

                        temp += "<a href='javascript:void(0);' " +
                            "class='viewBtn' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Details' " +
                            "data-bs-toggle='modal' " +
                            "data-bs-target='#addNewContact' " +
                            "onclick='showRecords(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'>" +
                            "<i class='fa fa-eye text-secondary'></i>" +
                            "</a>&nbsp;&nbsp;&nbsp;";

                        temp += "<a href='javascript:void(0);' " +
                            "class='DeleteBtn' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Delete' " +
                            "onclick='functionUserDelete(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'>" +
                            "<i class='icon-x-circle text-danger'></i>" +
                            "</a>";

                        temp += "</div></td>";

                        temp += "<td>" + response.listYarnOutwardMaster[i].OutwardListNo + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].GodownTitle + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].OutwardListDates + "</td>";

                        var SpanSundryParty = "";
                        if (response.listYarnOutwardMaster[i].SundryParty == "1") {
                            SpanSundryParty = "<span class='badge bg-success' style='margin-top: 5px;'><i class='fa fa-arrow-down'></i> Sundry Creditors</span>";
                        }
                        else if (response.listYarnOutwardMaster[i].SundryParty == "2") {
                            SpanSundryParty = "<span class='badge bg-danger' style='margin-top: 5px;'><i class='fa fa-arrow-up'></i> Sundry Debtors</span>";
                        }
                        else if (response.listYarnOutwardMaster[i].SundryParty == "3") {
                            SpanSundryParty = "<span class='badge bg-warning' style='margin-top: 5px;'><i class='fa fa-user'></i> Job Work</span>";
                        }

                        temp += "<td>" + response.listYarnOutwardMaster[i].PartyName + " <br />" + SpanSundryParty + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].MobileNo + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].UserAccountName + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].UserAccountMobileNo + "</td>";

                        temp += "</tr>";
                    }
                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").html(temp);
                    } else {
                        $("#copy-print-csv tbody").append(temp);
                    }
                    var permission = getCookie("PagePermission");
                    if (permission != null && permission != "") {
                        var currentPagePermission = JSON.parse(permission);
                        if (currentPagePermission.Add == false) {
                            $("#ADDYarnOutWardChallannew").hide();
                        }
                        if (currentPagePermission.Edit == false) { $(".EditBtn").hide(); }
                        if (currentPagePermission.Delete == false) { $(".DeleteBtn").hide(); }
                        if (currentPagePermission.view == false) { $(".viewBtn").hide(); }
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        var total = 0;
        var Paggination = 0;
        var prevNo = 0;
        var nextNo = 0;
        var SelectNo = 1;
        var PageNo = 0;

        // Display Pagination
        function displayPagginationData() {
            var searchdesignNo = $("#SearchRequirementNo").val();

            var formData = new FormData();
            formData.append('SearchString', searchdesignNo);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutwardMasterPaggination',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    total = response.listPagginationMaster[0].Total;
                    Paggination = response.listPagginationMaster[0].Paggination + 1;
                    prevNo = 0;
                    nextNo = 10;
                    if (response.listPagginationMaster[0].Paggination == "0") {
                        $('#divPaggination').hide();
                    }
                    else {
                        if (parseInt(response.listPagginationMaster[0].Paggination) <= parseInt(10)) {
                            var temp = "";
                            for (var i = 1; i <= parseInt(response.listPagginationMaster[0].Paggination); i++) {
                                if (i == 1) {
                                    temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                                else {
                                    temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                            }
                            $('#divPaggination').html(temp).show();
                        }
                        else {
                            var temp = "";
                            for (var i = 1; i <= 10; i++) {
                                if (i == 1) {
                                    temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                                else {
                                    temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                            }
                            temp += "<li class='page-item' id='next'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";
                            $('#divPaggination').html(temp).show();
                        }
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        // Select Pagination
        function funcationPaggination(abc) {
            $("#trLoading").show();
            var a = "#a" + abc;
            SelectNo = abc;
            $('li').removeClass('active');
            $(a).addClass('active');

            $("#rowStartCount").val(((abc - 1) * 30));
            displayData(((abc - 1) * 30));
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Color Matching Form");
            $("#add-alert").hide();

            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function showRecords(id) {
            clearAll();
            $("#edit-id").val(id);
            $("#saveViewbtn").hide();
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Yarn Outward Form");

            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    ViewRecordQueryString(DecryptID);
                },
                error: function (request, status, error) {
                }
            });
        }

        function showEditRecords(id) {
            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.location.href = '/UpdateYarnOutWardChallanNew?id=' + response.listEncryptDecrypt[0].DecryptID;
                },
                error: function (request, status, error) {
                }
            });
        }

        var ArrayYarnColor = [];

        function getYarnColor() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMatching',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    ArrayYarnColor.push(response.listYarnColorMaster);
                    if (response.Code == "200") {
                        if (response.listYarnColorMaster.length > 0) {
                            var tempDesignNo = "";
                        }
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function ViewRecordQueryString(DecryptID) {
            var formData = new FormData();
            formData.append('YarnOutwardID', DecryptID);
            var PartyId = 0;

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutwardDetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var userTable = $('#TblUser');

                    for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {
                        $("#hYarnOutwardID").val(response.listYarnOutwardMaster[i].YarnOutwardID);
                        $("#hGodownManagerUserAccountId").val(response.listYarnOutwardMaster[i].hGodownManagerUserAccountId);
                        $("#POutwardListNo").html("<b>Outward List No: </b>" + response.listYarnOutwardMaster[i].OutwardListNo);
                        $("#POutwardListDate").html("<b>Outward List Date: </b>" + response.listYarnOutwardMaster[i].OutwardListDates);

                        var SpanSundryParty = "";
                        if (response.listYarnOutwardMaster[i].SundryParty == "1") {
                            SpanSundryParty = "<span class='badge bg-success' style='margin-top: 5px;'><i class='fa fa-arrow-down'></i> Sundry Creditors</span>";
                        }
                        else if (response.listYarnOutwardMaster[i].SundryParty == "2") {
                            SpanSundryParty = "<span class='badge bg-danger' style='margin-top: 5px;'><i class='fa fa-arrow-up'></i> Sundry Debtors</span>";
                        }
                        else if (response.listYarnOutwardMaster[i].SundryParty == "3") {
                            SpanSundryParty = "<span class='badge bg-warning' style='margin-top: 5px;'><i class='fa fa-user'></i> Job Work</span>";
                        }

                        $("#PPartyName").html("<b>Sundry Party Name: </b>" + response.listYarnOutwardMaster[i].PartyName + "  " + SpanSundryParty);
                        $("#PMobileNo").html("<b>Mobile No: </b>" + response.listYarnOutwardMaster[i].MobileNo);

                        $("#PUserAccountName").html("<b>Godown Manager: </b>" + response.listYarnOutwardMaster[i].UserAccountName);
                        $("#PUserAccountMobileNo").html("<b>Manager Mobile No: </b>" + response.listYarnOutwardMaster[i].UserAccountMobileNo);

                        $("#tblYarnOutward tbody").empty();
                        var temp = "";
                        var spanTotalWeight = "0";
                        var srno = parseInt(0) + parseInt(1);
                        for (var j = 0; j < response.listYarnOutwardMaster[i].listYarnOutwardDetail.length; j++) {
                            temp += "<tr><td>" + srno++ + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].CompanyName + " <br />" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].CompanyMobileNo + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].YarnMaterial + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].YarnColor + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].YarnColorCode + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].LocationTitle + "<br />" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].GodownTitle + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].NoOfBox + "</td>";
                            temp += "</tr>";
                            spanTotalWeight = parseFloat(spanTotalWeight) + parseFloat(response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].NoOfBox);
                        }
                        $("#tblYarnOutward tbody").html(temp);
                        $("#spanTotalWeight").html(spanTotalWeight.toFixed(2));
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function functionUserDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('YarnOutwardID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteYarnOutwardMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
