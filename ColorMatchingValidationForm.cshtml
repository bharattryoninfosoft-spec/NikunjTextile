@{
    Layout = "/_LayoutPage1.cshtml";
}

<!-- Loading wrapper start -->
<div id="loading-wrapper">
    <div class="spinner-border"></div>
    Loading...
</div>
<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Color Matching Validation Form</div>
                    <br />
                    <!--Images-->
                    <div class="row gutters">
                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-12">
                            <div id="dropzone-sm">
                                <div class="row gutters">
                                    <div class="col-12" style="text-align: center;">
                                        <div class="form-section-header" style="margin: 0; padding: 0.3rem 0.9rem; background: #689de7;">Design No</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                            <div id="dropzone-sm">
                                <div class="row gutters">
                                    <div class="col-12">
                                        <select class="select-single detail" style="min-height: 35px;" id="DesignNo" onchange="getDesignNo(this)">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 col-12"></div>

                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-12">
                            <div id="dropzone-sm">
                                <div class="row gutters">
                                    <div class="col-12" style="text-align: center;">
                                        <div class="form-section-header" style="margin: 0; padding: 0.3rem 0.9rem; background: #689de7;">Color Matching ID</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <div id="dropzone-sm">
                                <div class="row gutters">
                                    <div class="col-12">
                                        <select class="select-single detail" style="min-height: 35px;" id="ColorMatchingID" onchange="getColorMatchingId(this)">
                                            <option value="">Select Color Matching</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <br />
                            <br />
                            <div id="dropzone-sm" class="mb-3 image-upload-clear-image">
                                <div class="dropzone needsclick dz-clickable" id="demo-upload">
                                    <div class="dz-message needsclick" style="text-align: center;">
                                        <label id="upload-PhotoOfDesign-default-preview" for="upload-PhotoOfDesign-default" style="width: 100%; padding-top: 80px;">Photo Of Design.</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <br />
                            <br />
                            <div id="dropzone-sm" class="mb-3 image-upload-clear-image">
                                <div class="dropzone needsclick dz-clickable" id="demo-upload">
                                    <input type="file" id="upload-ColorMatching-default" style="display:none;" onchange="saveImage(this)" accept="image/*" />
                                    <input type="hidden" id="upload-ColorMatching-temp-default" value="" />
                                    <div class="dz-message needsclick" style="text-align: center;">
                                        <label id="upload-ColorMatching-default-preview" for="upload-ColorMatching-default" style="width: 100%; padding-top: 80px;">Color Matching Photo to Be Uploaded.</label>
                                    </div>
                                </div>
                                <div style="text-align: end; padding-top: 10px;">
                                    <button type="button" class="btn btn-outline-danger" id="btnclearColorMatchingDefault" onclick="clearColorMatchingDefault()" style="padding: .375rem .75rem;"><i class="fa fa-times" style="font-size:large; margin:0; padding:0;"></i></button>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <div id="dropzone-sm">
                                <div class="table-responsive" id="divColorMatchingTable"></div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" style="text-align:center;">
                            <div id="dropzone-sm">
                                <button id="Previousbtn" type="button" class="btn btn-success" onclick="checkPrevious()" style="padding: .375rem .75rem; box-shadow: 0px 0px 2px 1px black; display:none;"><i class="fa fa-arrow-left" style="font-size: x-large;"></i></button> &nbsp; &nbsp;
                                <button id="Nextbtn" type="button" class="btn btn-success" onclick="checkNext()" style="padding: .375rem .75rem; box-shadow: 0px 0px 2px 1px black; display: none;"><i class="fa fa-arrow-right" style="font-size: x-large;"></i></button>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-12">
                            <div id="dropzone-sm">
                                <div class="row gutters">
                                    <div class="col-12" style="text-align: center;">
                                        <div class="form-section-header" style="margin: 0; padding: 0.3rem 0.9rem; background: #689de7;">Color Group</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <div id="dropzone-sm">
                                <div class="row gutters">
                                    <div class="col-12">
                                        <select class="select-single" style="min-height: 35px;" id="ColorGroup">
                                            <option value="">Select Color Group</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="modal-footer">
                        <button id="savebtn" type="button" class="btn btn-primary" onclick="checkSave()" style="font-size: medium;">Save Color Validate</button>
                    </div>

                    <input type="hidden" id="txtColorArray" title="txtColorArray" />
                    <input type="hidden" id="warpLength" title="warpLength" />
                    <input type="hidden" id="weftLength" title="weftLength" />
                    <input type="hidden" id="WarpCheckBox" title="WarpCheckBox" />
                    <input type="hidden" id="WeftCheckBox" title="WeftCheckBox" />
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        $('body').addClass('fullscreen');
        var currentPagePermission = {};
        var ArrayYarnColor = [];
        var listDesignColorMatchingDetails = [];
        var listDesignEntryWeftData = [];
        var DesignColorMatchingDetails = [];
        var isCurrentMatchingLockedInSaleOrder = false;

        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                currentPagePermission = JSON.parse(permission);
                if (currentPagePermission.Add == false) {
                    $("#savebtn").hide();
                }
            }

            FunctionIsLogin();
            getDesignEntryForm();
            getYarnColor();
            getColorGroup();
        });

        var notes = $('#notes').notify({
            removeIcon: '<i class="icon-close"></i>'
        });
        var notess = $('#notess').notify({
            removeIcon: '<i class="icon-close"></i>'
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request) {
                    notes.show(request.statusText, { type: 'danger' });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#Updatebtn").hide();
            $("#addNewContactLabel").html("Add Design Entry Form");
            $("#add-alert").hide();
            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();

            if (code.value == "0" || code.value == "") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }

            document.getElementById(code.id).classList.add("is-valid");
            document.getElementById(code.id).classList.remove("is-invalid");
            $(errorMessageValid).show();
            $(errorMessageInvalid).hide();
            $(".company-invalid-feedback").show();
            return true;
        }

        function isUsedInSaleOrder(detail) {
            if (!detail) return false;
            var flag = detail.IsUsedInSaleOrder !== undefined
                ? detail.IsUsedInSaleOrder
                : (detail.isUsedInSaleOrder !== undefined ? detail.isUsedInSaleOrder : detail.IsInSaleOrder);
            return flag === true || flag === 1 || flag === "1" || String(flag).toLowerCase() === "true";
        }

        function applySaleOrderEditLock(locked) {
            isCurrentMatchingLockedInSaleOrder = Boolean(locked);
            var canAdd = currentPagePermission.Add !== false;

            $("#upload-ColorMatching-default").prop("disabled", isCurrentMatchingLockedInSaleOrder);
            $("#btnclearColorMatchingDefault")
                .prop("disabled", isCurrentMatchingLockedInSaleOrder)
                .toggle(!isCurrentMatchingLockedInSaleOrder);
            $("#ColorGroup").prop("disabled", isCurrentMatchingLockedInSaleOrder);

            if (isCurrentMatchingLockedInSaleOrder) {
                $("#savebtn").prop("disabled", true).hide();
                if ($("#saleOrderLockAlert").length === 0) {
                    $("#divColorMatchingTable").prepend(
                        '<div id="saleOrderLockAlert" class="alert alert-warning py-2 px-3 mb-2" style="font-size:0.82rem;font-weight:600;">' +
                        '<i class="fa fa-lock me-1"></i> This Color Matching ID is already added in a Sale Order and cannot be edited.' +
                        '</div>'
                    );
                }
            } else {
                $("#saleOrderLockAlert").remove();
                $("#savebtn").prop("disabled", false).toggle(canAdd);
            }
        }

        function getDesignEntryForm() {
            var formData = new FormData();

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getExistsDesignNoForm',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200" && response.listDesignEntryForm.length > 0) {
                        $('#DesignNo').html("<option value=''> Select Designer No </option>");
                        for (var i = 0; i < response.listDesignEntryForm.length; i++) {
                            var item = response.listDesignEntryForm[i];
                            var optionHtml = "<option value='" + item.DesignEntryFormID + "|" + item.DesignColorMatchingFormID + "'> " + item.DesignerCode + item.DesignNo + " </option>";
                            $('#DesignNo').append(optionHtml);
                        }
                    }
                }
            });
        }

        function getYarnColor() {
            var formData = new FormData();

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMatching',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    ArrayYarnColor.push(response.listYarnColorMaster || []);
                }
            });
        }

        function getColorGroup() {
            var formData = new FormData();

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getColorGroup',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200" && response.listColorGroupMaster.length > 0) {
                        $('#ColorGroup').html("<option value='0' selected> Select Color Group </option>");
                        for (var i = 0; i < response.listColorGroupMaster.length; i++) {
                            var grp = response.listColorGroupMaster[i];
                            $('#ColorGroup').append("<option value='" + grp.ColorGroupID + "'> " + grp.ColorGroup + " </option>");
                        }
                    }
                }
            });
        }

        function saveImage(input) {
            if (isCurrentMatchingLockedInSaleOrder) {
                input.value = "";
                return false;
            }

            var previewStr = "#" + input.id + "-preview";
            if (input.files && input.files[0]) {
                var fildr = new FileReader();
                fildr.onload = function (e) {
                    var imgStr = "<img src='" + e.target.result + "' style='width:100%;margin-top:-54px;'>";
                    $(previewStr).html(imgStr);
                    $(previewStr).css('color', 'initial');
                };
                fildr.readAsDataURL(input.files[0]);
                return true;
            }

            var message = (input.id == "upload-image" || input.id == "upload-image-default")
                ? "Photo Of Sketch Is Needed."
                : "Photo Of Design Is Needed.";
            $(previewStr).html(message);
            $(previewStr).css('color', 'red');
            return false;
        }

        function clearColorMatchingDefault() {
            if (isCurrentMatchingLockedInSaleOrder) return;
            $("#upload-ColorMatching-default-preview").html("Color Matching Photo to Be Uploaded.");
            $("#upload-ColorMatching-default").val("");
        }

        function getDesignNo(abc) {
            $("#divColorMatchingTable").html('');
            listDesignColorMatchingDetails = [];
            listDesignEntryWeftData = [];
            applySaleOrderEditLock(false);

            if (abc.value != "") {
                var DesignEntryFormID = abc.value.split("|")[0];
                var DesignColorMatchingFormID = abc.value.split("|")[1];

                var formData = new FormData();
                formData.append('DesignEntryFormID', DesignEntryFormID);
                formData.append('DesignColorMatchingFormID', DesignColorMatchingFormID);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getCreateColorMatchingFormDetails',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        var form = response.listDesignColorMatchingForm[0];
                        var imgStr = `<img src="https://weavelanesoft.in/${form.PhotoOfDesign}" style="width:100%;margin-top:-54px;">`;
                        $("#upload-PhotoOfDesign-default-preview").html(imgStr).css('color', 'initial');

                        $("#weftLength").val(form.TotalWeft);
                        $("#warpLength").val(form.TotalWarp);
                        $("#WarpCheckBox").val(form.WarpCheckBox);
                        $("#WeftCheckBox").val(form.WeftCheckBox);

                        $("#ColorMatchingID").html('<option value="0" selected>Select Color Matching</option>');
                        for (var i = 0; i < form.listDesignColorMatchingDetails.length; i++) {
                            var detail = form.listDesignColorMatchingDetails[i];
                            var lockedTag = isUsedInSaleOrder(detail) ? " [In Sale Order]" : "";
                            $("#ColorMatchingID").append(
                                '<option value="' + detail.DesignColorMatchingDetailsID + '">' +
                                detail.WarpMatchingID + ' - ' + detail.FeederMatchingID + lockedTag +
                                '</option>'
                            );
                        }

                        listDesignColorMatchingDetails.push(form.listDesignColorMatchingDetails);
                        listDesignEntryWeftData.push(form.listDesignEntryWeftData);

                        $("#Previousbtn").hide();
                        $("#Nextbtn").show();
                        $("#btnclearColorMatchingDefault").click();
                    }
                });
            }
            else {
                $("#upload-PhotoOfDesign-default-preview").html('Photo Of Design.');
                $("#weftLength").val('');
                $("#warpLength").val('');
            }
        }

        function updateNavButtons() {
            var selectedColorOption = $('#ColorMatchingID').find('option:selected');
            var prevColorOption = selectedColorOption.prev();
            var nextColorOption = selectedColorOption.next();

            $("#Nextbtn").show();
            $("#Previousbtn").show();

            if (prevColorOption.text() == "") {
                $("#Previousbtn").hide();
                $("#Nextbtn").show();
            }

            if (nextColorOption.text() == "") {
                $("#Nextbtn").hide();
                $("#Previousbtn").show();
            }
        }

        function checkPrevious() {
            var prevOption = $('#ColorMatchingID').find('option:selected').prev();
            if (!prevOption.length) return;
            $('#ColorMatchingID').val(prevOption.val());
            updateNavButtons();
            $("#btnclearColorMatchingDefault").click();
            getColorMatchingId(document.getElementById("ColorMatchingID"));
        }

        function checkNext() {
            var nextOption = $('#ColorMatchingID').find('option:selected').next();
            if (!nextOption.length) return;
            $('#ColorMatchingID').val(nextOption.val());
            updateNavButtons();
            $("#btnclearColorMatchingDefault").click();
            getColorMatchingId(document.getElementById("ColorMatchingID"));
        }

        function showWarp(abc) {
            if (isCurrentMatchingLockedInSaleOrder) return;
            $("#MatchingWarp" + abc).removeAttr("disabled");
        }

        function showFeeder(abc) {
            if (isCurrentMatchingLockedInSaleOrder) return;
            $("#MatchingFeeder" + abc).removeAttr("disabled");
        }

        function getColorCodeById(yarnColorId) {
            var yarnColors = ArrayYarnColor[0] || [];
            for (var j = 0; j < yarnColors.length; j++) {
                if (yarnColors[j].YarnColorID == yarnColorId) {
                    return "#" + yarnColors[j].YarnColorCode;
                }
            }
            return "";
        }

        function getColorMatchingId(abc) {
            if (abc.value == "0") {
                applySaleOrderEditLock(false);
                $("#btnclearColorMatchingDefault").click();
                return;
            }

            updateNavButtons();

            var warpLength = parseInt($("#warpLength").val(), 10) || 0;
            var weftLength = parseInt($("#weftLength").val(), 10) || 0;
            DesignColorMatchingDetails = listDesignColorMatchingDetails[0] || [];
            var weftMetaList = listDesignEntryWeftData[0] || [];
            var WarpCheckBoxArry = ($("#WarpCheckBox").val() || "").split("|");
            var WeftCheckBoxArry = ($("#WeftCheckBox").val() || "").split("|");

            for (var i = 0; i < DesignColorMatchingDetails.length; i++) {
                var rowItem = DesignColorMatchingDetails[i];
                if (abc.value != rowItem.DesignColorMatchingDetailsID) continue;

                var locked = isUsedInSaleOrder(rowItem);

                if (rowItem.ColorMatchingPhoto != "") {
                    var imgStr = `<img src="https://weavelanesoft.in/${rowItem.ColorMatchingPhoto}" style="width:100%;margin-top:-54px;">`;
                    $("#upload-ColorMatching-default-preview").html(imgStr).css('color', 'initial');
                    $("#upload-ColorMatching-temp-default").val(rowItem.ColorMatchingPhoto);
                    $("#savebtn").removeClass("btn-primary").addClass("btn-warning").text('Update Color Validate');
                }
                else {
                    $("#upload-ColorMatching-temp-default").val('');
                    $("#upload-ColorMatching-default-preview").html("Color Matching Photo to Be Uploaded.").css('color', '');
                    $("#upload-ColorMatching-default").val("");
                    $("#savebtn").removeClass("btn-warning").addClass("btn-primary").text('Save Color Validate');
                }

                $("#ColorGroup").val(rowItem.ColorGroupID != "0" ? rowItem.ColorGroupID : 0);

                var tempColorMatchingTable = '<br /><br />';
                tempColorMatchingTable += '<input type="hidden" id="WarpMatchingID" value="' + rowItem.WarpMatchingID + '" class="form-control"/>';
                tempColorMatchingTable += '<table id="copy-print-csvs" class="table table-hover table-bordered m-0"><tbody>';

                for (var w = 1; w <= warpLength; w++) {
                    var srNos = w - 1;
                    var colorCode = getColorCodeById(rowItem["Warp" + w]);

                    tempColorMatchingTable += '<tr style="text-align: center;">';
                    tempColorMatchingTable += '<th style="padding: .3rem .3rem; width: 15%;">Warp ' + w + '</th>';
                    if (srNos == 0) {
                        tempColorMatchingTable += '<th style="padding: .3rem .3rem; width: 15%;"></th>';
                    }
                    else {
                        tempColorMatchingTable += '<th style="padding: .3rem .3rem; width: 15%;"><input type="hidden" value="' + (WarpCheckBoxArry[srNos] || "") + '" id="ischeckWarp' + w + '" disabled/></th>';
                    }

                    tempColorMatchingTable += '<td style="padding: .3rem .3rem; width: 40%;">';
                    tempColorMatchingTable += '<select id="MatchingWarp' + w + '" class="form-control is-valid" style="min-height: 30px; width: 90%; font-size: x-small;" onfocusout="validate(this)" onchange="MatchingWarp(' + w + ')" disabled>';
                    tempColorMatchingTable += '<option value="0"> Select Color </option>';
                    for (var j = 0; j < ArrayYarnColor[0].length; j++) {
                        var yc = ArrayYarnColor[0][j];
                        var sel = (rowItem["Warp" + w] == yc.YarnColorID) ? " selected" : "";
                        tempColorMatchingTable += "<option value='" + yc.YarnColorID + "'" + sel + "> " + yc.YarnColor + " </option>";
                    }
                    tempColorMatchingTable += '</select></td>';
                    tempColorMatchingTable += '<td id="tdWarColor' + w + '" style="padding: .3rem .3rem; width: 15%;"><div id="tddivColor' + w + '" style="background-color: ' + colorCode + '; padding: 15px;"></div></td>';
                    if (locked) {
                        tempColorMatchingTable += '<td style="padding: .3rem .3rem; width: 5%;"><i class="fa fa-lock text-secondary" title="Used in Sale Order"></i></td>';
                    } else {
                        tempColorMatchingTable += '<td style="padding: .3rem .3rem; width: 5%;"><a href="javascript:void(0);" data-toggle="tooltip" data-placement="top" title="Edit" onclick="showWarp(' + w + ')"><i class="icon-edit1 text-info" style="font-size: large;"></i></a></td>';
                    }
                    tempColorMatchingTable += '</tr>';
                }

                tempColorMatchingTable += '</tbody></table><hr style="height: 5px;">';
                tempColorMatchingTable += '<input type="hidden" id="FeederMatchingID" value="' + rowItem.FeederMatchingID + '" class="form-control"/>';
                tempColorMatchingTable += '<table id="copy-print-csvs" class="table table-hover table-bordered m-0"><tbody>';

                for (var fe = 1; fe <= weftLength; fe++) {
                    var srNo = fe - 1;
                    var weftMeta = weftMetaList[srNo] || {};
                    var colorCode = getColorCodeById(rowItem["Feeder" + fe]);

                    tempColorMatchingTable += '<tr style="text-align: center;">';
                    tempColorMatchingTable += '<th style="padding: .3rem .3rem; width: 15%;">Feeder ' + fe + '</th>';
                    if (weftMeta.DesignSpecification == "GROUND") {
                        tempColorMatchingTable += '<th style="padding: .3rem .3rem; width: 15%;"><span id="spanDesignSpecification' + fe + '"> ' + weftMeta.DesignSpecification + ' </span></th>';
                    }
                    else {
                        tempColorMatchingTable += '<th style="padding: .3rem .3rem; width: 15%;"><span id="spanDesignSpecification' + fe + '"> ' + (weftMeta.DesignSpecification || "") + ' </span> &nbsp; <input type="hidden" value="' + (WeftCheckBoxArry[srNo] || "") + '" id="ischeckWeft' + fe + '" disabled/></th>';
                    }

                    tempColorMatchingTable += '<td style="padding: .3rem .3rem; width: 40%;">';
                    tempColorMatchingTable += '<select id="MatchingFeeder' + fe + '" class="form-control is-valid" style="min-height: 30px; width: 90%; font-size: x-small;" onfocusout="validate(this)" onchange="MatchingFeeder(' + fe + ')" disabled>';
                    tempColorMatchingTable += '<option value="0"> Select Color </option>';
                    for (var j = 0; j < ArrayYarnColor[0].length; j++) {
                        var yc = ArrayYarnColor[0][j];
                        var sel = (rowItem["Feeder" + fe] == yc.YarnColorID) ? " selected" : "";
                        tempColorMatchingTable += "<option value='" + yc.YarnColorID + "'" + sel + "> " + yc.YarnColor + " </option>";
                    }
                    tempColorMatchingTable += '</select></td>';
                    tempColorMatchingTable += '<td id="tdWarColor' + fe + '" style="padding: .3rem .3rem; width: 15%;"><div id="tddivFeederColor' + fe + '" style="background-color: ' + colorCode + '; padding: 15px;"></div></td>';
                    if (locked) {
                        tempColorMatchingTable += '<td style="padding: .3rem .3rem; width: 5%;"><i class="fa fa-lock text-secondary" title="Used in Sale Order"></i></td>';
                    } else {
                        tempColorMatchingTable += '<td style="padding: .3rem .3rem; width: 5%;"><a href="javascript:void(0);" data-toggle="tooltip" data-placement="top" title="Edit" onclick="showFeeder(' + fe + ')"><i class="icon-edit1 text-info" style="font-size: large;"></i></a></td>';
                    }
                    tempColorMatchingTable += '</tr>';
                }

                tempColorMatchingTable += '</tbody></table><br />';
                tempColorMatchingTable += '<center><span class="field-placeholder" style="position: relative; padding: 0px 12px 0px 12px; width: 90%; text-align: center; color:red; font-size: medium; font-weight: 600;" id="spanDuplicate"></span></center><br />';
                $("#divColorMatchingTable").html(tempColorMatchingTable);

                applySaleOrderEditLock(locked);
            }
        }

        function buildWarpMatchingId() {
            var warpLength = parseInt($("#warpLength").val(), 10) || 0;
            var result = "";

            for (var i = 0; i < warpLength; i++) {
                var srNo = i + 1;
                var selectedText = $("#MatchingWarp" + srNo).find('option:selected').text().replace(/ /g, "");
                if (i == 0 || $("#ischeckWarp" + srNo).val() == "1") {
                    result += selectedText + "/";
                }
            }
            return result.slice(0, -1);
        }

        function buildFeederMatchingId() {
            var weftLength = parseInt($("#weftLength").val(), 10) || 0;
            var missing = [], checked = [];

            for (var i = 1; i <= weftLength; i++) {
                var chk = $(`#ischeckWeft${i}`);
                if (!chk.length) missing.push(i);
                else checked.push(i);
            }

            var result = "";
            for (var mi = 0; mi < missing.length; mi++) {
                result += $("#MatchingFeeder" + missing[mi]).find('option:selected').text().replace(/ /g, "") + "/";
            }
            for (var ck = 0; ck < checked.length; ck++) {
                if ($("#ischeckWeft" + checked[ck]).val() == 1) {
                    result += $("#MatchingFeeder" + checked[ck]).find('option:selected').text().replace(/ /g, "") + "/";
                }
            }
            return result.slice(0, -1);
        }

        function hasDuplicateMatching(candidateMatchingId) {
            var currentColorMatchingId = $("#ColorMatchingID").val();
            for (var j = 0; j < DesignColorMatchingDetails.length; j++) {
                var detail = DesignColorMatchingDetails[j];
                if (detail.DesignColorMatchingDetailsID != currentColorMatchingId && detail.MatchingID == candidateMatchingId) {
                    return j + 1;
                }
            }
            return 0;
        }

        function MatchingWarp(abc) {
            if (isCurrentMatchingLockedInSaleOrder) return;

            var colorCode = getColorCodeById($("#MatchingWarp" + abc).val());
            $("#tddivColor" + abc).css("background-color", colorCode);

            var warpMatchId = buildWarpMatchingId();
            $("#WarpMatchingID").val(warpMatchId);

            var dupRow = hasDuplicateMatching(warpMatchId + "/" + $("#FeederMatchingID").val());
            if (dupRow > 0) {
                $("#savebtn").hide();
                $("#spanDuplicate").html("Duplicate Found with Matching " + dupRow);
            }
            else {
                $("#savebtn").show();
                $("#spanDuplicate").html("");
            }
        }

        function MatchingFeeder(abc) {
            if (isCurrentMatchingLockedInSaleOrder) return;

            var colorCode = getColorCodeById($("#MatchingFeeder" + abc).val());
            $("#tddivFeederColor" + abc).css("background-color", colorCode);

            var feederMatchId = buildFeederMatchingId();
            $("#FeederMatchingID").val(feederMatchId);

            var dupRow = hasDuplicateMatching($("#WarpMatchingID").val() + "/" + feederMatchId);
            if (dupRow > 0) {
                $("#savebtn").hide();
                $("#spanDuplicate").html("Duplicate Found with Matching " + dupRow);
            }
            else {
                $("#savebtn").show();
                $("#spanDuplicate").html("");
            }
        }

        function checkSave() {
            if (isCurrentMatchingLockedInSaleOrder) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Locked Record',
                    text: 'This Color Matching ID is already used in a Sale Order and cannot be edited.'
                });
                return false;
            }

            $("#loading-wrapper").show();

            var warpLength = parseInt($("#warpLength").val(), 10) || 0;
            var weftLength = parseInt($("#weftLength").val(), 10) || 0;
            var warpMatchId = buildWarpMatchingId();
            var feederMatchId = buildFeederMatchingId();
            var dupRow = hasDuplicateMatching(warpMatchId + "/" + feederMatchId);

            if (dupRow > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Duplicate Found',
                    text: 'Matching ' + dupRow + ' already exists.',
                    confirmButtonText: 'OK'
                });
                $("#spanDuplicate").html("Duplicate Found with Matching " + dupRow);
                $("#loading-wrapper").hide();
                return false;
            }

            $("#spanDuplicate").html("");

            var colorGroupEl = document.getElementById("ColorGroup");
            var colorMatchingIdEl = document.getElementById("ColorMatchingID");
            var tempPhoto = $("#upload-ColorMatching-temp-default").val();

            if (!validate(colorGroupEl) || !validate(colorMatchingIdEl)) {
                $("#loading-wrapper").hide();
                return false;
            }

            if ($('#upload-ColorMatching-default')[0].files.length == 0 && tempPhoto == "") {
                $("#loading-wrapper").hide();
                Swal.fire({
                    icon: 'error',
                    title: 'Photo Required',
                    text: 'Please upload Color Matching Photo.'
                });
                return false;
            }

            var detailPayload = {
                DesignColorMatchingDetailsID: $("#ColorMatchingID").val(),
                DesignColorMatchingFormID: $("#DesignNo").val().split("|")[1],
                ColorGroupID: $("#ColorGroup").val(),
                ColorMatchingPhoto: tempPhoto,
                WarpMatchingID: $("#WarpMatchingID").val()
            };

            for (var wa = 0; wa < warpLength; wa++) {
                var sno = wa + 1;
                detailPayload["Warp" + sno] = $("#MatchingWarp" + sno).val();
            }

            detailPayload.FeederMatchingID = $("#FeederMatchingID").val();

            for (var we = 0; we < weftLength; we++) {
                var sno = we + 1;
                detailPayload["Feeder" + sno] = $("#MatchingFeeder" + sno).val();
            }

            var formData = new FormData();
            formData.append('DesignColorMatchingDetails', JSON.stringify(detailPayload));
            if ($('#upload-ColorMatching-default')[0].files.length > 0) {
                formData.append('ColorMatching', $('#upload-ColorMatching-default')[0].files[0]);
            }

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateDesignColorMatchingValidationFormMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    $("#loading-wrapper").hide();
                    if (response.Code == 200) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'Design Entry Created Successfully.',
                            confirmButtonText: 'OK'
                        }).then(() => {
                            getDesignNo(document.getElementById("DesignNo"));
                        });
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.Message
                        });
                    }
                },
                error: function () {
                    $("#loading-wrapper").hide();
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Problem has occurred while submitting your data.'
                    });
                }
            });
        }
    </script>
}