                                        confirmButtonText: 'OK'
                                    }).then(() => {
                                        // Optional
                                        // window.location.href = 'DesignEntry';
                                    });
                                }
                                else {
                                    $("#loading-wrapper").hide();
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: response.Message
                                    });

                                }
                            },
                            error: function (error) {
                                $("#loading-wrapper").hide();
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Oops...',
                                    text: 'Problem has occurred while submitting your data.'
                                });

                            }
                        });




                    }



                }



            }







        }

    </script>
}

