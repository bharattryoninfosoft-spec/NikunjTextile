        function MatchingWarp(abc) {

            var MatchingWarp = "#MatchingWarp" + abc;


            var yarnColors = ArrayYarnColor[0];

            var YarnColorID = $(MatchingWarp).val();
            var yarnColorCode = null;

            $.each(yarnColors, function (index, item) {

                if (item.YarnColorID == YarnColorID) {
                    yarnColorCode = item.YarnColorCode;
                    return false; // break the loop once found
                }

            });

            var tddivColor = "#tddivColor" + abc;
            var yarnColor = "#" + yarnColorCode;

            $(tddivColor).css("background-color", yarnColor);




            var warpLength = $("#warpLength").val();

            var WarpMatchingID = "";
            for (var i = 0; i < warpLength; i++) {
                var SrNo = i + 1;

                var MatchingWarp = "#MatchingWarp" + SrNo;

                if (i == 0) {
                    WarpMatchingID += $(MatchingWarp).find('option:selected').text().replace(/ /g, "") + "/";
                }
                else {

                    var ischeckWarp = "#ischeckWarp" + SrNo;
                    var checkWarpValue = $(ischeckWarp).val();

                    if (checkWarpValue == "1") {
                        WarpMatchingID += $(MatchingWarp).find('option:selected').text().replace(/ /g, "") + "/";
                    }
                }
            }
            $("#WarpMatchingID").val(WarpMatchingID.slice(0, -1));



            var MatchingID = WarpMatchingID.slice(0, -1) + "/" + $("#FeederMatchingID").val();
            for (var j = 0; j < DesignColorMatchingDetails.length; j++) {

                var SrNos = j + 1;
                var ColorMatchingID = $("#ColorMatchingID").val();

                if (DesignColorMatchingDetails[j].DesignColorMatchingDetailsID != ColorMatchingID) {


                    if (DesignColorMatchingDetails[j].MatchingID == MatchingID) {

                        $("#savebtn").hide();
                        $("#spanDuplicate").html("Duplicate Found with Matching " + SrNos + "");
                        return true;
                    }
                    else {
                        $("#savebtn").show();
                        $("#spanDuplicate").html("");
                    }

                }



            }


        }

