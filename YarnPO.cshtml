                    <br />

                    <nav aria-label="Page navigation example">
                        <ul class="pagination justify-content-center" id="divPaggination">
                            <!-- Dynamic Pagination Injected Here -->
                        </ul>
                    </nav>

                </div>
            </div>

        </div>
    </div>
    <!-- Row end -->

</div>

@section Scripts{
    <script>
        // Reusable SweetAlert Toast Configuration
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        var currentPagePermission = {};
        var selectedIds = [];

        $(document).ready(function () {
            FunctionIsLogin();
            displayPagginationData();
            displayData(0);
            getYarnColor();
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: request.statusText || 'Error fetching company details.'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.error(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.error(error);
                }
            });
        }

        function functionSearch() {
            displayPagginationData();
            displayData(0);
        }

        function displayData(rowStartCheck) {
            var rowStart = rowStartCheck;
            var searchdesignNo = $("#SearchRequirementNo").val();

            var formData = new FormData();
            formData.append('SearchRequirementNo', searchdesignNo);
            formData.append('startFrom', rowStart);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnPOMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var $tbody = $("#tblYarnPOList tbody");
                    $tbody.empty();
                    $("#selectAllHeader").prop('checked', false);

                    var temp = "";
                    var srno = parseInt(rowStart) + 1;

                    if (response.listYarnPOMaster && response.listYarnPOMaster.length > 0) {
                        for (var i = 0; i < response.listYarnPOMaster.length; i++) {
                            var item = response.listYarnPOMaster[i];
                            var isChecked = selectedIds.indexOf(item.YarnPOID) !== -1 ? "checked" : "";

                            temp += "<tr>";
                            temp += "<td class='text-center'><input type='checkbox' class='row-checkbox form-check-input' value='" + item.YarnPOID + "' " + isChecked + " /></td>";
                            temp += "<td class='text-center'>" + srno++ + "</td>";
                            temp += "<td class='text-center'><div class='actions'>";

                            if (item.EditableOrNot == "0") {
                                temp += "<a href='javascript:void(0);' class='EditBtn me-2' data-toggle='tooltip' title='Edit' onclick='showEditRecords(" + item.YarnPOID + ")'>" +
                                    "<i class='icon-edit1 text-info'></i></a>";

                                temp += "<a href='javascript:void(0);' class='viewBtn me-2' data-toggle='tooltip' title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + item.YarnPOID + ")'>" +
                                    "<i class='fa fa-eye text-secondary'></i></a>";

                                temp += "<a href='javascript:void(0);' class='DeleteBtn' data-toggle='tooltip' title='Delete' onclick='functionUserDelete(" + item.YarnPOID + ")'>" +
                                    "<i class='icon-x-circle text-danger'></i></a>";
                            } else {
                                temp += "<a href='javascript:void(0);' class='viewBtn' data-toggle='tooltip' title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + item.YarnPOID + ")'>" +
                                    "<i class='fa fa-eye text-secondary'></i></a>";
                            }

                            temp += "</div></td>";
                            temp += "<td>" + (item.PODates || '') + "</td>";
                            temp += "<td>" + (item.PONo || '') + "</td>";
                            temp += "<td>" + (item.SupplierPartyName || '') + "<br/><small class='text-muted'>" + (item.SupplierMobileNo || '') + "</small></td>";
                            temp += "<td>" + (item.BillToPartyName || '') + "<br/><small class='text-muted'>" + (item.BillToMobileNo || '') + "</small></td>";
                            temp += "<td>" + (item.CompanyPartyName || '') + "<br/><small class='text-muted'>" + (item.CompanyMobileNo || '') + "</small></td>";
                            temp += "<td>" + (item.GodownTitle || '') + "<br/><small class='text-muted'>" + (item.GodownAddress || '') + "</small></td>";
                            temp += "<td><i class='fa fa-inr'></i> " + item.TotalAmount.toLocaleString("en-IN") + "/-</td>";
                            temp += "<td>" + (item.DeliveryTime || '') + "</td>";
                            temp += "<td>" + (item.PaymentCondition || '') + "</td>";
                            temp += "</tr>";
                        }
                    } else {
                        temp = "<tr><td colspan='12' class='text-center text-muted'>No records found</td></tr>";
                    }

                    $tbody.html(temp);

                    // Apply permissions
                    var permission = getCookie("PagePermission");
                    if (permission != null && permission != "") {
                        var currentPagePermission = JSON.parse(permission);
                        if (currentPagePermission.Add == false) { $("#AddYarnPOEntry").hide(); }
                        if (currentPagePermission.Edit == false) { $(".EditBtn").hide(); }
                        if (currentPagePermission.Delete == false) { $(".DeleteBtn").hide(); }
                        if (currentPagePermission.view == false) { $(".viewBtn").hide(); }
                    }
                },
                error: function (request, status, error) {
                    console.error("Display Data Error:", error);
                }
            });
        }

        var total = 0;
        var Paggination = 0;

        function displayPagginationData() {
            var searchdesignNo = $("#SearchRequirementNo").val();

            var formData = new FormData();
            formData.append('SearchString', searchdesignNo);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnPOMasterPaggination',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (!response.listPagginationMaster || response.listPagginationMaster.length == 0 || response.listPagginationMaster[0].Paggination == "0") {
                        $('#divPaggination').hide();
                        return;
                    }

                    total = response.listPagginationMaster[0].Total;
                    Paggination = parseInt(response.listPagginationMaster[0].Paggination);

                    var temp = "";
                    var limit = Math.min(Paggination, 10);

                    for (var i = 1; i <= limit; i++) {
                        var activeClass = (i == 1) ? "active" : "";
                        temp += "<li class='page-item " + activeClass + "' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                    }

                    if (Paggination > 10) {
                        temp += "<li class='page-item' id='next'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";
                    }

                    $('#divPaggination').html(temp).show();
                },
                error: function (request, status, error) {
                    console.error("Pagination Error:", error);
                }
            });
        }

        function funcationPaggination(abc) {
            var a = "#a" + abc;
            $('#divPaggination li').removeClass('active');
            $(a).addClass('active');

            $("#rowStartCount").val(((abc - 1) * 30));
            displayData(((abc - 1) * 30));
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Color Matching Form");

            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function showRecords(id) {
            clearAll();
            $("#edit-id").val(id);
            $("#saveViewbtn").hide();
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Yarn PO Form");

            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    ViewRecordQueryString(DecryptID);
                },
                error: function (request, status, error) {
                    console.error("Encrypt ID Error:", error);
                }
            });
        }

        var ArrayYarnColor = [];

        function getYarnColor() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMatching',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    ArrayYarnColor.push(response.listYarnColorMaster);
                },
                error: function (request, status, error) {
                    console.error("Yarn Color Error:", error);
                }
            });
        }

        function ViewRecordQueryString(DecryptID) {
            var formData = new FormData();
            formData.append('YarnPOID', DecryptID);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnPODetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    for (var i = 0; i < response.listYarnPOMaster.length; i++) {
                        $("#PPODate").html("<b>PO Date: </b>" + response.listYarnPOMaster[i].PODates);
                        $("#PPONo").html("<b>PO No: </b>" + response.listYarnPOMaster[i].PONo);

                        $("#divSupplierPartyName").html(response.listYarnPOMaster[i].SupplierPartyName);
                        $("#PSupplierMobileNo").html("<b>Mobile No: </b>" + response.listYarnPOMaster[i].SupplierMobileNo + " / " + response.listYarnPOMaster[i].SupplierAlterMobileNo);
                        $("#PSupplierEmail").html("<b>Email: </b>" + response.listYarnPOMaster[i].SupplierEmail);
                        $("#PSupplierBillingAddress").html("<b>Billing Address: </b>" + response.listYarnPOMaster[i].SupplierBillingAddress);
                        $("#PSupplierState").html("<b>State: </b>" + response.listYarnPOMaster[i].SupplierState);
                        $("#PSupplierGSTIN").html("<b>GSTIn: </b>" + response.listYarnPOMaster[i].SupplierGSTIN);

                        $("#divBillToPartyName").html(response.listYarnPOMaster[i].BillToPartyName);
                        $("#PBillToMobileNo").html("<b>Mobile No: </b>" + response.listYarnPOMaster[i].BillToMobileNo + " / " + response.listYarnPOMaster[i].BillToAlterMobileNo);
                        $("#PBillToEmail").html("<b>Email: </b>" + response.listYarnPOMaster[i].BillToEmail);
                        $("#PBillToBillingAddress").html("<b>Billing Address: </b>" + response.listYarnPOMaster[i].BillToBillingAddress);
                        $("#PBillToState").html("<b>State: </b>" + response.listYarnPOMaster[i].BillToState);
                        $("#PBillToGSTIN").html("<b>GSTIn: </b>" + response.listYarnPOMaster[i].BillToGSTIN);

                        $("#divCompanyPartyName").html(response.listYarnPOMaster[i].CompanyPartyName);
                        $("#PCompanyMobileNo").html("<b>Mobile No: </b>" + response.listYarnPOMaster[i].CompanyMobileNo + " / " + response.listYarnPOMaster[i].CompanyAlterMobileNo);
                        $("#PCompanyEmail").html("<b>Email: </b>" + response.listYarnPOMaster[i].CompanyEmail);
