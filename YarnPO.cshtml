                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <!-- Field wrapper start -->
                            <div class="field-wrapper">
                                <input id="SearchRequirementNo" placeholder="Search Yarn PO No / Party Name." type="text" class="form-control clear-field detail" onkeyup="functionSearch()">
                                <div class="field-placeholder">Search Yarn PO No. / Party Name </div>
                            </div>
                            <!-- Field wrapper end -->
                        </div>
                    </div>

                    <!-- Clean Standard HTML Table -->
                    <div class="table-responsive">
                        <table id="tblYarnPOList" class="table table-hover table-bordered m-0 align-middle">
                            <thead>
                                <tr style="background-color: #1273eb; color: white;">
                                    <th style="width: 3%; text-align: center;">
                                        <input type="checkbox" id="selectAllHeader" class="form-check-input" />
                                    </th>
                                    <th style="width: 4%; text-align: center; color: white;">Sr No</th>
                                    <th style="width: 8%; text-align: center; color: white;">Action</th>
                                    <th style="width: 8%; color: white;">PO <br /> Date</th>
                                    <th style="width: 6%; color: white;">PO <br /> No</th>
                                    <th style="width: 15%; color: white;">Supplier <br /> Name</th>
                                    <th style="width: 15%; color: white;">Bill To <br /> Name</th>
                                    <th style="width: 15%; color: white;">Company <br /> Name</th>
                                    <th style="width: 12%; color: white;">Godown <br /> Details</th>
                                    <th style="width: 8%; color: white;">Total <br /> Amount</th>
                                    <th style="width: 8%; color: white;">Delivery <br /> Time</th>
                                    <th style="width: 8%; color: white;">Payment <br /> Condition</th>
