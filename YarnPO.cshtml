        function showEditRecords(id) {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.location.href = '/UpdateYarnPO?id=' + DecryptID;
                },
                error: function (request, status, error) {
                    console.error("Edit Record Error:", error);
                }
            });
        }

        // SweetAlert2 Delete Confirmation
        function functionUserDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to delete this Yarn PO record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('YarnPOID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteYarnPOMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {
                                Toast.fire({
                                    icon: 'success',
                                    title: 'Yarn PO deleted successfully.'
                                });
                                displayData(0);
                            } else {
                                Toast.fire({
                                    icon: 'error',
                                    title: response.Message || 'Failed to delete record.'
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'A problem occurred while deleting the record.'
                            });
                        }
                    });
                }
            });
        }

        // Checkbox Management
        $(document).on("change", "#selectAllHeader", function () {
            var isChecked = $(this).is(":checked");
            $("#tblYarnPOList tbody .row-checkbox").prop("checked", isChecked).trigger("change");
        });

        $(document).on("change", "#tblYarnPOList tbody .row-checkbox", function () {
            var val = parseInt($(this).val());
            if ($(this).is(":checked")) {
                if (selectedIds.indexOf(val) === -1) {
                    selectedIds.push(val);
                }
            } else {
                var index = selectedIds.indexOf(val);
                if (index !== -1) {
                    selectedIds.splice(index, 1);
                }
                $("#selectAllHeader").prop("checked", false);
            }
        });

        $(document).on("click", "#btnGeneratePDF", function () {
            if (selectedIds.length === 0) {
                Toast.fire({
                    icon: 'warning',
                    title: 'Please select at least one record to generate PDF.'
                });
                return;
            }

            ExportPDF(selectedIds);
        });

        function ExportPDF(ids) {
            $("#btnText").hide();
            $("#btnLoader").show();
            $("#btnGeneratePDF").prop("disabled", true);

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/ExportPDF",
                data: JSON.stringify({ yarnPOIds: ids }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var result = response.d;

                    $("#btnText").show();
                    $("#btnLoader").hide();
                    $("#btnGeneratePDF").prop("disabled", false);

                    if (result && result.FilePath) {
                        window.open(result.FilePath, "_blank");
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'PDF Generation Failed',
                            text: 'Could not generate the requested PDF file.'
                        });
                    }
                },
                error: function (xhr) {
                    $("#btnText").show();
                    $("#btnLoader").hide();
                    $("#btnGeneratePDF").prop("disabled", false);

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An unexpected error occurred while generating the PDF.'
                    });
                }
            });
        }
    </script>
}