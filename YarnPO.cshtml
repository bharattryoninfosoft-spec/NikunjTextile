    function generateYarnPOPDF(ids) {

        $.ajax({
            type: "POST",
            url: "/WebServiceNikunjTextile.asmx/GetYarnPODataForPDF",
            data: JSON.stringify({ yarnPOIds: ids }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {

                var result = response.d;

                console.log("Server Response:", result);

                if (result && result.FilePath) {
                    window.open(result.FilePath, "_blank");
                } else {
                    alert("PDF not generated");
                }
            },
            error: function (err) {
                console.error(err);
                alert("Error generating PDF");
            }
        });
    }
    function ExportPDF(ids) {
        // Show Loader
        $("#btnText").hide();
        $("#btnLoader").show();

        // Disable Button
        $(this).prop("disabled", true);
        $.ajax({
            type: "POST",
            url: "/WebServiceNikunjTextile.asmx/ExportPDF",
            data: JSON.stringify({ yarnPOIds: ids }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var result = response.d;

                console.log("Server Response:", result);

                if (result && result.FilePath) {
                    // Hide Loader
                    $("#btnText").show();
                    $("#btnLoader").hide();
                    // Enable Button
                    $("#btnGeneratePDF").prop("disabled", false);
                    window.open(result.FilePath, "_blank");
                 
                } else {
                    alert("PDF not generated");
                    // Hide Loader
                    $("#btnText").show();
                    $("#btnLoader").hide();

                    // Enable Button
                    $("#btnGeneratePDF").prop("disabled", false);
                }
                //var blob = new Blob([response], { type: 'application/pdf' });
                //var link = document.createElement('a');
                //link.href = window.URL.createObjectURL(blob);
                //link.download = "YarnPO.pdf";
                //link.click();
            },
            error: function (xhr) {

                console.log(xhr);

                alert("PDF Generate Error");
            }
        });
    }
