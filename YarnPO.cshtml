<script>

    var currentPagePermission = {};
    $(document).ready(function () {
        var permission = sessionStorage.getItem("PagePermission");
        if (permission != null) {
            currentPagePermission = JSON.parse(permission);
            console.log("currentPagePermission", currentPagePermission);
            if (currentPagePermission.Add == false) {
                $("#AddYarnPOEntry").hide();
            }
        }

        FunctionIsLogin();
        displayPagginationData();
        displayData(0);
        getYarnColor();
        //getDefaultCompany();


    });
    
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });


    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });






    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }

    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }




    function functionSearch() {
        displayPagginationData();
        displayData(0);
    }

    function displayData(rowStartCheck) {

        var rowStart = rowStartCheck;
        var searchdesignNo = $("#SearchRequirementNo").val();

        var formData = new FormData();
        formData.append('SearchRequirementNo', searchdesignNo);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnPOMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";

                var srno = parseInt(rowStart) + parseInt(1);
                for (var i = 0; i < response.listYarnPOMaster.length; i++) {

                    temp += "<tr>";
                    temp += "<td>";
                    temp += "<input id='selectAll' type='checkbox' class='row-checkbox me-2' value='" + response.listYarnPOMaster[i].YarnPOID + "' /> ";
                    temp += srno++;
                    temp += "</td>";
                    //temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnPOMaster[i].YarnPOID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnPOMaster[i].DesignColorMatchingFormID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listYarnPOMaster[i].DesignColorMatchingFormID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "<td><div class='actions'>";

                    // ======================================
                    // EDIT & DELETE ONLY WHEN EditableOrNot = 0
                    // ======================================

                    if (response.listYarnPOMaster[i].EditableOrNot == "0") {

                        // EDIT
                        if (currentPagePermission.Edit == true || currentPagePermission.Edit == "true") {

                            temp += "<a href='javascript:void(0);' " +
                                "data-toggle='tooltip' " +
                                "data-placement='top' " +
                                "title='Edit' " +
                                "onclick='showEditRecords(" + response.listYarnPOMaster[i].YarnPOID + ")'>" +
                                "<i class='icon-edit1 text-info'></i>" +
                                "</a>&nbsp;&nbsp;&nbsp;";
                        }

                        // VIEW
                        if (currentPagePermission.View == true || currentPagePermission.View == "true") {

                            temp += "<a href='javascript:void(0);' " +
                                "data-toggle='tooltip' " +
                                "data-placement='top' " +
                                "title='Details' " +
                                "data-bs-toggle='modal' " +
                                "data-bs-target='#addNewContact' " +
                                "onclick='showRecords(" + response.listYarnPOMaster[i].YarnPOID + ")'>" +
                                "<i class='fa fa-eye text-secondary'></i>" +
                                "</a>&nbsp;&nbsp;&nbsp;";
                        }

                        // DELETE
                        if (currentPagePermission.Delete == true || currentPagePermission.Delete == "true") {

                            temp += "<a href='javascript:void(0);' " +
                                "data-toggle='tooltip' " +
                                "data-placement='top' " +
                                "title='Delete' " +
                                "onclick='functionUserDelete(" + response.listYarnPOMaster[i].YarnPOID + ")'>" +
                                "<i class='icon-x-circle text-danger'></i>" +
                                "</a>";
                        }
                    }
                    else {

                        // VIEW ONLY
                        if (currentPagePermission.View == true || currentPagePermission.View == "true") {

                            temp += "<a href='javascript:void(0);' " +
                                "data-toggle='tooltip' " +
                                "data-placement='top' " +
                                "title='Details' " +
                                "data-bs-toggle='modal' " +
                                "data-bs-target='#addNewContact' " +
                                "onclick='showRecords(" + response.listYarnPOMaster[i].YarnPOID + ")'>" +
                                "<i class='fa fa-eye text-secondary'></i>" +
                                "</a>&nbsp;&nbsp;&nbsp;";
                        }
                    }

                    temp += "</div></td>";
                    //temp += "<td>" + response.listYarnPOMaster[i].DateandTimes + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].PODates + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].PONo + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].SupplierPartyName + " <br />" + response.listYarnPOMaster[i].SupplierMobileNo + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].BillToPartyName + " <br />" + response.listYarnPOMaster[i].BillToMobileNo + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].CompanyPartyName + " <br />" + response.listYarnPOMaster[i].CompanyMobileNo + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].GodownTitle + " <br />" + response.listYarnPOMaster[i].GodownAddress + "</td>";
                    temp += "<td><i class='fa fa-inr'></i> &nbsp;" + response.listYarnPOMaster[i].TotalAmount.toLocaleString("en-IN") + "/-</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].DeliveryTime + "</td>";
                    temp += "<td>" + response.listYarnPOMaster[i].PaymentCondition + "</td>";
                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }






    var total = 0;
    var Paggination = 0;
    var prevNo = 0;
    var nextNo = 0;
    var SelectNo = 1;
    var PageNo = 0;

    //Display Paggination
    function displayPagginationData() {

        var searchdesignNo = $("#SearchRequirementNo").val();

        var formData = new FormData();
        formData.append('SearchString', searchdesignNo);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnPOMasterPaggination',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                //console.log(response);

                //var userTable = $('#DDLDistrict');
                //listPagginationMaster
                total = response.listPagginationMaster[0].Total;
                Paggination = response.listPagginationMaster[0].Paggination + 1;
                prevNo = 0;
                nextNo = 10;
                //alert(response.listPagginationMaster[0].Paggination);
                if (response.listPagginationMaster[0].Paggination == "0") {
                    $('#divPaggination').hide();
                }
                else {


                    if (parseInt(response.listPagginationMaster[0].Paggination) <= parseInt(10)) {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= parseInt(response.listPagginationMaster[0].Paggination); i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                        }
                        $('#divPaggination').html(temp).show();
                    }
