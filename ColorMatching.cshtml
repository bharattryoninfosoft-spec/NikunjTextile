        function functionUserDelete(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to recover this record!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, Delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {

                if (result.isConfirmed) {

                    var formData = new FormData();
                    formData.append("DesignColorMatchingFormID", id);

                    $.ajax({
                        type: "POST",
                        url: "/WebServiceNikunjTextile.asmx/DeleteDesignColorMatchingFormMaster",
                        data: formData,
                        dataType: "json",
                        contentType: false,
                        processData: false,
                        success: function (response) {

                            if (response.Code == 200) {

                                Swal.fire({
                                    icon: "success",
                                    title: "Deleted!",
                                    text: "Color Matching Form deleted successfully.",
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    displayData(0);
                                });

                            } else {

                                Swal.fire({
                                    icon: "error",
                                    title: "Delete Failed",
                                    text: response.Message || "Problem occurred while deleting the Color Matching Form."
                                });

                            }
                        },
                        error: function (request, status, error) {

                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: "Something went wrong while deleting the record.",
                                footer: request.status + " - " + (error || request.statusText)
                            });

                        }
                    });

                }

            });

        }
