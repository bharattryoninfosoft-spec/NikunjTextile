<script>

    $(document).ready(function () {


        $('.active, .show, .current-page').removeClass('active show current-page');

        $("#EntryForm-tab").addClass("active");
        $("#tab-EntryForm").addClass("show active");
        $("#aColorMatching").addClass("current-page");

        FunctionIsLogin();

        displayPagginationData();
        displayData(0);
        getYarnColor();
        //getDefaultCompany();



    });

    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function functionSearch() {
        displayPagginationData();
        displayData(0);
    }
    function displayData(rowStartCheck) {

        var rowStart = rowStartCheck;
        var searchdesignNo = $("#search-design-no").val();

        var formData = new FormData();
        formData.append('SearchDesignNo', searchdesignNo);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getColorMatchingFormMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";

                var srno = parseInt(rowStart) + parseInt(1);
                for (var i = 0; i < response.listDesignColorMatchingForm.length; i++) {

                    temp += "<tr><td>" + srno++ + "</td>";
                    //temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listDesignColorMatchingForm[i].DesignColorMatchingFormID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listDesignColorMatchingForm[i].DesignColorMatchingFormID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listDesignColorMatchingForm[i].DesignColorMatchingFormID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "<td><div class='actions'>";
                    temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listDesignColorMatchingForm[i].DesignColorMatchingFormID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;";
                    temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listDesignColorMatchingForm[i].DesignColorMatchingFormID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;";
                    temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listDesignColorMatchingForm[i].DesignColorMatchingFormID + ")'><i class='icon-x-circle text-danger'></i></a>";
                    temp += "</div></td>";
                    temp += "<td>" + response.listDesignColorMatchingForm[i].DateandTimes + "</td>";
                    temp += "<td>" + response.listDesignColorMatchingForm[i].DesignerCode + response.listDesignColorMatchingForm[i].DesignNo + "</td>";
                    temp += "<td><img src='" + response.listDesignColorMatchingForm[i].PhotoOfDesign + "' style='width:50px; height:50px;'></td>";

                    //temp += "<td>" + response.listDesignColorMatchingForm[i].PickOnLoom + "</td>";
                    //temp += "<td>" + response.listDesignColorMatchingForm[i].TotalCard + "</td>";
                    //temp += "<td>" + response.listDesignColorMatchingForm[i].WarpQuality + "</td>";


                    var MatchingId = "";
                    var WarpMatchingID = "";
                    var FeederMatchingID = "";
                    for (var j = 0; j < response.listDesignColorMatchingForm[i].MatchingID.split(',').length; j++) {
                        var SrNos = j + 1;
                        MatchingId += "<b>" + SrNos + ":</b> " + response.listDesignColorMatchingForm[i].WarpMatchingID.split(',')[j] + " <b>-</b> " + response.listDesignColorMatchingForm[i].FeederMatchingID.split(',')[j] + "<br />";
                        WarpMatchingID += "<b>" + SrNos + ":</b> " + response.listDesignColorMatchingForm[i].WarpMatchingID.split(',')[j] + "<br />";
                        FeederMatchingID += "<b>" + SrNos + ":</b> " + response.listDesignColorMatchingForm[i].FeederMatchingID.split(',')[j] + "<br />";
                    }



                    temp += "<td>" + MatchingId + "</td>";
                    temp += "<td>" + WarpMatchingID + "</td>";
                    temp += "<td>" + FeederMatchingID + "</td>";


                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }
    var total = 0;
    var Paggination = 0;
    var prevNo = 0;
    var nextNo = 0;
    var SelectNo = 1;
    var PageNo = 0;

    //Display Paggination
    function displayPagginationData() {

        var searchdesignNo = $("#search-design-no").val();

        var formData = new FormData();
        formData.append('SearchString', searchdesignNo);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getColorMatchingFormPaggination',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                //console.log(response);

                //var userTable = $('#DDLDistrict');
                //listPagginationMaster
                total = response.listPagginationMaster[0].Total;
                Paggination = response.listPagginationMaster[0].Paggination + 1;
                prevNo = 0;
                nextNo = 10;
                //alert(response.listPagginationMaster[0].Paggination);
                if (response.listPagginationMaster[0].Paggination == "0") {
                    $('#divPaggination').hide();
                }
                else {


                    if (parseInt(response.listPagginationMaster[0].Paggination) <= parseInt(10)) {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= parseInt(response.listPagginationMaster[0].Paggination); i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                        }
                        $('#divPaggination').html(temp).show();
                    }
                    else {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= 10; i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }

                        }
                        //temp += "<a href='javascript:void(0);' id='next' onclick='funcationPagginationNext()'>&raquo;</a>";
                        temp += "<li class='page-item' id='next'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";

                        $('#divPaggination').html(temp).show();
                    }

                }


            },
            error: function (request, status, error) {
                //console.log(error);
                //console.log("error" + request.statusText);
                //alert(request.statusText);
            }
        });
    }
    //Select Paggination
    function funcationPaggination(abc) {
        //alert(abc);
        $("#trLoading").show();
        var a = "#a" + abc;
        SelectNo = abc;
        //alert(a);
        $('li').removeClass('active');
        //$("#a3").addClass("active");
        $(a).addClass('active');

        $("#rowStartCount").val(((abc - 1) * 30));
        displayData(((abc - 1) * 30));

        //$("#rowStartCount").val(((abc - 1) * 2));
        //displayData(((abc - 1) * 2));

    }
