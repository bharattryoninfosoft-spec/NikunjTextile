    function functionUserDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            var formData = new FormData();
            formData.append('DesignColorMatchingFormID', id);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/DeleteDesignColorMatchingFormMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200) {

                        notes.show("Color Matching Form deleted successfully.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                        displayData(0);
                    }
                    else {
                        //alert("Problem has been occurred while submitting your data.");

                        notes.show("Problem has been occurred while deleting Design Entry Form .", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                    }
                },
                error: function (error) {
                    // alert("Problem has been occurred while submitting your data.");

                    notes.show("Problem has been occurred while deleting Design Entry Form.", {
                        type: 'danger',
