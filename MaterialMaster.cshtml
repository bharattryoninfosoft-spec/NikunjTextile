@{
    Layout = "/_LayoutPage1.cshtml";
}



<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <button id="AddFinacialYearModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Material</button>
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Material</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />

                        <div class="row gutters">
                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">
                                    <div class="col-6">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input type="text" id="Material" name="Material" class="form-control clear-field" onfocusout="validate(this)">
                                            <div class="field-placeholder">Material<sup style="color:red;">*</sup></div>
                                            <div class="Material-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="Material-invalid-feedback invalid-feedback">Please Mention Material</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>



                                    <div class="col-6">

                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <div class="form-check form-check-inline">
                                                <br />
                                                <input id="IsActive" class="form-check-input" type="checkbox" value="1" checked>
                                                <label class="form-check-label" for="IsActive-default">Is Active</label>

                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>




                                </div>
                            </div>
                        </div>

                    </div>
                    <input id="edit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">
                        <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Material</div>
                    <br />

                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr>
                                    <th>Sr No</th>
                                    <th>Material</th>
                                    <th>Is Active</th>
                                    <!--<th>Position</th>-->
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>
<!-- Content wrapper end -->
@section Scripts{
    <script>
        var currentPagePermission = {};
        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                var currentPagePermission = JSON.parse(permission);
                if (currentPagePermission.Add == false) {
                    $("#AddFinacialYearModel").hide();
                }
            }

            $('.active, .show, .current-page').removeClass('active show current-page');

            $("#master-tab").addClass("active");
            $("#tab-Master").addClass("show active");
            $("#aMaterial").addClass("current-page");

            FunctionIsLogin();
            displayData(0);
        });

        // Helper function for SweetAlert2 toast notifications
        function showToast(type, msg) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: msg,
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true
            });
        }

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    showToast('error', request.statusText || 'Failed to fetch default company.');
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    console.log(data);
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            }
            else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getMaterialMaster?startFrom=' + rowStart,
                data: "{ 'startFrom':'" + rowStart + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    console.log(response);

                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").empty();
                    }
                    var dataTable = $('#copy-print-csv');
                    var temp = "";
                    if (response.listMaterialMaster.length < 10) {
                        $("#view-more-btn").hide();
                    }
                    else {
                        $("#view-more-btn").show();
                    }

                    var SrNo = 1;
                    for (var i = 0; i < response.listMaterialMaster.length; i++) {
                        var Top = i - 1;
                        var Previous = i + 1;

                        var ActionPosition = "";
                        if (response.listMaterialMaster.length != 1) {
                            if (i == 0) {
                                var PostDown = response.listMaterialMaster[i].MaterialID + "," + response.listMaterialMaster[i].Position + "|" + response.listMaterialMaster[Previous].MaterialID + "," + response.listMaterialMaster[Previous].Position;
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listMaterialMaster[i].MaterialID + "' value = '" + PostDown + "' /> ";
                                ActionPosition += "<span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listMaterialMaster[i].MaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }
                            else if (i == parseInt(response.listMaterialMaster.length - 1)) {
                                var PostUp = response.listMaterialMaster[i].MaterialID + "," + response.listMaterialMaster[i].Position + "|" + response.listMaterialMaster[Top].MaterialID + "," + response.listMaterialMaster[Top].Position;
                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listMaterialMaster[i].MaterialID + "' value = '" + PostUp + "' /> </span>";
                                ActionPosition += "<span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listMaterialMaster[i].MaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'></td>";
                            }
                            else {
                                var PostUp = response.listMaterialMaster[i].MaterialID + "," + response.listMaterialMaster[i].Position + "|" + response.listMaterialMaster[Top].MaterialID + "," + response.listMaterialMaster[Top].Position;
                                var PostDown = response.listMaterialMaster[i].MaterialID + "," + response.listMaterialMaster[i].Position + "|" + response.listMaterialMaster[Previous].MaterialID + "," + response.listMaterialMaster[Previous].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listMaterialMaster[i].MaterialID + "' value = '" + PostUp + "' /><span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listMaterialMaster[i].MaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span>";
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listMaterialMaster[i].MaterialID + "' value = '" + PostDown + "' /><span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listMaterialMaster[i].MaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }
                        }

                        temp += "<tr>";
                        temp += "<td>" + SrNo++ + "</td>";
                        temp += "<td>" + response.listMaterialMaster[i].Material + "</td>";

                        if (response.listMaterialMaster[i].IsActive == "1") {
                            temp += "<td><span class='badge bg-success'>Active</span></td>";
                        }
                        else {
                            temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                        }

                        temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listMaterialMaster[i].MaterialID + ")'><i class='icon-edit1 text-info'></i></a> &nbsp;&nbsp; <a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listMaterialMaster[i].MaterialID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                        temp += "</tr>";
                    }

                    dataTable.append(temp);
                },
                error: function (request, status, error) {
                }
            });
        }

        //Delete Material
        function functionFYDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this Financial Year record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                displayData(0);
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Financial Year deleted successfully.',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: 'Problem has been occurred while deleting Financial Year.'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Problem has been occurred while deleting Financial Year.'
                            });
                        }
                    });
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Material");
            $("#add-alert").hide();

            $("#Material").val('');
            $(".company-invalid-feedback").hide();

            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function checkSaveView() {
            var IsActive = "0";
            if ($("#IsActive").is(':checked')) {
                IsActive = "1";
            }

            var Material = $('#Material').val();

            if (validate(document.getElementById('Material')) == false) {
                validate(document.getElementById('Material'));
            }
            else {
                var formData = new FormData();
                formData.append('Material', Material);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertMaterialMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            showToast('success', response.Message);
                            displayData(0);
                            $("#cancelbtn").click();
                        }
                        else {
                            showToast('error', response.Message);
                        }
                    },
                    error: function (error) {
                        showToast('error', 'An error occurred while submitting your data.');
                    }
                });
            }
        }

        function checkSave() {
            var IsActive = "0";
            if ($("#IsActive").is(':checked')) {
                IsActive = "1";
            }

            var Material = $('#Material').val();

            if (validate(document.getElementById('Material')) == false) {
                validate(document.getElementById('Material'));
            }
            else {
                var formData = new FormData();
                formData.append('Material', Material);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertMaterialMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            showToast('success', response.Message);
                            displayData(0);
                        }
                        else {
                            showToast('error', response.Message);
                        }
                    },
                    error: function (error) {
                        showToast('error', 'An error occurred while submitting your data.');
                    }
                });
            }
        }

        function checkEdit() {
            var id = $("#edit-id").val();
            var IsActive = "0";
            if ($("#IsActive").is(':checked')) {
                IsActive = "1";
            }

            var Material = $('#Material').val();

            if (validate(document.getElementById('Material')) == false) {
                validate(document.getElementById('Material'));
            }
            else {
                var formData = new FormData();
                formData.append('MaterialID', id);
                formData.append('Material', Material);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/EditMaterialMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            $('#Material').val('');
                            showToast('success', response.Message);
                            displayData(0);
                            $("#cancelbtn").click();
                        }
                        else {
                            showToast('error', response.Message);
                        }
                    },
                    error: function (error) {
                        showToast('error', 'An error occurred while updating your data.');
                    }
                });
            }
        }

        function showRecords(id) {
            clearAll();
            $("#edit-id").val(id);
            $("#saveViewbtn").hide();
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Edit Material");

            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getMaterialMasterById?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#Material").val(response.listMaterialMaster[0].Material);

                        if (response.listMaterialMaster[0].IsActive == "1") {
                            $("#IsActive").prop('checked', true);
                        }
                        else {
                            $("#IsActive").prop('checked', false);
                        }
                    }
                    else {
                        showToast('error', response.Message);
                    }
                },
                error: function (request, status, error) {
                    showToast('error', 'Failed to retrieve record details.');
                }
            });
        }

        function functionYarnDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this Material record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('MaterialID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteMaterialMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Material deleted successfully.',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                displayData(0);
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: 'Problem has been occurred while deleting Material.'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Problem has been occurred while deleting Material.'
                            });
                        }
                    });
                }
            });
        }

        function onPostUp(QueueNo) {
            var down = $("#PostUp_" + QueueNo + "").val();
            var formData = new FormData();
            formData.append('PostQueue', down);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateTbl_MaterialQueue',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 1) {
                        displayData($("#rowStartCount").val());
                    }
                    else {
                        showToast('error', 'Problem has been occurred while retrieving your data.');
                    }
                },
                error: function (error) {
                    showToast('error', 'Problem has been occurred while retrieving your data.');
                }
            });
        }

        function onPostDown(QueueNo) {
            var down = $("#PostDown_" + QueueNo + "").val();
            var formData = new FormData();
            formData.append('PostQueue', down);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateTbl_MaterialQueue',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 1) {
                        displayData($("#rowStartCount").val());
                    }
                    else {
                        showToast('error', 'Problem has been occurred while retrieving your data.');
                    }
                },
                error: function (error) {
                    showToast('error', 'Problem has been occurred while retrieving your data.');
                }
            });
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "") {
                if (code.id == "name") {
                    $(".company-invalid-feedback").show();
                }
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else if ((code.id == "igst" || code.id == "gst" || code.id == "cess") && code.value[code.value.length - 1] == ".") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }
    </script>
}

