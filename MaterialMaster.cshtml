        //Delete Material
        function functionFYDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this Financial Year record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                displayData(0);
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Financial Year deleted successfully.',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: 'Problem has been occurred while deleting Financial Year.'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Problem has been occurred while deleting Financial Year.'
                            });
                        }
                    });
                }
            });
        }

