    function bindBrokerDropdown() {
        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/GetBrokerList',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (response) {
                let data = JSON.parse(response.d);
                console.log("GetBrokerList", data);
                $("#BrokerModel").empty().append('<option value="-1">Select</option>');
                $("#ddlBroker").empty().append('<option value="-1">Select</option>');
                $.each(data, function (i, item) {
                    $("#BrokerModel").append(`
               <option value="${item.BrokerCode}">
                   ${item.BrokerCode} - ${item.BrokerName}
               </option>
           `);
                });
                $.each(data, function (i, item) {
                    $("#ddlBroker").append(`
                    <option value="${item.BrokerCode}">
                        ${item.BrokerCode} - ${item.BrokerName}
                    </option>
                `);
                });
            },
