        function OnSupplierParty(abc) {
            var partyId = parseInt(abc);
            var PartyDetail = ListPartyArray.find(item => parseInt(item.PartyId) === partyId);
            if (PartyDetail) {
                $("#SupplierGST").val(PartyDetail.GSTIN);
                $("#SupplierAddress").val(PartyDetail.BillingAddress);
                $("#SupplierPhone").val(PartyDetail.MobileNo);

                if ($("#chcekSupplierDetails").is(':checked')) {
                    $("#ddlBillTo").prop("disabled", true).val(partyId).trigger('change');
                    $("#BillToGST").val(PartyDetail.GSTIN);
                    $("#BillToAddress").val(PartyDetail.BillingAddress);
                }
            }
        }

        function OnBillToParty(abc) {
            var PartyDetail = ListPartyArray.find(item => parseInt(item.PartyId) === parseInt(abc));
            if (PartyDetail) {
                $("#BillToGST").val(PartyDetail.GSTIN);
                $("#BillToAddress").val(PartyDetail.BillingAddress);
            }
        }

        function OnCompanyParty(abc) {
            var PartyDetail = ListPartyArray.find(item => parseInt(item.PartyId) === parseInt(abc));
            if (PartyDetail) {
                $("#CompanyGST").val(PartyDetail.GSTIN);
                $("#CompanyAddress").val(PartyDetail.BillingAddress);
            }
        }

        function OnChangeGown(abc) {
            var GoDownDetail = ListGodownArray.find(item => item.GodownID === parseInt(abc));
            if (GoDownDetail) {
                $("#GodownAddress").val(GoDownDetail.GodownAddress);
            }
        }

        function toggleSupplierDetails() {
            if ($("#chcekSupplierDetails").is(':checked')) {
                var supplierVal = $("#ddlSupplier").val();
                if (!supplierVal || supplierVal == "0") {
                    Toast.fire({ icon: "warning", title: "Please Select Supplier." });
                    $("#chcekSupplierDetails").prop("checked", false);
                } else {
                    $("#ddlCompany").prop("disabled", true).val(supplierVal).trigger('change');
                    $("#CompanyGST").val($("#SupplierGST").val());
                    $("#CompanyAddress").val($("#SupplierAddress").val());
                }
            } else {
                $('#ddlCompany').removeAttr('disabled');
            }
        }

        function toggleShippingAddress() {
            if ($("#checkAddress").prop("checked")) {
                $("#shippingAddress").attr("disabled", true).val($("#billingAddress").val());
            } else {
                $("#shippingAddress").attr("disabled", false);
            }
        }

        function checkShippingAdd() {
            if ($("#checkAddress").prop("checked")) {
                $("#shippingAddress").val($("#billingAddress").val());
            }
        }

        function saveparty() {
            var name = document.getElementById('party-name');
            var phone = document.getElementById('phone');
            if (!validate(name) || !validate(phone)) return;

            var formData = new FormData();
            formData.append('PartyName', name.value);
            formData.append('MobileNo', phone.value);
            formData.append('AlterMobileNo', $('#alt-phone').val() || '0');
            formData.append('Email', $('#email').val());
            formData.append('BillingAddress', $('#billingAddress').val());
            formData.append('ShippingAddress', $('#shippingAddress').val());
            formData.append('IsSameAddress', $("#checkAddress").is(':checked') ? "1" : "0");
            formData.append('GSTIN', $('#gstin').val());
            formData.append('State', $("#placeOfSupply option:selected").text());
            formData.append('PanNo', $('#PanNo').val());
            formData.append('Pincode', $('#pincode').val());
            formData.append('city', $('#city').val());
            formData.append('BankHolderName', $('#BankHolderName').val());
            formData.append('BankAccountNo', $('#BankAccountNo').val());
            formData.append('BankIFSCCode', $('#BankIFSCCode').val());
            formData.append('BankName', $('#BankName').val());
            formData.append('BankBranch', $('#BankBranch').val());
            formData.append('IsActiveParty', $("#checkIsActiveParty").is(':checked') ? "1" : "0");
            formData.append('SundryParty', $('#SundryParty').val());
            formData.append('BrokerCode', $("#Broker").val());

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertPartyMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 201) {
                        $("#addNewContact").modal("hide");
                        getPartyDetail();
                        setTimeout(function () {
                            var partyId = parseInt(response.id);
                            if (!CompanyAddParty) {
                                $("#ddlSupplier").val(partyId).trigger('change');
                                OnSupplierParty(partyId);
                            } else {
                                $("#ddlBillTo").val(partyId).trigger('change');
                                OnBillToParty(partyId);
                            }
                        }, 300);
                        Toast.fire({ icon: 'success', title: response.Message || 'Party saved successfully!' });
                    } else {
                        Toast.fire({ icon: 'error', title: response.Message || 'Failed to save party.' });
                    }
                }
            });
        }

        function myFunctionIFSC(abc) {
            var code = abc.value.trim().toUpperCase();
            if (!code || code.length !== 11) {
                setInvalid(abc); clearBankFields(); return;
            }
            $.ajax({
                type: "GET",
                url: "https://ifsc.razorpay.com/" + code,
                success: function (response) {
                    if (response && response.BANK) {
                        $("#BankName").val(response.BANK);
                        $("#BankBranch").val(response.BRANCH);
                        setValid(abc);
                    } else {
                        setInvalid(abc); clearBankFields();
                    }
                },
                error: function () { setInvalid(abc); clearBankFields(); }
            });
        }

        function setValid(el) { el.classList.add("is-valid"); el.classList.remove("is-invalid"); }
        function setInvalid(el) { el.classList.remove("is-valid"); el.classList.add("is-invalid"); }
        function clearBankFields() { $("#BankName, #BankBranch").val(''); }

        function myFunctionPINCODE(abc) {
            var code = abc.value;
            if (code.length == 6) {
                $.ajax({
                    type: "GET",
                    url: "https://api.postalpincode.in/pincode/" + code,
                    success: function (response) {
                        if (response && response[0].PostOffice) {
                            $("#city").val(response[0].PostOffice[0].District);
                            setValid(abc);
                        } else { setInvalid(abc); $("#city").val(''); }
                    },
                    error: function () { setInvalid(abc); $("#city").val(''); }
                });
            }
        }
    </script>
