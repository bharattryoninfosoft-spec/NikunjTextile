        function validateGstinInput(el) {
            var val = el.value;
            var $el = $(el);
            if (val.length === 15) {
                var gstVal = val.toUpperCase();
                var pattern = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;
                if (pattern.test(gstVal)) {
                    $el.addClass("is-valid").removeClass("is-invalid");
                    $('#PanNo').val(gstVal.substring(2, 12));
                    fetchGstDetails(gstVal);
                    return true;
                } else {
                    $el.addClass("is-invalid").removeClass("is-valid");
                    return false;
                }
            } else {
                $el.removeClass("is-valid is-invalid");
                return false;
            }
        }

