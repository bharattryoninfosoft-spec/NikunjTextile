    function ArrayTotalCalculation() {
        var txtColorArray = $("#txtYarnDetailsArray").val();
        var txtColorData = txtColorArray.slice(0, -1).split('|');

        var TotalQty = 0;
        var TotalRate = 0;
        var TotalAmount = 0;

        for (var j = 0; j < txtColorData.length; j++) {

            var Qty = "#Qty" + txtColorData[j];
            var QtyVal = $(Qty).val();

            var Rate = "#Rate" + txtColorData[j];
            var RateVal = $(Rate).val();

            var Amount = "#Amount" + txtColorData[j];
