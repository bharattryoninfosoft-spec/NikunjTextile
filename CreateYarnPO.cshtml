                console.log(err);
            }
        });
    }
    function getStates(GSTStateCode) {
        //alert(GSTStateCode);
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getStates',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                var jsonData = JSON.parse(data.d);
                $("#placeOfSupply option[value]").each(function () {
                    $(this).remove();
                });
                $('#placeOfSupply').empty();
                appendTemp = "<option value='0'>Select Place Of Supply</option >";
                $('#placeOfSupply').append(appendTemp);

                if (GSTStateCode == "0") {

                    for (var i = 0; i < jsonData.length; i++) {
                        admin = jsonData[i];

                        appendTemp = "<option value=" + admin.GSTStateCode + ">" + admin.GSTStateCode + "-" + admin.StateTitle + "</option >";
                        $('#placeOfSupply').append(appendTemp);
                    }
                }
                else {
                    for (var i = 0; i < jsonData.length; i++) {
                        admin = jsonData[i];
                        if (admin.GSTStateCode == GSTStateCode) {
                            appendTemp = "<option value=" + admin.GSTStateCode + " selected>" + admin.GSTStateCode + "-" + admin.StateTitle + "</option >";
                        }
                        else {
                            appendTemp = "<option value=" + admin.GSTStateCode + ">" + admin.GSTStateCode + "-" + admin.StateTitle + "</option >";
                        }


                        $('#placeOfSupply').append(appendTemp);
                    }
                }
                //$('#placeOfSupply').append("<option value=''> -- Select State -- </option>");
            },
            error: function (request, status, error) {
            }
        });
    }
