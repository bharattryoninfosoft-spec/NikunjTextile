        function renderAddedTable() {
            var $tbody = $("#tableAddedItems");
            $tbody.empty();

            if (addedItemsArray.length === 0) {
                $tbody.append('<tr><td colspan="8" class="text-center text-muted py-4">No items added yet. Use the fields above to add an item.</td></tr>');
                $("#TotalQty, #TotalRate").text("0");
                $("#TotalAmount").text("0.00");
                return;
            }

            var totalQty = 0, totalRate = 0, totalAmount = 0;
            $.each(addedItemsArray, function (i, item) {
                totalQty += item.Qty;
                totalRate += item.Rate;
                totalAmount += item.Amount;

                var tr = `
                        <tr id="addedRow_${item.RowId}">
                            <td class="text-center">${item.YarnMaterialName}</td>
                            <td>
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <div style="width:18px; height:18px; border-radius:3px; background-color:${item.YarnColorBg}; border:1px solid #ccc;"></div>
                                    <span>${item.YarnColorName}</span>
                                </div>
                            </td>
                            <td class="text-center">${item.CompanyCode || '-'}</td>
                            <td class="text-center fw-bold">${item.Qty.toLocaleString("en-IN")}</td>
                            <td class="text-center">${item.Rate.toLocaleString("en-IN")}</td>
                            <td class="text-center text-primary fw-bold">${item.GSTSLABName}</td>
                            <td class="text-center fw-bold">${item.Amount.toLocaleString("en-IN", { minimumFractionDigits: 2 })}</td>
                            <td class="text-center">
                                <i class="fa fa-pencil text-info me-2" style="cursor:pointer;" onclick="editAddedRow(${item.RowId})" title="Edit"></i>
                                <i class="fa fa-trash text-danger" style="cursor:pointer;" onclick="removeAddedRow(${item.RowId})" title="Remove"></i>
                            </td>
                        </tr>
                    `;
                $tbody.append(tr);
            });

            $("#TotalQty").text(totalQty.toLocaleString("en-IN"));
            $("#TotalRate").text(totalRate.toLocaleString("en-IN"));
            $("#TotalAmount").text(totalAmount.toLocaleString("en-IN", { minimumFractionDigits: 2 }));
        }

