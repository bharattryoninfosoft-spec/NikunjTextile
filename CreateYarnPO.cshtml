        function getPartyDetail() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getPartyDetails',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        ListPartyArray = response.listPartyMaster;
                        if (response.listPartyMaster.length > 0) {
                            $('#ddlSupplier, #ddlBillTo, #ddlCompany').empty();
                            $('#ddlSupplier').append("<option value='0'> Select Vendor </option>");
                            $('#ddlCompany').append("<option value='0'> Select Company </option>");
                            $('#ddlBillTo').append("<option value='0'> Select Bill To Name</option>");

                            $.each(response.listPartyMaster, function (i, item) {
                                var opt = `<option value='${item.PartyId}'>${item.PartyName}</option>`;
                                $('#ddlSupplier, #ddlBillTo, #ddlCompany').append(opt);
                            });
                        }
                    }
                }
            });
        }

