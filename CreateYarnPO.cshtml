        function myFunctionIFSC(abc) {
            var code = abc.value.trim().toUpperCase();
            if (!code || code.length !== 11) {
                setInvalid(abc); clearBankFields(); return;
            }
            $.ajax({
                type: "GET",
                url: "https://ifsc.razorpay.com/" + code,
                success: function (response) {
                    if (response && response.BANK) {
                        $("#BankName").val(response.BANK);
                        $("#BankBranch").val(response.BRANCH);
                        setValid(abc);
                    } else {
                        setInvalid(abc); clearBankFields();
                    }
                },
                error: function () { setInvalid(abc); clearBankFields(); }
            });
        }

        function setValid(el) { el.classList.add("is-valid"); el.classList.remove("is-invalid"); }
        function setInvalid(el) { el.classList.remove("is-valid"); el.classList.add("is-invalid"); }
        function clearBankFields() { $("#BankName, #BankBranch").val(''); }

        function myFunctionPINCODE(abc) {
            var code = abc.value;
            if (code.length == 6) {
                $.ajax({
                    type: "GET",
                    url: "https://api.postalpincode.in/pincode/" + code,
                    success: function (response) {
                        if (response && response[0].PostOffice) {
                            $("#city").val(response[0].PostOffice[0].District);
                            setValid(abc);
                        } else { setInvalid(abc); $("#city").val(''); }
                    },
                    error: function () { setInvalid(abc); $("#city").val(''); }
                });
            }
        }
    </script>
