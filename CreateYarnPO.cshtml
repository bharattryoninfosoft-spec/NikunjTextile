    function myFunctionIFSC(abc) {

        var code = abc.value.trim().toUpperCase();

        // Empty check
        if (!code) {
            setInvalid(abc);
            clearBankFields();
            return;
        }

        // IFSC length check
        if (code.length !== 11) {
            setInvalid(abc);
            clearBankFields();
            return;
        }

        var ifscurl = "https://ifsc.razorpay.com/" + code;

        $.ajax({
            type: "GET",
            url: ifscurl,
            success: function (response) {

                // ✅ Correct check
                if (response && response.BANK) {

                    $("#BankName").val(response.BANK);
                    $("#BankBranch").val(response.BRANCH);

                    setValid(abc);

                } else {
                    setInvalid(abc);
                    clearBankFields();
                }
            },
            error: function () {
                setInvalid(abc);
                clearBankFields();
            }
        });
    }
