@{
    Layout = "/_LayoutPage1.cshtml";
}





<style>
    .table-box {
        border: 1px dashed #ccc;
        padding: 10px;
        background: #fff;
    }

    .table th {
        font-size: 13px;
        white-space: nowrap;
    }

    .no-data {
        text-align: center;
        padding: 20px;
        color: #777;
    }

    .summary-card {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px dashed #ddd;
        font-size: 14px;
    }

        .summary-row:last-child {
            border-bottom: none;
            font-weight: bold;
        }

    #designModal .modal-body {
        max-height: 75vh;
        overflow-y: auto;
    }

    #upload-PhotoOfDesign-default-preview img {
        max-height: 100%;
        width: 100%;
        object-fit: contain;
    }

    .ColorMatchingName {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #AlertsMsg {
        font-weight: 500;
        margin-left: 10px;
        color: red;
        font-size: larger;
        align-self: center;
    }

    #SaleOrderDetails th:nth-child(2),
    #SaleOrderDetails td:nth-child(2) {
        width: 350px; /* adjust as needed */
        max-width: 350px;
        white-space: normal; /* allow wrapping */
        word-break: break-word;
    }

    #SaleOrderDetails td table td {
        padding: 2px 5px;
        font-size: 13px;
    }
</style>




<div class="content-wrapper">
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Sale Order Entry</div>
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="row gutters">

                            <!-- Order No -->
                            <div class="col-1">
                                <div class="field-wrapper">
                                    <input type="text" id="OrderNo" value="0" readonly>
                                    <div class="field-placeholder">Order No</div>
                                </div>
                            </div>

                            <!-- Order Date -->
                            <div class="col-2">
                                <div class="field-wrapper">
                                    <input type="date" id="OrderDate">
                                    <div class="field-placeholder">Order Date</div>
                                </div>
                            </div>

                            <!-- Party GST -->
                            <div class="col-5">
                                <div class="field-wrapper">
                                    <select id="ddlPartyGST" class="select-single detail form-control" title="Select Yarn Godown Manager" data-live-search="true">
                                        <option value="${item.PartyId}">${item.GSTIN}</option>
                                    </select>
                                    <div class="field-placeholder">Party GST<sup style="color:red;">*</sup></div>
                                    <div class="ddlPartyGST-valid-feedback valid-feedback">Looks good!</div>
                                    <div class="ddlPartyGST-invalid-feedback invalid-feedback">Please Select Party GST</div>
                                    <button type="button" id="AddPartyModel" class="btn btn-primary btn-sm position-absolute" data-bs-toggle="modal" data-bs-target="#addNewContact" style="top:50%; right:5px; transform:translateY(-50%); height:80%;">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Party Name -->
                            <div class="col-4">
                                <div class="field-wrapper">
                                    <input type="text" id="PartyName">
                                    <div class="field-placeholder">Party Name</div>
                                </div>
                            </div>

                            <!-- Party Address -->
                            <div class="col-4">
                                <div class="field-wrapper">
                                    <input type="text" id="PartyAddress">
                                    <div class="field-placeholder">Party Address</div>
                                </div>
                            </div>

                            <!-- Broker -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <input type="text" id="Broker">
                                    <div class="field-placeholder">Broker</div>
                                </div>
                            </div>

                            <!-- Transport -->
                            <div class="col-4">
                                <div class="field-wrapper">
                                    <select id="ddlTransport" class="select-single detail form-control" title="Select Transport" data-live-search="true">
                                        <option value="-1">Select</option>
                                    </select>
                                    <div class="field-placeholder"> Transport <sup style="color:red;">*</sup></div>
                                    <div class="ddlTransport-valid-feedback valid-feedback">Looks good!</div>
                                    <div class="ddlTransport-invalid-feedback invalid-feedback">Please Select Transport</div>
                                    <button type="button" id="AddTransportModel" class="btn btn-primary btn-sm position-absolute" data-bs-toggle="modal" data-bs-target="#TransportModal" style="top:50%; right:5px; transform:translateY(-50%); height:80%;">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <!-- Markup -->
                            <div class="col-1">
                                <div class="field-wrapper">
                                    <input type="text" id="Markup" value="0">
                                    <div class="field-placeholder">Mark-up %</div>
                                </div>
                            </div>
                            <!-- Remark -->
                            <div class="col-5">
                                <div class="field-wrapper">
                                    <input type="text" id="Remark">
                                    <div class="field-placeholder">Remark</div>
                                </div>
                            </div>
                            <!-- Model Button -->
                            <div class="col-5">
                                <div class="field-wrapper">
                                    <button class="btn btn-primary"
                                            onclick="openDesignModal()">
                                        Design Selection
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered" id="SaleOrderDetails">
                            <thead>
                                <tr>
                                    <th>Sr No</th>
                                    <th>Design No</th>
                                    <th>Type</th>
                                    <th>No of Colours</th>
                                    <th>Qty</th>
                                    <th>Unit</th>

                                    <th>Rate</th>
                                    <th>Broker Rate</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody id="orderBody">
                                <tr>
                                    <td colspan="10" class="no-data">
                                        No Data Available In Table
                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>




                    <div class="col-sm-12 col-xl-4 ms-auto">
                        <div class="summary-card">

                            <div class="summary-row">
                                <span>Qty</span>
                                <span id="totalQty">0</span>
                            </div>

                            <div class="summary-row">
                                <span>Amount</span>
                                <span id="totalAmount">0</span>
                            </div>

                            <div class="summary-row align-items-center">
                                <span>Add/Discount</span>

                                <div class="input-group" style="width:180px;">
                                    <!-- 🔥 TYPE SELECT (JOINED) -->
                                    <select id="discountType"
                                            class="form-select form-select-sm"
                                            style="max-width:70px;">
                                        <option value="percent">%</option>
                                        <option value="amount">₹</option>
                                    </select>
                                    <!-- 🔥 VALUE INPUT -->
                                    <input type="text"
                                           id="discountValue"
                                           class="form-control form-control-sm"
                                           value="0">



                                </div>

                                <!-- 🔥 RESULT -->
                                <span id="discountAmount">0</span>
                            </div>

                            <div class="summary-row align-items-center">
                                <span>GST</span>

                                <div class="d-flex align-items-center gap-5">

                                    <!-- GST Dropdown -->
                                    <select id="GSTSLABId" class="form-select">
                                    </select>
                                    <input type="text" id="gstPercent" class="form-control" hidden>
                                    <!-- GST Amount -->
                                    <span id="gstAmount">0</span>

                                </div>
                            </div>

                            <div class="summary-row fw-bold">
                                <span>Invoice Amount</span>
                                <span id="invoiceAmount">0</span>
                            </div>

                        </div>
                    </div>

                    <br />

                    <div class="text-end">
                        <a href="ListSaleOrderEntry" class="btn btn-light me-2">
                            <i class="fa fa-arrow-left"></i> Back
                        </a>

                        <button id="btnSave" class="btn btn-primary" onclick="saveSaleOrder()"> Save Sale Order </button>
                    </div>
                    <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="addNewContactLabel" aria-hidden="true">
                        <div class="modal-dialog modal-xl" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="addNewContactLabel">Add Party</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true"></span>
                                    </button>
                                </div>
                                <div class="modal-body" style=" overflow: initial !important; height:500px !important;">
                                    <div id="add-alert" class="alert alert-success" role="alert">
                                        Record has been saved Successfully.
                                    </div>
                                    <div class="row gutters" id="DivPartyMaster">

                                        <div class="row gutters">
                                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                                <div class="row gutters">

                                                    <div class="col-6">
                                                        <div class="row gutters">
                                                            <div class="col-6">
                                                                <div class="form-section-header" style="background: transparent; margin: 0; margin-top: 5px;">Party Details</div>
                                                            </div>
                                                            <div class="col-6">
                                                            </div>
                                                            <hr />
                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <select id="SundryParty" class="form-control" name="SundryParty">
                                                                        <option value="0"></option>
                                                                        <option value="1">Sundry Creditors</option>
                                                                        <option value="2">Sundry Debtors</option>
                                                                        <option value="3">Job Work</option>
                                                                    </select>
                                                                    <div class="field-placeholder">Select Sundry Party</div>
                                                                    <div class="gstin-valid-feedback valid-feedback">Looks good!</div>
                                                                </div>

                                                            </div>

                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12"></div>



                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    @*<input id="gstin" type="text" class="form-control clear-field detail" placeholder="ex: 20XXXXX9438X1XX" min="15" maxlength="15" onkeydown="validate(this)" />*@
                                                                    <input id="gstin" type="text" class="form-control clear-field detail" placeholder="ex: 20XXXXX9438X1XX" min="15" maxlength="15" onkeyup="validate(this)" style=" text-transform: uppercase;" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode>=48 && event.charCode<=57 )">
                                                                    <input id="gstintemp" type="hidden" class="form-control clear-field detail" placeholder="ex: 20XXXXX9438X1XX" min="15" maxlength="15" onkeyup="validate(this)" style=" text-transform: uppercase;" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode>=48 && event.charCode<=57 )">
                                                                    <div class="field-placeholder">GSTIN</div>
                                                                    <div class="gstin-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="gstin-invalid-feedback invalid-feedback" id="GSTError">Please Provide Valid GSTIN Number</div>

                                                                </div>

                                                            </div>

                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    @*<input id="gstin" type="text" class="form-control clear-field detail" placeholder="ex: 20XXXXX9438X1XX" min="15" maxlength="15" onkeydown="validate(this)" />*@
                                                                    <input id="PanNo" type="text" class="form-control clear-field detail" placeholder="PanNo" min="10" maxlength="10" onkeyup="validate(this)" style=" text-transform: uppercase;" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode>=48 && event.charCode<=57 )">
                                                                    <input id="PanNotemp" type="hidden" class="form-control clear-field detail" placeholder="PanNo" min="10" maxlength="10" onkeyup="validate(this)" style=" text-transform: uppercase;" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode>=48 && event.charCode<=57 )">
                                                                    <div class="field-placeholder">PAN No</div>
                                                                    <div class="PanNo-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="PanNo-invalid-feedback invalid-feedback" id="PanNoError">Please Provide Valid PanNo Number</div>

                                                                </div>

                                                            </div>




                                                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="party-name" placeholder="Enter Name" type="text" class="form-control clear-field detail" onfocusout="validate(this)">
                                                                    <div class="field-placeholder">Party Name <span class="text-danger">*</span></div>
                                                                    <div class="party-name-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="party-name-invalid-feedback invalid-feedback">Please Provide Party Name</div>
                                                                </div>
                                                                <!-- Field wrapper end -->
                                                            </div>






                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="phone" placeholder="Enter Mobile" type="tel" class="form-control clear-field detail" onfocusout="validate(this)" min="10" maxlength="10" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                                                    <input id="phonetemp" placeholder="Enter Mobile" type="hidden" class="form-control clear-field detail" onfocusout="validate(this)" min="10" maxlength="10" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                                                    <div class="field-placeholder">Mobile Number <span class="text-danger">*</span></div>
                                                                    <div class="phone-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="phone-invalid-feedback invalid-feedback">Please Provide Mobile Number</div>
                                                                    <div class="phone-less-feedback invalid-feedback">Invalid Number</div>
                                                                </div>
                                                                <!-- Field wrapper end -->
                                                            </div>
                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="alt-phone" placeholder="Enter Alternate Mobile" type="tel" class="form-control clear-field detail" @*onfocusout="validate(this)"*@ min="10" maxlength="10" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                                                    <div class="field-placeholder">Alternate Number</div>
                                                                    <div class="alt-phone-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="alt-phone-invalid-feedback invalid-feedback">Please Provide Alternate Number</div>
                                                                    <div class="alt-phone-less-feedback invalid-feedback">Invalid Number</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>

                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="email" placeholder="Enter Email" onfocusout="validateEmail(this.value,this)" type="text" class="form-control clear-field detail" onkeypress="return ((event.charCode >= 46 && event.charCode <= 57) && event.charCode != 47 || (event.charCode >= 64 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122))">
                                                                    <input type="hidden" id="email-temp" value="" />
                                                                    <input type="hidden" id="phone-temp" value="" />
                                                                    <div class="field-placeholder">Email</div>
                                                                    <div class="email-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="email-invalid-feedback invalid-feedback">Please Provide Proper Email</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>

                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                                            </div>




                                                            <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <select id="placeOfSupply" class="select-single js-states clear-field detail" title="Select Place" data-live-search="true">
                                                                        <option value="-1">Select</option>
                                                                    </select>
                                                                    <div class="field-placeholder">Place Of Supply</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>

                                                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="pincode" placeholder="Enter Pincode" type="tel" class="form-control clear-field detail" min="6" maxlength="6" onkeypress="return (event.charCode>=48 && event.charCode<=57)" onfocus="myFunctionPINCODE(this.value)" onkeyup="myFunctionPINCODE(this)">
                                                                    <div class="field-placeholder">Pincode</div>
                                                                    <div class="pincode-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="pincode-invalid-feedback invalid-feedback">Please Provide pincode</div>
                                                                    <div class="pincode-less-feedback invalid-feedback">Invalid Number</div>
                                                                </div>
                                                                <!-- Field wrapper end -->
                                                            </div>

                                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="city" placeholder="Enter City" type="text" class="form-control clear-field detail">
                                                                    <div class="field-placeholder">City</div>
                                                                    <div class="alt-phone-valid-feedback valid-feedback">Looks good!</div>
                                                                    <div class="alt-phone-invalid-feedback invalid-feedback">Please Provide City</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>


                                                            <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <select id="BrokerModel" class="select-single js-states clear-field detail" title="Select Place" data-live-search="true">
                                                                        <option value="-1">Select</option>
                                                                    </select>
                                                                    <div class="field-placeholder">Broker</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>
                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                                                <div class="field-wrapper">
                                                                    <div class="form-check form-check-inline">
                                                                        <input class="form-check-input clear-field detail" type="checkbox" id="chcekIsActiveParty" checked style="cursor:pointer;">
                                                                        <label class="form-check-label" for="chcekIsActiveParty">Is Active Party</label>
                                                                    </div>
                                                                </div>

                                                            </div>



                                                        </div>



                                                    </div>

                                                    <div class="col-6" style=" border-left: 1px solid #c3c3c3;">



                                                        <div class="col-6">
                                                            <div class="form-section-header" style="background: transparent; margin: 0; margin-top: 5px;">Bank Details</div>
                                                        </div>
                                                        <div class="col-6">

                                                        </div>
                                                        <hr style=" margin: 0px 0px 16px 0;" />


                                                        <div class="row gutters">

                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="BankHolderName" type="text" class="form-control clear-field detail" placeholder="Bank Holder Name" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode == 32)">
                                                                    <div class="field-placeholder">Bank Holder Name</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>



                                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="BankAccountNo" type="text" class="form-control clear-field detail" placeholder="Bank Account No" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode>=48 && event.charCode<=57 )">
                                                                    <div class="field-placeholder">Bank A/c No</div>
                                                                </div>
                                                                <!-- Field wrapper end -->

                                                            </div>



                                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="BankIFSCCode" placeholder="Enter IFSC" type="text" min="11" maxlength="11" class="form-control clear-field detail" onfocusout="validate(this)" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode>=48 && event.charCode<=57 )" onfocus="myFunctionIFSC(this.value)" onkeyup="myFunctionIFSC(this)">
                                                                    <div class="field-placeholder">Bank IFSC</div>
                                                                    <div class="BankIFSCCode-valid-feedback valid-feedback">Looks good!</div>
                                                                    @*<div class="BankIFSCCode-invalid-feedback invalid-feedback">Please Provide Bank IFSC Code</div>*@
                                                                </div>
                                                                <!-- Field wrapper end -->
                                                            </div>

                                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="BankName" type="text" class="form-control clear-field detail" placeholder="Bank Name" readonly>
                                                                    <div class="field-placeholder">Bank Name</div>
                                                                </div>
                                                                <!-- Field wrapper end -->
                                                            </div>
                                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                                                <!-- Field wrapper start -->
                                                                <div class="field-wrapper">
                                                                    <input id="BankBranch" type="text" class="form-control clear-field detail" placeholder="Bank Branch" readonly>
                                                                    <div class="field-placeholder">Bank Branch</div>
                                                                </div>
                                                                <!-- Field wrapper end -->
                                                            </div>
                                                        </div>
                                                        <div class="col-6">
                                                            <div class="form-section-header" style="background: transparent; margin: 0; margin-top: 5px;">Address Details</div>
                                                        </div>
                                                        <div class="col-6">

                                                        </div>
                                                        <hr style=" margin: 5px 0px 16px 0;" />
                                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                                            <!-- Field wrapper start -->
                                                            <div class="field-wrapper">
                                                                <textarea id="billingAddress" onkeyup="checkShippingAdd()" class="form-control clear-field detail" rows="3" placeholder="Enter Billing Address"></textarea>
                                                                <div class="field-placeholder">Billing Address</div>
                                                            </div>
                                                            <!-- Field wrapper end -->
                                                        </div>

                                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" id="divaddchk">

                                                            <div class="field-wrapper">
                                                                <div class="form-check form-check-inline" style="margin-left: 65%;">
                                                                    <input class="form-check-input clear-field detail" onclick="toggleShippingAddress()" type="checkbox" id="chcekAddress" value="option" checked style="cursor:pointer;">
                                                                    <label class="form-check-label" for="chcekAddress">Same as Billing Address</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                                            <!-- Field wrapper start -->
                                                            <div class="field-wrapper">
                                                                <textarea id="shippingAddress" class="form-control clear-field" rows="3" placeholder="Enter Shipping Address" disabled></textarea>
                                                                <div class="field-placeholder">Shipping Address</div>
                                                            </div>
                                                            <!-- Field wrapper end -->

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
