    function updateMainTotals(index) {

        let item = SaleOrderDetails[index];

        let totalQty = 0;

        item.SubDetails.forEach(x => {
            totalQty += x.Qty;
        });

        item.TotalQty = totalQty;
        item.NoOfColors = item.SubDetails.length;

        item.Amount = totalQty * item.BrokerRate;

        bindMainTable();
        updateSummary();
    }
    function processOrder(rate) {

        const subRows = $("#itemTableBody tr").not(".no-data");

        if (!subRows.length)
            return alert("Please add at least one Color Matching");

        const form = getFormData();
        if (!form.valid)
            return alert("Required fields missing");

        let totalQty = 0;
        let subDetails = [];

        subRows.each(function () {
            const row = $(this);
            const qty = parseFloat(row.find("td:eq(2)").text()) || 0;

            totalQty += qty;

            subDetails.push({
                ColorMatchingID: row.data("id"),
                ColorMatchingName: row.find("td:eq(1)").text().trim(),
                Qty: qty,
                ImageUrl: row.data("img") || ""   // ✅ THIS WAS MISSING
            });
        });

        const brokerRate = calculateBrokerRate(rate, form.markup);
        const amount = totalQty * brokerRate;

        const mainObj = {
            ...form,
            TotalQty: totalQty,
            NoOfColors: subDetails.length,
            Rate: rate,
            BrokerRate: brokerRate,
            Amount: amount,
            SubDetails: subDetails
        };

        mergeOrder(mainObj);

        bindMainTable();
        updateSummary();
        resetSubTable();

        $("#designModal").modal("hide");
    }
    function getFormData() {

        const designId = $("#DesignNo").val();
        const typeId = $("#TypeRow").val();
        const unitId = $("#UnitRow").val();

        return {
            valid: designId && typeId && unitId,

            DesignId: designId,
            DesignNo: $("#DesignNo option:selected").text().trim(),

            TypeId: typeId,
            Type: $("#TypeRow option:selected").text().trim(),

            UnitId: unitId,
            Unit: $("#UnitRow option:selected").text().trim(),

            ColorGroupId: $("#ddlColourGroup").val(),
            ColorGroup: $("#ddlColourGroup option:selected").text().trim(),

            Remark: $("#Remark").val() || "",
            markup: parseFloat($("#Markup").val()) || 0
        };
    }
    function calculateBrokerRate(rate, markup) {
        return rate + (rate * markup / 100);
    }
    function mergeOrder(newItem) {

        const index = SaleOrderDetails.findIndex(x =>
            x.DesignId == newItem.DesignId &&
            x.TypeId == newItem.TypeId &&
            x.UnitId == newItem.UnitId &&
            x.ColorGroupId == newItem.ColorGroupId
        );

        if (index === -1) {
            SaleOrderDetails.push(newItem);
            return;
        }

        const existing = SaleOrderDetails[index];

        existing.TotalQty += newItem.TotalQty;
        existing.BrokerRate = newItem.BrokerRate;
        existing.Amount = existing.TotalQty * newItem.BrokerRate;

        newItem.SubDetails.forEach(newSub => {

            const old = existing.SubDetails.find(x =>
                x.ColorMatchingID == newSub.ColorMatchingID
            );

            old ? old.Qty += newSub.Qty
                : existing.SubDetails.push(newSub);
        });
    }
