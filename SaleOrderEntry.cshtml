<script>
    document.title = "Create Sale Order - Nikunj Textile";
    $('body').addClass('fullscreen');
</script>


<script>

    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#YarnForm-tab").addClass("active");
        $("#tab-YarnForm").addClass("show active");
        $("#aYarnRequirement").addClass("current-page");
        loadOrderNo();
        FunctionIsLogin();
        bindPartyGST();
        bindBrokerDropdown();
        bindTransport();
        getItemGST();
        getStates(0);
        $("#PartyName").prop("disabled", true);
        $("#PartyAddress").prop("disabled", true);
        $("#Broker").prop("disabled", true);

        let today = new Date();

        let day = String(today.getDate()).padStart(2, '0');
        let month = String(today.getMonth() + 1).padStart(2, '0');
        let year = today.getFullYear();

        let formattedDate = `${year}-${month}-${day}`; // ✅ IMPORTANT

        $("#OrderDate").val(formattedDate);
    });
    let srNo = 1;
    let subDetails = [];
    let SaleOrderDetails = [];
    let currentViewIndex = -1;
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    let isEditMode = false;
    $("#discountType").on("change", function () {

        if ($(this).val() === "percent") {
            $("#discountValue").attr("placeholder", "Enter %");
        } else {
            $("#discountValue").attr("placeholder", "Enter ₹");
        }
    });
    $("#discountValue").on("input", updateSummary);
    $("#discountType").on("change", updateSummary);
    $("#gstPercent").on("input", updateSummary);
    $("#discountPercent").on("keypress", function (e) {
        if (e.key === "%") return true;

        if (!/[0-9.]/.test(e.key)) {
            e.preventDefault();
        }
    });
    $("#GSTSLABId").on("change", function () {

        let selectedText = $("#GSTSLABId option:selected").text();

        // 🔥 Extract number from text (e.g. "GST 5%" → 5)
        let percent = parseFloat(selectedText.replace(/[^\d.]/g, "")) || 0;

        // ✅ Set to input
        $("#gstPercent").val(percent);

        // 🔥 Update calculation
        updateSummary();
    });
    $("#AddPartyModel").on("click", function () {

        // Clear all fields
        $(".clear-field").val("");

        // Reset dropdowns
        $("#SundryParty").val("0");
        $("#placeOfSupply").val("-1");
        $("#Broker").val("-1");

        // Checkbox default
        $("#chcekIsActiveParty").prop("checked", true);

        // Hide update button, show save
        $("#editbtn").hide();
        $("#savebtn").show();
        $("#saveViewbtn").show();

        // Title change
        $("#addNewContactLabel").text("Add Party");
    });
    $("#ddlPartyGST").on("change", function () {
        let selected = $(this).find("option:selected");

        let partyId = $(this).val();
        let partyName = selected.data("name");
        let gst = selected.data("gstin");
        let BrokerCode = selected.data("brokercode");
        let BillingAddress = selected.data("address");
        let BrokerName = selected.data("brokername");
        $("#PartyName").val(partyName);
        $("#PartyAddress").val(BillingAddress);
        $("#Broker").val(BrokerName);

        console.log(partyId, partyName, gst, BillingAddress, BrokerCode, BrokerName);

        // Example:
        // $("#txtPartyName").val(partyName);
    });
    $("#ddlColourGroup").on("change", function () {
        let colorGroupId = $(this).val();
        console.log("Selected ColorGroupID:", colorGroupId);
    });
    $('#designModal').on('shown.bs.modal', function () {

        $('#DesignNo').select2('destroy').select2({
            dropdownParent: $('#designModal'),
            width: '100%'
        });

        $('#ddlColourGroup').select2('destroy').select2({
            dropdownParent: $('#designModal'),
            width: '100%'
        });

    });
    $('#designModal').on('hidden.bs.modal', function () {

        isViewMode = false;
        currentViewIndex = -1;
        // ✅ Clear dropdowns
        $("#DesignNo").val('');
        $("#ColorMatchingID").empty();

        // ✅ Clear inputs
        $("#ColorMatchingQty").val('');
        $("#weftLength").val('');
        $("#warpLength").val('');

        // ✅ Clear table
        $("#divColorMatchingTable").empty();
        $("#itemTableBody").html(`
        <tr class="no-data">
            <td colspan="4" class="text-center">
                No Data Available In Table
            </td>
        </tr>
    `);

        // ✅ Clear images
        $("#upload-PhotoOfDesign-default-preview").html('Photo Of Design');
        $("#upload-ColorMatching-default-preview").html('Color Matching Photo');

        // ✅ Reset hidden text
        $(".ColorMatchingID").text('');
        $(".ColorMatchingName").text('');

        // ✅ Reset buttons
        $("#Nextbtn").hide();
        $("#Previousbtn").hide();

    });
    $("#DesignNo").on("change", function () {
        if (!isEditMode) {
            const tbody = $("#itemTableBody");
            tbody.empty();
            document.getElementById("DesignNo").disabled = true;
        }

        let selected = $(this).find("option:selected");
        let val = $(this).val();
        if ($(this).val() != "") {
            let parts = val.split('|');

            let designEntryId = parts[0];
            let colorMatchingId = parts[1];
            // GET VALUES
            let typeId = selected.data("typeid");
            let type = selected.data("type");

            let unitId = selected.data("unitid");
            let unit = selected.data("unit");

            let colorId = selected.data("colorid");
            let color = selected.data("color");

            // SET DROPDOWNS
            $("#TypeRow").html(`<option value="${typeId}" selected>${type}</option>`);
            $("#UnitRow").html(`<option value="${unitId}" selected>${unit}</option>`);
            $("#ddlColourGroup").html(`<option value="${colorId}" selected>${color}</option>`);
            getDesignNo(designEntryId, colorMatchingId);

        } else {

            // RESET
            $("#TypeRow").html('<option value="">Select Type</option>');
            $("#UnitRow").html('<option value="">Select Unit</option>');
            $("#ddlColourGroup").html('<option value="">Select Color Group</option>');
        }
    });
    $('#TransportModal').on('show.bs.modal', function () {

        // Only for ADD
        if ($('#TransportId').val() == 0) {

            $.ajax({
                url: '/WebServiceNikunjTextile.asmx/GetNextTransportCode',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: '{}',

                success: function (res) {
                    $('#TransportCode').val(res.d);
                }
            });

        }
    });
    $("#ColorMatchingAddbtn").click(function () {

        const colorId = $(".ColorMatchingID").text().trim();
        const colorName = $(".ColorMatchingName").text().trim();
        const qty = parseFloat($("#ColorMatchingQty").val());
        let imageUrl = $("#upload-ColorMatching-default-preview img").attr("src") || "";
        if (!colorName) return showError("Please select Color Matching");
        if (!qty || qty <= 0) return showError("Please enter valid Qty");

        const tbody = $("#itemTableBody");

        tbody.find(".no-data").remove();

        const exists = [...tbody.find("tr")].some(tr =>
            $(tr).data("id") == colorId
        );

        if (exists) return showError("This item already added");

        tbody.append(createSubRow(colorId, colorName, qty, imageUrl));

        updateSrNo();

        $("#ColorMatchingQty").val('').focus();
    });
    $("#ColorMatchingQty").keypress(function (e) {
        if (e.which === 13) {
            $("#ColorMatchingAddbtn").click();
        }
    });
    $(document).on("click", ".deleteRow", function () {

        let row = $(this).closest("tr");
        let colorId = row.data("id");

        // 🔥 Remove from object
        if (currentViewIndex !== -1) {

            let subList = SaleOrderDetails[currentViewIndex].SubDetails;

            SaleOrderDetails[currentViewIndex].SubDetails =
                subList.filter(x => x.ColorMatchingID != colorId);

            updateMainTotals(currentViewIndex);
        }

        // 🔥 Remove row from UI
        row.remove();

        let rows = $("#itemTableBody tr").not(".no-data");

        if (rows.length === 0) {

            $("#itemTableBody").html(noDataRow());

            // ❌ No data → clear dropdown + image
            $("#ColorMatchingID").val("");
            $("#upload-ColorMatching-default-preview").html("No Image");

        } else {

            // ✅ Pick FIRST ROW
            let firstRow = rows.first();
            let id = firstRow.data("id");

            $("#ColorMatchingID").val(id).trigger("change");
            // 🔥 Ensure function runs
            getColorMatchingId(document.getElementById("ColorMatchingID"));
            // 🔥 Also update stored selected id
            if (currentViewIndex !== -1) {
                SaleOrderDetails[currentViewIndex].SelectedColorId = firstId;
            }
        }

        updateSrNo();
    });
    $("#btnAddToOrder").click(function () {

        const designNo = $("#DesignNo option:selected").text().trim();

        if (!designNo) return alert("Please select Design");

        $.ajax({
            type: "POST",
            url: "/WebServiceNikunjTextile.asmx/GetSaleRate",
            data: JSON.stringify({ designNo }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: res => processOrder(parseFloat(res.d) || 0),
            error: () => alert("Error fetching rate")
        });
    });
    $(document).on("click", ".viewSub", function () {

        const index = $(this).closest("tr").data("index");

        currentViewIndex = index;
        isEditMode = true;

        const item = SaleOrderDetails[index];

        bindSubTable(item.SubDetails);
        bindFormFields(item);

        setTimeout(() => {

            let selectedId = item.SelectedColorId;

            if (selectedId) {

                // ✅ Correct dropdown select
                $("#ColorMatchingID").val(selectedId);

                // ✅ Trigger image + table
                getColorMatchingId(document.getElementById("ColorMatchingID"));
            }

        }, 200);

        $("#designModal").modal("show");
    });
    $(document).on("click", "#itemTableBody tr", function () {

        let id = $(this).data("id");

        $("#ColorMatchingID").val(id);

        getColorMatchingId(document.getElementById("ColorMatchingID"));
    });
    $("#Markup").on("input", function () {

        const markup = parseFloat($(this).val()) || 0;

        SaleOrderDetails.forEach(item => {

            const brokerRate = calculateBrokerRate(item.Rate, markup);

            item.BrokerRate = brokerRate;
            item.Amount = item.TotalQty * brokerRate;
        });

        bindMainTable();
        updateSummary(); // 🔥 ADD THIS
    });
    function openDesignModal() {
        isEditMode = false; // ✅ ADD MODE
        document.getElementById("DesignNo").disabled = false;
        // Clear old data
        $("#DesignNo").val('');
        $("#ColorMatchingID").empty();
        $("#divColorMatchingTable").empty();

        // Load fresh data

        getDesignEntryForm();
        $("#designModal").modal("show");
    }
    function getDesignEntryForm() {

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/GetDesignEntryData',
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',

            success: function (response) {
                let data = JSON.parse(response.d); // 🔥 FIX
                console.log("GetDesignEntryData", data);

                if (data.Code == 200) {

                    // DESIGN
                    $("#DesignNo").html('<option value="">Select Design</option>');

                    $.each(data.Designs, function (i, item) {

                        $("#DesignNo").append(`
                         <option
                             value="${item.DesignEntryFormID}|${item.DesignColorMatchingFormID}"
                             data-typeid="${item.TypeID}"
                             data-type="${item.Type}"
                             data-unitid="${item.UnitId}"
                             data-unit="${item.UnitCode}"
                             data-colorid="${item.ColorGroupID}"
                             data-color="${item.ColorGroup}">
                             ${item.DesignerCode} - ${item.DesignNo}
                         </option>
                     `);
                    });

                    // TYPE
                    $("#TypeRow").html('<option value="">Select Type</option>');
