    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });


    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });






    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }

    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }




    function functionSearch() {
        displayPagginationData();
        displayData(0);
    }

    function displayData(rowStartCheck) {

        var rowStart = rowStartCheck;
        var searchdesignNo = $("#SearchRequirementNo").val();

        var formData = new FormData();
        formData.append('SearchRequirementNo', searchdesignNo);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnInwardMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";

                var srno = parseInt(rowStart) + parseInt(1);
                for (var i = 0; i < response.listYarnInwardMaster.length; i++) {

                    temp += "<tr><td>" + srno++ + "</td>";
                    //temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnInwardMaster[i].DesignColorMatchingFormID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listYarnInwardMaster[i].DesignColorMatchingFormID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "<td><div class='actions'>";

                    var TotalBarcode = "";
                    if (response.listYarnInwardMaster[i].TotalBarcode != "0")
                    {
                        TotalBarcode = "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' onclick='showYarnBarcodeRecords(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='fa fa-barcode text-secondary fa-2x' style='font-weight:50;' title='Print Stickers'></i></a>";
                    }

                    if (response.listYarnInwardMaster[i].IsComplete == 0) {
                        temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;";
                        temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;";
                        temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='icon-x-circle text-danger'></i></a>";
                        temp += "<br />" + TotalBarcode;
                    }
                    else {
                        //temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;";
                        temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;";
                        //temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listYarnInwardMaster[i].YarnInwardID + ")'><i class='icon-x-circle text-danger'></i></a>";
                        temp += "<br />" + TotalBarcode;
                    }

                    temp += "</div></td>";
                    //temp += "<td>" + response.listYarnInwardMaster[i].DateandTimes + "</td>";
                    temp += "<td><img src='" + response.listYarnInwardMaster[i].PhotoOfInward + "' style='width:50px; height:50px;'></td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].ChallanNo + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].YarnPONo + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].ChallanDates + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].PartyChallanNo + "</td>";
                    //temp += "<td>" + response.listYarnInwardMaster[i].ShippedToName + " </td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].GodownTitle + "  ";
                    //alert(response.listYarnInwardMaster[i].GODOWNCHANGE);
                    if (response.listYarnInwardMaster[i].GODOWNCHANGE == "GODOWN CHANGE") {
                        temp += "<br /> <span class='badge rounded-pill bg-warning' style='color:black;'>GODOWN CHANGE</span>";
                    }
                    temp += "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].GodownAddress + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].SupplierName + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].MobileNo + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].BillToPartyName + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].YarnMaterial + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].YarnColor + "</td>";
                    temp += "<td>" + response.listYarnInwardMaster[i].TotalWeight + "</td>";

                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }






    var total = 0;
    var Paggination = 0;
    var prevNo = 0;
    var nextNo = 0;
    var SelectNo = 1;
    var PageNo = 0;

    //Display Paggination
    function displayPagginationData() {

        var searchdesignNo = $("#SearchRequirementNo").val();

        var formData = new FormData();
        formData.append('SearchString', searchdesignNo);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnInwardMasterPaggination',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                //console.log(response);

                //var userTable = $('#DDLDistrict');
                //listPagginationMaster
                total = response.listPagginationMaster[0].Total;
                Paggination = response.listPagginationMaster[0].Paggination + 1;
                prevNo = 0;
                nextNo = 10;
                //alert(response.listPagginationMaster[0].Paggination);
                if (response.listPagginationMaster[0].Paggination == "0") {
                    $('#divPaggination').hide();
                }
                else {


                    if (parseInt(response.listPagginationMaster[0].Paggination) <= parseInt(10)) {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= parseInt(response.listPagginationMaster[0].Paggination); i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                        }
                        $('#divPaggination').html(temp).show();
                    }
                    else {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= 10; i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }

                        }
                        //temp += "<a href='javascript:void(0);' id='next' onclick='funcationPagginationNext()'>&raquo;</a>";
                        temp += "<li class='page-item' id='next'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";

                        $('#divPaggination').html(temp).show();
                    }

                }


            },
            error: function (request, status, error) {
                //console.log(error);
                //console.log("error" + request.statusText);
                //alert(request.statusText);
            }
        });
    }




    //Select Paggination
    function funcationPaggination(abc) {
        //alert(abc);
        $("#trLoading").show();
        var a = "#a" + abc;
        SelectNo = abc;
        //alert(a);
        $('li').removeClass('active');
        //$("#a3").addClass("active");
        $(a).addClass('active');

        $("#rowStartCount").val(((abc - 1) * 30));
        displayData(((abc - 1) * 30));

        //$("#rowStartCount").val(((abc - 1) * 2));
        //displayData(((abc - 1) * 2));

    }








