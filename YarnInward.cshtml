<script>

    $(document).ready(function () {


        $('.active, .show, .current-page').removeClass('active show current-page');

        $("#YarnForm-tab").addClass("active");
        $("#tab-YarnForm").addClass("show active");
        $("#aYarnInward").addClass("current-page");

        FunctionIsLogin();

        displayPagginationData();
        displayData(0);
        getYarnColor();
        //getDefaultCompany();



