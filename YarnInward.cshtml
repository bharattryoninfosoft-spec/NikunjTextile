                                    <th style="color: white !important;">Party  <br /> Challan No</th>
                                    <th style="color: white !important;">Shipped To <br /> Name</th>
                                    <th style="color: white !important;">Shipped to   <br /> Address</th>
                                    <th style="color: white !important;">Supplier  <br /> Name</th>
                                    <th style="color: white !important;">Mobile <br /> No</th>
                                    <th style="color: white !important;">Company <br /> Name</th>
                                    <th style="color: white !important;">Yarn  <br /> Material</th>
                                    <th style="color: white !important;">Yarn  <br /> Color</th>
