<style>
    /* Hide Export Buttons */
    .dt-buttons,
    .dataTables_wrapper .dt-buttons {
        display: none !important;
    }

    /* Hide Search Box */
    .dataTables_filter {
        display: none !important;
    }

    /* Hide "Showing x to y of z entries" */
    .dataTables_info {
        display: none !important;
    }

    /* Hide Pagination */
