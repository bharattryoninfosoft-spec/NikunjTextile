        function loadColorCodesForColor(colorId, selectedCodeToSet, callback) {
            let cId = parseInt(colorId, 10) || 0;
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/GetYarnColorCodes',
                data: { YarnColorID: cId },
                dataType: 'json',
                success: function (res) {
                    let list = (res && res.listColorCodes) ? res.listColorCodes : [];
                    let ddl = $('#ddlYarnColorCode');
                    let currentVal = normalize(selectedCodeToSet !== undefined ? selectedCodeToSet : (ddl.val() || "0"));
                    ddl.empty();
                    ddl.append("<option value='0' data-colorid='0'>Yarn Color Code</option>");
                    let seen = {};
                    for (let i = 0; i < list.length; i++) {
                        let code = (list[i].YarnColorCode || "").trim();
                        let cid = list[i].YarnColorID || 0;
                        let norm = normalize(code);
                        if (code && !seen[norm]) {
                            seen[norm] = true;
                            ddl.append(`<option value="${code}" data-colorid="${cid}">${code}</option>`);
                        }
                    }
                    if (currentVal && currentVal !== "0" && seen[currentVal]) {
                        ddl.val(currentVal);
                        $('#select2-ddlYarnColorCode-container').html(currentVal).attr('title', currentVal);
                    } else {
                        ddl.val('0');
                        $('#select2-ddlYarnColorCode-container').html('Yarn Color Code').attr('title', 'Yarn Color Code');
                    }
                    if (callback) callback(list);
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }
