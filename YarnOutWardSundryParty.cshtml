                selectedCode = "";
            }
            let optColorId = parseInt(selectedOption.data("colorid"), 10) || 0;
            let currentColorId = parseInt($("#ddlYarnColor").val(), 10) || 0;
            if (selectedCode && optColorId > 0 && currentColorId !== optColorId) {
                $("#ddlYarnColor").val(optColorId);
                let colorText = $("#ddlYarnColor option:selected").text().trim();
                $("#select2-ddlYarnColor-container").html(colorText).attr('title', colorText);
            }
            let displayText = selectedCode || "Yarn Color Code";
            $("#select2-ddlYarnColorCode-container").html(displayText).attr('title', displayText);
            if (!isLoadingForEdit) reloadYarnFlow();
        }
        function GridBindData(callback) {
            var GodownID = parseInt($("#ddlGodownMaster").val(), 10) || 0;
            var BillToPartyID = parseInt($("#ddlYarnCompany").val(), 10) || 0;
            var YarnMaterialID = parseInt($("#ddlYarnMaterial").val(), 10) || 0;
            var rawColor = $("#ddlYarnColor").val();
            var YarnColorID = Array.isArray(rawColor) ? rawColor.join(',') : (rawColor || 0);
            var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val() || 0;
            var siftSiftGodownLocationId = $("#siftGodownInputBox").val();
            if (GodownID < 0) GodownID = 0;
            if (BillToPartyID < 0) BillToPartyID = 0;
            if (YarnMaterialID < 0) YarnMaterialID = 0;
            if (GodownID > 0) {
                var formData = new FormData();
                formData.append('GodownID', GodownID);
                formData.append('BillToPartyID', BillToPartyID);
                formData.append('YarnMaterialID', YarnMaterialID);
                formData.append('YarnColorID', YarnColorID);
                formData.append('SiftGodownLocationId', (siftSiftGodownLocationId || "").slice(0, -1).replace(/\|/g, ','));
                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getYarnOutwardMasterNew',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        let data = response.listYarnOutwardMaster;
                        let tbody = $("#tableYarnOutward tbody");
                        tbody.empty();
                        let selectedCode = normalize($("#ddlYarnColorCode").val() || "");
                        if (selectedCode === "0" || selectedCode === "-1" || selectedCode === "YARN COLOR CODE") {
                            selectedCode = "";
                        }
                        if (data && data.length > 0) {
                            data.forEach(function (row) {
                                let cCode = (row.YarnColorCode || "").trim();
                                if (cCode && $("#ddlYarnColorCode option[value='" + cCode + "']").length === 0) {
                                    $("#ddlYarnColorCode").append(`<option value="${cCode}" data-colorid="${row.YarnColorID}">${cCode}</option>`);
                                }
                            });
                        }
                        if (selectedCode !== "" && data && data.length > 0) {
                            data = data.filter(function (row) {
                                return normalize(row.YarnColorCode) === selectedCode;
                            });
                        }
                        if (!data || data.length === 0) {
                            tbody.html('<tr><td colspan="8" class="text-center text-muted py-3">No Data Found</td></tr>');
                            if (callback) callback();
                            return;
                        }
                        $.each(data, function (index, row) {
                            let key = makeKey(row.CompanyName, row.YarnMaterialID, row.YarnColorID, row.YarnColorCode);
                            let itemKey = makeItemKey(row.GodownLocationID, row.YarnMaterialID, row.YarnColorID, row.YarnColorCode, row.BillToPartyID);

                            let existingItem = selectedOutwardList.find(x => x.Key === itemKey);
                            let initialQty = existingItem ? existingItem.NoOfBox : 0;
                            let trClass = initialQty > 0 ? "table-success" : "";

                            let tr = `<tr class="${trClass}">
                                    <td class="rowIndex text-center font-weight-bold text-muted">${index + 1}</td>
                                    <td id="CompanyId" hidden>${row.BillToPartyID}</td>
                                    <td>${row.CompanyName}</td>
                                    <td>${row.YarnMaterial}</td>
                                    <td>${row.YarnColor}</td>
                                    <td class="text-center font-weight-bold">${row.YarnColorCode || ''}</td>
                                    <td class="text-center font-weight-bold text-info">${row.Stock}</td>
                                    <td>${row.LocationTitle}</td>
                                    <td class="text-center">
                                        <input type="text" class="txtStockInput form-control form-control-sm text-center font-weight-bold mx-auto" 
                                            value="${initialQty}" data-key="${key}" data-stock="${row.Stock}"
                                            data-company="${normalize(row.CompanyName)}"
                                            data-materialid="${row.YarnMaterialID}"
                                            data-colorid="${row.YarnColorID}"
                                            data-colorcode="${normalize(row.YarnColorCode)}"
                                            data-locationid="${row.GodownLocationID}" maxlength="6" style="max-width: 80px; height: 26px; padding: 2px 4px; font-size: 13px;"
                                            onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                                    </td>
                                </tr>`;
                            tbody.append(tr);
                        });
                        if (callback) callback();
                    },
                    error: function () {
                        let tbody = $("#tableYarnOutward tbody");
                        tbody.html('<tr><td colspan="8" class="text-danger text-center py-3">Error loading data</td></tr>');
                        if (callback) callback();
                    }
                });
            } else {
                let tbody = $("#tableYarnOutward tbody");
                tbody.html('<tr><td colspan="8" class="text-center text-muted py-3">Select Godown to load available yarn stock</td></tr>');
                if (callback) callback();
            }
        }
        function loadAllYarnData(PartyId, YarnMaterialID, YarnColorID, callback) {
            if (typeof PartyId === 'function') {
                callback = PartyId;
                PartyId = null;
            }
            GridBindData(function () {
                highlightMatchedYarnRows();
                if (callback) callback();
            });
        }
        function getPendingYarnForm(PartyId, YarnMaterialID, YarnColorID, callback) {
            let tbody = $("#pendingYarnTable tbody");
            let pId = parseInt(PartyId, 10) || 0;
            let sundryVal = parseInt($("#SundryParty").val(), 10) || 1;
            if (pId <= 0 && sundryVal === 3) {
                tbody.html('<tr><td colspan="6" class="text-center text-muted py-3">Select Party to view pending requirements</td></tr>');
                if (callback) callback();
                return;
            }
            tbody.html('<tr><td colspan="6" class="text-center py-3"><i class="fa fa-spinner fa-spin me-1"></i> Loading pending requirements...</td></tr>');
            pendingDetailMap = {};
            pendingItemWise = {};
            isPendingAvailable = false;
            let mId = parseInt(YarnMaterialID, 10) || 0;
            if (mId < 0) mId = 0;
            let rawColors = $('#ddlYarnColor').val() || [];
            if (!Array.isArray(rawColors)) {
                rawColors = [rawColors];
            }
            let validColors = [];
            for (let i = 0; i < rawColors.length; i++) {
                let c = parseInt(rawColors[i], 10) || 0;
                if (c > 0) validColors.push(c);
            }
            let primaryPartyId = (sundryVal === 3 && pId > 0) ? pId : 0;
            function renderPendingData(data) {
                tbody.empty();
                let selectedCode = normalize($("#ddlYarnColorCode").val() || "");
                if (selectedCode === "0" || selectedCode === "-1" || selectedCode === "YARN COLOR CODE") {
                    selectedCode = "";
                }
                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        let cCode = (item.CompanyColourCode || "").trim();
                        if (cCode && $("#ddlYarnColorCode option[value='" + cCode + "']").length === 0) {
                            $("#ddlYarnColorCode").append(`<option value="${cCode}" data-colorid="${item.YarnColorID}">${cCode}</option>`);
                        }
                    });
                }
                let companyId = parseInt($("#ddlYarnCompany").val(), 10) || 0;
                let selectedCompanyName = normalize($("#ddlYarnCompany option:selected").text());
                if (companyId > 0 && selectedCompanyName && selectedCompanyName !== "SELECT COMPANY" && data && data.length > 0) {
                    data = data.filter(function (item) {
                        return normalize(item.CompanyName) === selectedCompanyName;
                    });
                }
                if (mId > 0 && data && data.length > 0) {
                    data = data.filter(function (item) {
                        return (parseInt(item.YarnMaterialID, 10) || 0) === mId;
                    });
                }
                let colorIdVal = parseInt($("#ddlYarnColor").val(), 10) || 0;
                if (colorIdVal > 0 && data && data.length > 0) {
                    data = data.filter(function (item) {
                        return (parseInt(item.YarnColorID, 10) || 0) === colorIdVal;
                    });
                }
                if (selectedCode !== "" && data && data.length > 0) {
                    data = data.filter(function (item) {
                        return normalize(item.CompanyColourCode) === selectedCode;
                    });
                }
                if (!data || data.length === 0) {
                    isPendingAvailable = false;
                    tbody.html('<tr><td colspan="6" class="text-center text-muted py-3">No Pending Requirements Found</td></tr>');
                    if (callback) callback();
                    return;
                }
                isPendingAvailable = true;
                $.each(data, function (i, item) {
                    let key = makeKey(item.CompanyName, item.YarnMaterialID, item.YarnColorID, item.CompanyColourCode);
                    let shortKey = `${item.YarnMaterialID}|${item.YarnColorID}`;
                    let codeKey = `${item.YarnMaterialID}|${item.YarnColorID}|${normalize(item.CompanyColourCode)}`;
                    let reqDetailId = parseInt(item.YarnRequirementDetailID) || parseInt(item.YarnRequirementID) || 0;
                    let reqId = parseInt(item.YarnRequirementID) || 0;
                    tbody.append(`
                            <tr><td><input type="checkbox" 
                                           data-key="${key}" 
                                           data-company="${normalize(item.CompanyName)}"
                                           data-materialid="${item.YarnMaterialID}" 
                                           data-colorid="${item.YarnColorID}" 
                                           data-colorcode="${normalize(item.CompanyColourCode)}" 
                                           data-detailid="${reqDetailId}" 
                                           data-reqid="${reqId}" 
                                           class="row-checkbox" 
                                           value="${reqDetailId}">REQ - ${reqId}</td>
                                <td>${item.PartyName || item.CompanyName || ''}</td>
                                <td>${item.YarnMaterial || ''}</td>
                                <td>${item.YarnColor || ''}</td>
                                <td>${item.CompanyColourCode || ''}</td>
                                <td>${item.NoofBoxes}</td>
                            </tr>
                        `);
                    pendingDetailMap[key] = reqDetailId;
                    pendingDetailMap[codeKey] = reqDetailId;
                    pendingDetailMap[shortKey] = reqDetailId;
                    let boxes = parseInt(item.NoofBoxes) || 0;
                    pendingItemWise[key] = (pendingItemWise[key] || 0) + boxes;
                    pendingItemWise[codeKey] = (pendingItemWise[codeKey] || 0) + boxes;
                    pendingItemWise[shortKey] = (pendingItemWise[shortKey] || 0) + boxes;
                });
                if (callback) callback();
            }
            function fetchPending(queryPartyId, onDone) {
                $.ajax({
                    url: "/WebServiceNikunjTextile.asmx/GetPendingYarn",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        partyId: queryPartyId,
                        yarnMaterialID: mId,
                        yarnColorID: validColors
                    }),
                    success: function (res) {
                        let data = res.d;
                        if (typeof data === "string") {
                            data = JSON.parse(data);
                        }
                        onDone(data || []);
                    },
                    error: function () {
                        onDone([]);
                    }
                });
            }
            fetchPending(primaryPartyId, function (data) {
                if (data.length > 0 || primaryPartyId === 0) {
                    renderPendingData(data);
                } else {
                    fetchPending(0, function (allData) {
                        renderPendingData(allData);
                    });
                }
            });
        }
        function highlightMatchedYarnRows() {
            let stockRows = $("#tableYarnOutward tbody tr").filter(function () {
                return $(this).find(".txtStockInput").length > 0;
            });
            if (stockRows.length === 0) return;
            $("#tableYarnOutward tbody tr#noMatchingStockRow").remove();
            let idx = 1;
            stockRows.show().each(function () {
                $(this).find(".rowIndex").text(idx++);
            });
        }
