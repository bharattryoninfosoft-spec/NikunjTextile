            // No pending requirements table in Sundry Party Outward
        }
        function formatDateToISO(dateStr) {
            if (!dateStr) return null;
            if (dateStr.includes("/")) {
                let parts = dateStr.split("/");
                if (parts.length !== 3) return null;
                let day = parts[0].padStart(2, '0');
                let month = parts[1].padStart(2, '0');
                let year = parts[2];
                return `${year}-${month}-${day}`;
            }
            return dateStr;
        }
        function saveYarnOutward() {
            let partyId = parseInt($("#ddlParty").val()) || 0;
            let listNo = $("#ListNo").val();
            let listDate = $("#ListDate").val();
            let godownManager = parseInt($("#ddlYarnGodownManager").val()) || 0;
            let godownId = parseInt($("#ddlGodownMaster").val()) || 0;
            let sundrypartyid = parseInt($("#SundryParty").val()) || 0;
            if (partyId === 0) {
                let partyTypeName = ($("#SundryParty").val() === '2') ? 'Sundry Debtors' : 'Sundry Creditors';
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: 'Please Select ' + partyTypeName + ' Party.',
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (!listNo) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Mention List No.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (!listDate) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Mention List Date.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (godownManager === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Select Godown Manager.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            // Automatically capture any newly entered quantities from #tableYarnOutward if not added yet
            $("#tableYarnOutward tbody tr").each(function () {
                let tr = $(this);
                let input = tr.find(".txtStockInput");
                if (input.length === 0) return;
                let qty = parseInt(input.val(), 10) || 0;
                let stock = parseInt(input.data("stock"), 10) || 0;
                let locId = parseInt(input.data("locationid"), 10) || 0;
                let matId = parseInt(input.data("materialid"), 10) || 0;
                let colId = parseInt(input.data("colorid"), 10) || 0;
                let colCode = (input.data("colorcode") || tr.find("td:eq(5)").text() || "").toString().trim();
                let compId = parseInt(tr.find("#CompanyId").text(), 10) || 0;
                let compName = tr.find("td:eq(2)").text().trim();
                let matName = tr.find("td:eq(3)").text().trim();
                let colName = tr.find("td:eq(4)").text().trim();
                let locTitle = tr.find("td:eq(7)").text().trim();

                if (qty > 0) {
                    let itemKey = makeItemKey(locId, matId, colId, colCode, compId);
                    let existingIdx = selectedOutwardList.findIndex(x => x.Key === itemKey);
                    let itemObj = {
                        Key: itemKey,
                        GodownLocationID: locId,
                        LocationTitle: locTitle,
                        YarnCompanyID: compId,
                        CompanyName: compName,
                        YarnMaterialID: matId,
                        YarnMaterial: matName,
                        YarnColorID: colId,
                        YarnColor: colName,
                        YarnColorCode: colCode,
                        Stock: stock,
                        NoOfBox: qty
                    };
                    if (existingIdx > -1) {
                        selectedOutwardList[existingIdx] = itemObj;
                    } else {
                        selectedOutwardList.push(itemObj);
                    }
                    tr.addClass("table-success");
                }
            });
            renderSelectedOutwardTable();

            let detailList = [];
            selectedOutwardList.forEach(function (item) {
                if (item.NoOfBox > 0) {
                    detailList.push({
                        BillToPartyID: partyId,
                        YarnCompanyID: item.YarnCompanyID,
                        YarnMaterialID: item.YarnMaterialID,
                        YarnColorID: item.YarnColorID,
                        GodownLocationID: item.GodownLocationID,
                        NoOfBox: item.NoOfBox,
                        YarnRequirementDetailID: 0
                    });
                }
            });
            if (detailList.length === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Enter at least one quantity",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            let formattedDate = formatDateToISO($("#ListDate").val());
            if (!formattedDate) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Invalid List Date.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            let outwardId = parseInt($("#YarnOutwardID").val()) || 0;
            let apiUrl = outwardId > 0 ? "/WebServiceNikunjTextile.asmx/UpdateYarnOutward" : "/WebServiceNikunjTextile.asmx/SavedataYarnOutward";
            let btnText = outwardId > 0 ? "Update Yarn OutWard" : "Save Yarn OutWard";

            let master = {
                YarnOutwardID: outwardId,
                GodownID: godownId,
                PartyId: partyId,
                OutwardListDate: formattedDate,
                GodownManagerUserAccountId: godownManager,
                SundryPartyID: sundrypartyid
            };

            $("#savebtn").prop("disabled", true).text("Processing...");

            $.ajax({
                url: apiUrl,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    master: master,
                    detail: detailList
                }),
                success: function (res) {
                    $("#savebtn").prop("disabled", false).text(btnText);
                    let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;
                    let data = Array.isArray(result) ? result[0] : result;
                    if (data && data.Status == 1) {
                        Swal.fire({
                            title: 'Success!',
                            text: data.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = 'YarnOutWardChallanDetails';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: data.Message || "Error saving data",
                            icon: 'error'
                        });
                    }
                },
                error: function (xhr) {
                    $("#savebtn").prop("disabled", false).text(btnText);
                    console.error(xhr.responseText);
                    Swal.fire({
                        title: 'Server Error',
                        text: 'An error occurred while saving.',
                        icon: 'error'
                    });
                }
            });
        }
        $(document).on("change", ".row-checkbox", function () {
            let currentChk = $(this);
            let key = normalize(currentChk.data("key"));
            let inputs = $(".txtStockInput").filter(function () {
                let inpKey = normalize($(this).data("key"));
                return inpKey === key;
            });
            let maxCapacity = 0;
            inputs.each(function () {
                maxCapacity += parseInt($(this).data("stock")) || 0;
            });
            let selectedStock = 0;
            $(".row-checkbox:checked").not(currentChk).each(function () {
                let chk = $(this);
                let chkKey = normalize(chk.data("key"));
                if (chkKey === key) {
                    selectedStock += parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                }
            });
            let currentStock = parseInt(currentChk.closest("tr").find("td:eq(5)").text()) || 0;
            if (currentChk.is(":checked")) {
                let tempTotal = selectedStock + currentStock;
                let usableTemp = Math.min(tempTotal, maxCapacity);
                if (usableTemp <= selectedStock) {
                    currentChk.prop("checked", false);
                    Swal.fire({
                        icon: "warning",
                        title: "Limit Reached",
                        text: "Stock already fully allocated!"
                    });
                    return;
                }
            }
            let selectedData = [];
            $(".row-checkbox:checked").each(function () {
                let chk = $(this);
                let chkKey = normalize(chk.data("key"));
                if (chkKey === key) {
                    let stock = parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                    let detailId = parseInt(chk.data("detailid")) || parseInt(chk.data("reqid")) || parseInt(chk.val()) || 0;
                    selectedData.push({
                        id: detailId,
                        stock: stock
                    });
                }
            });
            globalYarnMap[key] = selectedData;
            let totalStock = selectedData.reduce((sum, x) => sum + x.stock, 0);
            let usableStock = Math.min(totalStock, maxCapacity);
            let totalFilled = 0;
            inputs.val(0);
            inputs.each(function () {
                let input = $(this);
                let max = parseInt(input.data("stock")) || 0;
                let remaining = usableStock - totalFilled;
                if (remaining <= 0) {
                    input.val(0);
                    return;
                }
                let fill = Math.min(max, remaining);
                input.val(fill);
                input.data("old", fill);
                totalFilled += fill;
            });
            highlightMatchedYarnRows();
        });
    </script>
}
