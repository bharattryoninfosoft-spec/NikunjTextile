@using System;
@using System.Data;
@using System.Data.SqlClient;
@using System.Configuration;
@using System.Collections.Generic;
@using System.Web.Script.Serialization;

@{
    // Handler 1: Material Quality Wise Stock Report (Completely Independent of Production Orders)
    // Direct from Yarn Inward (In-House Stock), Jobber Outward (Given to Jobber), and Jobber Inward (Accepted / Returned)
    if (Request["handler"] == "GetMaterialReport" || Request["handler"] == "GetMaterialQualityStockReport")
    {
        Response.ContentType = "application/json";
        Response.Clear();

        try
        {
            string dateFrom = (Request["dateFrom"] ?? "").Trim();
            string dateTo = (Request["dateTo"] ?? "").Trim();
            string jobberIdStr = (Request["jobberId"] ?? "ALL").Trim();

            long filterJobberId = 0;
            long.TryParse(jobberIdStr, out filterJobberId);

            Func<string, DateTime?> parseDate = (str) =>
            {
                if (string.IsNullOrWhiteSpace(str)) return null;
                str = str.Trim();
                DateTime dt;
                string[] formats = new string[] {
                    "yyyy-MM-dd", "yyyy/MM/dd", "dd/MM/yyyy", "dd-MM-yyyy", "MM/dd/yyyy", "MM-dd-yyyy", "yyyy-MM-ddTHH:mm:ss"
                };
                if (DateTime.TryParseExact(str, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out dt))
                    return dt;
                if (DateTime.TryParse(str, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out dt))
                    return dt;
                if (DateTime.TryParse(str, out dt))
                    return dt;
                return null;
            };

            DateTime? parsedDateFrom = parseDate(dateFrom);
            DateTime? parsedDateTo = parseDate(dateTo);

            string connectionString = ConfigurationManager.ConnectionStrings["sqlconnstr"].ConnectionString;

            // Structure to hold in-house stock: Key = "Material|Color"
            var inHouseStockMap = new Dictionary<string, decimal>();

            // Structure to hold outward & inward details
            var transactionList = new List<Dictionary<string, object>>();

            using (SqlConnection con = new SqlConnection(connectionString))
            {
                con.Open();

                // 1. Query In-House Available Stock from Godown (YarnInwardDetail not yet outwarded)
                try
                {
                    string inHouseSql = @"
                    SELECT 
                        ISNULL(YMM.YarnMaterial, 'Other') AS YarnMaterial,
                        ISNULL(YCM.YarnColor, '') AS YarnColor,
                        CAST(SUM(ISNULL(YID.NetWeight, 0)) AS DECIMAL(18,2)) AS InHouseQty
                    FROM YarnInwardDetail YID
                    INNER JOIN YarnInwardMaster YIM ON YID.YarnInwardID = YIM.YarnInwardID
                    LEFT JOIN YarnMaterialMaster YMM ON YMM.YarnMaterialID = YIM.YarnMaterialID
                    LEFT JOIN YarnColorMaster YCM ON YCM.YarnColorID = YIM.YarnColorID
                    WHERE ISNULL(YID.BoxNo, '') <> ''
                      AND NOT EXISTS (
                          SELECT 1 FROM YARNOUTWARDScanMasterDetails YOSD WHERE YOSD.BarcodeNo = YID.BarcodeNo
                      )
                      AND NOT EXISTS (
                          SELECT 1 FROM JobberOutwardDetail JOD WHERE JOD.BarcodeNo = YID.BarcodeNo
                      )
                    GROUP BY YMM.YarnMaterial, YCM.YarnColor";

                    using (SqlCommand cmdInHouse = new SqlCommand(inHouseSql, con))
                    {
                        using (SqlDataReader dr = cmdInHouse.ExecuteReader())
                        {
                            while (dr.Read())
                            {
                                string mat = dr["YarnMaterial"].ToString().Trim();
                                string col = dr["YarnColor"].ToString().Trim();
                                decimal qty = Convert.ToDecimal(dr["InHouseQty"]);
                                string key = (mat + "|" + col).ToUpper();
                                inHouseStockMap[key] = qty;
                            }
                        }
                    }
                }
                catch { }

                // 2. Query Jobber Outward Transactions (Given to Jobber) - from JobberOutwardMaster & JobberOutwardDetail
                try
                {
                    string jobberOutwardSql = @"
                    SELECT 
                        'JOBBER' AS SourceType,
                        JOM.JobberOutwardID AS OutwardID,
                        CAST(ISNULL(JOM.OutwardListNo, '') AS VARCHAR(50)) AS ChallanNo,
                        JOM.OutwardListDate AS OutwardDate,
                        CONVERT(VARCHAR(10), JOM.OutwardListDate, 103) AS OutwardDateFormatted,
                        ISNULL(JOM.PartyId, 0) AS JobberPartyID,
                        ISNULL(PM.PartyName, ISNULL(JM.PartyName, 'Unknown Jobber')) AS JobberName,
                        ISNULL(YMM.YarnMaterial, 'Unknown Material') AS YarnMaterial,
                        ISNULL(YCM.YarnColor, '') AS YarnColor,
                        CAST(ISNULL(JOD.NetWeight, 0) AS DECIMAL(18,2)) AS OutwardWeight,
                        ISNULL(JOD.BarcodeNo, '') AS BarcodeNo,
                        ISNULL(JOD.BoxNo, '') AS BoxNo
                    FROM JobberOutwardMaster JOM
                    INNER JOIN JobberOutwardDetail JOD ON JOD.JobberOutwardID = JOM.JobberOutwardID
                    LEFT JOIN PartyMaster PM ON PM.PartyId = JOM.PartyId
                    LEFT JOIN JobberMaster JM ON JM.Id = JOM.PartyId
                    LEFT JOIN YarnMaterialMaster YMM ON YMM.YarnMaterialID = JOD.YarnMaterialID
                    LEFT JOIN YarnColorMaster YCM ON YCM.YarnColorID = JOD.YarnColorID
                    WHERE 1 = 1";

                    if (filterJobberId > 0)
                    {
                        jobberOutwardSql += " AND (JOM.PartyId = @JobberID OR JM.Id = @JobberID)";
                    }
                    if (parsedDateFrom.HasValue)
                    {
                        jobberOutwardSql += " AND JOM.OutwardListDate >= @DateFrom";
                    }
                    if (parsedDateTo.HasValue)
                    {
                        jobberOutwardSql += " AND JOM.OutwardListDate <= @DateTo";
                    }

                    using (SqlCommand cmdJOM = new SqlCommand(jobberOutwardSql, con))
                    {
                        if (filterJobberId > 0)
                        {
                            cmdJOM.Parameters.AddWithValue("@JobberID", filterJobberId);
                        }
                        if (parsedDateFrom.HasValue)
                        {
                            cmdJOM.Parameters.AddWithValue("@DateFrom", parsedDateFrom.Value.Date);
                        }
                        if (parsedDateTo.HasValue)
                        {
                            cmdJOM.Parameters.AddWithValue("@DateTo", parsedDateTo.Value.Date.AddDays(1).AddTicks(-1));
                        }

                        using (SqlDataReader dr = cmdJOM.ExecuteReader())
                        {
                            while (dr.Read())
                            {
                                transactionList.Add(new Dictionary<string, object>
                                {
                                    { "SourceType", "JOBBER" },
                                    { "OutwardID", dr["OutwardID"] },
                                    { "ChallanNo", dr["ChallanNo"].ToString() },
                                    { "OutwardDate", dr["OutwardDateFormatted"].ToString() },
                                    { "JobberPartyID", dr["JobberPartyID"] },
                                    { "JobberName", dr["JobberName"].ToString() },
                                    { "YarnMaterial", dr["YarnMaterial"].ToString().Trim() },
                                    { "YarnColor", dr["YarnColor"].ToString().Trim() },
                                    { "OutwardWeight", Convert.ToDecimal(dr["OutwardWeight"]) },
                                    { "BarcodeNo", dr["BarcodeNo"].ToString().Trim() }
                                });
                            }
                        }
                    }
                }
                catch { }

                // 3. Query Admin / General Yarn Outward (YarnOutwardMaster + YarnOutwardScanMasterDetails)
                try
                {
                    string adminOutwardSql = @"
                    SELECT 
                        'ADMIN' AS SourceType,
                        YOM.YarnOutwardID AS OutwardID,
                        CAST(ISNULL(YOM.OutwardListNo, '') AS VARCHAR(50)) AS ChallanNo,
                        YOSM.ChallanDate AS OutwardDate,
                        CONVERT(VARCHAR(10), YOSM.ChallanDate, 103) AS OutwardDateFormatted,
                        ISNULL(YOM.PartyId, 0) AS JobberPartyID,
                        ISNULL(PM.PartyName, ISNULL(JM.PartyName, 'Unknown Jobber')) AS JobberName,
                        ISNULL(YMM.YarnMaterial, 'Unknown Material') AS YarnMaterial,
                        ISNULL(YCM.YarnColor, '') AS YarnColor,
                        CAST(ISNULL(YOSD.NetWeight, 0) AS DECIMAL(18,2)) AS OutwardWeight,
                        ISNULL(YOSD.BarcodeNo, '') AS BarcodeNo
                    FROM YarnOutwardMaster YOM
                    INNER JOIN YarnOutwardScanMaster YOSM ON YOSM.YarnOutwardID = YOM.YarnOutwardID
                    INNER JOIN YarnOutwardScanMasterDetails YOSD ON YOSD.YarnOutwardScanID = YOSM.YarnOutwardScanID
                    LEFT JOIN PartyMaster PM ON PM.PartyId = YOM.PartyId
                    LEFT JOIN JobberMaster JM ON JM.Id = YOM.PartyId
                    LEFT JOIN YarnMaterialMaster YMM ON YMM.YarnMaterialID = YOSD.YarnMaterial
                    LEFT JOIN YarnColorMaster YCM ON YCM.YarnColorID = YOSD.YarnColour
                    WHERE 1 = 1";

                    if (filterJobberId > 0)
                    {
                        adminOutwardSql += " AND (YOM.PartyId = @JobberID OR JM.Id = @JobberID)";
                    }
                    if (parsedDateFrom.HasValue)
                    {
                        adminOutwardSql += " AND YOSM.ChallanDate >= @DateFrom";
                    }
                    if (parsedDateTo.HasValue)
                    {
                        adminOutwardSql += " AND YOSM.ChallanDate <= @DateTo";
                    }

                    using (SqlCommand cmdAOM = new SqlCommand(adminOutwardSql, con))
                    {
                        if (filterJobberId > 0)
                        {
                            cmdAOM.Parameters.AddWithValue("@JobberID", filterJobberId);
                        }
                        if (parsedDateFrom.HasValue)
                        {
                            cmdAOM.Parameters.AddWithValue("@DateFrom", parsedDateFrom.Value.Date);
                        }
                        if (parsedDateTo.HasValue)
                        {
                            cmdAOM.Parameters.AddWithValue("@DateTo", parsedDateTo.Value.Date.AddDays(1).AddTicks(-1));
                        }

                        using (SqlDataReader dr = cmdAOM.ExecuteReader())
                        {
                            while (dr.Read())
                            {
                                transactionList.Add(new Dictionary<string, object>
                                {
                                    { "SourceType", "ADMIN" },
                                    { "OutwardID", dr["OutwardID"] },
                                    { "ChallanNo", dr["ChallanNo"].ToString() },
                                    { "OutwardDate", dr["OutwardDateFormatted"].ToString() },
                                    { "JobberPartyID", dr["JobberPartyID"] },
                                    { "JobberName", dr["JobberName"].ToString() },
                                    { "YarnMaterial", dr["YarnMaterial"].ToString().Trim() },
                                    { "YarnColor", dr["YarnColor"].ToString().Trim() },
                                    { "OutwardWeight", Convert.ToDecimal(dr["OutwardWeight"]) },
                                    { "BarcodeNo", dr["BarcodeNo"].ToString().Trim() }
                                });
                            }
                        }
                    }
                }
                catch { }

                // 4. Query Jobber Inwards (Jobber ne accept kiya, return kiya)
                var outwardInwardMap = new Dictionary<long, decimal>();
                var barcodeInwardMap = new HashSet<string>();

                try
                {
                    string inwardSql = @"
                    SELECT 
                        ISNULL(JIM.JobWorkOutwardId, 0) AS JobWorkOutwardId,
                        ISNULL(JIM.TotalWeight, 0) AS TotalWeight,
                        ISNULL(JIM.PendingWeight, 0) AS PendingWeight,
                        ISNULL(JID.BarcodeNo, '') AS BarcodeNo,
                        CAST(ISNULL(JID.NetWeight, 0) AS DECIMAL(18,2)) AS InwardWeight
                    FROM JobberInwardMaster JIM
                    LEFT JOIN JobberInwardDetail JID ON JID.JobberInwardID = JIM.JobberInwardId";

                    using (SqlCommand cmdInw = new SqlCommand(inwardSql, con))
                    {
                        using (SqlDataReader dr = cmdInw.ExecuteReader())
                        {
                            while (dr.Read())
                            {
                                long oId = Convert.ToInt64(dr["JobWorkOutwardId"]);
                                decimal tot = Convert.ToDecimal(dr["TotalWeight"]);
                                decimal pnd = Convert.ToDecimal(dr["PendingWeight"]);
                                decimal rec = tot - pnd;
                                if (rec < 0) { rec = 0; }

                                if (oId > 0 && !outwardInwardMap.ContainsKey(oId))
                                {
                                    outwardInwardMap[oId] = rec;
                                }

                                string bc = dr["BarcodeNo"].ToString().Trim();
                                if (!string.IsNullOrEmpty(bc))
                                {
                                    barcodeInwardMap.Add(bc);
                                }
                            }
                        }
                    }
                }
                catch { }

                // 5. Consolidate by Material Quality (YarnMaterial & YarnColor)
                // Result structure: MaterialQuality | Particular | YarnColor | InHouseStock | GivenToJobber | AcceptedByJobber | ReturnedByJobber | BalanceWithJobber | Jobbers
                var materialMap = new Dictionary<string, Dictionary<string, object>>();

                // First seed with In-House Stock items so they appear even if nothing was given to jobbers yet
                foreach (var kvp in inHouseStockMap)
                {
                    string[] parts = kvp.Key.Split('|');
                    string mat = parts[0];
                    string col = parts.Length > 1 ? parts[1] : "";
                    string particular = (!string.IsNullOrEmpty(col) && !string.IsNullOrEmpty(mat))
                        ? col + " - " + mat
                        : (!string.IsNullOrEmpty(mat) ? mat : col);

                    materialMap[kvp.Key] = new Dictionary<string, object>
                    {
                        { "MaterialQuality", mat },
                        { "YarnColor", col },
                        { "Particular", particular },
                        { "InHouseStock", kvp.Value },
                        { "GivenToJobber", 0m },
                        { "AcceptedByJobber", 0m },
                        { "ReturnedByJobber", 0m },
                        { "BalanceWithJobber", 0m },
                        { "Jobbers", new HashSet<string>() },
                        { "Challans", new HashSet<string>() },
                        { "ChallanCount", 0 }
                    };
                }

                // Process Transactions
                var detailedTransactionRows = new List<object>();

                foreach (var tx in transactionList)
                {
                    string mat = tx["YarnMaterial"].ToString().Trim();
                    string col = tx["YarnColor"].ToString().Trim();
                    string particular = (!string.IsNullOrEmpty(col) && !string.IsNullOrEmpty(mat))
                        ? col + " - " + mat
                        : (!string.IsNullOrEmpty(mat) ? mat : col);

                    string key = (mat + "|" + col).ToUpper();
                    decimal outWt = Convert.ToDecimal(tx["OutwardWeight"]);
                    string jobber = tx["JobberName"].ToString().Trim();
                    string challan = tx["ChallanNo"].ToString().Trim();
                    long outId = Convert.ToInt64(tx["OutwardID"]);
                    string bc = tx["BarcodeNo"].ToString().Trim();

                    // Check accepted / returned
                    decimal acceptedWt = 0;
                    decimal returnWt = 0;

                    if (outwardInwardMap.ContainsKey(outId))
                    {
                        acceptedWt = outwardInwardMap[outId];
                    }
                    else if (!string.IsNullOrEmpty(bc) && barcodeInwardMap.Contains(bc))
                    {
                        acceptedWt = outWt;
                    }

                    if (acceptedWt > outWt)
                    {
                        returnWt = acceptedWt - outWt;
                        acceptedWt = outWt;
                    }

                    decimal balanceWt = outWt - acceptedWt;
                    if (balanceWt < 0) { balanceWt = 0; }

                    string status = balanceWt <= 0 ? "Accepted" : "With Jobber";

                    detailedTransactionRows.Add(new
                    {
                        SourceType = tx["SourceType"],
                        ChallanNo = challan,
                        OutwardDate = tx["OutwardDate"],
                        JobberName = jobber,
                        MaterialQuality = mat,
                        YarnColor = col,
                        Particular = particular,
                        GivenWeight = outWt,
                        AcceptedWeight = acceptedWt,
                        ReturnWeight = returnWt,
                        BalanceWeight = balanceWt,
                        Status = status
                    });

                    if (!materialMap.ContainsKey(key))
                    {
                        materialMap[key] = new Dictionary<string, object>
                        {
                            { "MaterialQuality", mat },
                            { "YarnColor", col },
                            { "Particular", particular },
                            { "InHouseStock", 0m },
                            { "GivenToJobber", outWt },
                            { "AcceptedByJobber", acceptedWt },
                            { "ReturnedByJobber", returnWt },
                            { "BalanceWithJobber", balanceWt },
                            { "Jobbers", new HashSet<string> { jobber } },
                            { "Challans", new HashSet<string> { challan } },
                            { "ChallanCount", 1 }
                        };
                    }
                    else
                    {
                        var mEntry = materialMap[key];
                        mEntry["GivenToJobber"] = Convert.ToDecimal(mEntry["GivenToJobber"]) + outWt;
                        mEntry["AcceptedByJobber"] = Convert.ToDecimal(mEntry["AcceptedByJobber"]) + acceptedWt;
                        mEntry["ReturnedByJobber"] = Convert.ToDecimal(mEntry["ReturnedByJobber"]) + returnWt;
                        mEntry["BalanceWithJobber"] = Convert.ToDecimal(mEntry["BalanceWithJobber"]) + balanceWt;
                        mEntry["ChallanCount"] = Convert.ToInt32(mEntry["ChallanCount"]) + 1;
                        ((HashSet<string>)mEntry["Jobbers"]).Add(jobber);
                        ((HashSet<string>)mEntry["Challans"]).Add(challan);
                    }
                }

                // If both Outward and In-House were empty, check ProductionOrderDetail as secondary fallback
                if (materialMap.Count == 0)
                {
                    try
                    {
                        string fbProdSql = @"
                        SELECT 
                            ISNULL(NULLIF(pod.WeftQuality, ''), 'General Quality') AS YarnMaterial,
                            ISNULL(NULLIF(pod.ColourMatchingName, ''), '') AS YarnColor,
                            ISNULL(jm.PartyName, 'Jobber Assigned') AS JobberName,
                            CAST(SUM(ISNULL(pod.PCS, 0)) AS DECIMAL(18,2)) AS OrderQty,
                            CAST(SUM(ISNULL(pod.ProductionPCS, 0)) AS DECIMAL(18,2)) AS AllottedQty
                        FROM ProductionOrderDetail pod
                        LEFT JOIN ProductionOrderMaster pom ON pom.ProductionOrderID = pod.ProductionOrderID
                        LEFT JOIN JobberMaster jm ON pom.JobWorkerID = jm.Id
                        WHERE ISNULL(pod.IsActive, 1) = 1
                        GROUP BY pod.WeftQuality, pod.ColourMatchingName, jm.PartyName";

                        using (SqlCommand cmdFb = new SqlCommand(fbProdSql, con))
                        {
                            using (SqlDataReader dr = cmdFb.ExecuteReader())
                            {
                                while (dr.Read())
                                {
                                    string mat = dr["YarnMaterial"].ToString().Trim();
                                    string col = dr["YarnColor"].ToString().Trim();
                                    string particular = (!string.IsNullOrEmpty(col) && !string.IsNullOrEmpty(mat))
                                        ? col + " - " + mat
                                        : (!string.IsNullOrEmpty(mat) ? mat : col);

                                    string key = (mat + "|" + col).ToUpper();
                                    decimal allotted = Convert.ToDecimal(dr["AllottedQty"]);
                                    string jName = dr["JobberName"].ToString().Trim();

                                    materialMap[key] = new Dictionary<string, object>
                                    {
                                        { "MaterialQuality", mat },
                                        { "YarnColor", col },
                                        { "Particular", particular },
                                        { "InHouseStock", 0m },
                                        { "GivenToJobber", allotted },
                                        { "AcceptedByJobber", 0m },
                                        { "ReturnedByJobber", 0m },
                                        { "BalanceWithJobber", allotted },
                                        { "Jobbers", new HashSet<string> { jName } },
                                        { "Challans", new HashSet<string> { "-" } },
                                        { "ChallanCount", 1 }
                                    };
                                }
                            }
                        }
                    }
                    catch { }
                }

                // If a specific jobber is filtered, only show materials relevant to this jobber
                if (filterJobberId > 0)
                {
                    var filteredMap = new Dictionary<string, Dictionary<string, object>>();
                    foreach (var kvp in materialMap)
                    {
                        decimal given = Convert.ToDecimal(kvp.Value["GivenToJobber"]);
                        decimal balance = Convert.ToDecimal(kvp.Value["BalanceWithJobber"]);
                        if (given > 0 || balance > 0)
                        {
                            filteredMap[kvp.Key] = kvp.Value;
                        }
                    }
                    materialMap = filteredMap;
                }

                // Prepare final list sorted by Material Quality
                var materialReportList = new List<object>();
                decimal grandTotalInHouse = 0;
                decimal grandTotalGiven = 0;
                decimal grandTotalAccepted = 0;
                decimal grandTotalReturned = 0;
                decimal grandTotalBalance = 0;

                foreach (var kvp in materialMap)
                {
                    var m = kvp.Value;
                    decimal inHouse = Math.Round(Convert.ToDecimal(m["InHouseStock"]), 2);
                    decimal given = Math.Round(Convert.ToDecimal(m["GivenToJobber"]), 2);
                    decimal accepted = Math.Round(Convert.ToDecimal(m["AcceptedByJobber"]), 2);
                    decimal returned = Math.Round(Convert.ToDecimal(m["ReturnedByJobber"]), 2);
                    decimal balance = Math.Round(Convert.ToDecimal(m["BalanceWithJobber"]), 2);

                    grandTotalInHouse += inHouse;
                    grandTotalGiven += given;
                    grandTotalAccepted += accepted;
                    grandTotalReturned += returned;
                    grandTotalBalance += balance;

                    materialReportList.Add(new
                    {
                        MaterialQuality = m["MaterialQuality"],
                        YarnColor = m["YarnColor"],
                        Particular = m["Particular"],
                        InHouseStock = inHouse,
                        GivenToJobber = given,
                        AcceptedByJobber = accepted,
                        ReturnedByJobber = returned,
                        BalanceWithJobber = balance,
                        Jobbers = string.Join(", ", (HashSet<string>)m["Jobbers"]),
                        ChallanCount = m["ChallanCount"]
                    });
                }

                materialReportList.Sort((a, b) =>
                {
                    dynamic da = a, db = b;
                    return string.Compare(da.Particular.ToString(), db.Particular.ToString(), StringComparison.OrdinalIgnoreCase);
                });

                var serializer = new JavaScriptSerializer { MaxJsonLength = int.MaxValue };
                Response.Write(serializer.Serialize(new
                {
                    status = "success",
                    data = materialReportList,
                    detailedTransactions = detailedTransactionRows,
                    kpi = new
                    {
                        inHouseStock = grandTotalInHouse,
                        givenToJobber = grandTotalGiven,
                        acceptedByJobber = grandTotalAccepted,
                        returnedByJobber = grandTotalReturned,
                        balanceWithJobber = grandTotalBalance,
                        totalMaterials = materialReportList.Count
                    }
                }));
            }
        }
        catch (Exception ex)
        {
            var serializer = new JavaScriptSerializer();
            Response.Write(serializer.Serialize(new { status = "error", message = ex.Message }));
        }

        Response.End();
        return;
    }

    // Handler 2: Production Order & Slip Level Report (Kept as secondary view)
    if (Request["handler"] == "GetStockReport")
    {
        Response.ContentType = "application/json";
        Response.Clear();

        try
        {
            string dateFrom = (Request["dateFrom"] ?? "").Trim();
            string dateTo = (Request["dateTo"] ?? "").Trim();
            string jobberIdStr = (Request["jobberId"] ?? "ALL").Trim();
            string statusFilter = (Request["statusFilter"] ?? "ALL").Trim();

            long filterJobberId = 0;
            long.TryParse(jobberIdStr, out filterJobberId);

            Func<string, DateTime?> parseDate = (str) =>
            {
                if (string.IsNullOrWhiteSpace(str)) return null;
                str = str.Trim();
                DateTime dt;
                string[] formats = new string[] {
                    "yyyy-MM-dd", "yyyy/MM/dd", "dd/MM/yyyy", "dd-MM-yyyy", "MM/dd/yyyy", "MM-dd-yyyy", "yyyy-MM-ddTHH:mm:ss"
                };
                if (DateTime.TryParseExact(str, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out dt))
                    return dt;
                if (DateTime.TryParse(str, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out dt))
                    return dt;
                if (DateTime.TryParse(str, out dt))
                    return dt;
                return null;
            };

            DateTime? parsedDtFrom = parseDate(dateFrom);
            DateTime? parsedDtTo = parseDate(dateTo);

            var list = new List<object>();
            string connectionString = ConfigurationManager.ConnectionStrings["sqlconnstr"].ConnectionString;

            using (SqlConnection con = new SqlConnection(connectionString))
            {
                con.Open();

                string sql = @"
                SELECT 
                    pom.ProductionOrderID,
                    ISNULL(pom.ProductionOrderNo, '') AS ProductionOrderNo,
                    pom.ProductionOrderDate,
                    CONVERT(VARCHAR(10), pom.ProductionOrderDate, 103) AS ProductionOrderDateFormatted,
                    ISNULL(pom.JobWorkerID, 0) AS JobWorkerID,
                    ISNULL(jm.PartyName, ISNULL(pom.JobWorkerName, 'Jobber Not Assigned')) AS JobWorkerName,
                    pod.ProductionOrderDetailID,
                    ISNULL(pod.SalesOrderID, 0) AS SalesOrderID,
                    ISNULL(NULLIF(pod.SalesOrderNo, ''), ISNULL(so.OrderNo, '')) AS SalesOrderNo,
                    pod.OrderDate,
                    CONVERT(VARCHAR(10), pod.OrderDate, 103) AS OrderDateFormatted,
                    ISNULL(pod.PartyID, ISNULL(so.PartyID, 0)) AS PartyID,
                    ISNULL(NULLIF(pod.PartyName, ''), ISNULL(pm.PartyName, '')) AS PartyName,
                    ISNULL(pod.SlipNo, '') AS SlipNo,
                    ISNULL(pod.DesignNo, '') AS DesignNo,
                    ISNULL(pod.ColourMatchingName, '') AS ColourMatchingName,
                    CAST(ISNULL(NULLIF(sods.Qty, 0), ISNULL(NULLIF(sod.Qty, 0), pod.PCS)) AS DECIMAL(18,2)) AS StockBeforeProduction,
                    CAST(ISNULL(pod.ProductionPCS, 0) AS DECIMAL(18,2)) AS AllottedToJobber,
                    CAST(CASE 
                        WHEN ISNULL(NULLIF(sods.Qty, 0), ISNULL(NULLIF(sod.Qty, 0), pod.PCS)) >= ISNULL(pod.ProductionPCS, 0)
                        THEN ISNULL(NULLIF(sods.Qty, 0), ISNULL(NULLIF(sod.Qty, 0), pod.PCS)) - ISNULL(pod.ProductionPCS, 0)
                        ELSE ISNULL(pod.PendingPCS, 0)
                    END AS DECIMAL(18,2)) AS InHouseRemainingStock,
                    CAST(ISNULL(recv.ReceivedPCS, 0) AS DECIMAL(18,2)) AS ReceivedFromJobber,
                    CAST(CASE 
                        WHEN (ISNULL(pod.ProductionPCS, 0) - ISNULL(recv.ReceivedPCS, 0)) > 0 
                        THEN (ISNULL(pod.ProductionPCS, 0) - ISNULL(recv.ReceivedPCS, 0)) 
                        ELSE 0 
                    END AS DECIMAL(18,2)) AS StockWithJobber
                FROM ProductionOrderMaster pom
                INNER JOIN ProductionOrderDetail pod ON pom.ProductionOrderID = pod.ProductionOrderID AND ISNULL(pod.IsActive, 1) = 1
                LEFT JOIN JobberMaster jm ON pom.JobWorkerID = jm.Id
                LEFT JOIN SaleOrder so ON pod.SalesOrderID = so.SaleOrderID
                LEFT JOIN PartyMaster pm ON ISNULL(pod.PartyID, so.PartyID) = pm.PartyID
                LEFT JOIN SaleOrderDetails sod ON pod.SalesOrderDetailID = sod.DetailID
                LEFT JOIN SaleOrderSubDetails sods ON pod.SubDetailID = sods.SubDetailID
                OUTER APPLY (
                    SELECT ISNULL(SUM(PTD.ReceivePCS), 0) AS ReceivedPCS
                    FROM ProcessTransactionDetail PTD
                    WHERE PTD.ProductionOrderDetailID = pod.ProductionOrderDetailID
                      AND ISNULL(PTD.IsActive, 1) = 1
                      AND PTD.ReceivePCS > 0
                ) recv
                WHERE ISNULL(pom.IsActive, 1) = 1";

                if (filterJobberId > 0)
                {
                    sql += " AND (pom.JobWorkerID = @JobberID OR jm.Id = @JobberID)";
                }
                if (parsedDtFrom.HasValue)
                {
                    sql += " AND pom.ProductionOrderDate >= @DateFrom";
                }
                if (parsedDtTo.HasValue)
                {
                    sql += " AND pom.ProductionOrderDate <= @DateTo";
                }

                sql += " ORDER BY pom.ProductionOrderID DESC, pod.ProductionOrderDetailID ASC";

                using (SqlCommand cmd = new SqlCommand(sql, con))
                {
                    if (filterJobberId > 0)
                    {
                        cmd.Parameters.AddWithValue("@JobberID", filterJobberId);
                    }
                    if (parsedDtFrom.HasValue)
                    {
                        cmd.Parameters.AddWithValue("@DateFrom", parsedDtFrom.Value.Date);
                    }
                    if (parsedDtTo.HasValue)
                    {
                        cmd.Parameters.AddWithValue("@DateTo", parsedDtTo.Value.Date.AddDays(1).AddTicks(-1));
                    }

                    using (SqlDataReader dr = cmd.ExecuteReader())
                    {
                        while (dr.Read())
                        {
                            decimal beforeStock = Convert.ToDecimal(dr["StockBeforeProduction"]);
                            decimal allotted = Convert.ToDecimal(dr["AllottedToJobber"]);
                            decimal inHouseBalance = Convert.ToDecimal(dr["InHouseRemainingStock"]);
                            decimal receivedBack = Convert.ToDecimal(dr["ReceivedFromJobber"]);
                            decimal withJobber = Convert.ToDecimal(dr["StockWithJobber"]);

                            string status = "With Jobber";
                            if (allotted > 0 && withJobber <= 0)
                            {
                                status = "Completed";
                            }
                            else if (receivedBack > 0 && withJobber > 0)
                            {
                                status = "Partially Received";
                            }

                            if (statusFilter == "WITH_JOBBER" && withJobber <= 0)
                            {
                                continue;
                            }
                            if (statusFilter == "COMPLETED" && status != "Completed")
                            {
                                continue;
                            }
                            if (statusFilter == "INHOUSE_PENDING" && inHouseBalance <= 0)
                            {
                                continue;
                            }

                            list.Add(new
                            {
                                ProductionOrderID = dr["ProductionOrderID"],
                                ProductionOrderNo = dr["ProductionOrderNo"].ToString(),
                                ProductionOrderDate = dr["ProductionOrderDateFormatted"].ToString(),
                                JobWorkerID = dr["JobWorkerID"],
                                JobWorkerName = dr["JobWorkerName"].ToString(),
                                ProductionOrderDetailID = dr["ProductionOrderDetailID"],
                                SalesOrderID = dr["SalesOrderID"],
                                SalesOrderNo = dr["SalesOrderNo"].ToString(),
                                OrderDate = dr["OrderDateFormatted"].ToString(),
                                PartyID = dr["PartyID"],
                                PartyName = dr["PartyName"].ToString(),
                                SlipNo = dr["SlipNo"].ToString(),
                                DesignNo = dr["DesignNo"].ToString(),
                                ColourMatchingName = dr["ColourMatchingName"].ToString(),
                                StockBeforeProduction = beforeStock,
                                AllottedToJobber = allotted,
                                InHouseRemainingStock = inHouseBalance,
                                ReceivedFromJobber = receivedBack,
                                StockWithJobber = withJobber,
                                Status = status
                            });
                        }
                    }
                }
            }

            var serializer = new JavaScriptSerializer { MaxJsonLength = int.MaxValue };
            Response.Write(serializer.Serialize(new { status = "success", data = list }));
        }
        catch (Exception ex)
        {
            var serializer = new JavaScriptSerializer();
            Response.Write(serializer.Serialize(new { status = "error", message = ex.Message }));
        }

        Response.End();
        return;
    }

    // Handler 3: Jobber Dropdown List (Combined from JobberMaster and PartyMaster)
    if (Request["handler"] == "GetJobbers")
    {
        Response.ContentType = "application/json";
        Response.Clear();

        try
        {
            var listJobbers = new List<object>();
            string connectionString = ConfigurationManager.ConnectionStrings["sqlconnstr"].ConnectionString;

            using (SqlConnection con = new SqlConnection(connectionString))
            {
                con.Open();
                string sql = @"
                SELECT DISTINCT Id, PartyName FROM (
                    SELECT Id, PartyName FROM JobberMaster WHERE PartyName IS NOT NULL AND PartyName <> ''
                    UNION
                    SELECT PartyId AS Id, PartyName FROM PartyMaster WHERE (SundryParty = 3 OR SundryParty = 2) AND PartyName IS NOT NULL AND PartyName <> ''
                ) tbl ORDER BY PartyName";

                using (SqlCommand cmd = new SqlCommand(sql, con))
                {
                    using (SqlDataReader dr = cmd.ExecuteReader())
                    {
                        while (dr.Read())
                        {
                            listJobbers.Add(new
                            {
                                Id = dr["Id"],
                                Name = dr["PartyName"].ToString()
                            });
                        }
                    }
                }
            }

            var serializer = new JavaScriptSerializer();
            Response.Write(serializer.Serialize(new { status = "success", jobbers = listJobbers }));
        }
        catch (Exception ex)
        {
            var serializer = new JavaScriptSerializer();
            Response.Write(serializer.Serialize(new { status = "error", message = ex.Message }));
        }

        Response.End();
        return;
    }

    Layout = "/_LayoutPage1.cshtml";
}

