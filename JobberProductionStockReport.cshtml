@section Scripts {
    <script>
        var rawTransactionsData = [];
        var filteredTransactionsData = [];

        $(document).ready(function () {
            // Ensure standard application layout
             $('body').addClass('fullscreen');

            // Set past 90 days date range default
            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();
            var todayStr = yyyy + "-" + mm + "-" + dd;

            var pastDate = new Date();
            pastDate.setDate(pastDate.getDate() - 90);
            var pdd = String(pastDate.getDate()).padStart(2, '0');
            var pmm = String(pastDate.getMonth() + 1).padStart(2, '0');
            var pyyyy = pastDate.getFullYear();
            var pastStr = pyyyy + "-" + pmm + "-" + pdd;

            $("#filterFromDate").val(pastStr);
            $("#filterToDate").val(todayStr);

            $(document).on("shown.bs.tab", "#stockReportTabs a", function () {
                updateCounterBadge();
            });

            $(document).on("click", "#stockReportTabs a", function () {
                setTimeout(function () {
                    updateCounterBadge();
                }, 100);
            });

            loadJobberDropdown();
            reloadAllReportData();
        });

        function reloadAllReportData() {
            loadMaterialReportData();
        }

        function loadJobberDropdown() {
            $.ajax({
                url: '/JobberProductionStockReport.cshtml?handler=GetJobbers',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.status === 'success' && res.jobbers) {
                        var $ddl = $("#filterJobber");
                        $ddl.find('option:not(:first)').remove();
                        res.jobbers.forEach(function (j) {
                            $ddl.append($('<option>', { value: j.Id, text: j.Name }));
                        });
                    }
                }
            });
        }

        function loadMaterialReportData() {
            $("#tblTransactionsBody").html('<tr><td colspan="12" class="text-center py-4 text-muted"><i class="fa fa-spinner fa-spin mr-1 me-1"></i> Loading transaction history...</td></tr>');
            $("#tblJobberSummaryBody").html('<tr><td colspan="8" class="text-center py-4 text-muted"><i class="fa fa-spinner fa-spin mr-1 me-1"></i> Loading jobber summary...</td></tr>');

            var fromDate = $("#filterFromDate").val();
            var toDate = $("#filterToDate").val();
            var jobberId = $("#filterJobber").val() || 'ALL';

            $.ajax({
                url: '/JobberProductionStockReport.cshtml?handler=GetMaterialReport',
                type: 'POST',
                data: {
                    dateFrom: fromDate,
                    dateTo: toDate,
                    jobberId: jobberId
                },
                dataType: 'json',
                success: function (res) {
                    if (res && res.status === 'success') {
                        rawTransactionsData = res.detailedTransactions || [];

                        if (res.kpi) {
                            $("#kpiInHouseStock").text(formatNum(res.kpi.inHouseStock));
                            $("#kpiGivenToJobber").text(formatNum(res.kpi.givenToJobber));
                            $("#kpiAcceptedByJobber").text(formatNum(res.kpi.acceptedByJobber));
                            $("#kpiReturnedByJobber").text(formatNum(res.kpi.returnedByJobber));
                            $("#kpiBalanceWithJobber").text(formatNum(res.kpi.balanceWithJobber));
                        }

                        applyQuickSearch();
                    } else {
                        rawTransactionsData = [];
                        renderJobberSummaryTable([]);
                        renderTransactionsTable([]);
                    }
                },
                error: function () {
                    rawTransactionsData = [];
                    $("#tblJobberSummaryBody").html('<tr><td colspan="8" class="text-center text-danger py-4"><i class="fa fa-exclamation-triangle mr-1 me-1"></i> Error loading report. Please retry.</td></tr>');
                    $("#tblTransactionsBody").html('<tr><td colspan="12" class="text-center text-danger py-4"><i class="fa fa-exclamation-triangle mr-1 me-1"></i> Error loading transactions. Please retry.</td></tr>');
                }
            });
        }

        function applyQuickSearch() {
            var q = ($("#tableQuickSearch").val() || '').trim().toLowerCase();

            if (!q) {
                filteredTransactionsData = rawTransactionsData.slice();
            } else {
                filteredTransactionsData = rawTransactionsData.filter(function (tx) {
                    var ch = String(tx.ChallanNo || '').toLowerCase();
                    var jb = String(tx.JobberName || '').toLowerCase();
                    var mat = String(tx.MaterialQuality || '').toLowerCase();
                    var col = String(tx.YarnColor || '').toLowerCase();
                    var src = String(tx.SourceType || '').toLowerCase();
                    var st = String(tx.Status || '').toLowerCase();
                    return ch.indexOf(q) >= 0 || jb.indexOf(q) >= 0 || mat.indexOf(q) >= 0 || col.indexOf(q) >= 0 || src.indexOf(q) >= 0 || st.indexOf(q) >= 0;
                });
            }

            $("#countTransactions").text(formatNum(filteredTransactionsData.length));

            renderJobberSummaryTable(filteredTransactionsData);
            renderTransactionsTable(filteredTransactionsData);
            updateCounterBadge();
        }

        function renderJobberSummaryTable(txData) {
            var tbody = $("#tblJobberSummaryBody");
            tbody.empty();

            var jobberMap = {};
            (txData || []).forEach(function (tx) {
                var jName = tx.JobberName || 'Unknown Jobber';
                if (!jobberMap[jName]) {
                    jobberMap[jName] = {
                        name: jName,
                        challanCount: 0,
                        given: 0,
                        accepted: 0,
                        returned: 0,
                        balance: 0
                    };
                }
                jobberMap[jName].challanCount++;
                jobberMap[jName].given += (parseFloat(tx.GivenWeight) || 0);
                jobberMap[jName].accepted += (parseFloat(tx.AcceptedWeight) || 0);
                jobberMap[jName].returned += (parseFloat(tx.ReturnWeight) || 0);
                jobberMap[jName].balance += (parseFloat(tx.BalanceWeight) || 0);
            });

            var jobberList = Object.values(jobberMap);
            $("#countJobbersSummary").text(jobberList.length);

            if (jobberList.length === 0) {
                tbody.html('<tr><td colspan="8" class="text-center py-4 text-muted"><i class="fa fa-info-circle mr-1 me-1"></i> No jobber summary data available.</td></tr>');
                $("#ftJobberTotalCount").text('0');
                $("#ftJobberGiven").text('0 KG');
                $("#ftJobberAccepted").text('0 KG');
                $("#ftJobberReturned").text('0 KG');
                $("#ftJobberBalance").text('0 KG');
                $("#ftJobberPercent").text('0%');
                return;
            }

            var sumGiven = 0, sumAccepted = 0, sumReturned = 0, sumBalance = 0, sumCount = 0;

            jobberList.forEach(function (j, idx) {
                sumGiven += j.given;
                sumAccepted += j.accepted;
                sumReturned += j.returned;
                sumBalance += j.balance;
                sumCount += j.challanCount;

                var pct = j.given > 0 ? Math.round((j.accepted / j.given) * 100) : 0;
                var progressBadge = pct >= 100 
                    ? '<span style="background: #dcfce7 !important; color: #15803d !important; border: 1px solid #86efac !important; padding: 2px 8px; border-radius: 12px; font-weight: 700; font-size: 0.78rem;">100%</span>'
                    : (pct > 0 
                        ? '<span style="background: #fef3c7 !important; color: #b45309 !important; border: 1px solid #fde68a !important; padding: 2px 8px; border-radius: 12px; font-weight: 700; font-size: 0.78rem;">' + pct + '%</span>'
                        : '<span style="background: #fee2e2 !important; color: #dc2626 !important; border: 1px solid #fecaca !important; padding: 2px 8px; border-radius: 12px; font-weight: 700; font-size: 0.78rem;">0%</span>');

                var balanceHtml = j.balance > 0
                    ? '<span style="background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #f87171 !important; font-weight: 800; font-size: 0.95rem; padding: 3px 10px; border-radius: 6px; display: inline-block;">' + formatNum(j.balance) + ' KG</span>'
                    : '<span style="background: #f0fdf4 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 700; font-size: 0.8rem; padding: 2px 8px; border-radius: 4px; display: inline-block;"><i class="fa fa-check mr-1"></i> Nil</span>';

                var html = '<tr>' +
                    '<td class="text-center text-muted font-weight-bold" style="vertical-align:middle;">' + (idx + 1) + '</td>' +
                    '<td class="font-weight-bold text-dark text-truncate" style="vertical-align:middle; font-size:0.92rem;" title="' + escapeHtml(j.name) + '">' +
                        '<i class="fa fa-user-circle text-primary mr-2 me-2"></i>' + escapeHtml(j.name) +
                    '</td>' +
                    '<td class="text-center" style="vertical-align:middle;">' +
                        '<span style="background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; font-weight: 800; font-size: 0.82rem; padding: 3px 12px; border-radius: 16px; display: inline-block;">' +
                            j.challanCount + ' Challans' +
                        '</span>' +
                    '</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #6d28d9 !important; font-size: 0.92rem; vertical-align:middle;">' + formatNum(j.given) + ' KG</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #15803d !important; font-size: 0.92rem; vertical-align:middle;">' + formatNum(j.accepted) + ' KG</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #b45309 !important; font-size: 0.92rem; vertical-align:middle;">' + formatNum(j.returned) + ' KG</td>' +
                    '<td class="text-right text-end" style="vertical-align:middle;">' + balanceHtml + '</td>' +
                    '<td class="text-center" style="vertical-align:middle;">' + progressBadge + '</td>' +
                    '</tr>';

                tbody.append(html);
            });

            $("#ftJobberTotalCount").text(formatNum(sumCount));
            $("#ftJobberGiven").text(formatNum(sumGiven) + ' KG');
            $("#ftJobberAccepted").text(formatNum(sumAccepted) + ' KG');
            $("#ftJobberReturned").text(formatNum(sumReturned) + ' KG');
            $("#ftJobberBalance").text(formatNum(sumBalance) + ' KG');

            var totalPct = sumGiven > 0 ? Math.round((sumAccepted / sumGiven) * 100) : 0;
            $("#ftJobberPercent").text(totalPct + '%');
        }

        function renderTransactionsTable(data) {
            var tbody = $("#tblTransactionsBody");
            tbody.empty();

            if (!data || data.length === 0) {
                tbody.html('<tr><td colspan="12" class="text-center py-4 text-muted"><i class="fa fa-info-circle mr-1 me-1"></i> No challan transactions found.</td></tr>');
                $("#ftTxGiven").text('0 KG');
                $("#ftTxAccepted").text('0 KG');
                $("#ftTxReturned").text('0 KG');
                $("#ftTxBalance").text('0 KG');
                return;
            }

            var sumGiven = 0, sumAccepted = 0, sumReturned = 0, sumBalance = 0;

            data.forEach(function (tx, idx) {
                var given = parseFloat(tx.GivenWeight) || 0;
                var accepted = parseFloat(tx.AcceptedWeight) || 0;
                var returned = parseFloat(tx.ReturnWeight) || 0;
                var balance = parseFloat(tx.BalanceWeight) || 0;

                sumGiven += given;
                sumAccepted += accepted;
                sumReturned += returned;
                sumBalance += balance;

                var badgeClass = tx.Status === 'Accepted' ? 'badge-completed' : 'badge-with-jobber';

                var html = '<tr>' +
                    '<td class="text-center text-muted font-weight-bold" style="vertical-align:middle;">' + (idx + 1) + '</td>' +
                    '<td class="text-center" style="vertical-align:middle;"><span class="badge bg-secondary text-white">' + escapeHtml(tx.SourceType) + '</span></td>' +
                    '<td class="text-center font-weight-bold" style="vertical-align:middle;"><span style="background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; font-weight: 700; font-size: 0.8rem; padding: 2px 8px; border-radius: 4px;">' + escapeHtml(tx.ChallanNo) + '</span></td>' +
                    '<td class="text-center text-muted small" style="vertical-align:middle;">' + escapeHtml(tx.OutwardDate) + '</td>' +
                    '<td class="font-weight-bold text-dark text-truncate" style="vertical-align:middle;" title="' + escapeHtml(tx.JobberName) + '"><i class="fa fa-user-circle text-primary mr-1 me-1"></i>' + escapeHtml(tx.JobberName) + '</td>' +
                    '<td class="font-weight-bold text-dark text-truncate" style="vertical-align:middle;">' + escapeHtml(tx.MaterialQuality) + '</td>' +
                    '<td class="text-truncate" style="vertical-align:middle;">' + escapeHtml(tx.YarnColor || '-') + '</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #6d28d9 !important; vertical-align:middle;">' + formatNum(given) + ' KG</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #15803d !important; vertical-align:middle;">' + formatNum(accepted) + ' KG</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #b45309 !important; vertical-align:middle;">' + formatNum(returned) + ' KG</td>' +
                    '<td class="text-right text-end font-weight-bold" style="color: #dc2626 !important; vertical-align:middle;">' + formatNum(balance) + ' KG</td>' +
                    '<td class="text-center" style="vertical-align:middle;"><span class="' + badgeClass + '">' + escapeHtml(tx.Status) + '</span></td>' +
                    '</tr>';

                tbody.append(html);
            });

            $("#ftTxGiven").text(formatNum(sumGiven) + ' KG');
            $("#ftTxAccepted").text(formatNum(sumAccepted) + ' KG');
            $("#ftTxReturned").text(formatNum(sumReturned) + ' KG');
            $("#ftTxBalance").text(formatNum(sumBalance) + ' KG');
        }


        function updateCounterBadge() {
            var activeTab = $("#stockReportTabs .nav-link.active").attr("id") || 'tab-jobber-summary';
            if (activeTab === 'tab-jobber-summary') {
                var jobberCount = $("#countJobbersSummary").text() || '0';
                $("#tableShowingCount").html('<i class="fa fa-users mr-1 me-1"></i> Showing ' + jobberCount + ' Jobbers');
            } else {
                var txCount = $("#countTransactions").text() || '0';
                $("#tableShowingCount").html('<i class="fa fa-list mr-1 me-1"></i> Showing ' + txCount + ' Transactions');
            }
        }

        function resetFilters() {
            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();
            var todayStr = yyyy + "-" + mm + "-" + dd;

            var pastDate = new Date();
            pastDate.setDate(pastDate.getDate() - 90);
            var pdd = String(pastDate.getDate()).padStart(2, '0');
            var pmm = String(pastDate.getMonth() + 1).padStart(2, '0');
            var pyyyy = pastDate.getFullYear();
            var pastStr = pyyyy + "-" + pmm + "-" + pdd;

            $("#filterFromDate").val(pastStr);
            $("#filterToDate").val(todayStr);
            $("#filterJobber").val('ALL');
            $("#tableQuickSearch").val('');
            reloadAllReportData();
        }

        function formatNum(val) {
            return (val || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function exportToExcel() {
            var activeTab = $("#stockReportTabs .nav-link.active").attr("id") || 'tab-jobber-summary';
            var csv = "";
            var fileName = "";

            if (activeTab === 'tab-jobber-summary') {
                fileName = "Jobber_Wise_Material_Stock_Summary.csv";
                csv = "SrNo,JobberName,ChallanCount,TotalIssuedKG,TotalAcceptedKG,TotalReturnedKG,BalanceWithJobberKG,AcceptedPct\n";
                $("#tblJobberSummary tbody tr").each(function () {
                    var cols = [];
                    $(this).find('td').each(function () {
                        cols.push('"' + $(this).text().trim().replace(/"/g, '""') + '"');
                    });
                    if (cols.length > 1) csv += cols.join(",") + "\n";
                });
            } else {
                fileName = "Jobber_Challan_Transactions_Report.csv";
                csv = "SrNo,Source,ChallanNo,Date,JobberName,MaterialQuality,YarnColor,IssuedKG,AcceptedKG,ReturnedKG,BalanceKG,Status\n";
                $("#tblTransactions tbody tr").each(function () {
                    var cols = [];
                    $(this).find('td').each(function () {
                        cols.push('"' + $(this).text().trim().replace(/"/g, '""') + '"');
                    });
                    if (cols.length > 1) csv += cols.join(",") + "\n";
                });
            }

            var blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}
