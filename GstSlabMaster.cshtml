<script>

    var currentPagePermission = {};
    $(document).ready(function () {
        var permission = sessionStorage.getItem("PagePermission");
        if (permission != null) {
            currentPagePermission = JSON.parse(permission);
            console.log("currentPagePermission", currentPagePermission);
            if (currentPagePermission.Add == false) {
                $("#AddGstModel").hide();
            }
        }

        FunctionIsLogin();
        displayData(0);

        //getDefaultCompany();


        // Shortcut Key
        $(document).keydown(function (key) {
            switch (parseInt(key.which, 10)) {
                case 27:
                    //Esc Key
                    $("#cancelbtn").click();
                    break;
                case 18 && 79:
                    // Alt + O
                    $("#AddGstModel").click();
                    break;
                default:
                    //alert(key.which);
                    break;
            }
        });
    });



