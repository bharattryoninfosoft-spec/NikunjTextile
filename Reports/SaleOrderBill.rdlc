	<Code>Public Function NumberToWords(ByVal amount As Decimal) As String
    Dim whole As Long = Convert.ToInt64(Math.Floor(Math.Abs(amount)))
    Dim paise As Integer = Convert.ToInt32(Math.Round((Math.Abs(amount) - whole) * 100D, 0))
    Dim result As String

    If whole = 0 Then
        result = "Zero"
    Else
        result = IndianNumberToWords(whole)
    End If

    result = "Rupees " &amp; result

    If paise &gt; 0 Then
        result = result &amp; " and " &amp; IndianNumberToWords(paise) &amp; " Paise"
    End If

    If amount &lt; 0D Then
        result = "Minus " &amp; result
    End If

    Return result &amp; " Only"
End Function

Private Function IndianNumberToWords(ByVal number As Long) As String
    Dim ones() As String = {"", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"}
    Dim tens() As String = {"", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"}

    If number &gt;= 10000000 Then
        Return IndianNumberToWords(number \ 10000000) &amp; " Crore " &amp; IndianNumberToWords(number Mod 10000000)
    ElseIf number &gt;= 100000 Then
        Return IndianNumberToWords(number \ 100000) &amp; " Lakh " &amp; IndianNumberToWords(number Mod 100000)
    ElseIf number &gt;= 1000 Then
        Return IndianNumberToWords(number \ 1000) &amp; " Thousand " &amp; IndianNumberToWords(number Mod 1000)
    ElseIf number &gt;= 100 Then
        Return IndianNumberToWords(number \ 100) &amp; " Hundred " &amp; IndianNumberToWords(number Mod 100)
    ElseIf number &gt;= 20 Then
        Return tens(number \ 10) &amp; " " &amp; ones(number Mod 10)
    Else
        Return ones(number)
    End If
End Function</Code>
