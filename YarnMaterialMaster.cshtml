@{
    Layout = "/_LayoutPage1.cshtml";
}

<style>
    /* Hide Export Buttons */
    .dt-buttons,
    .dataTables_wrapper .dt-buttons {
        display: none !important;
    }

    /* Hide Search Box */
    .dataTables_filter {
        display: none !important;
    }

    /* Hide "Showing x to y of z entries" */
    .dataTables_info {
        display: none !important;
    }

    /* Hide Pagination */
    .dataTables_paginate {
        display: none !important;
    }

    /* Hide "Show Entries" Dropdown */
    .dataTables_length {
        display: none !important;
    }
</style>

<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <button id="AddFinacialYearModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Yarn Material & Quality</button>
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Yarn Material & Quality</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body" style="overflow:auto">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />

                        <div class="row gutters">
                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">

                                    <div class="col-4">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input type="text" id="YarnMaterial" name="YarnMaterial" class="form-control clear-field" onfocusout="validate(this)">
                                            <div class="field-placeholder">Yarn Material & Quality<sup style="color:red;">*</sup></div>
                                            <div class="YarnMaterial-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="YarnMaterial-invalid-feedback invalid-feedback">Please Mention Yarn Material & Quality</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-4">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input type="text" id="Denier" name="Denier" class="form-control clear-field">
                                            <div class="field-placeholder">Denier</div>
                                            <div class="Denier-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="Denier-invalid-feedback invalid-feedback">Please Mention Denier</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>


                                    <div class="col-4">

                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <div class="form-check form-check-inline">
                                                <br />
                                                <input id="IsActive" class="form-check-input" type="checkbox" value="1" checked>
                                                <label class="form-check-label" for="IsActive-default">Is Active</label>

                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-4">

                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <select id="ServiceUnit" class="select-single js-states " title="Select Unit" data-live-search="true">
                                                <option value="-1">Select</option>
                                            </select>
                                            <div class="field-placeholder">Unit<sup style="color:red;">*</sup></div>
                                            <div class="ServiceUnit-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="ServiceUnit-invalid-feedback invalid-feedback">Please Select unit</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>



                                    <div class="col-4">
                                        <div class="field-wrapper">
                                            <div class="input-group">
                                                <input class="form-control clear-field detail" type="text" id="HSNSACCOde" placeholder="HSN Code" onfocusout="validate(this)">
                                            </div>
                                            <div class="field-placeholder" id="DivHSCSACCOde">HSN Code<sup style="color:red;">*</sup></div>
                                            <div class="HSNSACCOde-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="HSNSACCOde-invalid-feedback invalid-feedback">Please Provide HSN Code</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-4">
                                        <!-- Field wrapper start -->


                                        <div class="field-wrapper">
                                            <select id="GSTSLABId" class="select-single js-states " title="Select GST Slab" data-live-search="true">
                                                <option value="-1">Select</option>
                                            </select>
                                            <div class="field-placeholder">GST Slab<sup style="color:red;">*</sup></div>
                                            <div class="GSTSLABId-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="GSTSLABId-invalid-feedback invalid-feedback">Please Select GST Slab</div>
                                        </div>



                                        <!-- Field wrapper end -->
                                    </div>




                                </div>
                            </div>
                        </div>

                    </div>
                    <input id="edit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">
                        <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Yarn Material & Quality</div>
                    <br />
                    <div class="row gutters">


                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12">
                        </div>


                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <!-- Field wrapper start -->
                            <div class="field-wrapper">
                                <input id="search-Yarn-Material" placeholder="Search Yarn Material." type="text" class="form-control clear-field detail" onkeyup="functionSearch()">
                                <div class="field-placeholder">Search Yarn Material.</div>
                            </div>
                            <!-- Field wrapper end -->
                        </div>

                    </div>


                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr style="background-color: #1273eb;">
                                    <th style="color:white;">Sr No</th>
                                    <th style="color:white;">Yarn Material & Quality</th>
                                    <th style="color:white;">Denier</th>
                                    <th style="color:white;">Unit</th>
                                    <th style="color:white;">HSN</th>
                                    <th style="color:white;">GST Slab</th>
                                    <th style="color:white;">Is Active</th>
                                    <!--<th>Position</th>-->
                                    <th style="color:white;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>
@section Scripts{   

    <script>
        var currentPagePermission = {};
        $(document).ready(function () {
            FunctionIsLogin();
            displayData(0);
            getItemUnit();
            getItemGST();
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: request.statusText || 'Failed to load default company data.'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    console.log(data);
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function getItemUnit() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getItemUnit',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    var jsonData = JSON.parse(data.d);
                    $("#ServiceUnit option[value]").each(function () {
                        $(this).remove();
                    });

                    $('#ServiceUnit').append("<option value='' selected> -- Select -- </option>");
                    for (var i = 0; i < jsonData.length; i++) {
                        admin = jsonData[i];
                        appendTemp = "<option value='" + admin.UnitId + "'>" + admin.Unit + "</option >";
                        $('#ServiceUnit').append(appendTemp);
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function getItemGST() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getGSTSlabList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    var jsonData = JSON.parse(data.d);
                    $("#GSTSLABId option[value]").each(function () {
                        $(this).remove();
                    });
                    appendTemp = "<option value='0' selected></option >";
                    $('#GSTSLABId').append(appendTemp);

                    for (var i = 0; i < jsonData.length; i++) {
                        admin = jsonData[i];
                        appendTemp = "<option value='" + admin.GSTSLABId + "'>" + admin.GSTSLABName + "</option >";
                        $('#GSTSLABId').append(appendTemp);
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function functionSearch() {
            displayData(0);
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            }
            else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }

            var rowStartVal = $("#rowStartCount").val();
            var searchYarnMaterial = $("#search-Yarn-Material").val();

            var formData = new FormData();
            formData.append('searchYarnMaterial', searchYarnMaterial);
            formData.append('startFrom', rowStartVal);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnMaterialMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    console.log(response);

                    if (rowStartVal == 0) {
                        $("#copy-print-csv tbody").empty();
                    }
                    var dataTable = $('#copy-print-csv');
                    var temp = "";

                    if (response.listYarnMaterialMaster.length < 10) {
                        $("#view-more-btn").hide();
                    }
                    else {
                        $("#view-more-btn").show();
                    }

                    var SrNo = (parseInt(rowStartVal) + parseInt(1));
                    for (var i = 0; i < response.listYarnMaterialMaster.length; i++) {

                        var Top = i - 1;
                        var Previous = i + 1;
                        var ActionPosition = "";

                        if (response.listYarnMaterialMaster.length != 1) {
                            if (i == 0) {
                                var PostDown = response.listYarnMaterialMaster[i].YarnMaterialID + "," + response.listYarnMaterialMaster[i].Position + "|" + response.listYarnMaterialMaster[Previous].YarnMaterialID + "," + response.listYarnMaterialMaster[Previous].Position;

                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listYarnMaterialMaster[i].YarnMaterialID + "' value = '" + PostDown + "' /> ";
                                ActionPosition += "<span class='icon-triangle-down' title='Down' onclick='onPostDown(" + response.listYarnMaterialMaster[i].YarnMaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }
                            else if (i == parseInt(response.listYarnMaterialMaster.length - 1)) {
                                var PostUp = response.listYarnMaterialMaster[i].YarnMaterialID + "," + response.listYarnMaterialMaster[i].Position + "|" + response.listYarnMaterialMaster[Top].YarnMaterialID + "," + response.listYarnMaterialMaster[Top].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listYarnMaterialMaster[i].YarnMaterialID + "' value = '" + PostUp + "' /> </span>";
                                ActionPosition += "<span class='icon-triangle-up' title='Up' onclick='onPostUp(" + response.listYarnMaterialMaster[i].YarnMaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'></td>";
                            }
                            else {
                                var PostUp = response.listYarnMaterialMaster[i].YarnMaterialID + "," + response.listYarnMaterialMaster[i].Position + "|" + response.listYarnMaterialMaster[Top].YarnMaterialID + "," + response.listYarnMaterialMaster[Top].Position;
                                var PostDown = response.listYarnMaterialMaster[i].YarnMaterialID + "," + response.listYarnMaterialMaster[i].Position + "|" + response.listYarnMaterialMaster[Previous].YarnMaterialID + "," + response.listYarnMaterialMaster[Previous].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listYarnMaterialMaster[i].YarnMaterialID + "' value = '" + PostUp + "' /><span class='icon-triangle-up' title='Up' onclick='onPostUp(" + response.listYarnMaterialMaster[i].YarnMaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span>";
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listYarnMaterialMaster[i].YarnMaterialID + "' value = '" + PostDown + "' /><span class='icon-triangle-down' title='Down' onclick='onPostDown(" + response.listYarnMaterialMaster[i].YarnMaterialID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }
                        }

                        temp += "<tr>";
                        temp += "<td>" + SrNo++ + "</td>";
                        temp += "<td>" + response.listYarnMaterialMaster[i].YarnMaterial + "</td>";
                        temp += "<td>" + response.listYarnMaterialMaster[i].Denier + "</td>";
                        temp += "<td>" + response.listYarnMaterialMaster[i].Unit + "</td>";
                        temp += "<td>" + response.listYarnMaterialMaster[i].GSTSLABName + "</td>";
                        temp += "<td>" + response.listYarnMaterialMaster[i].HSNCode + "</td>";

                        if (response.listYarnMaterialMaster[i].IsActive == "1") {
                            temp += "<td><span class='badge bg-success'>Active</span></td>";
                        }
                        else {
                            temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                        }

                        temp += "<td><div class='actions'>";
                        temp += "<a href='javascript:void(0);' " +
                            "class='EditBtn' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Edit' " +
                            "data-bs-toggle='modal' " +
                            "data-bs-target='#addNewContact' " +
                            "onclick='showRecords(" + response.listYarnMaterialMaster[i].YarnMaterialID + ")'>" +
                            "<i class='icon-edit1 text-info'></i>" +
                            "</a>&nbsp;&nbsp;";

                        temp += "<a href='javascript:void(0);' " +
                            "class='DeleteBtn' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Delete' " +
                            "onclick='functionYarnDelete(" + response.listYarnMaterialMaster[i].YarnMaterialID + ")'>" +
                            "<i class='icon-x-circle text-danger'></i>" +
                            "</a>";

                        temp += "</div></td>";
                        temp += "</tr>";
                    }

                    dataTable.append(temp);
                    var permission = getCookie("PagePermission");
                    if (permission) {
                        var currentPagePermission = JSON.parse(permission);
                        if (currentPagePermission.Add == false) { $("#AddFinacialYearModel").hide(); }
                        if (currentPagePermission.Edit == false) { $(".EditBtn").hide(); }
                        if (currentPagePermission.Delete == false) { $(".DeleteBtn").hide(); }
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        // Delete FinancialYear
        function functionFYDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this Financial Year record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                displayData(0);
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Deleted!',
                                    text: 'Financial Year deleted successfully.',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Problem occurred while deleting Financial Year.'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Problem occurred while deleting Financial Year.'
                            });
                        }
                    });
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Yarn Material");
            $("#add-alert").hide();

            $("#YarnMaterial").val('');
            $("#Denier").val('');

            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function checkSaveView() {
            var IsActive = $("#IsActive").is(':checked') ? "1" : "0";

            var YarnMaterial = $('#YarnMaterial').val();
            var Denier = $('#Denier').val();
            var UnitId = $('#ServiceUnit').val();
            var HSNCode = $('#HSNSACCOde').val();
            var GSTSLABId = $('#GSTSLABId').val();

            if (validate(document.getElementById('YarnMaterial')) == false || validate(document.getElementById('ServiceUnit')) == false || validate(document.getElementById('HSNSACCOde')) == false || validate(document.getElementById('GSTSLABId')) == false) {
                validate(document.getElementById('YarnMaterial'));
                validate(document.getElementById('ServiceUnit'));
                validate(document.getElementById('HSNSACCOde'));
                validate(document.getElementById('GSTSLABId'));
            }
            else {
                var formData = new FormData();
                formData.append('YarnMaterial', YarnMaterial);
                formData.append('Denier', Denier);
                formData.append('UnitId', UnitId);
                formData.append('HSNCode', HSNCode);
                formData.append('GSTSLABId', GSTSLABId);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertYarnMaterialMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: response.Message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                            displayData(0);
                            $("#cancelbtn").click();
                        }
                        else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.Message
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while saving Yarn Material.'
                        });
                    }
                });
            }
        }

        function checkSave() {
            var IsActive = $("#IsActive").is(':checked') ? "1" : "0";

            var YarnMaterial = $('#YarnMaterial').val();
            var Denier = $('#Denier').val();
            var UnitId = $('#ServiceUnit').val();
            var HSNCode = $('#HSNSACCOde').val();
            var GSTSLABId = $('#GSTSLABId').val();

            if (validate(document.getElementById('YarnMaterial')) == false || validate(document.getElementById('ServiceUnit')) == false || validate(document.getElementById('HSNSACCOde')) == false || validate(document.getElementById('GSTSLABId')) == false) {
                validate(document.getElementById('YarnMaterial'));
                validate(document.getElementById('ServiceUnit'));
                validate(document.getElementById('HSNSACCOde'));
                validate(document.getElementById('GSTSLABId'));
            }
            else {
                var formData = new FormData();
                formData.append('YarnMaterial', YarnMaterial);
                formData.append('Denier', Denier);
                formData.append('UnitId', UnitId);
                formData.append('HSNCode', HSNCode);
                formData.append('GSTSLABId', GSTSLABId);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertYarnMaterialMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: response.Message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                            displayData(0);
                        }
                        else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.Message
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while saving Yarn Material.'
                        });
                    }
                });
            }
        }

        function checkEdit() {
            var id = $("#edit-id").val();
            var IsActive = $("#IsActive").is(':checked') ? "1" : "0";

            var YarnMaterial = $('#YarnMaterial').val();
            var Denier = $('#Denier').val();
            var UnitId = $('#ServiceUnit').val();
            var HSNCode = $('#HSNSACCOde').val();
            var GSTSLABId = $('#GSTSLABId').val();

            if (validate(document.getElementById('YarnMaterial')) == false || validate(document.getElementById('ServiceUnit')) == false || validate(document.getElementById('HSNSACCOde')) == false || validate(document.getElementById('GSTSLABId')) == false) {
                validate(document.getElementById('YarnMaterial'));
                validate(document.getElementById('ServiceUnit'));
                validate(document.getElementById('HSNSACCOde'));
                validate(document.getElementById('GSTSLABId'));
            }
            else {
                var formData = new FormData();
                formData.append('YarnMaterialID', id);
                formData.append('YarnMaterial', YarnMaterial);
                formData.append('Denier', Denier);
                formData.append('UnitId', UnitId);
                formData.append('HSNCode', HSNCode);
                formData.append('GSTSLABId', GSTSLABId);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/EditYarnMaterialMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            $('#YarnMaterial').val('');
                            $('#Denier').val('');
                            Swal.fire({
                                icon: 'success',
                                title: 'Updated!',
                                text: response.Message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                            displayData(0);
                            $("#cancelbtn").click();
                        }
                        else {
