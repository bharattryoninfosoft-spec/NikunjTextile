    function yarnbacksift(siftGodownInputBox) {
        var abc = $("#siftGodownInputBox").val();
        var xyz = siftGodownInputBox.split("_")[0] + "|";
        //alert(YarnInwardDetailID);


        //var abc = "(27,7,40,43,2)|(28,7,40,43,1)|(1002,7,40,43,3)|(1002,7,40,43,2)|(1002,7,40,43,1)|";
        //var xyz = "(1002,7,40,43,6)|";

        // remove ending |
        abc = abc.replace(/\|$/, '');
        xyz = xyz.replace(/\|$/, '');

        // split xyz
        var xyzParts = xyz.replace(/[()]/g, '').split(',');
        var matchKey = xyzParts.slice(0, 4).join(',');
        var xyzTotal = parseInt(xyzParts[4]);

        // split abc records
        var records = abc.split('|');

        var sum = 0;
        var indexesToRemove = [];

        // calculate sum for matching records
        records.forEach(function (rec, index) {
            var parts = rec.replace(/[()]/g, '').split(',');
            if (parts.slice(0, 4).join(',') === matchKey) {
                sum += parseInt(parts[4]);
                indexesToRemove.push(index);
            }
        });

        // remove records only if sum matches xyz
        if (sum === xyzTotal) {
            records = records.filter(function (_, index) {
                return !indexesToRemove.includes(index);
            });
        }

        // final result
        var result = records.join('|') + (records.length ? '|' : '');

        console.log(result);



        //alert(result);

        $("#siftGodownInputBox").val(result);

        //var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val();
        //$("#siftYarnInwardDetailID").val(siftYarnInwardDetailID.replace(YarnInwardDetailID, ""));


        displaySiftData();

    }






