   function StockTransferSiftTo(abc) {
       debugger;
    if (!abc) return;
    var parts = abc.split("_");
    if (parts.length < 4) return;
    var SrNo = parts[0];
    var BillToPartyID = parts[1];
    var YarnMaterialID = parts[2];
    var YarnColorID = parts[3];
    var GodownID = $("#ddlGodownMaster").val();

    var $stockSpan = $("#spanStock_" + SrNo);
    var $inputBox = $("#txtinputstock_" + SrNo);
    var TextStock = parseInt($inputBox.val()) || 0;
    var AvailableStock = parseInt($stockSpan.text()) || 0;
    if (!TextStock) {
        $inputBox.addClass("is-invalid");
        notes.show("Please Mention No Of Box.", { type: 'danger' });
        return;
    }

    if (TextStock > AvailableStock) {
        $inputBox.addClass("is-invalid");
        notes.show("Please Mention Below Stock Value.", { type: 'danger' });
        return;
    }

    $inputBox.removeClass("is-invalid");
    $("#tblSpanCompanyName").html($("#span_Name_" + SrNo).html());
    $("#tblSpanYarnMaterial").html($("#span_Material_" + SrNo).html());
    $("#tblSpanYarnColor").html($("#span_Color_" + SrNo).html());
    $("#tblSpanColorCode").html($("#span_Code_" + SrNo).html());
    $("#tblSpanNoOfBox").html(TextStock);

    $("#txtBillToPartyID").val(BillToPartyID);
    $("#txtYarnMaterialID").val(YarnMaterialID);
    $("#txtYarnColorID").val(YarnColorID);
    $("#txtTextStock").val(TextStock);
    var formData = new FormData();
    formData.append('BillToPartyID', BillToPartyID);
    formData.append('YarnMaterialID', YarnMaterialID);
    formData.append('YarnColorID', YarnColorID);
    formData.append('GodownID', GodownID);

    var siftGodownInputBox = $("#siftGodownInputBox").val() || "";
    formData.append(
        'siftGodownInputBox',
        siftGodownInputBox ? siftGodownInputBox.slice(0, -1).replace(/\|/g, ',') : ""
    );

    $.ajax({
        type: "POST",
        url: '/WebServiceNikunjTextile.asmx/getUpdateYarnOutwardSiftMaster',
        data: formData,
        dataType: 'json',
        contentType: false,
        processData: false,
        success: function (response) {

            var list = response.listYarnOutwardMaster || [];
            var $tbody = $("#tblYarnSift");

            $tbody.empty();

            if (!list.length) {
                $("#hTotalNoOfBox").html(0);
                return;
            }

            var temp = "";
            var srno = 1;
            var RemainingStock = TextStock;
            var locationIds = [];

            list.forEach(function (item) {

                var maxBox = parseInt(item.NoOfBox) || 0;
                var MentionNoOfBox = 0;

                if (RemainingStock > 0) {
                    MentionNoOfBox = Math.min(RemainingStock, maxBox);
                    RemainingStock -= MentionNoOfBox;
                }

                temp += `
                        <tr 
                            data-billto="${item.BillToPartyID}"
                            data-godownlocationid="${item.GodownLocationID}"
                            data-yarncolorid="${item.YarnColorID}"
                            data-yarnmaterialid="${item.YarnMaterialID}"
                            data-companyname="${item.CompanyName}"
                            data-yarnmaterial="${item.YarnMaterial}"
                            data-yarncolor="${item.YarnColor}"
                            data-yarncolorcode="${item.YarnColorCode}">

                            <td>${srno}</td>
                            <td>${item.GodownTitle}</td>
                            <td>${item.LocationTitle}</td>
                            <td>${maxBox}</td>
                            <td>
                                <input type="tel"
                                    class="form-control txtNoOfBox"
                                    id="txtNoOfBox_${item.GodownLocationID}"
                                    data-max="${maxBox}"
                                    value="${MentionNoOfBox}"
                                    maxlength="2"
                                    style="width:60px; min-height:30px;"
                                    onkeypress="return (event.charCode>=48 && event.charCode<=57)"
                                    onkeyup="GodownNoOfBox(this)" />
                            </td>
                        </tr>`;

                locationIds.push(item.GodownLocationID);
                srno++;
            });

            $tbody.append(temp);

            $("#hTotalNoOfBox").html(TextStock);
            $("#txtGodownLocationID").val(locationIds.join(",") + ",");
          
           HideAlreadySifted();

            setTimeout(function () {
                $("#btnSaveSiftYarnBox").focus();
            }, 300);
        }
    });

    $("#btnShiftModel").click();
}
    function SaveSiftYarnBox() {
        debugger;
        var dataArray = [];
        var BillToPartyID = $("#txtBillToPartyID").val();
        var YarnMaterialID = $("#txtYarnMaterialID").val();
        var YarnColorID = $("#txtYarnColorID").val();

        var GodownLocationIDRaw = $("#txtGodownLocationID").val();
        if (!GodownLocationIDRaw) return;

        var GodownLocationIDs = GodownLocationIDRaw.slice(0, -1).split(",");

        var TotalNoOfBox = 0;

        // 🔹 Calculate Total
        GodownLocationIDs.forEach(function (id) {
            var qty = parseInt($("#txtNoOfBox_" + id).val()) || 0;
            TotalNoOfBox += qty;
        });

        $("#hTotalNoOfBox").html(TotalNoOfBox);

        var SpanNoOfBox = parseInt($("#tblSpanNoOfBox").html()) || 0;

        if (TotalNoOfBox !== SpanNoOfBox) {
            return;
        }

        // 🔹 Build Sift String
        var existingValue = $("#siftGodownInputBox").val() || "";
        var newEntries = "";
        var qtyMap = {};

        GodownLocationIDs.forEach(function (id) {

            var qty = parseInt($("#txtNoOfBox_" + id).val()) || 0;
            if (qty > 0) {

                var entry = "(" + id + "," + BillToPartyID + "," + YarnMaterialID + "," + YarnColorID + "," + qty + ")|";
                newEntries += entry;

                var mapKey = BillToPartyID + "_" + YarnMaterialID + "_" + YarnColorID;

                if (!qtyMap[mapKey]) {
                    qtyMap[mapKey] = 0;
                }

                qtyMap[mapKey] += qty;
            }
        });

        $("#siftGodownInputBox").val(existingValue + newEntries);

        // 🔥 🔥 UPDATE STOCK IMMEDIATELY (NO AJAX WAIT)
        $("#tableYarnOutward tr").each(function () {

            var $row = $(this);

            var hiddenId = $row.find("input[type='hidden']").val();
            if (!hiddenId) return;

            var parts = hiddenId.split("_");
            if (parts.length < 4) return;

            var rowKey = parts[1] + "_" + parts[2] + "_" + parts[3];

            if (qtyMap[rowKey]) {

                var stockSpan = $row.find("span[id^='spanStock_']");
                var currentStock = parseInt(stockSpan.text()) || 0;

                var newStock = currentStock - qtyMap[rowKey];

                // Prevent negative
                if (newStock < 0) newStock = 0;

                stockSpan.text(newStock);
                $row.find("input[id^='txtinputstock_']").val("");

                // ✅ Hide row if stock becomes 0
                if (newStock === 0) {
                    $row.hide();
                }
            }
        });

        $("#tblYarnSift tr").each(function () {
            var id = $(this).data("godownlocationid");   // from data attribute
            var noOfBox = parseInt($("#txtNoOfBox_" + id).val()) || 0;

            if (noOfBox <= 0) return;   // skip empty rows

            dataArray.push({
                Id: id,
                Company: $(this).data("companyname"),
                Material: $(this).data("yarnmaterial"),
                Color: $(this).data("yarncolor"),
                YarnCode: $(this).data("yarncolorcode"),
                Godown: $(this).find("td:eq(1)").text().trim(),
                Location: $(this).find("td:eq(2)").text().trim(),
                NoOfBox: noOfBox
            });

        });

        if (dataArray.length === 0) {
            alert("Please enter at least one box.");
            return;
        }

        $("#btnClose").click();

        var dataTable = $('#tableSiftYarnData');
        var temp = "";

        var srno = $("#tableSiftYarnData tr").length + 1;

        for (var i = 0; i < dataArray.length; i++) {

            temp += "<tr>";

            var hiddenValue = "(" + dataArray[i].Id + "," +
                BillToPartyID + "," +
                YarnMaterialID + "," +
                YarnColorID + "," +
                dataArray[i].NoOfBox + ")";

            temp += "<td style='text-align:center;'>" +
                "<a href='javascript:void(0);' onclick='yarnbacksift(this,\"" + hiddenValue + "\")'>" +
                "<img src='/img/left-rrow.png' title='Sift Back Yarn' style='width:20px;'/>" +
                "</a>" +
                "</td>";

            temp += "<td>" + srno + "</td>";
            temp += "<td>" + dataArray[i].Company + "</td>";
            temp += "<td>" + dataArray[i].Material + "</td>";
            temp += "<td>" + dataArray[i].Color + "</td>";
            temp += "<td>" + dataArray[i].YarnCode + "</td>";
            temp += "<td>" + dataArray[i].Location + "</td>";
            temp += "<td>" + dataArray[i].NoOfBox + "</td>";

            // Hidden value for back sift
            temp += "<input type='hidden' id='txtsiftid_" + srno + "' " +
                "value='" + dataArray[i].Id + "' />";

            temp += "</tr>";

            srno++;
        }

        dataTable.append(temp);
    }
