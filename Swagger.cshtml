@{
    Layout = null;

    string masterPassword = "admin"; // Default password (also accepts admin@123, 123456)
    bool isAuthorized = false;
    string errorMessage = "";

    // Handle logout action
    if (Request.QueryString["logout"] == "1")
    {
        Session["SwaggerAuthorized"] = null;
        Response.Redirect("/Swagger.cshtml");
        return;
    }

    // Check if session is already authenticated
    if (Session["SwaggerAuthorized"] != null && (bool)Session["SwaggerAuthorized"] == true)
    {
        isAuthorized = true;
    }
    // Check if password was submitted
    else if (IsPost)
    {
        string enteredPassword = Request.Form["swaggerPassword"];
        if (!string.IsNullOrEmpty(enteredPassword) && 
            (enteredPassword == masterPassword || enteredPassword == "admin@123" || enteredPassword == "123456"))
        {
            Session["SwaggerAuthorized"] = true;
            isAuthorized = true;
        }
        else
        {
            errorMessage = "Incorrect password! Please try again.";
        }
    }
}
@if (!isAuthorized)
{
