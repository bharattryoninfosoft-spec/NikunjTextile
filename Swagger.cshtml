        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-alert">
                <i class="fa fa-exclamation-circle"></i>
                <span>@errorMessage</span>
            </div>
        }

        <form method="post" action="">
            <div class="form-group">
                <label for="swaggerPassword">Access Password</label>
                <div class="input-wrapper">
                    <input type="password" id="swaggerPassword" name="swaggerPassword" placeholder="Enter password..." autofocus required />
                    <button type="button" class="toggle-pwd" onclick="toggleVisibility()"><i class="fa fa-eye" id="eyeIcon"></i></button>
                </div>
            </div>
            <button type="submit" class="btn-unlock">
                <i class="fa fa-unlock-alt"></i> Unlock Swagger UI
            </button>
        </form>

        <div class="lock-footer">
            <p>Protected by WeaveLane ERP &bull; <a href="/ProductionOrderList">Return to ERP</a></p>
        </div>
    </div>

    <script>
        function toggleVisibility() {
            var pwd = document.getElementById("swaggerPassword");
            var icon = document.getElementById("eyeIcon");
            if (pwd.type === "password") {
                pwd.type = "text";
                icon.className = "fa fa-eye-slash";
            } else {
                pwd.type = "password";
                icon.className = "fa fa-eye";
            }
        }
    </script>
</body>
</html>
    return;
