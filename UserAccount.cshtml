        function renderPagination() {
            var totalPages = Math.ceil(filteredUserList.length / pageSize) || 1;
            var paginationEl = $("#paginationControls");
            paginationEl.empty();

            if (totalPages <= 1) {
                return;
            }

            var html = "";

            // First & Previous
            var prevDisabled = currentPage === 1 ? "disabled" : "";
            html += "<li class='page-btn " + prevDisabled + "' onclick='changePage(1)' title='First Page'><i class='bi bi-chevron-double-left'></i></li>";
            html += "<li class='page-btn " + prevDisabled + "' onclick='changePage(" + (currentPage - 1) + ")' title='Previous Page'><i class='bi bi-chevron-left'></i></li>";

            // Sliding page numbers
            var startPage = Math.max(1, currentPage - 2);
            var endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                html += "<li class='page-btn' onclick='changePage(1)'>1</li>";
                if (startPage > 2) {
                    html += "<li class='page-btn disabled'>...</li>";
                }
            }

            for (var p = startPage; p <= endPage; p++) {
                var activeClass = p === currentPage ? "active" : "";
                html += "<li class='page-btn " + activeClass + "' onclick='changePage(" + p + ")'>" + p + "</li>";
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += "<li class='page-btn disabled'>...</li>";
                }
                html += "<li class='page-btn' onclick='changePage(" + totalPages + ")'>" + totalPages + "</li>";
            }

            // Next & Last
            var nextDisabled = currentPage === totalPages ? "disabled" : "";
            html += "<li class='page-btn " + nextDisabled + "' onclick='changePage(" + (currentPage + 1) + ")' title='Next Page'><i class='bi bi-chevron-right'></i></li>";
            html += "<li class='page-btn " + nextDisabled + "' onclick='changePage(" + totalPages + ")' title='Last Page'><i class='bi bi-chevron-double-right'></i></li>";

            paginationEl.html(html);
        }

        function changePage(page) {
            var totalPages = Math.ceil(filteredUserList.length / pageSize) || 1;
            if (page < 1 || page > totalPages || page === currentPage) {
                return;
            }
            currentPage = page;
            renderUserTable();
            renderPagination();
            $(".user-table-wrapper").scrollTop(0);
        }

