
@{
    Layout = "/_LayoutPage1.cshtml";
}

<style>
    /* Hide Export Buttons */
    .dt-buttons,
    .dataTables_wrapper .dt-buttons {
        display: none !important;
    }

    /* Hide Search Box */
    .dataTables_filter {
        display: none !important;
    }

    /* Hide "Showing x to y of z entries" */
    .dataTables_info {
        display: none !important;
    }

    /* Hide Pagination */
    .dataTables_paginate {
        display: none !important;
    }

    /* Hide "Show Entries" Dropdown */
    .dataTables_length {
        display: none !important;
    }
</style>
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />

    <div class="card-header-lg">
        <button style="float:right;" class="btn btn-primary" id="AddUserAccountEntry" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add User Account</button>
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add User Account</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body" style="overflow:auto;">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />
                        <div class="row gutters">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                <div id="dropzone-sm" class="mb-3 image-upload-clear-image">
                                    <div class="dropzone needsclick dz-clickable" id="demo-upload">
                                        <input type="file" id="upload-image" style="display:none;" onchange="saveImage(this)" />
                                        <input type="hidden" id="upload-image-temp" value="" />
                                        <div class="dz-message needsclick" style="text-align: center; margin-top: 54px;"><label id="image-preview" for="upload-image">Upload Profile Image.</label></div>

                                    </div>

                                    <div style="text-align:center;padding-top:10px;">
                                        <button class="btn btn-outline-primary" onclick="clearImage()">Clear Image</button>
                                    </div>

                                </div>
                            </div>
                            <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">


                                    <div class="col-6">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <select class="form-control" id="ddlCompanyId">
                                            </select>
                                            <div class="field-placeholder">Company Name</div>
                                            <div class="ddlCompanyId-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="ddlCompanyId-invalid-feedback invalid-feedback">Please Select Company Name</div>
                                        </div>
                                    </div>




                                    <div class="col-6">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <select class="form-control" id="userRole">
                                                <option value="Admin">Admin</option>
                                                <option value="Sub Admin">Sub Admin</option>
                                                <option value="Accountant">Accountant</option>
                                                <option value="Sale Person">Sale Person</option>
                                                <option value="Supervisor">Supervisor</option>
                                                <option value="Watchman">Watchman</option>
                                                <option value="Job Work">Job Work</option>
                                            </select>
                                            <div class="field-placeholder">User Role</div>
                                            <div class="userRole-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="userRole-invalid-feedback invalid-feedback">Please Select User Role</div>
                                            <div class="userRole-less-feedback invalid-feedback">Invalid Number</div>
                                        </div>
                                    </div>



                                    <div class="col-12">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="full-name" type="text" class="form-control clear-field" onfocusout="validate(this)" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || event.charCode == 32)">
                                            <div class="field-placeholder">Full Name</div>
                                            <div class="full-name-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="full-name-invalid-feedback invalid-feedback">Please Provide Full Name</div>
                                        </div>
                                    </div>

                                    <div class="col-6">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="phone" type="tel" class="form-control clear-field" onfocusout="validate(this)" maxlength="10" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                            <div class="field-placeholder">Phone</div>
                                            <div class="phone-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="phone-invalid-feedback invalid-feedback">Please Provide Phone Number</div>
                                            <div class="phone-less-feedback invalid-feedback">Invalid Number</div>
                                        </div>
                                    </div>



                                    <div class="col-6">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="email" onfocusout="validateEmail(this.value)" type="text" class="form-control clear-field" onkeypress="return ((event.charCode >= 46 && event.charCode <= 57) && event.charCode != 47 || (event.charCode >= 64 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122))">
                                            <input type="hidden" id="email-temp" value="" />
                                            <input type="hidden" id="phone-temp" value="" />
                                            <div class="field-placeholder">Email</div>
                                            <div class="email-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="email-invalid-feedback invalid-feedback">Please Provide Proper Email</div>
                                        </div>
                                    </div>



                                    <div class="col-6 password-field">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="password" onfocusout="validate(this)" type="password" class="form-control clear-field">
                                            <div class="field-placeholder">Password</div>
                                            <div class="password-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="password-invalid-feedback invalid-feedback">Please Provide Password</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                        <!-- Field wrapper start -->
                                        <!-- Field wrapper end -->
                                    </div>
                                    <div class="col-6 password-field">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="cpassword" onfocusout="validate(this)" type="password" class="form-control clear-field">
                                            <div class="field-placeholder">Confirm Password</div>
                                            <div class="cpassword-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="cpassword-invalid-feedback invalid-feedback">Please Provide Confirm Password</div>
                                            <div class="cpassword-match-feedback invalid-feedback">Passwords Do No Match</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                        <!-- Field wrapper start -->
                                        <!-- Field wrapper end -->
                                    </div>



                                    <div class="col-6">
                                        <div class="field-wrapper">
                                            <div class="form-check form-check-inline">
                                                <br />
                                                <input id="checkLogin" class="form-check-input" type="checkbox" value="1">
                                                <label class="form-check-label" for="chcekEmail">Allow Login</label>
                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                    <input id="edit-id" type="hidden" />
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button id="savebtn" type="button" class="btn btn-primary" onclick="checkSave()">Save</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">User Master</div>
                    <div class="row align-items-center mb-3">
                        <!-- BUTTONS -->
                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-12">

                            <button class="btn btn-success btn-sm"
                                    onclick="exportTableToExcel('copy-print-csv','UserAccount')">
                                <i class="bi bi-file-earmark-excel-fill"></i>
                                Excel
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    onclick="generatePDF()">
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                PDF
                            </button>

                            <button class="btn btn-primary btn-sm"
                                    onclick="printTable()">
                                <i class="bi bi-printer-fill"></i>
                                Print
                            </button>
                        </div>
                        <!-- SEARCH -->
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 mb-2">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" id="searchBox" class="form-control" placeholder="Search..." onkeyup="searchTable()" />
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table v-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Company Name</th>
                                    <th>User Role</th>
                                    <th>Mobile No</th>
                                    <th>Email</th>
                                    <th>Allow Login</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>
@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script>
        $('body').addClass('fullscreen');
        var currentPagePermission = { Add: true, Edit: true, Delete: true }; // Default fallback

        // Configure SweetAlert2 Toast helper for non-blocking notifications
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                try {
                    currentPagePermission = JSON.parse(permission);
                } catch (e) {
                    console.error("Error parsing PagePermission cookie", e);
                }
            }

            // Hide Add Button if permission is false
            if (currentPagePermission.Add === false || currentPagePermission.Add === "false") {
                $("#AddUserAccountEntry").hide();
            }

            displayData(0);
            getddlCompanyId();
        });

        // Helper function to read cookies
        function getCookie(name) {
            var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            if (match) return decodeURIComponent(match[2]);
            return null;
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                }
            });
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            }
            else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getUserMaster?startFrom=' + rowStart,
                data: "{ 'startFrom':'" + rowStart + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").empty();
                    }

                    var tableBody = $("#copy-print-csv tbody");
                    var temp = "";
                    var operation = "";

                    if (response.listUserAccountMaster.length < 10) {
                        $("#view-more-btn").hide();
                    }
                    else {
                        $("#view-more-btn").show();
                    }

                    for (var i = 0; i < response.listUserAccountMaster.length; i++) {
                        if (response.listUserAccountMaster[i].AllowLogin == "1" ||
                            response.listUserAccountMaster[i].AllowLogin == 1) {
                            operation = "<span class='badge bg-success'>Yes</span>";
                        }
                        else {
                            operation = "<span class='badge bg-danger'>No</span>";
                        }

                        temp += "<tr>";
                        temp += "<td>" +
                            "<div class='media-box'>" +
                            "<img style='width:40px;height:40px;' " +
                            "src='" + response.listUserAccountMaster[i].UserAccountProfile + "' " +
                            "class='media-avatar'>" +
                            "<div class='media-box-body'>" +
                            "<a href='javascript:void(0);' class='text-truncate'>" +
                            response.listUserAccountMaster[i].UserAccountName +
                            "</a>" +
                            "</div>" +
                            "</div>" +
                            "</td>";

                        temp += "<td>" + response.listUserAccountMaster[i].CompanyName + "</td>";
                        temp += "<td>" + response.listUserAccountMaster[i].UserRole + "</td>";
                        temp += "<td>" + response.listUserAccountMaster[i].UserAccountMobileNo + "</td>";
                        temp += "<td>" + response.listUserAccountMaster[i].UserAccountEmail + "</td>";
                        temp += "<td>" + operation + "</td>";
                        temp += "<td>" + response.listUserAccountMaster[i].UserAccountDateAndTimes + "</td>";

                        // ==========================================
                        // ACTIONS COLUMN WITH PERMISSION CONTROLS
                        // ==========================================
                        temp += "<td><div class='actions'>";

                        var canEdit = currentPagePermission.Edit === true || currentPagePermission.Edit === "true";
                        var canDelete = currentPagePermission.Delete === true || currentPagePermission.Delete === "true";

                        // If neither edit nor delete are allowed, show a dash or leave blank
                        if (!canEdit && !canDelete) {
                            temp += "-";
                        } else {
                            // EDIT
                            if (canEdit) {
                                temp += "<a href='javascript:void(0);' " +
                                    "title='Edit' " +
                                    "data-bs-toggle='modal' " +
                                    "data-bs-target='#addNewContact' " +
                                    "onclick='showRecords(" + response.listUserAccountMaster[i].UserAccountId + ")'>" +
                                    "<i class='icon-edit1 text-info'></i>" +
                                    "</a>&nbsp;&nbsp;";
                            }

                            // DELETE
                            if (canDelete) {
                                temp += "<a href='javascript:void(0);' " +
                                    "title='Delete' " +
                                    "onclick='functionUserDelete(" + response.listUserAccountMaster[i].UserAccountId + ")'>" +
                                    "<i class='icon-x-circle text-danger'></i>" +
                                    "</a>";
                            }
                        }

                        temp += "</div></td>";
                        temp += "</tr>";
                    }

                    tableBody.append(temp);
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function showRecords(id) {
            clearAll();
            $("#upload-image-temp").val("");
            $("#upload-image").val("");
            $("#edit-id").val(id);
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Edit User Account");
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getUserMasterById?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#full-name").val(response.listUserAccountMaster[0].UserAccountName);
                        $("#ddlCompanyId").val(response.listUserAccountMaster[0].CompanyID);
                        $("#userRole").val(response.listUserAccountMaster[0].UserRole);
                        $('#email').val(response.listUserAccountMaster[0].UserAccountEmail);
                        $('#phone').val(response.listUserAccountMaster[0].UserAccountMobileNo);
                        $('#email-temp').val(response.listUserAccountMaster[0].UserAccountEmail);
                        $('#phone-temp').val(response.listUserAccountMaster[0].UserAccountMobileNo);
                        $('.password-field').hide();
                        if (response.listUserAccountMaster[0].AllowLogin == "1") {
                            $("#checkLogin").prop('checked', true);
                        }
                        else {
                            $("#checkLogin").prop('checked', false);
                        }
                        $("#upload-image-temp").val(response.listUserAccountMaster[0].UserAccountProfile);
                        var imgStr = "<img src='" + response.listUserAccountMaster[0].UserAccountProfile + "' style='height:200px;width:200px;margin-top:-54px;'>";
                        $("#image-preview").html(imgStr);
                        $("#image-preview").css('color', 'initial');
                    }
                    else {
                        Toast.fire({
                            icon: 'error',
                            title: response.Message
                        });
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Failed to retrieve record details.'
                    });
                }
            });
        }

        function clearAll() {
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add User Account");
            $("#add-alert").hide();
            $("#full-name").val('');
            $('#email').val('');
            $('#phone').val('');
            $('#password').val('');
            $('#cpassword').val('');
            $('.password-field').show();
            $(".clear-field").removeClass("is-valid is-invalid");

            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();

            $("#image-preview").html("Upload Profile Image.");
            $("#image-preview").css('color', 'initial');
        }

        function checkSave() {
            var image = document.getElementById('upload-image');
            var CompanyId = document.getElementById('ddlCompanyId');
            var name = document.getElementById('full-name');
            var UserRole = document.getElementById('userRole');
            var email = document.getElementById('email').value;
            var phone = document.getElementById('phone');
            var password = document.getElementById('password');
            var cpassword = document.getElementById('cpassword');

            if (saveImage(image) == false || validate(CompanyId) == false || validate(name) == false || validate(cpassword) == false || validate(password) == false || validateEmail(email) == false || validate(phone) == false) {
                validate(name);
                validate(cpassword);
                validate(password);
                validateEmail(email);
                validate(phone);
                saveImage(image);
            }
            else {
                var allowLogin = "0";

                if ($("#checkLogin").prop('checked') == true) {
                    allowLogin = "1";
                }
                var formData = new FormData();
                formData.append('CompanyIDss', CompanyId.value);
                formData.append('UserAccountName', name.value);
                formData.append('UserRole', UserRole.value);
                formData.append('UserAccountEmail', email);
                formData.append('UserAccountMobileNo', phone.value);
                formData.append('UserAccountPassword', password.value);
                formData.append('AllowLogin', allowLogin);
                formData.append('UserAccountProfile', image.files[0]);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertUserMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            Toast.fire({
                                icon: 'success',
                                title: response.Message
                            });
                            displayData(0);
                        }
                        else {
                            Toast.fire({
                                icon: 'error',
                                title: response.Message
                            });
                        }
                    },
                    error: function (error) {
                        Toast.fire({
                            icon: 'error',
                            title: 'An error occurred while saving.'
                        });
                    }
                });
            }
        }

        function checkEdit() {
            var id = $("#edit-id").val();
            var image = document.getElementById('upload-image');
            var CompanyId = document.getElementById('ddlCompanyId');
            var name = document.getElementById('full-name');
            var userRole = document.getElementById('userRole');
            var email = document.getElementById('email').value;
            var phone = document.getElementById('phone');

            if (validate(name) == false || validateEmail(email) == false || validate(phone) == false) {
                validate(name);
                validateEmail(email);
                validate(phone);
                saveImage(image);
            }
            else {
                var allowLogin = "0";

                if ($("#checkLogin").prop('checked') == true) {
                    allowLogin = "1";
                }
                var imagetemp = image.files[0];
                if (image.files[0] == undefined) {
                    imagetemp = $("#upload-image-temp").val();
                }

                var phonetemp = "";
                var emailtemp = "";
                if ($("#email-temp").val() != $("#email").val()) {
                    emailtemp = $("#email").val();
                }
                if ($("#phone-temp").val() != $("#phone").val()) {
                    phonetemp = $("#phone").val();
                }

                var formData = new FormData();
                formData.append('CompanyIDss', CompanyId.value);
                formData.append('UserAccountName', name.value);
                formData.append('userRole', userRole.value);
                formData.append('UserAccountEmail', emailtemp);
                formData.append('UserAccountMobileNo', phonetemp);
                formData.append('AllowLogin', allowLogin);
                formData.append('UserAccountProfile', imagetemp);
                formData.append('UserAccountId', id);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/editUserMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            Toast.fire({
                                icon: 'success',
                                title: response.Message
                            });
                            displayData(0);
                        }
                        else {
                            Toast.fire({
                                icon: 'error',
                                title: response.Message
                            });
                        }
                    },
                    error: function (error) {
                        Toast.fire({
                            icon: 'error',
                            title: 'An error occurred while editing.'
                        });
                    }
                });
            }
        }

        function saveImage(input) {
            if (input.files && input.files[0]) {
                var fildr = new FileReader();
                fildr.onload = function (e) {
                    var imgStr = "<img src='" + e.target.result + "' style='height:200px;width:200px;margin-top:-54px;'>";
                    $("#image-preview").html(imgStr);
                    $("#image-preview").css('color', 'initial');
                }
                fildr.readAsDataURL(input.files[0]);
                return true;
            }
            else {
                $("#image-preview").html("Profile Image Is Needed.");
                $("#image-preview").css('color', 'red');
                return false;
            }
        }

        function clearImage() {
            $("#image-preview").html("Upload Profile Image.");
            $("#upload-image").val("");
        }

        function functionUserDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this record!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('UserAccountId', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteUserMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {
                                displayData(0);
                                Toast.fire({
                                    icon: 'success',
                                    title: 'User deleted successfully.'
                                });
                            }
                            else {
                                Toast.fire({
                                    icon: 'error',
                                    title: 'Problem has been occurred while deleting user.'
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'Problem has been occurred while submitting your data.'
                            });
                        }
                    });
                }
            });
        }

        function validateEmail(email) {
            const re = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
            email = email.replace(/\s+/g, ' ').trim();
            var errorMessageValid = ".email-valid-feedback";
            var errorMessageInvalid = ".email-invalid-feedback";
            if (email == "") {
                document.getElementById("email").classList.remove("is-valid");
                document.getElementById("email").classList.add("is-invalid");
                $(errorMessageValid).hide(); $(errorMessageInvalid).show();
                return false;
            }
            else if (!re.test(String(email).toLowerCase())) {
                document.getElementById("email").classList.remove("is-valid");
                document.getElementById("email").classList.add("is-invalid");
                $(errorMessageValid).hide(); $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById("email").classList.add("is-valid");
                document.getElementById("email").classList.remove("is-invalid");
                $(errorMessageValid).show(); $(errorMessageInvalid).hide();
                return true;
            }
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "" || code.value == "0") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                $(".phone-less-feedback").hide();
                $(".cpassword-match-feedback").hide();
                return false;
            }
            else if (code.id == "phone" && code.value.length != 10) {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(".phone-less-feedback").show();
                $(".phone-invalid-feedback").hide();
                return false;
            }
            else if ((code.id == "cpassword" || (code.id == "password" && $("#cpassword").val() != "")) && $("#cpassword").val() != $("#password").val()) {
                document.getElementById("cpassword").classList.remove("is-valid");
                document.getElementById("cpassword").classList.add("is-invalid");
                document.getElementById("password").classList.remove("is-valid");
                document.getElementById("password").classList.add("is-invalid");
                $(".cpassword-match-feedback").show();
                $(".cpassword-invalid-feedback").hide();
                $(".password-invalid-feedback").hide();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                document.getElementById("cpassword").classList.remove("is-invalid");
                document.getElementById("password").classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(".password-invalid-feedback").hide();
                $(".cpassword-invalid-feedback").hide();
                $(errorMessageInvalid).hide();
                return true;
            }
        }

