@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script>
        $('body').addClass('fullscreen');
        var currentPagePermission = { Add: true, Edit: true, Delete: true }; // Default fallback

        // Configure SweetAlert2 Toast helper for non-blocking notifications
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                try {
                    currentPagePermission = JSON.parse(permission);
                } catch (e) {
                    console.error("Error parsing PagePermission cookie", e);
                }
            }

            // Hide Add Button if permission is false
            if (currentPagePermission.Add === false || currentPagePermission.Add === "false") {
                $("#AddUserAccountEntry").hide();
            }

            displayData(0);
            getddlCompanyId();
        });

        // Helper function to read cookies
        function getCookie(name) {
            var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            if (match) return decodeURIComponent(match[2]);
            return null;
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                }
            });
        }

        var fullUserList = [];
        var filteredUserList = [];
        var currentPage = 1;
        var pageSize = 10;

        function displayData(resetPage) {
            if (resetPage === undefined || resetPage === 0 || resetPage === true) {
                currentPage = 1;
            }
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getUserMaster?startFrom=0',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    fullUserList = (response && response.listUserAccountMaster) ? response.listUserAccountMaster : [];
                    applyFilter();
                },
                error: function (request, status, error) {
                    console.error("Error fetching users:", error);
                    fullUserList = [];
                    filteredUserList = [];
                    renderUserTable();
                    renderPagination();
                }
            });
        }

        function applyFilter() {
            var search = ($("#searchBox").val() || "").trim().toLowerCase();
            if (search.length > 0) {
                $("#clearSearchBtn").show();
                filteredUserList = fullUserList.filter(function (item) {
                    var name = String(item.UserAccountName || "").toLowerCase();
                    var company = String(item.CompanyName || "").toLowerCase();
                    var role = String(item.UserRole || "").toLowerCase();
                    var mobile = String(item.UserAccountMobileNo || "").toLowerCase();
                    var email = String(item.UserAccountEmail || "").toLowerCase();
                    var login = (item.AllowLogin == "1" || item.AllowLogin == 1) ? "yes active allow" : "no inactive disabled";
                    var date = String(item.UserAccountDateAndTimes || "").toLowerCase();
                    return name.indexOf(search) > -1 ||
                        company.indexOf(search) > -1 ||
                        role.indexOf(search) > -1 ||
                        mobile.indexOf(search) > -1 ||
                        email.indexOf(search) > -1 ||
                        login.indexOf(search) > -1 ||
                        date.indexOf(search) > -1;
                });
            } else {
                $("#clearSearchBtn").hide();
                filteredUserList = fullUserList.slice();
            }

            var maxPage = Math.ceil(filteredUserList.length / pageSize) || 1;
            if (currentPage > maxPage) {
                currentPage = maxPage;
            }
            if (currentPage < 1) {
                currentPage = 1;
            }

            renderUserTable();
            renderPagination();
        }

        function onSearchInput() {
            currentPage = 1;
            applyFilter();
        }

        function clearSearch() {
            $("#searchBox").val("");
            onSearchInput();
        }

        function onPageSizeChange(val) {
            pageSize = parseInt(val) || 10;
            currentPage = 1;
            applyFilter();
        }

        function renderUserTable() {
            var tableBody = $("#copy-print-csv tbody");
            tableBody.empty();

            if (!filteredUserList || filteredUserList.length === 0) {
                tableBody.html('<tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-info-circle me-1"></i> No matching user records found</td></tr>');
                $("#tableInfo").text("Showing 0 to 0 of 0 entries" + (fullUserList.length > 0 ? " (filtered from " + fullUserList.length + " total entries)" : ""));
                return;
            }

            var totalRecords = filteredUserList.length;
            var startIndex = (currentPage - 1) * pageSize;
            var endIndex = Math.min(startIndex + pageSize, totalRecords);

            var temp = "";
            var canEdit = currentPagePermission.Edit === true || currentPagePermission.Edit === "true";
            var canDelete = currentPagePermission.Delete === true || currentPagePermission.Delete === "true";

            for (var i = startIndex; i < endIndex; i++) {
                var user = filteredUserList[i];
                var srNo = i + 1;
                var profileImg = user.UserAccountProfile ? user.UserAccountProfile : '/img/user.png';
                var allowLoginHtml = (user.AllowLogin == "1" || user.AllowLogin == 1)
                    ? '<span class="status-badge bg-success text-white">Yes</span>'
                    : '<span class="status-badge bg-danger text-white">No</span>';

                var userName = user.UserAccountName || '-';
                var safeUserName = userName.replace(/'/g, "\\'").replace(/"/g, '&quot;');

                temp += "<tr>";
                temp += "<td class='text-center text-muted fw-bold'>" + srNo + "</td>";
                temp += "<td>" +
                    "<div class='user-profile-box'>" +
                    "<img class='avatar' src='" + profileImg + "' onerror=\"this.src='/img/user.png';\" alt='User Profile' />" +
                    "<a href='javascript:void(0);' class='user-name' title='" + safeUserName + "'>" + userName + "</a>" +
                    "</div>" +
                    "</td>";
                temp += "<td>" + (user.CompanyName || '-') + "</td>";
                temp += "<td><span class='user-role-badge'>" + (user.UserRole || '-') + "</span></td>";
                temp += "<td>" + (user.UserAccountMobileNo || '-') + "</td>";
                temp += "<td>" + (user.UserAccountEmail || '-') + "</td>";
                temp += "<td class='text-center'>" + allowLoginHtml + "</td>";
                temp += "<td class='text-center text-nowrap'>" + (user.UserAccountDateAndTimes || '-') + "</td>";

                // ACTIONS
                temp += "<td class='text-center'><div class='d-inline-flex align-items-center justify-content-center'>";
                if (!canEdit && !canDelete) {
                    temp += "<span class='text-muted'>-</span>";
                } else {
                    if (canEdit) {
                        temp += "<a href='javascript:void(0);' class='action-icon-btn text-info' title='Edit User' " +
                            "data-bs-toggle='modal' data-bs-target='#addNewContact' " +
                            "onclick='showRecords(" + user.UserAccountId + ")'>" +
                            "<i class='icon-edit1'></i>" +
                            "</a>";

                        temp += "<a href='javascript:void(0);' class='action-icon-btn text-warning' title='Reset Password' " +
                            "onclick='openAdminResetPassword(" + user.UserAccountId + ", \"" + safeUserName + "\")'>" +
                            "<i class='bi bi-key-fill'></i>" +
