        function validateEmail(email) {
            const re = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
            email = email.replace(/\s+/g, ' ').trim();
            var errorMessageValid = ".email-valid-feedback";
            var errorMessageInvalid = ".email-invalid-feedback";
            if (email == "") {
                document.getElementById("email").classList.remove("is-valid");
                document.getElementById("email").classList.add("is-invalid");
                $(errorMessageValid).hide(); $(errorMessageInvalid).show();
                return false;
            }
            else if (!re.test(String(email).toLowerCase())) {
                document.getElementById("email").classList.remove("is-valid");
                document.getElementById("email").classList.add("is-invalid");
                $(errorMessageValid).hide(); $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById("email").classList.add("is-valid");
                document.getElementById("email").classList.remove("is-invalid");
                $(errorMessageValid).show(); $(errorMessageInvalid).hide();
                return true;
            }
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "" || code.value == "0") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                $(".phone-less-feedback").hide();
                $(".cpassword-match-feedback").hide();
                return false;
            }
            else if (code.id == "phone" && code.value.length != 10) {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(".phone-less-feedback").show();
                $(".phone-invalid-feedback").hide();
                return false;
            }
            else if ((code.id == "cpassword" || (code.id == "password" && $("#cpassword").val() != "")) && $("#cpassword").val() != $("#password").val()) {
                document.getElementById("cpassword").classList.remove("is-valid");
                document.getElementById("cpassword").classList.add("is-invalid");
                document.getElementById("password").classList.remove("is-valid");
                document.getElementById("password").classList.add("is-invalid");
                $(".cpassword-match-feedback").show();
                $(".cpassword-invalid-feedback").hide();
                $(".password-invalid-feedback").hide();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                document.getElementById("cpassword").classList.remove("is-invalid");
                document.getElementById("password").classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(".password-invalid-feedback").hide();
                $(".cpassword-invalid-feedback").hide();
                $(errorMessageInvalid).hide();
                return true;
            }
        }

