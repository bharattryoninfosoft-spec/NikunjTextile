                preConfirm: () => {
                    var pwdInput = document.getElementById('adminNewPassword');
                    var newPassword = pwdInput ? pwdInput.value : '';
                    if (!newPassword || newPassword.trim().length < 4) {
                        Swal.showValidationMessage('Password must be at least 4 characters long.');
                        return false;
                    }
                    return $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/AdminChangeUserPassword',
                        data: {
                            TargetUserId: userId,
                            NewPassword: newPassword.trim()
                        },
                        dataType: "json"
                    }).then(response => {
                        var res = response.d || response;
                        if (typeof res === "string") {
                            try { res = JSON.parse(res); } catch (e) {}
                        }
                        if (res.Code !== 200) {
                            throw new Error(res.Message || 'Failed to reset password');
                        }
                        return res;
                    }).catch(error => {
                        Swal.showValidationMessage(error.message || 'Request failed');
                    });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    Toast.fire({
                        icon: 'success',
                        title: result.value.Message || 'Password reset successfully!'
                    });
                }
            });
        }
    </script>
}