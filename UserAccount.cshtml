                            "onclick='functionUserDelete(" + user.UserAccountId + ")'>" +
                            "<i class='icon-x-circle'></i>" +
                            "</a>";
                    }
                }
                temp += "</div></td>";
                temp += "</tr>";
            }

            tableBody.html(temp);

            var infoText = "Showing " + (startIndex + 1) + " to " + endIndex + " of " + totalRecords + " entries";
            if (filteredUserList.length !== fullUserList.length) {
                infoText += " (filtered from " + fullUserList.length + " total entries)";
