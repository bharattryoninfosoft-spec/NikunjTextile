                $("#ddlCompanyId option[value]").each(function () {
                    $(this).remove();
                });

                //$('#ddlCompanyId').append("<option value='-1'> -- Select -- </option>");

                for (var i = 0; i < jsonData.length; i++) {
                    admin = jsonData[i];

                    appendTemp = "<option value=" + admin.CompanyId + ">" + admin.CompanyName + "</option >";

                    $('#ddlCompanyId').append(appendTemp);
