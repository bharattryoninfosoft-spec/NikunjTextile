            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        function generatePDF() {
            if (typeof window.jspdf === "undefined") {
                Toast.fire({ icon: 'error', title: 'PDF library is not loaded.' });
                return;
            }
            if (!filteredUserList || filteredUserList.length === 0) {
                Toast.fire({ icon: 'warning', title: 'No data available to export.' });
                return;
            }
            const { jsPDF } = window.jspdf;
            var doc = new jsPDF('l', 'pt', 'a4');
            doc.setFontSize(16);
            doc.text('User Account Report', 40, 40);
            var headers = ['#', 'Name', 'Company Name', 'User Role', 'Mobile No', 'Email', 'Allow Login', 'Date'];
            var data = [];

            for (var i = 0; i < filteredUserList.length; i++) {
                var u = filteredUserList[i];
                var allowLogin = (u.AllowLogin == "1" || u.AllowLogin == 1) ? 'Yes' : 'No';
                data.push([
                    i + 1,
                    u.UserAccountName || '',
                    u.CompanyName || '',
                    u.UserRole || '',
                    u.UserAccountMobileNo || '',
                    u.UserAccountEmail || '',
                    allowLogin,
                    u.UserAccountDateAndTimes || ''
                ]);
            }

            doc.autoTable({
                head: [headers],
                body: data,
                startY: 60,
                theme: 'grid',
                margin: { left: 25, right: 25 },
                styles: { fontSize: 8, cellPadding: 5, valign: 'middle' },
                headStyles: { fontSize: 8, fontStyle: 'bold', halign: 'center' },
                didDrawPage: function (data) {
                    doc.setFontSize(8);
                    doc.text('Page ' + doc.internal.getNumberOfPages(), doc.internal.pageSize.width - 70, doc.internal.pageSize.height - 20);
                }
            });
            doc.save('UserAccountReport_' + getCurrentDateTime() + '.pdf');
        }

        function getCurrentDateTime() {
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var seconds = String(now.getSeconds()).padStart(2, '0');
            return year + month + day + '_' + hours + minutes + seconds;
        }

