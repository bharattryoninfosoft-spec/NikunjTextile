   function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getUserMaster?startFrom=' + rowStart,
            data: "{ 'startFrom':'" + rowStart + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listUserAccountMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
                    $("#view-more-btn").show();
                }
                for (var i = 0; i < response.listUserAccountMaster.length; i++) {
                    if (response.listUserAccountMaster[i].AllowLogin == "1" || response.listUserAccountMaster[i].AllowLogin == 1) {
                        operation = "<span class='badge bg-success'>Yes</span>";
                    }
                    else {
                        operation = "<span class='badge bg-danger'>No</span>";
                    }
                    temp += "<tr><td><div class='media-box'><img style='width:40px;height:40px;' src='" + response.listUserAccountMaster[i].UserAccountProfile + "' class='media-avatar' alt='Profile'><div class='media-box-body'><a href='javascript:void(0);' class='text-truncate'>" + response.listUserAccountMaster[i].UserAccountName + "</a><p></p></div></div></td><td>" + response.listUserAccountMaster[i].CompanyName + "</td><td>" + response.listUserAccountMaster[i].UserRole + "</td><td>" + response.listUserAccountMaster[i].UserAccountMobileNo + "</td><td>" + response.listUserAccountMaster[i].UserAccountEmail + "</td><td>" + operation + "</td><td>" + response.listUserAccountMaster[i].UserAccountDateAndTimes + "</td>";
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listUserAccountMaster[i].UserAccountId + ")'><i class='icon-edit1 text-info'></i></a><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listUserAccountMaster[i].UserAccountId + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "</tr>";

                }

                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }
   function showRecords(id) {
        clearAll();
        $("#upload-image-temp").val("");
        $("#upload-image").val("");
        $("#edit-id").val(id);
        $("#savebtn").hide();
        $("#editbtn").show();
        $("#addNewContactLabel").html("Edit User Account");
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getUserMasterById?id=' + id,
            data: "{ 'id':'" + id + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#full-name").val(response.listUserAccountMaster[0].UserAccountName);
                    $("#ddlCompanyId").val(response.listUserAccountMaster[0].CompanyID);
                    $("#userRole").val(response.listUserAccountMaster[0].UserRole);
                    $('#email').val(response.listUserAccountMaster[0].UserAccountEmail);
                    $('#phone').val(response.listUserAccountMaster[0].UserAccountMobileNo);
                    $('#email-temp').val(response.listUserAccountMaster[0].UserAccountEmail);
                    $('#phone-temp').val(response.listUserAccountMaster[0].UserAccountMobileNo);
                    $('.password-field').hide();
                    $('.password-field').hide();
                    if (response.listUserAccountMaster[0].AllowLogin == "1") {
                        $("#checkLogin").prop('checked', true);
                    }
                    else {
                        $("#checkLogin").prop('checked', false);
                    }
                    $("#upload-image-temp").val(response.listUserAccountMaster[0].UserAccountProfile);
                    var imgStr = "<img src='" + response.listUserAccountMaster[0].UserAccountProfile + "' style='height:200px;width:200px;margin-top:-54px;'>";
                    $("#image-preview").html(imgStr);
                    $("#image-preview").css('color', 'initial');
                }
                else {
                    $("#add-alert").removeClass("alert-success");
                    $("#add-alert").addClass("alert-danger");
                    $("#add-alert").html(response.Message);
                    $("#add-alert").show();
                }

            },
            error: function (request, status, error) {
                $("#add-alert").removeClass("alert-success");
                $("#add-alert").addClass("alert-danger");
                $("#add-alert").html(response.Message);
                $("#add-alert").show();
            }
        });

    }
