        function exportTableToExcel(tableID, filename = 'UserAccount') {
            var table = document.getElementById(tableID);
            if (!table) {
                Toast.fire({ icon: 'error', title: 'Table not found.' });
                return;
            }
            var clonedTable = table.cloneNode(true);
            var rows = clonedTable.querySelectorAll('tr');
            rows.forEach(function (row) {
                if (row.cells.length > 7) {
                    row.deleteCell(7);
                }
            });
            clonedTable.removeAttribute('id');
            clonedTable.removeAttribute('class');
            var html = `<html><head><meta charset="UTF-8"></head><body>${clonedTable.outerHTML}</body></html>`;
            var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.href = url;
            link.download = filename + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        function generatePDF() {
            if (typeof window.jspdf === "undefined") {
                Toast.fire({ icon: 'error', title: 'PDF library is not loaded.' });
                return;
            }
            const { jsPDF } = window.jspdf;
            var doc = new jsPDF('l', 'pt', 'a4');
            var table = document.getElementById('copy-print-csv');
            if (!table) {
                Toast.fire({ icon: 'error', title: 'Table not found.' });
                return;
            }
            doc.setFontSize(16);
            doc.text('User Account Report', 40, 40);
            var headers = ['Name', 'Company Name', 'User Role', 'Mobile No', 'Email', 'Allow Login', 'Date'];
            var data = [];
            var rows = table.querySelectorAll('tbody tr');
            rows.forEach(function (row) {
                if (row.style.display === 'none') { return; }
                var cells = row.querySelectorAll('td');
                if (cells.length < 7) { return; }
                var rowData = [];
                var nameElement = cells[0].querySelector('.media-box-body a');
                var name = nameElement ? nameElement.textContent.trim() : cells[0].textContent.trim();
                rowData.push(name);
                for (var i = 1; i < 7; i++) {
                    var value = cells[i].textContent.trim().replace(/\s+/g, ' ');
                    rowData.push(value);
                }
                data.push(rowData);
            });
            if (data.length === 0) {
                Toast.fire({ icon: 'warning', title: 'No data available to export.' });
                return;
            }
            doc.autoTable({
                head: [headers],
                body: data,
                startY: 60,
                theme: 'grid',
                margin: { left: 25, right: 25 },
                styles: { fontSize: 8, cellPadding: 5, valign: 'middle' },
                headStyles: { fontSize: 8, fontStyle: 'bold', halign: 'center' },
                didDrawPage: function (data) {
                    doc.setFontSize(8);
                    doc.text('Page ' + doc.internal.getNumberOfPages(), doc.internal.pageSize.width - 70, doc.internal.pageSize.height - 20);
                }
            });
            doc.save('UserAccountReport_' + getCurrentDateTime() + '.pdf');
        }

        function getCurrentDateTime() {
            var now = new Date();
            var year = now.getFullYear();
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var day = String(now.getDate()).padStart(2, '0');
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var seconds = String(now.getSeconds()).padStart(2, '0');
            return year + month + day + '_' + hours + minutes + seconds;
        }

        function printTable() {
            var table = document.getElementById("copy-print-csv");
            if (!table) {
                Toast.fire({ icon: 'error', title: 'Table not found.' });
                return;
            }
            var clonedTable = table.cloneNode(true);
            var rows = clonedTable.querySelectorAll('tr');
            rows.forEach(function (row) {
                if (row.cells.length > 7) {
                    row.deleteCell(7);
                }
                var actions = row.querySelectorAll('.actions');
                actions.forEach(function (element) {
                    element.remove();
                });
            });
            var style = `
                <style>
                    @@page { size: landscape; margin: 10mm; }
                    * { box-sizing: border-box; }
                    body { font-family: Arial, Helvetica, sans-serif; margin: 0; padding: 10px; color: #000; }
                    .print-header { text-align: center; margin-bottom: 15px; }
                    .print-header h2 { margin: 0; font-size: 20px; }
                    .print-header p { margin: 5px 0 0; font-size: 11px; }
                    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                    table, th, td { border: 1px solid #000; }
                    th { font-weight: bold; text-align: center; padding: 7px; font-size: 11px; }
                    td { padding: 6px; font-size: 10px; vertical-align: middle; word-break: break-word; }
                    .media-box { display: flex; align-items: center; gap: 8px; }
                    .media-avatar { width: 35px !important; height: 35px !important; object-fit: cover; border-radius: 50%; }
                    .media-box-body a { color: #000 !important; text-decoration: none !important; }
                    .badge { color: #000 !important; background: transparent !important; border: none !important; padding: 0 !important; }
                </style>
                `;
            var win = window.open('', '_blank', 'height=900,width=1200');
            if (!win) {
                Toast.fire({ icon: 'warning', title: 'Please allow pop-ups for printing.' });
                return;
            }
            win.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>User Account Report</title>${style}</head><body><div class="print-header"><h2>User Account Report</h2><p>Generated on: ${new Date().toLocaleString()}</p></div>${clonedTable.outerHTML}</body></html>`);
            win.document.close();
            win.focus();
            setTimeout(function () {
                win.print();
                setTimeout(function () { win.close(); }, 500);
            }, 700);
        }

        function searchTable() {
            var input, filter, table, tr, td, i, j, txtValue, found;
            input = document.getElementById("searchBox");
            filter = input.value.toUpperCase();
            table = document.getElementById("copy-print-csv");
            tr = table.getElementsByTagName("tr");

            for (i = 1; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td");
                found = false;

                for (j = 0; j < td.length; j++) {
                    if (td[j]) {
                        txtValue = td[j].textContent || td[j].innerText;
                        if (txtValue.toUpperCase().indexOf(filter) > -1) {
                            found = true;
                            break;
                        }
                    }
                }
                tr[i].style.display = found ? "" : "none";
            }
        }
    </script>
}