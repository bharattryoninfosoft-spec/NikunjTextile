<script>
   
    document.title = "Empty Location Report - Nikunj Textile";
    $('body').addClass('fullscreen');

    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#Report-tab").addClass("active");
        $("#tab-Report").addClass("show active");
        $("#aEmptyLocationReport").addClass("current-page");
        $(".nav-tabs .nav-link").removeClass("active");
        $(".nav-tabs .nav-link").attr("aria-selected", "false");
        $(".nav-tabs .nav-link[data-report='1']").addClass("active");
        $(".nav-tabs .nav-link[data-report='1']").attr("aria-selected", "true"); 
        FunctionIsLogin();
        LoadReport();        
    });

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            }
        });
    }
    let groupedData = {}; // ✅ GLOBAL (important)

    function LoadReport() {

        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/EmptyLocationReport',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',

            success: function (response) {

                let res = JSON.parse(response.d);
                let data = res.data;

                groupedData = {}; // reset

                // 👉 Group data
                data.forEach(item => {
                    if (!groupedData[item.GodownTitle]) {
                        groupedData[item.GodownTitle] = [];
                    }
                    groupedData[item.GodownTitle].push(item);
                });

                let html = '';
                let index = 1;

                // 👉 Render
                $.each(groupedData, function (godown, items) {

                    let safeGroup = godown.replace(/[^a-zA-Z0-9]/g, '_');

                    html += `
                    <tr class="group-header" data-group="${safeGroup}">
                        <td colspan="4">
                            <span class="toggle-btn">➕</span>
                            <strong>${godown} (${items.length})</strong>
                        </td>
                    </tr>
                `;

                    items.forEach(item => {
                        html += `
                        <tr class="group-row group-${safeGroup}">
                            <td>${index++}</td>
                            <td>${item.LocationTitle}</td>
                            <td>${item.GodownTitle}</td>
                            <td>${item.GodownAddress}</td>
                        </tr>
                    `;
                    });
                });

                $('#tblPendingGodown tbody').html(html);

                // 👉 Default collapse
                $('.group-row').hide();

                // 👉 Toggle
                $('.toggle-btn').off().on('click', function () {

                    let header = $(this).closest('tr');
                    let group = header.data('group');
                    let rows = $(`.group-${group}`);

                    if (rows.is(':visible')) {
                        rows.hide();
                        $(this).text('➕');
                    } else {
                        rows.show();
                        $(this).text('➖');
                    }
                });

                // 👉 Fill dropdown HERE (✅ FIXED)
                let options = '<option value="">All Godown</option>';

                Object.keys(groupedData).forEach(g => {
                    let safe = g.replace(/[^a-zA-Z0-9]/g, '_');
                    options += `<option value="${safe}">${g}</option>`;
                });

                $('#filterGodown').html(options);
            }
        });
    }
    $('#searchGodown').on('keyup', function () {

        let value = $(this).val().toLowerCase().trim();

        if (value === '') {
            $('#filterGodown').trigger('change'); // reset using filter
            return;
        }

        $('.group-header').hide();
        $('.group-row').hide();

        $('.group-row').each(function () {

            let location = $(this).find('td:eq(1)').text().toLowerCase();
            let godown = $(this).find('td:eq(2)').text().toLowerCase();

            if (location.includes(value) || godown.includes(value)) {

                $(this).show();

                let groupClass = $(this).attr('class').split(' ')
                    .find(c => c.startsWith('group-') && c !== 'group-row');

                let groupName = groupClass.replace('group-', '');

                let header = $(`.group-header[data-group="${groupName}"]`);
                header.show().find('.toggle-btn').text('➖');
            }
        });
    });
    $('#filterGodown').on('change', function () {

        let selected = $(this).val();

        // reset search
        $('#searchGodown').val('');

        if (selected === '') {
            $('.group-header').show();
            $('.group-row').hide();
            $('.toggle-btn').text('➕');
            return;
        }

        $('.group-header').hide();
        $('.group-row').hide();

        let header = $(`.group-header[data-group="${selected}"]`);
        let rows = $(`.group-${selected}`);

        header.show();
        rows.show();

        header.find('.toggle-btn').text('➖');
    });
    function applyFilters() {

        let searchValue = $('#searchGodown').val().toLowerCase().trim();
        let selectedGodown = $('#filterGodown').val();

        $('.group-header').hide();
        $('.group-row').hide();

        $('.group-row').each(function () {

            let location = $(this).find('td:eq(1)').text().toLowerCase();
            let godown = $(this).find('td:eq(2)').text().toLowerCase();

            let groupClass = $(this).attr('class').split(' ')
                .find(c => c.startsWith('group-') && c !== 'group-row');

            let groupName = groupClass.replace('group-', '');

            // ✅ Condition 1: Search match
            let matchSearch = (
                searchValue === '' ||
                location.includes(searchValue) ||
                godown.includes(searchValue)
            );

            // ✅ Condition 2: Dropdown match
            let matchGodown = (
                selectedGodown === '' ||
                groupName === selectedGodown
            );

            // ✅ BOTH conditions must match
            if (matchSearch && matchGodown) {

                $(this).show();

                let header = $(`.group-header[data-group="${groupName}"]`);
                header.show();

                header.find('.toggle-btn').text('➖');
            }
        });

        // 👉 Reset if no filters
        if (searchValue === '' && selectedGodown === '') {
            $('.group-header').show();
            $('.group-row').hide();
            $('.toggle-btn').text('➕');
        }
    }
    $('#searchGodown').on('keyup', applyFilters);
    $('#filterGodown').on('change', applyFilters);
</script>