@section Scripts {

    <script>

        $('body').addClass('fullscreen');

        var currentPagePermission = {};
        var ArrayYarnColor = [];
        var ArrayYarnMaterial = [];
        var IsJobWork = 0;
        var editingYarnRowNo = 0;
        var isSubmitting = false;
        $(document).ready(function () {

            var permission = getCookie("PagePermission");

            if (permission != null && permission != "") {

                currentPagePermission = JSON.parse(permission);

                if (currentPagePermission.Add == false) {
                    $("#savebtn").hide();
                }
            }

            $('.active, .show, .current-page')
                .removeClass('active show current-page');

            $("#YarnForm-tab").addClass("active");
            $("#tab-YarnForm").addClass("show active");
            $("#aCreateYarnRequirement").addClass("current-page");

            FunctionIsLogin();

            getPartyDetail();

            getDesignEntryForm();

        });
        function getDesignEntryForm() {

            var formData = new FormData();

            $.ajax({

                type: "POST",

                url: '/WebServiceNikunjTextile.asmx/getAllDesignEntryYarnReqForm',

                data: formData,

                dataType: 'json',

                contentType: false,

                processData: false,

                success: function (response) {

                    if (response.Code == "200") {

                        IsJobWork = parseInt(response.IsJobWork) || 0;

                        ArrayYarnMaterial = [];
                        ArrayYarnColor = [];

                        ArrayYarnMaterial.push(
                            response.listYarnMaterialMaster || []
                        );

                        ArrayYarnColor.push(
                            response.listYarnColorMaster || []
                        );


                        /* MATERIAL */

                        $("#yarnMaterial1").empty();

                        $("#yarnMaterial1").append(
                            "<option value='0'>Select Yarn Material</option>"
                        );

                        if (response.listYarnMaterialMaster &&
                            response.listYarnMaterialMaster.length > 0) {

                            $.each(
                                response.listYarnMaterialMaster,
                                function (i, item) {

                                    $("#yarnMaterial1").append(
                                        $("<option>", {
                                            value: item.YarnMaterialID,
                                            text: item.YarnMaterial
                                        })
                                    );

                                }
                            );
                        }


                        /* COLOR */

                        $("#YarnColor1").empty();

                        $("#YarnColor1").append(
                            "<option value='0'>Select Yarn Color</option>"
                        );

                        if (IsJobWork === 0) {

                            BindAllYarnColors(1);

                        }


                        /* REQUIREMENT NO */

                        if (response.listYarnRequirementMaster &&
                            response.listYarnRequirementMaster.length > 0) {

                            $("#RequirementNo").val(
                                response.listYarnRequirementMaster[0].RequirementNo
                            );

                        }

                    }

                },

                error: function (request, status, error) {

                    console.log(
                        "getAllDesignEntryYarnReqForm Error:",
                        error
                    );

                }

            });
        }
       function YarnMaterialChange(rowNo) {

            var materialId =
                parseInt($("#yarnMaterial" + rowNo).val()) || 0;

            $("#CompanyName" + rowNo)
                .empty()
                .append(
                    $("<option>", {
                        value: "0",
                        text: "Select Company"
                    })
                );

            $("#ColorCode" + rowNo).val("");

            if (materialId === 0) {

                $("#YarnColor" + rowNo)
                    .empty()
                    .append(
                        $("<option>", {
                            value: "0",
                            text: "Select Yarn Color"
                        })
                    );

                if (IsJobWork === 0) {
                    BindAllYarnColors(rowNo);
                }

                return;
            }

            BindYarnColorsByMaterial(
                rowNo,
                materialId,
                0
            );
        }
        function BindAllYarnColors(rowno) {
            var colorDDL = $("#YarnColor" + rowno);
            colorDDL.empty();
            colorDDL.append("<option value='0'>Select Yarn Color</option>");

            if (!ArrayYarnColor || !ArrayYarnColor[0]) {
                return;
            }

            var seenColorIds = {};
            $.each(ArrayYarnColor[0], function (i, item) {
                var itemColorId = parseInt(item.YarnColorID) || 0;
                var colorName = (item.YarnColor || "").trim();
                if (itemColorId > 0 && colorName !== "" && !seenColorIds[itemColorId]) {
                    seenColorIds[itemColorId] = true;
                    colorDDL.append(
                        $("<option>", {
                            value: itemColorId,
                            text: colorName
                        })
                    );
                }
            });
        }
        function BindYarnColorsByMaterial(
            rowNo,
            materialId,
            selectedColorId
        ) {
            var colorDDL = $("#YarnColor" + rowNo);
            colorDDL.empty();
            colorDDL.append(
                $("<option>", {
                    value: "0",
                    text: "Select Yarn Color"
                })
            );

            if (!ArrayYarnColor || !ArrayYarnColor[0]) {
                return;
            }

            var matId = parseInt(materialId) || 0;
            var seenColorIds = {};

            $.each(ArrayYarnColor[0], function (i, item) {
                var itemMaterialId = parseInt(item.YarnMaterialID) || 0;
                var itemColorId = parseInt(item.YarnColorID) || 0;
                var colorName = (item.YarnColor || "").trim();

                if (matId === 0 || itemMaterialId === matId) {
                    if (itemColorId > 0 && colorName !== "" && !seenColorIds[itemColorId]) {
                        seenColorIds[itemColorId] = true;
                        colorDDL.append(
                            $("<option>", {
                                value: itemColorId,
                                text: colorName
                            })
                        );
                    }
                }
            });

            if (selectedColorId) {
                colorDDL.val(String(selectedColorId));
            }
        }
        function YarnColorChange(rowNo) {
            var materialId = parseInt($("#yarnMaterial" + rowNo).val()) || 0;
            var colorId = parseInt($("#YarnColor" + rowNo).val()) || 0;
            var $company = $("#CompanyName" + rowNo);
            var $colorCode = $("#ColorCode" + rowNo);

            // Clear Company
            $company.empty().append(
                $("<option>", {
                    value: "0",
                    text: "Select Company"
                })
            );
            $colorCode.val("");

            if (materialId === 0 || colorId === 0) {
                $company.prop("disabled", true);
                return;
            }

            if (!ArrayYarnColor || !ArrayYarnColor[0]) {
                return;
            }

            // Find all distinct companies matching this material and color
            var matchingCompanies = [];
            var seenCompanyIds = {};

            $.each(ArrayYarnColor[0], function (i, item) {
                var itemMaterialId = parseInt(item.YarnMaterialID) || 0;
                var itemColorId = parseInt(item.YarnColorID) || 0;
                var compId = parseInt(item.CompanyId) || 0;
                var compName = (item.CompanyName || "").trim();
                var compCode = (item.CompanyCode || "").trim();

                if (itemMaterialId === materialId && itemColorId === colorId) {
                    if (compId > 0 && compName !== "" && !seenCompanyIds[compId]) {
                        seenCompanyIds[compId] = true;
                        matchingCompanies.push({
                            CompanyId: compId,
                            CompanyName: compName,
                            CompanyCode: compCode
                        });
                    }
                }
            });

            if (matchingCompanies.length === 0) {
                console.log("No companies found for material:", materialId, "color:", colorId);
                $company.prop("disabled", true);
                return;
            }

            // Populate all matching companies into dropdown
            $.each(matchingCompanies, function (i, comp) {
                $company.append(
                    $("<option>", {
                        value: comp.CompanyId,
                        text: comp.CompanyName,
                        "data-companycode": comp.CompanyCode
                    })
                );
            });

            // Enable company dropdown so user can select if multiple companies exist
            $company.prop("disabled", false);

            if (matchingCompanies.length === 1) {
                // If only 1 company, select it automatically and populate code
                $company.val(String(matchingCompanies[0].CompanyId));
                $colorCode.val(matchingCompanies[0].CompanyCode);
            } else {
                // If multiple companies exist, prompt user to choose
                $company.val("0");
                $colorCode.val("");
            }
        }
        function YarnPOCompany(rowNo) {
            return false;
        }
        function YarnCompanyChange(rowNo) {
            var selectedCompanyId = parseInt($("#CompanyName" + rowNo).val()) || 0;
            var materialId = parseInt($("#yarnMaterial" + rowNo).val()) || 0;
            var colorId = parseInt($("#YarnColor" + rowNo).val()) || 0;
            var $colorCode = $("#ColorCode" + rowNo);

            if (selectedCompanyId === 0) {
                $colorCode.val("");
                return;
            }

            var selectedOption = $("#CompanyName" + rowNo + " option:selected");
            var code = selectedOption.attr("data-companycode");
            if (code && code.trim() !== "") {
                $colorCode.val(code);
            } else {
                $.each(ArrayYarnColor[0], function (i, item) {
                    if (parseInt(item.YarnMaterialID) === materialId &&
                        parseInt(item.YarnColorID) === colorId &&
                        parseInt(item.CompanyId) === selectedCompanyId) {
                        $colorCode.val(item.CompanyCode || "");
                        return false;
                    }
                });
            }

            console.log("Selected CompanyID:", selectedCompanyId, "Code:", $colorCode.val());
        }
        function FunctionIsLogin() {

            $.ajax({

                type: "POST",

                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',

                data: "{ 'userName':'0' }",

                contentType: "application/json; charset=utf-8",

                dataType: "json",

                success: function (data) {

                    if (data.d == "false") {

                        window.location.replace(
                            "/Index"
                        );

                    }

                }

            });

        }
        var cachedJobbersList = [];

        function populateJobberUI(jobber) {
            if (!jobber) {
                $("#DivLblPartyDetails").hide();
                return;
            }

            $("#DivLblPartyDetails").show();
            $('#hPartyId').val(jobber.Id);

            var mob = jobber.MobileNumber || "";
            if (jobber.AlternateNumber && jobber.AlternateNumber.trim() !== "") {
                mob += (mob ? " / " : "") + jobber.AlternateNumber;
            }

            $('#PMobileNo').html("<b>Mobile No: </b>" + mob);
            $('#PEmail').html("<b>Email : </b>" + (jobber.Email || ""));
            $("#PBillingAddress").html("<b>Address : </b>" + (jobber.BillingAddress || ""));
            $('#PState').html("<b>State : </b>" + (jobber.PlaceOfSupply || ""));
            $('#PGSTIN').html("<b>GSTIn : </b>" + (jobber.Gstin || ""));
            $('#divPartyName').html(jobber.PartyName || "");
        }

        function getPartyDetail() {
            var formData = new FormData();

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getJobberDetailsForYarnRequirement',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200" || response.Code == 200) {
                        $('#ddlParty').empty();
                        cachedJobbersList = response.listJobber || [];

                        var jobbers = response.listJobber || [];
                        var isJobberUser = response.IsJobber || false;

                        if (!isJobberUser && jobbers.length > 1) {
                            $('#ddlParty').append(
                                $("<option>", {
                                    value: "",
                                    text: "Select Party Name"
                                })
                            );
                        }

                        if (jobbers.length > 0) {
                            $.each(jobbers, function (i, item) {
                                $('#ddlParty').append(
                                    $("<option>", {
                                        value: item.Id,
                                        text: item.PartyName
                                    })
                                );
                            });

                            if (isJobberUser || jobbers.length === 1) {
                                var firstJobber = jobbers[0];
                                $('#ddlParty').val(String(firstJobber.Id));
                                $('#ddlParty').prop('disabled', true);
                                populateJobberUI(firstJobber);
                            }
                            else {
                                $('#ddlParty').prop('disabled', false);
                                $('#ddlParty').val("");
                                $("#DivLblPartyDetails").hide();
                            }

                            $('#ddlParty').trigger('change');
                        } else {
                            $('#ddlParty').append(
                                $("<option>", {
                                    value: "",
                                    text: "No Jobbers Found"
                                })
                            );
                        }
                    }
                },
                error: function (request, status, error) {
                    console.log("getJobberDetailsForYarnRequirement Error:", error);
                }
            });
        }

        function functionParty(abc) {
            if (!abc || abc == "") {
                $("#DivLblPartyDetails").hide();
                return;
            }

            // 1. Search cached jobbers
            if (cachedJobbersList && cachedJobbersList.length > 0) {
                var found = cachedJobbersList.find(function (j) {
                    return String(j.Id) === String(abc);
                });
                if (found) {
                    populateJobberUI(found);
                    return;
                }
            }

            // 2. Fallback to API
            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/GetJobberById",
                data: JSON.stringify({ id: parseInt(abc, 10) }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var jobber = response.d || response;
                    if (typeof jobber === "string") {
                        try { jobber = JSON.parse(jobber); } catch (e) { }
                    }
                    if (jobber && jobber.Id) {
                        populateJobberUI(jobber);
                    } else {
                        $("#DivLblPartyDetails").hide();
                    }
                },
                error: function () {
                    $("#DivLblPartyDetails").hide();
                }
            });
        }
        function validate(code) {

            if (!code) {
                return true;
            }


            code.value =
                String(code.value || "")
                    .replace(/\s+/g, ' ')
                    .trim();


            if (
                code.value === "" ||
                code.value === "0" ||
                code.value === "-1"
            ) {

                document
                    .getElementById(code.id)
                    .classList
                    .remove("is-valid");

                document
                    .getElementById(code.id)
                    .classList
                    .add("is-invalid");

                return false;

            }
            else {

                document
                    .getElementById(code.id)
                    .classList
                    .add("is-valid");

                document
                    .getElementById(code.id)
                    .classList
                    .remove("is-invalid");

                return true;

            }

        }
        function toggleSaveLoader(show) {

            $("#savebtn")
                .prop("disabled", show);

            $("#btnText")
                .toggle(!show);

            $("#btnLoader")
                .toggle(show);

        }
        function checkSave() {

            if (isSubmitting) {
                return false;
            }


            isSubmitting = true;

            toggleSaveLoader(true);


            try {

                var InvoiceDate =
                    document.getElementById(
                        "InvoiceDate"
                    );


                var RequirementNo =
                    document.getElementById(
                        "RequirementNo"
                    );


                var PartyId =
                    document.getElementById(
                        "ddlParty"
                    );


                /* DATE */

                if (
                    !InvoiceDate ||
                    !InvoiceDate.value
                ) {

                    Swal.fire({
                        icon: "warning",
                        title: "Requirement Date Required",
                        text: "Please select Requirement Date."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                /* REQUIREMENT NO */

                if (
                    !RequirementNo ||
                    !RequirementNo.value ||
                    RequirementNo.value === "0"
                ) {

                    Swal.fire({
                        icon: "warning",
                        title: "Requirement No Required",
                        text: "Requirement No is required."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                /* PARTY */

                var selectedPartyVal = (PartyId && PartyId.value) ? PartyId.value : ($('#hPartyId').val() || "");

                if (
                    !selectedPartyVal ||
                    selectedPartyVal === "0" ||
                    selectedPartyVal === "-1"
                ) {

                    Swal.fire({
                        icon: "warning",
                        title: "Party Required",
                        text: "Please select Party."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                /* =====================================================
                   GET ROW NUMBERS
                ====================================================== */

                var txtYarnArray =
                    $("#txtYarnDetailsArray").val() || "";


                var rowNumbers =
                    txtYarnArray
                        .split("|")
                        .filter(function (x) {

                            return x &&
                                x.trim() !== "";

                        });


                if (rowNumbers.length === 0) {

                    Swal.fire({
                        icon: "warning",
                        title: "No Rows Added",
                        text: "Please add at least one yarn detail row."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                var detailArray = [];


                /* =====================================================
                   READ EACH ROW
                ====================================================== */

                for (
                    var j = 0;
                    j < rowNumbers.length;
                    j++
                ) {

                    var rowNum =
                        rowNumbers[j].trim();


                    var materialElement =
                        document.getElementById(
                            "yarnMaterialDetail" +
                            rowNum
                        );


                    var colorElement =
                        document.getElementById(
                            "YarnColorDetail" +
                            rowNum
                        );


                    /*
                     * IMPORTANT:
                     * CompanyNameDetail nahi.
                     * CompanyIDDetail use karvu.
                     */

                    var companyElement =
                        document.getElementById(
                            "CompanyIDDetail" +
                            rowNum
                        );


                    var colorCodeElement =
                        document.getElementById(
                            "ColorCodeDetail" +
                            rowNum
                        );


                    var boxElement =
                        document.getElementById(
                            "NoOfBoxDetail" +
                            rowNum
                        );


                    /* MATERIAL */

                    if (!materialElement) {

                        Swal.fire({
                            icon: "warning",
                            title: "Material Required",
                            text:
                                "Material data is missing in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    var YMVal =
                        String(
                            materialElement.value || ""
                        ).trim();


                    if (
                        !YMVal ||
                        YMVal === "0" ||
                        YMVal === "-1"
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Material Required",
                            text:
                                "Please select Material in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* COLOR */

                    if (!colorElement) {

                        Swal.fire({
                            icon: "warning",
                            title: "Color Required",
                            text:
                                "Color data is missing in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    var YCVal =
                        String(
                            colorElement.value || ""
                        ).trim();


                    if (
                        !YCVal ||
                        YCVal === "0" ||
                        YCVal === "-1"
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Color Required",
                            text:
                                "Please select Color in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* =================================================
                       COMPANY ID
                    ================================================== */

                    var CompanyIDVal =
                        companyElement
                            ? String(
                                companyElement.value || "0"
                            ).trim()
                            : "0";


                    /* =================================================
                       COLOR CODE
                    ================================================== */

                    var CCVal =
                        colorCodeElement
                            ? String(
                                colorCodeElement.value || ""
                            ).trim()
                            : "";


                    /* =================================================
                       BOXES
                    ================================================== */

                    var NOBVal =
                        boxElement
                            ? String(
                                boxElement.value || ""
                            ).trim()
                            : "";


                    var NoofBoxes =
                        parseInt(
                            NOBVal,
                            10
                        );


                    if (
                        !NOBVal ||
                        isNaN(NoofBoxes) ||
                        NoofBoxes <= 0
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Boxes Required",
                            text:
                                "Please enter valid No Of Boxes in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* =================================================
                       COMPANY VALIDATION ONLY JOB WORK
                    ================================================== */

                    if (
                        parseInt(IsJobWork, 10) === 1 &&
                        (
                            !CompanyIDVal ||
                            CompanyIDVal === "0"
                        )
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Company Required",
                            text:
                                "Please select Company in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* =================================================
                       FINAL DETAIL OBJECT

                       OLD:
                       CompanyName: CompanyID

                       NEW:
                       CompanyID: CompanyIDVal
                    ================================================== */

                    detailArray.push({

                        YarnMaterialID:
                            parseInt(
                                YMVal,
                                10
                            ),

                        YarnColorID:
                            parseInt(
                                YCVal,
                                10
                            ),

                        CompanyName:
                            parseInt(
                                CompanyIDVal,
                                10
                            ) || 0,

                        CompanyColourCode:
                            CCVal,

                        NoofBoxes:
                            NoofBoxes

                    });

                }


                /* =====================================================
                   MASTER OBJECT
                ====================================================== */

                var YarnRequirementObject = {

                    RequirementDates:
                        InvoiceDate.value,

                    RequirementNo:
                        RequirementNo.value,

                    PartyId:
                        parseInt(
                            selectedPartyVal,
                            10
                        ),

                    listYarnRequirementDetail:
                        detailArray

                };


                var YarnRequirementArray =
                    JSON.stringify(
                        YarnRequirementObject
                    );


                console.log(
                    "YarnRequirementArray:",
                    YarnRequirementArray
                );


                var formData =
                    new FormData();


                formData.append(
                    "YarnRequirementArray",
                    YarnRequirementArray
                );


                /* =====================================================
                   SAVE API
                ====================================================== */

                $.ajax({

                    type: "POST",

                    url:
                        "/WebServiceNikunjTextile.asmx/insertYarnRequirementMasterMaster",

                    data: formData,

                    dataType: "json",

                    contentType: false,

                    processData: false,

                    success: function (response) {

                        if (response.Code == 200) {

                            Swal.fire({

                                icon: "success",

                                title: "Success",

                                text:
                                    "Yarn Requirement Created Successfully.",

                                confirmButtonText: "OK",

                                allowOutsideClick: false

                            }).then(function () {

                                window.location.href =
                                    "YarnRequirement";

                            });

                        }
                        else {

                            Swal.fire({

                                icon: "error",

                                title: "Error",

                                text:
                                    response.Message ||
                                    "Unable to save Yarn Requirement."

                            });


                            isSubmitting = false;

                            toggleSaveLoader(false);

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "insertYarnRequirementMasterMaster Error:",
                            xhr.responseText
                        );


                        Swal.fire({

                            icon: "error",

                            title: "Server Error",

                            text:
                                "Problem occurred while submitting your data."

                        });


                        isSubmitting = false;

                        toggleSaveLoader(false);

                    }

                });

            }
            catch (error) {

                console.error(
                    "checkSave Error:",
                    error
                );


                Swal.fire({

                    icon: "error",

                    title: "Error",

                    text:
                        error.message ||
                        "Something went wrong."

                });


                isSubmitting = false;

                toggleSaveLoader(false);

                return false;

            }


            return true;

        }
