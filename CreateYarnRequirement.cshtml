    var ArrayYarnColor = [];
    var ArrayYarnMaterial = [];
    function getDesignEntryForm() {

        var formData = new FormData();
        //formData.append('SaleInvoiceID', SaleInvoiceID);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getAllDesignEntryYarnReqForm',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);
                //alert(response.Code);

                if (response.Code == "200") {

                    ArrayYarnColor.push(response.listYarnColorMaster);
                    ArrayYarnMaterial.push(response.listYarnMaterialMaster);

                    //console.log(ArrayYarnColor);
                    //console.log(ArrayYarnMaterial);



                    //Yarn Color
                    if (response.listYarnColorMaster.length > 0) {
                        var templistYarnColorMaster = "";




                        templistYarnColorMaster = "<option value='0' selected> Select Yarn Color </option>";
                        $('#YarnColor1').append(templistYarnColorMaster);
                        for (var i = 0; i < response.listYarnColorMaster.length; i++) {
                            templistYarnColorMaster = "<option value='" + response.listYarnColorMaster[i].YarnColorID + "'> " + response.listYarnColorMaster[i].YarnColor + " </option>";
                            $('#YarnColor1').append(templistYarnColorMaster);
                        }
                    }




                    //Yarn Materia
                    if (response.listYarnMaterialMaster.length > 0) {
                        var templistYarnMaterialMaster = "";

                        templistYarnMaterialMaster = "<option value='0' selected> Select Yarn Material </option>";
                        $('#yarnMaterial1').append(templistYarnMaterialMaster);

                        for (var i = 0; i < response.listYarnMaterialMaster.length; i++) {
                            templistYarnMaterialMaster = "<option value='" + response.listYarnMaterialMaster[i].YarnMaterialID + "'> " + response.listYarnMaterialMaster[i].YarnMaterial + " </option>";
                            $('#yarnMaterial1').append(templistYarnMaterialMaster);
                        }
                    }


                    //Yarn Requirement NO

                    if (response.listYarnRequirementMaster.length > 0) {

                        $('#RequirementNo').val(response.listYarnRequirementMaster[0].RequirementNo);


                    }






                }




            },
            error: function (request, status, error) {

                //window.location.href = 'SaleInvoice';

            }
        });
    }
    function YarnColorChange(rowno) {


        //console.log(ArrayYarnColor[0]);

        var yarnColors = ArrayYarnColor[0];

        var YarColo = "#YarnColor" + rowno;
        var tdYarnColor = "#tdYarnColor" + rowno;

        var yarnColor = yarnColors.find(item => item.YarnColorID === parseInt($(YarColo).val()));
        //alert(yarnColor.YarnColorCode);
        var ColorCode = "#" + yarnColor.YarnColorCode;
        $(tdYarnColor).css("background-color", ColorCode);



        YarnPOCompany(rowno);

    }
    function YarnPOCompany(rowno) {

        var YarnMaterial = "yarnMaterial" + rowno;
        var YarnColor = "YarnColor" + rowno;


        var YM = document.getElementById(YarnMaterial);
        var YC = document.getElementById(YarnColor);


        if (YM.value != '0' && YC.value != '0') {
            //alert(YM.value + " " + YC.value);

            var formData = new FormData();
            formData.append('YarnMaterialID', YM.value);
            formData.append('YarnColorID', YC.value);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnPOBillToCompany',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.listPartyMaster.length > 0) {
                        var appendTemp = "";
                        for (var j = 1; j <= response.listPartyMaster.length; j++) {

                            var CompanyName = "CompanyName" + rowno;
                            var CN = "#CompanyName" + rowno;
                            document.getElementById(CompanyName).innerHTML = "";
                            //CompanyCode

                            $(CN).empty();


                            if (response.listPartyMaster.length == 1) {
                                $(CN).append("<option value='0'>Select Company</option>");

                                for (var i = 0; i < response.listPartyMaster.length; i++) {
                                    let party = response.listPartyMaster[i];

                                    appendTemp = "<option value='" + party.PartyId + "' selected> "
                                        + party.PartyName + " (" + party.SundryParty + ")"
                                        + " </option>";

                                    $(CN).append(appendTemp);
                                }
                            }
                            else {
