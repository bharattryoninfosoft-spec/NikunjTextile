@{ Layout = "/_LayoutPage1.cshtml"; }

<div class="content-wrapper">

    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>

    <!-- =========================================================
         PARTY MASTER MODAL
    ========================================================== -->
    <button id="AddPartyModel"
            style="float:right; display:none;"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addNewContact">
    </button>

    <div class="modal fade"
         id="addNewContact"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         aria-labelledby="addNewContactLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-xl" role="document">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addNewContactLabel">
                        Add Party
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true"></span>
                    </button>
                </div>

                <div class="modal-body"
                     id="divModelBody"
                     style="overflow:initial !important;height:500px !important;">

                    <div id="add-alert"
                         class="alert alert-success"
                         role="alert">
                        Record has been saved Successfully.
                    </div>

                    <!-- =====================================================
                         YARN MATERIAL
                    ====================================================== -->
                    <div class="row gutters"
                         id="DivYarnMaterial"
                         style="display:none;">

                        <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">

                            <div class="row gutters">

                                <div class="col-4">
                                    <div class="field-wrapper">

                                        <input type="text"
                                               id="YarnMaterial"
                                               name="YarnMaterial"
                                               class="form-control clear-field"
                                               onfocusout="validate(this)">

                                        <div class="field-placeholder">
                                            Material & Quality
                                            <sup style="color:red;">*</sup>
                                        </div>

                                        <div class="YarnMaterial-valid-feedback valid-feedback">
                                            Looks good!
                                        </div>

                                        <div class="YarnMaterial-invalid-feedback invalid-feedback">
                                            Please Mention Yarn Material & Quality
                                        </div>

                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="field-wrapper">

                                        <input type="text"
                                               id="Denier"
                                               name="Denier"
                                               class="form-control clear-field">

                                        <div class="field-placeholder">
                                            Denier
                                        </div>

                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="field-wrapper">

                                        <div class="form-check form-check-inline">
                                            <br />

                                            <input id="IsActiveYarnMaterial"
                                                   class="form-check-input"
                                                   type="checkbox"
                                                   value="1"
                                                   checked>

                                            <label class="form-check-label"
                                                   for="IsActiveYarnMaterial">
                                                Is Active
                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="field-wrapper">

                                        <select id="ServiceUnit"
                                                class="select-single js-states"
                                                title="Select Unit"
                                                data-live-search="true">

                                            <option value="-1">
                                                Select
                                            </option>

                                        </select>

                                        <div class="field-placeholder">
                                            Unit
                                            <sup style="color:red;">*</sup>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="field-wrapper">

                                        <div class="input-group">

                                            <input class="form-control clear-field detail"
                                                   type="text"
                                                   id="HSNSACCOde"
                                                   placeholder="HSN Code"
                                                   onfocusout="validate(this)">

                                        </div>

                                        <div class="field-placeholder">
                                            HSN Code
                                            <sup style="color:red;">*</sup>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="field-wrapper">

                                        <select id="GSTSLABId"
                                                class="select-single js-states"
                                                title="Select GST Slab"
                                                data-live-search="true">

                                            <option value="-1">
                                                Select
                                            </option>

                                        </select>

                                        <div class="field-placeholder">
                                            GST Slab
                                            <sup style="color:red;">*</sup>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- =====================================================
                         YARN COLOR
                    ====================================================== -->
                    <div class="row gutters"
                         id="DivYarnColor"
                         style="display:none;">

                        <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">

                            <div class="row gutters">

                                <div class="col-5">
                                    <div class="field-wrapper">

                                        <input type="text"
                                               id="YarnColor"
                                               name="YarnColor"
                                               class="form-control clear-field"
                                               onfocusout="validate(this)">

                                        <div class="field-placeholder">
                                            Color
                                            <sup style="color:red;">*</sup>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-3">
                                    <div class="field-wrapper">

                                        <div class="input-group">

                                            <span class="input-group-text">
                                                #
                                            </span>

                                            <input type="text"
                                                   id="YarnColorCode"
                                                   name="YarnColorCode"
                                                   class="form-control clear-field"
                                                   onfocusout="validate(this)"
                                                   onkeyup="changeYarnColor(this)">

                                        </div>

                                        <div class="field-placeholder">
                                            Color Code
                                            <sup style="color:red;">*</sup>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-2">
                                    <div class="field-wrapper">

                                        <div class="form-check form-check-inline">
                                            <br />

                                            <input id="IsActiveYarnColor"
                                                   class="form-check-input"
                                                   type="checkbox"
                                                   value="1"
                                                   checked>

                                            <label class="form-check-label"
                                                   for="IsActiveYarnColor">
                                                Is Active
                                            </label>

                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- =====================================================
                         PARTY MASTER
                    ====================================================== -->
                    <div class="row gutters"
                         id="DivPartyMaster"
                         style="display:none;">

                        <div class="row gutters">

                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">

                                <div class="row gutters">

                                    <div class="col-6">

                                        <div class="row gutters">

                                            <div class="col-6">
                                                <div class="form-section-header"
                                                     style="background:transparent;margin:0;margin-top:5px;">
                                                    Party Details
                                                </div>
                                            </div>

                                            <div class="col-6"></div>

                                            <hr />

                                            <!-- GST -->
                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="gstin"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           placeholder="ex: 20XXXXX9438X1XX"
                                                           maxlength="15"
                                                           onkeyup="validate(this)"
                                                           style="text-transform:uppercase;">

                                                    <input id="gstintemp"
                                                           type="hidden">

                                                    <div class="field-placeholder">
                                                        GSTIN
                                                    </div>

                                                    <div class="gstin-invalid-feedback invalid-feedback"
                                                         id="GSTError">
                                                        Please Provide Valid GSTIN Number
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- PAN -->
                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="PanNo"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           placeholder="PanNo"
                                                           maxlength="10"
                                                           onkeyup="validate(this)"
                                                           style="text-transform:uppercase;">

                                                    <input id="PanNotemp"
                                                           type="hidden">

                                                    <div class="field-placeholder">
                                                        PAN No
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- PARTY NAME -->
                                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                                                <div class="field-wrapper">

                                                    <input id="party-name"
                                                           placeholder="Enter Name"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           onfocusout="validate(this)">

                                                    <div class="field-placeholder">
                                                        Party Name
                                                        <span class="text-danger">*</span>
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- MOBILE -->
                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="phone"
                                                           placeholder="Enter Mobile"
                                                           type="tel"
                                                           class="form-control clear-field detail"
                                                           maxlength="10"
                                                           onfocusout="validate(this)"
                                                           onkeypress="return event.charCode>=48 && event.charCode<=57">

                                                    <input id="phonetemp"
                                                           type="hidden">

                                                    <div class="field-placeholder">
                                                        Mobile Number
                                                        <span class="text-danger">*</span>
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- ALTERNATE MOBILE -->
                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="alt-phone"
                                                           placeholder="Enter Alternate Mobile"
                                                           type="tel"
                                                           class="form-control clear-field detail"
                                                           maxlength="10"
                                                           onkeypress="return event.charCode>=48 && event.charCode<=57">

                                                    <div class="field-placeholder">
                                                        Alternate Number
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- EMAIL -->
                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="email"
                                                           placeholder="Enter Email"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           onfocusout="validateEmail(this.value,this)">

                                                    <input type="hidden"
                                                           id="email-temp"
                                                           value="" />

                                                    <input type="hidden"
                                                           id="phone-temp"
                                                           value="" />

                                                    <div class="field-placeholder">
                                                        Email
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12"></div>

                                            <!-- PLACE -->
                                            <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">

                                                <div class="field-wrapper">

                                                    <select id="placeOfSupply"
                                                            class="select-single js-states clear-field detail"
                                                            title="Select Place"
                                                            data-live-search="true">

                                                        <option value="-1">
                                                            Select
                                                        </option>

                                                    </select>

                                                    <div class="field-placeholder">
                                                        Place Of Supply
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- PINCODE -->
                                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">

                                                <div class="field-wrapper">

                                                    <input id="pincode"
                                                           placeholder="Enter Pincode"
                                                           type="tel"
                                                           class="form-control clear-field detail"
                                                           maxlength="6"
                                                           onfocus="myFunctionPINCODE(this.value)"
                                                           onkeyup="myFunctionPINCODE(this)"
                                                           onkeypress="return event.charCode>=48 && event.charCode<=57">

                                                    <div class="field-placeholder">
                                                        Pincode
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- CITY -->
                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">

                                                <div class="field-wrapper">

                                                    <input id="city"
                                                           placeholder="Enter City"
                                                           type="text"
                                                           class="form-control clear-field detail">

                                                    <div class="field-placeholder">
                                                        City
                                                    </div>

                                                </div>

                                            </div>

                                            <!-- ACTIVE -->
                                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                                                <div class="field-wrapper">

                                                    <div class="form-check form-check-inline">

                                                        <input class="form-check-input clear-field detail"
                                                               type="checkbox"
                                                               id="chcekIsActiveParty"
                                                               checked>

                                                        <label class="form-check-label"
                                                               for="chcekIsActiveParty">
                                                            Is Active Party
                                                        </label>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                    </div>

                                    <!-- =====================================================
                                         BANK DETAILS
                                    ====================================================== -->
                                    <div class="col-6"
                                         style="border-left:1px solid #c3c3c3;">

                                        <div class="col-6">
                                            <div class="form-section-header"
                                                 style="background:transparent;margin:0;margin-top:5px;">
                                                Bank Details
                                            </div>
                                        </div>

                                        <hr style="margin:0 0 16px 0;" />

                                        <div class="row gutters">

                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="BankHolderName"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           placeholder="Bank Holder Name">

                                                    <div class="field-placeholder">
                                                        Bank Holder Name
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">

                                                <div class="field-wrapper">

                                                    <input id="BankAccountNo"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           placeholder="Bank Account No">

                                                    <div class="field-placeholder">
                                                        Bank A/c No
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">

                                                <div class="field-wrapper">

                                                    <input id="BankIFSCCode"
                                                           placeholder="Enter IFSC"
                                                           type="text"
                                                           maxlength="11"
                                                           class="form-control clear-field detail"
                                                           onfocus="myFunctionIFSC(this.value)"
                                                           onkeyup="myFunctionIFSC(this)">

                                                    <div class="field-placeholder">
                                                        Bank IFSC
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">

                                                <div class="field-wrapper">

                                                    <input id="BankName"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           placeholder="Bank Name"
                                                           readonly>

                                                    <div class="field-placeholder">
                                                        Bank Name
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">

                                                <div class="field-wrapper">

                                                    <input id="BankBranch"
                                                           type="text"
                                                           class="form-control clear-field detail"
                                                           placeholder="Bank Branch"
                                                           readonly>

                                                    <div class="field-placeholder">
                                                        Bank Branch
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <!-- ADDRESS -->
                                        <div class="col-6">

                                            <div class="form-section-header"
                                                 style="background:transparent;margin:0;margin-top:5px;">
                                                Address Details
                                            </div>

                                        </div>

                                        <hr style="margin:5px 0 16px 0;" />

                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                                            <div class="field-wrapper">

                                                <textarea id="billingAddress"
                                                          onkeyup="checkShippingAdd()"
                                                          class="form-control clear-field detail"
                                                          rows="3"
                                                          placeholder="Enter Billing Address"></textarea>

                                                <div class="field-placeholder">
                                                    Billing Address
                                                </div>

                                            </div>

                                        </div>

                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                                            <div class="field-wrapper">

                                                <div class="form-check form-check-inline"
                                                     style="margin-left:65%;">

                                                    <input class="form-check-input clear-field detail"
                                                           onclick="toggleShippingAddress()"
                                                           type="checkbox"
                                                           id="chcekAddress"
                                                           checked>

                                                    <label class="form-check-label"
                                                           for="chcekAddress">
                                                        Same as Billing Address
                                                    </label>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                                            <div class="field-wrapper">

                                                <textarea id="shippingAddress"
                                                          class="form-control clear-field"
                                                          rows="3"
                                                          placeholder="Enter Shipping Address"
                                                          disabled></textarea>

                                                <div class="field-placeholder">
                                                    Shipping Address
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <input id="edit-id" type="hidden" />
                <input id="catedit-id" type="hidden" />

                <div id="notess"></div>

                <div class="modal-footer"
                     id="divModalFooter">
                </div>

            </div>
        </div>
    </div>


    <!-- =========================================================
         MAIN FORM
    ========================================================== -->

    <div class="row gutters">

        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">

                <div class="card-body">

                    <div class="form-section-header">
                        Create Yarn Requirement Form
                    </div>

                    <br />

                    <!-- IMAGE -->
                    <div class="row gutters">

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">

                            <div id="dropzone-sm">

                                <input type="hidden"
                                       id="txtDesignColorMatchingFormID"
                                       class="form-control" />

                            </div>

                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12"></div>

                    </div>

                    <hr />

                    <!-- =====================================================
                         REQUIREMENT HEADER
                    ====================================================== -->

                    <div class="row gutters">

                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                            <div class="card">

                                <div class="card-body">

                                    <div class="row justify-content-between"
                                         style="border-bottom:1px solid #c3c3c3;margin-top:-20px;">

                                        <div id="notes"></div>

                                        <div class="col-xl-7 col-lg-7 col-md-7 col-sm-7 col-12">

                                            <div class="row gutters">

                                                <!-- DATE -->
                                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">

                                                    <div class="field-wrapper">

                                                        <div class="input-group">

                                                            <input type="text"
                                                                   id="InvoiceDate"
                                                                   class="form-control datepicker">

                                                        </div>

                                                        <div class="field-placeholder">
                                                            Requirement Date
                                                        </div>

                                                    </div>

                                                </div>

                                                <!-- REQUIREMENT NO -->
                                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">

                                                    <div class="field-wrapper">

                                                        <input type="text"
                                                               class="form-control"
                                                               id="RequirementNo"
                                                               value="0"
                                                               readonly>

                                                        <div class="field-placeholder">
                                                            Requirement No
                                                        </div>

                                                    </div>

                                                </div>

                                                <hr />

                                                <!-- PARTY -->
                                                <div class="col-9">

                                                    <div class="field-wrapper">

                                                        <select id="ddlParty"
                                                                class="select-single clear-field detail"
                                                                title="Select Party"
                                                                data-live-search="true"
                                                                onchange="functionParty(this.value)">
                                                        </select>

                                                        <div class="field-placeholder">
                                                            Select Party
                                                        </div>

                                                    </div>

                                                </div>

                                                <div class="col-3">

                                                    <button type="button"
                                                            class="btn btn-warning"
                                                            style="margin-top:8px;display:none;"
                                                            onclick="addparty()">
                                                        + ADD PARTY
                                                    </button>

                                                </div>

                                            </div>

                                        </div>

                                        <!-- PARTY DETAILS -->
                                        <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12"
                                             style="border-left:1px solid #c3c3c3;">

                                            <div class="row gutters"
                                                 id="DivLblPartyDetails"
                                                 style="display:none;">

                                                <div class="row">

                                                    <div class="col-12">

                                                        <div class="form-section-header light-bg"
                                                             id="divPartyName">
                                                            Party Detail
                                                        </div>

                                                    </div>

                                                    <br />
                                                    <hr />

                                                    <div class="col-xl-7 col-lg-7 col-md-7 col-sm-7 col-12">

                                                        <div class="field-wrapper">

                                                            <input type="hidden"
                                                                   id="hPartyId"
                                                                   class="form-control" />

                                                            <p id="PMobileNo">
                                                                Phone:
                                                                <span style="color:black;"></span>
                                                            </p>

                                                            <p id="PEmail">
                                                                Email:
                                                                <span style="color:black;"></span>
                                                            </p>

                                                            <p id="PBillingAddress">
                                                                Address:
                                                                <span style="color:black;"></span>
                                                            </p>

                                                        </div>

                                                    </div>

                                                    <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">

                                                        <div class="field-wrapper">

                                                            <br />

                                                            <p id="PState">
                                                                Place of Supply:
                                                                <span style="color:black;"></span>
                                                            </p>

                                                            <p id="PGSTIN">
                                                                GST:
                                                                <span style="color:black;"></span>
                                                            </p>

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                    <br />

                                    <!-- =====================================================
                                         YARN INPUT
                                    ====================================================== -->

                                    <div class="row gutters mb-3">

                                        <!-- MATERIAL -->
                                        <div class="col-xl-2 col-lg-3 col-md-6 col-sm-6 col-12">

                                            <div class="field-wrapper">

                                                <select id="yarnMaterial1"
                                                        class="form-control"
                                                        onchange="YarnMaterialChange(1)">

                                                    <option value="0">
                                                        Select Material
                                                    </option>

                                                </select>

                                                <div class="field-placeholder">
                                                    Material
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>

                                        </div>

                                        <!-- COLOR -->
                                        <div class="col-xl-2 col-lg-3 col-md-6 col-sm-6 col-12">

                                            <div class="field-wrapper">

                                                <select id="YarnColor1"
                                                        class="form-control"
                                                        onchange="YarnColorChange(1)">

                                                    <option value="0">
                                                        Select Color
                                                    </option>

                                                </select>

                                                <div class="field-placeholder">
                                                    Color
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>

                                        </div>

                                        <!-- =================================================
                                             COMPANY
                                             IMPORTANT:
                                             VALUE = CompanyID
                                             TEXT  = CompanyName
                                        ================================================== -->
                                        <div class="col-xl-2 col-lg-3 col-md-6 col-sm-6 col-12">

                                            <div class="field-wrapper">

                                                <select id="CompanyName1"
                                                        class="form-control"
                                                        title="Select Company"
                                                        onchange="YarnCompanyChange(1)" disabled>

                                                    <option value="0">
                                                        Select Company
                                                    </option>

                                                </select>

                                                <div class="field-placeholder">
                                                    Company
                                                    <span class="text-danger">*</span>
                                                </div>

                                            </div>

                                        </div>

