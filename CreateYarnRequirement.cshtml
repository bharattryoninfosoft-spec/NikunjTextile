       function deleteYarnData(rowNo) {

            Swal.fire({

                icon: "warning",

                title: "Delete Yarn Data?",

                text: "Are you sure you want to delete this row?",

                showCancelButton: true,

                confirmButtonText: "Yes, Delete",

                cancelButtonText: "Cancel"

            }).then(function (result) {

                if (!result.isConfirmed) {
                    return;
                }


                $("#trMatching" + rowNo)
                    .remove();


                var arr =
                    $("#txtYarnDetailsArray")
                        .val()
                        .split("|")
                        .filter(function (x) {

                            return (
                                x !== "" &&
                                x != rowNo
                            );

                        });


                $("#txtYarnDetailsArray")
                    .val(
                        arr.length > 0
                            ? arr.join("|") + "|"
                            : ""
                    );


                if (
                    editingYarnRowNo ==
                    rowNo
                ) {

                    editingYarnRowNo = 0;

                    resetYarnInput();

                }

            });

        }
       function resetYarnInput() {

            $("#yarnMaterial1")
                .val("0");


            $("#YarnColor1")
                .empty()
                .append(
                    $("<option>", {
                        value: "0",
                        text: "Select Yarn Color"
                    })
                );


            if (IsJobWork === 0) {

                BindAllYarnColors(1);

            }


            /*
             * Company reset
             */

            $("#CompanyName1")
                .empty()
                .append(
                    $("<option>", {
                        value: "0",
                        text: "Select Company"
                    })
                )
                .prop("disabled", true);


            $("#ColorCode1")
                .val("");


            $("#NoOfBox1")
                .val("");

        }
       function escapeHtml(value) {

            return String(
                value || ""
            )
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }
       function myFunctionPINCODE(abc) {

            if (!abc) {
                return;
            }


            var code =
                abc.value;


            if (code == "") {

                abc.classList.remove(
                    "is-valid"
                );

                abc.classList.add(
                    "is-invalid"
                );

                return;

            }


            if (code.length == 6) {

                var ifscurl =
                    "https://api.postalpincode.in/pincode/"
                    + code;


                $.ajax({

                    type: "GET",

                    url: ifscurl,

                    contentType: false,

                    processData: false,

                    success: function (response) {

                        if (
                            response &&
                            response.length != 0 &&
                            response[0].PostOffice &&
                            response[0].PostOffice.length > 0
                        ) {

                            $("#city").val(
                                response[0]
                                    .PostOffice[0]
                                    .District
                            );


                            abc.classList.add(
                                "is-valid"
                            );

                            abc.classList.remove(
                                "is-invalid"
                            );

                        }
                        else {

                            abc.classList.remove(
                                "is-valid"
                            );

                            abc.classList.add(
                                "is-invalid"
                            );

                            $("#city").val("");

                        }

                    },

                    error: function () {

                        abc.classList.remove(
                            "is-valid"
                        );

                        abc.classList.add(
                            "is-invalid"
                        );

                        $("#city").val("");

                    }

                });

            }
            else {

                abc.classList.remove(
                    "is-valid"
                );

                abc.classList.add(
                    "is-invalid"
                );

            }

        }
       function myFunctionIFSC(abc) {

            if (!abc) {
                return;
            }


            var code =
                abc.value;


            if (code == "") {

                abc.classList.remove(
                    "is-valid"
                );

                abc.classList.add(
                    "is-invalid"
                );

                return;

            }


            if (code.length == 11) {

                var ifscurl =
                    "https://ifsc.razorpay.com/"
                    + code;


                $.ajax({

                    type: "GET",

                    url: ifscurl,

                    contentType: false,

                    processData: false,

                    success: function (response) {

                        if (response) {

                            $("#BankName")
                                .val(
                                    response.BANK || ""
                                );

                            $("#BankBranch")
                                .val(
                                    response.BRANCH || ""
                                );


                            abc.classList.add(
                                "is-valid"
                            );

                            abc.classList.remove(
                                "is-invalid"
                            );

                        }
                        else {

                            abc.classList.remove(
                                "is-valid"
                            );

                            abc.classList.add(
                                "is-invalid"
                            );

                            $("#BankName").val("");
                            $("#BankBranch").val("");

                        }

                    },

                    error: function () {

                        abc.classList.remove(
                            "is-valid"
                        );

                        abc.classList.add(
                            "is-invalid"
                        );

                        $("#BankName").val("");
                        $("#BankBranch").val("");

                    }

                });

            }
            else {

                abc.classList.remove(
                    "is-valid"
                );

                abc.classList.add(
                    "is-invalid"
                );

                $("#BankName").val("");
                $("#BankBranch").val("");

            }

        }

    </script>

