        }
        function checkSave() {

            if (isSubmitting) {
                return false;
            }


            isSubmitting = true;

            toggleSaveLoader(true);


            try {

                var InvoiceDate =
                    document.getElementById(
                        "InvoiceDate"
                    );


                var RequirementNo =
                    document.getElementById(
                        "RequirementNo"
                    );


                var PartyId =
                    document.getElementById(
                        "ddlParty"
                    );


                /* DATE */

                if (
                    !InvoiceDate ||
                    !InvoiceDate.value
                ) {

                    Swal.fire({
                        icon: "warning",
                        title: "Requirement Date Required",
                        text: "Please select Requirement Date."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                /* REQUIREMENT NO */

                if (
                    !RequirementNo ||
                    !RequirementNo.value ||
                    RequirementNo.value === "0"
                ) {

                    Swal.fire({
                        icon: "warning",
                        title: "Requirement No Required",
                        text: "Requirement No is required."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                /* PARTY */

                if (
                    !PartyId ||
                    !PartyId.value ||
                    PartyId.value === "0" ||
                    PartyId.value === "-1"
                ) {

                    Swal.fire({
                        icon: "warning",
                        title: "Party Required",
                        text: "Please select Party."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                /* =====================================================
                   GET ROW NUMBERS
                ====================================================== */

                var txtYarnArray =
                    $("#txtYarnDetailsArray").val() || "";


                var rowNumbers =
                    txtYarnArray
                        .split("|")
                        .filter(function (x) {

                            return x &&
                                x.trim() !== "";

                        });


                if (rowNumbers.length === 0) {

                    Swal.fire({
                        icon: "warning",
                        title: "No Rows Added",
                        text: "Please add at least one yarn detail row."
                    });

                    isSubmitting = false;

                    toggleSaveLoader(false);

                    return false;
                }


                var detailArray = [];


                /* =====================================================
                   READ EACH ROW
                ====================================================== */

                for (
                    var j = 0;
                    j < rowNumbers.length;
                    j++
                ) {

                    var rowNum =
                        rowNumbers[j].trim();


                    var materialElement =
                        document.getElementById(
                            "yarnMaterialDetail" +
                            rowNum
                        );


                    var colorElement =
                        document.getElementById(
                            "YarnColorDetail" +
                            rowNum
                        );


                    /*
                     * IMPORTANT:
                     * CompanyNameDetail nahi.
                     * CompanyIDDetail use karvu.
                     */

                    var companyElement =
                        document.getElementById(
                            "CompanyIDDetail" +
                            rowNum
                        );


                    var colorCodeElement =
                        document.getElementById(
                            "ColorCodeDetail" +
                            rowNum
                        );


                    var boxElement =
                        document.getElementById(
                            "NoOfBoxDetail" +
                            rowNum
                        );


                    /* MATERIAL */

                    if (!materialElement) {

                        Swal.fire({
                            icon: "warning",
                            title: "Material Required",
                            text:
                                "Material data is missing in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    var YMVal =
                        String(
                            materialElement.value || ""
                        ).trim();


                    if (
                        !YMVal ||
                        YMVal === "0" ||
                        YMVal === "-1"
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Material Required",
                            text:
                                "Please select Material in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* COLOR */

                    if (!colorElement) {

                        Swal.fire({
                            icon: "warning",
                            title: "Color Required",
                            text:
                                "Color data is missing in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    var YCVal =
                        String(
                            colorElement.value || ""
                        ).trim();


                    if (
                        !YCVal ||
                        YCVal === "0" ||
                        YCVal === "-1"
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Color Required",
                            text:
                                "Please select Color in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* =================================================
                       COMPANY ID
                    ================================================== */

                    var CompanyIDVal =
                        companyElement
                            ? String(
                                companyElement.value || "0"
                            ).trim()
                            : "0";


                    /* =================================================
                       COLOR CODE
                    ================================================== */

                    var CCVal =
                        colorCodeElement
                            ? String(
                                colorCodeElement.value || ""
                            ).trim()
                            : "";


                    /* =================================================
                       BOXES
                    ================================================== */

                    var NOBVal =
                        boxElement
                            ? String(
                                boxElement.value || ""
                            ).trim()
                            : "";


                    var NoofBoxes =
                        parseInt(
                            NOBVal,
                            10
                        );


                    if (
                        !NOBVal ||
                        isNaN(NoofBoxes) ||
                        NoofBoxes <= 0
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Boxes Required",
                            text:
                                "Please enter valid No Of Boxes in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* =================================================
                       COMPANY VALIDATION ONLY JOB WORK
                    ================================================== */

                    if (
                        parseInt(IsJobWork, 10) === 1 &&
                        (
                            !CompanyIDVal ||
                            CompanyIDVal === "0"
                        )
                    ) {

                        Swal.fire({
                            icon: "warning",
                            title: "Company Required",
                            text:
                                "Please select Company in row "
                                + rowNum + "."
                        });

                        isSubmitting = false;

                        toggleSaveLoader(false);

                        return false;
                    }


                    /* =================================================
                       FINAL DETAIL OBJECT

                       OLD:
                       CompanyName: CompanyID

                       NEW:
                       CompanyID: CompanyIDVal
                    ================================================== */

                    detailArray.push({

                        YarnMaterialID:
                            parseInt(
                                YMVal,
                                10
                            ),

                        YarnColorID:
                            parseInt(
                                YCVal,
                                10
                            ),

                        CompanyName:
                            parseInt(
                                CompanyIDVal,
                                10
                            ) || 0,

                        CompanyColourCode:
                            CCVal,

                        NoofBoxes:
                            NoofBoxes

                    });

                }


                /* =====================================================
                   MASTER OBJECT
                ====================================================== */

                var YarnRequirementObject = {

                    RequirementDates:
                        InvoiceDate.value,

                    RequirementNo:
                        RequirementNo.value,

                    PartyId:
                        parseInt(
                            PartyId.value,
                            10
                        ),

                    listYarnRequirementDetail:
                        detailArray

                };


                var YarnRequirementArray =
                    JSON.stringify(
                        YarnRequirementObject
                    );


                console.log(
                    "YarnRequirementArray:",
                    YarnRequirementArray
                );


                var formData =
                    new FormData();


                formData.append(
                    "YarnRequirementArray",
                    YarnRequirementArray
                );


                /* =====================================================
                   SAVE API
                ====================================================== */

                $.ajax({

                    type: "POST",

                    url:
                        "/WebServiceNikunjTextile.asmx/insertYarnRequirementMasterMaster",

                    data: formData,

                    dataType: "json",

                    contentType: false,

                    processData: false,

                    success: function (response) {

                        if (response.Code == 200) {

                            Swal.fire({

                                icon: "success",

                                title: "Success",

                                text:
                                    "Yarn Requirement Created Successfully.",

                                confirmButtonText: "OK",

                                allowOutsideClick: false

                            }).then(function () {

                                window.location.href =
                                    "YarnRequirement";

                            });

                        }
                        else {

                            Swal.fire({

                                icon: "error",

                                title: "Error",

                                text:
                                    response.Message ||
                                    "Unable to save Yarn Requirement."

                            });


                            isSubmitting = false;

                            toggleSaveLoader(false);

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "insertYarnRequirementMasterMaster Error:",
                            xhr.responseText
                        );


                        Swal.fire({

                            icon: "error",

                            title: "Server Error",

                            text:
                                "Problem occurred while submitting your data."

                        });


                        isSubmitting = false;

                        toggleSaveLoader(false);

                    }

                });

            }
            catch (error) {

                console.error(
                    "checkSave Error:",
                    error
                );


                Swal.fire({

                    icon: "error",

                    title: "Error",

                    text:
                        error.message ||
                        "Something went wrong."

                });


                isSubmitting = false;

                toggleSaveLoader(false);

                return false;

            }


            return true;

        }
