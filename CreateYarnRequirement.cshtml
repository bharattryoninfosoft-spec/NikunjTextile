       function escapeHtml(value) {

            return String(
                value || ""
            )
                .replace(
                    /&/g,
                    "&amp;"
                )
                .replace(
                    /</g,
                    "&lt;"
                )
                .replace(
                    />/g,
                    "&gt;"
                )
                .replace(
                    /"/g,
                    "&quot;"
                )
                .replace(
                    /'/g,
                    "&#039;"
                );

        }
       function myFunctionPINCODE(abc) {

            if (!abc) {
                return;
            }


            var code =
                abc.value;


            if (code == "") {

                abc.classList.remove(
                    "is-valid"
                );

                abc.classList.add(
                    "is-invalid"
                );

                return;

            }


            if (code.length == 6) {

                var ifscurl =
                    "https://api.postalpincode.in/pincode/"
                    + code;


                $.ajax({

                    type: "GET",

                    url: ifscurl,

                    contentType: false,

                    processData: false,

                    success: function (response) {

                        if (
                            response &&
                            response.length != 0 &&
                            response[0].PostOffice &&
                            response[0].PostOffice.length > 0
                        ) {

                            $("#city").val(
                                response[0]
                                    .PostOffice[0]
                                    .District
                            );


                            abc.classList.add(
                                "is-valid"
                            );

                            abc.classList.remove(
                                "is-invalid"
                            );

                        }
                        else {

                            abc.classList.remove(
                                "is-valid"
                            );

                            abc.classList.add(
                                "is-invalid"
                            );

                            $("#city").val("");

                        }

                    },

                    error: function () {

                        abc.classList.remove(
                            "is-valid"
                        );

                        abc.classList.add(
                            "is-invalid"
                        );

                        $("#city").val("");

                    }

                });

            }
            else {

                abc.classList.remove(
                    "is-valid"
                );

                abc.classList.add(
                    "is-invalid"
                );

            }

        }
