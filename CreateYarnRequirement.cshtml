        function validate(code) {

            if (!code) {
                return true;
            }


            code.value =
                String(code.value || "")
                    .replace(/\s+/g, ' ')
                    .trim();


            if (
                code.value === "" ||
                code.value === "0" ||
                code.value === "-1"
            ) {

                document
                    .getElementById(code.id)
                    .classList
                    .remove("is-valid");

                document
                    .getElementById(code.id)
                    .classList
                    .add("is-invalid");

                return false;

            }
            else {

                document
                    .getElementById(code.id)
                    .classList
                    .add("is-valid");

                document
                    .getElementById(code.id)
                    .classList
                    .remove("is-invalid");

                return true;

            }

        }
        function toggleSaveLoader(show) {

