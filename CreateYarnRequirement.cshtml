        function editYarnData(rowNo) {

            var row =
                $("#trMatching" + rowNo);


            if (!row.length) {
                return false;
            }


            var materialId =
                $("#yarnMaterialDetail" + rowNo)
                    .val();


            var colorId =
                $("#YarnColorDetail" + rowNo)
                    .val();


            /*
             * IMPORTANT:
             * Read CompanyID, not CompanyName.
             */

            var companyId =
                $("#CompanyIDDetail" + rowNo)
                    .val() || "0";


            var codeValue =
                $("#ColorCodeDetail" + rowNo)
                    .val() || "";


            var boxValue =
                $("#NoOfBoxDetail" + rowNo)
                    .val() || "";


            /* MATERIAL */

            $("#yarnMaterial1")
                .val(
                    String(materialId)
                );


            /* COLOR */

            BindYarnColorsByMaterial(
                1,
                materialId,
                colorId
            );


            $("#YarnColor1")
                .val(
                    String(colorId)
                );

            YarnColorChange(1);

            /* =====================================================
               COMPANY

               Company dropdown populated by YarnColorChange:
               value = CompanyID
               text = Company Name
            ====================================================== */

            if (companyId > 0) {
                $("#CompanyName1")
                    .val(
                        String(companyId)
                    );
                $("#CompanyID1")
                    .val(
                        String(companyId)
                    );
            }

            $("#ColorCode1")
                .val(codeValue);


            $("#NoOfBox1")
                .val(boxValue);


            editingYarnRowNo =
                parseInt(
                    rowNo,
                    10
                );


            $("#btnAddYarn")
                .removeClass("btn-secondary")
                .addClass("btn-success")
                .html(
                    '<i class="fa fa-save"></i> UPDATE YARN DATA'
                );


            return true;

        }
