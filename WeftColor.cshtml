@{
    Layout = "/_LayoutPage1.cshtml";
}




<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <button id="AddFinacialYearModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Weft Color</button>
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Weft Color</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />

                        <div class="row gutters">
                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">
                                    <div class="col-6">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input type="text" id="WeftColor" name="WeftColor" class="form-control clear-field" onfocusout="validate(this)">
                                            <div class="field-placeholder">Weft Color<sup style="color:red;">*</sup></div>
                                            <div class="WeftColor-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="WeftColor-invalid-feedback invalid-feedback">Please Mention Weft Color</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>



                                    <div class="col-6">

                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <div class="form-check form-check-inline">
                                                <br />
                                                <input id="IsActive" class="form-check-input" type="checkbox" value="1" checked>
                                                <label class="form-check-label" for="IsActive-default">Is Active</label>

                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>




                                </div>
                            </div>
                        </div>
                    </div>
                    <input id="edit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">
                        <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Weft Color</div>
                    <br />

                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr>
                                    <th>Sr No</th>
                                    <th>Weft Color</th>
                                    <th>Is Active</th>
                                    <!--<th>Position</th>-->
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>
<!-- Content wrapper end -->

@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('.active, .show, .current-page').removeClass('active show current-page');

            $("#master-tab").addClass("active");
            $("#tab-Master").addClass("show active");
            $("#aWeftColor").addClass("current-page");

            FunctionIsLogin();
            displayData(0);
        });

        // Configure SweetAlert2 Toast helper for non-blocking notifications
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: request.statusText || 'Failed to fetch default company.'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    console.log(data);
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            }
            else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getWeftColorMaster?startFrom=' + rowStart,
                data: "{ 'startFrom':'" + rowStart + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    console.log(response);

                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").empty();
                    }
                    var dataTable = $('#copy-print-csv');
                    var temp = "";
                    if (response.listWeftColorMaster.length < 10) {
                        $("#view-more-btn").hide();
                    }
                    else {
                        $("#view-more-btn").show();
                    }

                    var SrNo = 1;
                    for (var i = 0; i < response.listWeftColorMaster.length; i++) {
                        var Top = i - 1;
                        var Previous = i + 1;

                        var ActionPosition = "";
                        if (response.listWeftColorMaster.length != 1) {
                            if (i == 0) {
                                var PostDown = response.listWeftColorMaster[i].WeftColorID + "," + response.listWeftColorMaster[i].Position + "|" + response.listWeftColorMaster[Previous].WeftColorID + "," + response.listWeftColorMaster[Previous].Position;
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listWeftColorMaster[i].WeftColorID + "' value = '" + PostDown + "' /> ";
                                ActionPosition += "<span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listWeftColorMaster[i].WeftColorID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }
                            else if (i == parseInt(response.listWeftColorMaster.length - 1)) {
                                var PostUp = response.listWeftColorMaster[i].WeftColorID + "," + response.listWeftColorMaster[i].Position + "|" + response.listWeftColorMaster[Top].WeftColorID + "," + response.listWeftColorMaster[Top].Position;
                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listWeftColorMaster[i].WeftColorID + "' value = '" + PostUp + "' /> </span>";
                                ActionPosition += "<span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listWeftColorMaster[i].WeftColorID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'></td>";
                            }
                            else {
                                var PostUp = response.listWeftColorMaster[i].WeftColorID + "," + response.listWeftColorMaster[i].Position + "|" + response.listWeftColorMaster[Top].WeftColorID + "," + response.listWeftColorMaster[Top].Position;
                                var PostDown = response.listWeftColorMaster[i].WeftColorID + "," + response.listWeftColorMaster[i].Position + "|" + response.listWeftColorMaster[Previous].WeftColorID + "," + response.listWeftColorMaster[Previous].Position;
                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listWeftColorMaster[i].WeftColorID + "' value = '" + PostUp + "' /><span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listWeftColorMaster[i].WeftColorID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span>";
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listWeftColorMaster[i].WeftColorID + "' value = '" + PostDown + "' /><span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listWeftColorMaster[i].WeftColorID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }
                        }

                        temp += "<tr>";
                        temp += "<td>" + SrNo++ + "</td>";
                        temp += "<td>" + response.listWeftColorMaster[i].WeftColor + "</td>";

                        if (response.listWeftColorMaster[i].IsActive == "1") {
                            temp += "<td><span class='badge bg-success'>Active</span></td>";
                        }
                        else {
                            temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                        }

                        temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listWeftColorMaster[i].WeftColorID + ")'><i class='icon-edit1 text-info'></i></a> &nbsp;&nbsp; <a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listWeftColorMaster[i].WeftColorID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                        temp += "</tr>";
                    }

                    dataTable.append(temp);
                },
                error: function (request, status, error) {
                }
            });
        }

        // Delete Weft Color (replaced confirm and notes with SweetAlert2)
        function functionFYDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this record!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                displayData(0);
                                Toast.fire({
                                    icon: 'success',
                                    title: 'Financial Year deleted successfully.'
                                });
                            }
                            else {
                                Toast.fire({
                                    icon: 'error',
                                    title: 'Problem has been occurred while deleting Financial Year.'
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'Problem has been occurred while deleting Financial Year.'
                            });
                        }
                    });
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Weft Color");
            $("#add-alert").hide();

            $("#WeftColor").val('');

            $(".company-invalid-feedback").hide();

            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function checkSaveView() {
            var IsActive = "0";
            if ($("#IsActive").is(':checked')) {
                IsActive = "1";
            }

            var WeftColor = $('#WeftColor').val();

            if (validate(document.getElementById('WeftColor')) == false) {
                validate(document.getElementById('WeftColor'));
            }
            else {
                var formData = new FormData();
                formData.append('WeftColor', WeftColor);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertWeftColorMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            Toast.fire({
                                icon: 'success',
                                title: response.Message
                            });
                            displayData(0);
                            $("#cancelbtn").click();
                        }
                        else {
                            Toast.fire({
                                icon: 'error',
                                title: response.Message
                            });
                        }
                    },
                    error: function (error) {
                        Toast.fire({
                            icon: 'error',
                            title: 'An error occurred while saving.'
                        });
                    }
                });
            }
        }

        function checkSave() {
            var IsActive = "0";
            if ($("#IsActive").is(':checked')) {
                IsActive = "1";
            }

            var WeftColor = $('#WeftColor').val();

            if (validate(document.getElementById('WeftColor')) == false) {
                validate(document.getElementById('WeftColor'));
            }
            else {
                var formData = new FormData();
                formData.append('WeftColor', WeftColor);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/insertWeftColorMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            Toast.fire({
                                icon: 'success',
                                title: response.Message
                            });
                            displayData(0);
                        }
                        else {
                            Toast.fire({
                                icon: 'error',
                                title: response.Message
                            });
                        }
                    },
                    error: function (error) {
                        Toast.fire({
                            icon: 'error',
                            title: 'An error occurred while saving.'
                        });
                    }
                });
            }
        }

        function checkEdit() {
            var id = $("#edit-id").val();
            var IsActive = "0";
            if ($("#IsActive").is(':checked')) {
                IsActive = "1";
            }

            var WeftColor = $('#WeftColor').val();

            if (validate(document.getElementById('WeftColor')) == false) {
                validate(document.getElementById('WeftColor'));
            }
            else {
                var formData = new FormData();
                formData.append('WeftColorID', id);
                formData.append('WeftColor', WeftColor);
                formData.append('IsActive', IsActive);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/EditWeftColorMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 201) {
                            clearAll();
                            $('#WeftColor').val('');
                            Toast.fire({
                                icon: 'success',
                                title: response.Message
                            });
                            displayData(0);
                            $("#cancelbtn").click();
                        }
                        else {
                            Toast.fire({
                                icon: 'error',
                                title: response.Message
                            });
                        }
                    },
                    error: function (error) {
                        Toast.fire({
                            icon: 'error',
                            title: 'An error occurred while editing.'
                        });
                    }
                });
            }
        }

        function showRecords(id) {
            clearAll();
            $("#edit-id").val(id);
            $("#saveViewbtn").hide();
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Edit Weft Color");
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getWeftColorMasterById?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#WeftColor").val(response.listWeftColorMaster[0].WeftColor);

                        if (response.listWeftColorMaster[0].IsActive == "1") {
                            $("#IsActive").prop('checked', true);
                        }
                        else {
                            $("#IsActive").prop('checked', false);
                        }
                    }
                    else {
                        Toast.fire({
                            icon: 'error',
                            title: response.Message
                        });
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Failed to retrieve record details.'
                    });
                }
            });
        }

        function functionYarnDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this Weft Color!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('WeftColorID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteWeftColorMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {
                                Toast.fire({
                                    icon: 'success',
                                    title: 'Weft Color deleted successfully.'
                                });
                                displayData(0);
                            }
                            else {
                                Toast.fire({
                                    icon: 'error',
                                    title: 'Problem has been occurred while deleting Weft Color.'
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'Problem has been occurred while deleting Weft Color.'
                            });
                        }
                    });
                }
            });
        }

        function onPostUp(QueueNo) {
            var down = $("#PostUp_" + QueueNo + "").val();
            var formData = new FormData();
            formData.append('PostQueue', down);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateTbl_WeftColorQueue',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 1) {
                        displayData($("#rowStartCount").val());
                    }
                    else {
                        Toast.fire({
                            icon: 'error',
                            title: 'Problem has been occurred while retrieving your data.'
                        });
                    }
                },
                error: function (error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Problem has been occurred while retrieving your data.'
                    });
                }
            });
        }

        function onPostDown(QueueNo) {
            var down = $("#PostDown_" + QueueNo + "").val();
            var formData = new FormData();
            formData.append('PostQueue', down);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateTbl_WeftColorQueue',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 1) {
                        displayData($("#rowStartCount").val());
                    }
                    else {
                        Toast.fire({
                            icon: 'error',
                            title: 'Problem has been occurred while retrieving your data.'
                        });
                    }
                },
                error: function (error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Problem has been occurred while retrieving your data.'
                    });
                }
            });
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "") {
                if (code.id == "name") {
                    $(".company-invalid-feedback").show();
                }
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else if ((code.id == "igst" || code.id == "gst" || code.id == "cess") && code.value[code.value.length - 1] == ".") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }
    </script>
}

