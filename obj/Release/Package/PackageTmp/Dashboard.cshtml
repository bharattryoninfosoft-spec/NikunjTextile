    function longfunctionfirst(callback) {
        setTimeout(function () {
            if (typeof callback == 'function')
                callback();
        }, 10);
    };






    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }



    var selectedState = "";

    function getDefaultCompany() {
        //alert("secound");
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);
                if (response.Code == 200 || response.Code == "200") {
                    if (response.listCompanyMaster.length != 0) {
                        $("#edit-id-default").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-name-default").val(response.listCompanyMaster[0].CompanyName);
                        $('#email-default').val(response.listCompanyMaster[0].Email);
                        $('#phone-default').val(response.listCompanyMaster[0].MobileNo);
                        $('#alt-phone-default').val(response.listCompanyMaster[0].AlterMobileNo);
                        //selectedState = response.listCompanyMaster[0].State;
                        //$('#state-default').val(response.listCompanyMaster[0].State);
                        //$('#state-default').val('24-Gujarat');
                        //$('#state-default [value=24-Gujarat]').attr('selected', 'true');

                        //$('#business-type-default').val(response.listCompanyMaster[0].BusinessType);
                        //$('#business-cate-default').val(response.listCompanyMaster[0].BusinessCategory);

                        longfunctionfirst(getStates(response.listCompanyMaster[0].State));
                        longfunctionfirst(getBusinessTypes(response.listCompanyMaster[0].BusinessType));
                        longfunctionfirst(getBusinessCat(response.listCompanyMaster[0].BusinessCategory));



                        $('#address-default').val(response.listCompanyMaster[0].BusinessAddress);
                        $('#description-default').val(response.listCompanyMaster[0].BusinessDescription);
                        $('#bank-name-default').val(response.listCompanyMaster[0].BankName);
                        $('#ifsc-default').val(response.listCompanyMaster[0].IFSC);
                        $('#acNumber-default').val(response.listCompanyMaster[0].ACNo);
                        $('#BarcodeTitle').val(response.listCompanyMaster[0].BarcodeTitle);
                        $('#SetCreditPercentage').val(response.listCompanyMaster[0].SetCreditPercentage);
                        $('#SupportNumber').val(response.listCompanyMaster[0].SupportNumber);

                        if (response.listCompanyMaster[0].GSTIN == "" || response.listCompanyMaster[0].GSTIN == null) {
                            $("#gstStat-default").prop('checked', false);
                            $('#gst-default').val("");
                            $('.gst-clear-default').hide();
                        }
                        else {
                            $("#gstStat-default").prop('checked', true);
                            $('#gst-default').val(response.listCompanyMaster[0].GSTIN);
                            $('.gst-clear-default').show();
                        }

                        $("#setDefault-default").prop('checked', true);
                        $("#setDefault-default").attr('disabled', true);
                        $("#upload-image-temp-default").val(response.listCompanyMaster[0].CompanyLogo);
                        var imgStr = "<img src='" + response.listCompanyMaster[0].CompanyLogo + "' style='height:200px;width:200px;margin-top:-54px;'>";
                        $("#upload-image-default-preview").html(imgStr);
                        $("#upload-image-default-preview").css('color', 'initial');

                        $("#upload-sign-temp-default").val(response.listCompanyMaster[0].Sign);
                        imgStr = "<img src='" + response.listCompanyMaster[0].Sign + "' style='height:200px;width:200px;margin-top:-54px;'>";
                        $("#upload-sign-default-preview").html(imgStr);
                        $("#upload-sign-default-preview").css('color', 'initial');
                    }
                }
                else {
                    $("#add-alert-default").removeClass("alert-success");
                    $("#add-alert-default").addClass("alert-danger");
                    $("#add-alert-default").html(response.Message);
                    $("#add-alert-default").show();
                }

            },
            error: function (request, status, error) {
                $("#add-alert").removeClass("alert-success");
                $("#add-alert").addClass("alert-danger");
                $("#add-alert").html(response.Message);
                $("#add-alert").show();
            }
        });
    }



    function getBusinessTypes(BusinsType) {

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getBusinessTypes',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                var jsonData = JSON.parse(data.d);
                $("#business-type option[value]").each(function () {
                    $(this).remove();
                });
                $("#business-type-default option[value]").each(function () {
                    $(this).remove();
                });
                $('#business-type').append("<option value='-1'> -- Select -- </option>");
                $('#business-type-default').append("<option value='-1'> -- Select -- </option>");
                for (var i = 0; i < jsonData.length; i++) {
                    admin = jsonData[i];

                    if (BusinsType == admin.BusinessTypeID) {
                        appendTemp = "<option value=" + admin.BusinessTypeID + " selected>" + admin.BusinessTypeTitle + "</option >";
                    }
                    else {
                        appendTemp = "<option value=" + admin.BusinessTypeID + ">" + admin.BusinessTypeTitle + "</option >";
                    }


                    $('#business-type').append(appendTemp);
                    $('#business-type-default').append(appendTemp);
                }
            },
            error: function (request, status, error) {
            }
        });
    }


