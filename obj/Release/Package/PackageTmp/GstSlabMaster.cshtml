
@{
    Layout = "/_LayoutPage1.cshtml";
}


<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <button id="AddGstModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Gst Slab</button>
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Gst Slab</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />

                        <div class="row gutters">
                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">
                                    <div class="col-4">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="name" type="text" class="form-control clear-field" onfocusout="validate(this)" onkeypress="return ((event.charCode >= 65 && event.charCode <= 90) || (event.charCode >= 97 && event.charCode <= 122) || (event.charCode >= 48 && event.charCode <= 57) || event.charCode == 32 || event.charCode == 37)">
                                            <div class="field-placeholder">Gst Slab Name <sup style="color:red;">*</sup></div>
                                            <div class="name-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="name-invalid-feedback invalid-feedback">Please Provide Slab Name</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper" style="margin-top: 0rem;">
                                            <input id="gst" type="tell" class="form-control clear-field" onfocusout="validate(this)" onkeypress="return validateFloatKeyPress(this,event);" maxlength="5">
                                            <div class="field-placeholder">SGST / CGST <sup style="color:red;">*</sup></div>
                                            <div class="gst-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="gst-invalid-feedback invalid-feedback">Please Provide GST</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-8">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input id="company" type="text" class="form-control clear-field" disabled>
                                            <input type="hidden" id="company-id" value="" />
                                            <div class="field-placeholder">Company Name</div>
                                            <div class="company-invalid-feedback invalid-feedback">&nbsp;</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                        @*<div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">*@
                                        <div class="row gutters">
                                            <div class="col-6">
                                                <!-- Field wrapper start -->
                                                <div class="field-wrapper" style="margin-top: 0rem;">
                                                    <input id="igst" type="tell" class="form-control clear-field" onfocusout="validate(this)" onkeypress="return validateFloatKeyPress(this,event);" maxlength="5">
                                                    <div class="field-placeholder">IGST <sup style="color:red;">*</sup></div>
                                                    <div class="igst-valid-feedback valid-feedback">Looks good!</div>
                                                    <div class="igst-invalid-feedback invalid-feedback">Please Provide IGST</div>
                                                </div>
                                                <!-- Field wrapper end -->
                                            </div>

                                            <div class="col-6" style="display:none;">
                                                <!-- Field wrapper start -->
                                                <div class="field-wrapper" style="margin-top: 0rem;">
                                                    <input id="cess" type="tell" value="0" class="form-control clear-field" @*onkeyup="validateAmount(this)"*@ onkeypress="return validateFloatKeyPress(this,event);" maxlength="5">
                                                    <div class="field-placeholder">CESS</div>
                                                    <div class="cess-valid-feedback valid-feedback">Looks good!</div>
                                                    <div class="cess-invalid-feedback invalid-feedback">Please Provide CESS</div>
                                                </div>
                                                <!-- Field wrapper end -->
                                            </div>
                                        </div>
                                        @*</div>*@

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <input id="edit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">

                        <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">GST Tax Slab</div>
                    <br />

                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr>
                                    <th>Gst Slab Name</th>
                                    @*<th>Company</th>*@
                                    <th>SGST</th>
                                    <th>CGST</th>
                                    <th>IGST</th>
                                    @*<th>CESS</th>*@
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>


