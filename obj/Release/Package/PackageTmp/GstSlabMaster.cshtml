<script>


    $(document).ready(function () {

        $('.active, .show, .current-page').removeClass('active show current-page');

        $("#forms-tab").addClass("active");
        $("#tab-forms").addClass("show active");
        $("#aGstSlabMaster").addClass("current-page");


        FunctionIsLogin();
        displayData(0);

        //getDefaultCompany();


        // Shortcut Key
        $(document).keydown(function (key) {
            switch (parseInt(key.which, 10)) {
                case 27:
                    //Esc Key
                    $("#cancelbtn").click();
                    break;
                case 18 && 79:
                    // Alt + O
                    $("#AddGstModel").click();
                    break;
                default:
                    //alert(key.which);
                    break;
            }
        });





    });



    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });


    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });


    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    $("#company").val(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(response.Message, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }


    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }







    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getGstSlab?startFrom=' + rowStart,
            data: "{ 'startFrom':'" + rowStart + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listGstSlabMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
                    $("#view-more-btn").show();
                }
                for (var i = 0; i < response.listGstSlabMaster.length; i++) {
                    //temp += "<tr><td>" + response.listGstSlabMaster[i].GSTSLABName + "</td><td>" + response.listGstSlabMaster[i].GST + "%</td><td>" + response.listGstSlabMaster[i].GST + "%</td><td>" + response.listGstSlabMaster[i].IGST + "%</td><td>" + response.listGstSlabMaster[i].CESS + "%</td><td>" + response.listGstSlabMaster[i].dates + "</td>";
                    temp += "<tr><td>" + response.listGstSlabMaster[i].GSTSLABName + "</td><td>" + response.listGstSlabMaster[i].GST + "%</td><td>" + response.listGstSlabMaster[i].GST + "%</td><td>" + response.listGstSlabMaster[i].IGST + "%</td><td>" + response.listGstSlabMaster[i].dates + "</td>";
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listGstSlabMaster[i].GSTSLABId + ")'><i class='icon-edit1 text-info'></i></a> &nbsp;&nbsp; <a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listGstSlabMaster[i].GSTSLABId + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "</tr>";

                }

                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }



    function showRecords(id) {
        clearAll();
        $("#edit-id").val(id);
        $("#saveViewbtn").hide();
        $("#savebtn").hide();
        $("#editbtn").show();
        $("#addNewContactLabel").html("Edit Gst Slab");
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getGstSlabById?id=' + id,
            data: "{ 'id':'" + id + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#name").val(response.listGstSlabMaster[0].GSTSLABName);
                    $('#igst').val(response.listGstSlabMaster[0].IGST);
                    $('#cess').val(response.listGstSlabMaster[0].CESS);
                    $('#gst').val(response.listGstSlabMaster[0].GST);
                    $('#company').val(response.listGstSlabMaster[0].CompanyName);
                    $('#company-id').val(response.listGstSlabMaster[0].CompanyId);
                }
                else {
                    //$("#add-alert").removeClass("alert-success");
                    //$("#add-alert").addClass("alert-danger");
                    //$("#add-alert").html(response.Message);
                    //$("#add-alert").show();


                    notess.show(response.Message, {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });

                }

            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();


                notess.show(response.Message, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });

            }
        });

    }



    function clearAll() {
        getDefaultCompany();
        $("#saveViewbtn").show();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add GST Slab");
        $("#add-alert").hide();
        $("#name").val('');
        $(".company-invalid-feedback").hide();
        $('#igst').val('');
        $('#cess').val('');
        $('#gst').val('');
        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }

    function checkSaveView() {
        var name = document.getElementById('name');
        var gst = document.getElementById('gst');
        var igst = document.getElementById('igst');
        var cess = document.getElementById('cess');
        var companyId = document.getElementById('company-id');



        if (validate(name) == false || validate(companyId) == false || validate(igst) == false || validate(gst) == false) {
            validate(name);
            //validate(companyId);
            validate(igst);
            validate(cess);
            validate(gst);
        }
        else {

            var CessValue = 0;
            if (cess.value != "") {
                CessValue = cess.value;
            }

            var formData = new FormData();
            formData.append('GSTSLABName', name.value);
            formData.append('GST', gst.value);
            formData.append('IGST', igst.value);
            formData.append('CESS', CessValue);
            formData.append('CompanyIds', companyId.value);


            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertGstSlabMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 201) {
                        clearAll();

                        //$("#add-alert").addClass("alert-success");
                        //$("#add-alert").removeClass("alert-danger");
                        //$("#add-alert").html(response.Message);
                        //$("#add-alert").show();

                        notes.show(response.Message, {
                            type: 'success',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });
                        displayData(0);
                        $("#cancelbtn").click();
                    }
                    else {
                        //$("#add-alert").removeClass("alert-success");
                        //$("#add-alert").addClass("alert-danger");
                        //$("#add-alert").html(response.Message);
                        //$("#add-alert").show();

                        notess.show(response.Message, {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });
                    }
                },
                error: function (error) {
                    //$("#add-alert").removeClass("alert-success");
                    //$("#add-alert").addClass("alert-danger");
                    //$("#add-alert").html(response.Message);
                    //$("#add-alert").show();

                    notess.show(response.Message, {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });

                }
            });
        }
    }


