    function functionUserDelete(abc) {
        if (confirm('Are you sure you want to delete this record?')) {
            var formData = new FormData();
            formData.append('GSTSLABId', abc);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/DeleteGstMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200) {

                        notes.show("GST slab deleted successfully.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                        displayData(0);
                    }
                    else {
                        //alert("Problem has been occurred while submitting your data.");

                        notes.show("Problem has been occurred while deleting GST Slab.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                    }
                },
                error: function (error) {
                    // alert("Problem has been occurred while submitting your data.");

                    notes.show("Problem has been occurred while deleting GST Slab.", {
                        type: 'danger',
                        //title: 'Opps.!',
