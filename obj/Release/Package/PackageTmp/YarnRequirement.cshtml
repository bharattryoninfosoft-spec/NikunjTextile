    function displayData(rowStartCheck) {

        var rowStart = rowStartCheck;
        var searchdesignNo = $("#SearchRequirementNo").val();

        var formData = new FormData();
        formData.append('SearchRequirementNo', searchdesignNo);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnRequirementMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";

                var srno = parseInt(rowStart) + parseInt(1);
                for (var i = 0; i < response.listYarnRequirementMaster.length; i++) {

                    temp += "<tr><td>" + srno++ + "</td>";
                    //temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnRequirementMaster[i].YarnRequirementID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnRequirementMaster[i].DesignColorMatchingFormID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listYarnRequirementMaster[i].DesignColorMatchingFormID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "<td><div class='actions'>";
                    temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnRequirementMaster[i].YarnRequirementID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;";
                    temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnRequirementMaster[i].YarnRequirementID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;";
                    temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listYarnRequirementMaster[i].YarnRequirementID + ")'><i class='icon-x-circle text-danger'></i></a>";
                    temp += "</div></td>";
                    //temp += "<td>" + response.listYarnRequirementMaster[i].DateandTimes + "</td>";
                    temp += "<td>" + response.listYarnRequirementMaster[i].RequirementDates + "</td>";
                    temp += "<td>" + response.listYarnRequirementMaster[i].RequirementNo + "</td>";
                    temp += "<td>" + response.listYarnRequirementMaster[i].PartyName + "</td>";
                    temp += "<td>" + response.listYarnRequirementMaster[i].MobileNo + "</td>";
                    temp += "<td>" + response.listYarnRequirementMaster[i].GSTIN + "</td>";
                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }






