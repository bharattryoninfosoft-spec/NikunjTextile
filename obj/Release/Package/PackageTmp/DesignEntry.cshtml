    function functionUserDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            var formData = new FormData();
            formData.append('DesignEntryFormID', id);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/DeleteDesignEntryFormMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200) {

                        notes.show("Design Entry Form deleted successfully.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                        displayData(0);
                    }
                    else {
                        //alert("Problem has been occurred while submitting your data.");

                        notes.show(response.Message, {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                    }
                },
                error: function (error) {
                    // alert("Problem has been occurred while submitting your data.");

                    notes.show("Problem has been occurred while deleting Design Entry Form.", {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });


                }
            });
        }

    }




