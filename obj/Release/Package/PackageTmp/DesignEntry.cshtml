        removeIcon: '<i class="icon-close"></i>'
    });






    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }

    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }




    function functionSearch() {
        displayPagginationData();
        displayData(0);
    }

    function displayData(rowStartCheck) {

        var rowStart = rowStartCheck;
        var searchdesignNo = $("#search-design-no").val();

        var formData = new FormData();
        formData.append('SearchDesignNo', searchdesignNo);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getDesignEntryFormMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";

                var srno = parseInt(rowStart) + parseInt(1);
                for (var i = 0; i < response.listDesignEntryForm.length; i++) {

                    temp += "<tr><td>" + srno++ + "</td>";
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listDesignEntryForm[i].DesignEntryFormID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Details' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listDesignEntryForm[i].DesignEntryFormID + ")'><i class='fa fa-eye text-secondary' style='font-weight:50;'></i></a>&nbsp;&nbsp;&nbsp;<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionUserDelete(" + response.listDesignEntryForm[i].DesignEntryFormID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "<td>" + response.listDesignEntryForm[i].DesignDates + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].DesignerCode + response.listDesignEntryForm[i].DesignNo + "</td>";
                    temp += "<td><img src='" + response.listDesignEntryForm[i].PhotoOfDesign + "' style='width:50px; height:50px;'></td>";
                    if (response.listDesignEntryForm[i].PhotoOfSketch == "") {
                        temp += "<td></td>";
                    }
                    else {
                        temp += "<td><img src='" + response.listDesignEntryForm[i].PhotoOfSketch + "' style='width:50px; height:50px;'></td>";
                    }

                    temp += "<td>" + response.listDesignEntryForm[i].WarpQuality + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].PickOnLoom + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].TotalCard + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].AveragePic + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].ReedOnLoom + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].Sketcher + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].Type + "</td>";
                    temp += "<td>" + response.listDesignEntryForm[i].DesignCategory + "</td>";
                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }






    var total = 0;
