    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }






        var searchSketcher = $("#search-Sketcher").val();

        var formData = new FormData();
        formData.append('searchSketcher', searchSketcher);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getSketcherMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {


                //$.ajax({
                //    type: "GET",
                //    url: '/WebServiceNikunjTextile.asmx/getSketcherMaster?startFrom=' + rowStart,
                //    //getItemCat
                //    data: "{ 'startFrom':'" + rowStart + "' }",
                //    dataType: 'json',
                //    contentType: false,
                //    processData: false,
                //    success: function (response) {

                console.log(response);

                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listSketcherMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
                    $("#view-more-btn").show();
                }

                var SrNo = rowStart + 1;
                for (var i = 0; i < response.listSketcherMaster.length; i++) {

                    var Top = i - 1;
                    var Previous = i + 1;

                    //console.log(response.listSketcherMaster[Previous].SketcherID);

                    var ActionPosition = "";
                    if (response.listSketcherMaster.length != 1) {
                        if (i == 0) {

                            var PostDown = response.listSketcherMaster[i].SketcherID + "," + response.listSketcherMaster[i].Position + "|" + response.listSketcherMaster[Previous].SketcherID + "," + response.listSketcherMaster[Previous].Position;

                            ActionPosition += "<input type='hidden' id='PostDown_" + response.listSketcherMaster[i].SketcherID + "' value = '" + PostDown + "' /> ";
                            ActionPosition += "<span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listSketcherMaster[i].SketcherID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            //ActionPosition += "<button type='button' class='btn btn-primary' style='font-size: 6px;' onclick='functionCakeCategoryUp(" + response.listSketcherMaster[i].SketcherID + ")'><i class='fa fa-arrow-up fa-2x'></i></button>  &nbsp;";
                        }
                        else
                            if (i == parseInt(response.listSketcherMaster.length - 1)) {

                                var PostUp = response.listSketcherMaster[i].SketcherID + "," + response.listSketcherMaster[i].Position + "|" + response.listSketcherMaster[Top].SketcherID + "," + response.listSketcherMaster[Top].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listSketcherMaster[i].SketcherID + "' value = '" + PostUp + "' /> </span>";
                                ActionPosition += "<span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listSketcherMaster[i].SketcherID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'></td>";
                            }
                            else {

                                var PostUp = response.listSketcherMaster[i].SketcherID + "," + response.listSketcherMaster[i].Position + "|" + response.listSketcherMaster[Top].SketcherID + "," + response.listSketcherMaster[Top].Position;
                                var PostDown = response.listSketcherMaster[i].SketcherID + "," + response.listSketcherMaster[i].Position + "|" + response.listSketcherMaster[Previous].SketcherID + "," + response.listSketcherMaster[Previous].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listSketcherMaster[i].SketcherID + "' value = '" + PostUp + "' /><span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listSketcherMaster[i].SketcherID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span>";
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listSketcherMaster[i].SketcherID + "' value = '" + PostDown + "' /><span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listSketcherMaster[i].SketcherID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }

                    }

                    temp += "<tr>";
                    temp += "<td>" + SrNo++ + "</td>";
                    temp += "<td>" + response.listSketcherMaster[i].Sketcher + "</td>";

                    if (response.listSketcherMaster[i].IsActive == "1") {
                        temp += "<td><span class='badge bg-success'>Active</span></td>";
                    }
                    else {
                        temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                    }

                    // temp += "<td>" + ActionPosition + "</td>";
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listSketcherMaster[i].SketcherID + ")'><i class='icon-edit1 text-info'></i></a> &nbsp;&nbsp; <a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listSketcherMaster[i].SketcherID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "</tr>";
                }

                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }








    //Delete Sketcher
    function functionFYDelete(abc) {
        if (confirm('Are you sure you want to delete this record?')) {
            // Save it!
            //alert(abc)
            var formData = new FormData();
            formData.append('FinancialYearIDs', abc);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.Code == 1) {
                        displayData(0);

                        notes.show("Financial Year deleted successfully.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                    }

                    else {
                        //document.getElementById("divSuccess").style.display = "none";
                        //document.getElementById("divError").style.display = "block";
                        //$("#spanError").html(response.Message);

                        notes.show("Problem has been occurred while deleting Financial Year.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });


                    }
                },
                error: function (error) {
                    notes.show("Problem has been occurred while deleting Financial Year.", {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });
                }
            });


        } else {
            // Do nothing!
            console.log('Problem has been occurred while submitting your data.');
        }
        //alert(abc);
    }

    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add Sketcher");
        $("#add-alert").hide();

        $("#Sketcher").val('');

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }



    function checkSaveView() {

        var IsActive = "0";
        if ($("#IsActive").is(':checked')) {
            //$("#isDefault").attr('value', 'true');
            IsActive = "1";
        }


        var Sketcher = $('#Sketcher').val();


        if (validate(document.getElementById('Sketcher')) == false) {
            validate(document.getElementById('Sketcher'));
        }
        else {

            var formData = new FormData();
            formData.append('Sketcher', Sketcher);
            formData.append('IsActive', IsActive);


            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertSketcherMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 201) {
                        clearAll();

                        notes.show(response.Message, {
                            type: 'success',

                        });
                        displayData(0);
                        $("#cancelbtn").click();
                    }
                    else {


                        notess.show(response.Message, {
                            type: 'danger',

                        });
                    }
                },
                error: function (error) {


                    notess.show(response.Message, {
                        type: 'danger',

                    });

                }
            });
        }
    }


