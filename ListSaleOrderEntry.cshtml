                type: "POST",
                data: JSON.stringify({ SaleOrderID: id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res) {
                    let data = res.d;

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
