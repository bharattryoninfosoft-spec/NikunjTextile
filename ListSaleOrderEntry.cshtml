<script>
    $(document).ready(function () {


        $('.active, .show, .current-page').removeClass('active show current-page');

        $("#master-tab").addClass("active");
        $("#tab-Master").addClass("show active");
        $("#aColorGroup").addClass("current-page");

        FunctionIsLogin();
        loadSaleOrders();
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    let SaleOrderList = [];

    function loadSaleOrders() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetSaleOrderList",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                let data = res.d;

                if (data.success) {
                    SaleOrderList = data.Data;

                    bindDataTable(SaleOrderList);
                } else {
                    alert(data.message);
                }
            }
        });
    }
    function bindDataTable(data) {

        let table = $('#saleOrderTable').DataTable({
            destroy: true,
            data: data,

            columns: [
                {
                    className: 'dt-control',
                    orderable: false,
                    data: null,
                    defaultContent: '<span style="cursor:pointer;"><i class="fa fa-plus"></i></span>'
                },
                { data: 'OrderNo' },
                { data: 'OrderDate' },
                { data: 'TotalQty' },
                { data: 'InvoiceAmount' },
                {  data: null,
                    render: function (data, type, row) {
                        return `
                        <i class="fa fa-edit text-primary edit me-2" data-id="${row.SaleOrderID}"></i>
                        <i class="fa fa-eye text-dark view me-2" data-id="${row.SaleOrderID}"></i>
                        <i class="fa fa-trash text-danger delete" data-id="${row.SaleOrderID}"></i>                           
                        `;
                    }
                }
            ],     
            info: false,
            lengthChange: false
        });

        // ✅ FIX CLICK EVENT
        $('#saleOrderTable tbody').off('click');

        $('#saleOrderTable tbody').on('click', 'td.dt-control', function () {

            let tr = $(this).closest('tr');
            let row = table.row(tr);

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
                $(this).html('<i class="fa fa-plus"></i>');
            } else {
                row.child(formatDetails(row.data())).show();
                tr.addClass('shown');
                $(this).html('<i class="fa fa-minus"></i>');
            }
        });
    }
    function formatDetails(order) {

        console.log("DETAIL CHECK:", order); // 🔍 DEBUG

        if (!order.Details || order.Details.length === 0) {
            return "<div style='padding:10px;'>No Details Found</div>";
        }

        let html = `<div style="padding:10px;">`;

        order.Details.forEach(d => {

            html += `
        <div style="border:1px solid #ddd; margin-bottom:10px; padding:8px;">
            <b>${d.DesignNo}</b> | Qty: ${d.Qty}
        `;

            if (d.SubDetails && d.SubDetails.length > 0) {

                html += `<table class="table table-sm mt-2">
                        <thead>
                            <tr>
                                <th>Colour</th>
                                <th>Qty</th>
                                <th>Unit</th>
                            </tr>
                        </thead><tbody>`;

                d.SubDetails.forEach(s => {
                    html += `
                <tr>
                    <td>${s.ColourName}</td>
                    <td>${s.Qty}</td>
                    <td>${s.Unit}</td>
                </tr>`;
                });

                html += `</tbody></table>`;
            }

            html += `</div>`;
        });

        html += `</div>`;
        return html;
    }
</script>



