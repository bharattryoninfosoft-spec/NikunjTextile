@{
    Layout = "/_LayoutPage1.cshtml";
}


<style>
    /* ========================================================
       ERP DESIGN SYSTEM - SALES ORDER (NIKUNJ TEXTILE)
       Deep Navy Blue (#1E3A5F) | Royal Blue (#2563EB) | Teal (#0D9488) | Light Gray (#F5F7FA)
    ======================================================== */
    :root {
        --erp-navy: #1E3A5F;
        --erp-navy-dark: #152A45;
        --erp-navy-light: #F0F4F8;
        --erp-blue: #2563EB;
        --erp-blue-hover: #1D4ED8;
        --erp-blue-light: #EFF6FF;
        --erp-teal: #0D9488;
        --erp-teal-light: #F0FDFA;
        --erp-bg: #F5F7FA;
        --erp-card-bg: #FFFFFF;
        --erp-border: #E2E8F0;
        --erp-text-main: #1E293B;
        --erp-text-muted: #64748B;
        --erp-shadow: 0 4px 12px rgba(30, 58, 95, 0.06);
        --erp-shadow-hover: 0 8px 20px rgba(30, 58, 95, 0.1);
    }

    body, .content-wrapper {
        background-color: var(--erp-bg);
        color: var(--erp-text-main);
    }

    /* Page Header Hero Card */
    .erp-hero-header {
        background: #FFFFFF;
        border: 1px solid var(--erp-border);
        border-radius: 12px;
        padding: 18px 24px;
        box-shadow: var(--erp-shadow);
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .erp-hero-title-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .erp-hero-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        background: linear-gradient(135deg, #1E3A5F 0%, #2563EB 100%);
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
    }

    .erp-hero-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--erp-navy);
        margin: 0;
        line-height: 1.2;
    }

    .erp-hero-subtitle {
        font-size: 13px;
        color: var(--erp-text-muted);
        margin: 3px 0 0 0;
    }

    .erp-btn-primary {
        background: var(--erp-blue) !important;
        border-color: var(--erp-blue) !important;
        color: #FFFFFF !important;
        font-weight: 600;
        padding: 9px 20px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.25);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .erp-btn-primary:hover {
        background: var(--erp-blue-hover) !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(37, 99, 235, 0.35);
        color: #FFFFFF !important;
    }

    /* Filter Card */
    .erp-card {
        background: #FFFFFF;
        border: 1px solid var(--erp-border);
        border-radius: 12px;
        box-shadow: var(--erp-shadow);
        padding: 20px;
        margin-bottom: 20px;
    }

    .erp-filter-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 18px;
    }

    .erp-btn-pdf {
        background: #DC2626 !important;
        border-color: #DC2626 !important;
        color: #FFFFFF !important;
        font-weight: 600;
        padding: 8px 18px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(220, 38, 38, 0.2);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .erp-btn-pdf:hover {
        background: #B91C1C !important;
        transform: translateY(-1px);
        color: #FFFFFF !important;
    }

    .erp-search-box {
        position: relative;
        min-width: 320px;
    }

    .erp-search-box i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--erp-text-muted);
        font-size: 14px;
        pointer-events: none;
    }

    .erp-search-input {
        padding-left: 38px !important;
        height: 42px;
        border-radius: 8px;
        border: 1px solid var(--erp-border);
        font-size: 13px;
        background: #F8FAFC;
        transition: all 0.2s ease;
    }

    .erp-search-input:focus {
        background: #FFFFFF;
        border-color: var(--erp-blue);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    /* Modern ERP Table */
    .erp-table-container {
        border: 1px solid var(--erp-border);
        border-radius: 10px;
        overflow-x: auto;
        background: #FFFFFF;
    }

    #saleOrderTable {
        width: 100% !important;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    #saleOrderTable thead th {
        background-color: var(--erp-navy) !important;
        color: #FFFFFF !important;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 13px 14px;
        vertical-align: middle;
        border: none;
        white-space: nowrap;
    }

    #saleOrderTable tbody td {
        padding: 12px 14px;
        vertical-align: middle;
        border-top: 1px solid #F1F5F9;
        border-bottom: none;
        border-left: none;
        border-right: none;
        font-size: 13px;
        color: var(--erp-text-main);
        transition: background-color 0.15s ease;
    }

    #saleOrderTable tbody tr:hover td {
        background-color: #F8FAFC !important;
    }

    .erp-order-no {
        font-weight: 700;
        color: var(--erp-navy);
    }

    .erp-party-cell {
        font-weight: 600;
        color: var(--erp-text-main);
    }

    .erp-date-cell {
        color: var(--erp-text-muted);
        font-size: 12px;
        white-space: nowrap;
    }

    .erp-qty-badge {
        background: var(--erp-blue-light);
        color: var(--erp-navy);
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        display: inline-block;
        border: 1px solid #DBEAFE;
    }

    .erp-amount-cell {
        font-weight: 700;
        color: var(--erp-navy);
        font-size: 13px;
        white-space: nowrap;
    }

    /* Status Badges */
    .erp-badge-open {
        background-color: #ECFDF5 !important;
        color: #065F46 !important;
        border: 1px solid #A7F3D0;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
    }

    .erp-badge-locked {
        background-color: #FFFBEB !important;
        color: #92400E !important;
        border: 1px solid #FDE68A;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
    }

    /* Action Button Group */
    .erp-action-btn-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .erp-btn-action {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        transition: all 0.2s ease;
        cursor: pointer;
        background: transparent;
        padding: 0;
    }

    .erp-btn-edit {
        background: #EFF6FF;
        color: var(--erp-blue);
        border: 1px solid #DBEAFE;
    }

    .erp-btn-edit:hover {
        background: var(--erp-blue);
        color: #FFFFFF !important;
        border-color: var(--erp-blue);
        transform: translateY(-1px);
    }

    .erp-btn-view {
        background: #F0FDFA;
        color: var(--erp-teal);
        border: 1px solid #CCFBF1;
    }

    .erp-btn-view:hover {
        background: var(--erp-teal);
        color: #FFFFFF !important;
        border-color: var(--erp-teal);
        transform: translateY(-1px);
    }

    .erp-btn-delete {
        background: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
    }

    .erp-btn-delete:hover {
        background: #DC2626;
        color: #FFFFFF !important;
        border-color: #DC2626;
        transform: translateY(-1px);
    }

    .erp-btn-disabled {
        background: #F1F5F9;
        color: #94A3B8;
        border: 1px solid #E2E8F0;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* Pagination */
    .erp-pagination-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        padding-top: 18px;
    }

    #pageNumbers {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .page-btn {
        min-width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid var(--erp-border);
        background: #FFFFFF;
        color: var(--erp-text-main);
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .page-btn:hover {
        background: #F8FAFC;
        border-color: var(--erp-blue);
        color: var(--erp-blue);
    }

    .page-btn.active {
        background: var(--erp-blue) !important;
        border-color: var(--erp-blue) !important;
        color: #FFFFFF !important;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
    }

    .page-dots {
        padding: 0 6px;
        font-weight: bold;
        color: var(--erp-text-muted);
    }

    .erp-nav-btn {
        height: 36px;
        padding: 0 16px;
        border-radius: 8px;
        border: 1px solid var(--erp-border);
        background: #FFFFFF;
        color: var(--erp-text-main);
        font-size: 13px;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .erp-nav-btn:hover:not(:disabled) {
        background: #F8FAFC;
        border-color: var(--erp-navy);
        color: var(--erp-navy);
    }

    .erp-nav-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Modal Styling */
    .erp-modal-header {
        background: linear-gradient(135deg, var(--erp-navy) 0%, var(--erp-navy-dark) 100%) !important;
        color: #FFFFFF !important;
        border-bottom: none;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

    .erp-info-card {
        background: #FFFFFF;
        border: 1px solid var(--erp-border);
        border-radius: 10px;
        padding: 16px;
        box-shadow: 0 2px 6px rgba(30, 58, 95, 0.04);
        margin-bottom: 16px;
    }

    .erp-table-modal thead th {
        background: #F1F5F9 !important;
        color: var(--erp-navy) !important;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
        border-bottom: 2px solid var(--erp-border);
    }
</style>

<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>

    <!-- ERP Hero Header Banner -->
    <div class="erp-hero-header" style="background-color: #eaf3ff; border: 1px solid #68a0eb; ">
        <div class="erp-hero-title-group">
            <div class="erp-hero-icon">
                <i class="fa fa-shopping-cart"></i>
            </div>
            <div>
                <h4 class="erp-hero-title">Sales Orders</h4>
                <p class="erp-hero-subtitle">Manage customer orders, track production readiness, and export documents</p>
            </div>
        </div>
        <div>
            <a href="saleOrderEntry" id="AddsaleOrderEntry" class="erp-btn-primary">
                <i class="fa fa-plus-circle"></i> Add Sales Order
            </a>
        </div>
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="erp-card" style="background-color: #eaf3ff; border: 1px solid #68a0eb; ">
                <!-- Filter Toolbar -->
                <div class="erp-filter-toolbar">
                    <button class="btn erp-btn-pdf" id="btnGeneratePDF">
                        <span id="btnText">
                            <i class="fa fa-file-pdf-o"></i> Export PDF
                        </span>
                        <span id="btnLoader" style="display:none;">
                            <i class="fa fa-spinner fa-spin"></i> Generating...
                        </span>
                    </button>

                    <div class="erp-search-box">
                        <i class="fa fa-search"></i>
                        <input id="SearchRequirementNo" placeholder="Search Order No / Party Name..." type="text" class="form-control erp-search-input detail" onkeyup="functionSearch()">
                    </div>
                </div>

                <!-- Table Container -->
                <div class="erp-table-container table-responsive">
                    <table id="saleOrderTable" class="table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 40px; text-align: center;"><input id="selectAll" type="checkbox" style="cursor: pointer;" /></th>
                                <th>Order No</th>
                                <th>Date</th>
                                <th>Party Name</th>
                                <th>Broker</th>
                                <th>Transport</th>
                                <th style="text-align: right;">Total Qty</th>
                                <th style="text-align: right;">Invoice Amount</th>
                                <th style="text-align: center; width: 120px;">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="erp-pagination-bar">
                    <button id="prevPage" class="erp-nav-btn">
                        <i class="fa fa-chevron-left me-1"></i> Previous
                    </button>

                    <div id="pageNumbers"></div>

                    <button id="nextPage" class="erp-nav-btn">
                        Next <i class="fa fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- Sale Order View Modal -->
            <div class="modal fade" id="viewSaleOrderModal" tabindex="-1" aria-labelledby="viewSaleOrderModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
                    <div class="modal-content shadow-lg border-0 rounded-3">
                        <div class="modal-header erp-modal-header py-3 px-4">
                            <h5 class="modal-title fw-bold fs-5" id="viewSaleOrderModalLabel">
                                <i class="fa fa-file-text-o me-2"></i> View Sale Order Details
                            </h5>
                            <button type="button" class="btn-close text-white close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close" style="background: transparent; border: none; font-size: 1.5rem; color: #fff; opacity: 0.9; cursor: pointer; line-height: 1;"><span aria-hidden="true">&times;</span></button>
                        </div>
                        <div class="modal-body p-4 bg-light">
                            <!-- Master Info Summary Card -->
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <span class="text-muted small d-block">Order No</span>
                                        <strong id="viewOrderNo" class="text-dark">--</strong>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="text-muted small d-block">Order Date</span>
                                        <strong id="viewOrderDate" class="text-dark">--</strong>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="text-muted small d-block">Party Name</span>
                                        <strong id="viewPartyName" class="text-dark">--</strong>
                                    </div>
                                    <div class="col-md-3">
                                        <span class="text-muted small d-block">Broker</span>
                                        <strong id="viewBroker" class="text-dark">--</strong>
                                    </div>
                                    <div class="col-md-3 mt-2">
                                        <span class="text-muted small d-block">Transport</span>
                                        <strong id="viewTransport" class="text-dark">--</strong>
                                    </div>
                                    <div class="col-md-3 mt-2">
                                        <span class="text-muted small d-block">Markup %</span>
                                        <strong id="viewMarkup" class="text-dark">--</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Items Details Table -->
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                                <h6 class="fw-bold text-primary mb-3"><i class="fa fa-list-alt me-2"></i>Ordered Items Details</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm align-middle" id="viewItemsTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-center" style="width: 50px;">Sr No</th>
                                                <th>Design No</th>
                                                <th style="width: 90px;">Type</th>
                                                <th>Colours & Quantities</th>
                                                <th class="text-end" style="width: 90px;">Total Qty</th>
                                                <th class="text-center" style="width: 70px;">Unit</th>
                                                <th class="text-end" style="width: 100px;">Rate</th>
                                                <th class="text-end" style="width: 110px;">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Dynamically populated rows -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Additional Charges Table Format (Placed under items / above remarks) -->
                            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                                <h6 class="fw-bold text-secondary mb-2">Additional Charges</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm align-middle mb-0" id="viewAdditionalChargesTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Sr No</th>
                                                <th>Charge Remark</th>
                                                <th>Rate / Value</th>
                                                <th>Total Calculated Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody id="viewAdditionalChargesContainer">
                                            <tr><td colspan="4" class="text-center text-muted">No additional charges.</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Bottom Notes & Totals Section -->
                            <div class="row gutters">
                                <div class="col-xl-7 col-lg-7 col-md-12 col-sm-12 col-12">
                                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                                        <span class="text-muted small d-block mb-1">Notes / Remarks</span>
                                        <p id="viewRemarks" class="text-dark fw-medium mb-0">--</p>
                                    </div>
                                </div>
                                <div class="col-xl-5 col-lg-5 col-md-12 col-sm-12 col-12 ms-auto">
                                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Total Amount:</span>
                                            <strong id="viewTotalAmount">0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Discount:</span>
                                            <strong id="viewDiscount">0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">GST Amount:</span>
                                            <strong id="viewGstAmount">0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Round Off:</span>
                                            <strong id="viewRoundOff">0.00</strong>
                                        </div>
                                        <div class="d-flex justify-content-between py-2 mt-1">
                                            <span class="fs-6 fw-bold text-dark">Invoice Total:</span>
                                            <span id="viewInvoiceAmount" class="fs-5 fw-bold text-primary">0.00</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-white py-2 px-4 border-top">
                            <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Row end -->

</div>
@section Scripts{
    <script>
        var currentPagePermission = {};
        let SaleOrderList = [];
        let FilteredSaleOrderList = [];
        let currentPage = 1;
        let pageSize = 10;

        $(document).ready(function () {
            FunctionIsLogin();
            loadSaleOrders();
        });

        // Helper function for SweetAlert2 toast notifications
        function showToast(type, msg) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type,
                title: msg,
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true
            });
        }
        $(document).on("click", ".page-btn", function () {
            currentPage = parseInt($(this).data("page"));
            renderPage();
        });
        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    showToast('error', request.statusText || 'Failed to fetch default company.');
                }
            });
        }
        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    console.log(data);
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }
        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }
        function loadSaleOrders() {
            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/GetSaleOrderList",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (res) {
                    let data = res.d;
                    console.log("GetSaleOrderList", data);
                    if (data.success) {
                        SaleOrderList = data.Data;
                        FilteredSaleOrderList = [...SaleOrderList];
                        currentPage = 1;
                        renderPage();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: data.message
                        });
                    }
                }
            });
        }
        function renderPage() {
            let start = (currentPage - 1) * pageSize;
            let end = start + pageSize;

            let pageData = FilteredSaleOrderList.slice(start, end);

            bindDataTable(pageData);

            let totalPages = Math.ceil(FilteredSaleOrderList.length / pageSize);

            $("#pageInfo").html(`Page ${currentPage} of ${totalPages}`);

            $("#prevPage").prop("disabled", currentPage === 1);
            $("#nextPage").prop("disabled", currentPage === totalPages);

            renderPageNumbers();
        }
        function renderPageNumbers() {
            let totalPages = Math.ceil(FilteredSaleOrderList.length / pageSize);
            let html = '';

            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);

            // First page
            if (startPage > 1) {
                html += `<button class="page-btn" data-page="1">1</button>`;

                if (startPage > 2) {
                    html += `<span class="page-dots">...</span>`;
                }
            }

            // Middle pages
            for (let i = startPage; i <= endPage; i++) {
                html += `
                        <button class="page-btn ${i === currentPage ? 'active' : ''}"
                                data-page="${i}">
                            ${i}
                        </button>
                    `;
            }

            // Last page
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += `<span class="page-dots">...</span>`;
                }

                html += `
                        <button class="page-btn" data-page="${totalPages}">
                            ${totalPages}
                        </button>
                    `;
            }

            $("#pageNumbers").html(html);
        }
        $(document).on("click", "#nextPage", function () {
            let totalPages = Math.ceil(FilteredSaleOrderList.length / pageSize);

            if (currentPage < totalPages) {
                currentPage++;
                renderPage();
            }
        });
        $(document).on("click", "#prevPage", function () {
            console.log("Previous Clicked");

            if (currentPage > 1) {
                currentPage--;
                renderPage();
            }
        });
        function bindDataTable(data) {
            let tbody = $("#saleOrderTable tbody");
            tbody.empty();

            $.each(data, function (i, row) {
                let encodedId = btoa(row.SaleOrderID);
                let actionHtml = '<div class="erp-action-btn-group">';

                if (parseInt(row.isEdite) === 0) {
                    // EDIT ENABLED
                    actionHtml += `<button type="button" class="erp-btn-action erp-btn-edit edit" data-id="${encodedId}" title="Edit Order"><i class="fa fa-pencil" style="pointer-events:none;"></i></button>`;
                } else {
                    // EDIT DISABLED
                    actionHtml += `<button type="button" class="erp-btn-action erp-btn-disabled" title="Edit Locked - Production Order Created" disabled><i class="fa fa-lock" style="pointer-events:none;"></i></button>`;
                }
                // VIEW ALWAYS ENABLED
                actionHtml += `<button type="button" class="erp-btn-action erp-btn-view view" data-id="${encodedId}" title="View Details"><i class="fa fa-eye" style="pointer-events:none;"></i></button>`;
                if (parseInt(row.isEdite) === 0) {
                    // DELETE ENABLED
                    actionHtml += `<button type="button" class="erp-btn-action erp-btn-delete delete" data-id="${row.SaleOrderID}" title="Delete Order"><i class="fa fa-trash" style="pointer-events:none;"></i></button>`;
                } else {
                    // DELETE DISABLED
                    actionHtml += `<button type="button" class="erp-btn-action erp-btn-disabled" title="Delete Locked - Production Order Created" disabled><i class="fa fa-lock" style="pointer-events:none;"></i></button>`;
                }
                actionHtml += '</div>';

                let statusBadge = (parseInt(row.isEdite) === 0) 
                    ? `<span class="erp-badge-open ms-2"><i class="fa fa-circle me-1" style="font-size:7px;"></i>Open</span>` 
                    : `<span class="erp-badge-locked ms-2"><i class="fa fa-lock me-1" style="font-size:9px;"></i>In Production</span>`;

                let rawAmt = parseFloat(row.InvoiceAmount || 0);
                let formattedAmount = isNaN(rawAmt) ? '0.00' : rawAmt.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                let tr = `
                        <tr>
                            <td style="text-align: center;">
                                <input type="checkbox" class="row-checkbox" value="${row.SaleOrderID}" style="cursor: pointer;" />
                            </td>
                            <td>
                                <div class="d-inline-flex align-items-center">
                                    <span class="erp-order-no">${row.OrderNo}</span>
                                    ${statusBadge}
                                </div>
                            </td>
                            <td><span class="erp-date-cell"><i class="fa fa-calendar-o me-1"></i>${row.OrderDate}</span></td>
                            <td><span class="erp-party-cell">${row.PartyName || '-'}</span></td>
                            <td>${row.BrokerName || '-'}</td>
                            <td>${row.TransportName || '-'}</td>
                            <td style="text-align: right;"><span class="erp-qty-badge">${row.TotalQty}</span></td>
                            <td style="text-align: right;"><span class="erp-amount-cell"><i class="fa fa-inr me-1" style="font-size:11px;"></i>${formattedAmount}</span></td>
                            <td style="text-align: center;">${actionHtml}</td>
                        </tr>
                    `;

                tbody.append(tr);
                var permission = getCookie("PagePermission");
                if (permission != null && permission != "") {
                    var currentPagePermission = JSON.parse(permission);
                    if (currentPagePermission.Add == false) {
                        $("#AddsaleOrderEntry").hide();
                    }
                    if (currentPagePermission.Edit == false) { $(".edit").hide(); }
                    if (currentPagePermission.Delete == false) { $(".delete").hide(); }
                    if (currentPagePermission.view == false) { $(".view").hide(); }
                }
            });
        }
        $(document).on('click', '.edit', function () {
            let id = $(this).attr('data-id');
            window.location.href = "/UpdateSaleOrderEntry?id=" + encodeURIComponent(id);
        });
        $(document).on('click', '.view', function () {
    debugger;
    let encodedId = $(this).attr('data-id');
    let saleOrderId = atob(decodeURIComponent(encodedId));

    $.ajax({
        url: '/WebServiceNikunjTextile.asmx/GetSaleOrderById',
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        dataType: 'json',
        data: JSON.stringify({ SaleOrderID: parseInt(saleOrderId) }),
        success: function (res) {
            let response = res.d;
            if (response.success) {
                let d = response.Data;

                // 1. Fill Master Summary Fields
                $("#viewOrderNo").text(d.OrderNo || '--');
                $("#viewOrderDate").text(d.OrderDate || '--');
                $("#viewPartyName").text(d.PartyName || '--');
                $("#viewBroker").text(d.BrokerName || d.BrokerID || '--');
                $("#viewTransport").text(d.TransportName || d.TransportID || '--');
                $("#viewMarkup").text((d.MarkupPercent || 0) + '%');
                $("#viewRemarks").text(d.Remark || 'No remarks provided.');

                // 3. Render Additional Charges Table Rows
                let addChargesTbody = $("#viewAdditionalChargesContainer");
                addChargesTbody.empty();

                let totalAdditionalChargeValue = 0;

                if (d.AdditionalCharges && d.AdditionalCharges.length > 0) {
                    d.AdditionalCharges.forEach((ac, idx) => {
                        let calculatedChargeAmount = parseFloat(ac.TotalCalculatedAmount || ac.totalCalculatedAmount || 0);
                        totalAdditionalChargeValue += parseFloat(ac.ChargeValue || ac.chargeValue || 0);

                        let row = `
                        <tr>
                            <td>${idx + 1}</td>
                            <td>${ac.ChargeRemark || '--'}</td>
                            <td><i class="fa fa-inr"></i> ${parseFloat(ac.ChargeValue || 0).toFixed(2)}</td>
                            <td><i class="fa fa-inr"></i> ${calculatedChargeAmount.toFixed(2)}</td>
                        </tr>`;
                        addChargesTbody.append(row);
                    });
                } else {
                    addChargesTbody.html(`<tr><td colspan="4" class="text-center text-muted">No additional charges found.</td></tr>`);
                }
                // 4. Render Items Sub-table & Calculate Dynamic Line Totals
                let itemTbody = $("#viewItemsTable tbody");
                itemTbody.empty();

                let calculatedSubTotalAmount = 0;

                if (d.Details && d.Details.length > 0) {
                    d.Details.forEach((item, index) => {
                        let designIndexStr = String(index + 1).padStart(2, '0');
                        let designCode = `${d.OrderNo || 'SO'}-${designIndexStr}`;

                        let colorBreakdown = "";
                        if (item.SubDetails && item.SubDetails.length > 0) {
                            colorBreakdown = item.SubDetails.map((sub, sIdx) => {
                                return `<div class="py-0.5">${sIdx + 1}. ${sub.ColourName} (${sub.Qty} ${sub.Unit || item.Unit || 'PCS'})</div>`;
                            }).join("");
                        }

                        let saleRate = parseFloat(item.BrokerRate || item.Rate || 0);
                        let chargeValue = parseFloat(item.ChargeValue || item.chargeValue || totalAdditionalChargeValue);

                        // Formula: SaleRate + ChargeValue = Rate
                        let calculatedRate = saleRate + chargeValue;
                        let qty = parseFloat(item.Qty || item.qty || 0);

                        // Formula: Rate * Qty = Amount
                        let calculatedAmount = calculatedRate * qty;

                        calculatedSubTotalAmount += calculatedAmount;

                        let designCol = `
                        <div>
                            <div class="fw-bold text-dark fs-6">${item.DesignName || item.DesignNo || '--'}</div>
                            <small class="text-muted" style="font-family: monospace;"><i class="fa fa-sitemap me-1 text-info"></i>${designCode}</small>
                        </div>`;

                        let imgUrl = item.ImageUrl || item.PhotoOfDesign || item.ColorMatchingPhoto || item.DesignPhoto || '';
                        if (imgUrl && String(imgUrl).trim() !== "") {
                            let imgSrc = formatImageUrl(imgUrl);
                            designCol = `
                            <div class="d-flex align-items-center gap-2">
                                <img src="${imgSrc}" alt="Design" 
                                     style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" 
                                     onerror="handleImageError(this, '${imgUrl}')">
                                <div>
                                    <div class="fw-bold text-dark fs-6">${item.DesignName || item.DesignNo || '--'}</div>
                                    <small class="text-muted" style="font-family: monospace;"><i class="fa fa-sitemap me-1 text-info"></i>${designCode}</small>
                                </div>
                            </div>`;
                        }

                        let row = `
                        <tr>
                            <td class="text-center fw-bold">${index + 1}</td>
                            <td>${designCol}</td>
                            <td><span class="badge bg-light text-dark border">${item.Type || '--'}</span></td>
                            <td>${colorBreakdown || '<span class="text-muted small">No colors specified</span>'}</td>
                            <td class="text-end fw-bold">${qty}</td>
                            <td class="text-center">${item.Unit || 'PCS'}</td>
                            <td class="text-end fw-semibold"><i class="fa fa-inr"></i> ${calculatedRate.toFixed(2)}</td>
                            <td class="text-end fw-bold text-success"><i class="fa fa-inr"></i> ${calculatedAmount.toFixed(2)}</td>
                        </tr>`;
                        itemTbody.append(row);
                    });
                } else {
                    itemTbody.html(`<tr><td colspan="8" class="text-center text-muted py-3">No line items found.</td></tr>`);
                }
                // 2. Compute and Fill Totals Summary Fields using Percentage-based calculations
                let finalTotalAmount = calculatedSubTotalAmount; // e.g., 9840.00

                // Get Discount Percent (fallback to 0 if not provided)
                let discountPercent = parseFloat(d.DiscountPercent || d.discountPercent || 0);
                let discountAmount = finalTotalAmount * (discountPercent / 100);

                // Taxable Amount after discount
                let taxableAmount = finalTotalAmount - discountAmount;

                // Get GST Percent (fallback to 10% or from database model)
                let gstPercent = parseFloat(d.GSTPercent || d.gstPercent || 10);
                let gstAmount = taxableAmount * (gstPercent / 100);

                // Step 1: Calculate the exact unrounded total before round-off
                let unroundedInvoiceTotal = taxableAmount + gstAmount;

                // Step 2: Automatically calculate round-off to snap to the nearest whole integer
                let roundedInvoiceTotal = Math.round(unroundedInvoiceTotal);
                let roundOff = roundedInvoiceTotal - unroundedInvoiceTotal;

                // Step 3: Final invoice total takes the rounded value directly
                let invoiceAmount = roundedInvoiceTotal;

                // Bind to view fields with accurate precision
                $("#viewTotalAmount").text(finalTotalAmount.toFixed(2));
                $("#viewDiscount").text(discountAmount.toFixed(2));
                $("#viewGstAmount").text(gstAmount.toFixed(2));
                $("#viewRoundOff").text(roundOff.toFixed(2));
                $("#viewInvoiceAmount").text(invoiceAmount.toFixed(2));
                // 5. Open Modal
                $("#viewSaleOrderModal").modal("show");
            } else {
                Swal.fire('Error', response.Message || 'Failed to fetch order details.', 'error');
            }
        },
        error: function () {
            Swal.fire('Error', 'Server connection error occurred.', 'error');
        }
    });
});
