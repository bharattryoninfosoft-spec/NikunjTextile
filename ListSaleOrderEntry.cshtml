<script>
    $(document).ready(function () {


        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#finance-tab").addClass("active");
        $("#tab-finance").addClass("show active");
        $("#aSaleOrderEntry").addClass("current-page");

        FunctionIsLogin();
        loadSaleOrders();
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    let SaleOrderList = [];

    function loadSaleOrders() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetSaleOrderList",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                let data = res.d;

                if (data.success) {
                    SaleOrderList = data.Data;

                    bindDataTable(SaleOrderList);
                } else {
                    alert(data.message);
                }
            }
        });
    }
    function bindDataTable(data) {
        console.log("data", data);
        let table = $('#saleOrderTable').DataTable({
            destroy: true,
            data: data,
            ordering: false,
            
            columns: [            
                { data: 'OrderNo' },
                {
                    data: 'OrderDate',
                    render: function (data) {
                        if (!data) return '';

                        // ✅ Extract milliseconds from .NET format
                        let match = /\/Date\((\d+)\)\//.exec(data);
                        if (!match) return '';
                        let d = new Date(parseInt(match[1]));
                        let day = String(d.getDate()).padStart(2, '0');
                        let month = String(d.getMonth() + 1).padStart(2, '0');
                        let year = d.getFullYear();
                        return `${day}-${month}-${year}`;
                    }
                },
                { data: 'PartyName', defaultContent: '-' },
                { data: 'BrokerName', defaultContent: '-' },
                { data: 'TransportName', defaultContent: '-' },
                { data: 'TotalQty' },
                { data: 'InvoiceAmount' },

                {
                    data: null,
                    render: function (data, type, row) {
                        let encodedId = btoa(row.SaleOrderID);

                        return `
                            <i class="fa fa-edit text-primary edit me-2" data-id="${encodedId}" style="cursor:pointer;"></i>
                            <i class="fa fa-eye text-dark view me-2" data-id="${encodedId}" style="cursor:pointer;"></i>
                            <i class="fa fa-trash text-danger delete" data-id="${row.SaleOrderID}" style="cursor:pointer;"></i>
                        `;
                    }
                }
            ],
            info: false,
            lengthChange: false

        });

        // ✅ FIX CLICK EVENT
        $('#saleOrderTable tbody').off('click');

        $('#saleOrderTable tbody').on('click', 'td.dt-control', function () {
            let tr = $(this).closest('tr');
            let row = table.row(tr);
            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
                $(this).html('<i class="fa fa-plus"></i>');
            } else {
                row.child(formatDetails(row.data())).show();
                tr.addClass('shown');
                $(this).html('<i class="fa fa-minus"></i>');
            }
        });
    }    
    // EDIT
    $(document).on('click', '.edit', function () {
        let id = $(this).attr('data-id');
        window.location.href = "/UpdateSaleOrderEntry?id=" + encodeURIComponent(id);
    });

    // VIEW
    $(document).on('click', '.view', function () {

        let id = $(this).attr('data-id');

        GetSaleOrderById
    });

    // DELETE
    $(document).on('click', '.delete', function () {
        let id = $(this).data('id');
        console.log("Delete Click:", id);

        Swal.fire({
            title: 'Are you sure?',
            icon: 'warning',
            showCancelButton: true
        }).then((result) => {
            if (result.isConfirmed) {
                deleteSaleOrder(id);
            }
        });
    });
    function deleteSaleOrder(id) {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/DeleteSaleOrder",
            type: "POST",
            data: JSON.stringify({ SaleOrderID: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                let data = res.d;

                if (data.success) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted!',
                        text: 'Sale Order deleted successfully'
                    });

                    loadSaleOrders(); // 🔄 reload table
                }
                else {
                    Swal.fire('Error', data.message, 'error');
                }
            }
        });
    }
</script>



