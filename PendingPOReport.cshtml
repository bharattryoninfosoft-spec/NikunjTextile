                                    <tr style=" background-color: #1273eb;">
                                        <th style="color: white !important;">Sr No</th>
                                        <th style="color: white !important;">PO <br> No</th>
                                        <th style="color: white !important;">PO <br> Date</th>
                                        <th style="color: white !important;">Supplier <br> Name</th>
                                        <th style="color: white !important;">Bill To <br> Name</th>
                                        <th style="color: white !important;">Company <br> Name</th>
                                        <th style="color: white !important;">Godown <br> Details</th>
                                        <th style="color: white !important;">Yarn <br> Material</th>
                                        <th style="color: white !important;">Yarn <br> Color</th>
                                        <th style="color: white !important;">Company <br> Code</th>
                                        <th style="color: white !important;">Qty</th>
                                        <th style="color: white !important;">Pending <br> Qty</th>
                                        <th style="color: white !important;">Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>          
        </div>
    </div>
    <!-- Content wrapper end -->
</div>
