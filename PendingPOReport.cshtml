<script>
    document.title = "Yarn Pending PO - Nikunj Textile";
    $('body').addClass('fullscreen');
</script>

<script>
    var table;
    var table;
    var fullData = [];
    var currentTab = "pending";

    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#Report-tab").addClass("active");
        $("#tab-Report").addClass("show active");
        $("#aPendingPOReport").addClass("current-page");
        $(".nav-tabs .nav-link").removeClass("active");
        $(".nav-tabs .nav-link").attr("aria-selected", "false");
        $(".nav-tabs .nav-link[data-report='1']").addClass("active");
        $(".nav-tabs .nav-link[data-report='1']").attr("aria-selected", "true");          
        FunctionIsLogin();
        LoadReport();

        currentTab = "pending";

        // highlight Pending tab
        $('#poTabs .nav-link').removeClass('active');
        $('#poTabs .nav-link').eq(0).addClass('active');
    });
    var table = $('#tblInward').DataTable();

    table.columns().every(function () {
        var that = this;
        $('input', this.header()).on('keyup change', function () {
            if (that.search() !== this.value) {
                that.search(this.value).draw();
            }
        });
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add Color Matching Form");
        $("#add-alert").hide();

        $("#YarnColor").val('');

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }
    function ValidateDates() {

        let date = $('#dateFrom').val();

        if (!date) {
            Swal.fire({
                icon: 'warning',
                title: 'Please select Date',
                confirmButtonText: 'OK'
            });

            $('#dateFrom').focus();
            return false;
        }

        return true;
    }
    function LoadReport() {

        var formData = new FormData();
        formData.append('DateFrom', $("#dateFrom").val() || "");

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/YarnPendingPOReport',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,

            success: function (response) {

                if (!response || !response.listYarnPOMaster) {
                    table.clear().draw();
                    return;
                }

                // ✅ store full data
                fullData = response.listYarnPOMaster;
                console.log("fullData", fullData);
                populateFilters(fullData);
                // ✅ apply tab filter
                applyTabFilter();
             
            }
        });
    }
    function filterTab(type, el) {

        currentTab = type;

        $('.nav-link').removeClass('active');
        $(el).addClass('active');

        applyTabFilter();
    }
    function applyTabFilter() {

        table.clear();

        let filtered = fullData.filter(x => {

            if (currentTab === "pending") {
                return x.IsComplete === false;   // ✅ only pending
            }
            else {
                return x.IsComplete === true;    // ✅ only complete
            }
        });
        let srno = 1;

        $.each(filtered, function (i, item) {

            let actionBtn = "";

            if (currentTab === "pending") {
                actionBtn = `<button class="btn btn-success btn-sm"
                            onclick="closePO('${item.YarnPODetailID}')">
                            Close
                         </button>`;
            } else {
                actionBtn = `<button class="btn btn-warning btn-sm" style="display:none"
                            onclick="reopenPO('${item.YarnPODetailID}')">
                            Pending
                         </button >`;
            }

            table.row.add([
                srno++,
                item.PONo,
                item.PODates,
                item.SupplierPartyName,
                item.BillToPartyName,
                item.CompanyPartyName,
                item.GodownTitle,
                item.YarnMaterial,
                item.YarnColor,
                item.CompanyCode,
                item.Qty,
                item.PendingQty,
                actionBtn
            ]);
        });

        table.draw();
    }
    function reopenPO(id) {

        Swal.fire({
            title: 'Are you sure?',
            text: "Move this PO back to Pending?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes'
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/ReopenPO',
                    data: JSON.stringify({ id: id }),
                    contentType: "application/json",
                    success: function () {

                        Swal.fire('Updated!', 'PO moved to Pending.', 'success');
                        LoadReport();
                    }
                });
            }
        });
    }
    function closePO(id) {

        Swal.fire({
            title: 'Are you sure?',
            text: "You want to close this PO?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Close it!'
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/ClosePO',
                    data: JSON.stringify({ id: id }),
                    contentType: "application/json",
                    success: function (res) {

                        Swal.fire('Closed!', 'PO closed successfully.', 'success');

                        LoadReport(); // reload data
                    }
                });

            }
        });
    }
    var table = $('#tblPendingPO').DataTable({
        dom: 'Bfrtip',

        scrollX: true,        // 🔥 horizontal scroll
        autoWidth: false,
        responsive: false,    // ❗ MUST disable

        buttons: [
            {
                extend: 'pdf',
                text: '<i class="fa fa-file-pdf-o"></i> PDF',
                orientation: 'landscape',
                pageSize: 'A4',
                title: 'Yarn Pending PO',
                className: 'btn btn-danger',

                exportOptions: {
                    columns: ':not(:last-child)' // 👈 remove button column
                },

                customize: function (doc) {

                    doc.content[0].alignment = 'center';
                    doc.content[0].fontSize = 14;
                    doc.content[0].bold = true;

                    var table = doc.content[1].table;

                    // 🔥 AUTO WIDTH FIX
                    var colCount = table.body[0].length;
                    table.widths = Array(colCount).fill('*');

                    doc.defaultStyle.fontSize = 7;
                    doc.pageMargins = [10, 30, 10, 10];

                    doc.styles.tableHeader = {
                        fillColor: '#2d4154',
                        color: 'white',
                        alignment: 'center',
                        bold: true,
                        fontSize: 8
                    };
                }
            },
            {
                extend: 'excel',
                text: '<i class="fa fa-file-excel-o"></i> Excel',
                className: 'btn btn-success'
            },
            {
                extend: 'print',
                text: '<i class="fa fa-print"></i> Print',
                className: 'btn btn-primary'
            }
        ],

        order: [[1, "desc"]], // 👈 PO column DESC

        columnDefs: [
            {
                targets: -1,
                orderable: false,
                searchable: false
            }
        ]
    });
    function populateFilters(data) {
        console.log("populateFilters", data);

        fillDropdown("#filterPONo", data.map(x => x.PONo), "All PO No");

        fillDropdown("#filterSupplier", data.map(x => x.SupplierPartyName), "All Supplier");

        fillDropdown("#filterBillTo", data.map(x => x.BillToPartyName), "All BillTo");

        fillDropdown("#filterCompany", data.map(x => x.CompanyPartyName), "All Company");

        fillDropdown("#filterGodown", data.map(x => x.GodownTitle), "All Godown");

        fillDropdown("#filterMaterial", data.map(x => x.YarnMaterial), "All Material");

        fillDropdown("#filterColor", data.map(x => x.YarnColor), "All Color");

        fillDropdown("#filterCompanyCode", data.map(x => x.CompanyCode), "All Company Code");
    }
    function fillDropdown(selector, list, placeholder) {

        let unique = [...new Set(list.filter(x => x && x !== "0"))];

        let ddl = $(selector);
        ddl.empty();

        // ✅ Default option
        ddl.append(`<option value="">${placeholder}</option>`);

        unique.sort().forEach(val => {
            ddl.append(`<option value="${val}">${val}</option>`);
        });

        ddl.trigger('change'); // for select2 / refresh
    }
    $('#filterPONo').on('change', function () {
        table.column(1).search(this.value).draw();
    });
    $('#filterSupplier').on('change', function () {
        let val = $(this).val();
        table.column(3).search(val ? val.join('|') : '', true, false).draw();
    });
    $('#filterBillTo').on('change', function () {
        table.column(4).search(this.value).draw();
    });
    $('#filterCompany').on('change', function () {
        table.column(5).search(this.value).draw();
    });
    $('#filterGodown').on('change', function () {
        table.column(6).search(this.value).draw();
    });
    $('#filterMaterial').on('change', function () {
        let val = $(this).val();
        table.column(7).search(val ? val.join('|') : '', true, false).draw();
    });
    $('#filterColor').on('change', function () {
        let val = $(this).val();
        table.column(8).search(val ? val.join('|') : '', true, false).draw();
    });
    $('#filterCompanyCode').on('change', function () {
        table.column(9).search(this.value).draw();
    });
    $('#dateFrom').on('change', function () {
        LoadReport(); // reload from server with date filter
    });
    function ResetFilters() {

        $('#dateFrom').val(""); 

        // ✅ Reset ALL dropdowns
        $('#filterPONo').val("").trigger('change');
        $('#filterSupplier').val(null).trigger('change');
        $('#filterBillTo').val("").trigger('change');
        $('#filterCompany').val("").trigger('change');
        $('#filterGodown').val("").trigger('change');
        $('#filterMaterial').val(null).trigger('change');
        $('#filterColor').val(null).trigger('change');
        $('#filterCompanyCode').val("").trigger('change');

        // ✅ Reset DataTable search
        table.search('').columns().search('').draw();

        // ✅ OPTIONAL: reload original data from server
        LoadReport();
    }
    $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

        let selectedDate = $('#dateFrom').val(); // yyyy-MM-dd
        let tableDate = data[2]; // PO Date column (dd-MM-yyyy)

        if (!selectedDate) return true;

        // convert input → dd-MM-yyyy
        let parts = selectedDate.split("-");
        let formattedInput = parts[2] + "-" + parts[1] + "-" + parts[0];

        return tableDate === formattedInput;
    });
</script>



