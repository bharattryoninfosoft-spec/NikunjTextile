        function highlightMatchedYarnRows() {

            if (!isPendingAvailable) {
                $("#tableYarnOutward tbody tr").show().removeClass("table-success");
                return;
            }
            let hasMatch = false;
            $("#tableYarnOutward tbody tr").each(function () {
                let row = $(this);
                let key = row.find(".txtStockInput").data("key");

                if (pendingItemWise[key]) {
                    hasMatch = true;
                    row.show().addClass("table-success");
                } else {
                    row.hide();
                }
            });

            if (!hasMatch) {
                $("#tableYarnOutward tbody").html(
                    '<tr><td colspan="8">No Matching Data</td></tr>'
                );
            }
