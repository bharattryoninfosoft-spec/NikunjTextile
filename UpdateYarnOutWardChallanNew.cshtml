        function applyCheckboxVisibility() {

            let outwardMap = {};

            // 👉 Outward table keys
            $(".txtStockInput").each(function () {
                let key = $(this).data("key");
                if (key) outwardMap[key] = true;
            });

            let tbody = $("#pendingYarnTable tbody");

            let matchedRows = [];
            let unmatchedRows = [];

            // 👉 Loop pending rows
            tbody.find("tr").each(function () {

                let row = $(this);
                let checkbox = row.find(".row-checkbox");
                let key = checkbox.data("key");

                if (outwardMap[key]) {

                    // ✅ enable
                    checkbox.prop("disabled", false);

                    matchedRows.push(row); // 👉 store for top

                } else {

                    // ❌ disable
                    checkbox.prop("disabled", true);
                    checkbox.prop("checked", false);

                    unmatchedRows.push(row); // 👉 store for bottom
                }
            });

            // 🔥 Reorder rows (matched first)
            tbody.empty();

            matchedRows.forEach(r => tbody.append(r));
            unmatchedRows.forEach(r => tbody.append(r));
        }
