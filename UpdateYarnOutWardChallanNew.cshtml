    function createKey(materialId, colorId, locationId) {
        return `${materialId}|${colorId}|${normalize(locationId)}`;
    }
    function GridBindData() {

        let GodownID = $("#ddlGodownMaster").val() || 0;
        if (GodownID == "0") return;

        let formData = new FormData();
        formData.append('GodownID', GodownID);
        formData.append('BillToPartyID', $("#ddlYarnCompany").val() || 0);
        formData.append('YarnMaterialID', $("#ddlYarnMaterial").val() || 0);
        formData.append('YarnColorID', $("#ddlYarnColor").val() || 0);

        let locationVal = $("#siftGodownInputBox").val() || "";
        formData.append('SiftGodownLocationId', locationVal.slice(0, -1).replace(/\|/g, ','));

        let tbody = $("#tableYarnOutward tbody");
        tbody.html('<tr><td colspan="8" class="text-center">Loading...</td></tr>');

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getUpdateYarnOutwardMasterNew',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,

            success: function (response) {

                let data = response.listYarnOutwardMaster || [];
                tbody.empty();
                console.log("data", data)
                if (data.length === 0) {
                    tbody.html('<tr><td colspan="8" class="text-center">No Data Found</td></tr>');
                    return;
                }
               
                let rows = data.map((row, index) => {
                    let key = createKey(row.YarnMaterialID,row.YarnColorID,row.YarnColorCode);                  
                    return `

                <tr>
                    <td>${index + 1}</td>
                    <td>${row.CompanyName}</td>
                    <td>${row.YarnMaterial}</td>
                    <td>${row.YarnColor}</td>
                    <td>${row.YarnColorCode}</td>
                    <td class="stock">${row.Stock}</td>
                    <td>${row.LocationTitle}</td>
                    <td>
                        <input type="text"
                            class="txtStockInput"
                            value="0"
                            data-key="${key}"
                            data-stock="${row.Stock}"
                            data-locationid="${row.GodownLocationID}"
                            maxlength="2"
                            onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                    </td>
                </tr>`;
                    
                });
              
                tbody.html(rows.join(""));

                highlightMatchedYarnRows();
            },

            error: function () {
                tbody.html('<tr><td colspan="8" class="text-danger text-center">Error loading data</td></tr>');
            }
        });
    }
    function getPendingYarnForm(PartyId, YarnMaterialID, YarnColorID) {

        let tbody = $("#pendingYarnTable tbody");

        tbody.html('<tr><td colspan="7" class="text-center">Loading...</td></tr>');

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetPendingYarn",
            type: "POST",
            contentType: "application/json; charset=utf-8",

            // ✅ Send all parameters
            data: JSON.stringify({
                partyId: PartyId,
                yarnMaterialID: YarnMaterialID,
                yarnColorID: YarnColorID
            }),

            success: function (res) {
                let data = res.d;
                //console.log("GetPendingYarnDetails", data)
                if (typeof data === "string") {
                    data = JSON.parse(data);
                }

                tbody.html("");

                if (!data || data.length === 0) {
                    tbody.append('<tr><td colspan="7" class="text-center">No Data Found</td></tr>');
                    return;
                }

                let ddl = $("#ddlYarnPREQ");
                ddl.empty();
                ddl.append('<option value="-1">Yarn Pending Requirement</option>');
                let grouped = {};
                $.each(data, function (i, item) {

                    if (!grouped[item.YarnRequirementID]) {
                        grouped[item.YarnRequirementID] = {
                            YarnRequirementID: item.YarnRequirementID,
                            PartyName: item.PartyName,
                            RequirementNo: item.RequirementNo,
                            RequirementDate: item.RequirementDate,
                            TotalBoxes: 0   // ✅ MUST initialize
                        };
                    }

                    // agar NoofBoxes nahi hai to 0 lo
                    grouped[item.YarnRequirementID].TotalBoxes += (item.NoofBoxes || 0);
                });
                $.each(grouped, function (key, item) {

                    let formattedDate = formatJsonDate(item.RequirementDate);

                    ddl.append(`
                      <option value="${item.YarnRequirementID}">
                           ReqNo = ${item.RequirementNo} | ${item.PartyName} | ${formattedDate}
                      </option>
                  `);
                });
            },

            error: function (err) {
                //console.log(err);
                tbody.html('<tr><td colspan="7" class="text-danger text-center">Error loading data</td></tr>');
            }
        });
    }
    function getPendingYarnDetails(YarnRequirementID) {

        let tbody = $("#pendingYarnTable tbody");

        tbody.html('<tr><td colspan="7" class="text-center">Loading...</td></tr>');

        // 🔥 RESET
        pendingDetailMap = {};
        pendingItemWise = {};
        isPendingAvailable = false;

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetUpdatePendingYarnDetails",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ YarnRequirementID: YarnRequirementID }),

            success: function (res) {

                let data = res.d;

                if (typeof data === "string") {
                    data = JSON.parse(data);
                }

                tbody.empty();

                if (!data || data.length === 0) {

                    isPendingAvailable = false;
                    tbody.html('<tr><td colspan="7">No Data Found</td></tr>');
                    $("#tableYarnOutward tbody tr").show();
                    return;
                }

                isPendingAvailable = true;

                $.each(data, function (i, item) {

                    tbody.append(`
                    <tr>
                        <td>${item.PartyName}</td>
                        <td>${item.YarnMaterial}</td>
                        <td>${item.YarnColor}</td>
                        <td>${item.CompanyColourCode}</td>
                        <td>${item.NoofBoxes}</td>
                    </tr>
                `);

                    let key =
                        item.YarnMaterialID + "|" +
                        item.YarnColorID + "|" +
                        normalize(item.CompanyColourCode);

                    pendingDetailMap[key] = item.YarnRequirementDetailID;

                    if (!pendingItemWise[key]) {
                        pendingItemWise[key] = 0;
                    }

                    pendingItemWise[key] += (parseInt(item.NoofBoxes) || 0);
                    console.log("item", item)
                });
                
                console.log("pendingItemWise", pendingItemWise);
                setTimeout(() => {
                    highlightMatchedYarnRows();
                }, 500);
            }
        });
    }
    function highlightMatchedYarnRows() {

        let rows = $("#tableYarnOutward tbody tr");

        if (!isPendingAvailable) {
            rows.show().removeClass("table-success");
            return;
        }

        let hasMatch = false;

        rows.each(function () {

            let row = $(this);
            let key = row.find(".txtStockInput").data("key");

            if (pendingItemWise[key]) {
                hasMatch = true;
                row.show().addClass("table-success");
            } else {
                row.hide();
            }
        });

        if (!hasMatch) {
            $("#tableYarnOutward tbody")
                .html('<tr><td colspan="8">No Matching Data</td></tr>');
        }
    }
    function editYarnOutward(id) {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetYarnOutwardForEdit",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ YarnOutwardID: id }),

            success: function (res) {

                let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;

                if (result.Status != 1) {
                    alert(result.Message);
                    return;
                }

                let master = result.Data.Master;
                let detail = result.Data.Detail;
                let YarnRequirementIDs = result.YarnRequirementIDs;
                console.log("master", master);
                // Fill master
                $("#ddlParty").val(master.PartyId).trigger("change");
                $("#ListDate").val(formatJsonDate(master.OutwardListDate));
                $("#ddlYarnGodownManager").val(master.GodownManagerUserAccountId).trigger("change");
                $("#ListNo").val(master.OutwardListNo);
                $("#YarnOutwardID").val(master.YarnOutwardID);

                // Create map
                let map = {};
                detail.forEach(d => {
                    let key = `${d.YarnMaterialID}|${d.YarnColorID}|${d.YarnColorCode}|${d.GodownLocationID}`;
                    map[key] = d.NoOfBox;                 
                });
              
                console.log("map", map);        
                debugger;
                setTimeout(() => {
                    $(".txtStockInput").each(function () {

                        let input = $(this);

                        let key = (input.data("key") + "|" + input.data("locationid"));
                        let stock = Number(input.data("stock")) || 0;

                        if (map[key] !== undefined) {
                            let editable = Number(map[key]);
                            input.val(editable);
                        } else {
                            input.val(0);                            
                        }
                    });

                }, 300); // ⛔ still using timeout, but controlled

                // Requirement dropdown
                if (YarnRequirementIDs?.length > 0) {

                    let val = parseInt(YarnRequirementIDs[0]) || 0;

                    setTimeout(() => {
                        $("#ddlYarnPREQ").val(val).trigger("change.select2");
                        $("#ddlYarnPREQ").prop("disabled", true);
                        $("#ddlParty").prop("disabled", true);
                        getPendingYarnDetails(val);
                    }, 400);
                }
            }
        });
    }
    function saveYarnOutward() {
        // 🔥 Get ID (important for update)
        let yarnOutwardID = parseInt($("#YarnOutwardID").val()) || 0;

        // 1. Get Values
        let partyId = parseInt($("#ddlParty").val()) || 0;
        let listNo = $("#ListNo").val();
        let listDate = $("#ListDate").val();
        let godownManager = parseInt($("#ddlYarnGodownManager").val()) || 0;
        let godownId = parseInt($("#ddlGodownMaster").val()) || 0;

        // 2. Validation
        if (partyId === 0) {
            notes.show("Please Select Sundry Creditors Party.", { type: 'danger' });
            return;
        }
        if (!listNo) {
            notes.show("Please Mention List No.", { type: 'danger' });
            return;
        }
        if (!listDate) {
            notes.show("Please Mention List Date.", { type: 'danger' });
            return;
        }
        if (godownManager === 0) {
            notes.show("Please Select Godown Manager.", { type: 'danger' });
            return;
        }
        let rawDate = $("#ListDate").val();
        let formattedDate = "";

        // Case 1: dd/MM/yyyy
        if (rawDate.includes("/")) {
            let parts = rawDate.split("/");
            formattedDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
        }
        // Case 2: dd-MM-yyyy
        else if (rawDate.includes("-") && rawDate.split("-")[0].length === 2) {
            let parts = rawDate.split("-");
            formattedDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
        }
        // Case 3: already yyyy-MM-dd
        else {
            formattedDate = rawDate;
        }
        // 3. Build Detail List
        let detailList = [];

        $("#tableYarnOutward tbody tr:visible").each(function () {

            let input = $(this).find(".txtStockInput");
            let qty = parseInt(input.val()) || 0;

            if (qty > 0) {

                let key = input.data("key"); // "MaterialID|ColorID"

                detailList.push({
                    BillToPartyID: partyId,
                    YarnMaterialID: parseInt(key.split("|")[0]),
                    YarnColorID: parseInt(key.split("|")[1]),
                    GodownLocationID: parseInt(input.data("locationid")),
                    NoOfBox: qty,
                    YarnRequirementDetailID:
                        (typeof pendingDetailMap !== 'undefined')
                            ? (pendingDetailMap[key] || 0)
                            : 0
                });
            }
        });

        if (detailList.length === 0) {
            notes.show("Enter at least one quantity value", { type: 'danger' });
            return;
        }

        // 4. Master Object
        let master = {
            YarnOutwardID: yarnOutwardID,   // 🔥 important
            GodownID: godownId,
            PartyId: partyId,
            OutwardListDate: formattedDate,
            GodownManagerUserAccountId: godownManager
        };

        // 🔥 Decide API (Save / Update)
        let url = (yarnOutwardID > 0)
            ? "/WebServiceNikunjTextile.asmx/UpdateYarnOutward"
            : "/WebServiceNikunjTextile.asmx/SavedataYarnOutward";

        // 5. AJAX
        $.ajax({
            url: url,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify({
                master: master,
                detail: detailList
            }),
            success: function (res) {

                let result = (typeof res.d === "string") ? JSON.parse(res.d) : res.d;
                let data = Array.isArray(result) ? result[0] : result;

                if (data && data.Status == 1) {

                    notes.show(data.Message, { type: 'success' });

                    setTimeout(function () {
                        window.location.href = 'YarnOutWardChallanDetails';
                    }, 1500);

                } else {
                    notes.show(data.Message || "Error saving data", { type: 'danger' });
                }
            },
            error: function (xhr) {
                console.error(xhr.responseText);
                notes.show("Critical Server Error. Check console.", { type: 'danger' });
            }
        });
    }
