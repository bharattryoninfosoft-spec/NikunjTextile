    $(document).on("change", "#ddlYarnPREQ", function () {
        let tbody = $("#tableYarnOutward tbody");
        tbody.empty();
        GridBindData();
        let YarnRequirementID = $(this).val();
        // ❌ No selection / default
        if (!YarnRequirementID || YarnRequirementID === "-1") {

            // 🔥 RESET EVERYTHING
            isPendingAvailable = false;
            pendingItemWise = {};
            pendingDataGlobal = [];

            $("#pendingYarnTable tbody").html(
                '<tr><td colspan="7" class="text-center">No Data</td></tr>'
            );

            // ✅ Important: show all rows again
            $("#tableYarnOutward tbody tr").show();

            return;
        }     
        // ✅ Load pending data
        getPendingYarnDetails(YarnRequirementID);

    });

    $(document).on("focus", ".txtStockInput", function () {
        $(this).data("old", parseInt($(this).val()) || 0);
    });

    $(document).on("input", ".txtStockInput", function () {

        let input = $(this);

        let stock = parseInt(input.data("stock")) || 0;
        let newVal = parseInt(input.val()) || 0;
        let oldVal = input.data("old") || 0;

        let key = normalize(input.data("key"));

        // ❌ NO PENDING → STOCK RULE
        if (!isPendingAvailable) {

            if (newVal > stock) {
                input.val(stock);
                notes.show("Cannot exceed stock (" + stock + ")", { type: 'danger' });
                return;
            }

            input.data("old", newVal);
            return;
        }

        // ✅ PENDING MODE

        let maxAllowed = parseInt(pendingItemWise[key]) || 0;

        let total = 0;

        $(".txtStockInput").each(function () {

            let loopKey = normalize($(this).data("key"));

            if (loopKey === key) {

                let val = parseInt($(this).val()) || 0;

                if (this === input[0]) {
                    val = newVal;
                }

                total += val;
            }
        });

        // ❌ EXCEED PENDING
        if (total > maxAllowed) {

            input.val(oldVal);

            notes.show(
                "Max allowed for this item: " + maxAllowed,
                { type: 'danger' }
            );

        } else {

            // ✅ OPTIONAL: also check stock per row
            if (newVal > stock) {
                input.val(stock);
                notes.show("Cannot exceed stock (" + stock + ")", { type: 'danger' });
                return;
            }

            input.data("old", newVal);
        }
    });

    function formatJsonDate(jsonDate) {

        if (!jsonDate) return "";

        let timestamp = parseInt(jsonDate.replace(/[^0-9]/g, ''));
        let date = new Date(timestamp);

        let day = ("0" + date.getDate()).slice(-2);
        let month = ("0" + (date.getMonth() + 1)).slice(-2);
        let year = date.getFullYear();

        return `${day}-${month}-${year}`;
    }
