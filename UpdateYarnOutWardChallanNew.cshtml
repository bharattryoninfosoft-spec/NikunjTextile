@{
    Layout = "/_LayoutPage1.cshtml";
}

<style>
    #tableYarnOutward th {
        font-size: 13px;
        font-weight: 600;
        vertical-align: middle !important;
        white-space: nowrap;
        background-color: #f1f4f8;
        border-bottom: 2px solid #dee2e6;
    }
    #tableYarnOutward td {
        font-size: 13px;
        vertical-align: middle !important;
    }
    #tableYarnOutward .txtStockInput {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 4px;
        transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }
    #tableYarnOutward .txtStockInput:focus {
        border-color: #80bdff;
        outline: 0;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, .25);
        background-color: #fffde7;
    }
    #tableYarnOutward tr.table-success td {
        background-color: #e8f5e9 !important;
    }
    .select2-container--default .select2-selection--single {
        height: 38px;
        border: 1px solid #e1e6f0;
        border-radius: 4px;
        /* display: flex; */
        align-items: center;
    }
</style>

<div class="content-wrapper">
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Yarn Outward List</div>
                    <input type="text" id="YarnOutwardID" hidden>
                    <div id="notes"></div>

                    <!-- Top Section: Filters (Left) & Pending Table (Right) -->
                    <div class="row gutters pb-3 mb-3 border-bottom">
                        <!-- Left: Form Controls -->
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <!-- Row 1: ListNo, ListDate, GodownManager, PartyType -->
                            <div class="row gutters">
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-6">
                                    <div class="field-wrapper">
                                        <input type="text" class="form-control" id="ListNo" placeholder="List No" value="1" readonly />
                                        <div class="field-placeholder">List No<sup style="color:red;">*</sup></div>
                                        <div class="ListNo-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ListNo-invalid-feedback invalid-feedback">Please Mention List No</div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-6">
                                    <div class="field-wrapper">
                                        <input type="text" class="form-control datepicker" id="ListDate" placeholder="List Date" value="" />
                                        <div class="field-placeholder">List Date<sup style="color:red;">*</sup></div>
                                        <div class="ListDate-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ListDate-invalid-feedback invalid-feedback">Please Mention List Date</div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnGodownManager" class="select-single detail form-control" title="Select Yarn Godown Manager" data-live-search="true">
                                            <option value="-1">Yarn Godown Manager</option>
                                        </select>
                                        <div class="field-placeholder">Godown Manager<sup style="color:red;">*</sup></div>
                                        <div class="ddlYarnGodownManager-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ddlYarnGodownManager-invalid-feedback invalid-feedback">Please Select Godown Manager</div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="SundryParty" class="form-control" name="SundryParty" onchange="changeSundryParty(this.value)">
                                            <option value="1">Sundry Creditors</option>
                                            <option value="2">Sundry Debtors</option>
                                            <option value="3">Job Work</option>
                                        </select>
                                        <div class="field-placeholder">Party Type</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 2: Godown, Party, YarnCompany -->
                            <div class="row gutters">
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlGodownMaster" class="select-single detail form-control" title="Select Godown Master" data-live-search="true" onchange="ChangeGodownMaster()">
                                            <option value="-1">Select Godown</option>
                                        </select>
                                        <div class="field-placeholder">Select Godown<sup style="color:red;">*</sup></div>
                                        <div class="ddlGodownMaster-valid-feedback valid-feedback"></div>
                                        <div class="ddlGodownMaster-invalid-feedback invalid-feedback">Please Select Godown</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlParty" class="select-single detail form-control" title="Select Party" data-live-search="true">
                                            <option value="-1">Select Party</option>
                                        </select>
                                        <div class="field-placeholder">Sundry Party<sup style="color:red;">*</sup></div>
                                        <div class="ddlParty-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ddlParty-invalid-feedback invalid-feedback">Please Select Sundry Creditors Party</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnCompany" class="select-single detail form-control" title="Select Yarn Company" data-live-search="true" onchange="GridBindData()">
                                            <option value="-1">Select Yarn Company</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Company</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 3: YarnMaterial, YarnColor, YarnColorCode -->
                            <div class="row gutters">
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnMaterial" class="select-single detail form-control" title="Select Yarn Material" data-live-search="true" onchange="GridBindData();">
                                            <option value="-1">Yarn Material</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Material</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnColor" class="select-single detail form-control" title="Select Yarn Color" data-live-search="true" onchange="ChangeYarnColor(this.value)" multiple>
                                            <option value="-1">Yarn Color</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Color</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnColorCode" class="select-single detail form-control" title="Select Yarn Color Code" data-live-search="true" onchange="ChangeYarnColorCode(this.value)" multiple>
                                            <option value="-1">Yarn Color Code</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Color Code</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Pending Yarn Table -->
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12" style="border-left: 1px solid #dee2e6;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fa fa-list-alt me-1"></i> Pending Yarn Requirements
                                </h6>
                            </div>
                            <div class="col-12" hidden>
                                <div class="field-wrapper">
                                    <select id="ddlYarnPREQ" class="select-single detail form-control" title="Select Yarn Pending Requirement" data-live-search="true">
                                        <option value="-1">Yarn Pending Requirement</option>
                                    </select>
                                    <div class="field-placeholder">Yarn Pending Requirement</div>
                                    <div class="ddlYarnPREQ-valid-feedback valid-feedback">Looks good!</div>
                                    <div class="ddlYarnPREQ-invalid-feedback invalid-feedback">Please Select Yarn Pending Requirement</div>
                                </div>
                            </div>
                            <div class="table-responsive border rounded" style="max-height: 250px; overflow-y: auto;">
                                <table class="table table-bordered table-striped table-hover align-middle mb-0" id="pendingYarnTable">
                                    <thead style="background-color: #f1f4f8; position: sticky; top: 0; z-index: 2;">
                                        <tr class="text-center align-middle">
                                            <th style="width: 125px;">Select / Req</th>
                                            <th class="text-left" style="min-width: 120px;">Party</th>
                                            <th class="text-left" style="min-width: 110px;">Yarn Material</th>
                                            <th class="text-left" style="min-width: 100px;">Yarn Color</th>
                                            <th style="width: 100px;">Color Code</th>
                                            <th style="width: 110px;">No of Boxes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">Select Party to view pending requirements</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Section: Stock Outward Table -->
                    <div class="row gutters mt-3">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fa fa-cubes me-1"></i> Available Godown Stock & Outward Allocation
                                </h6>
                            </div>
                            <input type="hidden" id="siftYarnInwardDetailID" class="form-control" placeholder="Yarn Inward DetailI D" title="YarnInwardDetailID" />
                            <input type="hidden" id="siftGodownInputBox" class="form-control" placeholder="Godown Input Box" title="Godown Input Box" />
                            <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto;">
                                <table id="tableYarnOutward" class="table table-bordered table-striped table-hover align-middle mb-0">
                                    <thead style="position: sticky; top: 0; z-index: 2; background-color: #f8f9fa;">
                                        <tr class="text-center align-middle">
                                            <th style="width: 50px;">#</th>
                                            <th class="text-left" style="min-width: 170px;">Company Name</th>
                                            <th class="text-left" style="min-width: 140px;">Yarn Material</th>
                                            <th class="text-left" style="min-width: 120px;">Yarn Color</th>
                                            <th style="width: 110px;">Color Code</th>
                                            <th style="width: 130px;">Stock (Boxes)</th>
                                            <th class="text-left" style="min-width: 130px;">Location Title</th>
                                            <th style="width: 140px;">No Of Box(Editable)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-3">Select Godown to load available yarn stock</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-end mt-3">
                        <a href="YarnOutWardChallanDetails" class="btn btn-light me-2">
                            <i class="fa fa-arrow-left"></i> Back
                        </a>

                        <button id="savebtn" class="btn btn-primary" onclick="saveYarnOutward()">
                            Save Yarn OutWard
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $('body').addClass('fullscreen');

        let globalYarnMap = {};
        let pendingDetailMap = {};
        let pendingItemWise = {};
        let isPendingAvailable = false;
        let isColorLoaded = false;
        let isSubmitting = false;
        let isLoadingForEdit = false;

        function normalize(val) {
            return (val || "").toString().toUpperCase().trim();
        }

        function formatJsonDate(jsonDate) {
            if (!jsonDate) return "";
            if (typeof jsonDate === "string" && jsonDate.indexOf("/Date(") > -1) {
                let timestamp = parseInt(jsonDate.replace(/[^0-9]/g, ''));
                let date = new Date(timestamp);
                let day = ("0" + date.getDate()).slice(-2);
                let month = ("0" + (date.getMonth() + 1)).slice(-2);
                let year = date.getFullYear();
                return `${day}-${month}-${year}`;
            }
            if (typeof jsonDate === "string" && jsonDate.indexOf("T") > -1) {
                let date = new Date(jsonDate);
                let day = ("0" + date.getDate()).slice(-2);
                let month = ("0" + (date.getMonth() + 1)).slice(-2);
                let year = date.getFullYear();
                return `${day}-${month}-${year}`;
            }
            return jsonDate;
        }

        function formatDateToISO(dateStr) {
            if (!dateStr) return null;
            if (dateStr.includes("/")) {
                let parts = dateStr.split("/");
                if (parts.length !== 3) return null;
                let day = parts[0].padStart(2, '0');
                let month = parts[1].padStart(2, '0');
                let year = parts[2];
                return `${year}-${month}-${day}`;
            }
            if (dateStr.includes("-")) {
                let parts = dateStr.split("-");
                if (parts[0].length === 4) return dateStr;
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            return dateStr;
        }

        $(document).ready(function () {
            FunctionIsLogin();

            $("#select2-ddlGodownMaster-container").css({ "background-color": "cornflowerblue", "color": "white" });
            $('#ddlGodownMaster').next('.select2-container').find('.select2-selection__arrow b').css({
                'border-color': '#fff transparent transparent transparent'
            });

            $("#select2-ddlParty-container").css({ "background-color": "lightslategrey", "color": "white" });
            $('#ddlParty').next('.select2-container').find('.select2-selection__arrow b').css({
                'border-color': '#fff transparent transparent transparent'
            });

            $("#select2-ddlYarnGodownManager-container").css({ "background-color": "cornflowerblue", "color": "white" });
            $('#ddlYarnGodownManager').next('.select2-container').find('.select2-selection__arrow b').css({
                'border-color': '#fff transparent transparent transparent'
            });

            GetAllDropDownData();
        });

        $("#ddlGodownMaster, #ddlYarnCompany, #ddlYarnMaterial").on("change", function () {
            if (isLoadingForEdit) return;
            isColorLoaded = false;
            GridBindData();
        });

        $("#ddlParty, #ddlYarnMaterial, #ddlYarnColor").on("change", function () {
            if (isLoadingForEdit) return;
            var PartyId = $("#ddlParty").val();
            var YarnMaterialID = $("#ddlYarnMaterial").val() || 0;
            var YarnColorID = $("#ddlYarnColor").val() || 0;
            if (PartyId && PartyId != "0") {
                loadAllYarnData(PartyId, YarnMaterialID, YarnColorID);
            }
        });

        $(document).on("focus", ".txtStockInput", function () {
            $(this).data("old", parseInt($(this).val()) || 0);
        });

        $(document).on("input", ".txtStockInput", function () {
            let input = $(this);
            let stock = parseInt(input.data("stock")) || 0;
            let newVal = parseInt(input.val()) || 0;
            let oldVal = input.data("old") || 0;
            let key = normalize(input.data("key"));

            if (!isPendingAvailable) {
                if (newVal > stock) {
                    input.val(stock);
                    Swal.fire({ icon: 'error', title: 'Limit Exceeded', text: "Cannot exceed stock (" + stock + ")" });
                    return;
                }
                input.data("old", newVal);
                return;
            }

            let matId = parseInt(key.split("|")[0]) || 0;
            let colId = parseInt(key.split("|")[1]) || 0;
            let shortKey = (matId > 0 && colId > 0) ? `${matId}|${colId}` : "";
            let maxAllowed = parseInt(pendingItemWise[key]) || parseInt(pendingItemWise[shortKey]) || 0;
            let total = 0;

            $(".txtStockInput").each(function () {
                let loopKey = normalize($(this).data("key"));
                let loopMat = parseInt(loopKey.split("|")[0]) || 0;
                let loopCol = parseInt(loopKey.split("|")[1]) || 0;
                let loopShortKey = (loopMat > 0 && loopCol > 0) ? `${loopMat}|${loopCol}` : "";
                if (loopKey === key || (shortKey !== "" && loopShortKey === shortKey)) {
                    let val = parseInt($(this).val()) || 0;
                    if (this === input[0]) {
                        val = newVal;
                    }
                    total += val;
                }
            });

            if (maxAllowed > 0 && total > maxAllowed) {
                input.val(oldVal);
                Swal.fire({
                    icon: 'error',
                    title: 'Limit Exceeded',
                    text: "Max allowed for this item: " + maxAllowed
                });
                return;            
            } else {
                if (newVal > stock) {
                    input.val(stock);
                    Swal.fire({ icon: 'error', title: 'Limit Exceeded', text: "Cannot exceed stock (" + stock + ")" });
                    return;
                }
                input.data("old", newVal);
            }
        });

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                }
            });
        }

        function GetAllDropDownData() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutWardDropDownData',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        // Party Name
                        if (response.listPartyMaster.length > 0) {
                            $('#ddlParty').empty().append("<option value='0'> Select Party </option>");
                            for (var i = 0; i < response.listPartyMaster.length; i++) {
                                $('#ddlParty').append("<option value='" + response.listPartyMaster[i].PartyId + "'> " + response.listPartyMaster[i].PartyName + " </option>");
                            }
                        }

                        // Company Name
                        if (response.listCompanyMaster.length > 0) {
                            $('#ddlYarnCompany').empty().append("<option value='0'> Select Company </option>");
                            for (var i = 0; i < response.listCompanyMaster.length; i++) {
                                $('#ddlYarnCompany').append("<option value='" + response.listCompanyMaster[i].PartyId + "'> " + response.listCompanyMaster[i].PartyName + " </option>");
                            }
                        }

                        // Yarn Material
                        if (response.listYarnMaterialMaster.length > 0) {
                            $('#ddlYarnMaterial').empty().append("<option value='0'> Select Yarn Material </option>");
                            for (var i = 0; i < response.listYarnMaterialMaster.length; i++) {
                                $('#ddlYarnMaterial').append("<option value='" + response.listYarnMaterialMaster[i].YarnMaterialID + "'> " + response.listYarnMaterialMaster[i].YarnMaterial + " </option>");
                            }
                        }

                        // Yarn Color
                        if (response.listYarnColorMaster.length > 0) {
                            $('#ddlYarnColor').empty().append("<option value='0'> Select Yarn Color </option>");
                            $('#ddlYarnColorCode').empty().append("<option value='0'> Yarn Color Code</option>");
                            for (var i = 0; i < response.listYarnColorMaster.length; i++) {
                                $('#ddlYarnColor').append("<option value='" + response.listYarnColorMaster[i].YarnColorID + "'> " + response.listYarnColorMaster[i].YarnColor + " </option>");
                                $('#ddlYarnColorCode').append("<option value='" + response.listYarnColorMaster[i].YarnColorID + "'> " + response.listYarnColorMaster[i].YarnColorCode + " </option>");
                            }
                        }

                        // Godown Manager
                        if (response.listUserAccountMaster.length > 0) {
                            $('#ddlYarnGodownManager').empty().append("<option value='0'> Select Godown Manager </option>");
                            for (var i = 0; i < response.listUserAccountMaster.length; i++) {
                                $('#ddlYarnGodownManager').append("<option value='" + response.listUserAccountMaster[i].UserAccountId + "'> " + response.listUserAccountMaster[i].UserAccountName + " </option>");
                            }
                        }

                        // Godown Master
                        if (response.listGodownMaster.length > 0) {
                            $('#ddlGodownMaster').empty().append("<option value='0'> Select Godown </option>");
                            for (var i = 0; i < response.listGodownMaster.length; i++) {
                                let isSel = response.listGodownMaster[i].IsDefault == "1" ? " selected" : "";
                                $('#ddlGodownMaster').append("<option value='" + response.listGodownMaster[i].GodownID + "'" + isSel + "> " + response.listGodownMaster[i].GodownTitle + " </option>");
                            }
                        }

                        var id = new URLSearchParams(window.location.search).get('id');
                        if (!id) {
                            var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
                            if (hashes[0] && hashes[0].indexOf('=') > -1) {
                                id = hashes[0].substring(hashes[0].indexOf('=') + 1);
                            }
                        }
                        if (id) {
                            editYarnOutward(id);
                        } else {
                            GridBindData();
                        }
                    }
                }
            });
        }

        function changeSundryParty(sundryVal, callback) {
            var SundryParty = sundryVal || $("#SundryParty").val();
            var formData = new FormData();
            formData.append('SundryParty', SundryParty);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getSundryPartyMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#ddlParty').empty();
                    $('#ddlParty').append("<option value='0'> Select Party </option>");
                    if (response.listPartyMaster && response.listPartyMaster.length > 0) {
                        for (var i = 0; i < response.listPartyMaster.length; i++) {
                            $('#ddlParty').append("<option value='" + response.listPartyMaster[i].PartyId + "'> " + response.listPartyMaster[i].PartyName + " </option>");
                        }
                    }
                    if (callback) callback(response.listPartyMaster);
                },
                error: function () {
                    if (callback) callback([]);
                }
            });
        }

        function ChangeYarnColor(YarnColorID) {
            $("#ddlYarnColorCode").val(YarnColorID);
            var ColorCode = $("#ddlYarnColorCode option:selected").text();
            $("#select2-ddlYarnColorCode-container").html(ColorCode);
            GridBindData();
        }

        function ChangeYarnColorCode(YarnColorID) {
            $("#ddlYarnColor").val(YarnColorID);
            var Color = $("#ddlYarnColor option:selected").text();
            $("#select2-ddlYarnColor-container").html(Color);
            GridBindData();
        }

        function ChangeGodownMaster() {
            GridBindData();
        }

        function GridBindData(callback) {
            var GodownID = $("#ddlGodownMaster").val() || 0;
            var BillToPartyID = $("#ddlYarnCompany").val() || 0;
            var YarnMaterialID = $("#ddlYarnMaterial").val() || 0;
            var YarnColorID = $("#ddlYarnColor").val() || 0;
            var yarnOutwardId = $("#YarnOutwardID").val() || 0;
            var siftSiftGodownLocationId = $("#siftGodownInputBox").val() || "";

            if (GodownID != "0") {
                var formData = new FormData();
                formData.append('GodownID', GodownID);
                formData.append('BillToPartyID', BillToPartyID);
                formData.append('YarnMaterialID', YarnMaterialID);
                formData.append('YarnColorID', YarnColorID);
                formData.append('YarnOutwardID', yarnOutwardId);
                formData.append('SiftGodownLocationId', siftSiftGodownLocationId.slice(0, -1).replace(/\|/g, ','));

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getUpdateYarnOutwardMasterNew',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        let data = response.listYarnOutwardMaster;
                        let tbody = $("#tableYarnOutward tbody");
                        tbody.empty();

                        if (!data || data.length === 0) {
                            tbody.html('<tr><td colspan="8" class="text-center text-muted py-3">No Data Found</td></tr>');
                            if (callback) callback();
                            return;
                        }

                        $.each(data, function (index, row) {
                            let key =
                                row.YarnMaterialID + "|" +
                                row.YarnColorID + "|" +
                                normalize(row.YarnColorCode);

                            let tr = `
                                <tr>
                                    <td class="rowIndex text-center font-weight-bold text-muted">${index + 1}</td>
                                    <td id="CompanyId" hidden>${row.BillToPartyID}</td>
                                    <td>${row.CompanyName}</td>
                                    <td>${row.YarnMaterial}</td>
                                    <td>${row.YarnColor}</td>
                                    <td class="text-center font-weight-bold">${row.YarnColorCode || ''}</td>
                                    <td class="text-center font-weight-bold text-info">${row.Stock}</td>
                                    <td>${row.LocationTitle}</td>
                                    <td class="text-center">
                                        <input type="text" class="txtStockInput form-control form-control-sm text-center font-weight-bold mx-auto" 
                                            value="0" data-key="${key}" data-stock="${row.Stock}"
                                            data-locationid="${row.GodownLocationID}" maxlength="4" style="max-width: 90px; height: 32px;"
                                            onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                                    </td>
                                </tr>
                            `;
                            tbody.append(tr);
                        });

                        if (callback) callback();
                    },
                    error: function () {
                        let tbody = $("#tableYarnOutward tbody");
                        tbody.html('<tr><td colspan="8" class="text-danger text-center py-3">Error loading data</td></tr>');
                        if (callback) callback();
                    }
                });
            } else {
                if (callback) callback();
            }
        }

        function loadAllYarnData(PartyId, YarnMaterialID, YarnColorID, callback) {
            if (typeof PartyId === 'function') {
                callback = PartyId;
                PartyId = null;
            }
            let pId = PartyId !== null && PartyId !== undefined ? PartyId : ($("#ddlParty").val() || 0);
            let mId = YarnMaterialID !== null && YarnMaterialID !== undefined ? YarnMaterialID : ($("#ddlYarnMaterial").val() || 0);
            let cId = YarnColorID !== null && YarnColorID !== undefined ? YarnColorID : ($("#ddlYarnColor").val() || 0);

            GridBindData(function () {
                getPendingYarnForm(pId, mId, cId, function () {
                    if (!isLoadingForEdit) {
                        highlightMatchedYarnRows();
                        applyCheckboxVisibility();
                    }
                    if (callback) callback();
                });
            });
        }

        function getPendingYarnForm(PartyId, YarnMaterialID, YarnColorID, callback) {
            let tbody = $("#pendingYarnTable tbody");
            let pId = parseInt(PartyId, 10) || 0;
            let currentOutwardId = parseInt($("#YarnOutwardID").val(), 10) || 0;
            let sundryVal = parseInt($("#SundryParty").val(), 10) || 1;

            if (pId <= 0 && sundryVal === 3) {
                tbody.html('<tr><td colspan="6" class="text-center text-muted py-3">Select Party to view pending requirements</td></tr>');
                if (callback) callback();
                return;
            }

            tbody.html('<tr><td colspan="6" class="text-center py-3"><i class="fa fa-spinner fa-spin me-1"></i> Loading pending requirements...</td></tr>');

            pendingDetailMap = {};
            pendingItemWise = {};
            isPendingAvailable = false;

            let rawColors = YarnColorID || $('#ddlYarnColor').val() || [];
            if (!Array.isArray(rawColors)) {
                rawColors = [rawColors];
            }
            let validColors = [];
            for (let i = 0; i < rawColors.length; i++) {
                let c = parseInt(rawColors[i], 10) || 0;
                if (c > 0) validColors.push(c);
            }

            let mId = parseInt(YarnMaterialID, 10) || 0;
            let primaryPartyId = (sundryVal === 3 && pId > 0) ? pId : 0;

            function renderPendingData(data) {
                tbody.empty();

                if (!data || data.length === 0) {
                    isPendingAvailable = false;
                    tbody.html('<tr><td colspan="6" class="text-center text-muted py-3">No Pending Requirements Found</td></tr>');
                    if (callback) callback();
                    return;
                }

                isPendingAvailable = true;

                $.each(data, function (i, item) {
                    let key = item.YarnMaterialID + "|" + item.YarnColorID + "|" + normalize(item.CompanyColourCode);
                    let reqDetailId = parseInt(item.YarnRequirementDetailID) || parseInt(item.YarnRequirementID) || 0;
                    let reqId = parseInt(item.YarnRequirementID) || 0;

                    tbody.append(`
                            <tr>
                                <td>
                                    <input type="checkbox" 
                                           data-key="${key}" 
                                           data-materialid="${item.YarnMaterialID}" 
                                           data-colorid="${item.YarnColorID}" 
                                           data-colorcode="${normalize(item.CompanyColourCode)}" 
                                           data-detailid="${reqDetailId}" 
                                           data-reqid="${reqId}" 
                                           class="row-checkbox" 
                                           value="${reqDetailId}">
                                    REQ - ${reqId}
                                </td>
                                <td>${item.PartyName || ''}</td>
                                <td>${item.YarnMaterial || ''}</td>
                                <td>${item.YarnColor || ''}</td>
                                <td>${item.CompanyColourCode || ''}</td>
                                <td>${item.NoofBoxes}</td>
                            </tr>
                        `);

                    let shortKey = `${item.YarnMaterialID}|${item.YarnColorID}`;
                    pendingDetailMap[key] = reqDetailId;
                    pendingDetailMap[shortKey] = reqDetailId;

                    let boxes = parseInt(item.NoofBoxes) || 0;
                    pendingItemWise[key] = (pendingItemWise[key] || 0) + boxes;
                    pendingItemWise[shortKey] = (pendingItemWise[shortKey] || 0) + boxes;
                });

                if (callback) callback();
            }

            function fetchPending(queryPartyId, onDone) {
                $.ajax({
                    url: "/WebServiceNikunjTextile.asmx/GetUpdatePendingYarnDetails",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        partyId: queryPartyId,
                        yarnMaterialID: mId,
                        yarnColorID: validColors,
                        yarnOutwardID: currentOutwardId
                    }),
                    success: function (res) {
                        let data = res.d;
                        if (typeof data === "string") {
                            data = JSON.parse(data);
                        }
                        onDone(data || []);
                    },
                    error: function () {
                        onDone([]);
                    }
                });
            }

            fetchPending(primaryPartyId, function (data) {
                if (data.length > 0 || primaryPartyId === 0) {
                    renderPendingData(data);
                } else {
                    fetchPending(0, function (allData) {
                        renderPendingData(allData);
                    });
                }
            });
        }

        function highlightMatchedYarnRows() {
            let stockRows = $("#tableYarnOutward tbody tr").filter(function () {
                return $(this).find(".txtStockInput").length > 0;
            });
            if (stockRows.length === 0) return;

            $("#tableYarnOutward tbody tr#noMatchingStockRow").remove();

            let checkedBoxes = $(".row-checkbox:checked");
            let checkedKeys = {};
            let checkedShortKeys = {};

            checkedBoxes.each(function () {
                let chk = $(this);
                let key = normalize(chk.data("key"));
                let mat = chk.data("materialid");
                let col = chk.data("colorid");
                if (key) checkedKeys[key] = true;
                if (mat && col) checkedShortKeys[`${mat}|${col}`] = true;
            });

            let visibleCount = 0;
            stockRows.each(function () {
                let row = $(this);
                let input = row.find(".txtStockInput");
                let key = normalize(input.data("key"));
                let keyParts = key.split("|");
                let shortKey = (keyParts.length >= 2) ? `${keyParts[0]}|${keyParts[1]}` : "";
                let currentVal = parseInt(input.val()) || 0;

                let isCheckedMatch = checkedBoxes.length > 0 && (checkedKeys[key] || (shortKey && checkedShortKeys[shortKey]));
                let shouldShow = (currentVal > 0) || isCheckedMatch;

                if (shouldShow) {
                    visibleCount++;
                    row.show().addClass("table-success");
                } else {
                    row.hide().removeClass("table-success");
                }
            });

            if (visibleCount === 0) {
                if (checkedBoxes.length === 0) {
                    $("#tableYarnOutward tbody").append('<tr id="noMatchingStockRow"><td colspan="8" class="text-center text-muted py-3">Select / Check Pending Requirement to view available stock</td></tr>');
                } else {
                    $("#tableYarnOutward tbody").append('<tr id="noMatchingStockRow"><td colspan="8" class="text-center text-muted py-3">No Matching Stock in Selected Godown for Selected Requirement</td></tr>');
                }
            } else {
                let idx = 1;
                stockRows.filter(":visible").each(function () {
                    $(this).find(".rowIndex").text(idx++);
                });
            }
        }

        function applyCheckboxVisibility() {
            let outwardMap = {};

            $(".txtStockInput").each(function () {
                let key = normalize($(this).data("key"));
                if (key) {
                    outwardMap[key] = true;
                    let parts = key.split("|");
                    if (parts.length >= 2) {
                        outwardMap[`${parts[0]}|${parts[1]}`] = true;
                    }
                }
            });

            let tbody = $("#pendingYarnTable tbody");
            let matchedRows = [];
            let unmatchedRows = [];

            tbody.find("tr").each(function () {
                let row = $(this);
                let checkbox = row.find(".row-checkbox");
                if (checkbox.length === 0) return;

                let key = normalize(checkbox.data("key"));
                let matId = checkbox.data("materialid");
                let colId = checkbox.data("colorid");
                let shortKey = (matId && colId) ? `${matId}|${colId}` : "";

                let isMatch = outwardMap[key] || (shortKey && outwardMap[shortKey]) || checkbox.is(":checked");

                if (isMatch) {
                    checkbox.prop("disabled", false);
                    matchedRows.push(row);
                } else {
                    checkbox.prop("disabled", true);
                    checkbox.prop("checked", false);
                    unmatchedRows.push(row);
                }
            });

            if (matchedRows.length > 0 || unmatchedRows.length > 0) {
                tbody.empty();
                matchedRows.forEach(r => tbody.append(r));
                unmatchedRows.forEach(r => tbody.append(r));
            }
        }

        function editYarnOutward(id) {
            isLoadingForEdit = true;
            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/GetYarnOutwardForEdit",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ YarnOutwardID: id }),
                success: function (res) {
                    let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;

                    if (result.Status != 1) {
                        isLoadingForEdit = false;
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: result.Message
                        });
                        return;
                    }

                    let master = result.Data.Master;
                    let detail = result.Data.Detail || [];

                    $("#YarnOutwardID").val(master.YarnOutwardID);
                    $("#ListNo").val(master.OutwardListNo);
                    $("#ListDate").val(formatJsonDate(master.OutwardListDate));
                    $("#SundryParty").val(master.SundryPartyId);
                    $("#ddlYarnGodownManager").val(master.GodownManagerUserAccountId).trigger("change.select2");

                    if (master.GodownID) {
                        $("#ddlGodownMaster").val(master.GodownID).trigger("change.select2");
                        let godownText = $("#ddlGodownMaster option:selected").text().trim();
                        $("#select2-ddlGodownMaster-container").html(godownText).attr("title", godownText);
                    }

                    // Also fetch getYarnOutwardDetails for rich details (LocationTitle, CompanyName, etc.)
                    let formData = new FormData();
                    formData.append('YarnOutwardID', id);
                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/getYarnOutwardDetails',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (viewRes) {
                            if (viewRes && viewRes.listYarnOutwardMaster && viewRes.listYarnOutwardMaster.length > 0) {
                                let viewDetail = viewRes.listYarnOutwardMaster[0].listYarnOutwardDetail || [];
                                detail.forEach(d => {
                                    let matched = viewDetail.find(vd => 
                                        vd.GodownLocationID == d.GodownLocationID && 
                                        vd.YarnMaterialID == d.YarnMaterialID && 
                                        vd.YarnColorID == d.YarnColorID
                                    );
                                    if (matched) {
                                        d.CompanyName = matched.CompanyName;
                                        d.YarnMaterial = matched.YarnMaterial;
                                        d.YarnColor = matched.YarnColor;
                                        d.LocationTitle = matched.LocationTitle;
                                        d.YarnColorCode = matched.YarnColorCode || d.YarnColorCode;
                                    }
                                });
                            }
                            proceedWithEdit();
                        },
                        error: function () {
                            proceedWithEdit();
                        }
                    });

                    function proceedWithEdit() {
                        changeSundryParty(master.SundryPartyId, function () {
                            if ($("#ddlParty option[value='" + master.PartyId + "']").length === 0 && master.PartyName) {
                                $("#ddlParty").append("<option value='" + master.PartyId + "'>" + master.PartyName + "</option>");
                            }

                            $("#ddlParty").val(master.PartyId);
                            let partyText = master.PartyName || $("#ddlParty option:selected").text().trim();
                            $("#select2-ddlParty-container").html(partyText).attr("title", partyText);

                            $("#ddlParty").prop("disabled", true);
                            $("#ddlParty").next(".select2-container").css({
                                "pointer-events": "none",
                                "cursor": "not-allowed"
                            });

                            loadAllYarnData(master.PartyId, 0, 0, function () {
                                // 1. Match or inject detail stock rows into #tableYarnOutward
                                detail.forEach(d => {
                                    let qty = parseFloat(d.NoOfBox) || 0;
                                    let dKey = `${d.YarnMaterialID}|${d.YarnColorID}|${normalize(d.YarnColorCode)}`;
                                    let dShortKey = `${d.YarnMaterialID}|${d.YarnColorID}`;

                                    let matchedInput = null;
                                    $(".txtStockInput").each(function () {
                                        let input = $(this);
                                        let locId = input.data("locationid");
                                        let k = normalize(input.data("key"));
                                        let kShort = `${k.split("|")[0]}|${k.split("|")[1]}`;
                                        if (locId == d.GodownLocationID && (k === dKey || kShort === dShortKey)) {
                                            matchedInput = input;
                                            return false;
                                        }
                                    });

                                    if (matchedInput && matchedInput.length > 0) {
                                        let curStock = parseFloat(matchedInput.data("stock")) || 0;
                                        let newStock = curStock + qty;
                                        matchedInput.data("stock", newStock);
                                        matchedInput.closest("tr").find("td:eq(6)").text(newStock);
                                        matchedInput.val(qty);
                                        matchedInput.data("old", qty);
                                        matchedInput.closest("tr").addClass("table-success");
                                    } else {
                                        let compName = d.CompanyName || master.PartyName || $("#ddlParty option:selected").text().trim();
                                        let matName = d.YarnMaterial || $("#ddlYarnMaterial option[value='" + d.YarnMaterialID + "']").text().trim() || "";
                                        let colName = d.YarnColor || $("#ddlYarnColor option[value='" + d.YarnColorID + "']").text().trim() || "";
                                        let locTitle = d.LocationTitle || ("Location " + d.GodownLocationID);

                                        let trHtml = `
                                            <tr class="table-success outward-saved-row">
                                                <td class="rowIndex text-center font-weight-bold text-muted">1</td>
                                                <td id="CompanyId" hidden>${d.YarnCompanyID || d.BillToPartyID || master.PartyId}</td>
                                                <td>${compName}</td>
                                                <td>${matName}</td>
                                                <td>${colName}</td>
                                                <td class="text-center font-weight-bold">${d.YarnColorCode || ''}</td>
                                                <td class="text-center font-weight-bold text-info">${qty}</td>
                                                <td>${locTitle}</td>
                                                <td class="text-center">
                                                    <input type="text" class="txtStockInput form-control form-control-sm text-center font-weight-bold mx-auto" 
                                                        value="${qty}" data-key="${dKey}" data-stock="${qty}"
                                                        data-old="${qty}"
                                                        data-locationid="${d.GodownLocationID}" maxlength="4" style="max-width: 90px; height: 32px;"
                                                        onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                                                </td>
                                            </tr>
                                        `;
                                        if ($("#tableYarnOutward tbody tr").find(".txtStockInput").length === 0) {
                                            $("#tableYarnOutward tbody").empty();
                                        }
                                        $("#tableYarnOutward tbody").prepend(trHtml);
                                    }
                                });

                                let savedReqIds = (result.YarnRequirementIDs || []).map(x => parseInt(x, 10)).filter(x => x > 0);
                                detail.forEach(d => {
                                    let rid = parseInt(d.YarnRequirementDetailID, 10) || 0;
                                    if (rid > 0 && savedReqIds.indexOf(rid) === -1) {
                                        savedReqIds.push(rid);
                                    }
                                });

                                // Ensure every saved requirement in detail is present in #pendingYarnTable
                                detail.forEach(d => {
                                    let dReq = parseInt(d.YarnRequirementDetailID, 10) || 0;
                                    if (dReq > 0) {
                                        let existingChk = $("#pendingYarnTable .row-checkbox").filter(function () {
                                            let detId = parseInt($(this).data("detailid"), 10) || 0;
                                            let rId = parseInt($(this).data("reqid"), 10) || 0;
                                            return detId === dReq || rId === dReq;
                                        });

                                        if (existingChk.length === 0) {
                                            if ($("#pendingYarnTable tbody tr").find(".row-checkbox").length === 0) {
                                                $("#pendingYarnTable tbody").empty();
                                            }
                                            let dKey = `${d.YarnMaterialID}|${d.YarnColorID}|${normalize(d.YarnColorCode)}`;
                                            let shortKey = `${d.YarnMaterialID}|${d.YarnColorID}`;
                                            let partyName = master.PartyName || $("#ddlParty option:selected").text().trim() || "";
                                            let matName = d.YarnMaterial || $("#ddlYarnMaterial option[value='" + d.YarnMaterialID + "']").text().trim() || "";
                                            let colName = d.YarnColor || $("#ddlYarnColor option[value='" + d.YarnColorID + "']").text().trim() || "";
                                            let colCode = d.YarnColorCode || "";
                                            let boxes = d.NoOfBox || 0;

                                            $("#pendingYarnTable tbody").prepend(`
                                                <tr>
                                                    <td>
                                                        <input type="checkbox" 
                                                               data-key="${dKey}" 
                                                               data-materialid="${d.YarnMaterialID}" 
                                                               data-colorid="${d.YarnColorID}" 
                                                               data-colorcode="${normalize(colCode)}" 
                                                               data-detailid="${dReq}" 
                                                               data-reqid="${dReq}" 
                                                               class="row-checkbox" 
                                                               value="${dReq}" checked>
                                                        REQ - ${dReq}
                                                    </td>
                                                    <td>${partyName}</td>
                                                    <td>${matName}</td>
                                                    <td>${colName}</td>
                                                    <td>${colCode}</td>
                                                    <td>${boxes}</td>
                                                </tr>
                                            `);
                                            pendingDetailMap[dKey] = dReq;
                                            pendingDetailMap[shortKey] = dReq;
                                            pendingItemWise[dKey] = (pendingItemWise[dKey] || 0) + (parseFloat(boxes) || 0);
                                            pendingItemWise[shortKey] = (pendingItemWise[shortKey] || 0) + (parseFloat(boxes) || 0);
                                            isPendingAvailable = true;
                                        }
                                    }
                                });

                                applyCheckboxVisibility();

                                // 2. Check matching requirement checkboxes in #pendingYarnTable
                                $("#pendingYarnTable .row-checkbox").each(function () {
                                    let chk = $(this);
                                    let rowMat = parseInt(chk.data("materialid")) || 0;
                                    let rowCol = parseInt(chk.data("colorid")) || 0;
                                    let rowDetailId = parseInt(chk.data("detailid")) || 0;
                                    let rowReqId = parseInt(chk.data("reqid")) || parseInt(chk.val()) || 0;
                                    let rowColorCode = normalize(chk.data("colorcode"));

                                    let isMatched = savedReqIds.indexOf(rowDetailId) !== -1 || savedReqIds.indexOf(rowReqId) !== -1;
                                    if (!isMatched) {
                                        isMatched = detail.some(d => {
                                            let dMat = parseInt(d.YarnMaterialID) || 0;
                                            let dCol = parseInt(d.YarnColorID) || 0;
                                            let dReq = parseInt(d.YarnRequirementDetailID) || 0;
                                            let dColorCode = normalize(d.YarnColorCode);

                                            if (dMat !== rowMat || dCol !== rowCol) {
                                                return false;
                                            }

                                            if (dReq > 0) {
                                                if (dReq === rowDetailId || dReq === rowReqId) {
                                                    return true;
                                                }
                                            }

                                            // Match by Material + Color + ColorCode (or Material + Color if color code empty)
                                            if (dColorCode && rowColorCode) {
                                                return dColorCode === rowColorCode;
                                            }
                                            return true;
                                        });
                                    }

                                    if (isMatched) {
                                        chk.prop("checked", true).attr("checked", "checked");
                                    }
                                });

                                // 3. Reconstruct globalYarnMap from checked checkboxes
                                globalYarnMap = {};
                                $(".row-checkbox:checked").each(function () {
                                    let chk = $(this);
                                    let key = normalize(chk.data("key"));
                                    let shortKey = `${chk.data("materialid")}|${chk.data("colorid")}`;
                                    let stock = parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                                    let itemObj = {
                                        id: parseInt(chk.data("detailid")) || parseInt(chk.data("reqid")) || parseInt(chk.val()) || 0,
                                        stock: stock
                                    };
                                    if (!globalYarnMap[key]) globalYarnMap[key] = [];
                                    globalYarnMap[key].push(itemObj);
                                    if (!globalYarnMap[shortKey]) globalYarnMap[shortKey] = [];
                                    globalYarnMap[shortKey].push(itemObj);
                                });

                                highlightMatchedYarnRows();
                                isLoadingForEdit = false;
                            });
                        });
                    }
                },
                error: function (err) {
                    isLoadingForEdit = false;
                    console.error("Error:", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to load outward record for edit.'
                    });
                }
            });
        }

        $(document).on("change", ".row-checkbox", function () {
            let currentChk = $(this);
            let key = normalize(currentChk.data("key"));
            let matId = parseInt(currentChk.data("materialid")) || 0;
            let colId = parseInt(currentChk.data("colorid")) || 0;
            let currentShortKey = (matId > 0 && colId > 0) ? `${matId}|${colId}` : "";

            let inputs = $(".txtStockInput").filter(function () {
                let inpKey = normalize($(this).data("key"));
                let inpMat = parseInt(inpKey.split("|")[0]) || 0;
                let inpCol = parseInt(inpKey.split("|")[1]) || 0;
                let inpShortKey = (inpMat > 0 && inpCol > 0) ? `${inpMat}|${inpCol}` : "";
                return inpKey === key || (currentShortKey !== "" && inpShortKey === currentShortKey);
            });

            let maxCapacity = 0;
            inputs.each(function () {
                maxCapacity += parseInt($(this).data("stock")) || 0;
            });

            let selectedStock = 0;
            $(".row-checkbox:checked").not(currentChk).each(function () {
                let chk = $(this);
                let chkKey = normalize(chk.data("key"));
                let chkMat = parseInt(chk.data("materialid")) || 0;
                let chkCol = parseInt(chk.data("colorid")) || 0;
                let chkShortKey = (chkMat > 0 && chkCol > 0) ? `${chkMat}|${chkCol}` : "";
                if (chkKey === key || (currentShortKey !== "" && chkShortKey === currentShortKey)) {
                    selectedStock += parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                }
            });

            let currentStock = parseInt(currentChk.closest("tr").find("td:eq(5)").text()) || 0;

            if (currentChk.is(":checked")) {
                let tempTotal = selectedStock + currentStock;
                let usableTemp = Math.min(tempTotal, maxCapacity);

                if (usableTemp <= selectedStock) {
                    currentChk.prop("checked", false);
                    Swal.fire({
                        icon: "warning",
                        title: "Limit Reached",
                        text: "Stock already fully allocated!"
                    });
                    return;
                }
            }

            let selectedData = [];
            $(".row-checkbox:checked").each(function () {
                let chk = $(this);
                let chkKey = normalize(chk.data("key"));
                let chkMat = parseInt(chk.data("materialid")) || 0;
                let chkCol = parseInt(chk.data("colorid")) || 0;
                let chkShortKey = (chkMat > 0 && chkCol > 0) ? `${chkMat}|${chkCol}` : "";
                if (chkKey === key || (currentShortKey !== "" && chkShortKey === currentShortKey)) {
                    let stock = parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                    selectedData.push({
                        id: parseInt(chk.data("detailid")) || parseInt(chk.data("reqid")) || parseInt(chk.val()) || 0,
                        stock: stock
                    });
                }
            });

            globalYarnMap[key] = selectedData;
            if (currentShortKey !== "") {
                globalYarnMap[currentShortKey] = selectedData;
            }

            let totalStock = selectedData.reduce((sum, x) => sum + x.stock, 0);
            let usableStock = Math.min(totalStock, maxCapacity);
            let totalFilled = 0;

            inputs.val(0);
            inputs.each(function () {
                let input = $(this);
                let max = parseInt(input.data("stock")) || 0;
                let remaining = usableStock - totalFilled;

                if (remaining <= 0) {
                    input.val(0);
                    input.data("old", 0);
                    return;
                }

                let fill = Math.min(max, remaining);
                input.val(fill);
                input.data("old", fill);
                totalFilled += fill;
            });

            highlightMatchedYarnRows();
        });

        function saveYarnOutward() {
            let yarnOutwardID = parseInt($("#YarnOutwardID").val()) || 0;
            let partyId = parseInt($("#ddlParty").val()) || 0;
            let listNo = $("#ListNo").val();
            let listDate = $("#ListDate").val();
            let godownManager = parseInt($("#ddlYarnGodownManager").val()) || 0;
            let godownId = parseInt($("#ddlGodownMaster").val()) || 0;
            let sundrypartyid = parseInt($("#SundryParty").val()) || 0;

            if (partyId === 0) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Select Sundry Creditors Party." });
                return;
            }
            if (!listNo) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Mention List No." });
                return;
            }
            if (!listDate) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Mention List Date." });
                return;
            }
            if (godownManager === 0) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Select Godown Manager." });
                return;
            }

            let detailList = [];
            let tempYarnMap = JSON.parse(JSON.stringify(globalYarnMap || {}));

            $("#tableYarnOutward tbody tr:visible").each(function () {
                let yarnCompanyId = parseInt($(this).find("#CompanyId").text()) || 0;
                let input = $(this).find(".txtStockInput");
                let qty = parseInt(input.val()) || 0;
                if (qty <= 0) return;

                let key = normalize(input.data("key"));
                let materialId = parseInt(key.split("|")[0]);
                let colorId = parseInt(key.split("|")[1]);
                let locationId = parseInt(input.data("locationid"));
                let shortKey = `${materialId}|${colorId}`;
                let yarnData = tempYarnMap[key] || tempYarnMap[shortKey] || [];

                if (yarnData && yarnData.length > 0) {
                    let remainingQty = qty;
                    for (let i = 0; i < yarnData.length; i++) {
                        let item = yarnData[i];
                        if (item.stock <= 0) continue;
                        let allocate = Math.min(remainingQty, item.stock);
                        if (allocate > 0) {
                            detailList.push({
                                BillToPartyID: partyId,
                                YarnMaterialID: materialId,
                                YarnCompanyID: yarnCompanyId,
                                YarnColorID: colorId,
                                GodownLocationID: locationId,
                                NoOfBox: allocate,
                                YarnRequirementDetailID: item.id
                            });
                            item.stock -= allocate;
                            remainingQty -= allocate;
                        }
                        if (remainingQty <= 0) break;
                    }
                    if (remainingQty > 0) {
                        let fallbackId = yarnData[yarnData.length - 1].id;
                        detailList.push({
                            BillToPartyID: partyId,
                            YarnMaterialID: materialId,
                            YarnCompanyID: yarnCompanyId,
                            YarnColorID: colorId,
                            GodownLocationID: locationId,
                            NoOfBox: remainingQty,
                            YarnRequirementDetailID: fallbackId
                        });
                    }
                } else {
                    let fallbackReqId = pendingDetailMap[key] || pendingDetailMap[shortKey] || (tempYarnMap[shortKey] && tempYarnMap[shortKey][0] ? tempYarnMap[shortKey][0].id : 0);
                    detailList.push({
                        BillToPartyID: partyId,
                        YarnMaterialID: materialId,
                        YarnCompanyID: yarnCompanyId,
                        YarnColorID: colorId,
                        GodownLocationID: locationId,
                        NoOfBox: qty,
                        YarnRequirementDetailID: fallbackReqId
                    });
                }
            });

            // Consolidate duplicate rows for same location, material, color, company
            let consolidatedMap = {};
            for (let i = 0; i < detailList.length; i++) {
                let d = detailList[i];
                let dKey = `${d.GodownLocationID}_${d.YarnMaterialID}_${d.YarnColorID}_${d.YarnCompanyID}_${d.BillToPartyID}`;
                if (!consolidatedMap[dKey]) {
                    consolidatedMap[dKey] = Object.assign({}, d);
                } else {
                    consolidatedMap[dKey].NoOfBox += d.NoOfBox;
                    if ((!consolidatedMap[dKey].YarnRequirementDetailID || consolidatedMap[dKey].YarnRequirementDetailID <= 0) && d.YarnRequirementDetailID > 0) {
                        consolidatedMap[dKey].YarnRequirementDetailID = d.YarnRequirementDetailID;
                    }
                }
            }
            detailList = Object.values(consolidatedMap);

            if (detailList.length === 0) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Enter at least one quantity." });
                return;
            }

            let formattedDate = formatDateToISO(listDate);
            if (!formattedDate) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Invalid List Date." });
                return;
            }

            let master = {
                YarnOutwardID: yarnOutwardID,
                GodownID: godownId,
                PartyId: partyId,
                OutwardListDate: formattedDate,
                GodownManagerUserAccountId: godownManager,
                SundryPartyID: sundrypartyid
            };

            $("#savebtn").prop("disabled", true).text("Saving...");

            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/UpdateYarnOutward",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    master: master,
                    detail: detailList
                }),
                success: function (res) {
                    $("#savebtn").prop("disabled", false).text("Save Yarn OutWard");
                    let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;
                    let data = Array.isArray(result) ? result[0] : result;

                    if (data && data.Status == 1) {
                        Swal.fire({ icon: 'success', title: 'Success', text: data.Message }).then(() => {
                            window.location.href = 'YarnOutWardChallanDetails';
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: (data && data.Message) ? data.Message : "Error saving data" });
                    }
                },
                error: function (xhr) {
                    $("#savebtn").prop("disabled", false).text("Save Yarn OutWard");
                    console.error(xhr.responseText);
                    Swal.fire({ icon: 'error', title: 'Error', text: "Server Error while saving." });
                }
            });
        }
    </script>
}
