        function saveYarnOutward() {
            let yarnOutwardID = parseInt($("#YarnOutwardID").val()) || 0;
            let partyId = parseInt($("#ddlParty").val()) || 0;
            let listNo = $("#ListNo").val();
            let listDate = $("#ListDate").val();
            let godownManager = parseInt($("#ddlYarnGodownManager").val()) || 0;
            let godownId = parseInt($("#ddlGodownMaster").val()) || 0;
            let sundrypartyid = parseInt($("#SundryParty").val()) || 0;
            if (partyId === 0) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Select Sundry Creditors Party." });
                return;
            }
            if (!listNo) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Mention List No." });
                return;
            }
            if (!listDate) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Mention List Date." });
                return;
            }
            if (godownManager === 0) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Please Select Godown Manager." });
                return;
            }
            let detailList = [];

            // 🔥 IMPORTANT: clone global map (so original not destroyed)
            let tempYarnMap = JSON.parse(JSON.stringify(globalYarnMap || {}));

            $("#tableYarnOutward tbody tr:visible").each(function () {

                let yarnCompanyId = parseInt($(this).find("#CompanyId").text()) || 0;
                let input = $(this).find(".txtStockInput");
                let qty = parseInt(input.val()) || 0;
                if (qty <= 0) return;
                let key = normalize(input.data("key"));
                let materialId = parseInt(key.split("|")[0]);
                let colorId = parseInt(key.split("|")[1]);
                let locationId = parseInt(input.data("locationid"));
                let yarnData = tempYarnMap[key] || [];
                let remainingQty = qty;
                for (let i = 0; i < yarnData.length; i++) {
                    if (remainingQty <= 0) break;
                    let item = yarnData[i];
                    if (item.stock <= 0) continue;

                    let usedQty = Math.min(item.stock, remainingQty);

                    if (usedQty > 0) {

                        detailList.push({
                            BillToPartyID: partyId,
                            YarnMaterialID: materialId,
                            YarnCompanyID: yarnCompanyId,
                            YarnColorID: colorId,
                            GodownLocationID: locationId,
                            NoOfBox: usedQty,
                            YarnRequirementDetailID: item.id
                        });

                        // 🔥 reduce stock globally
                        item.stock -= usedQty;
                        remainingQty -= usedQty;
                    }
                }

                // fallback (no checkbox selected)
                if (remainingQty > 0) {
                    detailList.push({
                        BillToPartyID: partyId,
                        YarnMaterialID: materialId,
                        YarnCompanyID: yarnCompanyId,
                        YarnColorID: colorId,
                        GodownLocationID: locationId,
                        NoOfBox: remainingQty,
                        YarnRequirementDetailID: 0
                    });
                }

            });

            if (detailList.length === 0) {
                Swal.fire({ icon: 'warning', title: 'Warning', text: "Enter at least one quantity" });
                return;
            }

            // ✅ DATE FORMAT FIX
            let rawDate = $("#ListDate").val(); // 22-04-2026

            let parts = rawDate.split("-");
            let formattedDate = `${parts[2]}-${parts[1]}-${parts[0]}`;

            let master = {
                YarnOutwardID: yarnOutwardID,
                GodownID: godownId,
                PartyId: partyId,
                OutwardListDate: formattedDate,
                GodownManagerUserAccountId: godownManager,
                SundryPartyID: sundrypartyid
            };

            console.log("FINAL DETAIL LIST:", detailList);

            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/UpdateYarnOutward",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    master: master,
                    detail: detailList
                }),
                success: function (res) {

                    let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;
                    let data = Array.isArray(result) ? result[0] : result;

                    if (data && data.Status == 1) {
                        Swal.fire({ icon: 'success', title: 'Success', text: data.Message }).then(() => {
                            window.location.href = 'YarnOutWardChallanDetails';
                        });

                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: data.Message || "Error saving data" });
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                    Swal.fire({ icon: 'error', title: 'Error', text: "Server Error" });
                }
            });
        }
