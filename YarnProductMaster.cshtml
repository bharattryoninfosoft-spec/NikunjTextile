@section Scripts{
    <script>
        $('body').addClass('fullscreen');
        var masterDataList = [];
        var filteredDataList = [];
        var currentPage = 1;
        var pageSize = 20;
        var prevNo = 0;
        var dropdownsLoaded = false;

        $(document).ready(function () {
            loadDropdowns();
            loadGridData();
        });

        // 1. Fetch Dropdown options via WebServiceNikunjTextile
        function loadDropdowns() {
            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/GetYarnMasterValidationDropdowns",
                dataType: "json",
                success: function (res) {
                    if (res && res.status) {
                        populateDropdowns(res);
                    }
                },
                error: function () {
                    // Fallback to page POST
                    $.ajax({
                        type: "POST",
                        url: "/YarnProductMaster",
                        data: { action: "get_dropdowns" },
                        dataType: "json",
                        success: function (res) {
                            if (res && res.status) populateDropdowns(res);
                        }
                    });
                }
            });
        }

        function populateDropdowns(res) {
            var compHtml = "<option value=''>-- Select Company --</option>";
            $.each(res.companies, function (i, c) {
                compHtml += "<option value='" + c.PartyId + "'>" + escapeHtml(c.PartyName) + "</option>";
            });
            $("#editCompanyID").html(compHtml);

            var matHtml = "<option value=''>-- Select Material --</option>";
            $.each(res.materials, function (i, m) {
                matHtml += "<option value='" + m.YarnMaterialID + "'>" + escapeHtml(m.YarnMaterial) + "</option>";
            });
            $("#editYarnMaterialID").html(matHtml);

            var colHtml = "<option value=''>-- Select Color --</option>";
            $.each(res.colors, function (i, col) {
                colHtml += "<option value='" + col.YarnColorID + "'>" + escapeHtml(col.YarnColor) + "</option>";
            });
            $("#editYarnColorID").html(colHtml);

            dropdownsLoaded = true;
        }

        // 2. Load Grid Records via WebServiceNikunjTextile
        function loadGridData() {
            $("#btnRefreshIcon").addClass("fa-spin");
            $("#tblYarnMaster tbody").html("<tr><td colspan='8' class='text-center py-4'><i class='fa fa-spinner fa-spin fa-2x text-primary'></i><br/><span class='text-muted small mt-2 d-inline-block'>Loading records & verifying usage...</span></td></tr>");
            $("#divPaggination").hide();

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/GetYarnMasterValidationList",
                dataType: "json",
                success: function (res) {
                    $("#btnRefreshIcon").removeClass("fa-spin");
                    if (res && res.status) {
                        masterDataList = res.data || [];
                        updateSummaryCounts();
                        applyFilters();
                    } else {
                        fallbackLoadGridData();
                    }
                },
                error: function () {
                    fallbackLoadGridData();
                }
            });
        }

        function fallbackLoadGridData() {
            $.ajax({
                type: "POST",
                url: "/YarnProductMaster",
                data: { action: "get_list" },
                dataType: "json",
                success: function (res) {
                    $("#btnRefreshIcon").removeClass("fa-spin");
                    if (res && res.status) {
                        masterDataList = res.data || [];
                        updateSummaryCounts();
                        applyFilters();
                    } else {
                        $("#tblYarnMaster tbody").html("<tr><td colspan='8' class='text-center text-danger py-4'>Failed to load data: " + (res ? res.message : "Unknown error") + "</td></tr>");
                    }
                },
                error: function () {
                    $("#btnRefreshIcon").removeClass("fa-spin");
                    $("#tblYarnMaster tbody").html("<tr><td colspan='8' class='text-center text-danger py-4'>Server communication error. Please try again.</td></tr>");
                }
            });
        }

        function updateSummaryCounts() {
            var total = masterDataList.length;
            var used = 0;
            var unused = 0;
            $.each(masterDataList, function (i, r) {
                if (r.IsUsed) used++;
                else unused++;
            });

            $("#lblTotalCount").text(total);
            $("#lblUsedCount").text(used);
            $("#lblUnusedCount").text(unused);
        }

        function onSearchGrid() {
            applyFilters();
        }

        function onStatusFilterChange() {
            applyFilters();
        }

        function applyFilters() {
            var search = ($("#txtSearchGrid").val() || "").trim().toLowerCase();
            var statusFilter = $("#ddlStatusFilter").val();

            filteredDataList = masterDataList.filter(function (item) {
                if (statusFilter === "UNUSED" && item.IsUsed) return false;
                if (statusFilter === "USED" && !item.IsUsed) return false;

                if (search) {
                    var comp = (item.Company || "").toLowerCase();
                    var mat = (item.YarnMaterial || "").toLowerCase();
                    var col = (item.YarnColor || "").toLowerCase();
                    var code = (item.CompanyCode || "").toLowerCase();
                    var reason = (item.UsageReason || "").toLowerCase();
                    if (!comp.includes(search) && !mat.includes(search) && !col.includes(search) && !code.includes(search) && !reason.includes(search)) {
                        return false;
                    }
                }
                return true;
            });

            currentPage = 1;
            prevNo = 0;
            renderPagedTable();
        }

        function renderPagedTable() {
            var totalRecords = filteredDataList.length;
            if (totalRecords === 0) {
                $("#tblYarnMaster tbody").html("<tr><td colspan='8' class='text-center text-muted py-4'>No matching records found.</td></tr>");
                $("#divPaggination").hide();
                return;
            }

            var totalPages = Math.ceil(totalRecords / pageSize);
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            var startIndex = (currentPage - 1) * pageSize;
            var endIndex = Math.min(startIndex + pageSize, totalRecords);
            var pageItems = filteredDataList.slice(startIndex, endIndex);

            var html = "";
            $.each(pageItems, function (idx, item) {
                var srNo = startIndex + idx + 1;
                var statusBadge = item.CanUpdate
                    ? "<span class='badge-status-editable'><i class='fa fa-check mr-1'></i> Editable</span>"
                    : "<span class='badge-status-inuse'><i class='fa fa-ban mr-1'></i> In Use</span>";

                var compCodeHtml = (item.CompanyCode && item.CompanyCode.trim() !== "")
                    ? "<span class='company-code-pill'>" + escapeHtml(item.CompanyCode) + "</span>"
                    : "<span class='text-muted' style='font-style: italic;'>-</span>";

                var actionBtn = "";
                if (item.CanUpdate) {
                    actionBtn = "<button type='button' class='btn btn-sm btn-outline-primary' onclick='openEditModal(" + item.YarnPODetailID + ")' title='Edit record'>" +
                                "<i class='fa fa-pencil mr-1'></i> Edit" +
                                "</button>";
                } else {
                    actionBtn = "<button type='button' class='btn btn-sm btn-outline-secondary' disabled title='Update blocked: Record is in use elsewhere.'>" +
                                "<i class='fa fa-lock mr-1'></i> Blocked" +
                                "</button>";
                }

                // actionBtn += "&nbsp;<button type='button' class='btn btn-sm btn-link text-info p-0 ml-1' onclick='verifyUsageLive(" + item.YarnPODetailID + ")' title='Run live database verification'>" +
                //              "<i class='fa fa-search'></i>" +
                //              "</button>";

                html += "<tr>";
                html += "<td style='text-align: center;' class='font-weight-bold text-muted'>" + srNo + "</td>";
                html += "<td><strong>" + escapeHtml(item.Company) + "</strong></td>";
                html += "<td>" + escapeHtml(item.YarnMaterial) + "</td>";
                html += "<td>" + escapeHtml(item.YarnColor) + "</td>";
                html += "<td style='text-align: center;'>" + compCodeHtml + "</td>";
                // html += "<td style='text-align: center;'>" + statusBadge + "</td>";
                // html += "<td class='small " + (item.IsUsed ? "text-danger" : "text-success") + "'>" + escapeHtml(item.UsageReason) + "</td>";
                html += "<td style='text-align: center; white-space: nowrap;'>" + actionBtn + "</td>";
                html += "</tr>";
            });

            $("#tblYarnMaster tbody").html(html);
            renderPagination(totalPages);
        }

        function renderPagination(totalPages) {
            if (totalPages <= 1) {
                $('#divPaggination').hide();
                return;
            }

            var temp = "";
            var startPage = 1;
            var endPage = totalPages;

            if (totalPages > 10) {
                startPage = prevNo + 1;
                endPage = Math.min(prevNo + 10, totalPages);

                if (prevNo > 0) {
                    temp += "<li class='page-item'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationPrev()'>Previous</a></li>";
                }
            }

            for (var i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                } else {
                    temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                }
            }

            if (totalPages > 10 && endPage < totalPages) {
                temp += "<li class='page-item'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";
            }

            $('#divPaggination').html(temp).show();
        }

        function funcationPaggination(pageNo) {
            currentPage = pageNo;
            renderPagedTable();
        }

        function funcationPagginationNext() {
            prevNo = prevNo + 10;
            currentPage = prevNo + 1;
            renderPagedTable();
        }

        function funcationPagginationPrev() {
            prevNo = Math.max(0, prevNo - 10);
            currentPage = prevNo + 1;
            renderPagedTable();
        }

        // 3. Live On-Demand Verification
        function verifyUsageLive(id) {
            Swal.fire({
                title: 'Verifying Usage...',
                text: 'Inspecting all database references for Record #' + id + '...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/CheckUsage",
                data: { id: id },
                dataType: "json",
                success: function (res) {
                    Swal.close();
                    if (res && res.status) {
                        if (res.isUsed) {
                            var reasonsHtml = "<div class='text-left mt-2'><ul class='mb-0'>";
                            $.each(res.reasons, function (i, r) {
                                reasonsHtml += "<li>" + escapeHtml(r) + "</li>";
                            });
                            reasonsHtml += "</ul></div>";

                            Swal.fire({
                                icon: 'error',
                                title: 'Update Blocked (In Use)',
                                html: 'This record cannot be updated because it is referenced in the database:' + reasonsHtml
                            });
                        } else {
                            Swal.fire({
                                icon: 'success',
                                title: 'Verified Safe (Unused)',
                                text: 'No database references found. This record is permitted to be updated.'
                            });
                        }
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Validation Notice',
                            text: res ? res.message : 'Unable to complete validation.'
                        });
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to verify usage with server.' });
                }
            });
        }

        // 4. Open Edit Modal (with Pre-Validation)
        function openEditModal(id) {
            var record = masterDataList.find(x => x.YarnPODetailID === id);
            if (!record) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Record not found.' });
                return;
            }

            $("#editDetailID").val(record.YarnPODetailID);
            $("#editCompanyID").val(record.CompanyPartyID);
            $("#editYarnMaterialID").val(record.YarnMaterialID);
            $("#editYarnColorID").val(record.YarnColorID);
            $("#editCompanyCode").val(record.CompanyCode);

            // Set Initial Validation Banner State
            $("#validationBanner").removeClass("alert-success alert-danger alert-info alert-warning").addClass("alert-info");
            $("#bannerIcon").removeClass("fa-check-circle fa-ban fa-exclamation-triangle").addClass("fa-spinner fa-spin");
            $("#bannerTitle").text("Pre-Validating Usage: ");
            $("#bannerText").text("Checking database dependencies...");
            $("#btnSubmitUpdate").prop("disabled", true);

            $("#modalEditYarnMaster").modal("show");

            // Perform live pre-validation check
            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/CheckUsage",
                data: { id: id },
                dataType: "json",
                success: function (res) {
                    if (res && res.status) {
                        if (res.isUsed) {
                            $("#validationBanner").removeClass("alert-info alert-success").addClass("alert-danger");
                            $("#bannerIcon").removeClass("fa-spinner fa-spin fa-check-circle").addClass("fa-ban text-danger");
                            $("#bannerTitle").text("Update Blocked: ");
                            $("#bannerText").html("Record is currently in use: " + escapeHtml(res.reasons.join(", ")));
                            $("#btnSubmitUpdate").prop("disabled", true);
                        } else {
                            $("#validationBanner").removeClass("alert-info alert-danger").addClass("alert-success");
                            $("#bannerIcon").removeClass("fa-spinner fa-spin fa-ban").addClass("fa-check-circle text-success");
                            $("#bannerTitle").text("Validation Passed: ");
                            $("#bannerText").text("No database dependencies found. You may safely update this record.");
                            $("#btnSubmitUpdate").prop("disabled", false);
                        }
                    } else {
                        $("#validationBanner").removeClass("alert-info alert-success").addClass("alert-warning");
                        $("#bannerIcon").removeClass("fa-spinner fa-spin").addClass("fa-exclamation-triangle text-warning");
                        $("#bannerTitle").text("Validation Error: ");
                        $("#bannerText").text(res ? res.message : "Validation check failed. Update is blocked.");
                        $("#btnSubmitUpdate").prop("disabled", true);
                    }
                },
                error: function () {
                    $("#validationBanner").removeClass("alert-info alert-success").addClass("alert-danger");
                    $("#bannerIcon").removeClass("fa-spinner fa-spin").addClass("fa-ban text-danger");
                    $("#bannerTitle").text("Validation Communication Error: ");
                    $("#bannerText").text("Could not verify with server. Update blocked for safety.");
                    $("#btnSubmitUpdate").prop("disabled", true);
                }
            });
        }

        // 5. Submit Update (Server-Enforced)
        function submitUpdateRecord() {
            var id = $("#editDetailID").val();
            var companyPartyID = $("#editCompanyID").val();
            var yarnMaterialID = $("#editYarnMaterialID").val();
            var yarnColorID = $("#editYarnColorID").val();
            var companyCode = ($("#editCompanyCode").val() || "").trim();

            if (!companyPartyID) {
                Swal.fire({ icon: 'warning', title: 'Required Field', text: 'Please select a Company.' });
                return;
            }
            if (!yarnMaterialID) {
                Swal.fire({ icon: 'warning', title: 'Required Field', text: 'Please select a Yarn Material.' });
                return;
            }
            if (!yarnColorID) {
                Swal.fire({ icon: 'warning', title: 'Required Field', text: 'Please select a Yarn Color.' });
                return;
            }
            if (!companyCode) {
                Swal.fire({ icon: 'warning', title: 'Required Field', text: 'Company Code cannot be empty.' });
                return;
            }

            $("#btnSubmitUpdate").prop("disabled", true);
            $("#btnUpdateSpinner").removeClass("d-none");
            $("#btnUpdateIcon").addClass("d-none");

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/UpdateRecord",
                data: {
                    id: id,
                    companyPartyID: companyPartyID,
                    yarnMaterialID: yarnMaterialID,
                    yarnColorID: yarnColorID,
                    companyCode: companyCode
                },
                dataType: "json",
                success: function (res) {
                    $("#btnSubmitUpdate").prop("disabled", false);
                    $("#btnUpdateSpinner").addClass("d-none");
                    $("#btnUpdateIcon").removeClass("d-none");

                    if (res && res.status) {
                        $("#modalEditYarnMaster").modal("hide");
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated!',
                            text: res.message || 'Record has been updated successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                        loadGridData();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Update Blocked / Failed',
                            text: res ? res.message : 'Server rejected the update.'
                        });
                    }
                },
                error: function (xhr) {
                    $("#btnSubmitUpdate").prop("disabled", false);
                    $("#btnUpdateSpinner").addClass("d-none");
                    $("#btnUpdateIcon").removeClass("d-none");
                    Swal.fire({
                        icon: 'error',
                        title: 'Request Failed',
                        text: 'An error occurred while updating the record.'
                    });
                }
            });
        }

        function escapeHtml(text) {
            if (text === null || text === undefined) return "";
            return String(text)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}
