@using System
@using System.Data
@using System.Data.SqlClient
@using System.Configuration
@using System.Collections.Generic
@using System.Web.Script.Serialization
@{
    Layout = "/_LayoutPage1.cshtml";

    // Handle direct POST fallback requests if invoked directly
    string action = Request["action"] ?? "";
    if (Request.HttpMethod == "POST" && !string.IsNullOrEmpty(action))
    {
        Response.Clear();
        Response.ContentType = "application/json; charset=utf-8";
        string jsonResult = "";

        try
        {
            if (action == "get_list")
            {
                jsonResult = GetYarnMasterListJson();
            }
            else if (action == "check_usage")
            {
                long id = 0;
                long.TryParse(Request["id"], out id);
                jsonResult = CheckRecordUsageJson(id);
            }
            else if (action == "get_dropdowns")
            {
                jsonResult = GetDropdownsJson();
            }
            else if (action == "update_record")
            {
                long id = 0;
                long.TryParse(Request["id"], out id);
                int companyPartyID = 0;
                int.TryParse(Request["companyPartyID"], out companyPartyID);
                int yarnMaterialID = 0;
                int.TryParse(Request["yarnMaterialID"], out yarnMaterialID);
                int yarnColorID = 0;
                int.TryParse(Request["yarnColorID"], out yarnColorID);
                string companyCode = (Request["companyCode"] ?? "").Trim();

                jsonResult = UpdateYarnMasterRecordJson(id, companyPartyID, yarnMaterialID, yarnColorID, companyCode);
            }
            else
            {
                jsonResult = new JavaScriptSerializer().Serialize(new { status = false, message = "Unknown action requested." });
            }
        }
        catch (Exception ex)
        {
            jsonResult = new JavaScriptSerializer().Serialize(new { status = false, message = "Server error: " + ex.Message });
        }

        Response.Write(jsonResult);
        Response.End();
        return;
    }
}

@functions {
    private string GetSqlConnectionString()
    {
        return ConfigurationManager.ConnectionStrings["sqlconnstr"].ConnectionString;
    }

    private string GetYarnMasterListJson()
    {
        var list = new List<Dictionary<string, object>>();
        string cs = GetSqlConnectionString();

        using (SqlConnection con = new SqlConnection(cs))
        {
            con.Open();
            try
            {
                using (SqlCommand setIso = new SqlCommand("SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;", con))
                {
                    setIso.CommandTimeout = 30;
                    setIso.ExecuteNonQuery();
                }
            }
            catch { }

            string query = @"
SELECT
    YPD.YarnPODetailID,
    YPM.YarnPOID,
    ISNULL(YPM.PONo, '') AS YarnPONo,
    ISNULL(YPM.CompanyPartyID, 0) AS CompanyPartyID,
    ISNULL(PM.PartyName, '') AS Company,
    ISNULL(YPD.YarnMaterialID, 0) AS YarnMaterialID,
    ISNULL(YM.YarnMaterial, '') AS YarnMaterial,
    ISNULL(YPD.YarnColorID, 0) AS YarnColorID,
    ISNULL(YC.YarnColor, '') AS YarnColor,
    ISNULL(YPD.CompanyCode, '') AS CompanyCode,
    (
        SELECT COUNT(1) 
        FROM YarnInwardMaster YIM WITH (NOLOCK) 
        WHERE YIM.YarnPODetailIDCompanyCode = YPD.YarnPODetailID
    ) AS InwardMasterCount,
    (
        SELECT COUNT(1) 
        FROM YarnInterchangeMaster YIC WITH (NOLOCK) 
        WHERE YIC.YarnPODetailID = YPD.YarnPODetailID
    ) AS InterChangeCount
FROM YarnPODetails YPD WITH (NOLOCK)
INNER JOIN YarnPOMaster YPM WITH (NOLOCK)
    ON YPD.YarnPOID = YPM.YarnPOID
LEFT JOIN PartyMaster PM WITH (NOLOCK)
    ON YPM.CompanyPartyID = PM.PartyID
LEFT JOIN yarnmaterialMaster YM WITH (NOLOCK)
    ON YPD.YarnMaterialID = YM.YarnMaterialID
LEFT JOIN YarnColorMaster YC WITH (NOLOCK)
    ON YPD.YarnColorID = YC.YarnColorID
ORDER BY
    PM.PartyName,
    YM.YarnMaterial,
    YC.YarnColor,
    YPD.YarnPODetailID DESC;";

            using (SqlCommand cmd = new SqlCommand(query, con))
            {
                cmd.CommandTimeout = 120;
                using (SqlDataReader rdr = cmd.ExecuteReader())
                {
                    while (rdr.Read())
                    {
                        var row = new Dictionary<string, object>();
                        long poDetailId = Convert.ToInt64(rdr["YarnPODetailID"]);
                        int inwardCount = Convert.ToInt32(rdr["InwardMasterCount"]);
                        int interChangeCount = Convert.ToInt32(rdr["InterChangeCount"]);

                        bool isUsed = (inwardCount > 0 || interChangeCount > 0);
                        string usageReason = "";
                        if (inwardCount > 0 && interChangeCount > 0)
                        {
                            usageReason = "Used in Yarn Inward (" + inwardCount + " entries) and Yarn Inter Change (" + interChangeCount + " entries).";
                        }
                        else if (inwardCount > 0)
                        {
                            usageReason = "Used in Yarn Inward (" + inwardCount + " challan/inward record(s)).";
                        }
                        else if (interChangeCount > 0)
                        {
                            usageReason = "Used in Yarn Inter Change (" + interChangeCount + " record(s)).";
                        }
                        else
                        {
                            usageReason = "No transaction references. Verified safe to update.";
                        }

                        row["YarnPODetailID"] = poDetailId;
                        row["YarnPOID"] = Convert.ToInt64(rdr["YarnPOID"]);
                        row["YarnPONo"] = rdr["YarnPONo"].ToString();
                        row["CompanyPartyID"] = Convert.ToInt32(rdr["CompanyPartyID"]);
                        row["Company"] = rdr["Company"].ToString();
                        row["YarnMaterialID"] = Convert.ToInt32(rdr["YarnMaterialID"]);
                        row["YarnMaterial"] = rdr["YarnMaterial"].ToString();
                        row["YarnColorID"] = Convert.ToInt32(rdr["YarnColorID"]);
                        row["YarnColor"] = rdr["YarnColor"].ToString();
                        row["CompanyCode"] = rdr["CompanyCode"].ToString();
                        row["IsUsed"] = isUsed;
                        row["CanUpdate"] = !isUsed;
                        row["UsageStatus"] = isUsed ? "Blocked (In Use)" : "Editable (Unused)";
                        row["UsageReason"] = usageReason;

                        list.Add(row);
                    }
                }
            }
        }

        var js = new JavaScriptSerializer();
        js.MaxJsonLength = Int32.MaxValue;
        return js.Serialize(new { status = true, data = list, total = list.Count });
    }

    private bool IsRecordUsedInDatabase(long yarnPODetailID, out List<string> reasons)
    {
        reasons = new List<string>();
        string cs = GetSqlConnectionString();

        using (SqlConnection con = new SqlConnection(cs))
        {
            con.Open();
            try
            {
                using (SqlCommand setIso = new SqlCommand("SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;", con))
                {
                    setIso.CommandTimeout = 30;
                    setIso.ExecuteNonQuery();
                }
            }
            catch { }

            // 1. Check YarnInwardMaster
            using (SqlCommand cmd = new SqlCommand("SELECT COUNT(1) FROM YarnInwardMaster WITH (NOLOCK) WHERE YarnPODetailIDCompanyCode = @ID", con))
            {
                cmd.CommandTimeout = 60;
                cmd.Parameters.AddWithValue("@ID", yarnPODetailID);
                int count = Convert.ToInt32(cmd.ExecuteScalar());
                if (count > 0)
                {
                    reasons.Add("Yarn Inward Master: " + count + " record(s) linked to this PO detail");
                }
            }

            // 2. Check YarnInwardDetail (Barcodes / Boxes created)
            using (SqlCommand cmd = new SqlCommand(@"
SELECT COUNT(1) 
FROM YarnInwardDetail D WITH (NOLOCK)
INNER JOIN YarnInwardMaster M WITH (NOLOCK) ON D.YarnInwardID = M.YarnInwardID
WHERE M.YarnPODetailIDCompanyCode = @ID", con))
            {
                cmd.CommandTimeout = 60;
                cmd.Parameters.AddWithValue("@ID", yarnPODetailID);
                int count = Convert.ToInt32(cmd.ExecuteScalar());
                if (count > 0)
                {
                    reasons.Add("Yarn Inward Detail (Barcodes/Boxes): " + count + " box(es) created");
                }
            }

            // 3. Check YARNOUTWARDScanMasterDetails
            using (SqlCommand cmd = new SqlCommand(@"
SELECT COUNT(1)
FROM YARNOUTWARDScanMasterDetails OSD WITH (NOLOCK)
WHERE OSD.YarnInwardDetailID IN (
    SELECT D.YarnInwardDetailID
    FROM YarnInwardDetail D WITH (NOLOCK)
    INNER JOIN YarnInwardMaster M WITH (NOLOCK) ON D.YarnInwardID = M.YarnInwardID
    WHERE M.YarnPODetailIDCompanyCode = @ID
)", con))
            {
                cmd.CommandTimeout = 60;
                cmd.Parameters.AddWithValue("@ID", yarnPODetailID);
                int count = Convert.ToInt32(cmd.ExecuteScalar());
                if (count > 0)
                {
                    reasons.Add("Yarn Outward Scans: " + count + " scanned item(s) found");
                }
            }

            // 4. Check YarnInterchangeMaster
            using (SqlCommand cmd = new SqlCommand("SELECT COUNT(1) FROM YarnInterchangeMaster WITH (NOLOCK) WHERE YarnPODetailID = @ID", con))
            {
                cmd.CommandTimeout = 60;
                cmd.Parameters.AddWithValue("@ID", yarnPODetailID);
                int count = Convert.ToInt32(cmd.ExecuteScalar());
                if (count > 0)
                {
                    reasons.Add("Yarn Inter Change: " + count + " transaction(s) found");
                }
            }
        }

        return reasons.Count > 0;
    }

    private string CheckRecordUsageJson(long id)
    {
        if (id <= 0)
        {
            return new JavaScriptSerializer().Serialize(new { status = false, message = "Invalid YarnPODetailID specified." });
        }

        List<string> reasons;
        bool isUsed = IsRecordUsedInDatabase(id, out reasons);

        return new JavaScriptSerializer().Serialize(new {
            status = true,
            id = id,
            isUsed = isUsed,
            canUpdate = !isUsed,
            reasons = reasons,
            message = isUsed ? ("Record is currently in use: " + string.Join("; ", reasons)) : "Record is verified unused and safe to update."
        });
    }

    private string GetDropdownsJson()
    {
        var companies = new List<Dictionary<string, object>>();
        var materials = new List<Dictionary<string, object>>();
        var colors = new List<Dictionary<string, object>>();
        string cs = GetSqlConnectionString();

        using (SqlConnection con = new SqlConnection(cs))
        {
            con.Open();

            // Companies
            using (SqlCommand cmd = new SqlCommand("SELECT PartyId, PartyName FROM PartyMaster WITH (NOLOCK) WHERE ISNULL(IsActive, 1) = 1 ORDER BY PartyName", con))
            {
                cmd.CommandTimeout = 60;
                using (SqlDataReader rdr = cmd.ExecuteReader())
                {
                    while (rdr.Read())
                    {
                        var c = new Dictionary<string, object>();
                        c["PartyId"] = Convert.ToInt32(rdr["PartyId"]);
                        c["PartyName"] = rdr["PartyName"].ToString();
                        companies.Add(c);
                    }
                }
            }

            // Materials
            using (SqlCommand cmd = new SqlCommand("SELECT YarnMaterialID, YarnMaterial FROM yarnmaterialMaster WITH (NOLOCK) ORDER BY YarnMaterial", con))
            {
                cmd.CommandTimeout = 60;
                using (SqlDataReader rdr = cmd.ExecuteReader())
                {
                    while (rdr.Read())
                    {
                        var m = new Dictionary<string, object>();
                        m["YarnMaterialID"] = Convert.ToInt32(rdr["YarnMaterialID"]);
                        m["YarnMaterial"] = rdr["YarnMaterial"].ToString();
                        materials.Add(m);
                    }
                }
            }

            // Colors
            using (SqlCommand cmd = new SqlCommand("SELECT YarnColorID, YarnColor FROM YarnColorMaster WITH (NOLOCK) ORDER BY YarnColor", con))
            {
                cmd.CommandTimeout = 60;
                using (SqlDataReader rdr = cmd.ExecuteReader())
                {
                    while (rdr.Read())
                    {
                        var col = new Dictionary<string, object>();
                        col["YarnColorID"] = Convert.ToInt32(rdr["YarnColorID"]);
                        col["YarnColor"] = rdr["YarnColor"].ToString();
                        colors.Add(col);
                    }
                }
            }
        }

        var js = new JavaScriptSerializer();
        return js.Serialize(new { status = true, companies = companies, materials = materials, colors = colors });
    }

    private string UpdateYarnMasterRecordJson(long id, int companyPartyID, int yarnMaterialID, int yarnColorID, string companyCode)
    {
        // 1. Basic Parameter validation
        if (id <= 0)
            return new JavaScriptSerializer().Serialize(new { status = false, message = "Invalid record ID." });
        if (companyPartyID <= 0)
            return new JavaScriptSerializer().Serialize(new { status = false, message = "Please select a valid Company." });
        if (yarnMaterialID <= 0)
            return new JavaScriptSerializer().Serialize(new { status = false, message = "Please select a valid Yarn Material." });
        if (yarnColorID <= 0)
            return new JavaScriptSerializer().Serialize(new { status = false, message = "Please select a valid Yarn Color." });
        if (string.IsNullOrWhiteSpace(companyCode))
            return new JavaScriptSerializer().Serialize(new { status = false, message = "Company Code cannot be empty." });

        // 2. MANDATORY SERVER-SIDE USAGE VALIDATION (Cannot be bypassed by direct POST)
        List<string> reasons;
        bool isUsed = IsRecordUsedInDatabase(id, out reasons);
        if (isUsed)
        {
            return new JavaScriptSerializer().Serialize(new {
                status = false,
                isBlocked = true,
                message = "UPDATE BLOCKED BY SERVER VALIDATION: This record is in active use: " + string.Join("; ", reasons)
            });
        }

        // 3. Perform update safely in a transaction
        string cs = GetSqlConnectionString();
        using (SqlConnection con = new SqlConnection(cs))
        {
            con.Open();
            using (SqlTransaction trans = con.BeginTransaction(IsolationLevel.RepeatableRead))
            {
                try
                {
                    long poId = 0;
                    using (SqlCommand checkCmd = new SqlCommand("SELECT YarnPOID FROM YarnPODetails WITH (UPDLOCK, ROWLOCK) WHERE YarnPODetailID = @ID", con, trans))
                    {
                        checkCmd.Parameters.AddWithValue("@ID", id);
                        object result = checkCmd.ExecuteScalar();
                        if (result == null || result == DBNull.Value)
                        {
                            trans.Rollback();
                            return new JavaScriptSerializer().Serialize(new { status = false, message = "Record not found in YarnPODetails." });
                        }
                        poId = Convert.ToInt64(result);
                    }

                    string sqlUpdateDetails = @"
UPDATE YarnPODetails 
SET 
    YarnMaterialID = @YarnMaterialID,
    YarnColorID = @YarnColorID,
    CompanyCode = @CompanyCode
WHERE YarnPODetailID = @YarnPODetailID";

                    using (SqlCommand cmdUpd = new SqlCommand(sqlUpdateDetails, con, trans))
                    {
                        cmdUpd.CommandTimeout = 60;
                        cmdUpd.Parameters.AddWithValue("@YarnMaterialID", yarnMaterialID);
                        cmdUpd.Parameters.AddWithValue("@YarnColorID", yarnColorID);
                        cmdUpd.Parameters.AddWithValue("@CompanyCode", companyCode);
                        cmdUpd.Parameters.AddWithValue("@YarnPODetailID", id);
                        cmdUpd.ExecuteNonQuery();
                    }

                    string sqlUpdateMaster = @"
UPDATE YarnPOMaster 
SET CompanyPartyID = @CompanyPartyID 
WHERE YarnPOID = @YarnPOID";

                    using (SqlCommand cmdUpdMaster = new SqlCommand(sqlUpdateMaster, con, trans))
                    {
                        cmdUpdMaster.CommandTimeout = 60;
                        cmdUpdMaster.Parameters.AddWithValue("@CompanyPartyID", companyPartyID);
                        cmdUpdMaster.Parameters.AddWithValue("@YarnPOID", poId);
                        cmdUpdMaster.ExecuteNonQuery();
                    }

                    trans.Commit();
                    return new JavaScriptSerializer().Serialize(new { status = true, message = "Record updated successfully." });
                }
                catch (Exception ex)
                {
                    trans.Rollback();
                    return new JavaScriptSerializer().Serialize(new { status = false, message = "Database error: " + ex.Message });
                }
            }
        }
    }
}

