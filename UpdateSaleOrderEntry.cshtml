    function saveSaleOrder()
    {
        let broker = $("#ddlBroker");
        let transport = $("#ddlTransport");
        let party = $("#ddlPartyGST");

        let isValid = true; // ✅ flag

        // Transport validation
        if (!transport.val() || transport.val() === "-1") {
            transport.addClass("is-invalid").removeClass("is-valid");
            showToast("error", "Please select Transport"); // ⚠️ use error not danger
            isValid = false;
        } else {
            transport.addClass("is-valid").removeClass("is-invalid");
        }

        // Broker validation
        if (!broker.val() || broker.val() === "-1") {
            broker.addClass("is-invalid").removeClass("is-valid");
            showToast("error", "Please select Broker");
            isValid = false;
        } else {
            broker.addClass("is-valid").removeClass("is-invalid");
        }

        // Party validation
        if (!party.val() || party.val() === "-1") {
            party.addClass("is-invalid").removeClass("is-valid");
            showToast("error", "Please select Party");
            isValid = false;
        } else {
            party.addClass("is-valid").removeClass("is-invalid");
        }

        // Design validation
        if (!SaleOrderDetails || SaleOrderDetails.length === 0) {
            showToast("error", "Please add at least one design!");
            isValid = false;
        }

        // ❌ Stop only after all checks
        if (!isValid) return false;

        // ✅ SHOW LOADER HERE
        showLoader();
        $("#btnSave").prop("disabled", true);
        let totalQty = 0;
        let totalAmount = 0;
        SaleOrderDetails.forEach((item) => {
            item.ItemType = item.TypeId || "";
            if (!item.SubDetails) {
                item.SubDetails = [];
            }
            item.SubDetails.forEach(sub => {
                sub.ColourID = sub.ColorMatchingID || 0;
                sub.ColourName = sub.ColorMatchingName || "";
                sub.Unit = sub.Unit || item.Unit || "PCS";
            });
            item.NoOfColours = item.SubDetails.length;
            let rowQty = 0;
            item.SubDetails.forEach(sub => {
                rowQty += parseFloat(sub.Qty || 0);
            });

            item.Qty = rowQty;
            item.Amount = rowQty * parseFloat(item.Rate || 0);
            totalQty += rowQty;
            totalAmount += item.Amount;
        });
        let value = parseFloat($("#discountValue").val()) || 0;
        let type = $("#discountType").val();

        let discountAmount = 0;

        if (type === "percent") {
            discountAmount = (totalAmount * value) / 100;
        } else {
            discountAmount = value;
        }

        if (discountAmount > totalAmount) {
            discountAmount = totalAmount;
        }

        $("#discountAmount").text(discountAmount.toFixed(2));
        let additionalValue = parseFloat($("#AdditionalValue").val()) || 0;
        let afterDiscount = totalAmount - discountAmount;
        let afterAdditional = afterDiscount + additionalValue;
        let gstPercent = parseFloat($("#gstPercent").val()) || 0;
        let gstAmount = (afterAdditional * gstPercent) / 100;

        $("#gstAmount").text(gstAmount.toFixed(2));

        // Final Amount
        let finalAmount = afterAdditional + gstAmount;

        $("#invoiceAmount").text(finalAmount.toFixed(2));

        let invoiceAmount = finalAmount.toFixed(2);
        let model = {
            SaleOrderID: parseInt($("#SaleOrderID").val() || 0),
            OrderNo: $("#OrderNo").val(),
            OrderDate: $("#OrderDate").val(),
            PartyID: parseInt($("#ddlPartyGST option:selected").val() || 0),
            BrokerID: ($("#ddlBroker option:selected").val() || ""),
            MarkupPercent: parseFloat($("#Markup").val() || 0),
            TransportID: ($("#ddlTransport option:selected").val() || ""),
            TotalQty: totalQty,
            TotalAmount: totalAmount,
            DiscountType: ($("#discountType").val() || ""),
            AdditionalRemark: ($("#AdditionalText").val() || ""),
            AdditionalValue: parseFloat($("#AdditionalValue").val() || 0),
            DiscountPercent: value,
            DiscountAmount: discountAmount,
            GSTPercent: gstPercent,
            GSTAmount: gstAmount,
            InvoiceAmount: invoiceAmount,
            Remark: $("#MainRemark").val(),
            Details: SaleOrderDetails
        };
        console.log("FINAL SAVE MODEL:", model);
        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/SaveSaleOrder",
            type: "POST",
            data: JSON.stringify({ model: model }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {

                let data = res.d;
                hideLoader(); // ✅ HIDE LOADER

                if (data.success) {
                    notes.show("Saved Successfully ✅", {
                        type: 'success',

                    });
                    window.location.href = 'listSaleOrderEntry';
                    $("#SaleOrderID").val(data.id);

                    console.log("Saved ID:", data.id);
                } else {
                    $("#btnSave").prop("disabled", false);
                    alert(data.message);
                }
            },
            error: function (err) {

                hideLoader(); // ✅ HIDE LOADER
                $("#btnSave").prop("disabled", false);
                console.error("Error:", err);
                alert("Save Failed ❌");
            }
        });
    }
    function formatDateFromDotNet(dateStr) {
        if (!dateStr) return "";
        let timestamp = parseInt(dateStr.replace(/\/Date\((\d+)\)\//, '$1'));
        let date = new Date(timestamp);

        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }
    function calculateRow(item, markup) {
        const rate = parseFloat(item.Rate) || 0;
        const brokerRate = calculateBrokerRate(rate, markup);

        return {
            ...item,
            BrokerRate: brokerRate,
            Amount: (parseFloat(item.Qty) || 0) * brokerRate
        };
    }
    function noDataRow() {
        return `<tr class="no-data"><td colspan="5">No Data</td></tr>`;
    } 
    $("#btnAddToOrder").click(function () {

        const designId = $("#DesignNo").val();
        const designName = $("#DesignNo option:selected").text().trim();

        const typeId = $("#TypeRow").val();
        const type = $("#TypeRow option:selected").text().trim();

        const unitId = $("#UnitRow").val();
        const unit = $("#UnitRow option:selected").text().trim();

        const colorGroupId = $("#ddlColourGroup").val();
        const colorGroupName = $("#ddlColourGroup option:selected").text().trim();

        const markup = parseFloat($("#Markup").val()) || 0;
        const designRemark = $("#DesignSelectionRemark").val() || "";

        if (!designId || designId == "-1")
            return Swal.fire("Error", "Select Design", "error");

        if (!colorGroupId || colorGroupId == "-1")
            return Swal.fire("Error", "Select Color Group", "error");

        let uniqueMap = {};

        // 🔥 GET RATE FROM TABLE (NOT DROPDOWN)
        let firstRow = $("#itemTableBody tr").not(".no-data").first();

        let saleRate = 0;

        if (firstRow.length > 0) {
            saleRate = parseFloat(firstRow.attr("data-rate")) || 0;
        }

        // fallback (new entry case)
        if (!saleRate) {
            saleRate = parseFloat($("#DesignNo option:selected").data("salerate")) || 0;
        }

        // ===========================
        // ✅ COLLECT COLORS
        // ===========================
        $("#itemTableBody tr").not(".no-data").each(function () {

            let row = $(this);

            let colorId = row.attr("data-colorid");
            let colorName = row.find("td:eq(4)").text().trim();
            let qty = parseFloat(row.find("td:eq(5)").text()) || 0;
            let remark = row.find("td:eq(6)").text().trim() || "";

            // 🔥 get rate from each row
            let rowRate = parseFloat(row.attr("data-rate")) || saleRate;

            if (!colorId || qty <= 0) return;

            if (uniqueMap[colorId]) {

                uniqueMap[colorId].Qty += qty;

                if (remark && !uniqueMap[colorId].Remark.includes(remark)) {
                    uniqueMap[colorId].Remark += ', ' + remark;
                }

            } else {

                uniqueMap[colorId] = {
                    ColorMatchingID: colorId,
                    ColorMatchingName: colorName,
                    Qty: qty,
                    Remark: remark,
                    Rate: rowRate   // ✅ correct rate
                };
            }
        });

        let subDetails = Object.values(uniqueMap);

        if (subDetails.length === 0)
            return Swal.fire("Error", "Add color first", "error");

        let totalQty = subDetails.reduce((sum, x) => sum + x.Qty, 0);

        // ===========================
        // ✅ CALCULATE BROKER RATE
        // ===========================
        let brokerRate = calculateBrokerRate(saleRate, markup);

        // ===========================
        // ✅ CREATE OBJECT
        // ===========================
        const obj = {
            DesignId: designId,
            DesignNo: designName,
            TypeId: typeId,
            Type: type,
            UnitId: unitId,
            Unit: unit,
            ColorGroupId: colorGroupId,
            ColorGroup: colorGroupName,
            Remark: designRemark,
            TotalQty: totalQty,
            NoOfColors: subDetails.length,
            Rate: saleRate,
            BrokerRate: brokerRate,
            Amount: totalQty * brokerRate,
            SubDetails: subDetails
        };

        // ===========================
        // ✅ CHECK EXISTING
        // ===========================
        let existingIndex = SaleOrderDetails.findIndex(item =>
            item.DesignId === obj.DesignId
        );

        // ===========================
        // ✅ EDIT MODE (RATE LOCK)
        // ===========================
        if (isEditMode && currentViewIndex !== -1) {

            let old = SaleOrderDetails[currentViewIndex];

            // 🔥 KEEP OLD RATE (IMPORTANT)
            obj.Rate = old.Rate;
            obj.BrokerRate = old.BrokerRate;
            obj.Amount = obj.TotalQty * obj.BrokerRate;

            SaleOrderDetails[currentViewIndex] = obj;
        }

        // ===========================
        // ✅ EXISTING MERGE (RATE LOCK)
        // ===========================
        else if (existingIndex !== -1) {

            let existing = SaleOrderDetails[existingIndex];

            // ❌ DO NOT CHANGE RATE
            // existing.Rate = obj.Rate;
            // existing.BrokerRate = obj.BrokerRate;

            // ✅ ONLY UPDATE QTY
            existing.TotalQty += obj.TotalQty;

            // ✅ KEEP OLD RATE
            existing.Amount = existing.TotalQty * existing.BrokerRate;

            existing.Remark = obj.Remark;

            obj.SubDetails.forEach(newItem => {

                let match = existing.SubDetails.find(x =>
                    x.ColorMatchingID === newItem.ColorMatchingID
                );

                if (match) {
                    match.Qty += newItem.Qty;

                    if (newItem.Remark && !match.Remark.includes(newItem.Remark)) {
                        match.Remark += ', ' + newItem.Remark;
                    }

                } else {
                    existing.SubDetails.push(newItem);
                }
            });

            existing.NoOfColors = existing.SubDetails.length;
        } else {
            SaleOrderDetails.push(obj);
        }

        // ===========================
        // ✅ RESET STATE
        // ===========================
        currentViewIndex = -1;
        isEditMode = false;

        // ===========================
        // ✅ REFRESH UI
        // ===========================
        bindMainTable();
        updateSummary();
        resetModal();
    });
