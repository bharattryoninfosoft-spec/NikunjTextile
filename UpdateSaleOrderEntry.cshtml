    function getDesignNo(DesignEntryFormID, DesignColorMatchingFormID) {

        $("#divColorMatchingTable").html('');

        listDesignColorMatchingDetails = [];
        listDesignEntryWeftData = [];

        if (DesignEntryFormID && DesignColorMatchingFormID) {

            var formData = new FormData();
            formData.append('DesignEntryFormID', DesignEntryFormID);
            formData.append('DesignColorMatchingFormID', DesignColorMatchingFormID);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getCreateColorMatchingFormDetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {

                    //console.log(response);

                    // 🔥 IMAGE
                    let imgStr = `<img src="${response.listDesignColorMatchingForm[0].PhotoOfDesign}"  style="width:100%; height:100%;">`;

                    $("#upload-PhotoOfDesign-default-preview").html(imgStr);

                    // 🔥 LENGTH DATA
                    let data = response.listDesignColorMatchingForm[0];

                    $("#weftLength").val(data.TotalWeft);
                    $("#warpLength").val(data.TotalWarp);
                    $("#WarpCheckBox").val(data.WarpCheckBox);
                    $("#WeftCheckBox").val(data.WeftCheckBox);

                    // 🔥 COLOR MATCHING DROPDOWN
                    let $dropdown = $("#ColorMatchingID");
                    $dropdown.empty().append('<option value="">Select Color Matching</option>');

                    $.each(data.listDesignColorMatchingDetails, function (i, item) {
                        $dropdown.append(`
                        <option value="${item.DesignColorMatchingDetailsID}">
                            ${item.WarpMatchingID} - ${item.FeederMatchingID}
                        </option>
                    `);
                    });

                    // 🔥 STORE DATA
                    listDesignColorMatchingDetails.push(data.listDesignColorMatchingDetails);
                    listDesignEntryWeftData.push(data.listDesignEntryWeftData);
                    $("#Previousbtn").hide();
                    $("#Nextbtn").show();
                    if (data.listDesignColorMatchingDetails.length > 0) {
                        let firstId = data.listDesignColorMatchingDetails[0].DesignColorMatchingDetailsID;

                        $dropdown.val(firstId);   // 🔥 set selected value

                        // 🔥 trigger change manually
                        getColorMatchingId(document.getElementById("ColorMatchingID"));
                    }
                }
            });
        }
        else {
            $("#upload-PhotoOfDesign-default-preview").html('Photo Of Design.');
            $("#weftLength").val('');
            $("#warpLength").val('');
        }
    }
