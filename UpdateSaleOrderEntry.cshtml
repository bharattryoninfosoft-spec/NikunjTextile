            function bindPartyGST(selectedPartyId) {
                $.ajax({
                    url: '/WebServiceNikunjTextile.asmx/GetPartyList',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function (res) {

                        let data = (typeof res.d === "string") ? JSON.parse(res.d) : res.d;

                        console.log("Parsed Data:", data);

                        $("#ddlPartyGST").empty();
                        $("#ddlPartyGST").append('<option value="-1">Select</option>');

                        if (Array.isArray(data)) {
                            $.each(data, function (i, item) {
                                let displayText = (item.GSTIN ? (item.GSTIN + " - ") : "") + (item.PartyName || '');
                                $("#ddlPartyGST").append(`
                                            <option value="${item.PartyId}"
                                                    data-name="${item.PartyName || ''}"
                                                    data-gstin="${item.GSTIN || ''}"
                                                    data-address="${item.BillingAddress || ''}"
                                                    data-state="${item.State || ''}"
                                                    data-brokercode="${item.BrokerCode || 0}"
                                                    data-brokername="${item.BrokerName || ''}">
                                                ${displayText}
                                            </option>
                                        `);
                            });

                            if (selectedPartyId) {
                                let matchId = selectedPartyId;
                                if (selectedPartyId === true && data.length > 0) {
                                    let maxParty = data.reduce((prev, current) => (parseInt(prev.PartyId) > parseInt(current.PartyId)) ? prev : current, data[0]);
                                    matchId = maxParty ? maxParty.PartyId : null;
                                }
                                if (matchId) {
                                    $("#ddlPartyGST").val(String(matchId)).trigger("change");
                                }
                            }
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }
