            function bindTransport(selectedCode) {
                $.ajax({
                    url: '/WebServiceNikunjTextile.asmx/GetTransportList',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function (res) {

                        let data = res.d; // ✅ FIX

                        console.log("GetTransportList", data);

                        $("#ddlTransport").empty();
                        $("#ddlTransport").append('<option value="-1">Select Transport</option>');

                        $.each(data, function (i, item) {
                            $("#ddlTransport").append(`
                                <option value="${item.TransportCode}">
                                    ${item.TransportName}
                                </option>
                            `);
                        });

                        if (selectedCode && selectedCode !== true) {
                            $("#ddlTransport").val(selectedCode).trigger("change");
                        } else if (selectedCode === true && data && data.length > 0) {
                            var newTransport = data[0];
                            if (newTransport && newTransport.TransportCode) {
                                $("#ddlTransport").val(newTransport.TransportCode).trigger("change");
                            }
                        }
                    },
                    error: function (err) {
                        console.log(err);
                    }
                });
            }
            function addTransport() {

                $('#TransportForm')[0]?.reset();
                $('#TransportId').val(0);
                $('#transportModal').modal('show');
            }
            function saveTransport() {
                let isValid = true;

                $('.form-control').removeClass('is-invalid');

                let mobile = $('#MobileNo').val().trim();

                // Broker Name
                if (!$('#TransportName').val().trim()) {
                    $('#TransportName').addClass('is-invalid');
                    isValid = false;
                }
                if (!$('#gstTransport').val().trim()) {
                    $('#gstTransport').addClass('is-invalid');
                    isValid = false;
                }
                if (!$('#TransportPanNo').val().trim()) {
                    $('#TransportPanNo').addClass('is-invalid');
                    isValid = false;
                }
                if (!$('#ContactPerson').val().trim()) {
                    $('#ContactPerson').addClass('is-invalid');
                    isValid = false;
                }
                // Mobile Required
                if (!mobile) {
                    $('#MobileNo').addClass('is-invalid');
                    isValid = false;
                }

                // Mobile Format Check
                else if (!/^[6-9]\d{9}$/.test(mobile)) {
                    $('#MobileNo').addClass('is-invalid');
                    $('#MobileNo').siblings('.invalid-feedback').text("Invalid mobile number");
                    isValid = false;
                }


                if (!isValid) return;

                let obj = {
                    TransportId: parseInt($('#TransportId').val()) || 0,
                    TransportName: $('#TransportName').val(),
                    FirmName: $('#FirmName').val(),
                    ContactPerson: $('#ContactPerson').val(),
                    Email: $('#Email').val(),
                    MobileNo: $('#MobileNo').val(),
                    AlternateMobileNo: $('#AlternateMobileNo').val(),
                    Address: $('#Address').val(),
                    CityName: $('#CityName').val(),
                    PANCard: $('#TransportPanNo').val(),
                    GSTNo: $('#gstTransport').val(),
                    VehicleType: $('#VehicleType').val(),
                    IsActive: $('#IsActive').val() === "true"
                };

                $.ajax({
                    url: '/WebServiceNikunjTextile.asmx/SaveTransport',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ obj: obj }),
                    success: function (res) {

                        if (res.d === "success") {
                            showToast('success', 'Saved Successfully');
                            $('#TransportModal').modal('hide');
                            bindTransport(true);
                        }
                    }
                });
            }
            function showToast(type, msg) {

                const iconMap = {
                    success: "success",
                    error: "error",
                    danger: "error",
                    warning: "warning",
                    info: "info",
                    question: "question"
                };

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: iconMap[type] || "info", // fallback
                    title: msg,
                    showConfirmButton: false,
                    timer: 2000
                });
            }
