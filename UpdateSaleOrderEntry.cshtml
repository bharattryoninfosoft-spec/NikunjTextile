<script>
    let srNo = 1;
    let subDetails = [];
    let SaleOrderDetails = [];
    let isEditMode = true;        // ✅ ADD THIS
    let currentViewIndex = -1;
    let currentId = null;
    let uniqueMap = {};
    console.log("SaleOrderDetails", SaleOrderDetails);
    console.log("subDetails", subDetails);
    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#finance-tab").addClass("active");
        $("#tab-finance").addClass("show active");
        $("#aSaleOrderEntry").addClass("current-page");
        const urlParams = new URLSearchParams(window.location.search);
        //debugger;
        const id = urlParams.get('id');

        FunctionIsLogin();
        bindPartyGST();
        bindBrokerDropdown();
        bindTransport();
        getItemGST();
        getStates(0);

        $("#PartyName").prop("disabled", true);
        $("#PartyAddress").prop("disabled", true);
        $("#Broker").prop("disabled", true);
        let today = new Date();
        let day = String(today.getDate()).padStart(2, '0');
        let month = String(today.getMonth() + 1).padStart(2, '0');
        let year = today.getFullYear();
        let formattedDate = `${year}-${month}-${day}`; // ✅ IMPORTANT
        $("#OrderDate").val(formattedDate);
        if (id) {
            loadSaleOrder(id);
            getDesignEntryForm();
        }
    });

    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    $("#discountType").on("change", function () {

        if ($(this).val() === "percent") {
            $("#discountValue").attr("placeholder", "Enter %");
        } else {
            $("#discountValue").attr("placeholder", "Enter ₹");
        }
    });
    $("#discountValue").on("input", updateSummary);
    $("#discountType").on("change", updateSummary);
    $("#gstPercent").on("input", updateSummary);
    $("#discountPercent").on("keypress", function (e) {
        if (e.key === "%") return true;

        if (!/[0-9.]/.test(e.key)) {
            e.preventDefault();
        }
    });
    $("#GSTSLABId").on("change", function () {

        let selectedText = $("#GSTSLABId option:selected").text();

        // 🔥 Extract number from text (e.g. "GST 5%" → 5)
        let percent = parseFloat(selectedText.replace(/[^\d.]/g, "")) || 0;

        // ✅ Set to input
        $("#gstPercent").val(percent);

        // 🔥 Update calculation
        updateSummary();
    });
    $("#AddPartyModel").on("click", function () {

        // Clear all fields
        $(".clear-field").val("");

        // Reset dropdowns
        $("#SundryParty").val("0");
        $("#placeOfSupply").val("-1");
        $("#Broker").val("-1");

        // Checkbox default
        $("#chcekIsActiveParty").prop("checked", true);

        // Hide update button, show save
        $("#editbtn").hide();
        $("#savebtn").show();
        $("#saveViewbtn").show();

        // Title change
        $("#addNewContactLabel").text("Add Party");
    });
