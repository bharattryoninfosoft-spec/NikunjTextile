    @section Scripts{
        <script>
            $('body').addClass('fullscreen');
            let srNo = 1;
            let subDetails = [];
            let SaleOrderDetails = [];
            let isEditMode = true;
            let currentViewIndex = -1;
            let currentId = null;
            let uniqueMap = {};
            var AdditionalRemarksArray = [];      
            $(document).ready(function () {
                const urlParams = new URLSearchParams(window.location.search);
                const id = urlParams.get('id');
                FunctionIsLogin();
                bindPartyGST();
                bindBrokerDropdown();
                bindTransport();
                getItemGST();
                getStates(0);
                AdditionalRemarks();

                $("#PartyName").prop("disabled", true);
                $("#PartyAddress").prop("disabled", true);
                $("#Broker").prop("disabled", true);

                let today = new Date();
                let day = String(today.getDate()).padStart(2, '0');
                let month = String(today.getMonth() + 1).padStart(2, '0');
                let year = today.getFullYear();
                let formattedDate = `${year}-${month}-${day}`;
                $("#OrderDate").val(formattedDate);

                if (id) {
                    loadSaleOrder(id);
                    getDesignEntryForm();
                }
            });         
            var notes = $('#notes').notify({
                removeIcon: '<i class="icon-close"></i>'
            });
            var notess = $('#notess').notify({
                removeIcon: '<i class="icon-close"></i>'
            });
            // Open Image Preview Modal on Thumbnail Click
            $(document).on("click", "#SaleOrderDetails tbody tr td img", function (e) {
                e.stopPropagation(); // Prevents triggering row selection/view events
                let imgSrc = $(this).attr("src");
                if (imgSrc) {
                    $("#previewModalImg").attr("src", imgSrc);
                    $("#imagePreviewModal").modal("show");
                }
            });
            $("#discountType").on("change", function () {

                if ($(this).val() === "Percentage") {
                    $("#discountValue").attr("placeholder", "Enter %");
                } else {
                    $("#discountValue").attr("placeholder", "Enter \u20B9");
                }
            });
            $("#discountValue").on("input", updateSummary);
            $("#discountType").on("change", updateSummary);
            $("#gstPercent").on("input", updateSummary);
            $("#discountPercent").on("keypress", function (e) {
                if (e.key === "%") return true;

                if (!/[0-9.]/.test(e.key)) {
                    e.preventDefault();
                }
            });
            // ✅ Unified GST Slab Change & Calculation Trigger
            $(document).on("change", "#GSTSLABId", function () {
                let selectedText = $("#GSTSLABId option:selected").text();

                // 🔥 Extract numeric percentage from text (e.g., "GST 5%" or "5%" -> 5)
                let percent = parseFloat(selectedText.replace(/[^\d.]/g, "")) || 0;

                // If the default option "Select GST" or value is 0, reset percent
                if ($(this).val() === "0" || $(this).val() === "-1") {
                    percent = 0;
                }

                // Set value to hidden/text input
                $("#gstPercent").val(percent);

                // Trigger recalculation
                updateSummary();
            });
            $("#AddPartyModel").on("click", function () {

                // Clear all fields
                $(".clear-field").val("");

                // Reset dropdowns
                $("#SundryParty").val("0");
                $("#placeOfSupply").val("-1");
                $("#Broker").val("-1");

                // Checkbox default
                $("#chcekIsActiveParty").prop("checked", true);

                // Hide update button, show save
                $("#editbtn").hide();
                $("#savebtn").show();
                $("#saveViewbtn").show();

                // Title change
                $("#addNewContactLabel").text("Add Party");
            });

            var partyColourHistoryData = [];

            function findItemTableRow(colorId, colorName) {
                let targetId = String(colorId || "").trim();
                let targetName = String(colorName || "").trim().toLowerCase();
                return $("#itemTableBody tr").filter(function () {
                    let rowId = String($(this).attr("data-colorid") || "").trim();
                    let rowName = String($(this).attr("data-colorname") || $(this).find("td:eq(4)").text() || "").trim().toLowerCase();
                    return rowId === targetId && rowName === targetName;
                });
            }

            function findHistoryTableRow(colorId, colorName) {
                let targetId = String(colorId || "").trim();
                let targetName = String(colorName || "").trim().toLowerCase();
                return $("#colourHistoryTableBody tr").filter(function () {
                    let rowId = String($(this).attr("data-colorid") || "").trim();
                    let rowName = String($(this).attr("data-colorname") || $(this).find(".chk-history-color").attr("data-colorname") || "").trim().toLowerCase();
                    return rowId === targetId && rowName === targetName;
                });
            }

            function resetColourHistory() {
                partyColourHistoryData = [];
                $("#colourHistoryTableBody").html(`
                    <tr class="no-history-data">
                        <td colspan="2" class="text-center text-muted py-2 small">
                            No Previous Order Colour History
                        </td>
                    </tr>
                `);
                $("#chkHistorySelectAll").prop("checked", false);
                $("#txtHistoryQty").val("");
            }

            function loadPartyPreviousOrderColourHistory(partyId) {
                partyColourHistoryData = [];
                resetColourHistory();

                let pid = parseInt(partyId, 10);
                if (!pid || pid <= 0) return;

                $.ajax({
                    type: "POST",
                    url: "/WebServiceNikunjTextile.asmx/GetPartyPreviousOrderColourHistory",
                    data: JSON.stringify({ partyId: pid }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        let res = response.d;
                        if (typeof res === "string") {
                            try { res = JSON.parse(res); } catch (e) { }
                        }

                        if (res && (res.Status === true || res.Status === "true" || res.Code === 200) && res.Data) {
                            partyColourHistoryData = res.Data;
                        } else if (Array.isArray(res)) {
                            partyColourHistoryData = res;
                        } else {
                            partyColourHistoryData = [];
                        }

                        if ($("#designModal").hasClass("show") || $("#designModal").is(":visible")) {
                            filterAndShowColourHistory();
                        }
                    },
                    error: function (xhr) {
                        console.error("Error loading party color history:", xhr);
                        partyColourHistoryData = [];
                    }
                });
            }

            function isDesignMatch(historyItem, selectedDesignVal, selectedDesignText) {
                if (!historyItem) return false;

                if (selectedDesignVal && historyItem.DesignID) {
                    let hVal = String(historyItem.DesignID).trim();
                    let sVal = String(selectedDesignVal).trim();
                    if (hVal !== "" && sVal !== "") {
                        if (hVal === sVal) return true;
                        let hPart = hVal.split('|')[0].trim();
                        let sPart = sVal.split('|')[0].trim();
                        if (hPart !== "" && sPart !== "" && hPart === sPart) return true;
                    }
                }

                if (selectedDesignText && historyItem.DesignNo) {
                    let normH = String(historyItem.DesignNo).replace(/[\s\-_]/g, '').toLowerCase();
                    let normS = String(selectedDesignText).replace(/[\s\-_]/g, '').toLowerCase();
                    if (normH !== "" && normS !== "") {
                        if (normH === normS || normS.includes(normH) || normH.includes(normS)) return true;
                    }
                }

                return false;
            }

            let currentLockedProductionDetails = [];

            function isSubDetailLocked(sub) {
                if (!sub || !currentLockedProductionDetails || currentLockedProductionDetails.length === 0) return false;
                let normalize = s => String(s || "").toLowerCase().replace(/[\/\-_]/g, ' ').replace(/\s+/g, ' ').trim();
                let subId = parseInt(sub.SubDetailID || 0);
                let colorId = parseInt(sub.ColorMatchingID || sub.ColourID || 0);
                let colorName = normalize(sub.ColorMatchingName || sub.ColourName || "");

                return currentLockedProductionDetails.some(function (p) {
                    let pSubId = parseInt(p.SubDetailID || 0);
                    let pColorId = parseInt(p.ColourMatchingID || 0);
                    let pColorName = normalize(p.ColourMatchingName || "");

                    if (subId > 0 && pSubId > 0 && subId === pSubId) return true;
                    if (colorId > 0 && pColorId > 0 && colorId === pColorId) return true;
                    if (colorName !== "" && pColorName !== "" && (colorName === pColorName || colorName.includes(pColorName) || pColorName.includes(colorName))) return true;
                    if (pSubId === 0 && pColorId === 0 && pColorName === "") return true;

                    return false;
                });
            }

            function matchesHighlightColor(colorName, designNo) {
                if (!colorName) return false;
                let urlParams = new URLSearchParams(window.location.search);
                let targetHighlightColor = (urlParams.get('highlightColor') ||
                                            urlParams.get('color') ||
                                            urlParams.get('colour') || '').trim();
                if (!targetHighlightColor) return false;

                let targetHighlightDesign = (urlParams.get('highlightDesign') ||
                                             urlParams.get('design') ||
                                             urlParams.get('designNo') || '').trim();

                let normalize = s => String(s || "").toLowerCase().replace(/[\/\-_]/g, ' ').replace(/\s+/g, ' ').trim();

                if (targetHighlightDesign) {
                    if (!designNo) {
                        if (typeof currentViewIndex !== "undefined" && currentViewIndex !== -1 && typeof SaleOrderDetails !== "undefined" && SaleOrderDetails[currentViewIndex]) {
                            designNo = SaleOrderDetails[currentViewIndex].DesignNo || SaleOrderDetails[currentViewIndex].DesignName || "";
                        } else if ($("#DesignNo option:selected").length > 0) {
                            designNo = $("#DesignNo option:selected").text().trim();
                        }
                    }
                    if (designNo) {
                        let d1 = normalize(designNo);
                        let d2 = normalize(targetHighlightDesign);
                        let dMatch = (d1 === d2 || (d1.length > 2 && d2.length > 2 && (d1.includes(d2) || d2.includes(d1))));
                        if (!dMatch) return false;
                    }
                }

                let n1 = normalize(colorName);
                let n2 = normalize(targetHighlightColor);
                if (n1 === n2) return true;
                if (n1.length > 3 && n2.length > 3 && (n1.includes(n2) || n2.includes(n1))) return true;
                return false;
            }

            function filterAndShowColourHistory() {
                let selectedDesignVal = $("#DesignNo").val();
                let selectedDesignText = $("#DesignNo option:selected").text().trim();

                if (!selectedDesignVal || selectedDesignVal === "-1" || selectedDesignVal === "") {
                    $("#colourHistoryTableBody").html(`
                        <tr class="no-history-data">
                            <td colspan="2" class="text-center text-muted py-2 small">
                                Select a Design to view history
                            </td>
                        </tr>
                    `);
                    $("#chkHistorySelectAll").prop("checked", false);
                    return;
                }

                if (!partyColourHistoryData || partyColourHistoryData.length === 0) {
                    $("#colourHistoryTableBody").html(`
                        <tr class="no-history-data">
                            <td colspan="2" class="text-center text-muted py-2 small">
                                No Previous Order Colour History
                            </td>
                        </tr>
                    `);
                    $("#chkHistorySelectAll").prop("checked", false);
                    return;
                }

                let matchedHistory = partyColourHistoryData.filter(function (h) {
                    return isDesignMatch(h, selectedDesignVal, selectedDesignText);
                });

                if (matchedHistory.length === 0) {
                    $("#colourHistoryTableBody").html(`
                        <tr class="no-history-data">
                            <td colspan="2" class="text-center text-muted py-2 small">
                                No Previous Order Colour History for this Design
                            </td>
                        </tr>
                    `);
                    $("#chkHistorySelectAll").prop("checked", false);
                    return;
                }

                let rowsHtml = "";
                matchedHistory.forEach(function (item) {
                    let $existingRow = findItemTableRow(item.ColourID, item.ColourName);
                    let isAlreadyInTable = $existingRow.length > 0;
                    let isHighlighted = matchesHighlightColor(item.ColourName, item.DesignNo || selectedDesignText);
                    let isLocked = isSubDetailLocked(item);

                    rowsHtml += `
                        <tr class="${isHighlighted ? "erp-highlighted-history-row" : ""} ${isLocked ? "erp-locked-history-row" : ""}" data-colorid="${item.ColourID}" data-colorname="${escapeHtml(item.ColourName)}">
                            <td class="text-center">
                                <input type="checkbox" class="chk-history-color" 
                                       data-colorid="${item.ColourID}" 
                                       data-colorname="${escapeHtml(item.ColourName)}" 
                                       data-totalqty="${item.TotalQty}" 
                                       data-designno="${escapeHtml(item.DesignNo)}" 
                                       ${isAlreadyInTable ? "checked" : ""}
                                       ${isLocked ? "disabled title='LOCKED: Linked to Production Order'" : ""}
                                       style="cursor: ${isLocked ? "not-allowed" : "pointer"}; width: 14px; height: 14px;" />
                            </td>
                            <td class="small fw-semibold text-truncate" title="Previous Qty: ${item.TotalQty}">
                                ${isHighlighted ? `<span class="erp-color-highlight"><i class="fa fa-hand-o-right me-1 text-danger"></i>${escapeHtml(item.ColourName)}</span>` : escapeHtml(item.ColourName)}
                                ${isLocked ? `<i class="fa fa-lock text-warning ms-1" title="LOCKED: Linked to Production Order"></i>` : ""}
                            </td>
                        </tr>
                    `;
                });

                $("#colourHistoryTableBody").html(rowsHtml);
                $("#pnlColourHistory").show();
                updateHistorySelectAllState();
            }

