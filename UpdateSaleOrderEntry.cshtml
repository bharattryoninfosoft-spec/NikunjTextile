            $(document).on("input change", "#Markup", function () {

    let markup = parseFloat($(this).val()) || 0;

    if (markup < 0) {
        markup = 0;
        $(this).val(0);
    }

    SaleOrderDetails.forEach(item => {

        // Manual rate ko Markup se overwrite mat karo
        if (item.IsRateManual) {
            return;
        }

        let baseRate = parseFloat(item.Rate) || 0;

        let brokerRate =
            baseRate + (baseRate * markup / 100);

        item.BrokerRate = brokerRate;

        item.Amount =
            (parseFloat(item.TotalQty) || 0) * brokerRate;

        // SubDetails rate sync
        if (Array.isArray(item.SubDetails)) {

            item.SubDetails.forEach(sub => {
                sub.Rate = brokerRate;
            });
        }
    });

    // Refresh table + complete calculation
    bindMainTable();
    updateSummary();
});


