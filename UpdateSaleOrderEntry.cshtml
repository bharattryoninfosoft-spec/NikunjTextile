    function checkNext() {

        let $ddl = $("#ColorMatchingID");
        let $options = $ddl.find("option:not(:first)"); // skip default

        let index = $options.index($options.filter(":selected"));

        if (index < $options.length - 1) {
            let nextVal = $options.eq(index + 1).val();

            $ddl.val(nextVal).trigger("change"); // 🔥 important
        }

        updateNavButtons();
    }
    function checkPrevious() {

        let $ddl = $("#ColorMatchingID");
        let $options = $ddl.find("option:not(:first)");

        let index = $options.index($options.filter(":selected"));

        if (index > 0) {
            let prevVal = $options.eq(index - 1).val();

            $ddl.val(prevVal).trigger("change"); // 🔥 important
        }

        updateNavButtons();
    }
    function updateNavButtons() {

        let $ddl = $("#ColorMatchingID");
        let $options = $ddl.find("option:not(:first)");
        let index = $options.index($options.filter(":selected"));

        $("#Previousbtn").toggle(index > 0);
        $("#Nextbtn").toggle(index < $options.length - 1);
    }
