                    console.log("master", master);
                    $("#GSTSLABId option").each(function () {
                        let percent = parseFloat($(this).data("percent")) || 0;
                        if (percent === gstPercent) {
                            $("#GSTSLABId").val($(this).val());
                        }
                    });

                    // ==============================
                    // 🔹 DROPDOWNS
                    // ==============================
                    setTimeout(() => {
                        $("#ddlPartyGST").val(master.PartyID).trigger('change');
                        $("#ddlBroker").val(master.BrokerID).trigger('change');
                        $("#ddlTransport").val(master.TransportID).trigger('change');
                        $("#GSTSLABId").trigger("change");
                    }, 150);

                    // ==============================
                    // 🔥 MAIN DATA BUILD
                    // ==============================
                    SaleOrderDetails = [];

                    if (master.Details && master.Details.length > 0) {

                        master.Details.forEach(item => {

                            let uniqueMap = {};

                            // ==========================
                            // 🔹 SUB DETAILS GROUP
                            // ==========================
                            if (item.SubDetails && item.SubDetails.length > 0) {

                                item.SubDetails.forEach(sub => {

                                    let colorId = String(sub.ColorDetailsID || sub.ColorMatchingID || "").trim();
                                    let qty = parseFloat(sub.Qty) || 0;

                                    if (!colorId || qty <= 0) return;

                                    let colorName = (sub.ColorMatchingName || sub.ColourName || "").trim();

                                    if (uniqueMap[colorId]) {

                                        uniqueMap[colorId].Qty += qty;

                                    } else {

                                        uniqueMap[colorId] = {
                                            ColorMatchingID: colorId,
                                            ColorMatchingName: colorName,
                                            Qty: qty,
                                            Rate: parseFloat(sub.Rate) || parseFloat(item.Rate) || 0,
                                            ImageUrl: sub.ImageUrl || "",
                                            Remark: sub.Remark || sub.DetailsRemark || ""
                                        };
                                    }

                                });
                            }

                            let subDetails = Object.values(uniqueMap);

                            // ==========================
                            // 🔹 MAIN OBJECT
                            // ==========================
                            const obj = {
                                DesignId: item.DesignId,
                                DesignNo: item.DesignName,
                                TypeId: item.TypeID,
                                Type: item.Type,
                                UnitId: item.UnitId,
                                Unit: item.Unit,
                                ColorGroupId: item.ColorGroupId,
                                ColorGroup: item.ColorGroup,
                                Remark: item.DetailsRemark || "",

                                SubDetails: subDetails,

                                TotalQty: subDetails.reduce((sum, x) => sum + x.Qty, 0),
                                NoOfColors: subDetails.length,

                                Rate: parseFloat(item.Rate) || 0,
                                BrokerRate: parseFloat(item.BrokerRate) || parseFloat(item.Rate) || 0,

                                Amount: subDetails.reduce((sum, x) => {
                                    let rate = x.Rate || item.Rate || 0;
                                    return sum + (x.Qty * rate);
                                }, 0),

                                SelectedColorId: subDetails.length > 0 ? subDetails[0].ColorMatchingID : null
                            };

                            // ==========================
                            // 🔹 MERGE SAME DESIGN
                            // ==========================
                            let existingIndex = SaleOrderDetails.findIndex(x =>
                                x.DesignId === obj.DesignId
                            );

                            if (existingIndex !== -1) {

                                let existing = SaleOrderDetails[existingIndex];

                                obj.SubDetails.forEach(newItem => {

                                    let match = existing.SubDetails.find(x =>
                                        x.ColorMatchingID === newItem.ColorMatchingID
                                    );

                                    if (match) {
                                        match.Qty += newItem.Qty;
                                        match.Rate = newItem.Rate || match.Rate;
                                    } else {
                                        existing.SubDetails.push(newItem);
                                    }

                                });

                                // ✅ Recalculate (IMPORTANT)
                                existing.TotalQty = existing.SubDetails.reduce((sum, x) => sum + x.Qty, 0);

                                existing.Amount = existing.SubDetails.reduce((sum, x) => {
                                    let rate = x.Rate || existing.Rate || 0;
                                    return sum + (x.Qty * rate);
                                }, 0);

                                existing.NoOfColors = existing.SubDetails.length;

                            } else {
                                SaleOrderDetails.push(obj);
                            }

                        });
                    }

                    // ==============================
                    // 🔹 FINAL UI BIND
                    // ==============================
                    bindMainTable();
                    updateSummary();

                } else {
                    alert(data?.Message || "No data found");
                }
            },

            error: function () {
                alert("Error loading data");
            }
        });
    }
    function bindMainTable() {

        const tbody = $("#orderBody");
        tbody.empty();

        if (SaleOrderDetails.length === 0) {
            tbody.html(`<tr><td colspan="12" class="text-center">No Data</td></tr>`);
            return;
        }

        SaleOrderDetails.forEach((item, index) => {

            let colorText = item.SubDetails.map((x, i) =>
                `${i + 1}. ${x.ColorMatchingName} - ${x.Qty}`
            ).join("<br>");

            let combinedRemark = item.SubDetails
                .map(x => x.Remark)
                .filter(x => x && x.trim() !== "")
                .join("<br>");

            let tr = `
         <tr data-index="${index}">

      <td class="col-srno">${index + 1}</td>

      <td class="col-design">${item.DesignNo}</td>

      <td class="col-type">${item.Type}</td>

      <td class="col-colors">${item.NoOfColors}</td>

      <td class="col-colorText">${colorText}</td>

      <td class="col-qty">${item.TotalQty}</td>

      <td class="col-unit">${item.Unit}</td>

      <td class="col-rate" hidden>${item.Rate}</td>

      <td class="col-brokerRate">
          <input type="number" 
                 class="form-control form-control-sm brokerRateInput" 
                 value="${item.BrokerRate || 0}" 
                 data-index="${index}" 
                 style="width:80px;" />
      </td>

      <td class="col-amount amountCell">${item.Amount}</td>

      <td class="col-remark">        
          <small style="color:gray">${combinedRemark}</small>
      </td>

      <td class="col-action" >
          <a class="viewSub"><i class="fa fa-eye text-secondary"></i></a>
          <a class="deleteMain"><i class="icon-x-circle text-danger"></i></a>
      </td>

  </tr>
        `;

            tbody.append(tr);
        });
    }
    function updateSummary() {

        let totalQty = 0;
        let totalAmount = 0;

        SaleOrderDetails.forEach(item => {
            totalQty += parseFloat(item.TotalQty) || 0;
            totalAmount += parseFloat(item.Amount) || 0;
        });

        $("#totalQty").text(totalQty);
        $("#totalAmount").text(totalAmount.toFixed(2));

        // 🔻 Discount
        let value = parseFloat($("#discountValue").val()) || 0;
        let type = $("#discountType").val();

        let discountAmount = (type === "percent")
            ? (totalAmount * value) / 100
            : value;

        if (discountAmount > totalAmount)
            discountAmount = totalAmount;

        $("#discountAmount").text(discountAmount.toFixed(2));

        let afterDiscount = totalAmount - discountAmount;

        // ✅ ADD THIS BLOCK (Additional)
        let additionalValue = parseFloat($("#AdditionalValue").val()) || 0;

        // 👉 choose + or - (IMPORTANT)
        let afterAdditional = afterDiscount + additionalValue;

        // show in UI
        $("#AdditionalAmount").text(additionalValue.toFixed(2));

        // 🔻 GST
        let gstPercent = parseFloat($("#gstPercent").val()) || 0;
        let gstAmount = (afterAdditional * gstPercent) / 100;

        $("#gstAmount").text(gstAmount.toFixed(2));

        // 🔻 Final
        let finalAmount = afterAdditional + gstAmount;

        $("#invoiceAmount").text(finalAmount.toFixed(2));
    }  
    function showLoader() {
        $("#loaderOverlay").css("display", "flex");
    }
    function hideLoader() {
        $("#loaderOverlay").hide();
    }
    function resetModal() {

        $("#itemTableBody").html(`
        <tr class="no-data">
            <td colspan="6" class="text-center">No Data Available</td>
        </tr>
    `);

        $("#DesignSelectionRemark").val("");
        $("#designModal").modal("hide");
            }
    $(document).on("change", ".brokerRateInput", function () {

        let index = $(this).data("index");
        let newRate = parseFloat($(this).val()) || 0;

        let item = SaleOrderDetails[index];

        // ✅ Manual override flag
        item.IsRateManual = true;

        item.Rate = newRate;
        item.BrokerRate = newRate;
        item.Amount = item.TotalQty * newRate;

        // ✅ Sync SubDetails
        if (item.SubDetails && item.SubDetails.length > 0) {
            item.SubDetails.forEach(sub => {
                sub.Rate = newRate;
            });
        }

        let row = $(this).closest("tr");

        row.find(".col-rate").text(item.Rate);
        row.find(".amountCell").text(item.Amount.toFixed(2));

        if (row.next().hasClass("child-row")) {
            bindSubTable(item.SubDetails);
        }

        updateSummary();
    });
    $("#AdditionalValue").on("input", function () {
        updateSummary();
    });
</script>



