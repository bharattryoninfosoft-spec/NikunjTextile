            $("#btnAddToOrder").click(function () {

                const designId = $("#DesignNo").val();
                const designName = $("#DesignNo option:selected").text().trim();

                const typeId = $("#TypeRow").val();
                const type = $("#TypeRow option:selected").text().trim();

                const unitId = $("#UnitRow").val();
                const unit = $("#UnitRow option:selected").text().trim();

                // 🔥 Modified: Color Group is now optional (fallback to empty string if not selected)
                const colorGroupId = $("#ddlColourGroup").val() || "";
                const colorGroupName = colorGroupId && colorGroupId !== "-1" ? $("#ddlColourGroup option:selected").text().trim() : "";

                const markup = parseFloat($("#Markup").val()) || 0;
                const designRemark = $("#DesignSelectionRemark").val() || "";

                // 🌟 READ ADDITIONAL REMARK & UNIT VALUE
                const addRemark = $("#AdditionalText").val().trim();
                const unitAddValue = parseFloat($("#AdditionalValue").val()) || 0;

                // ✅ CAPTURE DESIGN PREVIEW IMAGE URL
                const designImageUrl = $("#upload-ColorMatching-default-preview img").attr("src") || "";

                if (!designId || designId == "-1")
                    return Swal.fire("Error", "Select Design", "error");

                // ❌ Removed mandatory check for Color Group here:
                // if (!colorGroupId || colorGroupId == "-1")
                //     return Swal.fire("Error", "Select Color Group", "error");

                let uniqueMap = {};

                // Rate fetch logic
                let firstRow = $("#itemTableBody tr").not(".no-data").first();
                let saleRate = 0;

                if (firstRow.length > 0) {
                    saleRate = parseFloat(firstRow.attr("data-rate")) || 0;
                }

                if (!saleRate) {
                    saleRate = parseFloat($("#DesignNo option:selected").data("salerate")) || 0;
                }

                // Collect Colors (SubDetails)
                $("#itemTableBody tr").not(".no-data").each(function () {
                    let row = $(this);
                    let colorId = row.attr("data-colorid");
                    let colorName = row.find("td:eq(4)").text().trim();
                    let qtyInput = row.find(".sub-qty-input");
                    let qty = qtyInput.length > 0 ? (parseFloat(qtyInput.val()) || 0) : (parseFloat(row.find("td:eq(5)").text()) || 0);
                    let remark = row.find("td:eq(6)").text().trim() || "";
                    let rowRate = parseFloat(row.attr("data-rate")) || saleRate;
                    let rowImg = row.attr("data-img") || designImageUrl; // fallback to main image

                    if (!colorId || qty <= 0) return;

                    if (uniqueMap[colorId]) {
                        uniqueMap[colorId].Qty += qty;
                        if (remark && !uniqueMap[colorId].Remark.includes(remark)) {
                            uniqueMap[colorId].Remark += ', ' + remark;
                        }
                    } else {
                        uniqueMap[colorId] = {
                            ColorMatchingID: colorId,
                            ColorMatchingName: colorName,
                            Qty: qty,
                            Remark: remark,
                            Rate: rowRate,
                            ImageUrl: rowImg
                        };
                    }
                });

                let subDetails = Object.values(uniqueMap);
                if (subDetails.length === 0) return Swal.fire("Error", "Add color first", "error");

                let totalQty = subDetails.reduce((sum, x) => sum + x.Qty, 0);
                let brokerRate = calculateBrokerRate(saleRate, markup);

                let calculatedAddAmount = unitAddValue * totalQty;

                // 🌟 CREATE MAIN ITEM OBJECT WITH IMAGE INCLUDED
                const obj = {
                    DesignId: designId,
                    DesignNo: designName,
                    TypeId: typeId,
                    Type: type,
                    UnitId: unitId,
                    Unit: unit,
                    ColorGroupId: colorGroupId,
                    ColorGroup: colorGroupName,
                    Remark: designRemark,
                    TotalQty: totalQty,
                    NoOfColors: subDetails.length,
                    Rate: saleRate,
                    BrokerRate: brokerRate,
                    UnitAdditionalValue: unitAddValue,
                    AdditionalRemark: addRemark,
                    AdditionalValue: calculatedAddAmount,
                    Amount: (totalQty * brokerRate) + calculatedAddAmount,
                    ImageUrl: designImageUrl, // ✅ Saved in main object
                    SubDetails: subDetails
                };

                // Check existing item
                let existingIndex = SaleOrderDetails.findIndex(item => item.DesignId === obj.DesignId);

                if (isEditMode && currentViewIndex !== -1) {
                    let old = SaleOrderDetails[currentViewIndex];
                    obj.Rate = old.Rate;
                    obj.BrokerRate = old.BrokerRate;
                    obj.Amount = (obj.TotalQty * obj.BrokerRate) + calculatedAddAmount;

                    SaleOrderDetails[currentViewIndex] = obj;
                } else if (existingIndex !== -1) {
                    let existing = SaleOrderDetails[existingIndex];
                    existing.TotalQty += obj.TotalQty;
                    existing.UnitAdditionalValue = unitAddValue ? unitAddValue : existing.UnitAdditionalValue;
                    existing.AdditionalRemark = addRemark ? addRemark : existing.AdditionalRemark;
                    existing.AdditionalValue = existing.UnitAdditionalValue * existing.TotalQty;
                    existing.Amount = (existing.TotalQty * existing.BrokerRate) + existing.AdditionalValue;
                    existing.Remark = obj.Remark;
                    existing.ImageUrl = obj.ImageUrl || existing.ImageUrl;

                    obj.SubDetails.forEach(newItem => {
                        let match = existing.SubDetails.find(x => x.ColorMatchingID === newItem.ColorMatchingID);
                        if (match) {
                            match.Qty += newItem.Qty;
                            if (newItem.Remark && !match.Remark.includes(newItem.Remark)) {
                                match.Remark += ', ' + newItem.Remark;
                            }
                        } else {
                            existing.SubDetails.push(newItem);
                        }
                    });

                    existing.NoOfColors = existing.SubDetails.length;
                } else {
                    SaleOrderDetails.push(obj);
                }

                // Reset state & Refresh UI
                currentViewIndex = -1;
                isEditMode = false;

                bindMainTable();
                updateSummary();
                resetModal();
            });
            function createSubRow(
                designNo,
                designName,
                colorGroupId,
                colorGroupName,
                remark,
                colorId,
                colorName,
                qty,
                imageUrl = "",
                saleRate
            ) {
                return `
                    <tr data-colorid="${colorId}"data-colorgroupid="${colorGroupId}" data-rate="${saleRate}">
                    <td></td>
                    <td hidden>${designNo}</td>
                    <td hidden>${designName}</td>
                    <td hidden>${colorGroupName}</td>
                    <td>${colorName}</td>
                    <td><input type="number" class="form-control form-control-sm sub-qty-input text-center" value="${qty}" min="1" style="width: 75px;" /></td>
                    <td>${remark}</td>

                    <td>
                        <a href="#" class="deleteRow text-danger">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>`;
            }
            function formatImageUrl(url) {
                if (!url || typeof url !== 'string') return '/images/no-image.png';

                url = url.trim().replace(/^\/+/, ''); // Clean up leading slashes/spaces
                if (url === '') return '/images/no-image.png';

                // If it's already a full http/https URL, pass it through
                if (url.startsWith('http://') || url.startsWith('https://')) {
                    return url;
                }

                const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

                // Target domain for external or root-relative
                const baseDomain = isLocalhost ? 'https://weavelanesoft.in/' : '/';

                return baseDomain + url;
            }
            function bindMainTable() {
                const tbody = $("#orderBody");
                tbody.empty();

                if (SaleOrderDetails.length === 0) {
                    tbody.html(`<tr><td colspan="12" class="text-center">No Data Available</td></tr>`);
                    return;
                }

                // 🔥 Sum up all active per-unit additional charge inputs from all additional rows
                let totalAdditionalPerUnit = 0;
                $(".additional-row").each(function () {
                    let val = parseFloat($(this).find(".AdditionalValue").val()) || 0;
                    totalAdditionalPerUnit += val;
                });

                SaleOrderDetails.forEach((item, index) => {
                    let colorText = item.SubDetails.map((x, i) =>
                        `${i + 1}. ${x.ColorMatchingName} - ${x.Qty}`
                    ).join("<br>");

                    let combinedRemark = item.SubDetails
                        .map(x => x.Remark)
                        .filter(x => x && x.trim() !== "")
                        .join("<br>");

                    let designDisplay = item.DesignNo;
                    if (item.ImageUrl && item.ImageUrl.trim() !== "") {
                        let imgSrc = formatImageUrl(item.ImageUrl);

                        designDisplay = `
        <div class="d-flex align-items-center gap-2">
            <img src="${imgSrc}" alt="Design" 
                 style="width: 36px; height: 36px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" 
                 onerror="handleImageError(this, '${item.ImageUrl}')">
            <span>${item.DesignNo}</span>
        </div>`;
                    }

                    let baseRate = parseFloat(item.BrokerRate) || 0;

                    // 🔥 Effective Rate = Base Broker Rate + Sum of All Additional Charges per unit
                    let effectiveRate = baseRate + totalAdditionalPerUnit;

                    item.UnitAdditionalValue = totalAdditionalPerUnit;
                    item.Amount = parseFloat(item.TotalQty) * effectiveRate;

                    let tr = `
                        <tr data-index="${index}">
                            <td class="col-srno">${index + 1}</td>
                            <td class="col-design">${designDisplay}</td>
                            <td class="col-type">${item.Type}</td>
                            <td class="col-colors">${item.NoOfColors}</td>
                            <td class="col-colorText">${colorText}</td>
                            <td class="col-qty">${item.TotalQty}</td>
                            <td class="col-unit">${item.Unit}</td>
                            <td class="col-rate" hidden>${item.Rate}</td>
                            <td class="col-brokerRate">
                                <input type="number"
                                       class="form-control form-control-sm brokerRateInput"
                                       value="${effectiveRate}"
                                       data-index="${index}"
                                       style="width:80px;" />
                            </td>
                            <td class="col-amount amountCell">${parseFloat(item.Amount || 0).toFixed(2)}</td>
                            <td class="col-remark">
                                <div><b>${item.Remark || ''}</b></div>
                                <small style="color:gray">${combinedRemark}</small>
                            </td>
                            <td class="col-action">
                                <a class="viewSub"><i class="fa fa-eye text-secondary"></i></a>
                                <a class="deleteMain"><i class="icon-x-circle text-danger"></i></a>
                            </td>
                        </tr>`;

                    tbody.append(tr);
                });
            }
            function handleImageError(imgElement, originalUrl) {
                // If we haven't tried converting to uppercase yet
                if (!imgElement.dataset.triedUppercase && originalUrl) {
                    imgElement.dataset.triedUppercase = "true";

                    // Convert path & filename to UPPERCASE
                    let upperUrl = originalUrl.toUpperCase();
                    imgElement.src = formatImageUrl(upperUrl);
                } else {
                    // Fallback to placeholder if uppercase attempt also fails
                    imgElement.onerror = null;
                    imgElement.src = '/images/no-image.png';
                }
            }
            function updateSummary() {

                let totalQty = 0;
                let totalAmount = 0;

                // ============================================================
                // ADDITIONAL CHARGES PER UNIT
                // ============================================================

                let totalAdditionalPerUnit = 0;

                $(".additional-row").each(function () {
                    totalAdditionalPerUnit +=
                        parseFloat($(this).find(".AdditionalValue").val()) || 0;
                });


                // ============================================================
                // ITEM TOTAL
                // ============================================================

                SaleOrderDetails.forEach(item => {

                    let brokerRate =
                        parseFloat(item.BrokerRate) || 0;

                    let effectiveRate =
                        brokerRate + totalAdditionalPerUnit;

                    item.UnitAdditionalValue = totalAdditionalPerUnit;

                    item.Amount =
                        (parseFloat(item.TotalQty) || 0) * effectiveRate;

                    totalQty +=
                        parseFloat(item.TotalQty) || 0;

                    totalAmount +=
                        parseFloat(item.Amount) || 0;
                });


                // ============================================================
                // DISPLAY TOTAL
                // ============================================================

                $("#totalQty").text(totalQty);

                $("#totalAmount").text(
                    totalAmount.toFixed(2)
                );


                // ============================================================
                // DISCOUNT - PERCENTAGE IS THE ONLY INPUT
                // ============================================================

                let discountValPercent =
                    parseFloat($("#discountValuePercent").val()) || 0;

                // Validate percentage
                if (discountValPercent < 0) {
                    discountValPercent = 0;
                }

                if (discountValPercent > 100) {
                    discountValPercent = 100;
                }

                $("#discountValuePercent").val(discountValPercent);


                // Calculate discount ONLY from percentage
                let discountAmount =
                    (totalAmount * discountValPercent) / 100;

                // Safety
                if (discountAmount > totalAmount) {
                    discountAmount = totalAmount;
                }

                if (discountAmount < 0) {
                    discountAmount = 0;
                }


                // Update calculated amount
                $("#discountValueAmount").val(
                    discountAmount.toFixed(2)
                );

                $("#discountAmount").text(
                    discountAmount.toFixed(2)
                );

                let afterDiscount = totalAmount - discountAmount;
                // ============================================================
                // SHOW CALCULATED DISCOUNT AMOUNT
                // ============================================================

                $("#discountValueAmount").val(
                    discountAmount.toFixed(2)
                );

                $("#discountAmount").text(
                    discountAmount.toFixed(2)
                );

                // ============================================================
                // ADDITIONAL FIXED CHARGE
                // ============================================================

                let totalAdditionalValue = 0;

                $(".additional-row").each(function () {

                    let value =
                        parseFloat($(this).find(".AdditionalValue").val()) || 0;

                    // Since this is per-unit charge,
                    // total amount = value × total quantity
                    totalAdditionalValue +=
                        value * totalQty;
                });


                $("#AdditionalAmount").text(
                    totalAdditionalValue.toFixed(2)
                );


                // ============================================================
                // TAXABLE AMOUNT
                // ============================================================

                let taxableAmount = afterDiscount ;


                // ============================================================
                // GST
                // ============================================================

                let gstPercent =
                    parseFloat($("#gstPercent").val()) || 0;

                let gstAmount =
                    (taxableAmount * gstPercent) / 100;

                $("#gstAmount").text(
                    gstAmount.toFixed(2)
                );


                // ============================================================
                // FINAL TOTAL
                // ============================================================

                let finalAmount =
                    taxableAmount + gstAmount;

                let roundedAmount =
                    Math.round(finalAmount);

                let roundOff =
                    roundedAmount - finalAmount;


                $("#RoundOff").text(
                    roundOff.toFixed(2)
                );

                $("#invoiceAmount").text(
                    roundedAmount.toFixed(2)
                );
            }
            // Ensure change/input on any dynamic additional row input or remove button updates totals
            $(document).on("input change", ".AdditionalValue", function () {
                bindMainTable();
                updateSummary();
            });
            $(document).on("click", ".remove-additional", function () {
                $(this).closest(".summary-row").remove();
                bindMainTable();
                updateSummary();
            });
            $(document).on("change", ".brokerRateInput", function () {
                let index = $(this).data("index");
                let inputRate = parseFloat($(this).val()) || 0;
                let additionalPerUnit = parseFloat($(".additional-row:first .AdditionalValue").val()) || 0;

                // Extract base broker rate by subtracting additional charges
                let baseRate = inputRate - additionalPerUnit;
                let item = SaleOrderDetails[index];

                item.IsRateManual = true;
                item.Rate = baseRate;
                item.BrokerRate = baseRate;
                item.Amount = item.TotalQty * inputRate;

                if (item.SubDetails && item.SubDetails.length > 0) {
                    item.SubDetails.forEach(sub => {
                        sub.Rate = baseRate;
                    });
                }

                let row = $(this).closest("tr");
                row.find(".col-rate").text(item.Rate);
                row.find(".amountCell").text(item.Amount.toFixed(2));

                updateSummary();
            });
            $(document).on("click", ".viewSub", function () {

                const index = $(this).closest("tr").data("index");
                currentViewIndex = index;
                isEditMode = true;
                const item = SaleOrderDetails[index];
                $("#DesignNo").val(item.DesignId).trigger('change').prop("disabled", true);
                bindSubTable(item.SubDetails);
                bindFormFields(item);
                let selectedId = item.SelectedColorId || item.SubDetails?.[0]?.ColorMatchingID;
                if (selectedId) {
                    $("#ColorMatchingID").val(selectedId).trigger("change");
                    getColorMatchingId(document.getElementById("ColorMatchingID"));
                }
                $("#designModal").modal("show");
            });
            function bindSubTable(subData) {

                const $tbody = $("#itemTableBody");
                $tbody.empty();

                if (!Array.isArray(subData) || subData.length === 0) {
                    $tbody.html(noDataRow());
                    return;
                }

                let rows = "";

                let parent = currentViewIndex !== -1
                    ? SaleOrderDetails[currentViewIndex]
                    : null;

                subData.forEach((item, i) => {

                    // 🔥 ALWAYS USE LATEST RATE FROM PARENT
                    let saleRate = parent ? parent.BrokerRate : (item.Rate || 0);

                    rows += `
                    <tr data-colorid="${item.ColorMatchingID}"
                        data-colorgroupid="${item.ColorGroupId || ""}"
                        data-rate="${saleRate}"
                        data-img="${item.ImageUrl || ""}">

                        <td>${i + 1}</td>

                        <td hidden>${item.DesignNo || ""}</td>
                        <td hidden>${item.DesignName || ""}</td>
                        <td hidden>${item.ColorGroup || ""}</td>

                        <td>${item.ColorMatchingName}</td>

                        <td><input type="number" class="form-control form-control-sm sub-qty-input text-center" value="${item.Qty}" min="1" style="width: 75px;" /></td>

                        <td>${item.Remark || ""}</td>

                        <td>
                            <a href="javascript:void(0)" class="deleteRow text-danger">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>`;
                });

                $tbody.html(rows);
            }
            function bindFormFields(item) {

                $("#DesignNo").val(item.DesignId).trigger('change');

                $("#TypeRow").val(item.TypeId);
                $("#UnitRow").val(item.UnitId);

                $("#ddlColourGroup").val(item.ColorGroupId);

                $("#Remark").val(item.Remark);

                //$("#Markup").val(item.markup || 0);

                setTimeout(() => {

                    let firstSub = item.SubDetails[0];

                    if (firstSub) {
                        $("#ColorMatchingID").val(firstSub.ColorMatchingID);
                    }

                    getColorMatchingId(document.getElementById("ColorMatchingID"));

                }, 150);
            }
            function escapeHtml(text) {
                return $("<div>").text(text || "").html();
            }
            $(document).on("click", ".deleteRow", function () {

                let row = $(this).closest("tr");
                let colorId = row.attr("data-colorid");

                Swal.fire({
                    title: "Are you sure?",
                    text: "You want to delete this row!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, delete it!",
                    cancelButtonText: "Cancel"
                }).then((result) => {

                    if (result.isConfirmed) {

                        if (currentViewIndex !== -1) {

                            let subList = SaleOrderDetails[currentViewIndex].SubDetails;

                            SaleOrderDetails[currentViewIndex].SubDetails =
                                subList.filter(x => x.ColorMatchingID != colorId);

                            updateMainTotals(currentViewIndex);
                        }

                        row.remove();

                        let rows = $("#itemTableBody tr").not(".no-data");

                        if (rows.length === 0) {

                            $("#itemTableBody").html(noDataRow());
                            $("#ColorMatchingID").val("");
                            $("#upload-ColorMatching-default-preview").html("No Image");

                        } else {

                            let firstRow = rows.first();
                            let id = firstRow.attr("data-colorid");

                            $("#ColorMatchingID").val(id).trigger("change");
                            getColorMatchingId(document.getElementById("ColorMatchingID"));

                            if (currentViewIndex !== -1) {
                                SaleOrderDetails[currentViewIndex].SelectedColorId = id;
                            }
                        }

                        updateSrNo();

                        // ✅ Success message after delete
                        Swal.fire({
                            title: "Deleted!",
                            text: "Row has been deleted successfully.",
                            icon: "success",
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }
                });
            });
            function resetModal() {

                $("#itemTableBody").html(`
                    <tr class="no-data">
                        <td colspan="6" class="text-center">No Data Available</td>
                    </tr>
                `);

                $("#DesignSelectionRemark").val("");
                $("#designModal").modal("hide");
            }
            function saveSaleOrder() {
                let broker = $("#ddlBroker");
                let transport = $("#ddlTransport");
                let party = $("#ddlPartyGST");

                let isValid = true;

                // Validation checks
                if (!transport.val() || transport.val() === "-1") {
                    transport.addClass("is-invalid").removeClass("is-valid");
                    showToast("error", "Please select Transport");
                    isValid = false;
                } else {
                    transport.addClass("is-valid").removeClass("is-invalid");
                }

                if (!broker.val() || broker.val() === "-1") {
                    broker.addClass("is-invalid").removeClass("is-valid");
                    showToast("error", "Please select Broker");
                    isValid = false;
                } else {
                    broker.addClass("is-valid").removeClass("is-invalid");
                }

                if (!party.val() || party.val() === "-1") {
                    party.addClass("is-invalid").removeClass("is-valid");
                    showToast("error", "Please select Party");
                    isValid = false;
                } else {
                    party.addClass("is-valid").removeClass("is-invalid");
                }

                if (!SaleOrderDetails || SaleOrderDetails.length === 0) {
                    showToast("error", "Please add at least one design!");
                    isValid = false;
                }

                if (!isValid) return false;

                showLoader();
                $("#btnSave").prop("disabled", true);

                let totalQty = 0;
                let totalAmount = 0;

                // 🔥 Corrected Rate and Amount Calculation Logic for SaleOrderDetails
                SaleOrderDetails.forEach((item) => {
                    item.ItemType = item.TypeId || "";
                    if (!item.SubDetails) {
                        item.SubDetails = [];
                    }

                    let baseRate = parseFloat(item.Rate) || parseFloat(item.BrokerRate) || 0;
                    let brokerRate = parseFloat(item.BrokerRate) || baseRate;

                    item.Rate = baseRate;
                    item.BrokerRate = brokerRate;

                    let rowQty = 0;
                    item.SubDetails.forEach(sub => {
                        sub.ColourID = sub.ColorMatchingID || 0;
                        sub.ColourName = sub.ColorMatchingName || "";
                        sub.Unit = sub.Unit || item.Unit || "PCS";
                        sub.Rate = brokerRate;
                        rowQty += parseFloat(sub.Qty || 0);
                    });

                    item.NoOfColours = item.SubDetails.length;
                    item.Qty = rowQty;
                    item.Amount = rowQty * brokerRate; // Ensures correct calculation using effective broker rate

                    totalQty += rowQty;
                    totalAmount += item.Amount;
                });

                // Discount calculations
                let discountValPercent = parseFloat($("#discountValuePercent").val()) || 0;
                let discountValAmount = parseFloat($("#discountValueAmount").val()) || 0;
                let type = $("#discountType").val();
                let discountAmount = 0;

                if (discountValAmount > 0) {
                    discountAmount = discountValAmount;
                } else if (discountValPercent > 0) {
                    discountAmount = (totalAmount * discountValPercent) / 100;
                }

                if (discountAmount > totalAmount) {
                    discountAmount = totalAmount;
                }
                $("#discountAmount").text(discountAmount.toFixed(2));

                let afterDiscount = totalAmount - discountAmount;

                // Collect Dynamic Additional Charges rows for 'SaleOrderAdditionalCharges' table mapping
                let additionalChargesList = [];
                let totalAdditionalValue = 0;

                $(".additional-row").each(function () {
                    let remark = $(this).find(".AdditionalText").val().trim();
                    let chargeVal = parseFloat($(this).find(".AdditionalValue").val()) || 0;

                    if (chargeVal > 0 || remark !== "") {
                        let calculatedLineTotal = chargeVal * totalQty;

                        additionalChargesList.push({
                            ChargeRemark: remark,
                            ChargeValue: chargeVal,
                            TotalCalculatedAmount: calculatedLineTotal
                        });
                        totalAdditionalValue += chargeVal;
                    }
                });

                let afterAdditional = afterDiscount + totalAdditionalValue;
                let gstPercent = parseFloat($("#gstPercent").val()) || 0;
                let gstAmount = (afterAdditional * gstPercent) / 100;
                $("#gstAmount").text(gstAmount.toFixed(2));

                // Final Amount & Round Off
                let finalAmount = afterAdditional + gstAmount;
                let roundedAmount = Math.round(finalAmount);
                let roundOff = roundedAmount - finalAmount;

                $("#RoundOff").text(roundOff.toFixed(2));
                $("#invoiceAmount").text(roundedAmount.toFixed(2));

                let model = {
                    SaleOrderID: parseInt($("#SaleOrderID").val() || 0),
                    OrderNo: $("#OrderNo").val(),
                    OrderDate: $("#OrderDate").val(),
                    PartyID: parseInt($("#ddlPartyGST option:selected").val() || 0),
                    BrokerID: ($("#ddlBroker option:selected").val() || ""),
                    MarkupPercent: parseFloat($("#Markup").val() || 0),
                    TransportID: ($("#ddlTransport option:selected").val() || ""),
                    TotalQty: totalQty,
                    TotalAmount: totalAmount,
                    DiscountType: (type || "Percentage"),
                    AdditionalRemark: ($("#AdditionalText").val() || ""),
                    AdditionalValue: totalAdditionalValue,
                    DiscountPercent: discountValPercent,
                    DiscountAmount: discountAmount,
                    GSTPercent: gstPercent,
                    GSTAmount: gstAmount,
                    InvoiceAmount: roundedAmount,
                    RoundOff: roundOff,
                    Remark: $("#NotesRemark").val(),
                    Details: SaleOrderDetails,
                    AdditionalCharges: additionalChargesList
                };

                console.log("FINAL SAVE/UPDATE MODEL:", model);

                $.ajax({
                    url: "/WebServiceNikunjTextile.asmx/SaveSaleOrder",
                    type: "POST",
                    data: JSON.stringify({ model: model }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (res) {
                        let data = res.d;
                        hideLoader();
                        if (data.success) {
                            notes.show("Saved Successfully ✅", { type: 'success' });
                            $("#SaleOrderID").val(data.id);
                            window.location.href = "ListSaleOrderEntry"; // Update with your actual page URL/extension                                             
                        } else {
                            hideLoader();
                            $("#btnSave").prop("disabled", false);
                            alert(data.message || "Save Failed ❌");
                        }
                    },
                    error: function (err) {
                        hideLoader();
                        $("#btnSave").prop("disabled", false);
                        console.error("Error:", err);
                        alert("Save Failed ❌");
                    }
                });
            }
            function showLoader() {
                $("#loaderOverlay").css("display", "flex");
            }
            function hideLoader() {
                $("#loaderOverlay").hide();
            }
            $(document).on("change", ".brokerRateInput", function () {
                let index = $(this).data("index");
                let newRate = parseFloat($(this).val()) || 0;
                let item = SaleOrderDetails[index];
                // ✅ Manual override flag
                item.IsRateManual = true;
                item.Rate = newRate;
                item.BrokerRate = newRate;
                item.Amount = item.TotalQty * newRate;
                // ✅ Sync SubDetails
                if (item.SubDetails && item.SubDetails.length > 0) {
                    item.SubDetails.forEach(sub => {
                        sub.Rate = newRate;
                    });
                }
                let row = $(this).closest("tr");
                row.find(".col-rate").text(item.Rate);
                row.find(".amountCell").text(item.Amount.toFixed(2));
                if (row.next().hasClass("child-row")) {
                    bindSubTable(item.SubDetails);
                }
                updateSummary();
            });  
            function loadSaleOrder(id) {
                let finalId = id;
                try {
                    if (isNaN(id)) {
                        finalId = atob(decodeURIComponent(id));
                    }
                } catch (e) {
                    finalId = id;
                }

                showLoader();
                $.ajax({
                    url: '/WebServiceNikunjTextile.asmx/GetSaleOrderById',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ SaleOrderID: parseInt(finalId) }),
                    success: function (res) {
                        hideLoader();
                        let response = res.d;
                        if (response.success) {
                            let d = response.Data;

                            $("#SaleOrderID").val(d.SaleOrderID);
                            $("#OrderNo").val(d.OrderNo);
                            $("#OrderDate").val(d.OrderDate);
                            $("#ddlPartyGST").val(d.PartyID).trigger("change");
                            $("#ddlBroker").val(d.BrokerID).trigger("change");
                            $("#ddlTransport").val(d.TransportID).trigger("change");
                            $("#Markup").val(d.MarkupPercent);
                            $("#NotesRemark").val(d.Remark);
                            // 🔥 Fix Discount Values Binding Directly                           
                            $("#discountValuePercent").val(d.DiscountPercent);
                            $("#discountValueAmount").val(d.DiscountAmount);
                            $("#gstPercent").val(d.GSTPercent);
                            $("#GSTSLABId option").each(function () {
                                if ($(this).text().includes(d.GSTPercent)) {
                                    $(this).prop("selected", true);
                                }
                            });

                            $("#additionalChargesContainer").empty();
                            if (d.AdditionalCharges && d.AdditionalCharges.length > 0) {
                                d.AdditionalCharges.forEach((ac) => {
                                    let row = `
                 <div class="summary-row align-items-center d-flex pb-2 mb-2 border-bottom additional-row">
                     <div class="position-relative flex-grow-1 me-2">
                         <input type="text" class="form-control form-control-sm AdditionalText" value="${ac.ChargeRemark || ''}" placeholder="Remark" autocomplete="off">
                     </div>
                     <div class="input-group input-group-sm me-2" style="width: 100px;">
                         <span class="input-group-text"><i class="fa fa-inr"></i></span>
                         <input type="tel" class="form-control form-control-sm AdditionalValue" value="${ac.ChargeValue || 0}">
                     </div>
                     <a href="javascript:void(0);" class="text-danger remove-additional"><i class="fa fa-times-circle"></i></a>
                 </div>`;
                                    $("#additionalChargesContainer").append(row);
                                });
                            }

                            // 🔥 Map Items & Images correctly
                            SaleOrderDetails = (d.Details || []).map(item => ({
                                DesignId: item.DesignId,
                                DesignNo: item.DesignName || item.DesignNo,
                                TypeId: item.ItemType,
                                Type: item.Type,
                                UnitId: item.UnitId || 0,
                                Unit: item.Unit,
                                ColorGroupId: item.ColorGroupId || 0,
                                ColorGroup: item.ColorGroup || "",
                                Remark: item.Remark || "",
                                TotalQty: item.Qty,
                                NoOfColors: item.NoOfColours,
                                Rate: item.Rate,
                                BrokerRate: item.BrokerRate,
                                Amount: item.Amount,
                                ImageUrl: item.ImageUrl || "", // 🔥 Maps the color matching photo correctly
                                SubDetails: (item.SubDetails || []).map(sub => ({
                                    ColorMatchingID: sub.ColourID,
                                    ColorMatchingName: sub.ColourName,
                                    Qty: sub.Qty,
                                    Remark: sub.Remark,
                                    Rate: item.Rate,
                                    ColorGroupId: sub.ColorGroupId
                                }))
                            }));
                            bindMainTable();
                            updateSummary();
                        } else {
                            alert(response.Message || "Failed to load order.");
                        }
                    },
                    error: function (xhr, status, error) {
                        hideLoader();
                        console.error("AJAX Error:", error);
                        alert("Failed to load sale order data.");
                    }
                });
            }

        </script>
    }


