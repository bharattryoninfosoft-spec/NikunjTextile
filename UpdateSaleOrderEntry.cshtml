            function validate(code) {
                if (!code || !code.value) {
                    if (code) {
                        $(code).addClass("is-invalid").removeClass("is-valid");
                    }
                    return false;
                }

                code.value = code.value.replace(/\s+/g, ' ').trim();
                var $el = $(code);

                if (code.id === "gstin") {
                    if (code.value.length === 15) {
                        var gstVal = code.value.toUpperCase();
                        var pattern = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;

                        if (pattern.test(gstVal)) {
                            $el.addClass("is-valid").removeClass("is-invalid");

                            // Auto-fill PAN Number from GSTIN
                            $('#PanNo').val(gstVal.substring(2, 12));

                            // Fetch details from GST API
                            fetchGstDetails(gstVal);

                            return true;
                        } else {
                            $el.addClass("is-invalid").removeClass("is-valid");
                            $("#GSTError").html("Please enter a valid 15-digit GSTIN.");
                            return false;
                        }
                    } else {
                        $el.removeClass("is-valid is-invalid");
                        return false;
                    }
                }

                $el.addClass("is-valid").removeClass("is-invalid");
                return true;
            }
            function fetchGstDetails(gstin) {
                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/GetGstDetails',
                    data: JSON.stringify({ gstin: gstin }),
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    success: function (response) {
                        // Un-wrap response.d from ASMX string serialization
                        var res = (typeof response.d === 'string') ? JSON.parse(response.d) : response.d;

                        if (res && res.success && res.data) {
                            var d = res.data;

                            // 1. Party Name -> trade_name or legal_name
                            $("#party-name").val(d.trade_name || d.legal_name || '');

                            // 2. Billing Address -> address
                            $("#billingAddress").val(d.address || '');
                            checkShippingAdd();

                            // 3. City -> city
                            $("#city").val(d.city || '');

                            // 4. Pincode -> pincode
                            $("#pincode").val(d.pincode || '');

                            // 5. Place of Supply -> state_code
                            if (d.state_code) {
                                $("#placeOfSupply").val(d.state_code).trigger('change');
                            }
                            Toast.fire({ icon: 'success', title: 'GST Details Auto-filled!' });
                        } else {
                            Toast.fire({ icon: 'warning', title: 'GST Details not found' });
                        }
                    },
                    error: function () {
                        Toast.fire({ icon: 'error', title: 'Failed to fetch GST details.' });
                    }
                });
            }
