                if (!qty || qty <= 0) return showError("Enter valid Qty");

                const tbody = $("#itemTableBody");
                tbody.find(".no-data").remove();

                let existingRow = tbody.find(`tr[data-colorid='${colorId}']`);

                if (existingRow.length > 0) {
                    // 🔥 UPDATE QUANTITY INSTEAD OF BLOCKING
                    let qtyInput = existingRow.find(".sub-qty-input");
                    if (qtyInput.length > 0) {
                        let currentQty = parseFloat(qtyInput.val()) || 0;
                        qtyInput.val(currentQty + qty);
                    } else {
                        let qtyCell = existingRow.find("td:eq(5)");
                        let currentQty = parseFloat(qtyCell.text()) || 0;
                        qtyCell.text(currentQty + qty);
