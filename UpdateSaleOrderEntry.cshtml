            $(document).on("input", "#discountValueAmount", function () {
                if (isUpdatingDiscount) return;
                isUpdatingDiscount = true;

                let totalAmount = parseFloat($("#totalAmount").text()) || 0;
                let amtVal = parseFloat($(this).val()) || 0;

                if (totalAmount > 0) {
                    let percentVal = (amtVal / totalAmount) * 100;
                    // Limit decimal places for cleanliness
                    $("#discountValuePercent").val(percentVal > 100 ? 100 : percentVal.toFixed(2));
                } else {
                    $("#discountValuePercent").val(0);
                }

                isUpdatingDiscount = false;
                updateSummary();
            });
            // 2. Percentage Input Changed -> Calculate and update Amount
            $(document).on("input change", "#discountValuePercent", function () {
                let percent = parseFloat($(this).val()) || 0; if (percent < 0) percent = 0; if (percent > 100) percent = 100; $(this).val(percent);
