            // 🌟 Delegated input handler for dynamic Additional Text inputs
            $(document).on("input", ".AdditionalText", function () {
                var $input = $(this);
                var query = $input.val().toLowerCase().trim();

                // Find or create the suggestion dropdown container relative to this input
                var $wrapper = $input.closest('.position-relative');
                var $dropdown = $wrapper.find(".CustomDropdownList");

                if ($dropdown.length === 0) {
                    // Create dropdown if it doesn't exist in this row yet
                    $dropdown = $('<ul class="CustomDropdownList dropdown-menu shadow-sm w-100 m-0 bg-white" style="display: none; position: absolute; top: 100%; left: 0; max-height: 140px; overflow-y: auto; z-index: 1060; border: 1px solid #ced4da;"></ul>');
                    $wrapper.append($dropdown);
                }

                $dropdown.empty();

                if (query === "") {
                    $dropdown.hide();
                    return;
                }

                // Filter remarks matching input text
                var filtered = $.grep(AdditionalRemarksArray, function (item) {
                    return item.AdditionalRemark.toLowerCase().indexOf(query) !== -1;
                });

                if (filtered.length > 0) {
                    $.each(filtered, function (i, item) {
                        $dropdown.append(
                            '<li><a class="dropdown-item custom-item" href="javascript:void(0);" data-remark="' + item.AdditionalRemark + '">' + item.AdditionalRemark + '</a></li>'
                        );
                    });
                    $dropdown.show();
                } else {
                    $dropdown.hide();
                }
            });
