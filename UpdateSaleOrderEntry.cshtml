    $("#Markup").on("input", function () {

        const markup = parseFloat($(this).val()) || 0;

        SaleOrderDetails.forEach(item => {

            // ❌ Skip if manually edited
            if (item.IsRateManual) return;

            const brokerRate = calculateBrokerRate(item.Rate, markup);

            item.BrokerRate = brokerRate;
            item.Amount = item.TotalQty * brokerRate;

            // 🔥 Sync SubDetails also
            if (item.SubDetails && item.SubDetails.length > 0) {
                item.SubDetails.forEach(sub => {
                    sub.Rate = brokerRate;
                });
            }
        });
    })
