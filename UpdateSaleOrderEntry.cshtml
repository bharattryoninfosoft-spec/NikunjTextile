    $("#DesignNo").on("change", function () {
        let selected = $(this).find("option:selected");

        let tbody = $("#itemTableBody");
        tbody.empty(); // clear

        let val = $(this).val();
        if (!val) return;
        if (val !== "") {

            let parts = val.split('|');

            let designEntryId = parts[0];
            let colorMatchingId = parts[1];

            let typeId = selected.data("typeid");
            let type = selected.data("type");

            let unitId = selected.data("unitid");
            let unit = selected.data("unit");

            // ✅ FIX HERE
            let colors = selected.attr("data-colors");
            colors = colors ? JSON.parse(colors) : [];

            // TYPE + UNIT
            $("#TypeRow").html(`<option value="${typeId}" selected>${type}</option>`);
            $("#UnitRow").html(`<option value="${unitId}" selected>${unit}</option>`);

            // COLOR
            $("#ddlColourGroup").html('<option value="-1">Select Color Group</option>');

            if (colors && colors.length > 0) {

                let options = '';

                colors.forEach(function (c) {
                    options += `<option value="${c.ColorGroupID}">${c.ColorGroup}</option>`;
                });

                $("#ddlColourGroup").append(options);

            }

            getDesignNo(designEntryId, colorMatchingId);

        } else {
            $("#TypeRow").html('<option value="">Select Type</option>');
            $("#UnitRow").html('<option value="">Select Unit</option>');
            $("#ddlColourGroup").html('<option value="">Select Color Group</option>');
        }
    });
    $("#ColorMatchingAddbtn").click(function () {

        let saleRate = 0;

        // 🔥 FIX: use parent rate in edit mode
        if (isEditMode && currentViewIndex !== -1) {
            saleRate = SaleOrderDetails[currentViewIndex].BrokerRate;
        } else {
            saleRate = parseFloat($("#DesignNo option:selected").data("salerate")) || 0;
        }

        const colorId = $("#ColorMatchingID").val();
        const colorName = $("#ColorMatchingID option:selected").text().trim();
        const qty = parseFloat($("#ColorMatchingQty").val());

        if (!colorId) return showError("Please select Color Matching");
        if (!qty || qty <= 0) return showError("Enter valid Qty");

        const tbody = $("#itemTableBody");
        tbody.find(".no-data").remove();

        let existingRow = tbody.find(`tr[data-colorid='${colorId}']`);

        // ❌ Duplicate not allowed
        if (existingRow.length > 0) {
            showError("This color already added");

            // 🔥 highlight row
            existingRow.addClass("table-danger");
            setTimeout(() => existingRow.removeClass("table-danger"), 800);

            return;
        }

        let designNo = $("#DesignNo").val();
        let designName = $("#DesignNo option:selected").text().trim();
        let colorGroupId = $("#ddlColourGroup").val();
        let colorGroupName = $("#ddlColourGroup option:selected").text().trim();
        let remark = $("#DesignSelectionRemark").val() || "";
        let imageUrl = $("#upload-ColorMatching-default-preview img").attr("src") || "";

        tbody.append(createSubRow(
            designNo,
            designName,
            colorGroupId,
            colorGroupName,
            remark,
            colorId,
            colorName,
            qty,
            imageUrl,
            saleRate
        ));

        updateSrNo();

        // 🔥 RESET
        $("#ColorMatchingQty").val("");
        $("#DesignSelectionRemark").val("");
    });
