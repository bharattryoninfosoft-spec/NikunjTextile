            var gstRequestPromise = null;

            function syncGstSlabDropdown(targetPercent) {
                var targetVal = parseFloat(targetPercent);
                if (isNaN(targetVal)) {
                    targetVal = parseFloat($("#gstPercent").val()) || 0;
                }

                var $options = $("#GSTSLABId option");
                if ($options.length <= 1) {
                    return;
                }

                var matched = false;
                $options.each(function () {
                    var optVal = $(this).val();
                    if (optVal === "0" || optVal === "-1") {
                        if (targetVal === 0) {
                            $(this).prop("selected", true);
                            matched = true;
                            return false;
                        }
                    } else {
                        var optPercent = parseFloat($(this).text().replace(/[^\d.]/g, "")) || 0;
                        if (targetVal > 0 && Math.abs(optPercent - targetVal) < 0.01) {
                            $(this).prop("selected", true);
                            matched = true;
                            return false;
                        }
                    }
                });

                if (!matched && targetVal === 0) {
                    $("#GSTSLABId").val("0");
                }

                $("#gstPercent").val(targetVal);
                updateSummary();
            }

            function getItemGST(callback) {
                gstRequestPromise = $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getGSTSlabList',
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data, status) {
                        var jsonData = JSON.parse(data.d);
                        var $ddl = $('#GSTSLABId');
                        if ($ddl.data("select2")) { $ddl.select2("destroy"); }
                        $ddl.empty();
                        $ddl.append("<option value='0'>Select GST</option>");
                        for (var i = 0; i < jsonData.length; i++) {
                            var admin = jsonData[i];
                            $ddl.append(`<option value="${admin.GSTSLABId}">${admin.GSTSLABName}</option>`);
                        }

                        var currentGst = $("#gstPercent").val();
                        if (currentGst !== "" && currentGst !== undefined && currentGst !== null) {
                            syncGstSlabDropdown(currentGst);
                        }

                        if (typeof callback === "function") {
                            callback();
                        }
                    },
                    error: function (request, status, error) {
                        console.error("Error loading GST slab list:", error);
                        if (typeof callback === "function") {
                            callback();
                        }
                    }
                });

                return gstRequestPromise;
            }
