    function getDesignEntryForm() {

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/GetDesignEntryData',
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',

            success: function (response) {

                let data = JSON.parse(response.d);
                //console.log("GetDesignEntryData", data);

                if (data.Code == 200) {
                    $("#DesignNo").prop("disabled", false);
                    // ================= DESIGN =================
                    $("#DesignNo").html('<option value="-1">Select Design</option>');

                    $.each(data.Designs, function (i, item) {

                        $("#DesignNo").append(`
                            <option
                                value="${item.DesignEntryFormID}|${item.DesignColorMatchingFormID}"
                                data-typeid="${item.TypeID}"
                                data-type="${item.Type}"
                                data-unitid="${item.UnitId}"
                                data-unit="${item.UnitCode}"
                                data-salerate="${item.SaleRate}"   // 🔥 ADD THIS
                                data-colors='${JSON.stringify(item.ColorGroups)}'>
                                ${item.DesignerCode} - ${item.DesignNo}
                            </option>
                        `);
                    });

                    // ================= TYPE =================
                    $("#TypeRow").html('<option value="-1">Select Type</option>');
                    $.each(data.Types, function (i, item) {
                        $("#TypeRow").append(`
                        <option value="${item.TypeID}">
                            ${item.Type}
                        </option>
                    `);
                    });

                    // ================= UNIT =================
                    $("#UnitRow").html('<option value="-1">Select Unit</option>');
                    $.each(data.Units, function (i, item) {
                        $("#UnitRow").append(`
                        <option value="${item.UnitId}">
                            ${item.UnitCode}
                        </option>
                    `);
                    });

                    // ================= GLOBAL COLOR LIST =================
                    $("#ddlColourGroup").html('<option value="-1">Select Color Group</option>');
                    $.each(data.ColorGroups, function (i, item) {
                        $("#ddlColourGroup").append(`
                        <option value="${item.ColorGroupID}">
                            ${item.ColorGroup}
                        </option>
                    `);
                    });
                }
            },
            error: function (err) {
                console.error("Error:", err);
            }
        });
    }
