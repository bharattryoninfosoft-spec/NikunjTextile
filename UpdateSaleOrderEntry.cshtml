    @section Scripts{
        <script>
            $('body').addClass('fullscreen');
            let srNo = 1;
            let subDetails = [];
            let SaleOrderDetails = [];
            let isEditMode = true;
            let currentViewIndex = -1;
            let currentId = null;
            let uniqueMap = {};
            var AdditionalRemarksArray = [];      
            $(document).ready(function () {
                const urlParams = new URLSearchParams(window.location.search);
                const id = urlParams.get('id');
                FunctionIsLogin();
                bindPartyGST();
                bindBrokerDropdown();
                bindTransport();
                getItemGST();
                getStates(0);
                AdditionalRemarks();

                $("#PartyName").prop("disabled", true);
                $("#PartyAddress").prop("disabled", true);
                $("#Broker").prop("disabled", true);

                let today = new Date();
                let day = String(today.getDate()).padStart(2, '0');
                let month = String(today.getMonth() + 1).padStart(2, '0');
                let year = today.getFullYear();
                let formattedDate = `${year}-${month}-${day}`;
                $("#OrderDate").val(formattedDate);

                if (id) {
                    loadSaleOrder(id);
                    getDesignEntryForm();
                }
            });         
            var notes = $('#notes').notify({
                removeIcon: '<i class="icon-close"></i>'
            });
            var notess = $('#notess').notify({
                removeIcon: '<i class="icon-close"></i>'
            });
            // Open Image Preview Modal on Thumbnail Click
            $(document).on("click", "#SaleOrderDetails tbody tr td img", function (e) {
                e.stopPropagation(); // Prevents triggering row selection/view events
                let imgSrc = $(this).attr("src");
                if (imgSrc) {
                    $("#previewModalImg").attr("src", imgSrc);
                    $("#imagePreviewModal").modal("show");
                }
            });
            $("#discountType").on("change", function () {

                if ($(this).val() === "Percentage") {
                    $("#discountValue").attr("placeholder", "Enter %");
                } else {
                    $("#discountValue").attr("placeholder", "Enter \u20B9");
                }
            });
            $("#discountValue").on("input", updateSummary);
            $("#discountType").on("change", updateSummary);
            $("#gstPercent").on("input", updateSummary);
            $("#discountPercent").on("keypress", function (e) {
