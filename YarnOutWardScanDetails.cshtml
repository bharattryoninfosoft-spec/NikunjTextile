            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/DeleteYarnOutwardMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200) {

                        notes.show("Yarn Outward deleted successfully.", {
