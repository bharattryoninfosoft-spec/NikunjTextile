                                <thead>
                                    <tr style="background-color:#1273eb;">
                                        <th style="color:white">Sr No</th>
                                        <th style="color:white">Outward <br> List No</th>
                                        <th style="color:white">Outward <br> Date</th>
                                        <th style="color:white">Party</th>
                                        <th style="color:white">Party <br> Mobile No</th>
