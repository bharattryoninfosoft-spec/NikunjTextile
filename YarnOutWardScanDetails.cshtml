    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function functionSearch() {
        displayPagginationData();
        displayData(0);
    }
    function displayData(rowStartCheck) {
        debugger;
        var rowStart = rowStartCheck;
        var searchdesignNo = $("#SearchRequirementNo").val();
        var formData = new FormData();
        formData.append('SearchRequirementNo', searchdesignNo);
        formData.append('startFrom', rowStart);
        formData.append('Status', currentTab); // Completed / Pending

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/GetDisplayYarnoutwardScanMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                var tableId = currentTab == "Pending" ? "#pendingTable tbody" : "#completedTable tbody" ;
                console.log((tableId + currentTab))
                console.log("response",response)
                $(tableId).empty();
                var temp = "";
                var srno = parseInt(rowStart) + 1;
                for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {
                    temp += "<tr>";
                    temp += "<td>" + srno++ + "</td>";
                    temp += "<td>" + response.listYarnOutwardMaster[i].OutwardListNo + "</td>";
                    temp += "<td>" + response.listYarnOutwardMaster[i].DateAndTimes + "</td>";
                    temp += "<td>" + response.listYarnOutwardMaster[i].PartyName + "</td>";
                    temp += "<td>" + response.listYarnOutwardMaster[i].MobileNo + "</td>";
                    temp += "<td>" + response.listYarnOutwardMaster[i].BoxNo + "</td>";
                    if (currentTab == "Pending") {
                        temp += "<td style='text-align:center'>";
                        temp += "<a href='javascript:void(0);' onclick='showScanRecords(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'>";
                        temp += "<i class='fa fa-barcode' style='font-size:x-large;color:#1844ab'></i>";
                        temp += "</a>";
                        temp += "</td>";
                    }
                    else {
                        temp += "<td style='text-align:center'>";
                        temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' onclick='showEditRecords(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;";
                        temp += "</td>";
                    }
                 
                    temp += "</tr>";
                }
                $(tableId).html(temp);
            }
        });
    }
    //Display Paggination
    function displayPagginationData() {

        var searchdesignNo = $("#SearchRequirementNo").val();

        var formData = new FormData();
        formData.append('SearchString', searchdesignNo);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/GetYarnOutwardMasterScanPaggination',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                //console.log(response);

                //var userTable = $('#DDLDistrict');
                //listPagginationMaster
                total = response.listPagginationMaster[0].Total;
                Paggination = response.listPagginationMaster[0].Paggination + 1;
                prevNo = 0;
                nextNo = 10;
                //alert(response.listPagginationMaster[0].Paggination);
                if (response.listPagginationMaster[0].Paggination == "0") {
                    $('#divPaggination').hide();
                }
                else {


                    if (parseInt(response.listPagginationMaster[0].Paggination) <= parseInt(10)) {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= parseInt(response.listPagginationMaster[0].Paggination); i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                        }
                        $('#divPaggination').html(temp).show();
                    }
                    else {
                        var temp = "";
                        //temp += "<a href='javascript:void(0);' id='prev' onclick='funcationPagginationPrev()'>&laquo;</a>";

                        for (var i = 1; i <= 10; i++) {
                            if (i == 1) {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")' class='active'>" + i + "</a>";*/
                                temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }
                            else {
                                /*temp += "<a href='javascript:void(0);' id='a" + i + "' onclick='funcationPaggination(" + i + ")'>" + i + "</a>";*/
                                temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                            }

                        }
                        //temp += "<a href='javascript:void(0);' id='next' onclick='funcationPagginationNext()'>&raquo;</a>";
                        temp += "<li class='page-item' id='next'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";

                        $('#divPaggination').html(temp).show();
                    }

                }


            },
            error: function (request, status, error) {
                //console.log(error);
                //console.log("error" + request.statusText);
                //alert(request.statusText);
            }
        });
    }
    //Select Paggination
    function funcationPaggination(abc) {
        //alert(abc);
        $("#trLoading").show();
        var a = "#a" + abc;
        SelectNo = abc;
        //alert(a);
        $('li').removeClass('active');
        //$("#a3").addClass("active");
        $(a).addClass('active');

        $("#rowStartCount").val(((abc - 1) * 30));
        displayData(((abc - 1) * 30));

        //$("#rowStartCount").val(((abc - 1) * 2));
        //displayData(((abc - 1) * 2));

    }
