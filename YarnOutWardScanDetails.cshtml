</div>
<!-- Content wrapper end -->

@section Scripts{

    <script>
        var currentTab = "Pending";

        $(document).ready(function () {
            $('.active, .show, .current-page').removeClass('active show current-page');
            $("#YarnForm-tab").addClass("active");
            $("#tab-YarnForm").addClass("show active");
            $("#aYarnOutWardScanDetails").addClass("current-page");
            FunctionIsLogin();
            displayPagginationData();
            getYarnColor();
            document.querySelector("button[onclick=\"openTab(event,'Pending')\"]").click();
            //getDefaultCompany();
        });

        var ArrayYarnColor = [];
        var total = 0;
        var Paggination = 0;
        var prevNo = 0;
        var nextNo = 0;
        var SelectNo = 1;
        var PageNo = 0;

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Swal.fire({
                        title: 'Error!',
                        text: request.statusText || "Failed to fetch default company.",
                        icon: 'error'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function functionSearch() {
            displayPagginationData();
            displayData(0);
        }

        function displayData(rowStartCheck) {
            var rowStart = rowStartCheck;
            var searchdesignNo = $("#SearchRequirementNo").val();
            var formData = new FormData();
            formData.append('SearchRequirementNo', searchdesignNo);
            formData.append('startFrom', rowStart);
            formData.append('Status', currentTab); // Completed / Pending

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/GetDisplayYarnoutwardScanMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var tableId = currentTab == "Pending" ? "#pendingTable tbody" : "#completedTable tbody";
                    $(tableId).empty();
                    var temp = "";
                    var srno = parseInt(rowStart) + 1;
                    for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {
                        temp += "<tr>";
                        temp += "<td>" + srno++ + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].OutwardListNo + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].DateAndTimes + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].PartyName + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].MobileNo + "</td>";
                        temp += "<td>" + response.listYarnOutwardMaster[i].BoxNo + "</td>";
                        if (currentTab == "Pending") {
                            temp += "<td style='text-align:center'>";
                            temp += "<a href='javascript:void(0);' onclick='showScanRecords(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'>";
                            temp += "<i class='fa fa-barcode' style='font-size:x-large;color:#1844ab'></i>";
                            temp += "</a>";
                            temp += "</td>";
                        }
                        else {
                            temp += "<td style='text-align:center'>";
                            // Edit Button
                            temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='Edit' onclick='showEditRecords(" + response.listYarnOutwardMaster[i].YarnOutwardID + ")'><i class='icon-edit1 text-info'></i></a>&nbsp;&nbsp;&nbsp;";
                            // Generated Link Button
                            temp += "<a href='javascript:void(0);' onclick=CopyJobberLink('" + response.listYarnOutwardMaster[i].GeneratedLink + "') data-toggle='tooltip' title='Copy Jobber Inward Link'><i class='icon-copy text-success'></i></a>";
                            temp += "</td>";
                        }
                        temp += "</tr>";
                    }
                    $(tableId).html(temp);
                }
            });
        }

        // Display Pagination
        function displayPagginationData() {
            var searchdesignNo = $("#SearchRequirementNo").val();
            var formData = new FormData();
            formData.append('SearchString', searchdesignNo);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/GetYarnOutwardMasterScanPaggination',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    total = response.listPagginationMaster[0].Total;
                    Paggination = response.listPagginationMaster[0].Paggination + 1;
                    prevNo = 0;
                    nextNo = 10;
                    if (response.listPagginationMaster[0].Paggination == "0") {
                        $('#divPaggination').hide();
                    }
                    else {
                        if (parseInt(response.listPagginationMaster[0].Paggination) <= parseInt(10)) {
                            var temp = "";
                            for (var i = 1; i <= parseInt(response.listPagginationMaster[0].Paggination); i++) {
                                if (i == 1) {
                                    temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                                else {
                                    temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                            }
                            $('#divPaggination').html(temp).show();
                        }
                        else {
                            var temp = "";
                            for (var i = 1; i <= 10; i++) {
                                if (i == 1) {
                                    temp += "<li class='page-item active' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                                else {
                                    temp += "<li class='page-item' id='a" + i + "'><a class='page-link' href='javascript:void(0);' onclick='funcationPaggination(" + i + ")'>" + i + "</a></li>";
                                }
                            }
                            temp += "<li class='page-item' id='next'><a class='page-link' href='javascript:void(0);' onclick='funcationPagginationNext()'>Next</a></li>";
                            $('#divPaggination').html(temp).show();
                        }
                    }
                }
            });
        }

        // Select Pagination
        function funcationPaggination(abc) {
            $("#trLoading").show();
            var a = "#a" + abc;
            SelectNo = abc;
            $('li').removeClass('active');
            $(a).addClass('active');
            $("#rowStartCount").val(((abc - 1) * 30));
            displayData(((abc - 1) * 30));
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Color Matching Form");
            $("#add-alert").hide();
            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback, .valid-feedback").hide();
        }

        function showRecords(id) {
            clearAll();
            $("#edit-id").val(id);
            $("#saveViewbtn").hide();
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Yarn Outward Form");

            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    ViewRecordQueryString(DecryptID);
                },
                error: function (request, status, error) {
                }
            });
        }

        function showScanRecords(id) {
            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.location.href = '/YarnOutWardScan?id=' + response.listEncryptDecrypt[0].DecryptID;
                }
            });
        }

        function showEditRecords(id) {
            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.location.href = '/UpdateYarnOutWardScan?id=' + response.listEncryptDecrypt[0].DecryptID;
                }
            });
        }

        function getYarnColor() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMatching',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    ArrayYarnColor.push(response.listYarnColorMaster);
                    if (response.Code == "200") {
                        if (response.listYarnColorMaster.length > 0) {
                            var tempDesignNo = "";
                        }
                    }
                }
            });
        }

        function ViewRecordQueryString(DecryptID) {
            var formData = new FormData();
            formData.append('YarnOutwardID', DecryptID);
            var PartyId = 0;

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutwardDetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    var userTable = $('#TblUser');

                    for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {
                        $("#hYarnOutwardID").val(response.listYarnOutwardMaster[i].YarnOutwardID);
                        $("#hGodownManagerUserAccountId").val(response.listYarnOutwardMaster[i].hGodownManagerUserAccountId);
                        $("#POutwardListNo").html("<b>Outward List No: </b>" + response.listYarnOutwardMaster[i].OutwardListNo);
                        $("#POutwardListDate").html("<b>Outward List Date: </b>" + response.listYarnOutwardMaster[i].OutwardListDates);

                        var SpanSundryParty = "";
                        if (response.listYarnOutwardMaster[i].SundryParty == "1") {
                            SpanSundryParty = "<span class='badge bg-success' style='margin-top: 5px;'><i class='fa fa-arrow-down'></i> Sundry Creditors</span>";
                        }
                        else if (response.listYarnOutwardMaster[i].SundryParty == "2") {
                            SpanSundryParty = "<span class='badge bg-danger' style='margin-top: 5px;'><i class='fa fa-arrow-up'></i> Sundry Debtors</span>";
                        }
                        else if (response.listYarnOutwardMaster[i].SundryParty == "3") {
                            SpanSundryParty = "<span class='badge bg-warning' style='margin-top: 5px;'><i class='fa fa-user'></i> Job Work</span>";
                        }

                        $("#PPartyName").html("<b>Sundry Party Name: </b>" + response.listYarnOutwardMaster[i].PartyName + "  " + SpanSundryParty);
                        $("#PMobileNo").html("<b>Mobile No: </b>" + response.listYarnOutwardMaster[i].MobileNo);
                        $("#PUserAccountName").html("<b>Godown Manager: </b>" + response.listYarnOutwardMaster[i].UserAccountName);
                        $("#PUserAccountMobileNo").html("<b>Manager Mobile No: </b>" + response.listYarnOutwardMaster[i].UserAccountMobileNo);

                        $("#tblYarnOutward tbody").empty();
                        var dataTable = $('#tblYarnOutward tbody');
                        var temp = "";
                        var spanTotalWeight = "0";
                        var srno = parseInt(0) + parseInt(1);

                        for (var j = 0; j < response.listYarnOutwardMaster[i].listYarnOutwardDetail.length; j++) {
                            temp += "<tr><td>" + srno++ + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].CompanyName + " <br />" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].CompanyMobileNo + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].YarnMaterial + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].YarnColor + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].YarnColorCode + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].LocationTitle + "<br />" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].GodownTitle + "</td>";
                            temp += "<td style='text-align: center;'>" + response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].NoOfBox + "</td>";
                            temp += "</tr>";

                            spanTotalWeight = parseFloat(spanTotalWeight) + parseFloat(response.listYarnOutwardMaster[i].listYarnOutwardDetail[j].NoOfBox);
                        }
                        $("#tblYarnOutward tbody").empty();
                        dataTable.html(temp);
                        $("#spanTotalWeight").html(parseFloat(spanTotalWeight).toFixed(2));
                    }
                }
            });
        }

        function functionUserDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('YarnOutwardID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteYarnOutwardMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {
                                Swal.fire(
                                    'Deleted!',
                                    'Yarn Outward deleted successfully.',
                                    'success'
                                );
                                displayData(0);
                            }
                            else {
                                Swal.fire('Error!', 'Problem occurred while deleting Design Entry Form.', 'error');
                            }
                        },
                        error: function (error) {
                            Swal.fire('Error!', 'Problem occurred while deleting Design Entry Form.', 'error');
                        }
                    });
                }
            });
        }

        function showYarnBarcodeRecords(YarnInwardID) {
            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + YarnInwardID,
                data: "{ 'id':'" + YarnInwardID + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.open('/YarnBoxMultiBarcode?id=' + response.listEncryptDecrypt[0].DecryptID, '_blank');
                }
            });
        }

        function showBarcodeRecords(YarnInwardDetailID) {
            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + YarnInwardDetailID,
                data: "{ 'id':'" + YarnInwardDetailID + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.open('/YarnBoxBarcode?id=' + response.listEncryptDecrypt[0].DecryptID, '_blank');
                }
            });
        }

        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            currentTab = tabName;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].classList.remove("active");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.classList.add("active");
            displayData(0);
        }

        function CopyJobberLink(link) {
            var url = window.location.origin + "/CreateJobberInward?id=" + link;

            if (navigator.clipboard) {
                navigator.clipboard.writeText(url)
                    .then(function () {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Copied Successfully',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    })
                    .catch(function () {
                        CopyFallback(url);
                    });
            } else {
                CopyFallback(url);
            }
        }

        function CopyFallback(text) {
            var textarea = document.createElement("textarea");
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);

            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Copied Successfully',
                showConfirmButton: false,
                timer: 1500
            });
        }
    </script>
}


