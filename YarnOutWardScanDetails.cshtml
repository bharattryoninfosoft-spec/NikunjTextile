    function ViewRecordQueryString(DecryptID) {

        //alert(DecryptID);
        var formData = new FormData();
        formData.append('YarnOutwardID', DecryptID);

        var PartyId = 0;

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnOutwardDetails',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);

                //alert(response.listYarnOutwardMaster.length);
                var userTable = $('#TblUser');


                for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {


                    /* ---------- View Party Details ---------- */


                    $("#hYarnOutwardID").val(response.listYarnOutwardMaster[i].YarnOutwardID);
                    $("#hGodownManagerUserAccountId").val(response.listYarnOutwardMaster[i].hGodownManagerUserAccountId);
                    $("#POutwardListNo").html("<b>Outward List No: </b>" + response.listYarnOutwardMaster[i].OutwardListNo);
                    $("#POutwardListDate").html("<b>Outward List Date: </b>" + response.listYarnOutwardMaster[i].OutwardListDates);


                    var SpanSundryParty = "";
                    if (response.listYarnOutwardMaster[i].SundryParty == "1") {
                        SpanSundryParty = "<span class='badge bg-success' style='margin-top: 5px;'><i class='fa fa-arrow-down'></i> Sundry Creditors</span>";
                    }
                    else
                        if (response.listYarnOutwardMaster[i].SundryParty == "2") {
                            SpanSundryParty = "<span class='badge bg-danger' style='margin-top: 5px;'><i class='fa fa-arrow-up'></i> Sundry Debtors</span>";
                        }

                        else
