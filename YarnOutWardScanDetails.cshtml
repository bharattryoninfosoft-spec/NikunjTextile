    function ViewRecordQueryString(DecryptID) {

        //alert(DecryptID);
        var formData = new FormData();
        formData.append('YarnOutwardID', DecryptID);

        var PartyId = 0;

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnOutwardDetails',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);

                //alert(response.listYarnOutwardMaster.length);
                var userTable = $('#TblUser');


                for (var i = 0; i < response.listYarnOutwardMaster.length; i++) {


                    /* ---------- View Party Details ---------- */


