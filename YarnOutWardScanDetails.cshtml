                        "<i class='fa fa-barcode' style='font-size:x-large; color:#1844ab;'></i>" +
                        "</a>&nbsp;&nbsp;&nbsp;";
                    temp += "</div></td>";
                    temp += "</tr>";

                }
                $("#copy-print-csv tbody").empty();
                dataTable.append(temp);
