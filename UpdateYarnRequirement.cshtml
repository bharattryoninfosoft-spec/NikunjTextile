                            @section Scripts {
                                <script>
                                    $('body').addClass('fullscreen');

                                    var currentPagePermission = {};
                                    var ArrayYarnColor = [];
                                    var ArrayYarnMaterial = [];
                                    var IsJobWork = 0;
                                    var editingYarnRowNo = 0;
                                    var isSubmitting = false;

                                    $(document).ready(function () {
                                        var permission = getCookie("PagePermission");
                                        if (permission != null && permission != "") {
                                            currentPagePermission = JSON.parse(permission);
                                            if (currentPagePermission.Edit === false) {
                                                $("#Updatebtn").hide();
                                            }
                                        }

                                        $('.active, .show, .current-page').removeClass('active show current-page');
                                        $("#YarnForm-tab").addClass("active");
                                        $("#tab-YarnForm").addClass("show active");
                                        $("#aCreateYarnRequirement").addClass("current-page");

                                        FunctionIsLogin();

                                        var requirementId = getRequirementIdFromUrl();
                                        if (!requirementId) {
                                            Swal.fire({
                                                icon: "warning",
                                                title: "Invalid Requirement",
                                                text: "Yarn Requirement ID is missing."
                                            }).then(function () {
                                                window.location.href = "/YarnRequirement";
                                            });
                                            return;
                                        }

                                        $("#YarnRequirementID").val(requirementId);

                                        // Sequentially load master data -> party list -> existing requirement details
                                        getDesignEntryForm(function () {
                                            getPartyDetail(function () {
                                                functionYarnRequirement(requirementId);
                                            });
                                        });
                                    });
                                    function getDesignEntryForm(callback) {
                                        var formData = new FormData();
                                        $.ajax({
                                            type: "POST",
                                            url: '/WebServiceNikunjTextile.asmx/getAllDesignEntryYarnReqForm',
                                            data: formData,
                                            dataType: 'json',
                                            contentType: false,
                                            processData: false,
                                            success: function (response) {
                                                if (response.Code == "200") {
                                                    IsJobWork = parseInt(response.IsJobWork) || 0;
                                                    ArrayYarnMaterial = [];
                                                    ArrayYarnColor = [];

                                                    ArrayYarnMaterial.push(response.listYarnMaterialMaster || []);
                                                    ArrayYarnColor.push(response.listYarnColorMaster || []);

                                                    $("#yarnMaterial1").empty();
                                                    $("#yarnMaterial1").append("<option value='0' selected>Select Yarn Material</option>");

                                                    if (response.listYarnMaterialMaster && response.listYarnMaterialMaster.length > 0) {
                                                        $.each(response.listYarnMaterialMaster, function (i, item) {
                                                            $("#yarnMaterial1").append($("<option>", {
                                                                value: item.YarnMaterialID,
                                                                text: item.YarnMaterial
                                                            }));
                                                        });
                                                    }

                                                    $("#YarnColor1").empty();
                                                    $("#YarnColor1").append("<option value='0' selected>Select Yarn Color</option>");

                                                    if (IsJobWork === 0) {
                                                        BindAllYarnColors(1);
                                                    }

                                                    if (response.listYarnRequirementMaster && response.listYarnRequirementMaster.length > 0) {
                                                        $("#RequirementNo").val(response.listYarnRequirementMaster[0].RequirementNo);
                                                    }

                                                    if (typeof callback === "function") {
                                                        callback();
                                                    }
                                                } else {
                                                    Swal.fire({
                                                        icon: "error",
                                                        title: "Error",
                                                        text: response.Message || "Unable to load Yarn master data."
                                                    });
                                                }
                                            },
                                            error: function (request, status, error) {
                                                console.log("getAllDesignEntryYarnReqForm Error:", error);
                                                Swal.fire({
                                                    icon: "error",
                                                    title: "Server Error",
                                                    text: "Unable to load Yarn master data."
                                                });
                                            }
                                        });
                                    }
                                    function getRequirementIdFromUrl() {
                                        var query = window.location.search || "";
                                        if (!query) return "";
                                        var params = new URLSearchParams(query);
                                        var id = params.get("id");
                                        if (!id) {
                                            var first = query.substring(1).split("&")[0];
                                            if (first.indexOf("=") > -1) {
                                                id = first.substring(first.indexOf("=") + 1);
                                            }
                                        }
                                        return $.trim(id || "");
                                    }
                                    function YarnMaterialChange(rowNo) {
                                        var materialId = parseInt($("#yarnMaterial" + rowNo).val()) || 0;
                                        var $company = $("#CompanyName" + rowNo);

                                        if ($company.is("select")) {
                                            $company.empty().append($("<option>", { value: "0", text: "Select Company" }));
                                        } else {
                                            $company.val("");
                                        }
                                        $("#CompanyID" + rowNo).val("0");
                                        $("#ColorCode" + rowNo).val("");

                                        if (materialId === 0) {
                                            $("#YarnColor" + rowNo).empty().append($("<option>", { value: "0", text: "Select Yarn Color" }));
                                            if (IsJobWork === 0) {
                                                BindAllYarnColors(rowNo);
                                            }
                                            return;
                                        }
                                        BindYarnColorsByMaterial(rowNo, materialId, 0);
                                    }
                                    function BindAllYarnColors(rowno) {
                                        var colorDDL = $("#YarnColor" + rowno);
                                        colorDDL.empty();
                                        colorDDL.append("<option value='0'>Select Yarn Color</option>");

                                        if (!ArrayYarnColor || !ArrayYarnColor[0]) return;

                                        $.each(ArrayYarnColor[0], function (i, item) {
                                            colorDDL.append($("<option>", {
                                                value: item.YarnColorID,
                                                text: item.YarnColor
                                            }));
                                        });
                                    }
                                    function BindYarnColorsByMaterial(rowNo, materialId, selectedColorId) {
                                        var colorDDL = $("#YarnColor" + rowNo);
                                        colorDDL.empty();
                                        colorDDL.append($("<option>", { value: "0", text: "Select Yarn Color" }));

                                        if (!ArrayYarnColor || !ArrayYarnColor[0]) return;

                                        $.each(ArrayYarnColor[0], function (i, item) {
                                            var itemMaterialId = parseInt(item.YarnMaterialID) || 0;
                                            var itemColorId = parseInt(item.YarnColorID) || 0;

                                            if (IsJobWork > 0) {
                                                if (itemMaterialId === parseInt(materialId)) {
                                                    colorDDL.append($("<option>", { value: itemColorId, text: item.YarnColor }));
                                                }
                                            } else {
                                                colorDDL.append($("<option>", { value: itemColorId, text: item.YarnColor }));
                                            }
                                        });

                                        if (selectedColorId) {
                                            colorDDL.val(String(selectedColorId));
                                        }
                                    }
                                    function YarnColorChange(rowNo) {
                                        debugger;
                                        var materialId =
                                            parseInt($("#yarnMaterial" + rowNo).val()) || 0;

                                        var colorId =
                                            parseInt($("#YarnColor" + rowNo).val()) || 0;

                                        var $company =
                                            $("#CompanyName" + rowNo);

                                        var $colorCode =
                                            $("#ColorCode" + rowNo);

                                        // Clear Company
                                        $company.empty().append(
                                            $("<option>", {
                                                value: "0",
                                                text: "Select Company"
                                            })
                                        );

                                        $colorCode.val("");

                                        if (materialId === 0 || colorId === 0) {
                                            return;
                                        }

                                        if (!ArrayYarnColor || !ArrayYarnColor[0]) {
                                            return;
                                        }

                                        var yarnColor = null;

                                        $.each(ArrayYarnColor[0], function (i, item) {

                                            var itemMaterialId =
                                                parseInt(item.YarnMaterialID) || 0;

                                            var itemColorId =
                                                parseInt(item.YarnColorID) || 0;

                                            if (
                                                itemMaterialId === materialId &&
                                                itemColorId === colorId
                                            ) {
                                                yarnColor = item;
                                                return false;
                                            }

                                        });

                                        if (!yarnColor) {
                                            console.log(
                                                "Yarn Color not found:",
                                                materialId,
                                                colorId
                                            );
                                            return;
                                        }

                                        console.log("Selected Yarn Color:", yarnColor);

                                        // =====================================================
                                        // COMPANY DATA
                                        // CompanyId = actual Company ID
                                        // CompanyName = display name
                                        // CompanyCode = color/company code
                                        // =====================================================

                                        var companyId =
                                            parseInt(yarnColor.CompanyId) || 0;

                                        var companyName =
                                            yarnColor.CompanyName || "";

                                        var companyCode =
                                            yarnColor.CompanyCode || "";

                                        // Bind Company
                                        if (companyId > 0 && companyName !== "") {

                                            $company.append(
                                                $("<option>", {
                                                    value: companyId,
                                                    text: companyName
                                                })
                                            );

                                            // Automatically select company
                                            $company.val(String(companyId));

                                            // Call company change
                                            YarnCompanyChange(rowNo);
                                        }

                                        // Bind Company Code
                                        $colorCode.val(companyCode);

                                    }
                                    function YarnPOCompany(rowNo) {

                                        var materialId =
                                            parseInt($("#yarnMaterial" + rowNo).val()) || 0;

                                        var colorId =
                                            parseInt($("#YarnColor" + rowNo).val()) || 0;

                                        var $company =
                                            $("#CompanyName" + rowNo);

                                        var $colorCode =
                                            $("#ColorCode" + rowNo);

                                        // Clear
                                        $company.empty().append(
                                            $("<option>", {
                                                value: "0",
                                                text: "Select Company"
                                            })
                                        );

                                        $colorCode.val("");

                                        if (materialId === 0 || colorId === 0) {
                                            return false;
                                        }

                                        if (!ArrayYarnColor || !ArrayYarnColor[0]) {
                                            return false;
                                        }

                                        var companyFound = false;

                                        $.each(ArrayYarnColor[0], function (i, item) {

                                            var itemMaterialId =
                                                parseInt(item.YarnMaterialID) || 0;

                                            var itemColorId =
                                                parseInt(item.YarnColorID) || 0;

                                            if (
                                                itemMaterialId === materialId &&
                                                itemColorId === colorId
                                            ) {

                                                var companyId =
                                                    parseInt(item.CompanyId) || 0;

                                                var companyName =
                                                    item.CompanyName || "";

                                                var companyCode =
                                                    item.CompanyCode || "";

                                                if (
                                                    companyId > 0 &&
                                                    companyName !== ""
                                                ) {

                                                    $company.append(
                                                        $("<option>", {
                                                            value: companyId,
                                                            text: companyName
                                                        })
                                                    );

                                                    $company.val(
                                                        String(companyId)
                                                    );

                                                    $colorCode.val(
                                                        companyCode
                                                    );

                                                    companyFound = true;

                                                    console.log(
                                                        "Company Bind:",
                                                        {
                                                            CompanyId: companyId,
                                                            CompanyName: companyName,
                                                            CompanyCode: companyCode
                                                        }
                                                    );

                                                    return false;
                                                }

                                            }

                                        });

                                        return companyFound;
                                    }
                                    function YarnCompanyChange(rowNo) {

                                        var companyId =
                                            $("#CompanyName" + rowNo).val() || "0";


                                        /*
                                         * Here companyId is actual CompanyID.
                                         * No company name save/use for database.
                                         */

                                        console.log(
                                            "Selected CompanyID:",
                                            companyId
                                        );

                                    }
                                    function FunctionIsLogin() {
                                        $.ajax({
                                            type: "POST",
                                            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                                            data: "{ 'userName':'0' }",
                                            contentType: "application/json; charset=utf-8",
                                            dataType: "json",
                                            success: function (data) {
                                                if (data.d == "false") {
                                                    window.location.replace("/Index");
                                                }
                                            }
                                        });
                                    }
                                    function getPartyDetail(callback) {
                                        var formData = new FormData();
                                        $.ajax({
                                            type: "POST",
                                            url: '/WebServiceNikunjTextile.asmx/getPartyDetails',
                                            data: formData,
                                            dataType: 'json',
                                            contentType: false,
                                            processData: false,
                                            success: function (response) {
                                                if (response.Code == "200") {
                                                    $('#ddlParty').empty();
                                                    $('#ddlParty').append($("<option>", { value: "", text: "Select Party Name" }));

                                                    if (response.listPartyMaster && response.listPartyMaster.length > 0) {
                                                        $.each(response.listPartyMaster, function (i, item) {
                                                            $('#ddlParty').append($("<option>", {
