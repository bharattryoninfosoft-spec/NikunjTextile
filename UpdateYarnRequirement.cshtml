    function YarnColorChange(rowno) {


        //console.log(ArrayYarnColor[0]);

        var yarnColors = ArrayYarnColor[0];

        var YarColo = "#YarnColor" + rowno;
        var tdYarnColor = "#tdYarnColor" + rowno;

        var yarnColor = yarnColors.find(item => item.YarnColorID === parseInt($(YarColo).val()));
        //alert(yarnColor.YarnColorCode);
        var ColorCode = "#" + yarnColor.YarnColorCode;
        $(tdYarnColor).css("background-color", ColorCode);

        YarnPOCompany(rowno);

    }


    function YarnPOCompany(rowno) {

        var YarnMaterial = "yarnMaterial" + rowno;
        var YarnColor = "YarnColor" + rowno;


        var YM = document.getElementById(YarnMaterial);
        var YC = document.getElementById(YarnColor);


        if (YM.value != '0' && YC.value != '0') {
            //alert(YM.value + " " + YC.value);

            var formData = new FormData();
            formData.append('YarnMaterialID', YM.value);
            formData.append('YarnColorID', YC.value);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnPOBillToCompany',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    console.log(response);
                    if (response.listPartyMaster.length > 0) {



                        var appendTemp = "";
                        for (var j = 1; j <= response.listPartyMaster.length; j++) {

                            var CompanyName = "CompanyName" + rowno;
                            var CN = "#CompanyName" + rowno;
                            document.getElementById(CompanyName).innerHTML = "";


                            $(CN).empty();


                            if (response.listPartyMaster.length == 1) {
                                $(CN).append("<option value='0' > Select Company </option>");
                                for (var i = 0; i < response.listPartyMaster.length; i++) {
                                    appendTemp = "<option value='" + response.listPartyMaster[i].PartyId + "' selected> " + response.listPartyMaster[i].PartyName + " </option>";
                                    $(CN).append(appendTemp);
                                }
                            }
                            else {
                                $(CN).append("<option value='0' selected> Select Company </option>");
                                for (var i = 0; i < response.listPartyMaster.length; i++) {
                                    appendTemp = "<option value='" + response.listPartyMaster[i].PartyId + "' > " + response.listPartyMaster[i].PartyName + " </option>";
                                    $(CN).append(appendTemp);
                                }
                            }


                        }


                        YarnCompanyChange(rowno);

                    }
                    else {
                        var CompanyName = "CompanyName" + rowno;
                        var CN = "#CompanyName" + rowno;
                        document.getElementById(CompanyName).innerHTML = "";


                        $(CN).empty();
                    }

                },
                error: function (request, status, error) {

                    //window.location.href = 'SaleInvoice';

                }
            });






        }


    }


