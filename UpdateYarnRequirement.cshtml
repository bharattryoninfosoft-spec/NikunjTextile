                                        }).then(function (result) {
                                            if (!result.isConfirmed) return;

                                            var detailId = parseInt($("#txtYarnRequirementDetailID" + rowNo).val(), 10) || 0;
                                            if (detailId > 0) {
                                                var deleted = $.trim($("#txtDeleteYarnDetailsArray").val() || "");
