                    tempColorMatching += '<td style="width: 20%; text-align: center;">';
                    tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                    tempColorMatching += '<select id="yarnMaterial' + ArrayNo + '" class="form-control" style=" min-height: 30px; width: 90%; font-size: x-small;" onfocusout="validate(this)" onchange="YarnPOCompany(\'' + ArrayNo + '\')">';

                    tempColorMatching += '<option value="0">Select Yarn Material</option>';
                    for (var i = 0; i < ArrayYarnMaterial[0].length; i++) {
                        if (YMVal == ArrayYarnMaterial[0][i].YarnMaterialID) {
                            tempColorMatching += "<option value='" + ArrayYarnMaterial[0][i].YarnMaterialID + "' selected> " + ArrayYarnMaterial[0][i].YarnMaterial + " </option>";
                        }
                        else {
                            tempColorMatching += "<option value='" + ArrayYarnMaterial[0][i].YarnMaterialID + "'> " + ArrayYarnMaterial[0][i].YarnMaterial + " </option>";
                        }

                    }
                    tempColorMatching += '</select>';
                    tempColorMatching += '</div>';
                    tempColorMatching += '</td>';

                    var YC = "#YarnColor" + no;
                    var YCVal = $(YC).val();

                    var tdYM = "#tdYarnColor" + no;
                    var divColor = $(tdYM).css("background-color");


                    tempColorMatching += '<td style="width: 20%; text-align: center;">';
                    tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                    tempColorMatching += '<div id="tdYarnColor' + ArrayNo + '" style="width: 35px; height: 35px; border-radius: 3px; background-color: ' + divColor + '"></div>';
                    tempColorMatching += '<select id="YarnColor' + ArrayNo + '" class="form-control is-valid" style=" min-height: 30px; width: 90%; font-size: x-small;" onfocusout="validate(this)" onchange="YarnColorChange(\'' + ArrayNo + '\')">';

                    tempColorMatching += '<option value="0" >Select Yarn Color</option>';
                    for (var i = 0; i < ArrayYarnColor[0].length; i++) {
                        if (YCVal == ArrayYarnColor[0][i].YarnColorID) {
                            tempColorMatching += "<option value='" + ArrayYarnColor[0][i].YarnColorID + "' selected> " + ArrayYarnColor[0][i].YarnColor + " </option>";
                        }
                        else {
                            tempColorMatching += "<option value='" + ArrayYarnColor[0][i].YarnColorID + "'> " + ArrayYarnColor[0][i].YarnColor + " </option>";
                        }
                    }
                    tempColorMatching += '</select>';
                    tempColorMatching += '</div>';
                    tempColorMatching += '</td>';

                    var CN = "#CompanyName" + no;
                    var CNN = "#CompanyName" + no + " option";
                    var CNVal = $(CN).val();

                    let CompanyNameoptions = [];
                    $(CNN).each(function () {
                        CompanyNameoptions.push({
                            value: $(this).val(),
                            text: $(this).text()
                        });
                    });

                    tempColorMatching += '<td style="width: 20%; text-align: center;">';
                    tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                    //tempColorMatching += '<input type="text" class="form-control" id="CompanyName' + ArrayNo + '" placeholder="Company Name" value="' + CNVal + '" onfocusout="validate(this)" />';
                    tempColorMatching += '<select id="CompanyName' + ArrayNo + '" class="form-control is-valid" style=" min-height: 30px; width: 90%; font-size: x-small;" onfocusout="validate(this)" >';

                    for (var i = 0; i < CompanyNameoptions.length; i++) {
                        if (CompanyNameoptions[i].value == $(CN).val()) {
                            tempColorMatching += "<option value='" + CompanyNameoptions[i].value + "' selected> " + CompanyNameoptions[i].text + " </option>";
                        }
                        else {
                            tempColorMatching += "<option value='" + CompanyNameoptions[i].value + "'> " + CompanyNameoptions[i].text + " </option>";
                        }
                    }

                    tempColorMatching += '</select>';

                    tempColorMatching += '</div>';
                    tempColorMatching += '</td>';

                    var CC = "#ColorCode" + no;
                    var CCVal = $(CC).val();

                    tempColorMatching += '<td style="width: 20%; text-align: center;">';
                    tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                    tempColorMatching += '<input type="text" class="form-control" id="ColorCode' + ArrayNo + '" placeholder="Color Code" value="' + CCVal + '" onfocusout="validate(this)" />';
                    tempColorMatching += '</div>';
                    tempColorMatching += '</td>';

                    var NOB = "#NoOfBox" + no;
                    var NOBVal = $(NOB).val();

                    tempColorMatching += '<td style="width: 17%; text-align: center;">';
                    tempColorMatching += '<div class="field-wrapper" style="display:flex;align-items:center;justify-content:center;gap:5px;">';
                    tempColorMatching += '<input type="tel" class="form-control" id="NoOfBox' + ArrayNo + '" placeholder="No Of Boxes" value="' + NOBVal + '" onfocusout="validate(this)" onkeypress="return (event.charCode>=48 && event.charCode<=57)" />';
                    tempColorMatching += '</div>';
                    tempColorMatching += '</td>';

                    tempColorMatching += '</tr>';



                    $("#txtYarnDetailsArray").val(txtColorArray + ArrayNo + "|");
                    $("#tableItemData").append(tempColorMatching);



                }

            }
            else {
