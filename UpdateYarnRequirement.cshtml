                                    function validate(code) {
                                        if (!code) return true;
                                        code.value = String(code.value || "").replace(/\s+/g, ' ').trim();
                                        if (code.value === "" || code.value === "0" || code.value === "-1") {
                                            document.getElementById(code.id).classList.remove("is-valid");
                                            document.getElementById(code.id).classList.add("is-invalid");
                                            return false;
                                        } else {
                                            document.getElementById(code.id).classList.add("is-valid");
                                            document.getElementById(code.id).classList.remove("is-invalid");
                                            return true;
                                        }
                                    }
                                    function checkUpdate() {
                                        var YarnRequirementID = parseInt($("#YarnRequirementID").val(), 10) || 0;
                                        var InvoiceDate = $.trim($("#InvoiceDate").val() || "");
                                        var RequirementNo = $.trim($("#RequirementNo").val() || "");
                                        var PartyId = parseInt($("#ddlParty").val(), 10) || 0;
                                        var DeleteYarnDetailsArray = $.trim($("#txtDeleteYarnDetailsArray").val() || "");

                                        if (YarnRequirementID <= 0) {
                                            Swal.fire({ icon: "warning", title: "Invalid Requirement", text: "Yarn Requirement ID is missing." });
                                            return false;
                                        }
                                        if (InvoiceDate === "") {
                                            Swal.fire({ icon: "warning", title: "Requirement Date Required", text: "Please select Requirement Date." });
                                            return false;
                                        }
                                        if (RequirementNo === "" || RequirementNo === "0") {
                                            Swal.fire({ icon: "warning", title: "Requirement No Required", text: "Requirement No is required." });
                                            return false;
                                        }
                                        if (PartyId <= 0) {
                                            Swal.fire({ icon: "warning", title: "Party Required", text: "Please Select Party Name." });
                                            return false;
                                        }

                                        var rows = $("#tableItemData > tr");
                                        if (rows.length === 0) {
                                            Swal.fire({ icon: "warning", title: "No Yarn Data", text: "Please add at least one Yarn Data." });
                                            return false;
                                        }

                                        var details = [];
                                        var duplicateMap = {};
                                        var valid = true;

                                        rows.each(function (index) {
                                            if (!valid) return;
                                            var rowNo = ($(this).attr("id") || "").replace("trMatching", "");
                                            if (!rowNo) return;

                                            var detailId = parseInt($("#txtYarnRequirementDetailID" + rowNo).val(), 10) || 0;
                                            var materialId = parseInt($("#yarnMaterialDetail" + rowNo).val(), 10) || 0;
                                            var colorId = parseInt($("#YarnColorDetail" + rowNo).val(), 10) || 0;
                                            var companyId = parseInt($("#CompanyIDDetail" + rowNo).val(), 10) || 0;
                                            var colorCode = $.trim($("#ColorCodeDetail" + rowNo).val() || "");
                                            var noOfBox = parseInt($("#NoOfBoxDetail" + rowNo).val(), 10) || 0;

                                            if (materialId <= 0 || colorId <= 0 || noOfBox <= 0) {
                                                Swal.fire({ icon: "warning", title: "Invalid Row Data", text: "Please complete all fields in row " + (index + 1) + "." });
                                                valid = false;
                                                return;
                                            }

                                            var duplicateKey = materialId + "_" + colorId + "_" + companyId;
                                            if (duplicateMap[duplicateKey]) {
                                                Swal.fire({ icon: "warning", title: "Duplicate Entry", text: "Duplicate material/color/company combination found." });
                                                valid = false;
                                                return;
                                            }
                                            duplicateMap[duplicateKey] = true;

                                            details.push({
                                                YarnRequirementDetailID: detailId,
                                                YarnMaterialID: materialId,
                                                YarnColorID: colorId,
                                                CompanyName: companyId,
                                                CompanyColourCode: colorCode,
                                                NoofBoxes: noOfBox
                                            });
                                        });

                                        if (!valid || details.length === 0) return false;

                                        var payload = {
                                            YarnRequirementID: YarnRequirementID,
                                            RequirementDates: InvoiceDate,
                                            RequirementNo: RequirementNo,
                                            PartyId: PartyId,
                                            DeleteYarnDetailsArray: DeleteYarnDetailsArray,
                                            listYarnRequirementDetail: details
                                        };

                                        var formData = new FormData();
                                        formData.append("YarnRequirementArray", JSON.stringify(payload));
                                        $("#Updatebtn").prop("disabled", true);

                                        $.ajax({
                                            type: "POST",
                                            url: "/WebServiceNikunjTextile.asmx/UpdateYarnRequirementMasterMaster",
                                            data: formData,
                                            dataType: "json",
                                            contentType: false,
                                            processData: false,
                                            success: function (response) {
                                                if (response.Code == "200" || response.Code == 200) {
                                                    Swal.fire({
                                                        icon: "success",
                                                        title: "Success",
                                                        text: "Yarn Requirement Updated Successfully.",
                                                        allowOutsideClick: false
                                                    }).then(function () {
                                                        window.location.href = "YarnRequirement";
                                                    });
                                                } else {
                                                    Swal.fire({ icon: "error", title: "Error", text: response.Message || "Problem occurred while updating." });
                                                    $("#Updatebtn").prop("disabled", false);
                                                }
                                            },
                                            error: function (request, status, error) {
                                                console.error("Update error:", error);
                                                Swal.fire({ icon: "error", title: "Server Error", text: "Problem occurred while submitting your data." });
                                                $("#Updatebtn").prop("disabled", false);
                                            }
                                        });
                                        return false;
                                    }
