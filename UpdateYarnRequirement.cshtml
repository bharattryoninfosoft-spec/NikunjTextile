            processData: false,
            success: function (response) {
                console.log(response);
                //alert(response.Code);

                if (response.Code == "200") {

                    ArrayYarnColor.push(response.listYarnColorMaster);
                    ArrayYarnMaterial.push(response.listYarnMaterialMaster);

