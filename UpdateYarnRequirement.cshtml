                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });
            }

            //alert("hello");





        }


    }



    function deleteYarnData(abc) {
        var trMatching = "#trMatching" + abc;

        var replace = abc + "|";
        var ColorArray = $("#txtYarnDetailsArray").val();

        var DesignColorMatchingDetailsID = "#txtYarnRequirementDetailID" + abc;
        var DCMDID = $(DesignColorMatchingDetailsID).val() + ",";
        var DeleteColorArray = $("#txtDeleteYarnDetailsArray").val();

        if ($(DesignColorMatchingDetailsID).val() != "0") {
            $("#txtDeleteYarnDetailsArray").val(DeleteColorArray + DCMDID);
        }



        $(trMatching).remove();
        $("#txtYarnDetailsArray").val(ColorArray.replace(replace, ''));
    }




</script>