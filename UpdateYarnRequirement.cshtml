                                        </select>
                                        <div class="field-placeholder">GST Slab<sup style="color:red;">*</sup></div>
                                        <div class="GSTSLABId-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="GSTSLABId-invalid-feedback invalid-feedback">Please Select GST Slab</div>
