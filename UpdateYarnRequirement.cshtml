                                        <div class="Denier-invalid-feedback invalid-feedback">Please Mention Denier</div>
                                    </div>
                                    <!-- Field wrapper end -->
                                </div>


                                <div class="col-4">

                                    <!-- Field wrapper start -->
                                    <div class="field-wrapper">
                                        <div class="form-check form-check-inline">
                                            <br />
                                            <input id="IsActiveYarnMaterial" class="form-check-input" type="checkbox" value="1" checked>
                                            <label class="form-check-label" for="IsActiveYarnMaterial-default">Is Active</label>

                                        </div>
                                    </div>
                                    <!-- Field wrapper end -->
                                </div>

                                <div class="col-4">

                                    <!-- Field wrapper start -->
                                    <div class="field-wrapper">
