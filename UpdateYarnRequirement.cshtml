    function AddDuplicateYarnDetailData() {

        var PartyNo = $("#ddlParty").val();

        if (PartyNo == "") {
            notes.show('Please Select Party Name.', {
                type: 'danger',
                //title: 'Opps.!',
                //icon: '<i class="icon-alert-triangle"></i>'
            });

            validate(document.getElementById("ddlParty"));

        }
        else {
            var txtColorArray = $("#txtYarnDetailsArray").val();
            var tempColorMatching = '';

            var txtColorData = txtColorArray.slice(0, -1).split('|');

            var isValid = 0;

            for (var j = 0; j < txtColorData.length; j++) {
                //alert(txtColorData[j]);
                var yarnMaterial = "yarnMaterial" + txtColorData[j];
                var YarnColor = "YarnColor" + txtColorData[j];
                var CompanyName = "CompanyName" + txtColorData[j];
                var ColorCode = "ColorCode" + txtColorData[j];
                var NoOfBox = "NoOfBox" + txtColorData[j];

                var YM = document.getElementById(yarnMaterial);
                var YC = document.getElementById(YarnColor);
                var CN = document.getElementById(CompanyName);
                var CC = document.getElementById(ColorCode);
                var NOB = document.getElementById(NoOfBox);

                if (validate(YM) == false || validate(YC) == false || validate(CN) == false || validate(CC) == false || validate(NOB) == false) {
                    validate(YM);
                    validate(YC);
                    validate(CN);
                    validate(CC);
                    validate(NOB);
                    isValid = parseInt(isValid) + parseInt(1);
                }

            }



            if (isValid == 0) {
                for (var i = 0; i < txtColorData.length; i++) {

                    var no = parseInt(txtColorData[(txtColorData.length - 1)]);

                    var ArrayNo = parseInt(txtColorData[(txtColorData.length - 1)]) + parseInt(1);
                    
                    tempColorMatching += '<tr id="trMatching' + ArrayNo + '">';
                    tempColorMatching += '<td style="width:3%;">';
                    tempColorMatching += '<i class="fa fa-times fa-2x" style="color: red; margin-top: 14px; cursor:pointer;" onclick="deleteYarnData(' + ArrayNo + ')"></i>';
                    tempColorMatching += '<input type="hidden" id="txtYarnRequirementDetailID' + ArrayNo + '" value="0">';
                    tempColorMatching += '</td>';

                    var YM = "#yarnMaterial" + no;
