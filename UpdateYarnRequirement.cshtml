                                        <div class="YarnMaterial-invalid-feedback invalid-feedback">Please Mention Yarn Material & Quality</div>
                                    </div>
                                    <!-- Field wrapper end -->
                                </div>

                                <div class="col-4">
                                    <!-- Field wrapper start -->
                                    <div class="field-wrapper">
