                                    <th style="color: white !important;">Is Default</th>
                                    <!--<th>Position</th>-->
                                    <th style="color: white !important;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>
<!-- Content wrapper end -->

<script>
    document.title = "Godown Master - Nikunj Textile";
</script>
<script>
    var currentPagePermission = {};
    $(document).ready(function () {
        var permission = sessionStorage.getItem("PagePermission");
        if (permission != null) {
            currentPagePermission = JSON.parse(permission);
            console.log("currentPagePermission",currentPagePermission);
            // ADD
            if (currentPagePermission.Add == false) {
                $("#AddFinacialYearModel").hide();
            }           
        }
        FunctionIsLogin();
        displayData(0);
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function functionSearch() {
        //displayPagginationData();
        displayData(0);
    }
    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }



        var searchGodown = $("#search-Godown").val();

        var formData = new FormData();
        formData.append('searchGodown', searchGodown);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getGodownMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {




                //$.ajax({
                //    type: "GET",
                //    url: '/WebServiceNikunjTextile.asmx/getGodownMaster?startFrom=' + rowStart,
                //    //getItemCat
                //    data: "{ 'startFrom':'" + rowStart + "' }",
                //    dataType: 'json',
                //    contentType: false,
                //    processData: false,
                //    success: function (response) {

                console.log(response);

                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listGodownMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
                    $("#view-more-btn").show();
                }

                var SrNo = rowStart + 1;
                for (var i = 0; i < response.listGodownMaster.length; i++) {

                    var Top = i - 1;
                    var Previous = i + 1;

                    //console.log(response.listGodownMaster[Previous].TypeID);



                    temp += "<tr>";
                    temp += "<td>" + SrNo++ + "</td>";
                    temp += "<td>" + response.listGodownMaster[i].GodownTitle + "</td>";
                    temp += "<td>" + response.listGodownMaster[i].GodownAddress + "</td>";

                    if (response.listGodownMaster[i].IsActive == "1") {
                        temp += "<td><span class='badge bg-success'>Active</span></td>";
                    }
                    else {
                        temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                    }
                    
                    if (response.listGodownMaster[i].IsDefault == "1") {
                        temp += "<td><span class='badge bg-success'>Default</span></td>";
                    }
                    else {
                        temp += "<td><span class='badge bg-danger'>Not Default</span></td>";
                    }

                    //temp += "<td>" + ActionPosition + "</td>";
                    temp += "<td><div class='actions'>";

                    // EDIT
                    if (currentPagePermission.Edit == true) {

                        temp += "<a href='javascript:void(0);' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='' " +
                            "data-original-title='Edit' " +
                            "data-bs-toggle='modal' " +
                            "data-bs-target='#addNewContact' " +
                            "onclick='showRecords(" + response.listGodownMaster[i].GodownID + ")'>" +
                            "<i class='icon-edit1 text-info' style='font-size: larger;'></i>" +
                            "</a> &nbsp;&nbsp;";
                    }

                    // DELETE
                    if (currentPagePermission.Delete == true) {
                        temp += "<a href='javascript:void(0);' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='' " +
                            "data-original-title='Delete' " +
                            "onclick='functionYarnDelete(" + response.listGodownMaster[i].GodownID + ")'>" +
                            "<i class='icon-x-circle text-danger' style='font-size: larger;'></i>" +
                            "</a>&nbsp;&nbsp;&nbsp;";
                    }
                        temp += "<a href='javascript:void(0);' " +
                            "data-toggle='tooltip' " +
                            "data-placement='top' " +
                            "title='Is Default Update' " +
                            "data-original-title='Is Active' " +
                            "onclick='functionYarnActive(" + response.listGodownMaster[i].GodownID + ")'>" +
                            "<i class='icon-verified_user text-primary' style='font-size: larger;'></i>" +
                            "</a>";                    
                    temp += "</div></td>";
                    //temp += "<td><div class='actions'>< a href = 'javascript:void(0);' data - toggle='tooltip' data - placement='top' title = '' data - original - title='Edit' data - bs - toggle='modal' data - bs - target='#addNewContact' onclick = 'showRecords(" + response.listGodownMaster[i].GodownID + ")' > <i class='icon-edit1 text-info' style='font-size: larger;'></i></a > & nbsp;& nbsp; ";
                    //temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listGodownMaster[i].GodownID + ")'><i class='icon-x-circle text-danger' style='font-size: larger;'></i></a>&nbsp;&nbsp;&nbsp;";
                    //temp += "<a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='Is Default Update' data-original-title='Is Active' onclick='functionYarnActive(" + response.listGodownMaster[i].GodownID + ")'><i class='icon-verified_user text-primary' style='font-size: larger;'></i></a></div>  &nbsp;&nbsp;";
                    //temp += "</div></td>";
                    temp += "</tr>";
                }

                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        }); 
    }
    function functionYarnActive(abc) {
        if (confirm('Are you sure you want to update default status ?')) {
            // Save it!
            //alert(abc)
            var formData = new FormData();
            formData.append('GodownID', abc);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/ActiveFGodownMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {

                    if (response.Code == 1) {

                        notes.show("Year status updated successflly.", {
                            type: 'success',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                        displayData($("#rowStartCount").val());
                    }

                    else {
                        notes.show("Problem has been occurred while upadating your year.", {
                            type: 'danger',
                            //title: 'Opps.!',
                            //icon: '<i class="icon-alert-triangle"></i>'
                        });

                    }
                },
                error: function (error) {
                    // alert("Problem has been occurred while upadating your data.");
                    notes.show("Problem has been occurred while upadating your year.", {
                        type: 'danger',
                        //title: 'Opps.!',
                        //icon: '<i class="icon-alert-triangle"></i>'
                    });

                }
            });


        } else {
            // Do nothing!
            console.log('Problem has been occurred while upadating your data.');
        }
        //alert(abc);
    }
    function functionIsManual() {


        const myCheckbox = document.getElementById('IsManually');

        if (myCheckbox.checked) {
            // The checkbox is checked
            $("#divTableLocation").show();
            $("#divNoOfRack").hide();
            $("#divGoLocation").hide();
        } else {
            // The checkbox is unchecked
            $("#divTableLocation").hide();
            $("#divNoOfRack").show();
            $("#divGoLocation").show();
        }

    }
    function AddLocationbtn() {


        var GodownTitle = $("#GodownTitle").val();

        if (GodownTitle == "") {
            notess.show('Please Mention Godown Title.', {
                type: 'danger',
                //title: 'Opps.!',
                //icon: '<i class="icon-alert-triangle"></i>'
            });
        }
        else {

            var txtColorArray = $("#txtLocationArray").val();
            var tempColorMatching = '';

            var txtColorData = txtColorArray.slice(0, -1).split('|');

            var isValid = 0;

            for (var j = 0; j < txtColorData.length; j++) {

                var GodownLocation = "GodownLocation" + txtColorData[j];
                var GL = document.getElementById(GodownLocation);

                if (validate(GL) == false) {
                    validate(GL);
                    isValid = parseInt(isValid) + parseInt(1);
                }

            }


            if (isValid == 0) {

                //for (var i = 0; i < txtColorData.length; i++) {

                var no = parseInt(txtColorData[(txtColorData.length - 1)]);

                var ArrayNo = parseInt(txtColorData[(txtColorData.length - 1)]) + parseInt(1);

                tempColorMatching += '<tr id="trLocation' + ArrayNo + '">';



                tempColorMatching += '<td style="width:10%; text-align: end;">';
                tempColorMatching += '<i class="fa fa-times fa-2x" style="color: red; margin-top: 14px; cursor:pointer;" onclick="deleteLocationData(\'' + ArrayNo + '\')"></i>';
                tempColorMatching += '</td>';
                tempColorMatching += '<td style="width: 80%;">';
                tempColorMatching += '<div class="field-wrapper" style=" margin: 0;">';
                tempColorMatching += '<input type="hidden" id="GodownLocationID' + ArrayNo + '" name="GodownLocationID' + ArrayNo + '" placeholder="GodownLocationID" class="form-control clear-field" onfocusout="validate(this)" value="0">';
                tempColorMatching += '<input type="text" id="GodownLocation' + ArrayNo + '" name="GodownLocation' + ArrayNo + '" placeholder="Location" class="form-control clear-field" onfocusout="validate(this)">';
                tempColorMatching += '<div class="field-placeholder">Godown Location<sup style="color:red;">*</sup></div>';
                tempColorMatching += '<div class="GodownLocation' + ArrayNo + '-valid-feedback valid-feedback">Looks good!</div>';
                tempColorMatching += '<div class="GodownLocation' + ArrayNo + '-invalid-feedback invalid-feedback">Please Mention Godown Location</div>';
                tempColorMatching += '</div>';
                tempColorMatching += '</td>';
                tempColorMatching += '</tr>';


                $("#txtLocationArray").val(txtColorArray + ArrayNo + "|");
                $("#tableItemData").append(tempColorMatching);


                setTimeout(() => {
                    var boxno = "#GodownLocation" + ArrayNo;
                    $(boxno).focus();
                }, 500);


                //}



            }
            else {
                notess.show('Please Fill Location.', {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });
                return;
            }



        }


    }
    function deleteLocationData(abc) {

        var trMatching = "#trLocation" + abc;

        var replace = abc + "|";
        var ColorArray = $("#txtLocationArray").val();



        var GodownID = "#GodownLocationID" + abc;
        var DCMDID = $(GodownID).val() + ",";
        var DeleteColorArray = $("#txtDeleteLocationArray").val();

        if ($(GodownID).val() != "0") {
            $("#txtDeleteLocationArray").val(DeleteColorArray + DCMDID);
        }


        $(trMatching).remove();

        $("#txtLocationArray").val(ColorArray.replace(replace, ''));

    }
    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#divManuallyOrAuto").show();
        $("#addNewContactLabel").html("Add Godown / Warehouse");
        $("#add-alert").hide();

        $("#GodownTitle").val('');
        $("#GodownAddress").val('');
        $("#NoOfRack").val('');
        $("#PrefixTitle").val('');
        $("#txtLocationArray").val('1|');
        $('#IsActive').prop('checked', true);
        $('#IsManually').prop('checked', false);

        //$("#tblYarnMaterial tbody").empty();
        //var dataTable = $('#tblYarnMaterial');

        var tempLocation = '';

        tempLocation += '<tr id="trLocation1">';
        tempLocation += '<td style="width:10%;">';
        tempLocation += '<div class="field-wrapper" style="display:flex;align-items:center; gap:5px;">';
        tempLocation += '</div>';
        tempLocation += '</td>';

        tempLocation += '<td style="width: 80%;">';
        tempLocation += '<div class="field-wrapper">';
        tempLocation += '<input type="text" id="GodownLocation1" name="GodownLocation1" placeholder="Location" class="form-control clear-field is-valid" onfocusout="validate(this)">';
        tempLocation += '<div class="field-placeholder">Godown Location<sup style="color:red;">*</sup></div>';
        tempLocation += '<div class="GodownLocation1-valid-feedback valid-feedback" style="">Looks good!</div>';
        tempLocation += '<div class="GodownLocation1-invalid-feedback invalid-feedback" style="display: none;">Please Mention Godown Location</div>';
        tempLocation += '</div>';
        tempLocation += '</td>';
        tempLocation += '</tr>';
        //$("#tblYarnMaterial tbody").empty();
        //dataTable.html(tempLocation);
        $("#tableItemData").html(tempLocation);


        $("#divTableLocation").hide();
        $("#divNoOfRack").show();
        $("#divGoLocation").show();

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }
    function checkSaveView() {

        var IsActive = "0";
        if ($("#IsActive").is(':checked')) {
            //$("#isDefault").attr('value', 'true');
            IsActive = "1";
        }

        var IsDefault = "0";
        if ($("#IsDefault").is(':checked')) {
            //$("#isDefault").attr('value', 'true');
            IsDefault = "1";
        }


        var Type = $('#GodownTitle').val();
        var GSTNumber = $('#GSTNumber').val();
