@{
    Layout = "/_LayoutPage1.cshtml";
}



<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
     
        <button id="AddFinacialYearModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Godown / Warehouse</button>
     
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Godown / Warehouse</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />
                        <div class="row gutters">

                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">
                                    <div class="col-5">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input type="text" id="GodownTitle" name="GodownTitle" placeholder="Godown / Warehouse" class="form-control clear-field" onfocusout="validate(this)">
                                            <div class="field-placeholder">Godown / Warehouse Name<sup style="color:red;">*</sup></div>
                                            <div class="GodownTitle-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="GodownTitle-invalid-feedback invalid-feedback">Please Mention Godown Title</div>
                                        </div>
                                        <div class="field-wrapper">
                                            <input type="text" id="GSTNumber" name="GSTNumber" placeholder="GST Number" class="form-control clear-field">
                                            <div class="field-placeholder">GST Number</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-5">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <textarea class="form-control clear-field" id="GodownAddress" name="GodownAddress" placeholder="Godown Address"></textarea>
                                            <div class="field-placeholder">Godown Address</div>
                                            <div class="Type-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="Type-invalid-feedback invalid-feedback">Please Mention Godown </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-2">

                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <div class="form-check form-check-inline">
                                                <input id="IsActive" class="form-check-input" type="checkbox" value="1" checked>
                                                <label class="form-check-label" for="IsActive">Is Active</label>

                                                <br />
                                                <br />
                                                <input id="IsDefault" class="form-check-input" type="checkbox" value="0">
                                                <label class="form-check-label" for="IsDefault">Is Default</label>

                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <hr />
                                <div class="row gutters" id="divLocation">



                                    <div class="col-3">

                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper" id="divManuallyOrAuto">
                                            <div class="form-check form-check-inline">
                                                <br />
                                                <input id="IsManually" class="form-check-input" type="checkbox" value="0" onchange="functionIsManual()">
                                                <label class="form-check-label" for="IsManually-default">Manually Or Auto</label>

                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>



                                    <div class="col-4" id="divNoOfRack">
                                        <div class="field-wrapper">
                                            <input type="text" id="NoOfRack" name="NoOfRack" placeholder="No Of Rack" class="form-control clear-field" onfocusout="validate(this)" onkeypress="return (event.charCode>=48 && event.charCode<=57)">
                                            <div class="field-placeholder">No Of Rack<sup style="color:red;">*</sup></div>
                                            <div class="NoOfRack-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="NoOfRack-invalid-feedback invalid-feedback">Please Mention No Of Rack</div>
                                        </div>
                                    </div>



                                    <div class="col-4" id="divGoLocation">
                                        <div class="field-wrapper">
                                            <input type="text" id="PrefixTitle" name="PrefixTitle" placeholder="Prefix Title" class="form-control clear-field" onfocusout="validate(this)">
                                            <div class="field-placeholder">Prefix Title<sup style="color:red;">*</sup></div>
                                            <div class="NoOfRack-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="NoOfRack-invalid-feedback invalid-feedback">Please Mention Prefix Title</div>
                                        </div>
                                    </div>





                                    <div class="col-8" id="divTableLocation" style="display:none;">

                                        <div class="table-responsive">

                                            <table class="table table-bordered" id="tblYarnMaterial" style="overflow: hidden; border-color: transparent;">


                                                <tbody id="tableItemData">
                                                    <tr id="trLocation1">
                                                        <td style="width:10%;">
                                                            <div class="field-wrapper" style="display:flex;align-items:center; gap:5px;">
                                                            </div>
                                                        </td>

                                                        <td style="width: 80%;">

                                                            <div class="field-wrapper" style=" margin: 0;">
                                                                <input type="hidden" id="GodownLocationID1" name="GodownLocationID1" placeholder="GodownLocationID1" class="form-control clear-field" onfocusout="validate(this)" value="0">
                                                                <input type="text" id="GodownLocation1" name="GodownLocation1" placeholder="Location" class="form-control clear-field" onfocusout="validate(this)">
                                                                <div class="field-placeholder">Godown Location<sup style="color:red;">*</sup></div>
                                                                <div class="GodownLocation1-valid-feedback valid-feedback">Looks good!</div>
                                                                <div class="GodownLocation1-invalid-feedback invalid-feedback">Please Mention Godown Location</div>
                                                            </div>
                                                        </td>

                                                    </tr>

                                                </tbody>




                                            </table>
                                        </div>

                                        <button id="AddLocationbtn" type="button" class="btn btn-secondary" onclick="AddLocationbtn()" style="margin-top: -5px; margin-left: 13%;"><i class="fa fa-plus"></i> ADD LOCATION</button>
                                    </div>
                                </div>

                                <input type="hidden" id="txtDeleteLocationArray" name="txtYarnDetailsArray" class="form-control" value="" />
                                <input type="hidden" id="txtLocationArray" name="txtYarnDetailsArray" class="form-control" value="1|" />
                            </div>
                        </div>
                    </div>
                    <input id="edit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">
                        <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Godown / Warehouse</div>
                    <br />
                    <div class="row gutters">

                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12">
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <!-- Field wrapper start -->
                            <div class="field-wrapper">
                                <input id="search-Godown" placeholder="Search Godown" type="text" class="form-control clear-field detail" onkeyup="functionSearch()">
                                <div class="field-placeholder">Search Godown</div>
                            </div>
