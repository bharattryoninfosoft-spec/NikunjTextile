        }

        function functionYarnPO(YarnPOID) {
            var formData = new FormData();
            formData.append('YarnPOID', YarnPOID);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnPODetails',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response && response.listYarnPOMaster && response.listYarnPOMaster.length > 0) {
                        var po = response.listYarnPOMaster[0];

                        $("#YarnPOID").val(po.YarnPOID);
                        $("#PODate").val(po.PODates);
                        $("#PONo").val(po.PONo);

                        if (po.IsSameAsSupplier == "1") {
                            $("#chcekSupplierDetails").prop("checked", true);
                            $("#ddlBillTo").prop("disabled", true);
                        }

                        $("#ddlSupplier").val(po.SupplierPartyID);
                        $("#select2-ddlSupplier-container").html(po.SupplierPartyName);
                        $("#SupplierPhone").val(po.SupplierMobileNo);
                        $("#SupplierAddress").val(po.SupplierBillingAddress);
                        $("#SupplierGST").val(po.SupplierGSTIN);

                        $("#ddlBillTo").val(po.BillToPartyID);
                        $("#select2-ddlBillTo-container").html(po.BillToPartyName);
                        $("#BillToGST").val(po.BillToGSTIN);
                        $("#BillToAddress").val(po.BillToBillingAddress);

                        $("#ddlCompany").val(po.CompanyPartyID);
                        $("#select2-ddlCompany-container").html(po.CompanyPartyName);
                        $("#CompanyGST").val(po.CompanyGSTIN);
                        $("#CompanyAddress").val(po.CompanyBillingAddress);

                        $("#ddlGodownID").val(po.GodownID);
                        $("#select2-ddlGodownID-container").html(po.GodownTitle);
                        $("#GodownAddress").val(po.GodownAddress);

                        $("#DeliveryTime").val(po.DeliveryTime);
                        $("#PaymentCondition").val(po.PaymentCondition);
                        $("#NotesRemarks").val(po.NotesRemarks);

                        if (po.NotesRemarks && po.NotesRemarks != "") {
                            $("#DivAddNotes").hide();
                            $("#DivNotes").show();
                        }

                        addedItemsArray = [];
                        rowCounter = 0;

                        if (po.listYarnPODetails && po.listYarnPODetails.length > 0) {
                            $.each(po.listYarnPODetails, function (j, detail) {
                                rowCounter++;
                                var matName = detail.YarnMaterial || (ArrayYarnMaterial[0] ? (ArrayYarnMaterial[0].find(x => x.YarnMaterialID === detail.YarnMaterialID)?.YarnMaterial || "") : "");
                                var colorName = detail.YarnColor || (ArrayYarnColor[0] ? (ArrayYarnColor[0].find(x => x.YarnColorID === detail.YarnColorID)?.YarnColor || "") : "");
                                var gstName = detail.GSTSLABName || (ArrayGstSlab[0] ? (ArrayGstSlab[0].find(x => x.GSTSLABId === detail.GSTSLABId)?.GSTSLABName || "") : "");

                                addedItemsArray.push({
                                    RowId: rowCounter,
                                    YarnPODetailID: detail.YarnPODetailID || 0,
                                    YarnMaterialID: detail.YarnMaterialID,
                                    YarnMaterialName: matName,
                                    YarnColorID: detail.YarnColorID,
                                    YarnColorName: colorName,
                                    YarnColorBg: "#" + (detail.YarnColorCode || "eee"),
                                    CompanyCode: detail.CompanyCode || "",
                                    Qty: parseFloat(detail.Qty || 0),
                                    Rate: parseFloat(detail.Rate || 0),
                                    GSTSLABId: detail.GSTSLABId,
                                    GSTSLABName: gstName,
                                    Amount: parseFloat(detail.Amount || 0)
                                });
                            });
                        }
                        renderAddedTable();
                    }
                }
            });
        }

        function checkSave() {
            var YarnPOID = $("#YarnPOID").val();
            var Supplier = $("#ddlSupplier").val();
            var BillTo = $("#ddlBillTo").val();
            var Company = $("#ddlCompany").val();
            var Godown = $("#ddlGodownID").val();
            var DeleteYarnDetailsArray = $("#txtDeleteYarnDetailsArray").val();

            if (Supplier === "0" || !Supplier) return Toast.fire({ icon: 'warning', title: 'Please Select Supplier Name.' });
            if (Company === "0" || !Company) return Toast.fire({ icon: 'warning', title: 'Please Select Company Detail.' });
            if (BillTo === "0" || !BillTo) return Toast.fire({ icon: 'warning', title: 'Please Select Bill To.' });
            if (Godown === "0" || !Godown) return Toast.fire({ icon: 'warning', title: 'Please Select Godown.' });

            if (addedItemsArray.length === 0) {
                return Toast.fire({ icon: 'warning', title: 'Please add at least one item to the table.' });
            }

            var PODate = document.getElementById("PODate");
            var PONo = document.getElementById("PONo");
            var DeliveryTime = document.getElementById("DeliveryTime");
            var PaymentCondition = document.getElementById("PaymentCondition");
            var NotesRemarks = document.getElementById("NotesRemarks");

            if (!validate(PODate) || !validate(PONo) || !validate(DeliveryTime) || !validate(PaymentCondition)) {
                return Toast.fire({ icon: 'warning', title: 'Please fill all required fields.' });
            } else {
                var appendTemp = '';
                $.each(addedItemsArray, function (i, item) {
                    appendTemp += '{';
                    appendTemp += '"YarnPODetailID": "' + item.YarnPODetailID + '",';
                    appendTemp += '"YarnMaterialID": "' + item.YarnMaterialID + '",';
                    appendTemp += '"YarnColorID": "' + item.YarnColorID + '",';
                    appendTemp += '"CompanyCode": "' + item.CompanyCode + '",';
                    appendTemp += '"Qty": "' + item.Qty + '",';
                    appendTemp += '"Rate": "' + item.Rate + '",';
                    appendTemp += '"GSTSLABId": "' + item.GSTSLABId + '",';
                    appendTemp += '"Amount": "' + item.Amount + '"';
                    appendTemp += '},';
                });

                var IsSameAsSupplier = $('#chcekSupplierDetails').prop('checked') ? 1 : 0;
                var IsSameAsCompany = $('#chcekCompanyDetails').prop('checked') ? 1 : 0;

                var YarnPO = '{';
                YarnPO += '"YarnPOID":"' + YarnPOID + '", ';
                YarnPO += '"PODates":"' + PODate.value + '", ';
                YarnPO += '"PONo":"' + PONo.value + '",';
                YarnPO += '"SupplierPartyID":"' + Supplier + '",';
                YarnPO += '"IsSameAsSupplier":"' + IsSameAsSupplier + '",';
                YarnPO += '"BillToPartyID":"' + BillTo + '",';
                YarnPO += '"CompanyPartyID":"' + Company + '",';
                YarnPO += '"IsSameAsCompany":"' + IsSameAsCompany + '",';
                YarnPO += '"GodownID":"' + Godown + '",';
                YarnPO += '"TotalQty":"' + $("#TotalQty").text() + '",';
                YarnPO += '"TotalRate":"' + $("#TotalRate").text() + '",';
                YarnPO += '"TotalAmount":"' + $("#TotalAmount").text() + '",';
                YarnPO += '"DeliveryTime":"' + DeliveryTime.value + '",';
                YarnPO += '"PaymentCondition":"' + PaymentCondition.value + '",';
                YarnPO += '"NotesRemarks":"' + NotesRemarks.value + '",';
                YarnPO += '"DeleteYarnDetailsArray":"' + (DeleteYarnDetailsArray.endsWith(',') ? DeleteYarnDetailsArray.slice(0, -1) : DeleteYarnDetailsArray) + '",';
                YarnPO += '"listYarnPODetails": [' + appendTemp.slice(0, -1) + ']';
                YarnPO += '}';

                const formData = new FormData();
                formData.append('YarnPOArray', YarnPO);

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/UpdateYarnPOMasterMaster',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.Code == 200) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: 'Yarn PO Updated Successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = 'YarnPO';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.Message || 'Failed to update record.'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Problem occurred while submitting your data.'
                        });
                    }
                });
            }
        }

        /* Generic Helpers */
        function validateFloatKeyPress(el, evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode;
            var number = el.value.split('.');
            if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57)) return false;
            if (number.length > 1 && charCode == 46) return false;
            return true;
        }

        function validate(code) {
            if (!code || !code.id) return true;
            if (code.value == "0" || code.value == "") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                return false;
            } else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                return true;
            }
        }

