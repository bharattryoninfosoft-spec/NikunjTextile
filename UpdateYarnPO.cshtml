    function YarnDetailArray() {


        var txtColorArray = $("#txtYarnDetailsArray").val();
        var txtColorData = txtColorArray.slice(0, -1).split('|');

        var YarnDTArray = [];

        var TempYarnDTAry = "";

        for (var j = 0; j < txtColorData.length; j++) {

            var SrNo = j + 1;
            var yarnMaterial = "#yarnMaterial" + txtColorData[j];
            var yarnMaterialVal = $(yarnMaterial).val();

            var YarnColor = "#YarnColor" + txtColorData[j];
            var YarnColorVal = $(YarnColor).val();

            var CompanyCode = "#CompanyCode" + txtColorData[j];
            var CompanyCodeVal = $(CompanyCode).val();


            TempYarnDTAry += '{';
            TempYarnDTAry += '"Srno": "' + SrNo + '",';
            TempYarnDTAry += '"YarnMaterial": "' + yarnMaterialVal + '",';
            TempYarnDTAry += '"YarnColor": "' + YarnColorVal + '",';
            TempYarnDTAry += '"CompanyCode": "' + CompanyCodeVal + '"';
            TempYarnDTAry += '},';


        }


        var pushar = '[' + TempYarnDTAry.slice(0, -1) + ']';


        var data = JSON.parse(pushar);
        console.log(data);

        var IsMatch = 0;

        for (var i = 0; i < data.length; i++) {
            for (var j = i + 1; j < data.length; j++) {



                if (data[i].YarnMaterial === data[j].YarnMaterial &&
                    data[i].YarnColor === data[j].YarnColor &&
                    data[i].CompanyCode === data[j].CompanyCode) {
                    console.log("SrNo " + data[j].Srno + " match with SrNo " + data[i].Srno);
                    //alert("SrNo " + data[j].Srno + " match with SrNo " + data[i].Srno);

                    var tr1 = "#trMatching" + data[j].Srno;
                    var tr2 = "#trMatching" + data[i].Srno;

                    $(tr1).css('background-color', 'indianred');
                    $(tr2).css('background-color', 'indianred');
                    IsMatch = 1;
                }

            }
        }

        //alert(IsMatch);

        //console.log(IsMatch);
        if (IsMatch == 0) {
            $('[id^="trMatching"]').removeAttr('style');
            return true;
        }
        else {
            return false;
        }

    }


