    function calculationYarn(rowNo) {
        //alert(rowNo);
        var Qty = "#Qty" + rowNo;
        var Rate = "#Rate" + rowNo;
        var Amount = "#Amount" + rowNo;
        var GST = "#GST" + rowNo;

        var QtyValue = $(Qty).val();
        var RateValue = $(Rate).val();
        var GSTValue = $(GST).val();
        //alert(GSTValue);

        console.log(ArrayGstSlab[0]);
        var GstSlab = ArrayGstSlab[0];
        //var yarnColors = ArrayYarnColor[0];

        //var YarColo = "#YarnColor" + rowno;
        //var tdYarnColor = "#tdYarnColor" + rowno;

        //var yarnColor = yarnColors.find(item => item.YarnColorID === parseInt($(YarColo).val()));
        var GSTIGST = GstSlab.find(item => item.GSTSLABId === parseInt(GSTValue));
        //console.log(GSTIGST);

        //alert(GSTIGST.IGST);
        var IGSTVAL = parseFloat(GSTIGST.IGST) / parseFloat(100);
        if (QtyValue == "") {
            QtyValue = "0";
        }

        if (RateValue == "") {
            RateValue = "0";
        }

        if (IGSTVAL == 0) {
            var TotalAmount = (parseFloat(QtyValue) * parseFloat(RateValue));
        }
        else {
            var TotalAmount = ((parseFloat(QtyValue) * parseFloat(RateValue)) * parseFloat(IGSTVAL)) + ((parseFloat(QtyValue) * parseFloat(RateValue)));
        }

        //alert(TotalAmount);
        $(Amount).val(TotalAmount.toFixed(2));






        ArrayTotalCalculation();







    }




    function ArrayTotalCalculation() {
        var txtColorArray = $("#txtYarnDetailsArray").val();
        var txtColorData = txtColorArray.slice(0, -1).split('|');

        var TotalQty = 0;
        var TotalRate = 0;
        var TotalAmount = 0;

        for (var j = 0; j < txtColorData.length; j++) {

            var Qty = "#Qty" + txtColorData[j];
            var QtyVal = $(Qty).val();

            var Rate = "#Rate" + txtColorData[j];
            var RateVal = $(Rate).val();

