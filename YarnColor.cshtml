@{
    Layout = "/_LayoutPage1.cshtml";
}
<style>
    /* Hide Export Buttons */
    .dt-buttons,
    .dataTables_wrapper .dt-buttons {
        display: none !important;
    }

    /* Hide Search Box */
    .dataTables_filter {
        display: none !important;
    }

    /* Hide "Showing x to y of z entries" */
    .dataTables_info {
        display: none !important;
    }

    /* Hide Pagination */
    .dataTables_paginate {
        display: none !important;
    }

    /* Hide "Show Entries" Dropdown */
    .dataTables_length {
        display: none !important;
    }
</style>
<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <button id="AddFinacialYearModel" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="clearAll()">Add Yarn Color</button>
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Yarn Color</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="modal-body" id="divModelBody">
                        <div id="add-alert" class="alert alert-success" role="alert">
                            Record has been saved Successfully.
                        </div>
                        <br />

                        <div class="row gutters">
                            <div class="col-xl-12 col-lg-12 col-md-8 col-sm-8 col-12">
                                <div class="row gutters">
                                    <div class="col-5">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <input type="text" id="YarnColor" name="YarnColor" class="form-control clear-field" onfocusout="validate(this)">
                                            <div class="field-placeholder">Yarn Color<sup style="color:red;">*</sup></div>
                                            <div class="YarnColor-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="YarnColor-invalid-feedback invalid-feedback">Please Mention Yarn Color</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-3">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <div class="input-group">
                                                <span class="input-group-text">#</span>
                                                <input type="text" id="YarnColorCode" name="YarnColorCode" class="form-control clear-field" onfocusout="validate(this)" onkeyup="changeYarnColor(this)">
                                            </div>
                                            <div class="field-placeholder">Yarn Color Code<sup style="color:red;">*</sup></div>
                                            <div class="YarnColor-valid-feedback valid-feedback">Looks good!</div>
                                            <div class="YarnColor-invalid-feedback invalid-feedback">Please Mention Yarn Color Code</div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>

                                    <div class="col-2">
                                        <!-- Field wrapper start -->
                                        <div class="field-wrapper">
                                            <div class="form-check form-check-inline">
                                                <br />
                                                <input id="IsActive" class="form-check-input" type="checkbox" value="1" checked>
                                                <label class="form-check-label" for="IsActive-default" style="background-color: white; border-radius: 10px; padding: 3px;">Is Active</label>

                                            </div>
                                        </div>
                                        <!-- Field wrapper end -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input id="edit-id" type="hidden" />
                    <div id="notess"></div>
                    <div class="modal-footer">
                        <button id="saveViewbtn" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="savebtn" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Yarn Color</div>
                    <br />
                    <div class="row gutters">


                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12">
                        </div>


                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <!-- Field wrapper start -->
                            <div class="field-wrapper">
                                <input id="search-Yarn-Color" placeholder="Search Yarn Color." type="text" class="form-control clear-field detail" onkeyup="functionSearch()">
                                <div class="field-placeholder">Search Yarn Color.</div>
                            </div>
                            <!-- Field wrapper end -->
                        </div>

                    </div>

                    <div class="table-responsive">
                        <table id="copy-print-csv" class="table table-hover table-bordered m-0">
                            <thead>
                                <tr style="background-color: #1273eb;">
                                    <th style="color:white;">Sr No</th>
                                    <th style="color:white;">Yarn Color</th>
                                    <th style="color:white;">Color Code</th>
                                    <th style="color:white;">Is Active</th>
                                    <!--<th>Position</th>-->
                                    <th style="color:white;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="view-more-styl-class">
        <button type="button" class="btn btn-primary view-more-btn-style" id="view-more-btn" onclick="displayData(1)">View More</button>
        <br /><br /><br />
    </div>
    <!-- Row end -->

</div>
@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var currentPagePermission = {};

        // Configure SweetAlert2 Toast helper for non-blocking notifications
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        $(document).ready(function () {
            FunctionIsLogin();
            displayData(0);
        });

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: request.statusText || 'Failed to fetch default company.'
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                    console.log(error);
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) { }
            });
        }

        function functionSearch() {
            displayData(0);
        }

        function displayData(rowStartCheck) {
            var rowStart = 0;
            if (rowStartCheck != 0) {
                rowStart = parseInt($("#rowStartCount").val()) + 10;
                $("#rowStartCount").val(rowStart);
            } else {
                rowStart = 0;
                $("#rowStartCount").val("0");
            }

            var searchYarnColor = $("#search-Yarn-Color").val();
            var formData = new FormData();
            formData.append('SearchYarnColor', searchYarnColor);
            formData.append('startFrom', rowStart);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    console.log(response);

                    if (rowStart == 0) {
                        $("#copy-print-csv tbody").empty();
                    }
                    var tableBody = $("#copy-print-csv tbody");
                    var temp = "";

                    if (response.listYarnColorMaster.length < 10) {
                        $("#view-more-btn").hide();
                    } else {
                        $("#view-more-btn").show();
                    }

                    var SrNo = rowStart + 1;
                    for (var i = 0; i < response.listYarnColorMaster.length; i++) {
                        var Top = i - 1;
                        var Previous = i + 1;

                        temp += "<tr>";
                        temp += "<td>" + SrNo++ + "</td>";
                        temp += "<td>" + response.listYarnColorMaster[i].YarnColor + "</td>";
                        temp += "<td><span style='background-color: #" + response.listYarnColorMaster[i].YarnColorCode + "; border-radius: 2px; font-weight: 600; padding: 0.25rem 1.5rem; line-height: 100%; vertical-align: middle; margin-right: 5px;'></span> #" + response.listYarnColorMaster[i].YarnColorCode + "</td>";

                        if (response.listYarnColorMaster[i].IsActive == "1") {
                            temp += "<td><span class='badge bg-success'>Active</span></td>";
                        } else {
                            temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                        }

                        temp += "<td><div class='actions'>";
                        temp += "<a href='javascript:void(0);' class='YarnColorEdit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listYarnColorMaster[i].YarnColorID + ")'><i class='icon-edit1 text-info'></i></a>";
                        temp += "<a href='javascript:void(0);' class='YarnColorDelete' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listYarnColorMaster[i].YarnColorID + ")'><i class='icon-x-circle text-danger'></i></a>";
                        temp += "</div></td>";
                        temp += "</tr>";
                    }

                    tableBody.append(temp);

                    var permission = getCookie("PagePermission");
                    if (permission) {
                        var currentPagePermission = JSON.parse(permission);
                        if (currentPagePermission.Add == false) { $("#AddFinacialYearModel").hide(); }
                        if (currentPagePermission.Edit == false) { $(".YarnColorEdit").hide(); }
                        if (currentPagePermission.Delete == false) { $(".YarnColorDelete").hide(); }
                    }
                },
                error: function (request, status, error) { }
            });
        }

        function changeYarnColor(abc) {
            if (abc.value == "") {
                $("#divModelBody").css("background-color", "white");
            } else {
                var colorCode = "#" + abc.value;
                $("#divModelBody").css("background-color", colorCode);
            }
        }

        function functionFYDelete(abc) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this record!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('FinancialYearIDs', abc);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteFinancialYearMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 1) {
                                displayData(0);
                                Toast.fire({
                                    icon: 'success',
                                    title: 'Financial Year deleted successfully.'
                                });
                            } else {
                                Toast.fire({
                                    icon: 'error',
                                    title: 'Problem has been occurred while deleting Financial Year.'
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'Problem has been occurred while deleting Financial Year.'
                            });
                        }
                    });
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Yarn Color");
            $("#add-alert").hide();

            $("#YarnColor").val('');
            $("#YarnColorCode").val('');
            $("#divModelBody").css("background-color", "white");

            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function checkSaveView() {
            var IsActive = $("#IsActive").is(':checked') ? "1" : "0";
            var YarnColor = $('#YarnColor').val();
            var YarnColorCode = $('#YarnColorCode').val();
            var YColor = YarnColorCode.slice(0, 1);

            if (YColor == "#") {
                Toast.fire({
                    icon: 'warning',
                    title: 'Please Remove # in Yarn Color.'
                });
            } else {
                if (validate(document.getElementById('YarnColor')) == false || validate(document.getElementById('YarnColorCode')) == false) {
                    validate(document.getElementById('YarnColor'));
                    validate(document.getElementById('YarnColorCode'));
                } else {
                    var formData = new FormData();
                    formData.append('YarnColor', YarnColor);
                    formData.append('YarnColorCode', YarnColorCode);
                    formData.append('IsActive', IsActive);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/insertYarnColorMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 201) {
                                clearAll();
                                Toast.fire({
                                    icon: 'success',
                                    title: response.Message
                                });
                                displayData(0);
                                $("#cancelbtn").click();
                            } else {
                                Toast.fire({
                                    icon: 'error',
                                    title: response.Message
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'An error occurred while saving.'
                            });
                        }
                    });
                }
            }
        }

        function checkSave() {
            var IsActive = $("#IsActive").is(':checked') ? "1" : "0";
            var YarnColor = $('#YarnColor').val();
            var YarnColorCode = $('#YarnColorCode').val();
            var YColor = YarnColorCode.slice(0, 1);

            if (YColor == "#") {
                Toast.fire({
                    icon: 'warning',
                    title: 'Please Remove # in Yarn Color.'
                });
            } else {
                if (validate(document.getElementById('YarnColor')) == false || validate(document.getElementById('YarnColorCode')) == false) {
                    validate(document.getElementById('YarnColor'));
                    validate(document.getElementById('YarnColorCode'));
                } else {
                    var formData = new FormData();
                    formData.append('YarnColor', YarnColor);
                    formData.append('YarnColorCode', YarnColorCode);
                    formData.append('IsActive', IsActive);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/insertYarnColorMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 201) {
                                clearAll();
                                Toast.fire({
                                    icon: 'success',
                                    title: response.Message
                                });
                                displayData(0);
                            } else {
                                Toast.fire({
                                    icon: 'error',
                                    title: response.Message
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'An error occurred while saving.'
                            });
                        }
                    });
                }
            }
        }

        function checkEdit() {
            var id = $("#edit-id").val();
            var IsActive = $("#IsActive").is(':checked') ? "1" : "0";
            var YarnColor = $('#YarnColor').val();
            var YarnColorCode = $('#YarnColorCode').val();
            var YColor = YarnColorCode.slice(0, 1);

            if (YColor == "#") {
                Toast.fire({
                    icon: 'warning',
                    title: 'Please Remove # in Yarn Color.'
                });
            } else {
                if (validate(document.getElementById('YarnColor')) == false || validate(document.getElementById('YarnColorCode')) == false) {
                    validate(document.getElementById('YarnColor'));
                    validate(document.getElementById('YarnColorCode'));
                } else {
                    var formData = new FormData();
                    formData.append('YarnColorID', id);
                    formData.append('YarnColor', YarnColor);
                    formData.append('YarnColorCode', YarnColorCode);
                    formData.append('IsActive', IsActive);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/EditYarnColorMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 201) {
                                clearAll();
                                $('#YarnColor').val('');
                                Toast.fire({
                                    icon: 'success',
                                    title: response.Message
                                });
                                displayData(0);
                                $("#cancelbtn").click();
                            } else {
                                Toast.fire({
                                    icon: 'error',
                                    title: response.Message
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'An error occurred while editing.'
                            });
                        }
                    });
                }
            }
        }

        function showRecords(id) {
            clearAll();
            $("#edit-id").val(id);
            $("#saveViewbtn").hide();
            $("#savebtn").hide();
            $("#editbtn").show();
            $("#addNewContactLabel").html("Edit Yarn Color");

            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getYarnColorMasterById?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#YarnColor").val(response.listYarnColorMaster[0].YarnColor);
                        $("#YarnColorCode").val(response.listYarnColorMaster[0].YarnColorCode);

                        var colorCode = "#" + response.listYarnColorMaster[0].YarnColorCode;
                        $("#divModelBody").css("background-color", colorCode);

                        if (response.listYarnColorMaster[0].IsActive == "1") {
                            $("#IsActive").prop('checked', true);
                        } else {
                            $("#IsActive").prop('checked', false);
                        }
                    } else {
                        Toast.fire({
                            icon: 'error',
                            title: response.Message
                        });
                    }
                },
                error: function (request, status, error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Failed to retrieve record details.'
                    });
                }
            });
        }

        function functionYarnDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You want to delete this Yarn Color!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('YarnColorID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteYarnColorMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {
                                Toast.fire({
                                    icon: 'success',
                                    title: 'Yarn Color deleted successfully.'
                                });
                                displayData(0);
                            } else {
                                Toast.fire({
                                    icon: 'error',
                                    title: 'Problem has been occurred while deleting Yarn Color.'
                                });
                            }
                        },
                        error: function (error) {
                            Toast.fire({
                                icon: 'error',
                                title: 'Problem has been occurred while deleting Yarn Color.'
                            });
                        }
                    });
                }
            });
        }

        function onPostUp(QueueNo) {
            var down = $("#PostUp_" + QueueNo + "").val();
            var formData = new FormData();
            formData.append('PostQueue', down);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateTbl_YarnColorQueue',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 1) {
                        displayData($("#rowStartCount").val());
                    } else {
                        Toast.fire({
                            icon: 'error',
                            title: 'Problem has been occurred while retrieving your data.'
                        });
                    }
                },
                error: function (error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Problem has been occurred while retrieving your data.'
                    });
                }
            });
        }

        function onPostDown(QueueNo) {
            var down = $("#PostDown_" + QueueNo + "").val();
            var formData = new FormData();
            formData.append('PostQueue', down);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/UpdateTbl_YarnColorQueue',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 1) {
                        displayData($("#rowStartCount").val());
                    } else {
                        Toast.fire({
                            icon: 'error',
                            title: 'Problem has been occurred while retrieving your data.'
                        });
                    }
                },
                error: function (error) {
                    Toast.fire({
                        icon: 'error',
                        title: 'Problem has been occurred while retrieving your data.'
                    });
                }
            });
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();

            if (code.value == "") {
                if (code.id == "name") {
                    $(".company-invalid-feedback").show();
                }
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            } else if ((code.id == "igst" || code.id == "gst" || code.id == "cess") && code.value[code.value.length - 1] == ".") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            } else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }
    </script>
}

