                var url = URL.createObjectURL(file);
                img.src = url;
                img.onload = function () {
                    URL.revokeObjectURL(url);
                    resolve(img);
                };
                img.onerror = function (err) {
                    URL.revokeObjectURL(url);
                    reject(err);
                };
            });
