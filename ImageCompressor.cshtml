        function validateEmail(email, element) {
            const re = /^(([^<>()[\]\\.,;:\s@@\"]+(\.[^<>()[\]\\.,;:\s@@\"]+)*)|(\".+\"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
            email = email.replace(/\s+/g, ' ').trim();
            var idStr = "#" + element.id;
            var errorMessageValid = "." + element.id + "-valid-feedback";
            var errorMessageInvalid = "." + element.id + "-invalid-feedback";
            if (email == "") {
                //document.getElementById(element.id).classList.remove("is-valid");
                //document.getElementById(element.id).classList.add("is-invalid");
                //$(errorMessageValid).hide(); $(errorMessageInvalid).show();
                return true;
            }
            else if (!re.test(String(email).toLowerCase())) {
                document.getElementById(element.id).classList.remove("is-valid");
                document.getElementById(element.id).classList.add("is-invalid");
                $(errorMessageValid).hide(); $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(element.id).classList.add("is-valid");
                document.getElementById(element.id).classList.remove("is-invalid");
                $(errorMessageValid).show(); $(errorMessageInvalid).hide();
                return true;
            }
        }

        function validate(code) {
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback .valid-feedback").hide();
            if (code.value == "" || code.value == "0") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                $(".phone-less-feedback").hide();
                $(".alt-phone-invalid-feedback").hide();
                $(".phone-invalid-feedback").hide();
                $(".phone-default-invalid-feedback").hide();
                return false;
            }
            else if ((code.id == "phone" || code.id == "alt-phone" || code.id == "phone-default") && code.value.length != 10) {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                if (code.id == "phone") {
                    $(".phone-less-feedback").show();
                    $(".phone-invalid-feedback").hide();
                } else if (code.id == "alt-phone") {
                    $(".alt-phone-less-feedback").show();
                    $(".alt-phone-invalid-feedback").hide();
                }
                else if (code.id == "phone-default") {
                    $(".phone-default-less-feedback").show();
                    $(".phone-default-invalid-feedback").hide();
                }

                return false;
            }
            else if ((code.id == "business-type" || code.id == "business-cate" || code.id == "state" || code.id == "business-type-default" || code.id == "business-cate-default" || code.id == "state-default")) {

                if (code.value != "-1") {
                    document.getElementById(code.id).classList.add("is-valid");
                    document.getElementById(code.id).classList.remove("is-invalid");
                    $(errorMessageValid).show();
                    $(errorMessageInvalid).hide();
                    return true;
                }
                else {
                    $(errorMessageInvalid).show();
                    document.getElementById(code.id).classList.add("is-invalid");
                    document.getElementById(code.id).classList.remove("is-valid");
                    return false;
                }
            }
            else if ((code.id == "gst")) {


                if (code.value.length == 2) {
                    $('#state').val(code.value);
                }

                if (code.value.length == 15) {


                    $("#gst").val(code.value.toUpperCase());
                    let gstVal = code.value.toUpperCase();
                    let eMMessage = "No Errors";
                    let statecode = gstVal.substring(0, 2);
                    let patternstatecode = /^[0-9]{2}$/
