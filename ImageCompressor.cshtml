                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#Updatebtn").hide();
        $("#addNewContactLabel").html("Add Design Entry Form");
        $("#add-alert").hide();

        $("#YarnColor").val('');

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }
    function validate(code) {
        //alert(code);
        //alert(code.id + "  " + code.value);
        //console.log(code.id + " Hello" + code.value);

        //code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";
        $(".invalid-feedback .valid-feedback").hide();

        //alert(code.value);

        if (code.value == "0") {

            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else
            if (code.value == "") {

                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
    }
</script>
<script>
    async function compressImages() {

        let files = document.getElementById("folderInput").files;

        if (files.length === 0) {

            Swal.fire({
                icon: 'warning',
                title: 'Please select folder'
            });

            return;
        }

        document.getElementById("btnLoader").style.display = "inline";
        document.getElementById("compressBtn").disabled = true;

        let zip = new JSZip();
        let folder = zip.folder("CompressImages");

        let scaleFactor = 0.5;

        for (let file of files) {

            if (file.name.toLowerCase().endsWith(".bmp")) {

                let img = await loadImage(file);

                let canvas = document.createElement("canvas");

                canvas.width = img.width * scaleFactor;
                canvas.height = img.height * scaleFactor;

                let ctx = canvas.getContext("2d");

                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                let blob = await new Promise(resolve =>
                    canvas.toBlob(resolve, "image/jpeg", 0.8)
                );

                let newName = file.name.replace(".bmp", ".bmp");

                folder.file(newName, blob);
            }
        }

        zip.generateAsync({ type: "blob" }).then(function (content) {

            saveAs(content, "CompressImages.zip");

            document.getElementById("btnLoader").style.display = "none";
            document.getElementById("compressBtn").disabled = false;

            Swal.fire({
                icon: 'success',
                title: 'Compression Completed',
                text: 'CompressImages.zip downloaded successfully',
                confirmButtonColor: '#3085d6'
            });

        });
    }

    function loadImage(file) {

        return new Promise(resolve => {

            let img = new Image();

            img.src = URL.createObjectURL(file);

            img.onload = function () {
                resolve(img);
            }

        });

    }
</script>
