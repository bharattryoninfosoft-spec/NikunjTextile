<script>
    async function compressImages() {

        let files = document.getElementById("folderInput").files;

        if (files.length === 0) {

            Swal.fire({
                icon: 'warning',
                title: 'Please select folder'
            });

            return;
        }

        document.getElementById("btnLoader").style.display = "inline";
        document.getElementById("compressBtn").disabled = true;

        let zip = new JSZip();
        let folder = zip.folder("CompressImages");

        let scaleFactor = 0.5;

        for (let file of files) {

            if (file.name.toLowerCase().endsWith(".bmp")) {

                let img = await loadImage(file);

                let canvas = document.createElement("canvas");

                canvas.width = img.width * scaleFactor;
                canvas.height = img.height * scaleFactor;

                let ctx = canvas.getContext("2d");

                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                let blob = await new Promise(resolve =>
                    canvas.toBlob(resolve, "image/jpeg", 0.8)
                );

                let newName = file.name.replace(".bmp", ".bmp");

                folder.file(newName, blob);
            }
        }

        zip.generateAsync({ type: "blob" }).then(function (content) {

            saveAs(content, "CompressImages.zip");

            document.getElementById("btnLoader").style.display = "none";
            document.getElementById("compressBtn").disabled = false;

            Swal.fire({
                icon: 'success',
                title: 'Compression Completed',
                text: 'CompressImages.zip downloaded successfully',
                confirmButtonColor: '#3085d6'
            });

        });
    }

    function loadImage(file) {

        return new Promise(resolve => {

            let img = new Image();

            img.src = URL.createObjectURL(file);

            img.onload = function () {
                resolve(img);
            }

        });

    }
</script>
