@{
    Layout = "/_LayoutPage1.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<style>
    .drop-zone {
        border: 2px dashed #1273eb;
        border-radius: 12px;
        padding: 35px 20px;
        text-align: center;
        background: #f8fbff;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .drop-zone:hover, .drop-zone.dragover {
        background: #eef5ff;
        border-color: #0b5ed7;
        box-shadow: 0 4px 15px rgba(18, 115, 235, 0.15);
    }

    .drop-zone-icon {
        font-size: 48px;
        color: #1273eb;
        margin-bottom: 10px;
    }

    .drop-zone-title {
        font-size: 18px;
        font-weight: 700;
        color: #2e3a59;
        margin-bottom: 5px;
    }

    .drop-zone-subtitle {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 15px;
    }

    .stats-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px 20px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

    .stats-value {
        font-size: 22px;
        font-weight: 700;
        color: #1273eb;
    }

    .stats-label {
        font-size: 12px;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .progress-bar-container {
        display: none;
        margin-top: 15px;
    }

    .file-tree-container {
        max-height: 320px;
        overflow-y: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #ffffff;
    }

    .file-tree-table th {
        position: sticky;
        top: 0;
        background: #1273eb;
        color: #ffffff !important;
        z-index: 2;
    }
</style>

<div class="content-wrapper">
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            
            <div class="card">
                <div class="card-header-lg d-flex justify-content-between align-items-center">
                    <h4><i class="icon-folder me-2 text-primary"></i> Batch Image & Folder Compressor</h4>
                    <span class="badge bg-primary">Multiple Folders & Subfolder Support</span>
                </div>

                <div class="card-body">
                    <!-- Drop Zone & Folder Selection -->
                    <div class="row gutters mb-3">
                        <div class="col-12">
                            <div id="dropZone" class="drop-zone">
                                <div class="drop-zone-icon">
                                    <i class="fa fa-folder-open"></i>
                                </div>
                                <div class="drop-zone-title">Drag & Drop Multiple Folders or Files Here</div>
                                <div class="drop-zone-subtitle">All nested folders & subfolders (Folder in Folder) will be preserved in the output ZIP</div>
                                
                                <div class="d-flex justify-content-center gap-2 mt-2">
                                    <button type="button" class="btn btn-primary" onclick="$('#folderInput').click()">
                                        <i class="fa fa-folder me-1"></i> Select Folders
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="$('#fileInput').click()">
                                        <i class="fa fa-image me-1"></i> Select Individual Files
                                    </button>
                                </div>

                                <input type="file" id="folderInput" webkitdirectory directory multiple style="display:none;" onchange="handleFolderSelect(this.files)">
                                <input type="file" id="fileInput" multiple accept="image/*,.bmp,.jpg,.jpeg,.png,.webp" style="display:none;" onchange="handleFileSelect(this.files)">
                            </div>
                        </div>
                    </div>

                    <!-- Compression Settings Bar -->
                    <div class="row gutters mb-3">
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div class="field-wrapper">
                                <select id="scaleFactorSelect" class="form-select">
                                    <option value="0.25">25% (Smallest File Size)</option>
                                    <option value="0.5" selected>50% (Recommended)</option>
                                    <option value="0.75">75% (High Resolution)</option>
                                    <option value="1.0">100% (Original Dimensions)</option>
                                </select>
                                <div class="field-placeholder">Image Scale / Dimension</div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div class="field-wrapper">
                                <select id="qualitySelect" class="form-select">
                                    <option value="0.6">60% (Maximum Compression)</option>
                                    <option value="0.8" selected>80% (High Quality)</option>
                                    <option value="0.9">90% (Very High Quality)</option>
                                    <option value="1.0">100% (Lossless / Max Quality)</option>
                                </select>
                                <div class="field-placeholder">Output Image Quality</div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div class="field-wrapper">
                                <select id="formatSelect" class="form-select">
                                    <option value="image/jpeg" selected>Convert to JPEG (.jpg)</option>
                                    <option value="image/webp">Convert to WEBP (.webp)</option>
                                    <option value="image/png">Convert to PNG (.png)</option>
                                </select>
                                <div class="field-placeholder">Output Target Format</div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12 d-flex align-items-center gap-2">
                            <button id="compressBtn" type="button" class="btn btn-success w-100 py-2 fw-bold" onclick="compressAndZip()" disabled>
                                <i class="fa fa-file-archive-o me-1"></i> Compress & Download ZIP
                            </button>
                            <button id="clearBtn" type="button" class="btn btn-danger py-2" onclick="clearSelectedFiles()" style="display:none;" title="Clear Selection">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Progress Bar & Status -->
                    <div id="progressContainer" class="progress-bar-container">
                        <div class="d-flex justify-content-between mb-1 fw-bold text-dark">
                            <span id="progressStatusText">Compressing files...</span>
                            <span id="progressPercentText">0%</span>
                        </div>
                        <div class="progress" style="height: 14px;">
                            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>

                    <!-- Statistics Bar -->
                    <div id="statsRow" class="row gutters mt-3" style="display:none;">
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div class="stats-card">
                                <div id="lblTotalFiles" class="stats-value">0</div>
                                <div class="stats-label">Total Images</div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div class="stats-card">
                                <div id="lblTotalFolders" class="stats-value">0</div>
                                <div class="stats-label">Unique Folders</div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div class="stats-card">
                                <div id="lblOriginalSize" class="stats-value">0 MB</div>
                                <div class="stats-label">Original Size</div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                            <div id="cardSavings" class="stats-card">
                                <div id="lblCompressedSize" class="stats-value text-success">--</div>
                                <div class="stats-label">Compressed Size</div>
                            </div>
                        </div>
                    </div>

                    <!-- File List Table -->
                    <div id="fileTableContainer" class="mt-3" style="display:none;">
                        <h6 class="fw-bold text-secondary mb-2"><i class="fa fa-list me-1"></i> Detected Files & Nested Folders Structure</h6>
                        <div class="file-tree-container">
                            <table class="table table-sm table-hover table-bordered m-0 file-tree-table">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;" class="text-center">#</th>
                                        <th>Relative Subfolder & File Path</th>
                                        <th style="width: 130px;" class="text-end">Original Size</th>
                                        <th style="width: 130px;" class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="fileListBody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>
        var selectedFileList = [];

        $(document).ready(function () {
            $('.active, .show, .current-page').removeClass('active show current-page');
            $("#aImageCompressor").addClass("current-page");

            // Setup Drag and Drop
            var $dropZone = $("#dropZone");

            $dropZone.on("dragover dragenter", function (e) {
                e.preventDefault();
                e.stopPropagation();
                $dropZone.addClass("dragover");
            });

            $dropZone.on("dragleave dragend drop", function (e) {
                e.preventDefault();
                e.stopPropagation();
                $dropZone.removeClass("dragover");
            });

            $dropZone.on("drop", async function (e) {
                var dt = e.originalEvent.dataTransfer;
                if (!dt || !dt.items) return;

                var items = dt.items;
                var files = [];

                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item.webkitGetAsEntry) {
                        var entry = item.webkitGetAsEntry();
                        if (entry) {
                            var entryFiles = await scanFilesRecursive(entry, "");
                            files = files.concat(entryFiles);
                        }
                    } else if (item.kind === 'file') {
                        var file = item.getAsFile();
                        if (file) {
                            file.relativePath = file.name;
                            files.push(file);
                        }
                    }
                }

                if (files.length > 0) {
                    processNewFiles(files);
                }
            });
        });

        async function scanFilesRecursive(entry, path) {
            var fileList = [];
            if (entry.isFile) {
                var file = await new Promise(resolve => entry.file(resolve));
                file.relativePath = path + file.name;
                fileList.push(file);
            } else if (entry.isDirectory) {
                var dirReader = entry.createReader();
                var entries = await readAllDirectoryEntries(dirReader);
                for (var i = 0; i < entries.length; i++) {
                    var childFiles = await scanFilesRecursive(entries[i], path + entry.name + "/");
                    fileList = fileList.concat(childFiles);
                }
            }
            return fileList;
        }

        function readAllDirectoryEntries(dirReader) {
            var entries = [];
            return new Promise(resolve => {
                function read() {
                    dirReader.readEntries(results => {
                        if (!results.length) {
                            resolve(entries);
                        } else {
                            entries = entries.concat(Array.from(results));
                            read();
                        }
                    });
                }
                read();
            });
        }

        function handleFolderSelect(files) {
            var list = [];
            for (var i = 0; i < files.length; i++) {
                var file = files[i];
                file.relativePath = file.webkitRelativePath || file.name;
                list.push(file);
            }
            processNewFiles(list);
        }

        function handleFileSelect(files) {
            var list = [];
            for (var i = 0; i < files.length; i++) {
                var file = files[i];
                file.relativePath = file.name;
                list.push(file);
            }
            processNewFiles(list);
        }

        function isImageFile(file) {
            var name = (file.name || "").toLowerCase();
            return name.endsWith(".bmp") || name.endsWith(".jpg") || name.endsWith(".jpeg") || name.endsWith(".png") || name.endsWith(".webp");
        }

        function processNewFiles(files) {
            var validImages = [];
            for (var i = 0; i < files.length; i++) {
                if (isImageFile(files[i])) {
                    validImages.push(files[i]);
                }
            }

            if (validImages.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'No Image Files Found', text: 'Please select folders containing BMP, JPG, PNG or WEBP images.' });
                } else {
                    alert('No supported image files found in selected folder(s).');
                }
                return;
            }

            selectedFileList = selectedFileList.concat(validImages);
            renderFileList();
        }

        function clearSelectedFiles() {
            selectedFileList = [];
            $("#folderInput").val('');
            $("#fileInput").val('');
            renderFileList();
        }

        function formatBytes(bytes) {
            if (bytes === 0) return '0 Bytes';
            var k = 1024;
            var sizes = ['Bytes', 'KB', 'MB', 'GB'];
            var i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function renderFileList() {
            var $tbody = $("#fileListBody");
            $tbody.empty();

            if (selectedFileList.length === 0) {
                $("#fileTableContainer").hide();
                $("#statsRow").hide();
                $("#compressBtn").prop("disabled", true);
                $("#clearBtn").hide();
                return;
            }

            $("#fileTableContainer").show();
            $("#statsRow").show();
            $("#compressBtn").prop("disabled", false);
            $("#clearBtn").show();

            var totalOriginalBytes = 0;
            var folderSet = new Set();
            var rowsHtml = "";

            $.each(selectedFileList, function (idx, file) {
                totalOriginalBytes += file.size;

                var relPath = file.relativePath || file.name;
                var folderName = relPath.contains ? (relPath.includes("/") ? relPath.substring(0, relPath.lastIndexOf("/")) : "/") : (relPath.indexOf("/") >= 0 ? relPath.substring(0, relPath.lastIndexOf("/")) : "/");
                folderSet.add(folderName);

                rowsHtml += '<tr id="fileRow_' + idx + '">' +
                    '<td class="text-center font-monospace">' + (idx + 1) + '</td>' +
                    '<td class="text-break"><strong>' + escapeHtml(relPath) + '</strong></td>' +
                    '<td class="text-end">' + formatBytes(file.size) + '</td>' +
                    '<td class="text-center" id="fileStatus_' + idx + '"><span class="badge bg-secondary">Ready</span></td>' +
                    '</tr>';
            });

            $tbody.html(rowsHtml);

            $("#lblTotalFiles").text(selectedFileList.length);
            $("#lblTotalFolders").text(folderSet.size);
            $("#lblOriginalSize").text(formatBytes(totalOriginalBytes));
            $("#lblCompressedSize").text("--");
        }

        function escapeHtml(text) {
            return $('<div>').text(text).html();
        }

        function loadImage(file) {
            return new Promise((resolve, reject) => {
                var img = new Image();
                var url = URL.createObjectURL(file);
                img.src = url;
                img.onload = function () {
                    URL.revokeObjectURL(url);
                    resolve(img);
                };
                img.onerror = function (err) {
                    URL.revokeObjectURL(url);
                    reject(err);
                };
            });
        }

        async function compressAndZip() {
            if (selectedFileList.length === 0) return;

            var scaleFactor = parseFloat($("#scaleFactorSelect").val() || "0.5");
            var quality = parseFloat($("#qualitySelect").val() || "0.8");
            var targetMime = $("#formatSelect").val() || "image/jpeg";

            var extMap = {
                "image/jpeg": ".jpg",
                "image/webp": ".webp",
                "image/png": ".png"
            };
            var newExt = extMap[targetMime] || ".jpg";

            $("#compressBtn").prop("disabled", true);
            $("#clearBtn").hide();
            $("#progressContainer").show();
            $("#progressBar").css("width", "0%");
            $("#progressPercentText").text("0%");

            var zip = typeof JSZip !== 'undefined' ? new JSZip() : new window.JSZip();
            var totalFiles = selectedFileList.length;
            var totalCompressedBytes = 0;

            for (var i = 0; i < totalFiles; i++) {
                var file = selectedFileList[i];
                var pct = Math.round(((i + 1) / totalFiles) * 100);

                $("#fileStatus_" + i).html('<span class="badge bg-primary"><i class="fa fa-spinner fa-spin"></i> Compressing</span>');
                $("#progressStatusText").text("Compressing (" + (i + 1) + "/" + totalFiles + "): " + (file.relativePath || file.name));
                $("#progressBar").css("width", pct + "%");
                $("#progressPercentText").text(pct + "%");

                try {
                    var img = await loadImage(file);
                    var canvas = document.createElement("canvas");
                    var targetWidth = Math.max(1, Math.round(img.width * scaleFactor));
                    var targetHeight = Math.max(1, Math.round(img.height * scaleFactor));

                    canvas.width = targetWidth;
                    canvas.height = targetHeight;

                    var ctx = canvas.getContext("2d");
                    if (targetMime === "image/jpeg") {
                        ctx.fillStyle = "#FFFFFF";
                        ctx.fillRect(0, 0, canvas.width, canvas.height);
                    }
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                    var blob = await new Promise(resolve => canvas.toBlob(resolve, targetMime, quality));
                    totalCompressedBytes += blob.size;

                    // Compute path with subfolder structure preserved
                    var originalPath = file.relativePath || file.name;
                    var zipPath = originalPath.replace(/\.[^/.]+$/, newExt);

                    zip.file(zipPath, blob);

                    $("#fileStatus_" + i).html('<span class="badge bg-success">Done (' + formatBytes(blob.size) + ')</span>');
                } catch (err) {
                    console.error("Compression error on file:", file.name, err);
                    $("#fileStatus_" + i).html('<span class="badge bg-danger">Failed</span>');
                }

                // Yield main thread briefly for UI render
                await new Promise(r => setTimeout(r, 5));
            }

            $("#progressStatusText").text("Building ZIP Archive with Subfolders...");

            zip.generateAsync({ type: "blob" }, function updateCallback(metadata) {
                var zipPct = Math.round(metadata.percent);
                $("#progressPercentText").text(zipPct + "%");
            }).then(function (zipContent) {
                var zipFileName = "Compressed_Images_" + new Date().toISOString().slice(0, 10) + ".zip";
                
                if (typeof saveAs !== 'undefined') {
                    saveAs(zipContent, zipFileName);
                } else {
                    var link = document.createElement('a');
                    link.href = URL.createObjectURL(zipContent);
                    link.download = zipFileName;
                    link.click();
                    URL.revokeObjectURL(link.href);
                }

                $("#progressContainer").hide();
                $("#compressBtn").prop("disabled", false);
                $("#clearBtn").show();
                $("#lblCompressedSize").text(formatBytes(totalCompressedBytes));

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Compression Completed!',
                        html: '<b>' + totalFiles + '</b> images compressed into <b>' + zipFileName + '</b>.<br>Subfolder hierarchy fully preserved!',
                        confirmButtonColor: '#3085d6'
                    });
                } else {
                    alert('Compression completed! Download started.');
                }
            }).catch(function (err) {
                console.error("ZIP Generation error:", err);
                $("#progressContainer").hide();
                $("#compressBtn").prop("disabled", false);
                $("#clearBtn").show();
                alert('Error creating ZIP archive: ' + err.message);
            });
        }
    </script>
}