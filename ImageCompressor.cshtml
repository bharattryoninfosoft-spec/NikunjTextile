        function checkIFSC(code) {
            console.log(code);
            if (code.length == 11) {

                var ifscurl = "https://ifsc.razorpay.com/" + code;

                $.ajax({
                    type: "GET",
                    url: ifscurl,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.length != 0) {
                            $("#bank-name").val(response.BANK.replace(/"|'/g, ''));
                            $(".ifsc-invalid-feedback").html("Opps! Invalid IFSC Code.");
