<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


<style>

   .content-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 80vh;
    }

    .upload-card {
        width: 500px;
        background: #fff;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .upload-title {
        text-align: center;
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 30px;
        color: #333;
    }

    .form-label {
        font-weight: 600;
        color: #555;
    }

    .form-control {
        height: 42px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    .move-btn {
        width: 100%;
        margin-top: 20px;
        background: #4e73df;
        border: none;
        padding: 10px;
        color: #fff;
        font-weight: 600;
        border-radius: 6px;
        transition: 0.3s;
    }

        .move-btn:hover {
            background: #224abe;
        }

    .path-icon {
        position: absolute;
        left: 10px;
        top: 10px;
        color: #777;
    }

    .input-group {
        position: relative;
    }

        .input-group input {
            padding-left: 35px;
        }
        #loaderOverlay{
    position: fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background: rgba(0,0,0,0.4);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:9999;
}

.loader{
    border:6px solid #f3f3f3;
    border-top:6px solid #4e73df;
    border-radius:50%;
    width:50px;
    height:50px;
    animation: spin 1s linear infinite;
}

@@keyframes spin{
    0%{ transform:rotate(0deg); }
    100%{ transform:rotate(360deg); }
}
</style>

<div class="content-wrapper">

    <div class="upload-card">

        <div class="upload-title">
            <i class="fa fa-image"></i> Compress BMP Images
        </div>

        <label class="form-label">Source Path</label>

        <div class="input-group">
            <i class="fa fa-folder path-icon"></i>
            <input type="text" id="sourcePath" class="form-control" placeholder="Enter Folder Path">

        </div>
        <button id="moveBtn" class="move-btn" onclick="MoveImages()">
            <span id="btnText">
                <i class="fa fa-upload"></i> Compress Images
            </span>

            <span id="btnLoader" style="display:none;">
                <i class="fa fa-spinner fa-spin"></i> Processing...
            </span>
        </button>

    </div>

</div>

