    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                console.log("Company", response)
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#Updatebtn").hide();
        $("#addNewContactLabel").html("Add Design Entry Form");
        $("#add-alert").hide();

        $("#YarnColor").val('');

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }
    function validate(code) {
        //alert(code);
        //alert(code.id + "  " + code.value);
        //console.log(code.id + " Hello" + code.value);

        //code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";
        $(".invalid-feedback .valid-feedback").hide();

        //alert(code.value);

        if (code.value == "0") {

            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else
            if (code.value == "") {

                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
    }
</script>
<script>
    let dropArea = document.getElementById("dropArea");
    let fileInput = document.getElementById("fileInput");
    let fileList = document.getElementById("fileList");
    let selectedFiles = [];

    dropArea.onclick = () => fileInput.click();

    fileInput.addEventListener("change", function (e) {

        selectedFiles = e.target.files;
        fileList.innerHTML = "";

        for (let file of selectedFiles) {
            previewUpload(file);
        }

    });

    dropArea.addEventListener("dragover", e => e.preventDefault());

    dropArea.addEventListener("drop", e => {

        e.preventDefault();

        selectedFiles = e.dataTransfer.files;

        fileList.innerHTML = "";

        for (let file of selectedFiles) {
            previewUpload(file);
        }

    });

    function previewUpload(file) {

        let reader = new FileReader();

        reader.onload = function (e) {

            let div = document.createElement("div");
            div.className = "file-item";

            div.innerHTML = `
        <img src="${e.target.result}" class="preview">

        <div style="flex:1">
            <div>${file.name}</div>

            <div class="progress">
                <div class="progress-bar"></div>
            </div>
        </div>

        <div class="percent">0%</div>
        `;

            fileList.appendChild(div);

        };

        reader.readAsDataURL(file);
    }


    $("#uploadBtn").click(function () {

        var files = $("#fileInput")[0].files;

        if (files.length == 0) {
            alert("Please select images");
            return;
        }

        var formData = new FormData();

        fileList.innerHTML = "";

        for (var i = 0; i < files.length; i++) {

            previewUpload(files[i]);   // ✅ correct
            formData.append("file" + i, files[i]);

        }

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/UploadCompressImages",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,

            xhr: function () {

                var xhr = new window.XMLHttpRequest();

                xhr.upload.addEventListener("progress", function (evt) {

                    if (evt.lengthComputable) {

                        var percent = Math.round((evt.loaded / evt.total) * 100);

                        $(".progress-bar").css("width", percent + "%");
                        $(".percent").text(percent + "%");

                    }

                }, false);

                return xhr;
            },

            success: function (res) {

                $(".progress-bar").css("width", "100%");
                $(".percent").text("100%");
                alert("Images Compressed Successfully");

            },

            error: function (err) {
                console.log(err);
            }

        });

    });

</script>
