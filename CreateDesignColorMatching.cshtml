        //Warp Matching
        function WarpMatchingChange(abc) {
            const warpLength = +$("#warpLength").val();
            const [rowNo, DDlNo] = abc.split('_');
            const Mat = `#MatchingWarp${rowNo}_${DDlNo}`;
            const TableData = `#tdMatchingWarp${rowNo}_${DDlNo}`;
            //alert(TableData);
            const getSelectedText = id => $.trim($(id + " option:selected").text());
            const cleanValue = val => val.replace(/\/+$/, ""); // remove trailing "/"
            const getChkArray = () =>
                Array.from({ length: warpLength - 1 }, (_, i) => i + 2)
                    .filter(no => $(`#chkwarp${no}`).prop('checked'))
                    .join("|");

            // ✅ Update Table Background
            const val = $(Mat).val();
            if (!val) {
                $(TableData).css("background-color", "");
            } else {
                const color = ArrayYarnColor[0].find(c => c.YarnColorID == val)?.YarnColorCode;
                if (color) $(TableData).css("background-color", `#${color}`);
                //alert(color);
            }

            // ✅ Build Matching String
            const buildMatching = (Did) => {
                if (!$(Mat).val()) return "";
                const chkArray = getChkArray().split('|').filter(Boolean);
                let ids = getSelectedText(`#MatchingWarp${Did}_1`) + "/";
                chkArray.forEach(no => {
                    ids += getSelectedText(`#MatchingWarp${Did}_${no}`) + "/";
                });
                return cleanValue(ids);
            };


            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            const ColorMatchingArray = txtColorData.map((_, i) => {
                const Did = i + 1;
                const matchVal = buildMatching(Did);
                $(`#matching${Did}ID`).html(matchVal);
                return { [`Matching ${Did}`]: matchVal };
            });

            //console.log(ColorMatchingArray);

            //CheckWarpDuplicates(ColorMatchingArray);
            mergerAllMatchingID();
        }
        function onchangeCHKWarp() {

            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            const warpLength = +$("#warpLength").val();
            const ColorMatchingArray = [];

            const cleanValue = (val) => val.replace(/\/+$/, ""); // Remove trailing "/"
            const getSelectedText = (id) => $.trim($(id + " option:selected").text());

            txtColorData.forEach((_, d) => {
                const Did = d + 1;
                const matchingID = "#matching" + Did + "ID";
                const MatchingIDs = "Matching " + Did;

                let chkArray = [];
                for (let wa = 1; wa <= warpLength; wa++) {
                    const Mat = "#MatchingWarp" + Did + "_" + wa;
                    if (!$(Mat).val()) {
                        validate(document.getElementById("MatchingWarp" + Did + "_" + wa));
                    } else if ($("#chkwarp" + wa).prop("checked")) {
                        chkArray.push(wa);
                    }
                }

                // Build MatchingWarpID
                let MatchingWarpID = getSelectedText("#MatchingWarp" + Did + "_1") + "/";
                chkArray.forEach((wa, i) => {
                    if (!(i === 0 && wa === 1)) {
                        MatchingWarpID += getSelectedText("#MatchingWarp" + Did + "_" + wa) + "/";
                    }
                });

                MatchingWarpID = cleanValue(MatchingWarpID);
                $(matchingID).html(MatchingWarpID);

                let obj = {};
                obj[MatchingIDs] = MatchingWarpID;
                ColorMatchingArray.push(obj);
            });
            //console.log(ColorMatchingArray);


            //CheckWarpDuplicates(ColorMatchingArray);
            mergerAllMatchingID();
        }
