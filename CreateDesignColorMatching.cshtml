                                <input type="hidden" id="txtDesignColorMatchingFormID" class="form-control" />

                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <div class="form-section-header" style=" margin: 0; padding: 0.3rem 0.9rem; background: #689de7;">Design No</div>
                                    </div>
                                    <div class="col-6">
                                        <select class="form-control" style="min-height: 35px;" id="DesignNo" onchange="getDesignNo(this)">
                                            <option value="">Select Design No</option>
                                        </select>
                                    </div>
                                </div>


                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <span>Pick On Loom</span>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="PickOnLoom" name="PickOnLoom" class="form-control" title="Pick On Loom" placeholder="Pick On Loom" style="min-height: 35px;" readonly />
                                    </div>
                                </div>


                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <span>Total Card</span>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="TotalCard" name="TotalCard" class="form-control" title="Total Card" placeholder="Total Card" style="min-height: 35px;" readonly />
                                    </div>
                                </div>

                                <div class="row gutters">
                                    <div class="col-6" style=" text-align: center;">
                                        <span>Design Category</span>
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="DesignCategory" name="DesignCategory" class="form-control" title="Design No" placeholder="Design No" style="min-height: 35px;" readonly />
                                    </div>
                                </div>




                            </div>

                            <!-- Field wrapper end -->

