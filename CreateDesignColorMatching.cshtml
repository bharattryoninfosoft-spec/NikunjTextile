    //Warp Matching
    function WarpMatchingChange(abc) {
        const warpLength = +$("#warpLength").val();
        const [rowNo, DDlNo] = abc.split('_');
        const Mat = `#MatchingWarp${rowNo}${DDlNo}`;
        const TableData = `#tdMatchingWarp${rowNo}${DDlNo}`;
        //alert(TableData);
        const getSelectedText = id => $.trim($(id + " option:selected").text());
        const cleanValue = val => val.replace(/\/+$/, ""); // remove trailing "/"
        const getChkArray = () =>
            Array.from({ length: warpLength - 1 }, (_, i) => i + 2)
                .filter(no => $(`#chkwarp${no}`).prop('checked'))
                .join("|");

        // ✅ Update Table Background
        const val = $(Mat).val();
        if (!val) {
            $(TableData).css("background-color", "");
        } else {
            const color = ArrayYarnColor[0].find(c => c.YarnColorID == val)?.YarnColorCode;
            if (color) $(TableData).css("background-color", `#${color}`);
            //alert(color);
        }

        // ✅ Build Matching String
        const buildMatching = (Did) => {
            if (!$(Mat).val()) return "";
            const chkArray = getChkArray().split('|').filter(Boolean);
            let ids = getSelectedText(`#MatchingWarp${Did}1`) + "/";
            chkArray.forEach(no => {
                ids += getSelectedText(`#MatchingWarp${Did}${no}`) + "/";
            });
            return cleanValue(ids);
        };


        const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
        const ColorMatchingArray = txtColorData.map((_, i) => {
            const Did = i + 1;
            const matchVal = buildMatching(Did);
            $(`#matching${Did}ID`).html(matchVal);
            return { [`Matching ${Did}`]: matchVal };
        });

        //console.log(ColorMatchingArray);

        //CheckWarpDuplicates(ColorMatchingArray);
        mergerAllMatchingID();
    }

    function onchangeCHKWarp() {

        const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
        const warpLength = +$("#warpLength").val();
        const ColorMatchingArray = [];

        const cleanValue = (val) => val.replace(/\/+$/, ""); // Remove trailing "/"
        const getSelectedText = (id) => $.trim($(id + " option:selected").text());

        txtColorData.forEach((_, d) => {
            const Did = d + 1;
            const matchingID = "#matching" + Did + "ID";
            const MatchingIDs = "Matching " + Did;

            let chkArray = [];
            for (let wa = 1; wa <= warpLength; wa++) {
                const Mat = "#MatchingWarp" + Did + wa;
                if (!$(Mat).val()) {
                    validate(document.getElementById("MatchingWarp" + Did + wa));
                } else if ($("#chkwarp" + wa).prop("checked")) {
                    chkArray.push(wa);
                }
            }

            // Build MatchingWarpID
            let MatchingWarpID = getSelectedText("#MatchingWarp" + Did + "1") + "/";
            chkArray.forEach((wa, i) => {
                if (!(i === 0 && wa === 1)) {
                    MatchingWarpID += getSelectedText("#MatchingWarp" + Did + wa) + "/";
                }
            });

            MatchingWarpID = cleanValue(MatchingWarpID);
            $(matchingID).html(MatchingWarpID);

            let obj = {};
            obj[MatchingIDs] = MatchingWarpID;
            ColorMatchingArray.push(obj);
        });
        //console.log(ColorMatchingArray);


        //CheckWarpDuplicates(ColorMatchingArray);
        mergerAllMatchingID();
    }





    function CheckWarpDuplicates(ColorMatchingArray) {
        // ✅ Check Duplicates

        $("#spanWarpDuplicate").html('');

        var arr = ColorMatchingArray;
        console.log(arr);
        var seen = {};
        $.each(arr, function (i, obj) {
            var value = Object.values(obj)[0];   // Get the string (e.g., "BLACK/FIROZI")
            var key = Object.keys(obj)[0];       // Get the key (e.g., "Matching 1")

            if (seen[value]) {
                console.log("Duplicate Found:", seen[value], "and", key);
                $("#spanWarpDuplicate").append(
                    `<div>Duplicate Found: ${seen[value]} and ${key}</div>`
                );
                return;
            } else {
                seen[value] = key;
            }
        });



    }







    //Weft Feeder Matching
    function WeftMatchingChange(abc) {
        const [rowNo, DDlNo] = abc.split('_');
        const weftLength = +$("#weftLength").val();
        const Mat = `#MatchingWeft${rowNo}${DDlNo}`;
        const TableData = `#tdMatchingWeft${rowNo}${DDlNo}`;

        // ✅ Set Background Color
        const selectedVal = $(Mat).val();
        if (!selectedVal) {
            $(TableData).css("background-color", "");
        } else {
            const match = ArrayYarnColor[0].find(c => c.YarnColorID == selectedVal);
            if (match) $(TableData).css("background-color", `#${match.YarnColorCode}`);
        }

        // ✅ Get Missing & Checked Checkboxes
        let missing = [], checked = [];
        for (let i = 1; i <= weftLength; i++) {
            const chk = $(`#chkweft${i}`);
            if (!chk.length) missing.push(i);
            else if (chk.prop('checked')) checked.push(i);
        }

        // ✅ Build Marching DDL Values
        const getDDLText = i => $.trim($(`#MatchingWeft${rowNo}${i} option:selected`).text());
        const allSelected = [...missing, ...checked].map(getDDLText).filter(Boolean).join('/');
        $(`#matchingWeft${rowNo}ID`).html(allSelected);

        // ✅ Build Color Matching Array
        const ColorMatchingArray = $("#txtColorArray").val().slice(0, -1).split('|').map(id => {
            return { [`Matching ${id}`]: $(`#matchingWeft${id}ID`).html() };
        });

        //console.log(ColorMatchingArray);
        //CheckWeftDuplicates(ColorMatchingArray);
        mergerAllMatchingID();
    }

    function onchangeCHKWeft() {
        const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
        const weftLength = +$("#weftLength").val();
        const ColorMatchingArray = [];

        // ✅ Get Missing & Checked Checkboxes
        let missing = [], checked = [];
        for (let i = 1; i <= weftLength; i++) {
            const chk = $(`#chkweft${i}`);
            if (!chk.length) missing.push(i);
            else if (chk.prop('checked')) checked.push(i);
        }

        const getDDLText = (row, i) =>
            $.trim($(`#MatchingWeft${row}${i} option:selected`).text());





        // ✅ Loop Through Rows
        txtColorData.forEach((_, idx) => {

            const Did = 0 + 1;
            //const matchingID = "#matchingWeft" + Did + "ID";
            //const MatchingIDs = "matchingWeft " + Did;

            let chkArray = [];
            for (let wa = 1; wa <= weftLength; wa++) {
                const Mat = "#MatchingWeft" + Did + wa;
                if (!$(Mat).val()) {
                    validate(document.getElementById("MatchingWeft" + Did + wa));
                } else if ($("#chkwarp" + wa).prop("checked")) {
                    chkArray.push(wa);
                }
            }





            const rowNo = idx + 1;
            const ddlValues = [...missing, ...checked]
                .map(i => getDDLText(rowNo, i))
                .filter(Boolean)
                .join('/');

            $(`#matchingWeft${rowNo}ID`).html(ddlValues);

            ColorMatchingArray.push({ [`Matching ${rowNo}`]: ddlValues });
        });
















        //CheckWeftDuplicates(ColorMatchingArray);
        mergerAllMatchingID();
    }

