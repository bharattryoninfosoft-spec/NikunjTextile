    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }

    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }

    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }



    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#Updatebtn").hide();
        $("#addNewContactLabel").html("Add Design Entry Form");
        $("#add-alert").hide();

        $("#YarnColor").val('');

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }

    function validate(code) {
        //alert(code);
        //alert(code.id + "  " + code.value);
        //console.log(code.id + " Hello");

        code.value = code.value.replace(/\s+/g, ' ').trim();
        var errorMessageValid = "." + code.id + "-valid-feedback";
        var errorMessageInvalid = "." + code.id + "-invalid-feedback";
        $(".invalid-feedback .valid-feedback").hide();

        if (code.value == "0") {

            document.getElementById(code.id).classList.remove("is-valid");
            document.getElementById(code.id).classList.add("is-invalid");
            $(errorMessageInvalid).show();
            return false;
        }
        else
            if (code.value == "") {

                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
    }




    function getDesignEntryForm() {

        var formData = new FormData();
        //formData.append('SaleInvoiceID', SaleInvoiceID);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getDesignNoForm',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                //console.log(response);
                //alert(response.Code);

                if (response.Code == "200") {

                    var DesignColorMatchingFormIDs = "";
                    var designNo = "";
                    //Design No
                    if (response.listDesignEntryForm.length > 0) {
                        var tempDesignNo = "";
                        tempDesignNo = "<option value=''> Select Designer No </option>";
                        $('#DesignerID').append(tempDesignNo);
                        for (var i = 0; i < response.listDesignEntryForm.length; i++) {
                            DesignColorMatchingFormIDs = response.listDesignEntryForm[i].DesignColorMatchingFormIDs;

                            if (DesignColorMatchingFormIDs != "0") {
                                if (DesignColorMatchingFormIDs == response.listDesignEntryForm[i].DesignColorMatchingFormID) {
                                    designNo = response.listDesignEntryForm[i].DesignEntryFormID + "|" + response.listDesignEntryForm[i].DesignColorMatchingFormID;
                                    tempDesignNo = "<option value='" + response.listDesignEntryForm[i].DesignEntryFormID + "|" + response.listDesignEntryForm[i].DesignColorMatchingFormID + "' selected> " + response.listDesignEntryForm[i].DesignerCode + response.listDesignEntryForm[i].DesignNo + " </option>";
                                    $('#DesignNo').append(tempDesignNo);
                                    //alert(tempDesignNo);
                                }

                            }

                            tempDesignNo = "<option value='" + response.listDesignEntryForm[i].DesignEntryFormID + "|" + response.listDesignEntryForm[i].DesignColorMatchingFormID + "'> " + response.listDesignEntryForm[i].DesignerCode + response.listDesignEntryForm[i].DesignNo + " </option>";
                            $('#DesignNo').append(tempDesignNo);

                        }
                    }

                    //if (DesignColorMatchingFormIDs != "0") {
                    //    getCookieDesignNo(designNo)
                    //}
                }

            },
            error: function (request, status, error) {

                //window.location.href = 'SaleInvoice';

            }
        });

    }



    var ArrayYarnColor = [];

    function getYarnColor() {

        var formData = new FormData();
        //formData.append('SaleInvoiceID', SaleInvoiceID);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getYarnColorMatching',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                //console.log(response);
                //alert(response.Code);
                ArrayYarnColor.push(response.listYarnColorMaster);

                if (response.Code == "200") {

