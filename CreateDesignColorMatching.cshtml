        function checkSave() {
            const txtColorData = $("#txtColorArray").val().slice(0, -1).split('|');
            const ColorArray = $("#txtColorArray").val();
            const warpLength = parseInt($("#warpLength").val());
            const weftLength = parseInt($("#weftLength").val());
            const DesignNo = $("#DesignNo").val();

            let WarpCheckBox = "", WeftCheckBox = "";
            let ColorMatchingArray = [];
            let hasValidationError = false;

            const lastColorNo = parseInt(txtColorData[txtColorData.length - 1]);

            // Validate fields and build checkbox values
            for (let i = 0; i < warpLength; i++) {
                const Sno = i + 1;
                const el = document.getElementById("MatchingWarp" + lastColorNo + "_" + Sno);
                if (!validate(el)) hasValidationError = true;

                WarpCheckBox += $("#chkwarp" + Sno).is(':checked') ? "1|" : "0|";
            }

            for (let i = 0; i < weftLength; i++) {
                const Sno = i + 1;
                const el = document.getElementById("MatchingWeft" + lastColorNo + "_" + Sno);
                if (!validate(el)) hasValidationError = true;

                WeftCheckBox += $("#chkweft" + Sno).is(':checked') ? "1|" : "0|";
            }

            if (hasValidationError) {
                notes.show('Please fill all fields', { type: 'danger' });
                return;
            }

            let seen = {}, isDuplicate = false;
            $("#spanDuplicate").html('');

            txtColorData.forEach((colorNo, index) => {
                const id = "#matching" + colorNo + "ID";
                const weftId = "#matchingWeft" + colorNo + "ID";
                const value = $(id).html() + "/" + $(weftId).html();
                const key = "Matching " + (index + 1);

                let obj = {};
                obj[key] = value;
                ColorMatchingArray.push(obj);

                if (seen[value]) {
                    isDuplicate = true;
                    $("#spanDuplicate").append(`<div>Duplicate Found: ${seen[value]} and ${key}</div>`);
                } else {
                    seen[value] = key;
                }
            });

            if (isDuplicate) return;

            // Build final data
            let WarpFeederArray = txtColorData.map(MatchingNo => {
                let obj = {
                    MatchingNo,
                    WarpMatchingID: $("#matching" + MatchingNo + "ID").html(),
                    FeederMatchingID: $("#matchingWeft" + MatchingNo + "ID").html()
                };

                for (let i = 0; i < warpLength; i++) {
                    obj["Warp" + (i + 1)] = $("#MatchingWarp" + MatchingNo + "_" + (i + 1)).val();
                }

                for (let i = 0; i < weftLength; i++) {
                    obj["Feeder" + (i + 1)] = $("#MatchingWeft" + MatchingNo + "_" + (i + 1)).val();
                }

                return obj;
            });

            const DesignColorMatchingArray = JSON.stringify({
                DesignEntryFormID: DesignNo.split("|")[0],
                TotalWarp: warpLength,
                TotalWeft: weftLength,
                ColorArray: ColorArray,
                WarpCheckBox: WarpCheckBox.slice(0, -1),
                WeftCheckBox: WeftCheckBox.slice(0, -1),
                listDesignColorMatchingDetails: WarpFeederArray
            });

            const formData = new FormData();
            formData.append('ColorFormArray', DesignColorMatchingArray);

            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/insertDesignColorMatchingFormMaster",
                data: formData,
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200) {

                        Swal.fire({
                            icon: "success",
                            title: "Success",
                            text: "Color Matching Created Successfully.",
                            confirmButtonText: "OK"
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = "ColorMatching";
                            }
                        });

                    } else {

                        Swal.fire({
                            icon: "error",
                            title: "Oops...",
                            text: response.Message
                        });

                    }
                },
                error: function () {

                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Problem occurred while submitting your data."
                    });

                }
            });
        }
