    function getStates(StateCode) {


        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getStates',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                var jsonData = JSON.parse(data.d);
                $("#state option[value]").each(function () {
                    $(this).remove();
                });
                $("#state-default option[value]").each(function () {
                    $(this).remove();
                });

                $('#state').append("<option value='-1'> -- Select -- </option>");
                $('#state-default').append("<option value='-1'> -- Select -- </option>");
                for (var i = 0; i < jsonData.length; i++) {
                    admin = jsonData[i];

                    if (admin.GSTStateCode == StateCode) {
                        appendTemp = "<option value=" + admin.GSTStateCode + " selected>" + admin.GSTStateCode + "-" + admin.StateTitle + "</option >";
                    }
                    else {
                        //appendTemp = "<option value=" + admin.GSTStateCode + "-" + admin.StateTitle + ">" + admin.GSTStateCode + "-" + admin.StateTitle + "</option >";
                        appendTemp = "<option value=" + admin.GSTStateCode + ">" + admin.GSTStateCode + "-" + admin.StateTitle + "</option >";
                    }

                    $('#state').append(appendTemp);
                    $('#state-default').append(appendTemp);
                }
            },
            error: function (request, status, error) {
            }
        });
    }
