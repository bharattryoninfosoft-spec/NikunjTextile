    function CardPickCalculation() {

        var txtTotalCard = $("#TotalCard").val();
        var txtAveragePic = $("#AveragePic").val();

        var txtWeftData = $("#txtWeftData").val().slice(0, -1).split('|');

        var TotalCard = 0;
        var TotalPic = 0;

        for (var i = 0; i < txtWeftData.length; i++) {
            var no = parseFloat(i) + parseFloat(1);

            var WCard = "#Card" + no;
            var WPick = "#Pick" + no;

            var VCard = $(WCard).val();
            var VPick = $(WPick).val();

            console.log("VCard " + VCard);
            console.log("VPick " + VPick);

            TotalCard = (parseFloat(TotalCard) + parseFloat(VCard)).toFixed(2);
            TotalPic = (parseFloat(TotalPic) + parseFloat(VPick)).toFixed(2);
        }



        if (parseFloat(txtTotalCard) == parseFloat(TotalCard)) {
            $("#spanTotalCard").html("Match Total Card.*");
            $("#spanTotalCard").css("color", "green");
        }
        else {
            $("#spanTotalCard").html("Not Match Total Card.*");
            $("#spanTotalCard").css("color", "red");
        }



        if (parseFloat(txtAveragePic) == parseFloat(TotalPic)) {
            $("#spanTotalPic").html("Match Total Average Pic.*");
            $("#spanTotalPic").css("color", "green");
        }
        else {
            $("#spanTotalPic").html("Not Match Total Average Pic.*");
            $("#spanTotalPic").css("color", "red");
        }


        //spanTotal

    }



