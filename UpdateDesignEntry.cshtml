    function validateDecimal(el) {

        let value = el.value;

        // Remove invalid characters
        value = value.replace(/[^0-9.]/g, '');

        // Allow only one dot
        let parts = value.split('.');
        if (parts.length > 2) {
            value = parts[0] + '.' + parts[1];
        }

        // Limit to 2 decimal places
        if (parts[1]) {
            parts[1] = parts[1].substring(0, 2);
            value = parts[0] + '.' + parts[1];
        }

        el.value = value;
    }
    function saveImage(input) {
        var previewStr = "#" + input.id + "-preview";
        if (input.files && input.files[0]) {
            var fildr = new FileReader();
            fildr.onload = function (e) {
                var imgStr = "<img src='" + e.target.result + "' style='width:100%;margin-top:-54px;'>";
                $(previewStr).html(imgStr);
                $(previewStr).css('color', 'initial');
            }
            fildr.readAsDataURL(input.files[0]);

            if (input.id == "upload-PhotoOfDesign-default") {
                $("#txttempPhotoOfDesign").val("");
            }
            else
                if (input.id == "upload-PhotoOfSketch-default") {
                    $("#txttempPhotoOfSketch").val("");
                }

            return true;
        }
        else {
            var message = "";
            if (input.id == "upload-image" || input.id == "upload-image-default") {
                message = "Photo Of Sketch Is Needed.";
            }
            else {
                message = "Photo of Design Is Needed.";
            }
            $(previewStr).html(message);
            $(previewStr).css('color', 'red');
            return false;
        }
    }

