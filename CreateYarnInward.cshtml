        function checkCloseSave() {
            var PhotoOfInward = $('#upload-PhotoOfInward-default')[0].files[0];

            if ($('#upload-PhotoOfInward-default')[0].files.length == 0) {
                isUploadPhoto = 1;
                Swal.fire({ icon: 'warning', title: 'Warning', text: 'Please Upload Photo Of Inward' });
            }
            else {
                var InwardDate = document.getElementById('txtInwardDate');
                var ChallanNo = document.getElementById('txtChallanNo');
                var ChallanDate = document.getElementById('txtChallanDate');
                var PartyChallanNo = document.getElementById('txtPartyChallanNo');
                var YarnPOID = document.getElementById('ddlPONumber');
                var YarnMaterialID = document.getElementById('ddlYarnMaterial');
                var YarnColorID = document.getElementById('ddlYarnColor');
                var YarnPODetailIDCompanyCode = document.getElementById('ddlCompanyColourCode');
                var LotNo = document.getElementById('txtLotNo');
                var TotalWeight = document.getElementById('TotalWeight');
                var PendingWeight = document.getElementById('PendingWeight');
                var TotalPendingWeight = document.getElementById('TotalPendingWeight');
                var GodownID = document.getElementById('ddlGodown');

                const fieldsToValidate = [
                    { element: ChallanDate, name: "Challan Date" },
                    { element: PartyChallanNo, name: "Party Challan No" },
                    { element: InwardDate, name: "Inward Date" },
                    { element: ChallanNo, name: "Challan No" },
                    { element: YarnPOID, name: "Yarn PO Number" },
                    { element: YarnMaterialID, name: "Yarn Material" },
                    { element: YarnColorID, name: "Yarn Color" },
                    { element: YarnPODetailIDCompanyCode, name: "Company Colour Code" }
                ];

                let isFormValid = true;
                let errorFieldsNames = [];

                fieldsToValidate.forEach(fieldObj => {
                    if (validate(fieldObj.element) === false) {
                        isFormValid = false;
                        errorFieldsNames.push(fieldObj.name);
                    }
                });

                if (!isFormValid) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Validation Error',
                        html: "Please fill the following required fields correctly:<br>- " + errorFieldsNames.join("<br>- ")
                    });
                    return false;
                }

                var isSaveInward = 0;
                var IsComplete = 0;

                if (parseFloat(PendingWeight.innerHTML) == 0) {
                    isSaveInward = 1;
                    if (parseFloat(TotalPendingWeight.innerHTML) == 0) {
                        IsComplete = 1;
                    }
                    else if (parseFloat(TotalPendingWeight.innerHTML) > 0) {
                        IsComplete = 0;
                    }
                    else {
                        isSaveInward = 1;
                        IsComplete = 1;
                    }
                }
                else if (parseFloat(PendingWeight.innerHTML) < 0) {
                    if (parseFloat(TotalPendingWeight.innerHTML) == 0) {
                        IsComplete = 1;
                    }
                    else if (parseFloat(TotalPendingWeight.innerHTML) > 0) {
                        IsComplete = 0;
                    }
                    else {
                        isSaveInward = 1;
                        IsComplete = 1;
                    }
                }
                else {
                    isSaveInward = 0;
                    Swal.fire({ icon: 'error', title: 'Error', text: "Total Weight and Pending Weight are Not Match" });
                }

                if (isSaveInward == 1) {
                    var txtColorArray = $("#txtYarnDetailsArray").val();
                    var txtColorData = txtColorArray.slice(0, -1).split('|');

                    var appendTemp = '';
                    for (var j = 0; j < txtColorData.length; j++) {
                        var id = txtColorData[j];
                        if (!id) continue;
                        var tr = $("#trMatching" + id);
                        if (tr.length === 0) continue;

                        var BNVal = $("#BoxNo" + id).val() || "";
                        var BARVal = $("#BarcodeNo" + id).val() || "";
                        var rawNW = $("#NetWeight" + id).val();
                        var NWVal = parseFloat(rawNW);
                        var LCVal = $("#Location" + id).val() || "0";

                        if (!BNVal.trim() && (isNaN(NWVal) || NWVal === 0)) {
                            continue;
                        }

                        var finalNetWeight = isNaN(NWVal) ? "0.00" : NWVal.toFixed(2);

                        appendTemp += '{';
                        appendTemp += '"BoxNo": "' + BNVal + '",';
                        appendTemp += '"NetWeight": "' + finalNetWeight + '",';
                        appendTemp += '"BarcodeNo": "' + BARVal + '",';
                        appendTemp += '"GodownLocationID": "' + LCVal + '"';
                        appendTemp += '},';
                    }

                    var YarnInwardArray = '';
                    YarnInwardArray += '{';
                    YarnInwardArray += '"ChallanDates":"' + ChallanDate.value + '", ';
                    YarnInwardArray += '"PartyChallanNo":"' + PartyChallanNo.value + '",';
                    YarnInwardArray += '"YarnInwardDates":"' + InwardDate.value + '", ';
                    YarnInwardArray += '"ChallanNo":"' + ChallanNo.value + '",';
                    YarnInwardArray += '"YarnPOID":"' + YarnPOID.value + '",';
                    YarnInwardArray += '"YarnMaterialID":"' + YarnMaterialID.value + '",';
                    YarnInwardArray += '"YarnColorID":"' + YarnColorID.value + '",';
                    YarnInwardArray += '"YarnPODetailIDCompanyCode":"' + YarnPODetailIDCompanyCode.value + '",';
                    YarnInwardArray += '"LotNo":"' + LotNo.value + '",';
                    YarnInwardArray += '"TotalWeight":"' + TotalWeight.value + '",';
                    YarnInwardArray += '"POPendingWeight":"' + $("#TotalPendingWeight").html() + '",';
                    YarnInwardArray += '"PendingWeight":"' + $("#TotalPendingTotalWeight").val() + '",';
                    YarnInwardArray += '"GodownID":"' + GodownID.value + '",';
                    YarnInwardArray += '"IsComplete":"1",';
                    YarnInwardArray += '"listYarnInwardDetail": [' + (appendTemp ? appendTemp.slice(0, -1) : '') + ']';
                    YarnInwardArray += '}';

                    const formData = new FormData();
                    formData.append('YarnInwardArray', YarnInwardArray);
                    formData.append('PhotoOfInward', PhotoOfInward);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/insertYarnInwardMasterMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            let res = response.d || response;

                            if (res.Code == 200) {
                                Swal.fire({ icon: 'success', title: 'Success', text: 'Yarn Inward Created Successfully.' });
                                setTimeout(() => {
                                    window.location.href = 'YarnInward';
                                }, 1000);
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.Message });
                            }
                        },
                        error: function (xhr) {
                            Swal.fire({ icon: 'error', title: 'Error', text: "Problem occurred while submitting your data." });
                        }
                    });
                }
            }
        }

        $('#Savebtn').on('click', function () {
            let location = $('#Location1').val();

            if (!location || location === "0") {
                Swal.fire({
                    icon: 'error',
                    title: 'Please Select Location',
                    text: 'Location is required before saving!'
                });
                return;
            }

            let totalWeight = parseFloat($('#TotalTotalWeight').val() || $('#TotalTotalWeight').text()) || 0;

            let receiveWeight = 0;
            $('#tableItemData').find('[id^="NetWeight"]').each(function () {
                receiveWeight += parseFloat($(this).val()) || 0;
            });
            receiveWeight = parseFloat(receiveWeight.toFixed(2));
            let ReceivePOQty = parseFloat($('#ReceivePOQty').val()) || 0;
            let ChallanWeight = parseFloat(parseFloat($('#TotalWeight').val() || 0).toFixed(2));
            let TotalPendingWeight = parseFloat($('#TotalPendingWeight').text()) || 0;

            let pending = totalWeight - receiveWeight;

            $('#TotalPendingWeight').text(pending.toFixed(2));

            if (ChallanWeight.toFixed(2) !== receiveWeight.toFixed(2)) {
                Swal.fire({
                    icon: 'error',
                    title: 'Challan Pending Weight InComplete',
                    text: `Total: ${ChallanWeight.toFixed(2)} | Received: ${receiveWeight.toFixed(2)}`
                });
                return;
            }

            Swal.fire({
                title: 'Confirm Save',
                html: `
                        <b>Total Weight:</b> ${totalWeight} <br>
                        <b>Receive Weight:</b> ${(ReceivePOQty + receiveWeight).toFixed(2)}<br>
                        <b>Pending Weight:</b> ${TotalPendingWeight}
                    `,
                icon: 'info',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Save',
                denyButtonText: 'Save & Close',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    checkSave();
                }
                else if (result.isDenied) {
                    checkCloseSave();
                }
            });
        });
    </script>
