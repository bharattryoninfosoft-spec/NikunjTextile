@{
    Layout = "/_LayoutPage1.cshtml";
}
<style>
    .jobber-list-card {
        border: 0;
        border-radius: 2px;
        box-shadow: none;
    }

    .jobber-search {
        width: 370px;
        max-width: 100%;
        height: 40px;
        font-size: 13px;
    }

    .jobber-table {
        width: 100%;
        border-collapse: collapse;
    }

        .jobber-table thead th {
            background: #2f70bd !important;
            color: #ffffff !important;
            font-size: 13px;
            font-weight: 600;
            padding: 9px 10px;
            border: 1px solid #d5dce5;
            white-space: nowrap;
        }

        .jobber-table tbody td {
            padding: 9px 10px;
            font-size: 13px;
            vertical-align: middle;
            border: 1px solid #dce3eb;
        }

        .jobber-table tbody tr:nth-child(even) {
            background: #f3f6fa;
        }

        .jobber-table tbody tr:nth-child(odd) {
            background: #ffffff;
        }

        .jobber-table tbody tr:hover {
            background: #eef5fd;
        }

    .jobber-action-btn {
        border: 0;
        background: transparent;
        padding: 3px 5px;
        cursor: pointer;
        margin-right: 4px;
    }

    .btn-edit-jobber {
        color: #0d6efd;
    }

    .btn-view-jobber {
        color: #495057;
    }

    .btn-delete-jobber {
        color: #dc3545;
    }
</style>

<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="0" />

    <div class="card-header-lg clearfix mb-3">
        <button id="btnOpenPartyModal" style="float:right;" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="AddJobberModel()">
            <i class="fa fa-plus me-1"></i> Add Jobber
        </button>

        <!-- Jobber Modal -->
        <div class="modal fade" id="addNewContact" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="addNewContactLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl" role="document">
                <div class="modal-content" id="JobberModal">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addNewContactLabel">Add Jobber</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body" style="overflow-y: auto; max-height: calc(100vh - 200px);">
                        <div class="container-fluid" id="DivJobberMaster">
                            <div class="row gutters">
                                <!-- Left Column: Jobber Details -->
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="row gutters">
                                        <div class="col-12">
                                            <div class="form-section-header fw-bold mt-1">Jobber Details</div>
                                            <hr class="my-2" />
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <select id="ddlJobberType" class="form-select clear-field detail" onchange="toggleMachineSection()">
                                                    <option value="Weaving / Process">Weaving / Process</option>
                                                    <option value="Processing Only">Processing Only</option>
                                                </select>
                                                <div class="field-placeholder">Jobber Type</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtPrefix" placeholder="PREFIX" type="text" maxlength="8" class="form-control clear-field detail" style="text-transform: uppercase;" />
                                                <div class="field-placeholder">Prefix</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtGSTIN" type="text" class="form-control clear-field detail" placeholder="ex: 24XXXXX9438X1XX" minlength="15" maxlength="15" onkeyup="validate(this)" style="text-transform: uppercase;">
                                                <input id="gstintemp" type="hidden" class="clear-field detail">
                                                <div class="field-placeholder">GSTIN</div>
                                                <div class="invalid-feedback" id="GSTError">Please Provide Valid GSTIN Number</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtPANNo" type="text" class="form-control clear-field detail" placeholder="PAN No" minlength="10" maxlength="10" onkeyup="validate(this)" style="text-transform: uppercase;">
                                                <input id="PanNotemp" type="hidden" class="clear-field detail">
                                                <div class="field-placeholder">PAN No</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtPartyName" placeholder="Enter Party Name" type="text" class="form-control clear-field detail" onfocusout="validate(this)">
                                                <div class="field-placeholder">Party Name <span class="text-danger">*</span></div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtMobileNumber" placeholder="Enter Mobile" type="tel" class="form-control clear-field detail" minlength="10" maxlength="10" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)">
                                                <input id="phonetemp" type="hidden" class="clear-field detail">
                                                <div class="field-placeholder">Mobile Number <span class="text-danger">*</span></div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtAlternateNumber" placeholder="Enter Alternate Mobile" type="tel" class="form-control clear-field detail" minlength="10" maxlength="10" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)">
                                                <div class="field-placeholder">Alternate Number</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtEmail" placeholder="Enter Email" type="text" class="form-control clear-field detail" onfocusout="validateEmail(this.value, this)">
                                                <div class="field-placeholder">Email</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <select id="ddlPlaceOfSupply" class="form-select clear-field detail">
                                                    <option value="0">Select Place Of Supply</option>
                                                </select>
                                                <div class="field-placeholder">Place Of Supply</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtPincode" placeholder="Enter Pincode" type="tel" class="form-control clear-field detail" minlength="6" maxlength="6" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" onkeyup="myFunctionPINCODE(this)">
                                                <div class="field-placeholder">Pincode</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtCity" placeholder="Enter City" type="text" class="form-control clear-field detail">
                                                <div class="field-placeholder">City</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Bank & Address Details -->
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12 border-start">
                                    <div class="row gutters">
                                        <div class="col-12">
                                            <div class="form-section-header fw-bold mt-1">Bank Details</div>
                                            <hr class="my-2" />
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtBankHolderName" type="text" class="form-control clear-field detail" placeholder="Bank Holder Name">
                                                <div class="field-placeholder">Bank Holder Name</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtBankAcNo" type="text" class="form-control clear-field detail" placeholder="Bank Account No">
                                                <div class="field-placeholder">Bank A/c No</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtBankIFSC" placeholder="Enter IFSC" type="text" maxlength="11" class="form-control clear-field detail" onkeyup="myFunctionIFSC(this)" style="text-transform: uppercase;">
                                                <div class="field-placeholder">Bank IFSC</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtBankName" type="text" class="form-control clear-field detail" placeholder="Bank Name" readonly>
                                                <div class="field-placeholder">Bank Name</div>
                                            </div>
                                        </div>

                                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12 mb-3">
                                            <div class="field-wrapper">
                                                <input id="txtBankBranch" type="text" class="form-control clear-field detail" placeholder="Bank Branch" readonly>
                                                <div class="field-placeholder">Bank Branch</div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-section-header fw-bold mt-1">Address Details</div>
                                            <hr class="my-2" />
                                        </div>

                                        <div class="col-12 mb-3">
                                            <div class="field-wrapper">
                                                <textarea id="txtBillingAddress" class="form-control clear-field detail" rows="2" placeholder="Enter Billing Address"></textarea>
                                                <div class="field-placeholder">Billing Address</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- BOTTOM SECTION: MACHINE SUB-GRID -->
                                <div class="col-12 mt-3" id="machineSectionContainer">
                                    <div class="form-section-header fw-bold text-primary">Machine Details (Whole Numbers Only)</div>
                                    <hr class="my-2" />
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="machineTable">
                                            <thead class="table-light text-center">
                                                <tr>
                                                    <th>MACHINE TYPE</th>
                                                    <th>RPM</th>
                                                    <th>PANA REPEAT</th>
                                                    <th>PANA WIDTH</th>
                                                    <th>NO OF MACHINES</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><input id="txtMachineType" type="text" class="form-control" /></td>
                                                    <td><input id="txtRPM" type="number" step="1" class="form-control" value="0" /></td>
                                                    <td><input id="txtPanaRepeat" type="number" step="1" class="form-control" value="0" /></td>
                                                    <td><input id="txtPanaWidth" type="number" step="1" class="form-control" value="0" /></td>
                                                    <td><input id="txtNoOfMachines" type="number" step="1" class="form-control" value="0" /></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <input id="hfJobberID" type="hidden" value="0" />

                    <div class="modal-footer">
                        <button id="btnSave" type="button" class="btn btn-primary" onclick="checkSaveView()">Save</button>
                        <button id="btnSaveAndNew" type="button" class="btn btn-outline-primary" onclick="checkSave()">Save & New</button>
                        <button id="editbtn" type="button" class="btn btn-primary" onclick="checkEdit()" style="display:none;">Update</button>
                        <button id="cancelbtn" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Grid View -->
    <div class="row gutters mt-2">
        <div class="col-12">
            <div class="card jobber-list-card">
                <div class="card-body">
                    <div class="form-section-header mb-3">
                        Jobber Master List
                    </div>
                    <div class="d-flex justify-content-end mb-3">
                        <input id="search-jobber-name"
                               placeholder="Search Party Name / Mobile No / City..."
                               type="text"
                               class="form-control jobber-search"
                               onkeyup="functionSearch(this)">
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0 jobber-table" id="tblJobber">
                            <thead>
                                <tr>
                                    <th style="width:70px;">Sr No</th>
                                    <th>Jobber Type</th>
                                    <th>Party Name</th>
                                    <th>Mobile Number</th>
                                    <th>City</th>
                                    <th style="width:110px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="6" class="text-center">
                                        Loading...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var CurrentPage = 1;
        var PageSize = 10;
        var allJobberData = [];
        var filteredJobberData = [];

        $(document).ready(function () {
            getStates("0");
            displayData(0);
            toggleMachineSection();
        });

        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        function toggleMachineSection() {
            var val = $("#ddlJobberType").val();
            if (val && val.includes("Weaving")) {
                $("#machineSectionContainer").show();
            } else {
                $("#machineSectionContainer").hide();
            }
        }

        function AddJobberModel() {
            clearAll();
            $("#hfJobberID").val("0");
        }

        function clearAll() {
            $("#JobberModal input, #JobberModal textarea").prop("readonly", false);
            $("#JobberModal select").prop("disabled", false);
            $("#btnSave, #btnSaveAndNew").show();
            $("#editbtn").hide();
            $("#addNewContactLabel").html("Add Jobber Information");
            $(".clear-field,.form-control").val("");
            $("#ddlJobberType").val("Weaving / Process");
            $("#ddlPlaceOfSupply").val("0");
            $("#txtRPM, #txtPanaRepeat, #txtPanaWidth, #txtNoOfMachines").val(0);
            toggleMachineSection();
        }

        function getStates(GSTStateCode) {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getStates',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    var jsonData = JSON.parse(data.d);
                    var $select = $('#ddlPlaceOfSupply').empty().append("<option value='0'>Select Place Of Supply</option>");
                    $.each(jsonData, function (i, admin) {
                        var selected = (admin.GSTStateCode == GSTStateCode) ? "selected" : "";
                        $select.append(`<option value="${admin.GSTStateCode}" ${selected}>${admin.GSTStateCode} - ${admin.StateTitle}</option>`);
                    });
                }
            });
        }

        function myFunctionPINCODE(element) {
            var code = $(element).val().trim();
            if (code.length === 6) {
                $.ajax({
                    type: "GET",
                    url: "https://api.postalpincode.in/pincode/" + code,
                    success: function (response) {
                        if (response && response[0].Status === "Success") {
                            $("#txtCity").val(response[0].PostOffice[0].District);
                            $(element).addClass("is-valid").removeClass("is-invalid");
                        } else {
                            $(element).removeClass("is-valid").addClass("is-invalid");
                            $("#txtCity").val('');
                        }
                    }
                });
            }
        }

        function myFunctionIFSC(element) {
            var code = $(element).val().trim().toUpperCase();
            var $el = $(element);
            if (code.length === 11) {
                $.ajax({
                    type: "GET",
                    url: "https://ifsc.razorpay.com/" + code,
                    dataType: "json",
                    success: function (response) {
                        if (response && response.BANK) {
                            $("#txtBankName").val(response.BANK);
                            $("#txtBankBranch").val(response.BRANCH);
                            $el.addClass("is-valid").removeClass("is-invalid");
                        } else {
                            $el.removeClass("is-valid").addClass("is-invalid");
                            $("#txtBankName").val('');
                            $("#txtBankBranch").val('');
                        }
                    }
                });
            }
        }

        function validateEmail(emailValue, element) {
            var $el = $(element);
            var emailReg = /^[\w-\.]+@@([\w-]+\.)+[\w-]{2,4}$/;
            if (emailValue.trim() === "") {
                $el.removeClass("is-valid is-invalid");
                return;
            }
            if (!emailReg.test(emailValue)) {
                $el.removeClass("is-valid").addClass("is-invalid");
            } else {
                $el.addClass("is-valid").removeClass("is-invalid");
            }
        }

        function validate(code) {
            if (!code || !code.value) {
                if (code) { $(code).addClass("is-invalid").removeClass("is-valid"); }
                return false;
            }
            code.value = code.value.replace(/\s+/g, ' ').trim();
            var $el = $(code);

            if (code.id === "txtGSTIN") {
                if (code.value.length === 15) {
                    var gstVal = code.value.toUpperCase();
                    var pattern = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;
                    if (pattern.test(gstVal)) {
                        $el.addClass("is-valid").removeClass("is-invalid");
                        $('#txtPANNo').val(gstVal.substring(2, 12));
                        fetchGstDetails(gstVal);
                        return true;
                    } else {
                        $el.addClass("is-invalid").removeClass("is-valid");
                        return false;
                    }
                } else {
                    $el.removeClass("is-valid is-invalid");
                    return false;
                }
            }
            $el.addClass("is-valid").removeClass("is-invalid");
            return true;
        }

        function fetchGstDetails(gstin) {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/GetGstDetails',
                data: JSON.stringify({ gstin: gstin }),
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                success: function (response) {
                    var res = (typeof response.d === 'string') ? JSON.parse(response.d) : response.d;
                    if (res && res.success && res.data) {
                        var d = res.data;
                        $("#txtPartyName").val(d.trade_name || d.legal_name || '');
                        $("#txtBillingAddress").val(d.address || '');
                        $("#txtCity").val(d.city || '');
                        $("#txtPincode").val(d.pincode || '');
                        if (d.state_code) {
                            $("#ddlPlaceOfSupply").val(d.state_code);
                        }
                        Toast.fire({ icon: 'success', title: 'GST Details Auto-filled!' });
                    }
                }
            });
        }

        function displayData(rowStart) {
            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/GetJobberList",
                data: "{}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var jobberData = response.d || [];
                    if (typeof jobberData === "string") {
                        jobberData = JSON.parse(jobberData);
                    }
                    allJobberData = jobberData;
                    filteredJobberData = jobberData;
                    bindJobberGrid(rowStart);
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    $("#tblJobber tbody").html(`
                            <tr>
                                <td colspan="6" class="text-center text-danger">Failed to load Jobber data</td>
                            </tr>
                        `);
                    Toast.fire({ icon: "error", title: "Failed to load Jobber data!" });
                }
            });
        }

        function bindJobberGrid(rowStart) {
            var pageData = filteredJobberData.slice(rowStart, rowStart + PageSize);
            var html = "";

            if (pageData.length === 0) {
                html = `
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">No Jobber Data Found</td>
                        </tr>
                    `;
            } else {
                $.each(pageData, function (index, item) {
                    html += `
                            <tr>
                                <td>${rowStart + index + 1}</td>
                                <td>${item.JobberType || ""}</td>
                                <td>${item.PartyName || ""}</td>
                                <td>${item.MobileNumber || ""}</td>
                                <td>${item.City || ""}</td>
                                <td>
                                    <button type="button" class="jobber-action-btn btn-view-jobber" title="View" onclick="viewJobber(${item.Id})">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                    <button type="button" class="jobber-action-btn btn-edit-jobber" title="Edit" data-bs-toggle="modal" data-bs-target="#addNewContact" onclick="editJobber(${item.Id})">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button type="button" class="jobber-action-btn btn-delete-jobber" title="Delete" onclick="deleteJobber(${item.Id})">
                                        <i class="fa fa-times-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                });
            }
            $("#tblJobber tbody").html(html);
        }

        function functionSearch(element) {
            var searchText = $(element).val().trim().toLowerCase();
            filteredJobberData = allJobberData.filter(function (item) {
                var partyName = (item.PartyName || "").toLowerCase();
                var mobileNumber = (item.MobileNumber || "").toLowerCase();
                var city = (item.City || "").toLowerCase();
                var jobberType = (item.JobberType || "").toLowerCase();

                return partyName.includes(searchText) ||
                    mobileNumber.includes(searchText) ||
                    city.includes(searchText) ||
                    jobberType.includes(searchText);
            });
            $("#rowStartCount").val(0);
            bindJobberGrid(0);
        }

        function checkSaveView() { saveJobberData(true); }
        function checkSave() { saveJobberData(false); }
        function checkEdit() { saveJobberData(true); }

        function saveJobberData(closeModal) {
            var name = $("#txtPartyName").val();
            var phone = $("#txtMobileNumber").val();
            var jobberType = $("#ddlJobberType").val();

            if (!name || !phone) {
                Toast.fire({ icon: 'warning', title: 'Please provide Party Name and Mobile Number.' });
                return;
            }

            var formData = {
                Id: $("#hfJobberID").val() || 0,
                JobberType: jobberType,
                PartyName: name,
                MobileNumber: phone,
                AlternateNumber: $("#txtAlternateNumber").val(),
                Email: $("#txtEmail").val(),
                Gstin: $("#txtGSTIN").val(),
                PanNo: $("#txtPANNo").val(),
                Prefix: $("#txtPrefix").val(),
                City: $("#txtCity").val(),
                Pincode: $("#txtPincode").val(),
                PlaceOfSupply: $("#ddlPlaceOfSupply option:selected").text(),
                BankHolderName: $("#txtBankHolderName").val(),
                BankAcNo: $("#txtBankAcNo").val(),
                BankIfsc: $("#txtBankIFSC").val(),
                BankName: $("#txtBankName").val(),
                BankBranch: $("#txtBankBranch").val(),
                BillingAddress: $("#txtBillingAddress").val(),
                MachineType: $("#txtMachineType").val() || "",
                Rpm: parseInt($("#txtRPM").val()) || 0,
                PanaRepeat: parseInt($("#txtPanaRepeat").val()) || 0,
                PanaWidth: parseInt($("#txtPanaWidth").val()) || 0,
                NoOfMachines: parseInt($("#txtNoOfMachines").val()) || 0
            };

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/SaveJobber',
                data: JSON.stringify({ model: formData }),
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                success: function (response) {
                    Toast.fire({ icon: 'success', title: 'Saved successfully!' });
                    clearAll();
                    displayData(0);
                    if (closeModal) $("#cancelbtn").click();
                },
                error: function (xhr) {
                    Toast.fire({ icon: 'error', title: 'Error saving record.' });
                }
            });
        }

        function editJobber(id) {
            getJobberById(id, "edit");
        }

        function viewJobber(id) {
            getJobberById(id, "view");
            $("#addNewContact").modal("show");
        }

        function getJobberById(id, mode) {
            $.ajax({
                type: "POST",
                url: "/WebServiceNikunjTextile.asmx/GetJobberById",
                data: JSON.stringify({ id: id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var jobber = response.d;
                    if (typeof jobber === "string") {
                        jobber = JSON.parse(jobber);
                    }

                    $("#hfJobberID").val(jobber.Id);
                    $("#ddlJobberType").val(jobber.JobberType);
                    $("#txtPrefix").val(jobber.Prefix || "");
                    $("#txtGSTIN").val(jobber.Gstin || "");
                    $("#txtPANNo").val(jobber.PanNo || "");
                    $("#txtPartyName").val(jobber.PartyName || "");
                    $("#txtMobileNumber").val(jobber.MobileNumber || "");
                    $("#txtAlternateNumber").val(jobber.AlternateNumber || "");
                    $("#txtEmail").val(jobber.Email || "");
                    $("#txtPincode").val(jobber.Pincode || "");
                    $("#txtCity").val(jobber.City || "");

                    // Set Place of Supply dropdown based on matching text or code
                    if (jobber.PlaceOfSupply) {
                        $("#ddlPlaceOfSupply option").each(function () {
                            if ($(this).text().includes(jobber.PlaceOfSupply)) {
                                $(this).prop("selected", true);
                            }
                        });
                    }

                    $("#txtBankHolderName").val(jobber.BankHolderName || "");
                    $("#txtBankAcNo").val(jobber.BankAcNo || "");
                    $("#txtBankIFSC").val(jobber.BankIfsc || "");
                    $("#txtBankName").val(jobber.BankName || "");
                    $("#txtBankBranch").val(jobber.BankBranch || "");
                    $("#txtBillingAddress").val(jobber.BillingAddress || "");

                    $("#txtMachineType").val(jobber.MachineType || "");
                    $("#txtRPM").val(jobber.Rpm || 0);
                    $("#txtPanaRepeat").val(jobber.PanaRepeat || 0);
                    $("#txtPanaWidth").val(jobber.PanaWidth || 0);
                    $("#txtNoOfMachines").val(jobber.NoOfMachines || 0);

                    toggleMachineSection();

                    if (mode === "view") {
                        $("#JobberModal input, #JobberModal textarea").prop("readonly", true);
                        $("#JobberModal select").prop("disabled", true);
                        $("#btnSave, #btnSaveAndNew, #editbtn").hide();
                        $("#addNewContactLabel").html("Jobber Master Details");
                    } else {
                        $("#JobberModal input, #JobberModal textarea").prop("readonly", false);
                        $("#JobberModal select").prop("disabled", false);
                        $("#btnSave, #btnSaveAndNew").hide();
                        $("#editbtn").show();
                        $("#addNewContactLabel").html("Edit Jobber Master");
                    }
                },
                error: function (xhr) {
                    Toast.fire({ icon: "error", title: "Failed to load Jobber details!" });
                }
            });
        }

        function deleteJobber(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "/WebServiceNikunjTextile.asmx/DeleteJobber",
                        data: JSON.stringify({ id: id }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (response) {
                            if (response.d === true) {
                                Toast.fire({ icon: "success", title: "Jobber deleted successfully!" });
                                displayData(0);
                            } else {
                                Toast.fire({ icon: "error", title: "Failed to delete Jobber!" });
                            }
                        },
                        error: function (xhr) {
                            console.log(xhr.responseText);
                            Toast.fire({ icon: "error", title: "Something went wrong!" });
                        }
                    });
                }
            });
        }
    </script>
}