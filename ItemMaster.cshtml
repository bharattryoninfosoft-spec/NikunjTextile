<script>
    document.title = "Item Master - Nikunj Textile";
</script>
<script>
    $(document).ready(function () {


        $('.active, .show, .current-page').removeClass('active show current-page');

        $("#master-tab").addClass("active");
        $("#tab-Master").addClass("show active");
        $("#aColorGroup").addClass("current-page");

        FunctionIsLogin();
        loadItemMaster();
        bindItemDropdowns();
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function loadItemMaster() {
        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetItemMasterList",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {

                let data = JSON.parse(res.d);

                if (data.Status == 1) {
                    bindItemTable(data.Data);
                } else {
                    alert(data.Message);
                }
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
    // VIEW
    $(document).on("click", ".view", function () {
        let id = $(this).data("id");
        openItemModal(id, "view");
    });
    function openItemModal(id, mode) {

        $("#itemModal").modal("show");
        if (mode === "add") {
            $("#itemModalTitle").text("Add Item");
            $("#ItemId").val(0);
            $("#ItemCode").val("");
            $("#ItemName").val("");
            $("#UnitId").val("");
            $("#GSTSLABId").val("");
            $("#HSNCode").val("");
            $("#SaleRate").val("");
            $("#IsActive").val("1");
        }
        else if (mode === "edit") {
            $("#itemModalTitle").text("Edit Item");
        }
        else if (mode === "view") {
            $("#itemModalTitle").text("View Item");
        }
        // 🔹 Disable all fields in view mode
        if (mode === "view") {
            $("#itemModal input, #itemModal select, #itemModal textarea").prop("disabled", true);
            $("#saveBtn").hide(); // hide save button
        } else {
            $("#itemModal input, #itemModal select, #itemModal textarea").prop("disabled", false);
            $("#saveBtn").show();
        }

        // 🔹 Load data
        if (id > 0) {
            $.ajax({
                url: '/WebServiceNikunjTextile.asmx/GetItemById',
                type: 'POST',
                data: JSON.stringify({ ItemId: id }),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                success: function (res) {
                    let result = JSON.parse(res.d);
                    if (result.Status === 1) {
                        let d = result.Data;
                        console.log("result", d);
                        $("#ItemId").val(d.ItemId);
                        $("#BarcodeNo").val(d.BarcodeNo);
                        $("#HSNCode").val(d.HSNCode);
                        $("#PurchaseRate").val(d.PurchaseRate);
                        $("#SaleRate").val(d.SaleRate);
                        $("#OpeningStock").val(d.OpeningStock);
                        $("#MinStockLevel").val(d.MinStockLevel);
                        $("#Description").val(d.Description);
                        $("#IsActive").prop("checked", d.IsActive);
                        $("#ItemName").val(d.ItemName).trigger("change");
                        $("#UnitId").val(d.UnitId).trigger("change");
                        $("#GSTSLABId").val(d.GSTSLABId).trigger("change");
                    }
                }
            });
        }
    }
    // EDIT
    $(document).on("click", ".edit", function () {
        let id = $(this).data("id");
        openItemModal(id, "edit");

    });
    // DELETE
    $(document).on("click", ".delete", function () {
        let id = $(this).data("id");

        Swal.fire({
            title: "Are you sure?",
            text: "You want to delete this item!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Delete"
        }).then((result) => {
            if (result.isConfirmed) {
                deleteItem(id);
            }
        });
    }); 
    $(document).on("change", "#ItemName", function () {

        let designerCode = $(this).find("option:selected").data("code") || "";

        $("#ItemCode").val(designerCode);

    });
    function bindItemTable(data) {

        if ($.fn.DataTable.isDataTable('#tblItemMaster')) {
            $('#tblItemMaster').DataTable().clear().destroy();
        }

        $('#tblItemMaster').DataTable({
            data: data,
            columns: [
                { data: 'ItemCode' },
                { data: 'ItemName' },
                { data: 'Unit' },
                { data: 'GSTSLABName' },
                { data: 'HSNCode' },
                { data: 'SaleRate' },
                {
                    data: 'IsActive',
                    render: function (data) {
                        return data
                            ? '<span class="badge bg-success">Active</span>'
                            : '<span class="badge bg-danger">Inactive</span>';
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        return `
                    <i class="fa fa-edit text-primary edit me-2" data-id="${row.ItemId}"></i>
                    <i class="fa fa-eye text-dark view me-2" data-id="${row.ItemId}"></i>
                    <i class="fa fa-trash text-danger delete" data-id="${row.ItemId}"></i>
                `;
                    }
                }
            ],

            // 🔥 IMPORTANT
            order: [[0, 'desc']],   // default sorting (we will fix below)

            responsive: true,
            pageLength: 10,
            lengthChange: false,
            info: false,
            ordering: true
        });
    }
    function deleteItem(id) {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/DeleteItem",
            type: "POST",
            data: JSON.stringify({ ItemId: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {

                let data = JSON.parse(res.d);

                if (data.Status == 1) {
                    Swal.fire("Deleted!", data.Message, "success");
                    loadItemMaster(); // reload table
                } else {
                    Swal.fire("Error!", data.Message, "error");
                }
            }
        });
    }
    function bindItemDropdowns() {

        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/GetItemDropdownData',
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function (res) {

                let data = JSON.parse(res.d);

                // bind dropdowns here
                $("#ItemName").empty().append('<option value="">Select</option>');
                $.each(data.Designers, function (i, item) {
                    $("#ItemName").append(`
                        <option value="${item.DesignerID}" 
                                data-code="${item.DesignerCode}" 
                                data-name="${item.DesignerName}">
                            ${item.DesignerCode} - ${item.DesignerName}
                        </option>
                    `);
                });

                $("#UnitId").empty().append('<option value="">Select</option>');
                $.each(data.Units, function (i, item) {
                    $("#UnitId").append(`<option value="${item.UnitId}">${item.UnitCode}</option>`);
                });

                $("#GSTSLABId").empty().append('<option value="">Select</option>');
                $.each(data.GST, function (i, item) {
                    $("#GSTSLABId").append(`<option value="${item.GSTSLABId}">${item.GST}%</option>`);
                });
            }
        });
    }
    function showToast(type, msg) {
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: type,
            title: msg,
            showConfirmButton: false,
            timer: 2000
        });
    }
    function saveItem() {
        debugger;
        var milliseconds = jQuery.now()
        let model = {
            ItemId: parseInt($("#ItemId").val()) || 0,
            ItemCode: $("#ItemCode").val(),
            ItemName: $("#ItemName").val(),
            UnitId: parseInt($("#UnitId").val()) || 0,
            HSNCode: $("#HSNCode").val(),
            GSTSLABId: parseInt($("#GSTSLABId").val()) || 0,
            PurchaseRate: parseFloat($("#PurchaseRate").val()) || 0,
            SaleRate: parseFloat($("#SaleRate").val()) || 0,
            OpeningStock: parseFloat($("#OpeningStock").val()) || 0,
            MinStockLevel: parseFloat($("#MinStockLevel").val()) || 0,
            Description: $("#Description").val()||'',
            IsActive: $("#IsActive").is(":checked"),   
            BarcodeNo: $("#BarcodeNo").val() || milliseconds,
        };

        $.ajax({
            url: '/WebServiceNikunjTextile.asmx/SaveItem',
            type: 'POST',

            // 🔥 IMPORTANT CHANGE
            data: JSON.stringify({ model: model }),

            contentType: 'application/json; charset=utf-8',
            dataType: 'json',

            success: function (res) {

                // 🔥 IMPORTANT CHANGE
                let data = JSON.parse(res.d);

                if (data.Status == 1) {
                    showToast('success', 'Saved Successfully');    
                    $('#itemModal').modal('hide');
                    loadItemMaster();
                } else {
                    showToast('error', 'Something went wrong');
                }
            },
            error: function () {
               showToast('error', 'Something went wrong');
            }
        });
    }
</script>



