@{
    Layout = "/_LayoutPage1.cshtml";
}


<style>
    #tblItemMaster {
        width: 100% !important;
    }

        #tblItemMaster td, #tblItemMaster th {
            vertical-align: middle !important;
            font-size: 13px;
            padding: 8px 10px;
        }

        #tblItemMaster td {
            white-space: nowrap;
        }

            #tblItemMaster td:nth-child(4) { /* Address column */
                white-space: normal;
                max-width: 250px;
                word-break: break-word;
            }

        #tblItemMaster th {
            background-color: #1f6ed4;
            color: #fff;
            font-weight: 500;
        }

    .dataTables_wrapper .dataTables_filter {
        float: right;
        margin-bottom: 10px;
    }

    .badge {
        font-size: 11px;
        padding: 5px 8px;
    }

    .fa {
        font-size: 14px;
    }
    .mt-3 {
        margin-top: 2rem !important;
    }
</style>

<!-- Content wrapper start -->
<div class="content-wrapper">
    <input type="hidden" id="rowStartCount" value="" />
    <div id="notes"></div>
    <div class="card-header-lg">
        <button style="float:right;" class="btn btn-primary" onclick="openItemModal(0, 'add')">
            <i class="fa fa-plus"></i> Add Item Master
        </button>
        <div class="modal fade" id="itemModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <input type="hidden" id="ItemId" />
                    <!-- Header -->
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Add Item</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <input type="hidden" id="ItemId" value="0" />
                        <input type="hidden" id="BarcodeNo" value="" />
                        <div class="row g-3">
                            <!-- Item Code -->
                            <div class="col-2">
                                <div class="field-wrapper">
                                    <input type="text" class="form-control" id="ItemCode" readonly>
                                    <div class="field-placeholder">Item Code</div>
                                </div>
                            </div>

                            <!-- Item Name -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <select id="ItemName" class="form-control">
                                        <option value="">Select</option>
                                    </select>
                                    <div class="field-placeholder">Item Name <span class="text-danger">*</span></div>
                                </div>
                            </div>
                            <!-- Unit -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <select id="UnitId" class="form-control">
                                        <option value="">Select</option>
                                    </select>
                                    <div class="field-placeholder">Unit</div>
                                </div>
                            </div>

                            <!-- GST -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <select id="GSTSLABId" class="form-control">
                                        <option value="">Select</option>
                                    </select>
                                    <div class="field-placeholder">GST (%)</div>
                                </div>
                            </div>

                            <!-- HSN Code -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <input type="text" class="form-control" id="HSNCode">
                                    <div class="field-placeholder">HSN Code</div>
                                </div>
                            </div>
                            <!-- Sale Rate -->
                            <div class="col-3">
                                <div class="field-wrapper">
                                    <input type="number" class="form-control" id="SaleRate">
                                    <div class="field-placeholder">Sale Rate</div>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-2 mt-3">
                                <input type="checkbox" id="IsActive" checked /> Active
                            </div>
                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">                        
                        <button type="button" id="saveBtn" class="btn btn-success px-4" onclick="saveItem()">
                            Save
                        </button>
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div style="float:none;clear:both;">
        <br />
    </div>

    <!-- Row start -->
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Item Master</div>
                    <br />
                    <div class="table-responsive">
                        <table id="tblItemMaster" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Unit</th>
                                    <th>GST</th>
                                    <th>HSN Code</th>
                                    <th>Sale Rate</th>
                                    <th>Status</th>
                                    <th>Action</th> <!-- NEW -->
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <!-- Row end -->

</div>
<!-- Content wrapper end -->














