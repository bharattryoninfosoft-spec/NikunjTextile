    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getLocationMaster?startFrom=' + rowStart,
            //getItemCat
            data: "{ 'startFrom':'" + rowStart + "' }",
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {

                console.log(response);

                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listLocationMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
                    $("#view-more-btn").show();
                }

                var SrNo = rowStart + 1;
                for (var i = 0; i < response.listLocationMaster.length; i++) {

                    var Top = i - 1;
                    var Previous = i + 1;

                    //console.log(response.listLocationMaster[Previous].TypeID);



                    temp += "<tr>";
                    temp += "<td>" + SrNo++ + "</td>";
                    temp += "<td>" + response.listLocationMaster[i].LocationTitle + "</td>";
                    temp += "<td>" + response.listLocationMaster[i].LocationAddress + "</td>";

                    if (response.listLocationMaster[i].IsActive == "1") {
                        temp += "<td><span class='badge bg-success'>Active</span></td>";
                    }
                    else {
                        temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                    }

                    //temp += "<td>" + ActionPosition + "</td>";
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listLocationMaster[i].LocationID + ")'><i class='icon-edit1 text-info'></i></a> &nbsp;&nbsp; <a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listLocationMaster[i].LocationID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "</tr>";
                }

                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }








