    function formatDate(jsonDate) {

        var timestamp = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, "$1"));
        var date = new Date(timestamp);

        var year = date.getFullYear();
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var day = ("0" + date.getDate()).slice(-2);

        return year + "-" + month + "-" + day;
    }
    function BindFinancialYearMaster() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetFinancialYear",
            type: "POST",
            data: "{}",
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                var data = res.d;

                if (typeof data === "string") {
                    data = JSON.parse(data);
                }          
                if (data && data.length > 0) {

                    $("#dateFrom").val(formatDate(data[0].StartDate));
                    $("#dateTo").val(formatDate(data[0].EndDate));

                   

                    LoadReport(1);
                   
                }

            }
        });
    }
    $(document).on("click", ".report-tab", function () {

        var reportType = $(this).data("report");

        LoadReport(reportType);

    });
    function LoadReport(type) {

        if (!ValidateDates()) {
            return;
        }

        var from = $("#dateFrom").val();
        var to = $("#dateTo").val();
        var MaterialID = $("#MaterialID").val() || 0;
        var ColorID = $("#ColorID").val() || 0;
        var GodownID = $("#GodownID").val() || 0;
        var LocationID = $("#LocationID").val() || 0;
        var PartyID = $("#PartyID").val() || 0;
        var CompanyID = $("#CompanyID").val() || 0;
        var YarnColorCode = $("#YarnColorCode").val() || "";
        var BoxNo = $("#BoxNo").val() || "";


        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetYarnReport",
            type: "POST",
            data: JSON.stringify({

                ReportType: type,
                DateFrom: from,
                DateTo: to,
                MaterialID: MaterialID,
                ColorID: ColorID,
                GodownID: GodownID,
                LocationID: LocationID,
                PartyID: PartyID,
                CompanyID: CompanyID,
                YarnColorCode: YarnColorCode,
                BoxNo: BoxNo

            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {

                var data = res.d;
                if (typeof data === "string") {
                    data = JSON.parse(data);
                }

                if (!data || data.length === 0) {
                    $("#reportTable tbody").html("<tr><td>No Data Found</td></tr>");
                    return;
                }

                if ($.fn.DataTable.isDataTable('#reportTable')) {
                    $('#reportTable').DataTable().destroy();
                }

                $("#reportTable").empty();
           
                $("#reportTable").DataTable({
                    data: data,
                    columns: Object.keys(data[0]).map(function (key) {

                        if (key === "YarnInwardDate" || key === "DateAndTime" || key === "PODate") {
                            return {
                                data: key,
                                title: key,
                                render: function (value) {

                                    if (!value) return "";

                                    var timestamp = parseInt(value.substr(6));
                                    var date = new Date(timestamp);

                                    var day = ("0" + date.getDate()).slice(-2);
                                    var month = ("0" + (date.getMonth() + 1)).slice(-2);
                                    var year = date.getFullYear();

                                    return day + "-" + month + "-" + year;
                                }
                            };
                        }

                        return { data: key, title: key };
                    }),

                    responsive: true,
                    pageLength: 25,
                     lengthChange: false,   // hide "Show entries"
                    info: false            // hide "Showing X of Y"
                });             
            }
        });
    }
