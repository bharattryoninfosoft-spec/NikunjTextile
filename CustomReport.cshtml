            $("#MaterialID").val(filter.MaterialID).trigger('change');
            $("#ColorID").val(filter.ColorID).trigger('change');
            $("#GodownID").val(filter.GodownID).trigger('change');
            $("#LocationID").val(filter.LocationID).trigger('change');
            $("#BillToID").val(filter.BillToID).trigger('change');
            $("#ShippedToID").val(filter.ShippedToID).trigger('change');
            $("#YarnColorCode").val(filter.YarnColorCode);
            $("#BoxNo").val(filter.BoxNo).trigger('change');

            // Barcode handle
            if (filter.BarcodeNo) {
                $("#BoxNo option").each(function () {
                    if ($(this).data("barcode") == filter.BarcodeNo) {
                        $(this).prop("selected", true);
                    }
                });
            }
            // Close modal
            $("#loadFilterModal").modal("hide");
            // 🔥 Load report
            LoadReport()
        });

        // ========================================================
        // 📦 LOCATION BOX DETAILS MODAL LOGIC
        // ========================================================
        var currentModalRowData = null;
        var rowBoxesCache = [];
        var allBoxesCache = [];

        $(document).on("click", ".btn-box-details, .btn-box-details *, td.box-count-cell", function (e) {
            e.preventDefault();
            e.stopPropagation();

            var tr = $(this).closest('tr');
            var table = $('#reportTable').DataTable();
            var rowData = table.row(tr).data();

            if (rowData) {
                showBoxDetailsModal(rowData);
            }
        });

        function openBoxModalElement() {
            var $m = $("#modalLocationBoxes");
            if (typeof $m.modal === 'function') {
                $m.modal('show');
            } else if (window.bootstrap && bootstrap.Modal) {
                try {
                    var el = document.getElementById('modalLocationBoxes');
                    var modal = (typeof bootstrap.Modal.getInstance === 'function' ? bootstrap.Modal.getInstance(el) : null) || new bootstrap.Modal(el);
                    modal.show();
                } catch (e) {
                    $m.addClass('show').css('display', 'block');
                }
            } else {
                $m.addClass('show').css('display', 'block');
            }
        }

        function closeBoxModalElement() {
            var $m = $("#modalLocationBoxes");
            if (typeof $m.modal === 'function') {
                $m.modal('hide');
            } else if (window.bootstrap && bootstrap.Modal) {
                try {
                    var el = document.getElementById('modalLocationBoxes');
                    var modal = typeof bootstrap.Modal.getInstance === 'function' ? bootstrap.Modal.getInstance(el) : null;
                    if (modal) modal.hide();
                    else $m.removeClass('show').css('display', 'none');
                } catch (e) {
                    $m.removeClass('show').css('display', 'none');
                }
            } else {
                $m.removeClass('show').css('display', 'none');
            }
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css('padding-right', '');
        }

        $(document).on("click", "#modalLocationBoxes [data-dismiss='modal'], #modalLocationBoxes [data-bs-dismiss='modal']", function () {
            closeBoxModalElement();
        });

        function showBoxDetailsModal(rowData) {
            currentModalRowData = rowData;
            rowBoxesCache = [];
            allBoxesCache = [];

            var locTitle = rowData.LocationTitle || rowData.GodownLocationTitle || rowData.Location || '';
            var gdnTitle = rowData.GodownTitle || rowData.Godown || '';
            var mat = rowData.YarnMaterial || rowData.Material || '';
            var color = rowData.YarnColor || rowData.Color || '';
            var code = rowData.YarnColorCode || rowData.ColorCode || '';
            var comp = rowData.CompanyName || '';
            var party = rowData.PartyName || '';
            var boxes = parseInt(rowData.NoOfBoxes || rowData.Boxes || 0) || 0;
            var weight = parseFloat(rowData.NetWeight || rowData.Weight || 0).toFixed(2);

            $("#modalLocTitle").text(locTitle || 'Location');
            $("#modalLocSubTitle").text('Boxes and weights inside ' + (locTitle || 'this location'));

            var locText = locTitle || '-';
            if (gdnTitle) locText += ' <span class="text-muted fw-normal">(' + gdnTitle + ')</span>';
            $("#boxModalLocationInfo").html(locText);

            var matText = mat || '-';
            if (color) matText += ' / ' + color;
            if (code) matText += ' <span class="badge bg-secondary">' + code + '</span>';
            $("#boxModalMaterialInfo").html(matText);

            $("#boxModalTotalBoxes").text(boxes);
            $("#boxModalTotalWeight").text(weight);
            var avg = boxes > 0 ? (parseFloat(weight) / boxes).toFixed(2) : '0.00';
            $("#boxModalAvgWeight").text(avg);

            // Reset modal controls
            $("#boxSearchInput").val('');
            $("#boxErrorMsg").addClass("d-none").text('');
            $("#boxTableWrapper").addClass("d-none");
            $("#boxLoadingSpinner").removeClass("d-none");
            $("#btnFilterRowOnly").addClass("btn-primary active font-weight-bold").removeClass("btn-outline-primary");
            $("#btnFilterAllLocation").removeClass("btn-primary active font-weight-bold").addClass("btn-outline-secondary");
            $("#countRowOnly").text(boxes);
            $("#countAllLocBadge").empty();

            openBoxModalElement();

            // Fetch boxes
            fetchBoxDetails(rowData, false);
        }

        function fetchBoxDetails(rowData, allInLocation) {
            var locTitle = rowData.LocationTitle || rowData.GodownLocationTitle || rowData.Location || '';
            var gdnTitle = rowData.GodownTitle || rowData.Godown || '';
            var mat = rowData.YarnMaterial || rowData.Material || '';
            var color = rowData.YarnColor || rowData.Color || '';
            var code = rowData.YarnColorCode || rowData.ColorCode || '';
            var comp = rowData.CompanyName || '';
            var party = rowData.PartyName || '';

            $("#boxLoadingSpinner").removeClass("d-none");
            $("#boxTableWrapper").addClass("d-none");
            $("#boxErrorMsg").addClass("d-none");

            $.ajax({
                url: '/CustomReport.cshtml?handler=GetBoxDetails',
                type: 'POST',
                data: {
                    LocationTitle: locTitle,
                    GodownTitle: gdnTitle,
                    YarnMaterial: mat,
                    YarnColor: color,
                    YarnColorCode: code,
                    CompanyName: comp,
                    PartyName: party,
                    AllInLocation: allInLocation ? 'true' : 'false'
                },
                dataType: 'json',
                success: function (res) {
                    $("#boxLoadingSpinner").addClass("d-none");
                    if (res && res.status === 'success' && res.data) {
                        if (!allInLocation) {
                            rowBoxesCache = res.data;
                            $("#countRowOnly").text(res.data.length);
                        } else {
                            allBoxesCache = res.data;
                            $("#countAllLocBadge").text('(' + res.data.length + ')');
                        }
                        renderBoxTable(res.data);
                    } else {
                        $("#boxErrorMsg").removeClass("d-none").text((res && res.message) ? res.message : 'No boxes found for this location.');
                    }
                },
                error: function () {
                    // Fallback to WebServiceNikunjTextile.asmx
                    $.ajax({
                        url: '/WebServiceNikunjTextile.asmx/GetLocationBoxDetails',
                        type: 'POST',
                        data: JSON.stringify({
                            LocationTitle: locTitle,
                            GodownTitle: gdnTitle,
                            YarnMaterial: mat,
                            YarnColor: color,
                            YarnColorCode: code,
                            CompanyName: comp,
                            PartyName: party,
                            AllInLocation: allInLocation
                        }),
                        contentType: 'application/json; charset=utf-8',
                        dataType: 'json',
                        success: function (res2) {
                            $("#boxLoadingSpinner").addClass("d-none");
                            var parsed = typeof res2.d === 'string' ? JSON.parse(res2.d) : (res2.d || res2);
                            var boxList = (parsed && parsed.data) ? parsed.data : (Array.isArray(parsed) ? parsed : []);
                            if (!allInLocation) {
                                rowBoxesCache = boxList;
                                $("#countRowOnly").text(boxList.length);
                            } else {
                                allBoxesCache = boxList;
                                $("#countAllLocBadge").text('(' + boxList.length + ')');
                            }
                            renderBoxTable(boxList);
                        },
                        error: function (xhr2) {
                            $("#boxLoadingSpinner").addClass("d-none");
                            $("#boxErrorMsg").removeClass("d-none").text('Error loading box details. Please try again.');
                        }
                    });
                }
            });
        }

        function formatBoxDate(dStr) {
            if (!dStr) return '-';
            var s = String(dStr).trim();
            var m = s.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/);
            if (m) {
                var yyyy = m[1];
                var mm = m[2].length === 1 ? '0' + m[2] : m[2];
                var dd = m[3].length === 1 ? '0' + m[3] : m[3];
                return dd + '-' + mm + '-' + yyyy;
            }
            return s;
        }

        function renderBoxTable(boxes) {
            var tbody = $("#tblBoxDetailsList tbody");
            tbody.empty();

            var filterText = ($("#boxSearchInput").val() || '').trim().toLowerCase();

            var filtered = (boxes || []).filter(function (b) {
                if (!filterText) return true;
                var boxNo = String(b.BoxNo || '').toLowerCase();
                var barcode = String(b.BarcodeNo || '').toLowerCase();
                var mat = String(b.YarnMaterial || '').toLowerCase();
                var col = String(b.YarnColor || '').toLowerCase();
                var dt = formatBoxDate(b.YarnInwardDate).toLowerCase();
                return boxNo.indexOf(filterText) >= 0 || barcode.indexOf(filterText) >= 0 || mat.indexOf(filterText) >= 0 || col.indexOf(filterText) >= 0 || dt.indexOf(filterText) >= 0;
            });

            $("#boxFilterCount").text(filtered.length + ' / ' + (boxes ? boxes.length : 0) + ' boxes');

            if (filtered.length === 0) {
                tbody.html('<tr><td colspan="7" class="text-center py-4 text-muted"><i class="fa fa-info-circle me-1"></i> No matching boxes found.</td></tr>');
                $("#tfootTotalWeight").html('0.00 <small class="font-weight-normal fw-normal">kg</small>');
                $("#tfootTotalBoxes").text(0);
                $("#boxTableWrapper").removeClass("d-none");
                return;
            }

            var totalWt = 0;
            filtered.forEach(function (b, idx) {
                var wt = parseFloat(b.NetWeight) || 0;
                totalWt += wt;

                var rowHtml = '<tr>' +
                    '<td class="text-center text-muted font-weight-bold fw-bold py-2" style="vertical-align:middle;">' + (idx + 1) + '</td>' +
                    '<td class="text-center text-muted small py-2" style="vertical-align:middle;">' + formatBoxDate(b.YarnInwardDate) + '</td>' +
                    '<td class="py-2" style="vertical-align:middle; font-weight:500; color:#334155;">' + (b.YarnMaterial || '-') + '</td>' +
                    '<td class="py-2" style="vertical-align:middle; color:#334155;">' + (b.YarnColor || '-') + (b.YarnColorCode ? ' <span class="badge badge-dark px-2 py-1 ml-1 ms-1" style="background:#1e293b; color:#fff; font-size:0.72rem; letter-spacing:0.3px;">' + b.YarnColorCode + '</span>' : '') + '</td>' +
                    '<td class="text-right text-end font-weight-bold fw-bold text-success py-2" style="vertical-align:middle; font-size:0.95rem;">' + wt.toFixed(2) + ' <small class="text-muted" style="font-size:0.75rem; font-weight:normal;">kg</small></td>' +
                    '<td class="text-center py-2" style="vertical-align:middle;"><span class="badge badge-light border px-2 py-1" style="font-size:0.88rem; font-weight:700; color:#1e293b; background:#ffffff; box-shadow:0 1px 2px rgba(0,0,0,0.05); border-color:#cbd5e1 !important;"><i class="fa fa-cube text-primary mr-1 me-1"></i>' + (b.BoxNo || '-') + '</span></td>' +
                    '<td class="text-center font-monospace py-2" style="vertical-align:middle; font-size:0.85rem; color:#475569; letter-spacing:0.5px;">' + (b.BarcodeNo || '-') + '</td>' +
                    '</tr>';
                tbody.append(rowHtml);
            });

            $("#tfootTotalWeight").html(totalWt.toFixed(2) + ' <small class="font-weight-normal fw-normal" style="font-size:0.8rem;">kg</small>');
            $("#tfootTotalBoxes").text(filtered.length);
            $("#boxTableWrapper").removeClass("d-none");
        }

        $(document).on("input", "#boxSearchInput", function () {
            var activeList = $("#btnFilterAllLocation").hasClass("active") ? allBoxesCache : rowBoxesCache;
            renderBoxTable(activeList);
        });

        $(document).on("click", "#btnFilterRowOnly", function () {
            $("#btnFilterRowOnly").addClass("btn-primary active font-weight-bold").removeClass("btn-outline-primary");
            $("#btnFilterAllLocation").removeClass("btn-primary active font-weight-bold").addClass("btn-outline-secondary");
            if (rowBoxesCache && rowBoxesCache.length > 0) {
                renderBoxTable(rowBoxesCache);
            } else if (currentModalRowData) {
                fetchBoxDetails(currentModalRowData, false);
            }
        });

        $(document).on("click", "#btnFilterAllLocation", function () {
            $("#btnFilterAllLocation").addClass("btn-primary active font-weight-bold").removeClass("btn-outline-secondary");
            $("#btnFilterRowOnly").removeClass("btn-primary active font-weight-bold").addClass("btn-outline-primary");
            if (allBoxesCache && allBoxesCache.length > 0) {
                renderBoxTable(allBoxesCache);
            } else if (currentModalRowData) {
                fetchBoxDetails(currentModalRowData, true);
            }
        });

        $(document).on("click", "#btnExportBoxesExcel", function () {
            var activeList = $("#btnFilterAllLocation").hasClass("active") ? allBoxesCache : rowBoxesCache;
            if (!activeList || activeList.length === 0) {
                alert("No boxes to export.");
                return;
            }
            var loc = $("#modalLocTitle").text().trim() || 'Location';
            var csv = "SR,Date,Material,Color,ColorCode,NetWeight(kg),BoxNumber,Barcode\n";
            activeList.forEach(function (b, i) {
                csv += (i + 1) + ',"' + formatBoxDate(b.YarnInwardDate) + '","' + (b.YarnMaterial || '') + '","' + (b.YarnColor || '') + '","' + (b.YarnColorCode || '') + '",' + (parseFloat(b.NetWeight) || 0).toFixed(2) + ',"' + (b.BoxNo || '') + '","' + (b.BarcodeNo || '') + '"\n';
            });
            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "BoxDetails_" + loc.replace(/[^a-zA-Z0-9_-]/g, "_") + ".csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    </script>

    }

