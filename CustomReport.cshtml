@{
    Layout = "/_LayoutPage1.cshtml";
}
<style>
    div.dt-buttons {
        float: none !important;
    }
    div.dt-buttons {
        float: left;
    }
    .dt-buttons {
        display: flex !important;
        gap: 5px;
    }

        .dt-buttons .dt-button {
            display: inline-block !important;
            background: #0d6efd;
            color: #fff;
            border-radius: 4px;
            padding: 5px 10px;
        }
</style>
<div class="content-wrapper">
    <div class="container-fluid">

        <div class="row">

            <!-- LEFT FILTER PANEL -->
            <div class="col-md-3">

                <div class="card p-3">

                    <h5 class="d-flex justify-content-between align-items-center">
                        Filters
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="OpenFilterModal()">
                            Load Report
                        </button>
                    </h5>


                    <div class="field-wrapper">
                        <input type="date" id="dateFrom" class="form-control">
                        <div class="field-placeholder">Start Date</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="BillToID" class="select-single detail" title="Select Color Code" data-live-search="true">
                            <option value="0">Company Name</option>
                        </select>
                        <div class="field-placeholder">Company Name</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="ShippedToID" class="select-single detail" title="Select Color Code" data-live-search="true">
                            <option value="0">Party Name</option>
                        </select>
                        <div class="field-placeholder">Party Name</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="MaterialID" class="select-single detail" title="Select Yarn Company" data-live-search="true">
                            <option value="0">Material</option>
                        </select>
                        <div class="field-placeholder">Material</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="ColorID" class="select-single detail" title="Select Color Code" data-live-search="true">
                            <option value="0">Color</option>
                        </select>
                        <div class="field-placeholder">Color</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="YarnColorCode" class="select-single detail" title="Select Color Code" data-live-search="true">
                            <option value="">Color Code</option>
                        </select>
                        <div class="field-placeholder">Color Code</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="BoxNo" class="select-single detail" title="Select BoxNo" data-live-search="true">
                            <option value="">BoxNo</option>
                        </select>
                        <div class="field-placeholder">BoxNo</div>
                    </div>
                    <div class="field-wrapper">
                        <select id="GodownID" class="select-single detail" title="Select Color Code" data-live-search="true">
                            <option value="0">Godown</option>
                        </select>
                        <div class="field-placeholder">Godown</div>
                    </div>

                    <div class="field-wrapper">
                        <select id="LocationID" class="select-single detail" title="Select Color Code" data-live-search="true">
                            <option value="0">Location</option>
                        </select>
                        <div class="field-placeholder">Location</div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button class="btn btn-primary w-45" onclick="LoadReport()">
                            Search
                        </button>
                        <button type="button" class="btn btn-secondary w-45" onclick="ResetFilters()">
                            Reset
                        </button>
                    </div>




                </div>

            </div>
            <div class="col-md-9">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="reportTable" class="table table-bordered table-striped w-100">
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Save Filter Modal -->
            <div class="modal fade" id="saveFilterModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">

                        <div class="modal-header bg-warning">
                            <h5 class="modal-title">Save Filter</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <label>Filter Name</label>
                            <input type="text" id="txtFilterName" class="form-control" placeholder="Enter Filter Name">
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button id="btnSaveFilterFinal" class="btn btn-success">Save</button>
                        </div>

                    </div>
                </div>
            </div>
            <!-- Load Filter Modal -->
            <div class="modal fade" id="loadFilterModal" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">

                        <div class="modal-header bg-secondary text-white">
                            <h5 class="modal-title">Load Report </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">

                            <table class="table table-bordered table-hover" id="tblFilterList">
                                <thead class="table-light">
                                    <tr>
                                        <th>Id</th>
                                        <th>Report Name</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Content wrapper end -->
</div>


<script>
    $('body').addClass('fullscreen');
    var table;

    $(document).ready(function () {
        $('.active, .show, .current-page').removeClass('active show current-page');
        $("#Report-tab").addClass("active");
        $("#tab-Report").addClass("show active");
        $("#aCustomReport").addClass("current-page");
        $(".nav-tabs .nav-link").removeClass("active");
        $(".nav-tabs .nav-link").attr("aria-selected", "false");
        $(".nav-tabs .nav-link[data-report='1']").addClass("active");
        $(".nav-tabs .nav-link[data-report='1']").attr("aria-selected", "true");
        $(document).ready(function () {

            var today = new Date();

            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();

            var formatted = yyyy + "-" + mm + "-" + dd; // for input type="date"
            $("#dateFrom").val(formatted);
        });
        FunctionIsLogin();
        //BindFinancialYearMaster();
        BindMaterial();
        BindColor();
        BindGodown();
        BindLocation();
        BindParty();
        BindCompany();
        BindYarnColorCode();
        BindBox();


    });
    var table = $('#tblInward').DataTable();

    table.columns().every(function () {
        var that = this;

        $('input', this.header()).on('keyup change', function () {
            if (that.search() !== this.value) {
                that.search(this.value).draw();
            }
        });
    });
    var notes = $('#notes').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    var notess = $('#notess').notify({
        removeIcon: '<i class="icon-close"></i>'
    });
    function getDefaultCompany() {
        $.ajax({
            type: "GET",
            url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.Code == 200 || response.Code == "200") {
                    $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                    $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                }
            },
            error: function (request, status, error) {
                //$("#add-alert").removeClass("alert-success");
                //$("#add-alert").addClass("alert-danger");
                //$("#add-alert").html(response.Message);
                //$("#add-alert").show();

                notes.show(request.statusText, {
                    type: 'danger',
                    //title: 'Opps.!',
                    //icon: '<i class="icon-alert-triangle"></i>'
                });


            }
        });
    }
    function FunctionIsLogin() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
            data: "{ 'userName':'0' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                console.log(data);
                if (data.d == "false") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
                console.log(error);
            }
        });
    }
    function logout() {
        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/Logout',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data, status) {
                if (data.d == "done") {
                    window.location.replace("/Index");
                }
            },
            error: function (request, status, error) {
            }
        });
    }
    function clearAll() {
        getDefaultCompany();
        $("#savebtn").show();
        $("#editbtn").hide();
        $("#addNewContactLabel").html("Add Color Matching Form");
        $("#add-alert").hide();

        $("#YarnColor").val('');

        $(".company-invalid-feedback").hide();

        $(".clear-field").removeClass("is-valid is-invalid");
        $(".invalid-feedback").hide();
        $(".valid-feedback").hide();
    }
    function loadTable() {
        $.ajax({
            type: "POST",
            url: "/WebServiceNikunjTextile.asmx/GetInwardTable",
            contentType: "application/json",
            dataType: "json",
            success: function (res) {
                var data = JSON.parse(res.d);
                table.clear();
                $.each(data, function (i, v) {
                    table.row.add([
                        v.YarnInwardDate,
                        v.ChallanNo,
                        v.PartyName,
                        v.BoxNo,
                        parseFloat(v.NetWeight).toFixed(2)
                    ]);
                });
                table.draw();
            }
        });
    }
    function ValidateDates() {

        var from = $("#dateFrom").val();

        if (from == "") {
            alert("Please select Date");
            return false;
        }

        return true;
    }
    function BindMaterial() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetMaterial",
            type: "POST",
            data: "{}",
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                var data = res.d;

                // if string convert to JSON
                if (typeof data === "string") {
                    data = JSON.parse(data);
                }
                $("#MaterialID").empty();
                $("#MaterialID").append('<option value="0">All Material</option>');

                $.each(data, function (i, item) {

                    $("#MaterialID").append(
                        '<option value="' + item.YarnMaterialID + '">' +
                        item.YarnMaterial +
                        '</option>'
                    );

                });

            },

            error: function (err) {
                console.log("Error:", err);
            }

        });

    }
