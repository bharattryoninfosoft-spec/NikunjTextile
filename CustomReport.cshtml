            var BillToID = $("#BillToID").val() || 0;
            var ShippedToID = $("#ShippedToID").val() || 0;

            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/GetYarnReport",
                type: "POST",
                data: JSON.stringify({
                    DateFrom: from,
                    MaterialID: MaterialID,
                    ColorID: ColorID,
                    GodownID: GodownID,
                    LocationID: LocationID,
                    CompanyID: BillToID,
                    PartyID: ShippedToID,
                    YarnColorCode: YarnColorCode,
                    BoxNo: BoxNo,
                    BarcodeNo: BarcodeNo
                }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",

                success: function (res) {
                    
                    var data = res.d;
                    if (typeof data === "string") {
                        data = JSON.parse(data);
                    }

                    if (!data || data.length === 0) {
                        if ($.fn.DataTable.isDataTable('#reportTable')) {
                            $('#reportTable').DataTable().clear().destroy();
                        }

                        $("#reportTable").html(
                            "<thead><tr><th>Message</th></tr></thead>" +
                            "<tbody><tr><td>No Data Found</td></tr></tbody>"
                        );

                        return;
                    }

                    // Group identical rows and sum boxes & net weight
                    data = groupReportData(data);

                    if ($.fn.DataTable.isDataTable('#reportTable')) {
                        $('#reportTable').DataTable().clear().destroy();
                    }

                    $("#reportTable").empty();

                    var colKeys = Object.keys(data[0]);
                    var cols = colKeys.map(function (key) {
                        var lower = key.toLowerCase();
                        var isBoxCount = lower.indexOf('box') >= 0 && lower.indexOf('color') < 0 && lower.indexOf('code') < 0;
                        if (isBoxCount) {
                            return {
                                data: key,
                                title: key,
                                className: 'text-center box-count-cell',
                                render: function (val, type, row) {
                                    var count = val || 0;
                                    return '<a href="javascript:void(0)" class="btn-box-details badge bg-primary text-white text-decoration-none px-2 py-1 shadow-sm" ' +
                                        'title="Click to view all boxes and weights in this location" style="cursor: pointer; font-size: 0.95rem; display: inline-block;">' +
                                        '<i class="fa fa-cubes me-1"></i>' + count +
                                        '</a>';
                                }
                            };
                        }
                        var isWeight = lower.indexOf('weight') >= 0 || lower.indexOf('wt') >= 0;
                        if (isWeight) {
                            return {
                                data: key,
                                title: key,
                                className: 'text-end fw-semibold',
                                render: function (val) {
                                    var num = parseFloat(val) || 0;
                                    return num.toFixed(2);
                                }
                            };
                        }
                        return { data: key, title: key };
                    });

                    $("#reportTable").DataTable({
                        data: data,
                        columns: cols,

                        dom: '<"row mb-2"<"col-md-6"B><"col-md-6 text-end"f>>rtip',

                        buttons: [
                            {
                                extend: 'pdf',
                                text: '<i class="fa fa-file-pdf-o" aria-hidden="true"></i> PDF',
                                orientation: 'landscape', // 🔥 important
                                pageSize: 'A4',
                                title: 'Custom Report - Nikunj Textile',
                                className: 'btn btn-danger',
                                customize: function (doc) {
                                    // 🔥 Center title
                                    doc.content[0].alignment = 'center';
                                    doc.content[0].fontSize = 14;
                                    doc.content[0].bold = true;
                                    // 🔥 Table full width
                                    var table = doc.content[1].table;
                                    var colCount = table.body[0].length;
                                    table.widths = Array(colCount).fill('*');
                                    // 🔥 Header style
                                    doc.styles.tableHeader = {
                                        fillColor: '#2d4154',
                                        color: 'white',
                                        alignment: 'center',
                                        bold: true,
                                        fontSize: 10
                                    };
                                    // 🔥 Body alignment
                                    doc.defaultStyle.fontSize = 9;
                                    // 🔥 Layout padding
                                    doc.content[1].layout = {
                                        paddingLeft: function () { return 5; },
                                        paddingRight: function () { return 5; },
                                        paddingTop: function () { return 4; },
                                        paddingBottom: function () { return 4; }
                                    };
                                }
                            },
                            {
                                extend: 'excel',
                                text: '<i class="fa fa-file-excel-o" aria-hidden="true"></i> Excel',
                                className: 'btn btn-success'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa fa-print" aria-hidden="true"></i> Print',
                                className: 'btn btn-primary'
