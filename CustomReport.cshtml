    function formatDate(jsonDate) {

        var timestamp = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, "$1"));
        var date = new Date(timestamp);

        var year = date.getFullYear();
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var day = ("0" + date.getDate()).slice(-2);

        return year + "-" + month + "-" + day;
    }
    function BindFinancialYearMaster() {

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetFinancialYear",
            type: "POST",
            data: "{}",
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                var data = res.d;

                if (typeof data === "string") {
                    data = JSON.parse(data);
                }
                if (data && data.length > 0) {

                    $("#dateFrom").val(formatDate(data[0].StartDate));
                    $("#dateTo").val(formatDate(data[0].EndDate));



                    LoadReport();

                }

            }
        });
    }
    function LoadReport() {

        if (!ValidateDates()) return;

        var from = $("#dateFrom").val();
        var MaterialID = $("#MaterialID").val() || 0;
        var ColorID = $("#ColorID").val() || 0;
        var GodownID = $("#GodownID").val() || 0;
        var LocationID = $("#LocationID").val() || 0;
        var YarnColorCode = $("#YarnColorCode").val() || "";
        var BoxNo = $("#BoxNo").val() || "";
        var BarcodeNo = $("#BoxNo option:selected").data("barcode") || "";
        var BillToID = $("#BillToID").val() || 0;
        var ShippedToID = $("#ShippedToID").val() || 0;

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetYarnReport",
            type: "POST",
            data: JSON.stringify({
                DateFrom: from,
                MaterialID: MaterialID,
                ColorID: ColorID,
                GodownID: GodownID,
                LocationID: LocationID,
                CompanyID: BillToID,
                PartyID: ShippedToID,
                YarnColorCode: YarnColorCode,
                BoxNo: BoxNo,
                BarcodeNo: BarcodeNo
            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (res) {

                var data = res.d;
                if (typeof data === "string") {
                    data = JSON.parse(data);
                }

                if (!data || data.length === 0) {
                    $("#reportTable tbody").html("<tr><td>No Data Found</td></tr>");
                    return;
                }

                if ($.fn.DataTable.isDataTable('#reportTable')) {
                    $('#reportTable').DataTable().clear().destroy();
                }

                $("#reportTable").empty();

                $("#reportTable").DataTable({
                    data: data,
                    columns: Object.keys(data[0]).map(function (key) {
                        return { data: key, title: key };
                    }),

                    dom: '<"row mb-2"<"col-md-6"B><"col-md-6 text-end"f>>rtip',

                    buttons: [
                        {
                            extend: 'pdf',
                            text: '<i class="fa fa-file-pdf-o" aria-hidden="true"></i> PDF',
                            orientation: 'landscape', // 🔥 important
                            pageSize: 'A4',
                            title: 'Custom Report - Nikunj Textile',
                            className: 'btn btn-danger',
                            customize: function (doc) {
                                // 🔥 Center title
                                doc.content[0].alignment = 'center';
                                doc.content[0].fontSize = 14;
                                doc.content[0].bold = true;
                                // 🔥 Table full width
                                var table = doc.content[1].table;
                                var colCount = table.body[0].length;
                                table.widths = Array(colCount).fill('*');
                                // 🔥 Header style
                                doc.styles.tableHeader = {
                                    fillColor: '#2d4154',
                                    color: 'white',
                                    alignment: 'center',
                                    bold: true,
                                    fontSize: 10
                                };
                                // 🔥 Body alignment
                                doc.defaultStyle.fontSize = 9;
                                // 🔥 Layout padding
                                doc.content[1].layout = {
                                    paddingLeft: function () { return 5; },
                                    paddingRight: function () { return 5; },
                                    paddingTop: function () { return 4; },
                                    paddingBottom: function () { return 4; }
                                };
                            }
                        },
                        {
                            extend: 'excel',
                            text: '<i class="fa fa-file-excel-o" aria-hidden="true"></i> Excel',
                            className: 'btn btn-success'
                        },
                        {
                            extend: 'print',
                            text: '<i class="fa fa-print" aria-hidden="true"></i> Print',
                            className: 'btn btn-primary'
                        },                      
                        {
                            text: '<i class="fa fa-save"></i> Save',
                            className: 'btn btn-warning',
                            action: function () {
                                // Open modal
                                $("#txtFilterName").val("");
                                $("#saveFilterModal").modal("show");
                            }
                        }
                    ],

                    responsive: true,
                    pageLength: 25,
                    lengthChange: false,
                    info: false
                });
            }

        });
    }
    $("#btnSaveFilterFinal").click(function () {
        debugger;
        var filterName = $("#txtFilterName").val().trim();

        if (filterName === "") {
            alert("Please enter filter name ❗");
            return;
        }
        // 🔥 Collect filter data
        var filterData = {
            DateFrom: $("#dateFrom").val(),
            MaterialID: $("#MaterialID").val() || 0,
            ColorID: $("#ColorID").val() || 0,
            GodownID: $("#GodownID").val() || 0,
            LocationID: $("#LocationID").val() || 0,
            BillToID: $("#BillToID").val() || 0,
            ShippedToID: $("#ShippedToID").val() || 0,
            YarnColorCode: $("#YarnColorCode").val() || "",
            BoxNo: $("#BoxNo").val() || "",
            BarcodeNo: $("#BoxNo option:selected").data("barcode") || ""
        };

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/SaveDynamicReport",
            type: "POST",
            data: JSON.stringify({
                ReportName: "YarnStockReport",   // you can make dynamic later
                FilterName: filterName,
                FilterJson: JSON.stringify(filterData)
            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function () {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                Toast.fire({
                    icon: 'success',
                    title: 'Filter saved successfully ✅'
                });
                $("#saveFilterModal").modal("hide");
            },
            error: function () {
                alert("Error saving ❌");
            }
        });

    });
    function ResetFilters() {
        $("#MaterialID").val('0').trigger("change");
        $("#ColorID").val('0').trigger("change");
        $("#GodownID").val('0').trigger("change");
        $("#LocationID").val('0').trigger("change");
        $("#BillToID").val('0').trigger("change");
        $("#ShippedToID").val('0').trigger("change");
        $("#YarnColorCode").val('').trigger("change");
        $("#BoxNo").val('').trigger("change");        
        LoadReport();   
    }
    function OpenFilterModal() {

        $("#loadFilterModal").modal("show");

        var reportName = "YarnStockReport"; // 🔥 dynamic later if needed

        $.ajax({
            url: "/WebServiceNikunjTextile.asmx/GetSavedFilters",
            type: "POST",
            data: JSON.stringify({ ReportName: reportName }), // ✅ pass parameter
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {

                var data = JSON.parse(res.d);

                var tbody = $("#tblFilterList tbody");
                tbody.empty();

                var i = 1;

                data.forEach(function (item) {

                    var row = `<tr>
                    <td>${i}</td>
                    <td>${item.FilterName}</td>
                    <td>
                        <button class="btn btn-sm btn-primary applyFilterBtn"
                            data-json='${item.FilterJson.replace(/'/g, "&apos;")}'>
                            Apply
                        </button>
                    </td>
                </tr>`;

                    tbody.append(row);
                    i++;
                });
            }
        });
    }
    $(document).on("click", ".applyFilterBtn", function () {

        var json = $(this).attr("data-json");
        var filter = JSON.parse(json);

        // 🔥 Apply values
        $("#dateFrom").val(filter.DateFrom);
        $("#MaterialID").val(filter.MaterialID).trigger('change');
        $("#ColorID").val(filter.ColorID).trigger('change');
        $("#GodownID").val(filter.GodownID).trigger('change');
        $("#LocationID").val(filter.LocationID).trigger('change');
        $("#BillToID").val(filter.BillToID).trigger('change');
        $("#ShippedToID").val(filter.ShippedToID).trigger('change');
        $("#YarnColorCode").val(filter.YarnColorCode);
        $("#BoxNo").val(filter.BoxNo).trigger('change');

        // Barcode handle
        if (filter.BarcodeNo) {
            $("#BoxNo option").each(function () {
                if ($(this).data("barcode") == filter.BarcodeNo) {
                    $(this).prop("selected", true);
                }
            });
        }
        // Close modal
        $("#loadFilterModal").modal("hide");
        // 🔥 Load report
        LoadReport()
    });
</script>



