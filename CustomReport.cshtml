        function groupReportData(data) {
            if (!data || !Array.isArray(data) || data.length === 0) return data;

            var keys = Object.keys(data[0]);
            if (keys.length <= 1) return data;

            var metricKeys = [];
            var groupKeys = [];

            // Identify quantity/weight metric columns vs grouping columns
            keys.forEach(function (key, index) {
                var lower = key.toLowerCase();
                var isWeight = lower.indexOf('weight') >= 0 || lower.indexOf('wt') >= 0;
                var isBox = (lower.indexOf('box') >= 0 || lower.indexOf('stock') >= 0 || lower.indexOf('qty') >= 0 || lower.indexOf('pcs') >= 0 || lower.indexOf('count') >= 0)
                            && lower.indexOf('color') < 0 && lower.indexOf('code') < 0;

                if (isWeight || isBox) {
                    metricKeys.push(key);
                } else if (index >= keys.length - 2 && lower.indexOf('color') < 0 && lower.indexOf('name') < 0 && lower.indexOf('party') < 0 && lower.indexOf('material') < 0 && lower.indexOf('godown') < 0 && lower.indexOf('location') < 0) {
                    metricKeys.push(key);
                } else {
                    groupKeys.push(key);
                }
            });

            if (metricKeys.length === 0 && keys.length >= 2) {
                metricKeys = [keys[keys.length - 2], keys[keys.length - 1]];
                groupKeys = keys.slice(0, keys.length - 2);
            }

            var groupedMap = {};
            var groupedList = [];

            data.forEach(function (row) {
                var compositeKey = groupKeys.map(function (k) {
                    return String(row[k] === null || row[k] === undefined ? '' : row[k]).trim().toUpperCase();
                }).join('___');

                if (!groupedMap[compositeKey]) {
                    var newRow = {};
                    keys.forEach(function (k) {
                        newRow[k] = row[k];
                    });
                    metricKeys.forEach(function (mk) {
                        newRow[mk] = parseFloat(row[mk]) || 0;
                    });
                    groupedMap[compositeKey] = newRow;
                    groupedList.push(newRow);
                } else {
                    var existingRow = groupedMap[compositeKey];
                    metricKeys.forEach(function (mk) {
                        var val = parseFloat(row[mk]) || 0;
                        existingRow[mk] = (parseFloat(existingRow[mk]) || 0) + val;
                    });
                }
            });

            // Format metrics: box count as integer if whole number, weight to 2 decimal places
            groupedList.forEach(function (row) {
                metricKeys.forEach(function (mk) {
                    var val = parseFloat(row[mk]) || 0;
                    var lower = mk.toLowerCase();
                    if (lower.indexOf('weight') >= 0 || lower.indexOf('wt') >= 0 || (val % 1 !== 0)) {
                        row[mk] = parseFloat(val.toFixed(2));
                    } else {
                        row[mk] = Math.round(val);
                    }
                });
            });

            return groupedList;
        }

        function LoadReport() {

