                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Mention List Date.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (godownManager === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Select Godown Manager.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }

            let detailList = [];
            let tempYarnMap = JSON.parse(JSON.stringify(globalYarnMap || {}));

            $("#tableYarnOutward tbody tr:visible").each(function () {
                let yarnCompanyId = parseInt($(this).find("#CompanyId").text()) || 0;
                let input = $(this).find(".txtStockInput");
                let qty = parseInt(input.val()) || 0;
                if (qty <= 0) return;
                let key = normalize(input.data("key"));
                let materialId = parseInt(input.data("materialid")) || parseInt(key.split("|")[1]) || 0;
                let colorId = parseInt(input.data("colorid")) || parseInt(key.split("|")[2]) || 0;
                let locationId = parseInt(input.data("locationid")) || 0;
                let yarnData = tempYarnMap[key] || [];

                if (yarnData && yarnData.length > 0) {
                    let remainingQty = qty;
                    for (let i = 0; i < yarnData.length; i++) {
                        let item = yarnData[i];
                        if (item.stock <= 0) continue;
                        let allocate = Math.min(remainingQty, item.stock);
                        if (allocate > 0) {
                            detailList.push({
                                BillToPartyID: partyId,
                                YarnCompanyID: yarnCompanyId,
                                YarnMaterialID: materialId,
                                YarnColorID: colorId,
                                GodownLocationID: locationId,
                                NoOfBox: allocate,
                                YarnRequirementDetailID: item.id
                            });
                            item.stock -= allocate;
                            remainingQty -= allocate;
                        }
                        if (remainingQty <= 0) break;
                    }
                    if (remainingQty > 0) {
                        let fallbackId = yarnData[yarnData.length - 1].id;
                        detailList.push({
                            BillToPartyID: partyId,
                            YarnCompanyID: yarnCompanyId,
                            YarnMaterialID: materialId,
                            YarnColorID: colorId,
                            GodownLocationID: locationId,
                            NoOfBox: remainingQty,
                            YarnRequirementDetailID: fallbackId
                        });
                    }
                } else {
                    let fallbackReqId = pendingDetailMap[key] || 0;
                    detailList.push({
                        BillToPartyID: partyId,
                        YarnCompanyID: yarnCompanyId,
                        YarnMaterialID: materialId,
                        YarnColorID: colorId,
                        GodownLocationID: locationId,
                        NoOfBox: qty,
                        YarnRequirementDetailID: fallbackReqId
                    });
                }
            });

            // Consolidate duplicate rows for same location, material, color, company
            let consolidatedMap = {};
            for (let i = 0; i < detailList.length; i++) {
                let d = detailList[i];
                let dKey = `${d.GodownLocationID}_${d.YarnMaterialID}_${d.YarnColorID}_${d.YarnCompanyID}_${d.BillToPartyID}`;
                if (!consolidatedMap[dKey]) {
                    consolidatedMap[dKey] = Object.assign({}, d);
                } else {
                    consolidatedMap[dKey].NoOfBox += d.NoOfBox;
                    if ((!consolidatedMap[dKey].YarnRequirementDetailID || consolidatedMap[dKey].YarnRequirementDetailID <= 0) && d.YarnRequirementDetailID > 0) {
                        consolidatedMap[dKey].YarnRequirementDetailID = d.YarnRequirementDetailID;
                    }
                }
            }
            detailList = Object.values(consolidatedMap);

            if (detailList.length === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Enter at least one quantity",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }

            let formattedDate = formatDateToISO($("#ListDate").val());
            if (!formattedDate) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Invalid List Date.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }

            let master = {
                GodownID: godownId,
                PartyId: partyId,
                OutwardListDate: formattedDate,
                GodownManagerUserAccountId: godownManager,
                SundryPartyID: sundrypartyid
            };

            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/SavedataYarnOutward",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    master: master,
                    detail: detailList
                }),
                success: function (res) {
                    let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;
                    let data = Array.isArray(result) ? result[0] : result;

                    if (data && data.Status == 1) {
                        Swal.fire({
                            title: 'Success!',
                            text: data.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = 'YarnOutWardChallanDetails';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: data.Message || "Error saving data",
                            icon: 'error'
                        });
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                    Swal.fire({
                        title: 'Server Error',
                        text: 'An error occurred while saving.',
                        icon: 'error'
                    });
                }
            });
        }

        $(document).on("change", ".row-checkbox", function () {
            let currentChk = $(this);
            let key = normalize(currentChk.data("key"));

            let inputs = $(".txtStockInput").filter(function () {
                let inpKey = normalize($(this).data("key"));
                return inpKey === key;
            });

            let maxCapacity = 0;
            inputs.each(function () {
                maxCapacity += parseInt($(this).data("stock")) || 0;
            });

            let selectedStock = 0;
            $(".row-checkbox:checked").not(currentChk).each(function () {
                let chk = $(this);
                let chkKey = normalize(chk.data("key"));
                if (chkKey === key) {
                    selectedStock += parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                }
            });

            let currentStock = parseInt(currentChk.closest("tr").find("td:eq(5)").text()) || 0;

            if (currentChk.is(":checked")) {
                let tempTotal = selectedStock + currentStock;
                let usableTemp = Math.min(tempTotal, maxCapacity);

                if (usableTemp <= selectedStock) {
                    currentChk.prop("checked", false);
                    Swal.fire({
                        icon: "warning",
                        title: "Limit Reached",
                        text: "Stock already fully allocated!"
                    });
                    return;
                }
            }

            let selectedData = [];
            $(".row-checkbox:checked").each(function () {
                let chk = $(this);
                let chkKey = normalize(chk.data("key"));
                if (chkKey === key) {
                    let stock = parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                    let detailId = parseInt(chk.data("detailid")) || parseInt(chk.data("reqid")) || parseInt(chk.val()) || 0;
                    selectedData.push({
                        id: detailId,
                        stock: stock
                    });
                }
            });

            globalYarnMap[key] = selectedData;

            let totalStock = selectedData.reduce((sum, x) => sum + x.stock, 0);
            let usableStock = Math.min(totalStock, maxCapacity);
            let totalFilled = 0;

            inputs.val(0);
            inputs.each(function () {
                let input = $(this);
                let max = parseInt(input.data("stock")) || 0;
                let remaining = usableStock - totalFilled;

                if (remaining <= 0) {
                    input.val(0);
                    return;
                }

                let fill = Math.min(max, remaining);
                input.val(fill);
                input.data("old", fill);
                totalFilled += fill;
            });

            highlightMatchedYarnRows();
        });
    </script>
}