@{
    Layout = "/_LayoutPage1.cshtml";
}




<style>
    #tableYarnOutward th {
        font-size: 13px;
        font-weight: 600;
        vertical-align: middle !important;
        white-space: nowrap;
        background-color: #f1f4f8;
        border-bottom: 2px solid #dee2e6;
    }
    #tableYarnOutward td {
        font-size: 13px;
        vertical-align: middle !important;
    }
    #tableYarnOutward .txtStockInput {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 4px;
        transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
    }
    #tableYarnOutward .txtStockInput:focus {
        border-color: #80bdff;
        outline: 0;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, .25);
        background-color: #fffde7;
    }
    #tableYarnOutward tr.table-success td {
        background-color: #e8f5e9 !important;
    }
</style>

<div class="content-wrapper">
    <div class="row gutters">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div class="form-section-header">Yarn Outward List</div>
                    <div id="notes"></div>

                    <!-- Top Section: Filters (Left) & Pending Table (Right) -->
                    <div class="row gutters pb-3 mb-3 border-bottom">
                        <!-- Left: Form Controls -->
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <!-- Row 1: ListNo, ListDate, GodownManager, PartyType -->
                            <div class="row gutters">
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-6">
                                    <div class="field-wrapper">
                                        <input type="text" class="form-control" id="ListNo" placeholder="List No" value="1" readonly />
                                        <div class="field-placeholder">List No<sup style="color:red;">*</sup></div>
                                        <div class="ListNo-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ListNo-invalid-feedback invalid-feedback">Please Mention List No</div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-6">
                                    <div class="field-wrapper">
                                        <input type="text" class="form-control datepicker" id="ListDate" placeholder="List Date" value="1" />
                                        <div class="field-placeholder">List Date<sup style="color:red;">*</sup></div>
                                        <div class="ListDate-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ListDate-invalid-feedback invalid-feedback">Please Mention List Date</div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnGodownManager" class="select-single detail form-control" title="Select Yarn Godown Manager" data-live-search="true">
                                            <option value="-1">Yarn Godown Manager</option>
                                        </select>
                                        <div class="field-placeholder">Godown Manager<sup style="color:red;">*</sup></div>
                                        <div class="ddlYarnGodownManager-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ddlYarnGodownManager-invalid-feedback invalid-feedback">Please Select Godown Manager</div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="SundryParty" class="form-control" name="SundryParty" onchange="changeSundryParty(this.value)" disabled>
                                            <option value="1">Sundry Creditors</option>
                                            <option value="2">Sundry Debtors</option>
                                            <option value="3" selected>Job Work</option>
                                        </select>
                                        <div class="field-placeholder">Party Type</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 2: Godown, Party, YarnCompany -->
                            <div class="row gutters">
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlGodownMaster" class="select-single detail form-control" title="Select Godown Master" data-live-search="true" onchange="ChangeGodownMaster()">
                                            <option value="-1">Select Godown</option>
                                        </select>
                                        <div class="field-placeholder">Select Godown<sup style="color:red;">*</sup></div>
                                        <div class="ddlGodownMaster-valid-feedback valid-feedback"></div>
                                        <div class="ddlGodownMaster-invalid-feedback invalid-feedback">Please Select Godown</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlParty" class="select-single detail form-control" title="Select Party" data-live-search="true" onchange="partyChange()">
                                            <option value="-1">Select Party</option>
                                        </select>
                                        <div class="field-placeholder">Sundry Party<sup style="color:red;">*</sup></div>
                                        <div class="ddlParty-valid-feedback valid-feedback">Looks good!</div>
                                        <div class="ddlParty-invalid-feedback invalid-feedback">Please Select Sundry Creditors Party</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnCompany" class="select-single detail form-control" title="Select Yarn Company" data-live-search="true" onchange="ChangeYarnCompany()">
                                            <option value="-1">Select Yarn Company</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Company</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 3: YarnMaterial, YarnColor, YarnColorCode -->
                            <div class="row gutters">
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnMaterial" class="select-single detail form-control" title="Select Yarn Material" data-live-search="true" onchange="reloadYarnFlow()">
                                            <option value="-1">Yarn Material</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Material</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnColor" class="select-single detail form-control" title="Select Yarn Color" data-live-search="true" onchange="ChangeYarnColor(this.value)">
                                            <option value="-1">Yarn Color</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Color</div>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="field-wrapper">
                                        <select id="ddlYarnColorCode" class="select-single detail form-control" title="Select Yarn Color Code" data-live-search="true" onchange="ChangeYarnColorCode(this.value)">
                                            <option value="-1">Yarn Color Code</option>
                                        </select>
                                        <div class="field-placeholder">Yarn Color Code</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Pending Yarn Table -->
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12" style="border-left: 1px solid #dee2e6;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fa fa-list-alt me-1"></i> Pending Yarn Requirements
                                </h6>
                            </div>
                            <div class="col-12" hidden>
                                <div class="field-wrapper">
                                    <select id="ddlYarnPREQ" class="select-single detail form-control" title="Select Yarn Pending Requirement" data-live-search="true">
                                        <option value="-1">Yarn Pending Requirement</option>
                                    </select>
                                    <div class="field-placeholder">Yarn Pending Requirement</div>
                                    <div class="ddlYarnPREQ-valid-feedback valid-feedback">Looks good!</div>
                                    <div class="ddlYarnPREQ-invalid-feedback invalid-feedback">Please Select Yarn Pending Requirement</div>
                                </div>
                            </div>
                            <div class="table-responsive border rounded" style="max-height: 250px; overflow-y: auto;">
                                <table class="table table-bordered table-striped table-hover align-middle mb-0" id="pendingYarnTable">
                                    <thead style="background-color: #f1f4f8; position: sticky; top: 0; z-index: 2;">
                                        <tr class="text-center align-middle">
                                            <th style="width: 125px;">Select / Req</th>
                                            <th class="text-left" style="min-width: 120px;">Party</th>
                                            <th class="text-left" style="min-width: 110px;">Yarn Material</th>
                                            <th class="text-left" style="min-width: 100px;">Yarn Color</th>
                                            <th style="width: 100px;">Color Code</th>
                                            <th style="width: 110px;">No of Boxes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">Select Party to view pending requirements</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Section: Stock Outward Table -->
                    <div class="row gutters mt-3">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="m-0 font-weight-bold text-primary">
                                    <i class="fa fa-cubes me-1"></i> Available Godown Stock & Outward Allocation
                                </h6>
                            </div>
                            <input type="hidden" id="siftYarnInwardDetailID" class="form-control" placeholder="Yarn Inward DetailI D" title="YarnInwardDetailID" />
                            <input type="hidden" id="siftGodownInputBox" class="form-control" placeholder="Godown Input Box" title="Godown Input Box" />
                            <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto;">
                                <table id="tableYarnOutward" class="table table-bordered table-striped table-hover align-middle mb-0">
                                    <thead style="position: sticky; top: 0; z-index: 2; background-color: #f8f9fa;">
                                        <tr class="text-center align-middle">
                                            <th style="width: 50px;">#</th>
                                            <th class="text-left" style="min-width: 170px;">Company Name</th>
                                            <th class="text-left" style="min-width: 140px;">Yarn Material</th>
                                            <th class="text-left" style="min-width: 120px;">Yarn Color</th>
                                            <th style="width: 110px;">Color Code</th>
                                            <th style="width: 130px;">Stock (Boxes)</th>
                                            <th class="text-left" style="min-width: 130px;">Location Title</th>
                                            <th style="width: 140px;">No Of Box(Editable)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-3">Select Godown to load available yarn stock</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-end mt-3">
                        <a href="YarnOutWardChallanDetails" class="btn btn-light me-2">
                            <i class="fa fa-arrow-left"></i> Back
                        </a>

                        <button id="savebtn" class="btn btn-primary" onclick="saveYarnOutward()">
                            Save Yarn OutWard
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script>

        $('body').addClass('fullscreen');
        var currentPagePermission = {};
        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                var currentPagePermission = JSON.parse(permission);
                if (currentPagePermission.Add == false) {
                    $("#savebtn").hide();
                }
            }
            let today = new Date();

            let day = String(today.getDate()).padStart(2, '0');
            let month = String(today.getMonth() + 1).padStart(2, '0');
            let year = today.getFullYear();

            let formattedDate = `${day}/${month}/${year}`;

            $("#ListDate").val(formattedDate);
            var liSelected;
            $(document).keydown(function (key) {
                var li = $('li');
                switch (parseInt(key.which, 10)) {

                    case 27:
                        $("#DivDDLItemDetail").hide();
                        $("#DivAddItem").show();
                        //Esc Key
                        $("#CloseItemModel").click();
                        $("#cancelbtn").click();
                        $("#cancelItembtn").click();
                        break;

                    case 40:
                        if (liSelected) {
                            liSelected.removeClass('selected');
                            next = liSelected.next();
                            if (next.length > 0) {
                                liSelected = next.addClass('selected');
                            } else {
                                liSelected = li.eq(0).addClass('selected');
                            }
                        } else {
                            liSelected = li.eq(0).addClass('selected');
                        }
                        break;

                    case 38:
                        if (liSelected) {
                            liSelected.removeClass('selected');
                            next = liSelected.prev();
                            if (next.length > 0) {
                                liSelected = next.addClass('selected');
                            } else {
                                liSelected = li.last().addClass('selected');
                            }
                        } else {
                            liSelected = li.last().addClass('selected');
                        }
                        break;

                    default:
                        break;
                }
            });
            FunctionIsLogin();
            $("#select2-ddlGodownMaster-container").css("background-color", "cornflowerblue");
            $("#select2-ddlGodownMaster-container").css("color", "white");
            $('#ddlGodownMaster').next('.select2-container').find('.select2-selection__arrow b').css({ 'border-color': '#fff transparent transparent transparent' });
            $("#select2-ddlParty-container").css("background-color", "lightslategrey");
            $("#select2-ddlParty-container").css("color", "white");
            $('#ddlParty').next('.select2-container').find('.select2-selection__arrow b').css({ 'border-color': '#fff transparent transparent transparent' });
            $("#select2-ddlYarnGodownManager-container").css("background-color", "cornflowerblue");
            $("#select2-ddlYarnGodownManager-container").css("color", "white");
            $('#ddlYarnGodownManager').next('.select2-container').find('.select2-selection__arrow b').css({ 'border-color': '#fff transparent transparent transparent' });
            $("#SundryParty").val("3").prop("disabled", true);
            GetAllDropDownData();
        });

        var isColorLoaded = false;
        let globalYarnMap = {};
        let selectionOrderMap = {};
        let pendingDetailMap = {};
        let pendingItemWise = {};
        let isPendingAvailable = false;
        let yarnReloadTimer = null;

        function normalize(val) { return (val || "").toString().toUpperCase().trim(); }
        function makeKey(company, materialId, colorId, colorCode) {
            return normalize(company) + "|" + (parseInt(materialId, 10) || 0) + "|" + (parseInt(colorId, 10) || 0) + "|" + normalize(colorCode);
        }

        function reloadYarnFlow() {
            clearTimeout(yarnReloadTimer);
            yarnReloadTimer = setTimeout(function () {
                loadAllYarnData();
            }, 60);
        }

        function resetYarnFilters() {
            $("#ddlYarnCompany").val("0");
            $("#select2-ddlYarnCompany-container").html("Select Company").attr('title', 'Select Company');

            $("#ddlYarnMaterial").val("0");
            $("#select2-ddlYarnMaterial-container").html("Select Yarn Material").attr('title', 'Select Yarn Material');

            $("#ddlYarnColor").val("0");
            $("#select2-ddlYarnColor-container").html("Select Yarn Color").attr('title', 'Select Yarn Color');

            $("#ddlYarnColorCode").val("0");
            $("#select2-ddlYarnColorCode-container").html("Yarn Color Code").attr('title', 'Yarn Color Code');
        }

        function partyChange() {
            resetYarnFilters();
            loadColorCodesForColor(0);
            reloadYarnFlow();
        }

        $("#ddlGodownMaster, #ddlYarnMaterial").off("change.yarnFlow").on("change.yarnFlow", function () {
            reloadYarnFlow();
        });
        $("#ddlYarnCompany").off("change.yarnFlow").on("change.yarnFlow", function () {
            ChangeYarnCompany();
        });

        $(document).on("focus", ".txtStockInput", function () {
            $(this).data("old", parseInt($(this).val()) || 0);
        });

        $(document).on("input", ".txtStockInput", function () {
            let input = $(this);

            let stock = parseInt(input.data("stock")) || 0;
            let newVal = parseInt(input.val()) || 0;
            let oldVal = input.data("old") || 0;

            let key = normalize(input.data("key"));

            // ❌ NO PENDING → STOCK RULE
            if (!isPendingAvailable) {
                if (newVal > stock) {
                    input.val(stock);
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: "Cannot exceed stock (" + stock + ")",
                        showConfirmButton: false,
                        timer: 2000
                    });
                    return;
                }
                input.data("old", newVal);
                return;
            }

            // ✅ PENDING MODE - Exact match on Company, Material, Color, and Color Code
            let maxAllowed = parseInt(pendingItemWise[key]) || 0;
            let total = 0;

            $(".txtStockInput").each(function () {
                let loopKey = normalize($(this).data("key"));
                if (loopKey === key) {
                    let val = parseInt($(this).val()) || 0;
                    if (this === input[0]) {
                        val = newVal;
                    }
                    total += val;
                }
            });

            // ❌ EXCEED PENDING
            if (maxAllowed > 0 && total > maxAllowed) {
                input.val(oldVal);
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Max allowed for this item: " + maxAllowed,
                    showConfirmButton: false,
                    timer: 2000
                });
                return;            
            } else {
                if (newVal > stock) {
                    input.val(stock);
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: "Cannot exceed stock (" + stock + ")",
                        showConfirmButton: false,
                        timer: 2000
                    });
                    return;
                }
                input.data("old", newVal);
            }
        });

        function formatJsonDate(jsonDate) {
            if (!jsonDate) return "";
            let timestamp = parseInt(jsonDate.replace(/[^0-9]/g, ''));
            let date = new Date(timestamp);

            let day = ("0" + date.getDate()).slice(-2);
            let month = ("0" + (date.getMonth() + 1)).slice(-2);
            let year = date.getFullYear();

            return `${day}-${month}-${year}`;
        }

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: request.statusText || 'Failed to fetch default company',
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#Updatebtn").hide();
            $("#addNewContactLabel").html("Add Design Entry Form");
            $("#add-alert").hide();
            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function validate(code) {
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback, .valid-feedback").hide();

            if (code.value == "0" || code.value == "") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }

        function GetAllDropDownData() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutWardDropDownData',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        changeSundryParty($("#SundryParty").val());

                        if (response.listCompanyMaster.length > 0) {
                            $('#ddlYarnCompany').empty();
                            var tempPartyName = "<option value='0'> Select Company </option>";
                            $('#ddlYarnCompany').append(tempPartyName);
                            var seenCompanies = {};
                            for (var i = 0; i < response.listCompanyMaster.length; i++) {
                                var cpId = response.listCompanyMaster[i].PartyId;
                                var cpName = (response.listCompanyMaster[i].PartyName || "").trim();
                                if (!seenCompanies[cpId] && cpName) {
                                    seenCompanies[cpId] = true;
                                    $('#ddlYarnCompany').append("<option value='" + cpId + "'> " + cpName + " </option>");
                                }
                            }
                        }
                        else {
                            $('#ddlYarnCompany').empty();
                            $("#ddlYarnCompany").prop('disabled', true);
                        }

                        if (response.listYarnMaterialMaster.length > 0) {
                            $('#ddlYarnMaterial').empty();
                            var tempPartyName = "<option value='0'> Select Yarn Material </option>";
                            $('#ddlYarnMaterial').append(tempPartyName);
                            var seenMaterials = {};
                            for (var i = 0; i < response.listYarnMaterialMaster.length; i++) {
                                var ymId = response.listYarnMaterialMaster[i].YarnMaterialID;
                                var ymName = (response.listYarnMaterialMaster[i].YarnMaterial || "").trim();
                                if (!seenMaterials[ymId] && ymName) {
                                    seenMaterials[ymId] = true;
                                    $('#ddlYarnMaterial').append("<option value='" + ymId + "'> " + ymName + " </option>");
                                }
                            }
                        }
                        else {
                            $('#ddlYarnMaterial').empty();
                            $("#ddlYarnMaterial").prop('disabled', true);
                        }

                        if (response.listYarnColorMaster.length > 0) {
                            $('#ddlYarnColor').empty();
                            var tempPartyName = "<option value='0'> Select Yarn Color </option>";
                            $('#ddlYarnColor').append(tempPartyName);

                            var seenColors = {};

                            for (var i = 0; i < response.listYarnColorMaster.length; i++) {
                                var cItem = response.listYarnColorMaster[i];
                                var cid = cItem.YarnColorID;
                                var cName = (cItem.YarnColor || "").trim();

                                if (!cid || cid <= 0) continue;

                                var nameKey = cName.toUpperCase();
                                if (nameKey && !seenColors[nameKey]) {
                                    seenColors[nameKey] = true;
                                    $('#ddlYarnColor').append("<option value='" + cid + "'> " + cName + " </option>");
                                }
                            }
                            $('#ddlYarnColor').val('0');
                            $('#select2-ddlYarnColor-container').html('Select Yarn Color').attr('title', 'Select Yarn Color');

                            loadColorCodesForColor(0);
                        }
                        else {
                            $('#ddlYarnColor').empty();
                            $('#ddlYarnColorCode').empty();
                            $("#ddlYarnColor").prop('disabled', true);
                            $("#ddlYarnColorCode").prop('disabled', true);
                        }

                        if (response.listUserAccountMaster.length > 0) {
                            $('#ddlYarnGodownManager').empty();
                            var tempPartyName = "<option value='0'> Select Godown Manager </option>";
