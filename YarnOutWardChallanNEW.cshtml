    function GridBindData(callback) {
        var GodownID = $("#ddlGodownMaster").val() || 0;
        var BillToPartyID = $("#ddlYarnCompany").val() || 0;
        var YarnMaterialID = $("#ddlYarnMaterial").val() || 0;
        var YarnColorID = $("#ddlYarnColor").val() || 0;
        var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val() || 0;
        var siftSiftGodownLocationId = $("#siftGodownInputBox").val();
        if (GodownID != "0") {
            var formData = new FormData();
            formData.append('GodownID', GodownID);
            formData.append('BillToPartyID', BillToPartyID);
            formData.append('YarnMaterialID', YarnMaterialID);
            formData.append('YarnColorID', YarnColorID);
            formData.append('SiftGodownLocationId', siftSiftGodownLocationId.slice(0, -1).replace(/\|/g, ','));
            let tbody = $("#pendingYarnTable tbody");
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutwardMasterNew',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
              
                success: function (response) {

                    let data = response.listYarnOutwardMaster;
                    let tbody = $("#tableYarnOutward tbody");
                    tbody.empty();

                    if (!data || data.length === 0) {
                        tbody.html('<tr><td colspan="8" class="text-center">No Data Found</td></tr>');
                        if (callback) callback();
                        return;
                    }

                    $.each(data, function (index, row) {

                        let key =
                            row.YarnMaterialID + "|" +
                            row.YarnColorID + "|" +
                            normalize(row.YarnColorCode);

                        let tr = `
                        <tr>
                            <td class="rowIndex">${index + 1}</td>
                            <td>${row.CompanyName}</td>
                            <td>${row.YarnMaterial}</td>
                            <td>${row.YarnColor}</td>
                            <td>${row.YarnColorCode}</td>
                            <td>${row.Stock}</td>
                            <td>${row.LocationTitle}</td>
                            <td>
                                <input type="text"
                                    class="txtStockInput"
                                    value="0"
                                    data-key="${key}"
                                    data-stock="${row.Stock}"
                                    data-locationid="${row.GodownLocationID}"
                                    maxlength="2"
                                    onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                            </td>
                        </tr>
                    `;

                        tbody.append(tr);
                    });
                    if (callback) callback(); // ✅ VERY IMPORTANT
                },
                error: function () {
                    tbody.html('<tr><td colspan="7" class="text-danger text-center">Error loading data</td></tr>');
                    if (callback) callback();
                }
            });
        }
    }
