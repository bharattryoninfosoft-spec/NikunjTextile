</div>



@section Scripts{
    <script>

        $('body').addClass('fullscreen');
        var currentPagePermission = {};
        $(document).ready(function () {
            var permission = getCookie("PagePermission");
            if (permission != null && permission != "") {
                var currentPagePermission = JSON.parse(permission);
                if (currentPagePermission.Add == false) {
                    $("#savebtn").hide();
                }
            }
            let today = new Date();

            let day = String(today.getDate()).padStart(2, '0');
            let month = String(today.getMonth() + 1).padStart(2, '0');
            let year = today.getFullYear();

            let formattedDate = `${day}/${month}/${year}`;

            $("#ListDate").val(formattedDate);
            var liSelected;
            $(document).keydown(function (key) {
                var li = $('li');
                switch (parseInt(key.which, 10)) {

                    case 27:
                        $("#DivDDLItemDetail").hide();
                        $("#DivAddItem").show();
                        //Esc Key
                        $("#CloseItemModel").click();
                        $("#cancelbtn").click();
                        $("#cancelItembtn").click();
                        break;

                    case 40:
                        if (liSelected) {
                            liSelected.removeClass('selected');
                            next = liSelected.next();
                            if (next.length > 0) {
                                liSelected = next.addClass('selected');
                            } else {
                                liSelected = li.eq(0).addClass('selected');
                            }
                        } else {
                            liSelected = li.eq(0).addClass('selected');
                        }
                        break;

                    case 38:
                        if (liSelected) {
                            liSelected.removeClass('selected');
                            next = liSelected.prev();
                            if (next.length > 0) {
                                liSelected = next.addClass('selected');
                            } else {
                                liSelected = li.last().addClass('selected');
                            }
                        } else {
                            liSelected = li.last().addClass('selected');
                        }
                        break;

                    default:
                        break;
                }
            });
            FunctionIsLogin();
            $("#select2-ddlGodownMaster-container").css("background-color", "cornflowerblue");
            $("#select2-ddlGodownMaster-container").css("color", "white");
            $('#ddlGodownMaster').next('.select2-container').find('.select2-selection__arrow b').css({ 'border-color': '#fff transparent transparent transparent' });
            $("#select2-ddlParty-container").css("background-color", "lightslategrey");
            $("#select2-ddlParty-container").css("color", "white");
            $('#ddlParty').next('.select2-container').find('.select2-selection__arrow b').css({ 'border-color': '#fff transparent transparent transparent' });
            $("#select2-ddlYarnGodownManager-container").css("background-color", "cornflowerblue");
            $("#select2-ddlYarnGodownManager-container").css("color", "white");
            $('#ddlYarnGodownManager').next('.select2-container').find('.select2-selection__arrow b').css({ 'border-color': '#fff transparent transparent transparent' });
            GetAllDropDownData();
        });

        var isColorLoaded = false;
        let pendingDetailMap = {};
        let pendingItemWise = {};
        let isPendingAvailable = false;

        function normalize(val) { return (val || "").toString().trim(); }
        function makeKey(material, color, code) {
            return normalize(material) + "|" + normalize(color) + "|" + normalize(code);
        }

        $("#ddlGodownMaster, #ddlYarnCompany, #ddlYarnMaterial").on("change", function () {
            isColorLoaded = false;   // reset flag
            GridBindData();
        });

        $("#ddlParty, #ddlYarnMaterial, #ddlYarnColor").on("change", function () {
            var PartyId = $("#ddlParty").val();
            var YarnMaterialID = $("#ddlYarnMaterial").val() || 0;
            var YarnColorID = $("#ddlYarnColor").val() || 0;
            loadAllYarnData(PartyId, YarnMaterialID, YarnColorID);
        });

        $(document).on("focus", ".txtStockInput", function () {
            $(this).data("old", parseInt($(this).val()) || 0);
        });

        $(document).on("input", ".txtStockInput", function () {
            let input = $(this);

            let stock = parseInt(input.data("stock")) || 0;
            let newVal = parseInt(input.val()) || 0;
            let oldVal = input.data("old") || 0;

            let key = normalize(input.data("key"));

            // ❌ NO PENDING → STOCK RULE
            if (!isPendingAvailable) {
                if (newVal > stock) {
                    input.val(stock);
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: "Cannot exceed stock (" + stock + ")",
                        showConfirmButton: false,
                        timer: 2000
                    });
                    return;
                }
                input.data("old", newVal);
                return;
            }

            // ✅ PENDING MODE
            let maxAllowed = parseInt(pendingItemWise[key]) || 0;
            let total = 0;

            $(".txtStockInput").each(function () {
                let loopKey = normalize($(this).data("key"));
                if (loopKey === key) {
                    let val = parseInt($(this).val()) || 0;
                    if (this === input[0]) {
                        val = newVal;
                    }
                    total += val;
                }
            });

            // ❌ EXCEED PENDING
            if (total > maxAllowed) {
                input.val(oldVal);
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Max allowed for this item: " + maxAllowed,
                    showConfirmButton: false,
                    timer: 2000
                });
            } else {
                if (newVal > stock) {
                    input.val(stock);
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: "Cannot exceed stock (" + stock + ")",
                        showConfirmButton: false,
                        timer: 2000
                    });
                    return;
                }
                input.data("old", newVal);
            }
        });

        function formatJsonDate(jsonDate) {
            if (!jsonDate) return "";
            let timestamp = parseInt(jsonDate.replace(/[^0-9]/g, ''));
            let date = new Date(timestamp);

            let day = ("0" + date.getDate()).slice(-2);
            let month = ("0" + (date.getMonth() + 1)).slice(-2);
            let year = date.getFullYear();

            return `${day}-${month}-${year}`;
        }

        function getDefaultCompany() {
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getCompanyMasterDefault',
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 200 || response.Code == "200") {
                        $("#company-id").val(response.listCompanyMaster[0].CompanyId);
                        $("#company-default").html(response.listCompanyMaster[0].CompanyName);
                    }
                },
                error: function (request, status, error) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: request.statusText || 'Failed to fetch default company',
                        showConfirmButton: false,
                        timer: 3000
                    });
                }
            });
        }

        function FunctionIsLogin() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/checkLoginStatus',
                data: "{ 'userName':'0' }",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function logout() {
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/Logout',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data, status) {
                    if (data.d == "done") {
                        window.location.replace("/Index");
                    }
                },
                error: function (request, status, error) {
                }
            });
        }

        function clearAll() {
            getDefaultCompany();
            $("#savebtn").show();
            $("#Updatebtn").hide();
            $("#addNewContactLabel").html("Add Design Entry Form");
            $("#add-alert").hide();
            $("#YarnColor").val('');
            $(".company-invalid-feedback").hide();
            $(".clear-field").removeClass("is-valid is-invalid");
            $(".invalid-feedback").hide();
            $(".valid-feedback").hide();
        }

        function validate(code) {
            var errorMessageValid = "." + code.id + "-valid-feedback";
            var errorMessageInvalid = "." + code.id + "-invalid-feedback";
            $(".invalid-feedback, .valid-feedback").hide();

            if (code.value == "0" || code.value == "") {
                document.getElementById(code.id).classList.remove("is-valid");
                document.getElementById(code.id).classList.add("is-invalid");
                $(errorMessageInvalid).show();
                return false;
            }
            else {
                document.getElementById(code.id).classList.add("is-valid");
                document.getElementById(code.id).classList.remove("is-invalid");
                $(errorMessageValid).show();
                $(errorMessageInvalid).hide();
                $(".company-invalid-feedback").show();
                return true;
            }
        }

        function GetAllDropDownData() {
            var formData = new FormData();
            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/getYarnOutWardDropDownData',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == "200") {
                        if (response.listPartyMaster.length > 0) {
                            $('#ddlParty').empty();
                            var tempPartyName = "<option value='0'> Select Party </option>";
                            $('#ddlParty').append(tempPartyName);
                            for (var i = 0; i < response.listPartyMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listPartyMaster[i].PartyId + "'> " + response.listPartyMaster[i].PartyName + " </option>";
                                $('#ddlParty').append(tempPartyName);
                            }
                        }
                        else {
                            $('#ddlParty').empty();
                            $("#ddlParty").prop('disabled', true);
                        }

                        if (response.listCompanyMaster.length > 0) {
                            $('#ddlYarnCompany').empty();
                            var tempPartyName = "<option value='0'> Select Company </option>";
                            $('#ddlYarnCompany').append(tempPartyName);
                            for (var i = 0; i < response.listCompanyMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listCompanyMaster[i].PartyId + "'> " + response.listCompanyMaster[i].PartyName + " </option>";
                                $('#ddlYarnCompany').append(tempPartyName);
                            }
                        }
                        else {
                            $('#ddlYarnCompany').empty();
                            $("#ddlYarnCompany").prop('disabled', true);
                        }

                        if (response.listYarnMaterialMaster.length > 0) {
                            $('#ddlYarnMaterial').empty();
                            var tempPartyName = "<option value='0'> Select Yarn Material </option>";
                            $('#ddlYarnMaterial').append(tempPartyName);
                            for (var i = 0; i < response.listYarnMaterialMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listYarnMaterialMaster[i].YarnMaterialID + "'> " + response.listYarnMaterialMaster[i].YarnMaterial + " </option>";
                                $('#ddlYarnMaterial').append(tempPartyName);
                            }
                        }
                        else {
                            $('#ddlYarnMaterial').empty();
                            $("#ddlYarnMaterial").prop('disabled', true);
                        }

                        if (response.listYarnColorMaster.length > 0) {
                            $('#ddlYarnColor').empty();
                            $('#ddlYarnColorCode').empty();
                            var tempPartyName = "<option value='0'> Select Yarn Color </option>";
                            $('#ddlYarnColor').append(tempPartyName);
                            $('#ddlYarnColorCode').append("<option value='0'> Yarn Color Code</option>");
                            for (var i = 0; i < response.listYarnColorMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listYarnColorMaster[i].YarnColorID + "'> " + response.listYarnColorMaster[i].YarnColor + " </option>";
                                $('#ddlYarnColor').append(tempPartyName);
                                $('#ddlYarnColorCode').append("<option value='" + response.listYarnColorMaster[i].YarnColorID + "'> " + response.listYarnColorMaster[i].YarnColorCode + " </option>");
                            }
                        }
                        else {
                            $('#ddlYarnColor').empty();
                            $('#ddlYarnColorCode').empty();
                            $("#ddlYarnColor").prop('disabled', true);
                            $("#ddlYarnColorCode").prop('disabled', true);
                        }

                        if (response.listUserAccountMaster.length > 0) {
                            $('#ddlYarnGodownManager').empty();
                            var tempPartyName = "<option value='0'> Select Godown Manager </option>";
                            $('#ddlYarnGodownManager').append(tempPartyName);
                            for (var i = 0; i < response.listUserAccountMaster.length; i++) {
                                tempPartyName = "<option value='" + response.listUserAccountMaster[i].UserAccountId + "'> " + response.listUserAccountMaster[i].UserAccountName + " </option>";
                                $('#ddlYarnGodownManager').append(tempPartyName);
                            }
                        }
                        else {
                            $('#ddlYarnGodownManager').empty();
                            $("#ddlYarnGodownManager").prop('disabled', true);
                        }

                        if (response.listGodownMaster.length > 0) {
                            $('#ddlGodownMaster').empty();
                            var tempPartyName = "<option value='0'> Select Godown </option>";
                            $('#ddlGodownMaster').append(tempPartyName);
                            for (var i = 0; i < response.listGodownMaster.length; i++) {
                                if (response.listGodownMaster[i].IsDefault == "1") {
