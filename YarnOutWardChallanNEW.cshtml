        function Yrancolor(list) {
            var selectedColor = $("#ddlYarnColor").val();
            $('#ddlYarnColor').empty();
            $('#ddlYarnColorCode').empty();
            $('#ddlYarnColor').append("<option value='0'>Select Yarn Color</option>");
            $('#ddlYarnColorCode').append("<option value='0'>Yarn Color Code</option>");

            var uniqueColors = {};
            for (var i = 0; i < list.length; i++) {
                var colorID = list[i].YarnColorID;
                if (!uniqueColors[colorID]) {
                    $('#ddlYarnColor').append("<option value='" + colorID + "'>" + list[i].YarnColor + "</option>");
                    $('#ddlYarnColorCode').append("<option value='" + colorID + "'>" + list[i].YarnColorCode + "</option>");
                    uniqueColors[colorID] = true;
                }
            }
            $("#ddlYarnColor").val(selectedColor);
            $("#ddlYarnColorCode").val(selectedColor);
        }

        function YarnMaterial(list) {
            var selectedColor = $("#ddlYarnMaterial").val();
            $('#ddlYarnMaterial').empty();
            $('#ddlYarnMaterial').append("<option value='0'>Select Yarn Material</option>");
            var uniqueColors = {};

            for (var i = 0; i < list.length; i++) {
                var YarnMaterialID = list[i].YarnMaterialID;
                if (!uniqueColors[YarnMaterialID]) {
                    $('#ddlYarnMaterial').append("<option value='" + YarnMaterialID + "'>" + list[i].YarnMaterial + "</option>");
                    uniqueColors[YarnMaterialID] = true;
                }
            }
            $("#ddlYarnMaterial").val(selectedColor);
        }

        function ChangeGodownMaster() {
            GridBindData();
        }

        function ChangeYarnColorCode(YarnColorID) {
            $("#ddlYarnColor").val(YarnColorID);
            var Color = $("#ddlYarnColor option:selected").text();
            $("#select2-ddlYarnColor-container").html(Color);
            GridBindData();
