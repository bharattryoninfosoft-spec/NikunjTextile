        }

        function GridBindData(callback) {
            var GodownID = $("#ddlGodownMaster").val() || 0;
            var BillToPartyID = $("#ddlYarnCompany").val() || 0;
            var YarnMaterialID = $("#ddlYarnMaterial").val() || 0;
            var YarnColorID = $("#ddlYarnColor").val() || 0;
            var siftYarnInwardDetailID = $("#siftYarnInwardDetailID").val() || 0;
            var siftSiftGodownLocationId = $("#siftGodownInputBox").val();

            if (GodownID != "0") {
                var formData = new FormData();
                formData.append('GodownID', GodownID);
                formData.append('BillToPartyID', BillToPartyID);
                formData.append('YarnMaterialID', YarnMaterialID);
                formData.append('YarnColorID', YarnColorID);
                formData.append('SiftGodownLocationId', siftSiftGodownLocationId.slice(0, -1).replace(/\|/g, ','));
                let tbody = $("#pendingYarnTable tbody");

                $.ajax({
                    type: "POST",
                    url: '/WebServiceNikunjTextile.asmx/getYarnOutwardMasterNew',
                    data: formData,
                    dataType: 'json',
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        let data = response.listYarnOutwardMaster;
                        let tbody = $("#tableYarnOutward tbody");
                        tbody.empty();

                        if (!data || data.length === 0) {
                            tbody.html('<tr><td colspan="8" class="text-center">No Data Found</td></tr>');
                            if (callback) callback();
                            return;
                        }

                        $.each(data, function (index, row) {
                            let key = row.YarnMaterialID + "|" + row.YarnColorID + "|" + normalize(row.YarnColorCode);

                            let tr = `<tr>
                                    <td class="rowIndex">${index + 1}</td>
                                    <td id="CompanyId" hidden>${row.BillToPartyID}</td>
                                    <td>${row.CompanyName}</td>
                                    <td>${row.YarnMaterial}</td>
                                    <td>${row.YarnColor}</td>
                                    <td>${row.YarnColorCode}</td>
                                    <td>${row.Stock}</td>
                                    <td>${row.LocationTitle}</td>
                                    <td>
                                        <input type="text" class="txtStockInput" value="0" data-key="${key}" data-stock="${row.Stock}"
                                            data-locationid="${row.GodownLocationID}" maxlength="2"
                                            onkeypress="return (event.charCode>=48 && event.charCode<=57)" />
                                    </td>
                                </tr>`;
                            tbody.append(tr);
                        });
                        if (callback) callback();
                    },
                    error: function () {
                        tbody.html('<tr><td colspan="7" class="text-danger text-center">Error loading data</td></tr>');
                        if (callback) callback();
                    }
                });
            }
        }

        function loadAllYarnData(PartyId, YarnMaterialID, YarnColorID) {
            GridBindData(function () {
                getPendingYarnForm(PartyId, YarnMaterialID, YarnColorID, function () {
                    highlightMatchedYarnRows();
                    applyCheckboxVisibility();
                });
            });
        }

        function getPendingYarnForm(PartyId, YarnMaterialID, YarnColorID, callback) {
            let tbody = $("#pendingYarnTable tbody");
            tbody.html('<tr><td colspan="7" class="text-center">Loading...</td></tr>');

            pendingDetailMap = {};
            pendingItemWise = {};
            isPendingAvailable = false;

            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/GetPendingYarn",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({
                    partyId: PartyId,
                    yarnMaterialID: YarnMaterialID,
                    yarnColorID: $('#ddlYarnColor').val() || []
                }),
                success: function (res) {
                    let data = res.d;
                    if (typeof data === "string") {
                        data = JSON.parse(data);
                    }

                    tbody.empty();

                    if (!data || data.length === 0) {
                        isPendingAvailable = false;
                        tbody.html('<tr><td colspan="7">No Data Found</td></tr>');
                        $("#tableYarnOutward tbody tr").show();
                        if (callback) callback();
                        return;
                    }

                    isPendingAvailable = true;

                    $.each(data, function (i, item) {
                        let key = item.YarnMaterialID + "|" + item.YarnColorID + "|" + normalize(item.CompanyColourCode);

                        tbody.append(`
                                <tr><td><input type="checkbox" data-key="${key}" class="row-checkbox" value="${item.YarnRequirementID}">REQ - ${item.YarnRequirementID}</td>
                                    <td>${item.PartyName}</td>
                                    <td>${item.YarnMaterial}</td>
                                    <td>${item.YarnColor}</td>
                                    <td>${item.CompanyColourCode}</td>
                                    <td>${item.NoofBoxes}</td>
                                </tr>
                            `);

                        pendingDetailMap[key] = item.YarnRequirementDetailID;

                        if (!pendingItemWise[key]) {
                            pendingItemWise[key] = 0;
                        }
                        pendingItemWise[key] += (parseInt(item.NoofBoxes) || 0);
                    });

                    if (callback) callback();
                },
                error: function () {
                    tbody.html('<tr><td colspan="7" class="text-danger text-center">Error loading data</td></tr>');
                    if (callback) callback();
                }
            });
        }

        function highlightMatchedYarnRows() {
            if (!isPendingAvailable) {
                $("#tableYarnOutward tbody tr").show().removeClass("table-success");
                return;
            }
            let hasMatch = false;
            $("#tableYarnOutward tbody tr").each(function () {
                let row = $(this);
                let key = row.find(".txtStockInput").data("key");

                if (pendingItemWise[key]) {
                    hasMatch = true;
                    row.show().addClass("table-success");
                } else {
                    row.hide();
                }
            });

            if (!hasMatch) {
                $("#tableYarnOutward tbody").html('<tr><td colspan="8">No Matching Data</td></tr>');
            }
        }

        function applyCheckboxVisibility() {
            let outwardMap = {};

            $(".txtStockInput").each(function () {
                let key = $(this).data("key");
                if (key) outwardMap[key] = true;
            });

            let tbody = $("#pendingYarnTable tbody");
            let matchedRows = [];
            let unmatchedRows = [];

            tbody.find("tr").each(function () {
                let row = $(this);
                let checkbox = row.find(".row-checkbox");
                let key = checkbox.data("key");

                if (outwardMap[key]) {
                    checkbox.prop("disabled", false);
                    matchedRows.push(row);
                } else {
                    checkbox.prop("disabled", true);
                    checkbox.prop("checked", false);
                    unmatchedRows.push(row);
                }
            });

            tbody.empty();
            matchedRows.forEach(r => tbody.append(r));
            unmatchedRows.forEach(r => tbody.append(r));
        }

        function formatDateToISO(dateStr) {
            if (!dateStr) return null;
            if (dateStr.includes("/")) {
                let parts = dateStr.split("/");
                if (parts.length !== 3) return null;
                let day = parts[0].padStart(2, '0');
                let month = parts[1].padStart(2, '0');
                let year = parts[2];
                return `${year}-${month}-${day}`;
            }
            return dateStr;
        }

        function saveYarnOutward() {
            let partyId = parseInt($("#ddlParty").val()) || 0;
            let listNo = $("#ListNo").val();
            let listDate = $("#ListDate").val();
            let godownManager = parseInt($("#ddlYarnGodownManager").val()) || 0;
            let godownId = parseInt($("#ddlGodownMaster").val()) || 0;
            let sundrypartyid = parseInt($("#SundryParty").val()) || 0;

            if (partyId === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Select Sundry Creditors Party.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (!listNo) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Mention List No.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (!listDate) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Mention List Date.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }
            if (godownManager === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Please Select Godown Manager.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }

            let detailList = [];
            let tempYarnMap = JSON.parse(JSON.stringify(globalYarnMap || {}));

            $("#tableYarnOutward tbody tr:visible").each(function () {
                let yarnCompanyId = parseInt($(this).find("#CompanyId").text()) || 0;
                let input = $(this).find(".txtStockInput");
                let qty = parseInt(input.val()) || 0;
                if (qty <= 0) return;
                let key = normalize(input.data("key"));
                let materialId = parseInt(key.split("|")[0]);
                let colorId = parseInt(key.split("|")[1]);
                let locationId = parseInt(input.data("locationid"));
                let yarnData = tempYarnMap[key] || [];
                let remainingQty = qty;

                for (let i = 0; i < yarnData.length; i++) {
                    if (remainingQty <= 0) break;
                    let item = yarnData[i];
                    if (item.stock <= 0) continue;
                    let usedQty = Math.min(item.stock, remainingQty);

                    if (usedQty > 0) {
                        detailList.push({
                            BillToPartyID: partyId,
                            YarnCompanyID: yarnCompanyId,
                            YarnMaterialID: materialId,
                            YarnColorID: colorId,
                            GodownLocationID: locationId,
                            NoOfBox: usedQty,
                            YarnRequirementDetailID: item.id
                        });
                        item.stock -= usedQty;
                        remainingQty -= usedQty;
                    }
                }

                if (remainingQty > 0) {
                    detailList.push({
                        BillToPartyID: partyId,
                        YarnCompanyID: yarnCompanyId,
                        YarnMaterialID: materialId,
                        YarnColorID: colorId,
                        GodownLocationID: locationId,
                        NoOfBox: remainingQty,
                        YarnRequirementDetailID: 0
                    });
                }
            });

            if (detailList.length === 0) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Enter at least one quantity",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }

            let formattedDate = formatDateToISO($("#ListDate").val());
            if (!formattedDate) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'warning',
                    title: "Invalid List Date.",
                    showConfirmButton: false,
                    timer: 2000
                });
                return;
            }

            let master = {
                GodownID: godownId,
                PartyId: partyId,
                OutwardListDate: formattedDate,
                GodownManagerUserAccountId: godownManager,
                SundryPartyID: sundrypartyid
            };

            $.ajax({
                url: "/WebServiceNikunjTextile.asmx/SavedataYarnOutward",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify({
                    master: master,
                    detail: detailList
                }),
                success: function (res) {
                    let result = typeof res.d === "string" ? JSON.parse(res.d) : res.d;
                    let data = Array.isArray(result) ? result[0] : result;

                    if (data && data.Status == 1) {
                        Swal.fire({
                            title: 'Success!',
                            text: data.Message,
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = 'YarnOutWardChallanDetails';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: data.Message || "Error saving data",
                            icon: 'error'
                        });
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                    Swal.fire({
                        title: 'Server Error',
                        text: 'An error occurred while saving.',
                        icon: 'error'
                    });
                }
            });
        }

        let globalYarnMap = {};
        let selectionOrderMap = {};

        $(document).on("change", ".row-checkbox", function () {
            let currentChk = $(this);
            let key = normalize(currentChk.data("key"));

            let inputs = $(".txtStockInput").filter(function () {
                return normalize($(this).data("key")) === key;
            });

            let maxCapacity = 0;
            inputs.each(function () {
                maxCapacity += parseInt($(this).data("stock")) || 0;
            });

            let selectedStock = 0;
            $(".row-checkbox:checked").not(currentChk).each(function () {
                let chk = $(this);
                if (normalize(chk.data("key")) === key) {
                    selectedStock += parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                }
            });

            let currentStock = parseInt(currentChk.closest("tr").find("td:eq(5)").text()) || 0;

            if (currentChk.is(":checked")) {
                let tempTotal = selectedStock + currentStock;
                let usableTemp = Math.min(tempTotal, maxCapacity);

                if (usableTemp <= selectedStock) {
                    currentChk.prop("checked", false);
                    Swal.fire({
                        icon: "warning",
                        title: "Limit Reached",
                        text: "Stock already fully allocated!"
                    });
                    return;
                }
            }

            let selectedData = [];
            $(".row-checkbox:checked").each(function () {
                let chk = $(this);
                if (normalize(chk.data("key")) === key) {
                    let stock = parseInt(chk.closest("tr").find("td:eq(5)").text()) || 0;
                    selectedData.push({
                        id: parseInt(chk.val()),
                        stock: stock
                    });
                }
            });

            globalYarnMap[key] = selectedData;

            let totalStock = selectedData.reduce((sum, x) => sum + x.stock, 0);
            let usableStock = Math.min(totalStock, maxCapacity);
            let totalFilled = 0;

            inputs.val(0);
            inputs.each(function () {
                let input = $(this);
                let max = parseInt(input.data("stock")) || 0;
                let remaining = usableStock - totalFilled;

                if (remaining <= 0) {
                    input.val(0);
                    return;
                }

                let fill = Math.min(max, remaining);
                input.val(fill);
                input.data("old", fill);
                totalFilled += fill;
            });
        });
    </script>
}