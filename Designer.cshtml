    function checkSaveView() {

        var IsActive = "0";
        if ($("#IsActive").is(':checked')) {
            //$("#isDefault").attr('value', 'true');
            IsActive = "1";
        }


        var DesignerCode = $('#DesignerCode').val();
        var DesignerName = $('#DesignerName').val();
        var Address = $('#Address').val();
        var BankName = $('#BankName').val();
        var BankAcNo = $('#BankAcNo').val();
        var IFSCCode = $('#IFSCCode').val();
        var AadharUpload = $('#AadharUpload')[0].files[0];


        if (validate(document.getElementById('DesignerCode')) == false && validate(document.getElementById('DesignerName')) == false) {
            validate(document.getElementById('DesignerCode'));
            validate(document.getElementById('DesignerName'));
        }
        else {

            var formData = new FormData();
            formData.append('DesignerCode', DesignerCode);
            formData.append('DesignerName', DesignerName);
            formData.append('Address', Address);
            formData.append('BankName', BankName);
            formData.append('BankAcNo', BankAcNo);
            formData.append('IFSCCode', IFSCCode);
            formData.append('AadharUpload', AadharUpload);
            formData.append('IsActive', IsActive);


            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertDesignerMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.Code == 201) {
                        clearAll();

                        notes.show(response.Message, {
                            type: 'success',

                        });
                        displayData(0);
                        $("#cancelbtn").click();
                    }
                    else {


                        notess.show(response.Message, {
                            type: 'danger',

                        });
                    }
                },
                error: function (error) {


                    notess.show(response.Message, {
                        type: 'danger',

                    });

                }
            });
        }
    }

    function checkSave() {
        var IsActive = "0";
        if ($("#IsActive").is(':checked')) {

            IsActive = "1";
        }


        var DesignerCode = $('#DesignerCode').val();
        var DesignerName = $('#DesignerName').val();
        var Address = $('#Address').val();
        var BankName = $('#BankName').val();
        var BankAcNo = $('#BankAcNo').val();
        var IFSCCode = $('#IFSCCode').val();
        var AadharUpload = $('#AadharUpload')[0].files[0];


        if (validate(document.getElementById('DesignerCode')) == false && validate(document.getElementById('DesignerName')) == false) {
            validate(document.getElementById('DesignerCode'));
            validate(document.getElementById('DesignerName'));
        }
        else {

            var formData = new FormData();
            formData.append('DesignerCode', DesignerCode);
            formData.append('DesignerName', DesignerName);
            formData.append('Address', Address);
            formData.append('BankName', BankName);
            formData.append('BankAcNo', BankAcNo);
            formData.append('IFSCCode', IFSCCode);
            formData.append('AadharUpload', AadharUpload);
            formData.append('IsActive', IsActive);

            $.ajax({
                type: "POST",
                url: '/WebServiceNikunjTextile.asmx/insertDesignerMaster',
                data: formData,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
