    function displayData(rowStartCheck) {
        var rowStart = 0;
        if (rowStartCheck != 0) {
            rowStart = parseInt($("#rowStartCount").val()) + 10;
            $("#rowStartCount").val(rowStart);
        }
        else {
            rowStart = 0;
            $("#rowStartCount").val("0");
        }

        var searchDesigner = $("#search-Designer").val();

        var formData = new FormData();
        formData.append('searchDesigner', searchDesigner);
        formData.append('startFrom', rowStart);

        $.ajax({
            type: "POST",
            url: '/WebServiceNikunjTextile.asmx/getDesignerMaster',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            success: function (response) {



                //$.ajax({
                //    type: "GET",
                //    url: '/WebServiceNikunjTextile.asmx/getDesignerMaster?startFrom=' + rowStart,
                //    //getItemCat
                //    data: "{ 'startFrom':'" + rowStart + "' }",
                //    dataType: 'json',
                //    contentType: false,
                //    processData: false,
                //    success: function (response) {

                console.log(response);

                if (rowStart == 0) {
                    $("#copy-print-csv tbody").empty();
                }
                var dataTable = $('#copy-print-csv');
                var temp = "";
                var operation = "";
                if (response.listDesignerMaster.length < 10) {
                    $("#view-more-btn").hide();
                }
                else {
                    $("#view-more-btn").show();
                }

                var SrNo = rowStart + 1;
                for (var i = 0; i < response.listDesignerMaster.length; i++) {

                    var Top = i - 1;
                    var Previous = i + 1;

                    //console.log(response.listDesignerMaster[Previous].DesignerID);

                    var ActionPosition = "";
                    if (response.listDesignerMaster.length != 1) {
                        if (i == 0) {

                            var PostDown = response.listDesignerMaster[i].DesignerID + "," + response.listDesignerMaster[i].Position + "|" + response.listDesignerMaster[Previous].DesignerID + "," + response.listDesignerMaster[Previous].Position;

                            ActionPosition += "<input type='hidden' id='PostDown_" + response.listDesignerMaster[i].DesignerID + "' value = '" + PostDown + "' /> ";
                            ActionPosition += "<span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listDesignerMaster[i].DesignerID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            //ActionPosition += "<button type='button' class='btn btn-primary' style='font-size: 6px;' onclick='functionCakeCategoryUp(" + response.listDesignerMaster[i].DesignerID + ")'><i class='fa fa-arrow-up fa-2x'></i></button>  &nbsp;";
                        }
                        else
                            if (i == parseInt(response.listDesignerMaster.length - 1)) {

                                var PostUp = response.listDesignerMaster[i].DesignerID + "," + response.listDesignerMaster[i].Position + "|" + response.listDesignerMaster[Top].DesignerID + "," + response.listDesignerMaster[Top].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listDesignerMaster[i].DesignerID + "' value = '" + PostUp + "' /> </span>";
                                ActionPosition += "<span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listDesignerMaster[i].DesignerID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'></td>";
                            }
                            else {

                                var PostUp = response.listDesignerMaster[i].DesignerID + "," + response.listDesignerMaster[i].Position + "|" + response.listDesignerMaster[Top].DesignerID + "," + response.listDesignerMaster[Top].Position;
                                var PostDown = response.listDesignerMaster[i].DesignerID + "," + response.listDesignerMaster[i].Position + "|" + response.listDesignerMaster[Previous].DesignerID + "," + response.listDesignerMaster[Previous].Position;

                                ActionPosition += "<input type='hidden' id='PostUp_" + response.listDesignerMaster[i].DesignerID + "' value = '" + PostUp + "' /><span class='icon-triangle-up'  title='Up'  onclick='onPostUp(" + response.listDesignerMaster[i].DesignerID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span>";
                                ActionPosition += "<input type='hidden' id='PostDown_" + response.listDesignerMaster[i].DesignerID + "' value = '" + PostDown + "' /><span class='icon-triangle-down' title='Down'  onclick='onPostDown(" + response.listDesignerMaster[i].DesignerID + ")' style='color: #337ab7; font-size: x-large; cursor: pointer;'> </span></td>";
                            }

                    }

                    temp += "<tr>";
                    temp += "<td>" + SrNo++ + "</td>";
                    temp += "<td>" + response.listDesignerMaster[i].DesignerCode + "</td>";
                    temp += "<td>" + response.listDesignerMaster[i].DesignerName + "</td>";
                    temp += "<td>" + response.listDesignerMaster[i].Address + "</td>";
                    temp += "<td>" + response.listDesignerMaster[i].BankName + "</td>";
                    temp += "<td>" + response.listDesignerMaster[i].BankAcNo + "</td>";
                    temp += "<td>" + response.listDesignerMaster[i].IFSCCode + "</td>";
                    if (response.listDesignerMaster[i].AadharUpload != "") {
                        temp += "<td><a href='/" + response.listDesignerMaster[i].AadharUpload + "' target='_blank'><i class='fa fa-file-pdf-o fa-2x'></i></a></td>";
                    }
                    else {
                        temp += "<td></td>";
                    }



                    if (response.listDesignerMaster[i].IsActive == "1") {
                        temp += "<td><span class='badge bg-success'>Active</span></td>";
                    }
                    else {
                        temp += "<td><span class='badge bg-danger'>Inactive</span></td>";
                    }

                    /*temp += "<td>" + ActionPosition + "</td>";*/
                    temp += "<td><div class='actions'><a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Edit' data-bs-toggle='modal' data-bs-target='#addNewContact' onclick='showRecords(" + response.listDesignerMaster[i].DesignerID + ")'><i class='icon-edit1 text-info'></i></a> &nbsp;&nbsp; <a href='javascript:void(0);' data-toggle='tooltip' data-placement='top' title='' data-original-title='Delete' onclick='functionYarnDelete(" + response.listDesignerMaster[i].DesignerID + ")'><i class='icon-x-circle text-danger'></i></a></div></td>";
                    temp += "</tr>";
                }

                dataTable.append(temp);
            },
            error: function (request, status, error) {
            }
        });
    }



