        function showEditRecords(id) {
            var DecryptID = "";
            $.ajax({
                type: "GET",
                url: '/WebServiceNikunjTextile.asmx/getEncryptID?id=' + id,
                data: "{ 'id':'" + id + "' }",
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    console.log(response);
                    DecryptID = response.listEncryptDecrypt[0].DecryptID;
                    window.location.href = '/UpdateYarnRequirement?id=' + response.listEncryptDecrypt[0].DecryptID;
                },
                error: function (request, status, error) {

                }
            });
        }
        function functionUserDelete(id) {
            // Replaced native confirm() with SweetAlert2 confirmation dialog
            Swal.fire({
                title: 'Are you sure?',
                text: "Are you sure you want to delete this record?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('YarnRequirementID', id);

                    $.ajax({
                        type: "POST",
                        url: '/WebServiceNikunjTextile.asmx/DeleteYarnRequirementMaster',
                        data: formData,
                        dataType: 'json',
                        contentType: false,
                        processData: false,
                        success: function (response) {
                            if (response.Code == 200) {

                                Swal.fire(
                                    'Deleted!',
                                    'Yarn Requirement deleted successfully.',
                                    'success'
                                );

                                notes.show("Yarn Requirement deleted successfully.", {
                                    type: 'danger'
                                });

                                displayData(0);
                            }
                            else {
                                Swal.fire(
                                    'Error!',
                                    'A problem occurred while deleting the Design Entry Form.',
                                    'error'
                                );

                                notes.show("Problem has been occurred while deleting Design Entry Form .", {
                                    type: 'danger'
                                });
                            }
                        },
                        error: function (error) {
                            Swal.fire(
                                'Error!',
                                'A problem occurred while processing your request.',
                                'error'
                            );

                            notes.show("Problem has been occurred while deleting Design Entry Form.", {
                                type: 'danger'
                            });
                        }
                    });
                }
            });
        }
    </script>
