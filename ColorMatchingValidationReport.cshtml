                success: function (data) {
                    if (data.d == "false") {
                        window.location.replace("/Index");
                    }
                }
            });
        }

        // ================= INIT =================
        $(document).ready(function () {

            $('.active, .show, .current-page').removeClass('active show current-page');
            $("#Report-tab").addClass("active");
            $("#tab-Report").addClass("show active");
            $("#aColorMatchingReport").addClass("current-page");

            FunctionIsLogin();

            setActiveTab("tabAll");
            loadReport(1, '');

            // ================= SEARCH (FINAL FIX) =================
            $("#searchBox").on("keyup", function () {

                let val = $(this).val().toLowerCase().trim();

                if (!val) {
                    applyFilters(fullData);
                    return;
                }

                let grouped = {};

                fullData.forEach(item => {
                    let key = item.DesignColorMatchingFormID;
                    if (!grouped[key]) grouped[key] = [];
                    grouped[key].push(item);
                });

                let result = [];

                Object.values(grouped).forEach(group => {

                    let isMatch = group.some(obj => {

                        let designNo = (obj.DesignNo || '').toLowerCase().trim();
                        let designerCode = (obj.DesignerCode || '').toLowerCase().trim();

                        let full1 = (designNo + designerCode).replace(/\s/g, '');
                        let full2 = (designerCode + designNo).replace(/\s/g, '');

                        let searchVal = val.replace(/\s/g, '');

                        let allFieldsMatch = Object.values(obj).some(v =>
                            (v || '').toString().toLowerCase().includes(val)
                        );

                        return (
                            designNo.includes(val) ||
                            designerCode.includes(val) ||
                            full1.includes(searchVal) ||
                            full2.includes(searchVal) ||
                            allFieldsMatch
                        );
                    });

                    if (isMatch) result.push(...group);
                });

                applyFilters(result);
            });

            // ================= TABS =================
            $("#tabAll").click(function () {
                setActiveTab("tabAll");
                loadReport(1, '');
            });

            $("#tabValidated").click(function () {
                setActiveTab("tabValidated");
                loadReport(1, 'Validated');
            });

            $("#tabNotValidated").click(function () {
                setActiveTab("tabNotValidated");
                loadReport(1, 'Not Validated');
            });

        });

        // ================= FILTER =================
        function applyFilters(data) {
            filteredData = data;
            currentPage = 1;
            renderReport();
        }

