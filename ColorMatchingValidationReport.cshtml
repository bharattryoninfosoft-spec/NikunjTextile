                <div class="row mb-2">
                    <div class="col-md-3"><b>Warp:</b> ${header.WarpQuality || ''}</div>
                    <div class="col-md-3"><b>Category:</b> ${header.DesignCategory || ''}</div>
                    <div class="col-md-3"><b>Total Card:</b> ${header.TotalCard || ''}</div>
                    <div class="col-md-3"><b>Pick:</b> ${header.PickOnLoom || ''}</div>
