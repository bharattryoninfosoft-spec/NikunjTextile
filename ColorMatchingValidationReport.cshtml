    // ================= TOGGLE =================
    function toggleRow(id) {
        let body = $("#body_" + id);
        let icon = $("#icon_" + id);

        if (body.is(":visible")) {
            body.slideUp(150);
            icon.html('<i class="fa fa-plus"></i>');   // ✅ FIX
