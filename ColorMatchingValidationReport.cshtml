    // ================= PAGINATION =================
    function renderPagination() {

        let totalPages = Math.ceil(totalRecords / pageSize) || 1;

        let html = '';

        html += `<button class="btn btn-sm btn-secondary me-1"
        ${currentPage === 1 ? 'disabled' : ''}
        onclick="changePage(${currentPage - 1})">Prev</button>`;

        html += `<span class="mx-2">
        Page <b>${currentPage}</b> of <b>${totalPages}</b>
    </span>`;

        html += `<button class="btn btn-sm btn-secondary"
        ${currentPage >= totalPages ? 'disabled' : ''}
        onclick="changePage(${currentPage + 1})">Next</button>`;

        html += `<span class="ms-3 text-muted">
        Total: ${totalRecords}
    </span>`;

        $("#pagination").html(html);
    }

    // ================= PAGE CHANGE =================
    function changePage(page) {

        let totalPages = Math.ceil(totalRecords / pageSize);
        if (page < 1 || page > totalPages) return;

        currentPage = page;

        loadReport(currentPage, currentStatus);

        // 🔥 smooth scroll
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ================= HELPERS =================
    function getWarp(r) {
        return [r.Warp1, r.Warp2, r.Warp3, r.Warp4, r.Warp5]
            .filter(x => x && x !== "0")
            .join(', ');
    }

    function getFeeder(r) {
        return [r.Feeder1, r.Feeder2, r.Feeder3, r.Feeder4, r.Feeder5]
            .filter(x => x && x !== "0")
            .join(', ');
    }
