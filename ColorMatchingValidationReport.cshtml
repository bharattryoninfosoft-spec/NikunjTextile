<style>
    /* ================= BLOCK ================= */
    .cm-block {
        border-bottom: 1px solid #ddd;
    }

    .cm-header {
        padding: 10px;
        background: #f5f7fa;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.2s ease;
    }

        .cm-header:hover {
            background: #e9f0ff;
        }

    .cm-body {
        padding: 10px;
        background: #fff;
    }

    .cm-table {
        border-top: 1px solid #ddd;
    }

    /* ================= ROW ================= */
    .cm-row {
        display: grid;
        grid-template-columns: 60px 1fr 1fr 1fr;
        padding: 6px;
        border-bottom: 1px solid #eee;
        font-size: 13px;
        transition: background 0.2s ease;
    }

    .cm-head {
        font-weight: bold;
        background: #c5dcff;
    }

    .cm-row:hover {
        background: #f1f5ff;
    }

    /* ================= TABS ================= */
    #reportTabs .nav-link {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
        border-radius: 6px;
        padding: 6px 12px;
        transition: all 0.3s ease;
        position: relative;
    }

        /* Hover */
        #reportTabs .nav-link:hover {
            background: #eef3ff;
        }

        /* Active */
        #reportTabs .nav-link.active {
            background-color: #0d6efd;
            color: #fff;
        }

        /* Animated underline */
        #reportTabs .nav-link::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 50%;
            width: 0;
            height: 3px;
            background: #0d6efd;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        #reportTabs .nav-link.active::after {
            width: 80%;
        }

    /* Badge */
    #reportTabs .badge {
        font-size: 11px;
    }

    /* ================= PAGINATION ================= */
    #pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    /* ================= STICKY HEADER ================= */
    .report-header {
        position: sticky;
        top: 0;
        z-index: 999;
        background: #fff;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
    }

        /* Shadow on scroll */
        .report-header.scrolled {
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

    /* ================= LOADER ================= */
    .loader {
        width: 18px;
        height: 18px;
        border: 3px solid #ddd;
        border-top: 3px solid #0d6efd;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    /* ================= SMALL ANIMATION ================= */
    .scale-click {
        transform: scale(0.95);
        transition: transform 0.15s ease;
